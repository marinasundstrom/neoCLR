module Examples.Web

import System.*
import System.Result.*
import System.Time.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import Neo.Configuration.*
import Neo.DependencyInjection.*
import Neo.Logging.*
import Neo.Web.*

// Arguments: optional port (default 8080), optional run duration in seconds (default 60).
// A finite timer makes shutdown explicit and testable without a process signal adapter.
async func Main(arguments: string[]) -> Task<int> {
    var port = 8080
    var seconds = 60
    if arguments.Length > 0 { port = Int32.Parse(arguments[0])! }
    if arguments.Length > 1 { seconds = Int32.Parse(arguments[1])! }
    if seconds < 1 || seconds > 3600 { return 1 }
    use builder = WebApplication.CreateBuilder()
    builder.Server.Port = port
    _ = builder.Configuration.AddInMemoryCollection([ConfigurationEntry("Greeting", "Hello")])
    builder.Logging.AddConsole()
    _ = builder.Services.AddSingleton<VisitStore>((provider) => Ok(VisitStore()))!
    _ = builder.Services.AddScoped<GreetingService>((provider) => {
        return Ok(GreetingService(provider.GetRequiredService<Configuration>()!))
    })!
    _ = builder.Services.AddScoped<MaintenanceMiddleware>()!
    _ = builder.Services.AddSingleton<DemoResponseCache>((provider) => Ok(DemoResponseCache()))!
    _ = builder.Services.AddScoped<DemoResponseCacheMiddleware>()!
    let Ok(app) = builder.Build() else { return 1 }
    use application = app
    let Ok(_) = Configure(app) else { return 1 }
    let lifetime = app.RunAsync()
    let Ok(actualPort) = app.GetLocalPort() else {
        _ = await lifetime
        return 1
    }
    Console.WriteLine("LISTENING http://127.0.0.1:" + actualPort.ToString())
    use stop = Timer(() => { app.Stop() })
    stop.Start(Duration.FromTicks((long)seconds * 10000000L))
    let Ok(_) = await lifetime else { return 1 }
    Console.WriteLine("STOPPED")
    return 0
}

func Configure(app: WebApplication) -> Result<unit, WebError> {
    app.Use(LogRequest)?
    app.UseMiddleware<MaintenanceMiddleware>()?
    app.UseMiddleware<DemoResponseCacheMiddleware>()?
    app.MapGet("/cached", Computed)?
    app.MapGet("/uncached", Computed)?
    app.MapGet("/cache-stats", CacheStatistics)?
    app.MapGet("/", Home)?
    app.MapGet("/hello/{name}", Greeting)?
    app.MapGet("/hello/current", Current)?
    app.MapPost("/visits", Visit)?
    app.MapGet("/search", Search)?
    app.MapPost("/greetings", CreateGreeting)?
    app.MapPost("/json-text", JsonText)?
    app.MapGet("/items/{id}", Item)?
    app.Map("/echo/{value}", Echo)?
    return app.Run(Unmatched)
}
