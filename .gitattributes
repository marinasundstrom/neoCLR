# Preserve upstream notice bytes, including line endings and trailing blank lines.
third-party/licenses/** -text -whitespace
third-party/unicode/** -text -whitespace
third-party/raven-tools/** -text -whitespace

# Raven bootstrap manifests hash exact source and generated bytes.
runtime/raven/src/** text eol=lf
runtime/raven/*.rvnproj text eol=lf
runtime/raven/generated/** text eol=lf
