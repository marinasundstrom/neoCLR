import System.Runtime.InteropServices.*

[NativeImport("/usr/lib/libSystem.B.dylib", EntryPoint: "malloc")]
unsafe extern func AllocateBytes(size: nuint) -> *unit;

[NativeImport("/usr/lib/libSystem.B.dylib", EntryPoint: "free")]
unsafe extern func FreeBytes(pointer: *unit) -> unit;

// The caller owns the returned native allocation and must call SampleRelease.
[NativeExport("sample_allocate")]
unsafe func SampleAllocate(value: int) -> *int {
    let pointer = (*int)AllocateBytes((nuint)4)
    if pointer != default(*int) {
        *pointer = value
    }
    return pointer
}

[NativeExport("sample_read")]
unsafe func SampleRead(pointer: *int) -> int {
    return *pointer
}

[NativeExport("sample_write")]
unsafe func SampleWrite(pointer: *int, value: int) -> unit {
    *pointer = value
}

[NativeExport("sample_release")]
unsafe func SampleRelease(pointer: *int) -> unit {
    FreeBytes(pointer)
}

unsafe func Main() -> int {
    let pointer = SampleAllocate(42)
    if pointer == default(*int) {
        return 1
    }
    SampleWrite(pointer, 43)
    let result = SampleRead(pointer)
    SampleRelease(pointer)
    if result != 43 {
        return 2
    }
    return 0
}
