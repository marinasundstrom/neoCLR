import System.*
import System.Runtime.*
import System.Result.*

class ByteBufferOwner {
    val Data: Memory<byte>
    val ReadOnlyData: ReadOnlyMemory<byte>

    init(data: Memory<byte>, readonlyData: ReadOnlyMemory<byte>) {
        Data = data
        ReadOnlyData = readonlyData
    }
}

func CreateOwner() -> ByteBufferOwner {
    let data: byte[] = [(byte)1, (byte)2, (byte)3, (byte)4]
    let memory: Memory<byte> = data
    let readonlyMemory: ReadOnlyMemory<byte> = data
    return ByteBufferOwner(memory.Slice(1, 2), readonlyMemory.Slice(2, 1))
}

func CreateEmpty() -> ReadOnlyMemory<byte> {
    let memory: ReadOnlyMemory<byte> = [(byte)8]
    return memory.Slice(1)
}

func Keep(data: Memory<byte>) -> Memory<byte> => data
func KeepReadOnly(data: ReadOnlyMemory<byte>) -> ReadOnlyMemory<byte> => data

func CreateConverted() -> ReadOnlyMemory<byte> {
    let memory: Memory<byte> = [(byte)5, (byte)6, (byte)7, (byte)8]
    return memory.Slice(1, 2)
}

func CreateConvertedEmpty() -> ReadOnlyMemory<byte> {
    let memory: Memory<byte> = [(byte)9]
    return memory.Slice(1)
}

func CreateRanged() -> ByteBufferOwner {
    let memory: Memory<byte> = [(byte)10, (byte)11, (byte)12, (byte)13]
    let readonlyMemory: ReadOnlyMemory<byte> = memory
    return ByteBufferOwner(memory[1..^1], readonlyMemory.Slice(1..^1))
}

func ReadByte(source: ReadOnlySlice<byte>) -> byte => source[0]

func CreateBorrowed() -> Slice<byte> {
    let data: byte[] = [(byte)51, (byte)52, (byte)53]
    return data[1..]
}

func CreateBorrowedEmpty() -> ReadOnlySlice<byte> {
    let data: byte[] = [(byte)54]
    return data[1..]
}

func BorrowedWindows() -> int {
    let soleOwner = CreateBorrowed()
    let emptyOwner = CreateBorrowedEmpty()
    GC.Collect()
    if soleOwner[0] != 52 || !emptyOwner.IsEmpty {
        return 20
    }
    let data: byte[] = [(byte)10, (byte)20, (byte)30, (byte)40]
    let memory: Memory<byte> = data
    let readonlyMemory: ReadOnlyMemory<byte> = memory[1..3]
    let window = data[1..^1]
    let readonlyWindow: ReadOnlySlice<byte> = window
    window[0] = (byte)99
    GC.Collect()
    if data[1] != 99 || ReadByte(readonlyWindow) != 99 || ReadByte(readonlyMemory) != 99 {
        return 21
    }
    let borrowed: Slice<byte> = memory[2..]
    borrowed[1] = (byte)77
    if data[3] != 77 || ReadByte(memory) != 10 || ReadByte(data) != 10 {
        return 22
    }
    let nested = window.Slice(1)[..1]
    if nested[0] != 30 || window[^1] != 30 || window[^0..].Length != 0 {
        return 23
    }
    let copy = readonlyWindow.ToArray()
    window[1] = (byte)88
    if copy[1] != 30 || readonlyWindow[1] != 88 {
        return 24
    }
    if !default(Slice<byte>).IsEmpty || !default(ReadOnlySlice<byte>).Slice(0).IsEmpty {
        return 25
    }
    return 0
}

func Main() -> int {
    let borrowedResult = BorrowedWindows()
    if borrowedResult != 0 {
        return borrowedResult
    }
    let empty = default(Memory<byte>)
    let readonlyEmpty = default(ReadOnlyMemory<byte>)
    if !empty.IsEmpty || !readonlyEmpty.IsEmpty {
        return 1
    }
    let owner = CreateOwner()
    let retainedEmpty = CreateEmpty()
    let converted = CreateConverted()
    let convertedEmpty = CreateConvertedEmpty()
    let convertedDefault: ReadOnlyMemory<byte> = empty
    let convertedOwner = ByteBufferOwner(empty, CreateConverted())
    let ranged = CreateRanged()
    GC.Collect()
    if Keep(owner.Data).Slice(0, 2).Length != 2 || owner.ReadOnlyData.Slice(1, 0).Length != 0 {
        return 2
    }
    if retainedEmpty.Slice(0).Length != 0 {
        return 3
    }
    if Keep(owner.Data).Slice(1).Slice(1).Length != 0 || owner.ReadOnlyData.Slice(0).Length != 1 {
        return 4
    }
    if empty.Slice(0).Length != 0 || readonlyEmpty.Slice(0).Length != 0 {
        return 5
    }
    if converted.Length != 2 || converted.Slice(1).Length != 1 {
        return 6
    }
    if convertedEmpty.Slice(0).Length != 0 || convertedDefault.Slice(0).Length != 0 {
        return 7
    }
    if KeepReadOnly(owner.Data).Slice(1).Length != 1 || convertedOwner.ReadOnlyData.Slice(1).Length != 1 {
        return 8
    }
    if ranged.Data[..].Length != 2 || ranged.ReadOnlyData[..].Length != 2 {
        return 9
    }
    if ranged.Data[1..][..1].Length != 1 || ranged.ReadOnlyData[..^1][^1..].Length != 1 {
        return 10
    }
    if ranged.Data[^0..].Length != 0 || ranged.ReadOnlyData.Slice(Range.All).Length != 2 {
        return 11
    }
    if empty[..].Length != 0 || readonlyEmpty[^0..^0].Length != 0 {
        return 12
    }
    if Range(2, 1).TryGetOffsetAndLength(2) is Error(_) {
    } else {
        return 13
    }
    if Range.All.TryGetOffsetAndLength(-1) is Error(_) {
    } else {
        return 14
    }
    return 0
}
