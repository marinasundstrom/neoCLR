<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>SliceConsumer</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RavenTargetPlatform>NeoCLR</RavenTargetPlatform>
    <RavenMetadataFormat>NeoCLR</RavenMetadataFormat>
    <RavenNeoClrNativeCoreReference>../../../runtime/legacy/raven/projects/System.Runtime/bin/neoclr/System.Runtime.dll</RavenNeoClrNativeCoreReference>
    <RavenNeoClrRuntimeContracts>../../../runtime/legacy/raven/projects/System.Runtime/ownership.json</RavenNeoClrRuntimeContracts>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="consumer.rvn" />
  </ItemGroup>
</Project>
