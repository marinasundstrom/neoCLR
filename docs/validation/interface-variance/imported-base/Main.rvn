import System.*
import ImportedVariance.*

open class Derived : Base {
    init(number: int) : base(number) { }
}

class Leaf : Derived {
    init(number: int) : base(number) { }
}

class Source : Producer<Leaf> {
    private val value: Leaf

    init(value: Leaf) {
        self.value = value
    }

    func Get() -> Leaf => value
}

class Sink : Consumer<Base> {
    func Accept(value: Base) -> int {
        value.Number += 1
        return value.Number
    }
}

class NestedSource : Producer<Consumer<Base>> {
    private val value: Consumer<Base>

    init(value: Consumer<Base>) {
        self.value = value
    }

    func Get() -> Consumer<Base> => value
}

class ArraySource : Producer<int[]> {
    private val value: int[]

    init(value: int[]) {
        self.value = value
    }

    func Get() -> int[] => value
}

class ObjectSink : Consumer<Object> {
    private val expected: Object

    init(expected: Object) {
        self.expected = expected
    }

    func Accept(value: Object) -> int {
        if Object.ReferenceEquals(value, expected) {
            return 42
        }
        return 1
    }
}

func Widen(value: Producer<Leaf>) -> Producer<Base> => value
func Narrow(value: Consumer<Base>) -> Consumer<Leaf> => value
func NarrowObject(value: Consumer<Object>) -> Consumer<Consumer<Base>> => value
func WidenObject(value: Producer<Consumer<Base>>) -> Producer<Object> => value
func Nest(value: Producer<Consumer<Base>>) -> Producer<Consumer<Leaf>> => value

func WidenArray(value: Producer<int[]>) -> Producer<Object> => value
func NarrowArray(value: Consumer<Object>) -> Consumer<int[]> => value

func Main() -> int {
    let leaf = Leaf(40)
    let source = Source(leaf)
    let producer = Widen(source)
    let result = producer.Get()
    if !Object.ReferenceEquals(result, leaf) || !Object.ReferenceEquals(producer, source) {
        return 1
    }
    let sink = Sink()
    let consumer = Narrow(sink)
    if consumer.Accept(leaf) != 41 || leaf.Number != 41 {
        return 2
    }
    let nestedSource = NestedSource(sink)
    let objectProducer = WidenObject(nestedSource)
    if !Object.ReferenceEquals(objectProducer.Get(), sink) {
        return 5
    }
    let objectConsumer = NarrowObject(ObjectSink(sink))
    if objectConsumer.Accept(sink) != 42 {
        return 6
    }
    let nested = Nest(nestedSource)
    let nestedConsumer = nested.Get()
    if !Object.ReferenceEquals(nestedConsumer, sink) {
        return 3
    }
    if nestedConsumer.Accept(leaf) != 42 || leaf.Number != 42 {
        return 4
    }
    let numbers: int[] = [40, 2]
    let arraySource = ArraySource(numbers)
    let arrayProducer = WidenArray(arraySource)
    if !Object.ReferenceEquals(arrayProducer.Get(), numbers) {
        return 7
    }
    let arrayConsumer = NarrowArray(ObjectSink(numbers))
    if arrayConsumer.Accept(numbers) != 42 {
        return 8
    }
    numbers[0] = 42
    if arraySource.Get()[0] != 42 {
        return 9
    }
    return 42
}
