module VarianceIntrospection

import System.*
import System.Introspection.*
import System.Runtime.*

interface Producer<out T> {
    func Get() -> T
}

interface Consumer<in T> {
    func Accept(value: T) -> ()
}

class Fixed<T> { }

func Main() -> int {
    var invariant = 0
    var covariant = 0
    var contravariant = 0
    let assembly = RuntimeContext.Current.ExecutingAssembly
    let types = assembly.GetTypes()
    for type in types {
        if type is NominalTypeInfo nominal && nominal.Namespace == "VarianceIntrospection" && type.GenericArgumentCount == 1 {
            let parameter = type.GetGenericArguments()[0]
            if parameter is GenericParameterTypeInfo info {
                if !info.Equals(type.GetGenericArgument(0)) {
                    return 1
                }
                if info.Variance == GenericVariance.Invariant {
                    invariant += 1
                } else if info.Variance == GenericVariance.Covariant {
                    covariant += 1
                } else if info.Variance == GenericVariance.Contravariant {
                    contravariant += 1
                }
            } else {
                return 2
            }
        }
    }
    if invariant != 1 || covariant != 1 || contravariant != 1 {
        return 3
    }
    if typeof(Fixed<int>).GetGenericArgument(0) is GenericParameterTypeInfo {
        return 4
    }
    var moduleTypes = 0
    for scope in assembly.GetModules() {
        if scope.Name == "VarianceIntrospection" {
            for type in scope.GetTypes() {
                if type.GenericArgumentCount == 1 {
                    var found = false
                    for candidate in types {
                        if type.Equals(candidate) {
                            found = true
                        }
                    }
                    if !found {
                        return 5
                    }
                    moduleTypes += 1
                }
            }
        }
    }
    if moduleTypes != 3 {
        return 6
    }
    return 42
}
