import System.*
import System.Result.*
import System.Option.*

func Main() -> int {
    let Ok(input) = Console.ReadByte() else {
        return 1
    }
    let Some(value) = input else {
        return 2
    }
    if value != (byte)42 {
        return 3
    }
    let Ok(end) = Console.ReadByte() else {
        return 4
    }
    if end is Some(_) {
        return 5
    }
    let Ok(parsed) = int.Parse("42") else {
        return 6
    }
    let Error(_) = int.Parse("invalid") else {
        return 7
    }
    let Ok(text) = "native".SliceUtf8(0, 3) else {
        return 8
    }
    if text != "nat" {
        return 9
    }
    return parsed
}
