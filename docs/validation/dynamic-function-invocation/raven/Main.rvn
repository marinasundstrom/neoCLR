import System.*
import System.Introspection.*
import System.Runtime.Reflection.*

class Counter {
    private val value: int

    init(value: int) {
        self.value = value
    }

    func Add(increment: int) -> int => value + increment
}

func KeepObject(value: Object?) -> Object? => value

func Keep(callback: (int) -> int) -> (int) -> int => callback

func IsFactory<T>(obj: Object?) -> bool {
    if obj is () -> T {
        return true
    }
    return false
}

func ReadFactory<T>(obj: Object, fallback: T) -> T {
    return obj match {
        () -> T callback => callback()
        _ => fallback
    }
}

func FactoryChecksAgree<T>(obj: Object?) -> bool {
    return IsFactory<T>(obj) == typeof(() -> T).IsInstanceOfType(obj)
}

func Answer() -> int => 42

func Main() -> int {
    let factory: () -> int = Answer
    if !IsFactory<int>(factory) || IsFactory<string>(factory) || IsFactory<int>(null) {
        return 8
    }
    if ReadFactory<int>(factory, 0) != 42 || ReadFactory<string>(factory, "fallback") != "fallback" {
        return 9
    }
    if !FactoryChecksAgree<int>(factory) || !FactoryChecksAgree<string>(factory) ||
        !FactoryChecksAgree<int>(null) {
        return 11
    }
    let counter = Counter(40)
    let callback: (int) -> int = counter.Add
    let reference: Object = callback
    if reference is not (int) -> int {
        return 3
    }
    if reference is (string) -> int || reference is (int) -> string {
        return 4
    }
    let missing: Object? = null
    let ordinary: Object = counter
    if missing is (int) -> int || ordinary is (int) -> int {
        return 5
    }
    if reference is (int) -> int captured {
        if captured(2) != 42 {
            return 6
        }
    } else {
        return 7
    }
    let expectedShape = typeof((int) -> int)
    if !expectedShape.IsInstanceOfType(reference) || expectedShape.IsInstanceOfType(missing) ||
        expectedShape.IsInstanceOfType(ordinary) || typeof((string) -> int).IsInstanceOfType(reference) ||
        typeof((int) -> string).IsInstanceOfType(reference) {
        return 10
    }
    let shape = reference.GetType()
    if !shape.IsFunctionType || shape.IsNominalType || !shape.Equals(typeof((int) -> int)) {
        return 1
    }
    let keeper: ((int) -> int) -> (int) -> int = Keep
    let callbackArguments: Object?[] = [reference]
    let forwarded = FunctionReflection.Invoke(keeper, callbackArguments)
    if forwarded is not .Ok(Object function) {
        return 2
    }
    let wrongCount: Object?[] = []
    let wrongType: Object?[] = [true]
    let nullValue: Object?[] = [null]
    if FunctionReflection.Invoke(function, wrongCount) is not .Error(.InvalidArguments) ||
        FunctionReflection.Invoke(function, wrongType) is not .Error(.InvalidArguments) ||
        FunctionReflection.Invoke(function, nullValue) is not .Error(.InvalidArguments) {
        return 12
    }
    if FunctionReflection.Invoke(null, wrongCount) is not .Error(.InvalidReceiver) ||
        FunctionReflection.Invoke(ordinary, wrongCount) is not .Error(.InvalidReceiver) {
        return 13
    }
    let keepObject: (Object?) -> Object? = KeepObject
    if FunctionReflection.Invoke(keepObject, nullValue) is not .Ok(null) {
        return 14
    }
    let arguments: Object?[] = [2]
    let result = FunctionReflection.Invoke(function, arguments)
    return result match {
        .Ok(int value) => value
        _ => 0
    }
}
