class Counter {
    public var Value: int = 0

    func +=(amount: int) {
        Value = Value + amount
    }

    func %=(amount: int) { Value = Value % amount }
    func <<=(count: int) { Value = Value << count }
    func >>=(count: int) { Value = Value >> count }
    func >>>=(count: int) { Value = Value >>> count }

    func ++() { Value = Value + 1 }
    func --() { Value = Value - 1 }
    static func ++(value: Counter) -> Counter {
        let result = Counter()
        result.Value = value.Value + 2
        return result
    }

    static func +(left: Counter, right: int) -> Counter => Counter()
}

struct ValueCounter {
    public var Value: int = 0

    func +=(amount: int) {
        Value = Value + amount
    }

    func ++() { Value = Value + 1 }
    func --() { Value = Value - 1 }
}

class IndexCounter {
    private var calls: int = 0
    val Calls: int => calls

    func Index() -> int {
        calls = calls + 1
        return 0
    }
}

class Truth {
    public var State: int = 0

    static func true(value: Truth) -> bool => value.State > 0
    static func false(value: Truth) -> bool => value.State < 0
    static func &(left: Truth, right: Truth) -> Truth => right
    static func |(left: Truth, right: Truth) -> Truth => right
}

class TruthProbe {
    public var Calls: int = 0

    func Make(state: int) -> Truth {
        Calls = Calls + 1
        let value = Truth()
        value.State = state
        return value
    }
}

class Number {
    public var Value: int = 0

    static func Make(value: int) -> Number {
        let number = Number()
        number.Value = value
        return number
    }

    static func +(left: Number, right: Number) -> Number => Make(left.Value + right.Value)
    static func -(left: Number, right: Number) -> Number => Make(left.Value - right.Value)
    static func *(left: Number, right: Number) -> Number => Make(left.Value * right.Value)
    static func /(left: Number, right: Number) -> Number => Make(left.Value / right.Value)
    static func %(left: Number, right: Number) -> Number => Make(left.Value % right.Value)
    static func &(left: Number, right: Number) -> Number => Make(left.Value & right.Value)
    static func |(left: Number, right: Number) -> Number => Make(left.Value | right.Value)
    static func ^(left: Number, right: Number) -> Number => Make(left.Value ^ right.Value)
    static func <<(left: Number, count: int) -> Number => Make(left.Value << count)
    static func >>(left: Number, count: int) -> Number => Make(left.Value >> count)
    static func >>>(left: Number, count: int) -> Number => Make(left.Value >>> count)
    static func +(value: Number) -> Number => Make(+value.Value)
    static func -(value: Number) -> Number => Make(-value.Value)
    static func ~(value: Number) -> Number => Make(~value.Value)
    static func !(value: Number) -> bool => value.Value == 0
    static func ==(left: Number, right: Number) -> bool => left.Value == right.Value
    static func !=(left: Number, right: Number) -> bool => left.Value != right.Value
    static func <(left: Number, right: Number) -> bool => left.Value < right.Value
    static func <=(left: Number, right: Number) -> bool => left.Value <= right.Value
    static func >(left: Number, right: Number) -> bool => left.Value > right.Value
    static func >=(left: Number, right: Number) -> bool => left.Value >= right.Value
    static func ++(value: Number) -> Number => Make(value.Value + 1)
    static func --(value: Number) -> Number => Make(value.Value - 1)
    static func implicit(value: int) -> Number => Make(value)
    static func explicit(value: Number) -> int => value.Value
}

class Program {

    static func Main() -> int {
        var counter = Counter()
        let alias = counter
        counter += 10
        if alias.Value != 10 {
            return 1
        }

        var value = ValueCounter()
        value += 12
        if value.Value != 12 {
            return 2
        }

        let indexes = IndexCounter()
        let values: Counter[] = [Counter()]
        values[indexes.Index()] += 20
        if values[0].Value != 20 || indexes.Calls != 1 {
            return 3
        }

        var shifts = Counter()
        shifts += 85
        shifts %= 43
        shifts <<= 2
        shifts >>= 1
        shifts >>>= 1
        if shifts.Value != 42 {
            return 4
        }

        var signed = -1
        signed >>>= 1
        if signed != 2147483647 || (-1 >>> -1) != 1 || (-1 >>> 32) != -1 {
            return 5
        }

        var wide: long = -1
        wide >>>= 63
        wide <<= 6
        wide >>= 1
        wide %= 21
        if wide != 11 {
            return 6
        }

        var increment = Counter()
        increment++
        let prefixed = ++increment
        if prefixed.Value != 2 || increment.Value != 2 { return 7 }
        let old = increment++
        if old.Value != 2 || increment.Value != 4 { return 8 }
        increment--
        if increment.Value != 3 { return 9 }

        var number = ValueCounter()
        number++
        let updated = ++number
        if updated.Value != 2 || number.Value != 2 { return 10 }
        number--
        if number.Value != 1 { return 11 }

        let probe = TruthProbe()
        let stopped = probe.Make(-1) && probe.Make(42)
        if probe.Calls != 1 || stopped.State != -1 { return 12 }
        let continued = probe.Make(0) && probe.Make(42)
        if probe.Calls != 3 || continued.State != 42 { return 13 }
        let accepted = probe.Make(1) || probe.Make(0)
        if probe.Calls != 4 || accepted.State != 1 { return 14 }
        while accepted { accepted.State = 0 }
        if accepted { return 15 }

        let a: Number = 21
        let b: Number = 2
        if (a + b).Value != 23 { return 16 }
        if (a - b).Value != 19 { return 16 }
        if (a * b).Value != 42 { return 16 }
        if (a / b).Value != 10 { return 16 }
        if (a % b).Value != 1 { return 16 }
        if (a & b).Value != 0 { return 16 }
        if (a | b).Value != 23 { return 16 }
        if (a ^ b).Value != 23 { return 16 }
        if (a << 1).Value != 42 { return 16 }
        if (a >> 1).Value != 10 { return 16 }
        if (a >>> 1).Value != 10 { return 16 }
        if (+a).Value != 21 { return 16 }
        if (-a).Value != -21 { return 16 }
        if (~a).Value != -22 { return 16 }
        if a == b || !(a != b) || a < b || a <= b || !(a > b) || !(a >= b) { return 17 }
        if !a { return 18 }
        if (int)a != 21 { return 19 }
        var incremented = a
        let incrementResult = ++incremented
        let previous = incremented--
        if incrementResult.Value != 22 || previous.Value != 22 || incremented.Value != 21 { return 20 }

        return alias.Value + value.Value + values[0].Value
    }
}
