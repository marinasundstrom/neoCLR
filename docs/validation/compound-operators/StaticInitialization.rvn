class Counter {
    static field Count: int
    static func Next() -> int {
        Count += 1
        return Count
    }
}

class Cache<T> {
    static readonly field Value: int = Counter.Next()
}

class State {
    static readonly field Value: int = 10
    static init() {
        Value += 30
    }
    static func Read() -> int => Value
}

func Main() -> int {
    if Cache<int>.Value != 1 { return 1 }
    if Cache<string>.Value != 2 { return 2 }
    if Cache<int>.Value != 1 { return 3 }
    if Counter.Count != 2 { return 4 }
    return State.Read() + Counter.Count
}
