public class Consumer<Unused, T> : Base<T> {
    init(value: T) : base(value) { }
    public override func Select(value: T) -> T => base.Echo(Get())
}

func Main() -> int {
    let first: Base<int> = Derived<bool, int>(40)
    let second: Base<int> = Consumer<bool, int>(2)
    let references: Base<Base<int>> = Consumer<bool, Base<int>>(first)
    if !System.Object.ReferenceEquals(references.Select(second), first) {
        return 1
    }
    return first.Select(99) + second.Select(99)
}
