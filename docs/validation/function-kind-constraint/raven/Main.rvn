class Incrementer {
    private val step: int

    init(step: int) {
        self.step = step
    }

    func Apply(value: int) -> int => value + step
}

func Forward<F>(callback: F) -> F where F: func => Keep<F>(callback)

func Main() -> int {
    let incrementer = Incrementer(2)
    let callback: (int) -> int = incrementer.Apply
    let slot = FunctionSlot<(int) -> int>(callback)
    let function = Forward<(int) -> int>(slot.Get())
    return function(40)
}
