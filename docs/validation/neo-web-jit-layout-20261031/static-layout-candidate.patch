+
+/// Dense storage identities for one immutable selected module. Field lowering
+/// and initializer guards must share the same source-order owner inventory.
+pub(super) struct StorageLayout {
+    pub owners: Vec<usize>,
+    pub ordinals: Vec<usize>,
+}
+
+impl StorageLayout {
+    pub fn new(input: &Module) -> Self {
+        let mut owners = Vec::new();
+        let mut ordinals = Vec::with_capacity(input.types.len());
+        for (index, owner) in input.types.iter().enumerate() {
+            ordinals.push(owners.len());
+            if needs_storage(input, owner) {
+                owners.push(index);
+            }
+        }
+        Self { owners, ordinals }
+    }
+}
 pub(super) fn entry_owner<'a>(input: &Module, f: &'a Function) -> Option<&'a Type> {
     if f.name.ends_with("..cctor") {
         return None;
@@ -38,3 +59,36 @@ pub(super) fn owner_type(owner: &TypeDef) -> Type {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn storage_layout_keeps_field_and_initializer_owners_in_source_order() {
+        let mut input = neoclr::assemble(
+            ".module Storage\n.type class Empty\n.end\n.type class Fields\n.end\n\
+             .type class Initializer\n.method private static .cctor() -> void\nret\n.end\n.end\n\
+             .type class Gap\n.end\n.type class Both\n.method private static .cctor() -> void\nret\n.end\n.end\n\
+             .function Main() -> Int32\nldc.i4 0\nret\n.end\n",
+        ).unwrap();
+        for index in [1, 4] {
+            input.types[index]
+                .static_fields
+                .push(neoclr::metadata::StaticField {
+                    name: "Value".into(),
+                    ty: Type::Int32,
+                    readonly: false,
+                    visibility: neoclr::metadata::Visibility::Public,
+                });
+        }
+        let layout = StorageLayout::new(&input);
+        assert_eq!(layout.owners, [1, 2, 4]);
+        assert_eq!(layout.ordinals, [0, 0, 1, 2, 2]);
+        // A fresh profile after a module change cannot reuse earlier ordinals.
+        input.types[1].static_fields.clear();
+        let layout = StorageLayout::new(&input);
+        assert_eq!(layout.owners, [2, 4]);
+        assert_eq!(layout.ordinals, [0, 0, 0, 1, 1]);
+    }
+}
