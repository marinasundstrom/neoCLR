func Main() -> int {
    let leaf = Leaf(40)
    let parent: Base<int> = leaf
    let view: View<int> = leaf
    let references = Derived<bool, Base<int>>(parent, 2)
    if !System.Object.ReferenceEquals(references.Get(), parent) {
        return 1
    }
    leaf.Count = 3
    if parent.Get() != 40 {
        return 2
    }
    return references.Get().Get() + view.Echo(leaf.Count) - 1
}
