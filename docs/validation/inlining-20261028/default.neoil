.module InlineBench
.references ()
.function Main(Int32 count) -> Int32
.local Int32 i
.local Int32 sum
ldc.i4 0
stloc 0
ldc.i4 0
stloc 1
loop:
ldloc 1
ldloc 0
call Leaf(Int32)
add
stloc 1
ldloc 0
ldc.i4 1
add
stloc 0
ldloc 0
ldarg 0
blt loop
ldloc 1
ret
.end
.function Leaf(Int32 value) -> Int32
ldarg 0
ldc.i4 8
mul
ret
.end
