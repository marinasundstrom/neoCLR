import System.*

class Cell {
    var Number: int
    init(number: int) {
        Number = number
    }
}

class Key {
    private field storedNumber: int
    val Number: int => storedNumber
    init(number: int) {
        storedNumber = number
    }
    override func Equals(other: Object?) -> bool {
        if other is Key key {
            return Number == key.Number
        }
        return false
    }
    override func GetHashCode() -> int {
        return Number
    }
}

func Check(condition: bool, description: string) {
    if !condition {
        System.Fault(description)
    }
    Console.WriteLine(description)
}

func SameValue(left: Object, right: Object?) -> bool {
    return left.Equals(right)
}

func Hash(value: Object) -> int {
    return value.GetHashCode()
}

func Main() {
    let absent: Object? = null
    let present: Object = Cell(1)
    let nullableBox: Object = 42
    if !Object.ReferenceEquals(null, null) || !Object.ReferenceEquals(absent, null)
        || Object.ReferenceEquals(present, null) || Object.ReferenceEquals(null, present)
        || present.Equals(null) || present.Equals(absent)
        || Key(1).Equals(null) || nullableBox.Equals(null) || SameValue(present, null) {
        System.Fault("Object equality must accept nullable arguments and preserve null semantics")
    }
    let cell = Cell(1)
    let alias = cell
    let hash = Hash(cell)
    alias.Number = 2
    Check(Object.ReferenceEquals(cell, alias), "Aliases share identity")
    Check(SameValue(cell, alias), "Default equality follows identity")
    Check(!SameValue(cell, Cell(2)), "Equal fields do not make two cells equal")
    Check(hash == Hash(alias), "Mutation preserves the default hash")

    let first = Key(42)
    let second = Key(42)
    Check(!Object.ReferenceEquals(first, second), "Equal keys remain distinct objects")
    Check(SameValue(first, second), "An override supplies key equality")
    Check(Hash(first) == Hash(second), "Equal keys supply equal hashes")
    Check(!SameValue(first, cell), "Key equality rejects another type")

    var number = 42
    let boxed: Object = number
    let equalBox: Object = 42
    number = 7
    Check(!Object.ReferenceEquals(boxed, equalBox), "Equal boxed integers have distinct identities")
    Check(SameValue(boxed, equalBox), "Boxed integers compare their values")
    Check(!SameValue(boxed, first), "Boxed integer equality checks the concrete type")
    Check(Hash(boxed) == 42 && Hash(boxed) == Hash(equalBox), "Boxed integer hashes preserve the copied value")
}
