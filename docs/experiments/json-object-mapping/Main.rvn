import System.*
import System.Data.Json.*
import System.IO.*
import System.Result.*
import System.Concurrency.Tasks.*

func Check(condition: bool) {
    if !condition {
        Panic("JSON object mapping check failed")
    }
}

// This orchestration preserves independent stream, JSON and mapping failures.
// MappingError still owns the application's schema-specific cases.
async func ReadReport(stream: MemoryStream) -> Task<Result<StationReport, StreamError | JsonError | MappingError>> {
    _ = stream.Seek(0)?
    let document = await JsonSerializer.DeserializeNode(stream)?
    let report = DecodeReport(document)?
    return Ok(report)
}

async func RoundTrip() -> Task<Result<unit, StreamError | JsonError | MappingError>> {
    let document = JsonSerializer.DeserializeNode("{\"station\":\"Café\"}")?
    let report = DecodeReport(document)?
    Check(report.Station == "Café")
    Check(report.Assignments == 1)
    let mapped = EncodeReport(report)?
    let text = JsonSerializer.SerializeNode(mapped)?
    Check(text == "{\"station\":\"Café\"}")

    // Serializer borrows the stream; mapping remains a separate DOM operation.
    let stream = MemoryStream()
    _ = await JsonSerializer.SerializeNode(stream, mapped)?
    let restored = await ReadReport(stream)?
    Check(restored.Station == report.Station)
    Check(restored.Assignments == 1)
    stream.Close()

    let missing = JsonObject()
    Check(DecodeReport(missing) is Failure(MappingError.Json(JsonError.MissingField(_))))
    _ = missing.Add("station", JsonNull())?
    Check(DecodeReport(missing) is Failure(MappingError.Json(JsonError.TypeMismatch(_))))
    Check(DecodeReport(JsonArray()) is Failure(MappingError.Json(JsonError.TypeMismatch(_))))
    return Ok(())
}

async func ErrorAlternatives() -> Task<()> {
    let closed = MemoryStream()
    closed.Close()
    let Failure(streamFailure) = await ReadReport(closed) else {
        Panic("Expected stream failure")
    }
    if streamFailure is StreamError error {
        Check(error is StreamError.Closed)
    } else {
        Panic("Stream failure was relabeled")
    }

    let empty = MemoryStream()
    let invalidJson = await ReadReport(empty)
    empty.Close()
    let Failure(jsonFailure) = invalidJson else {
        Panic("Expected JSON failure")
    }
    if jsonFailure is JsonError error {
        Check(error is JsonError.Syntax(_))
    } else {
        Panic("JSON failure was relabeled")
    }

    let missingField = MemoryStream()
    let Ok(_) = await JsonSerializer.SerializeNode(missingField, JsonObject()) else {
        Panic("Could not prepare mapping fixture")
    }
    let invalidMapping = await ReadReport(missingField)
    missingField.Close()
    let Failure(mappingFailure) = invalidMapping else {
        Panic("Expected mapping failure")
    }
    if mappingFailure is MappingError error {
        Check(error is MappingError.Json(JsonError.MissingField("station")))
    } else {
        Panic("Mapping failure lost its domain boundary")
    }
}

async func Main() -> Task<()> {
    if let Ok(_) = await RoundTrip() {
        await ErrorAlternatives()
        Console.WriteLine("JSON object mapping checks passed")
    } else {
        Panic("JSON object mapping failed")
    }
}
