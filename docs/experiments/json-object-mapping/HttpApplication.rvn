import System.*
import System.Concurrency.Tasks.*
import System.Data.Json.*
import System.Result.*
import System.Web.Http.*
import System.Web.Http.Json.*

union AppError {
    case Http(reason: HttpError)
    case Json(reason: JsonError)
    case Body(message: string)

    override func ToString() -> string {
        return match self {
            Http(let reason) => reason.ToString()
            Json(let reason) => reason.ToString()
            Body(let message) => message
        }
    }
}

// Conversions belong to this application; the library retains the original errors.
extension HttpErrorConversion for HttpError {
    static func implicit(error: HttpError) -> AppError => AppError.Http(error)
}

extension JsonErrorConversion for JsonError {
    static func implicit(error: JsonError) -> AppError => AppError.Json(error)
}

// Exact property names deliberately match the existing wire schema.
public class ReportPayload {
    init() { }
    var station: string { get; set; } = ""
}

public class Acknowledgement {
    init() { }
    var accepted: bool { get; set; } = false
}

func CreateReport() -> Result<ReportPayload, JsonError> {
    let report = ReportPayload()
    report.station = "Café"
    return Ok(report)
}

async func Acknowledge(content: HttpContent) -> Task<Result<Acknowledgement, JsonError>> {
    _ = await content.ReadFromJson<ReportPayload>()?
    let reply = Acknowledgement()
    reply.accepted = true
    return Ok(reply)
}

func PrepareReport() -> Result<HttpContent, AppError> {
    let report = CreateReport()?
    let content = JsonContent.Create(report)?
    return Ok(content)
}

// The application owns this domain mapping; the client library preserves causes.
func AdaptClientResult<T>(result: Result<T, HttpError | JsonError>) -> Result<T, AppError> {
    return match result {
        Ok(let value) => Ok(value)
        Failure(let error) => match error {
            HttpError reason => Failure(AppError.Http(reason))
            JsonError reason => Failure(AppError.Json(reason))
        }
    }
}

func ReadReply(result: Result<HttpClientResponse, HttpError | JsonError>) -> Result<string, AppError> {
    let response = AdaptClientResult(result)?
    if response.StatusCode != HttpStatusCode.Created {
        return Failure(AppError.Http(HttpError.UnsuccessfulStatus(response.StatusCode)))
    }
    let reply = JsonContent.Read<Acknowledgement>(response.Content)?
    if reply.accepted {
        let output = JsonSerializer.Serialize(reply)?
        return Ok(output)
    }
    return Failure(AppError.Body("Unexpected acknowledgement"))
}
