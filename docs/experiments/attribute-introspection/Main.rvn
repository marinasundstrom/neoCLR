import System.*
import System.Linq.*
import System.Collections.*
import System.Introspection.*
import System.Option.*

public class NoteAttribute : Attribute {
    init(text: string, number: int, enabled: bool) {
        System.Fail("Attribute constructors must not run during introspection")
    }
}

[Note("type", 42, true)]
public class Item {
    [Note("field", 42, true)]
    public field Number: int;

    [Note("property", 42, true)]
    var Name: string { get; set; } = "Lamp"

    [Note("constructor", 42, true)]
    init([Note("constructor parameter", 42, true)] number: int) {
        Number = number
    }

    [Note("method", 42, true)]
    func Read([Note("parameter", 42, true)] suffix: string) -> string {
        return Name + suffix
    }
}

[AttributeUsage(AttributeTargets.All, AllowMultiple: true)]
public class LabelAttribute : Attribute {
    init(text: string) {
        System.Fail("Repeated attribute constructors must not run")
    }
}

[Label("first"), Note("middle", 42, true)]
[Label("last")]
public class RepeatedItem { }

public class PlainItem { }

public union AppRoutes {
    [Note("route", 42, true)]
    case Item(id: int)
}

func FindNote(member: MemberInfo) -> Option<string> {
    for attribute in member.GetCustomAttributesData() {
        if attribute.AttributeType.Equals(typeof(NoteAttribute)) {
            let arguments = attribute.GetConstructorArguments()
            if arguments[0].Value is string text {
                return Some(text)
            }
        }
    }
    return None
}

public func Check(attributes: Sequence<CustomAttributeData>, text: string) {
    if attributes.Count != 1 {
        System.Fail("Wrong attribute count")
        return
    }
    let attribute = attributes[0]
    if ((NominalTypeInfo)attribute.AttributeType).Name != "NoteAttribute" || attribute.Constructor.Name != ".ctor" {
        System.Fail("Wrong attribute identity")
        return
    }
    let arguments = attribute.GetConstructorArguments()
    if arguments.Count != 3 {
        System.Fail("Wrong argument count")
        return
    }
    if arguments[0].Value is string value {
        if value != text {
            System.Fail("Wrong text argument")
        }
    } else {
        System.Fail("Missing text argument")
    }
    if arguments[1].Value is int number {
        if number != 42 {
            System.Fail("Wrong numeric argument")
        }
    } else {
        System.Fail("Missing numeric argument")
    }
    if arguments[2].Value is bool enabled {
        if !enabled {
            System.Fail("Wrong Boolean argument")
        }
    } else {
        System.Fail("Missing Boolean argument")
    }
    let erased: Object = arguments
    let copied = (CustomAttributeTypedArgument[])erased
    copied[0] = copied[1]
    let fresh = attribute.GetConstructorArguments()
    if !fresh[0].ArgumentType.Equals(typeof(string)) {
        System.Fail("A caller changed the stored metadata snapshot")
    }
    if !fresh[0].ArgumentType.Equals(typeof(string)) || !arguments[1].ArgumentType.Equals(typeof(int)) || !arguments[2].ArgumentType.Equals(typeof(bool)) {
        System.Fail("Wrong argument types")
    }
}

func Main() {
    if ((NominalTypeInfo)typeof(PlainItem)).GetCustomAttributesData().Count != 0 {
        System.Fail("Unannotated type has attributes")
    }
    let repeated = ((NominalTypeInfo)typeof(RepeatedItem)).GetCustomAttributesData()
    if repeated.Count != 3 {
        System.Fail("Multiple attributes were lost")
    }
    if repeated[0].GetConstructorArguments()[0].Value is string first {
        if first != "first" {
            System.Fail("Attribute order changed")
        }
    } else {
        System.Fail("First repeated attribute missing")
    }
    if repeated[2].GetConstructorArguments()[0].Value is string last {
        if last != "last" {
            System.Fail("Repeated attribute order changed")
        }
    } else {
        System.Fail("Last repeated attribute missing")
    }
    if !repeated[1].AttributeType.Equals(typeof(NoteAttribute)) {
        System.Fail("Mixed attribute declaration missing")
    }
    let routeType = (NominalTypeInfo)typeof(AppRoutes)
    var routeCases = 0
    if let Some(module) = routeType.Module {
        for candidate in module.GetTypes().OfType<NominalTypeInfo>() {
            if let Some(parent) = candidate.DeclaringType {
                if parent.Equals(routeType) {
                    Check(candidate.GetCustomAttributesData(), "route")
                    routeCases += 1
                }
            }
        }
    }
    if routeCases != 1 {
        System.Fail("Union case metadata missing")
    }
    let type = (NominalTypeInfo)typeof(Item)
    let Some(note) = FindNote(type) else {
        System.Fail("Attribute lookup failed")
        return
    }
    if note != "type" {
        System.Fail("Wrong startup metadata")
    }
    Check(type.GetCustomAttributesData(), "type")
    var checks = 0
    for member in type.GetFields() {
        if member.Name == "Number" {
            Check(member.GetCustomAttributesData(), "field")
            checks += 1
        }
    }
    for property in type.GetProperties() {
        Check(property.GetCustomAttributesData(), "property")
        checks += 1
    }
    for constructor in type.GetConstructors() {
        Check(constructor.GetCustomAttributesData(), "constructor")
        checks += 1
        Check(constructor.GetParameters()[0].GetCustomAttributesData(), "constructor parameter")
    }
    for method in type.GetMethods() {
        if method.Name == "Read" {
            Check(method.GetCustomAttributesData(), "method")
            checks += 1
            Check(method.GetParameters()[0].GetCustomAttributesData(), "parameter")
        }
    }
    Check(type.GetCustomAttributesData(), "type")
    if checks != 4 {
        System.Fail("Missing attributed members")
    }
    if ReadRouteDeclarations() != 2 {
        System.Fail("Catalog route metadata missing")
    }
    Console.WriteLine("Attribute introspection checks passed")
}
