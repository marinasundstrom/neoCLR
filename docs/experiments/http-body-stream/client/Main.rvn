import System.*
import System.Concurrency.Tasks.*
import System.Optional.*
import System.Result.*
import System.Web.Http.*

async func Main(arguments: string[]) -> Task<()> {
    let client = HttpClient()
    for mode in 0..9 {
        let Ok(request) = HttpClientRequest.Get(arguments[0]) else { Panic("Request failed") }
        let Ok(response) = await client.Send(request, HttpCompletionOption.ResponseHeadersRead) else {
            Panic("Headers failed")
        }
        Check(!response.Content.IsBuffered)
        let Some(stream) = response.Content.TryGetStream() else { Panic("Missing body stream") }
        if mode == 1 {
            let Ok(forward) = HttpClientRequest.Post(arguments[0], response.Content) else { Panic("Forward preparation failed") }
            Check((await client.Send(forward)) is Failure(HttpError.Unsupported(_)))
        }
        await Consume(stream, mode)
        response.Dispose()
        response.Dispose()
        Console.WriteLine("CASE")
    }
    client.Dispose()
    Console.WriteLine("DONE")
}
