import System.*
import System.Collections.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.IO.*
import System.Time.*
import System.Result.*
import System.Web.Http.*

func Check(value: bool) {
    if !value {
        System.Fail("Response stream contract failed")
    }
}

class GeneratedInput : InputStream {
    private val mode: int
    private var registration: CancellationRegistration? = null
    var Position: int = 0
    var Reads: int = 0
    var Closes: int = 0

    init(mode: int) {
        self.mode = mode
    }

    func Read(buffer: byte[], offset: int, count: int) -> Task<Result<int, StreamError>> {
        return Read(buffer, offset, count, CancellationToken.None)
    }

    func Read(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        // Deferred producer checks the buffer remains valid across scheduling.
        let pending = Promise<Result<int, StreamError>>()
        if mode >= 8 {
            Reads += 1
            registration = cancellationToken.Register(() => {
                _ = pending.Cancel()
            })
            return pending.Task
        }
        TaskQueue.Default.Post(() => {
            _ = pending.Complete(ReadCore(buffer, offset, count))
        })
        return pending.Task
    }

    private func ReadCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        Check(Closes == 0 && offset == 0 && count > 0 && count <= 4096)
        Reads += 1
        if mode == 4 { return Ok(0) }
        if mode == 5 { return Failure(StreamError.AccessDenied) }
        if mode == 6 { return Ok(count + 1) }
        let read = if mode == 1 { count } else if count > 71 { 71 } else { count }
        var index = 0
        while index < read {
            buffer[index] = (byte)((Position + index) % 251)
            index += 1
        }
        Position += read
        return Ok(read)
    }

    func Close() {
        Closes += 1
        if registration is CancellationRegistration active {
            registration = null
            active.Dispose()
        }
    }
}

// Outcome observation: an awaited cancelled task cannot yield a Result value.
func ObserveCancellation(pending: Task<Result<System.Void, HttpError>>) -> Task<bool> {
    let observed = Promise<bool>()
    pending.OnCompleted(() => {
        _ = observed.Complete(pending.IsCancelled)
    })
    return observed.Task
}

async func Main() -> Task<()> {
    let options = HttpServerOptions()
    options.ResponseWriteTimeout = Duration.FromTicks(30000000L)
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 16, options) else {
        System.Fail("Listen failed")
    }
    let Ok(port) = server.GetLocalPort() else {
        System.Fail("Port failed")
    }
    Console.WriteLine(port)
    for mode in 0..10 {
        let Ok(context) = await server.Accept() else {
            System.Fail("Accept failed")
        }
        let input = GeneratedInput(mode)
        let length = if mode == 3 { 0 } else if mode == 1 { 8193 } else { 1025 }
        let Ok(content) = HttpStreamContent.Create(input, length, mode == 1) else {
            System.Fail("Content failed")
        }
        if mode == 7 { content.Dispose() }
        context.Respond(HttpStatusCode.OK, content)
        let cancellation = CancellationTokenSource()
        if mode == 8 {
            cancellation.CancelAfter(Duration.FromTicks(10000000L))
        }
        let sending = context.Complete(cancellation.Token)
        if mode == 0 { context.RespondText("Later mutation must not replace the admitted source") }
        if mode == 8 {
            Check(await ObserveCancellation(sending))
        } else {
            let result = await sending
            if mode == 9 {
                Check(result is Failure(HttpError.TimedOut))
            } else if mode < 4 {
                Check(result is Ok(_))
            } else if mode == 5 {
                Check(result is Failure(HttpError.Content(StreamError.AccessDenied)))
            } else if mode == 7 {
                Check(result is Failure(HttpError.InvalidRequest(_)))
            } else {
                Check(result is Failure(HttpError.Content(StreamError.IoFailure)))
            }
        }
        cancellation.Dispose()
        Check(input.Closes == if mode == 1 { 0 } else { 1 })
        if mode == 1 {
            Check(input.Position == 8193 && input.Reads == 3)
        } else if mode == 0 {
            Check(input.Position == 1025 && input.Reads == 15)
        } else if mode == 2 || mode == 3 || mode == 7 {
            Check(input.Reads == 0)
        } else {
            Check(input.Reads == 1)
        }
        context.Dispose()
        content.Dispose()
        Check(input.Closes == if mode == 1 { 0 } else { 1 })
        if mode == 1 { input.Close() }
        Console.WriteLine("CASE")
    }
    server.Close()
    Console.WriteLine("DONE")
}
