import System.*

record struct Position(Value: Index)
record struct Interval(Value: Range)

func Main(args: string[]) {
    var count = 0
    if args[0] == "allocation" {
        count = 128
    }
    var i = 0
    while i < count {
        let key = Position(Index(i))
        let same = Position(Index.FromStart(i))
        let range = Interval(Range(Index.Start, Index(i)))
        let sameRange = Interval(Range(Index.Start, Index.FromStart(i)))
        if key != same || key.GetHashCode() != same.GetHashCode() ||
            range != sameRange || range.GetHashCode() != sameRange.GetHashCode() {
            Panic("imported component value semantics")
        }
        i += 1
    }
    Console.WriteLine("PASS")
}
