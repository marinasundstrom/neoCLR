import System.*
import System.Text.*
func Main() {
    let builder = StringBuilder(128)
    var iteration = 0
    while iteration < 64 {
        builder.Append("e").Append("́")
        let first = builder.ToString()
        builder.AppendLine("!").AppendLine("")
        let second = builder.ToString()
        if first != "é" || first.Length != 1 || second != "é!\n\n" {
            Panic("Snapshot or grapheme mismatch")
        }
        builder.Clear()
        if builder.Utf8ByteCount != 0 || builder.ToString() != "" || second != "é!\n\n" {
            Panic("Clear or immutable snapshot mismatch")
        }
        iteration += 1
    }
    let exact = StringBuilder(3).AppendLine("é")
    if exact.Utf8ByteCount != 3 || exact.ToString() != "é\n" {
        Panic("Exact byte quota mismatch")
    }
    let empty = StringBuilder(0).Append("").Clear()
    if empty.ToString() != "" {
        Panic("Empty mismatch")
    }
    Console.WriteLine("PASS StringBuilder reuse")
}
