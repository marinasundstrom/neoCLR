import System.*
import System.Text.*
func Main() -> int {
    var iteration = 0
    while iteration < 16 {
        var text = ""
        var index = 0
        while index < 1024 {
            text = String.Concat(text, "0123456789abcdef")
            index += 1
        }
        if text.GetUtf8ByteCount() != 16384 {
            System.Fail("Construction size mismatch")
        }
        iteration += 1
    }
    return 0
}
