module SchedulerContinuations {
    import System.*
    import System.Collections.*
    import System.Concurrency.Tasks.*
    import System.Runtime.CompilerServices.*

    // Internal experiment: managed outcome storage, runtime continuation dispatch.
    // The unpumped producer queue is deliberately never used for registration.
    class Completion : TaskAwaiter {
        private val source: Promise<int>
        private var callbacks = ArrayList<Continuation>()
        var Deliveries = 0
        val Observed = Promise<int>()

        init(producer: TaskQueue) {
            source = Promise<int>(producer)
        }

        val IsCompleted: bool => source.Task.IsCompleted
        val IsCancelled: bool => source.Task.IsCancelled
        func GetAwaiter() -> Completion => self
        func GetResult() -> int => source.Task.GetResult()

        func OnCompleted(callback: () -> System.Void) {
            _ = Subscribe(callback)
        }

        // Explicit observation adapter; ordinary consumers use await.
        func Subscribe(callback: () -> System.Void) -> Continuation {
            let registration = Continuation(callback)
            if IsCompleted {
                registration.Submit()
            } else {
                callbacks.Add(registration)
            }
            return registration
        }

        func Publish() -> System.Void {
            if IsCompleted {
                Panic("Duplicate completion")
            }
            Dispatch()
            if !source.Complete(42) {
                Panic("Duplicate completion")
            }
            return ()
        }

        func PublishFault() -> System.Void {
            Publish()
            Panic("fault after continuation submission")
            return ()
        }

        func Cancel() -> System.Void {
            if IsCompleted {
                Panic("Duplicate cancellation")
            }
            Dispatch()
            if !source.Cancel() {
                Panic("Duplicate cancellation")
            }
            return ()
        }

        private func Dispatch() {
            let pending = callbacks
            Continuation.SubmitBatch(pending)
            callbacks = ArrayList<Continuation>()
        }

        // Explicit OnCompleted below tests deferred outcome observation, not await.
        func Observe() -> System.Void {
            if !IsCompleted {
                Panic("Observer ran before completion")
            }
            Deliveries += 1
            Observed.Complete(Deliveries)
            return ()
        }
    }

    func UnpumpedProducer() -> TaskQueue {
        let queue = TaskQueue()
        queue.Post(ProducerPumpForbidden)
        return queue
    }

    func ProducerPumpForbidden() -> System.Void {
        Panic("producer queue was pumped")
        return ()
    }
}

module neoCLR.Runtime {
    import System.Runtime.CompilerServices.*

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerSubmit(callback: () -> System.Void) -> int;

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerCapture() -> long;

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerSubmitTo(destination: long, callback: () -> System.Void) -> int;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerRegister(destination: long, callback: () -> System.Void) -> long;

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerActivate(registration: long) -> bool;

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerCancel(registration: long) -> bool;

}
