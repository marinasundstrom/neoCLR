module SchedulerContinuations {
    import System.*
    import System.Concurrency.Tasks.*

    async func Main() -> Task<int> {
        let source = Completion(UnpumpedProducer())
        _ = neoCLR.Runtime.SchedulerSubmit(source.PublishFault)
        _ = await source
        Panic("Continuation ran after terminal fault")
        return 0
    }
}
