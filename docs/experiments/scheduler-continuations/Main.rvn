module SchedulerContinuations {
    import System.*
    import System.Collections.*
    import System.Concurrency.Tasks.*
    import System.Runtime.CompilerServices.*

    async func Consume(completion: Completion) -> Task<int> {
        let value = await completion
        return value
    }

    async func Pending() -> Task<int> {
        let producer = UnpumpedProducer()
        let pending = Completion(producer)
        let first = Consume(pending)
        let second = Consume(pending)
        if first.IsCompleted || second.IsCompleted {
            Panic("Pending await completed inline")
        }
        _ = neoCLR.Runtime.SchedulerSubmit(pending.Publish)
        let one = await first
        let two = await second
        if one != 42 || two != 42 {
            Panic("Pending continuation result mismatch")
        }
        return 0
    }

    async func Completed() -> Task<int> {
        let producer = UnpumpedProducer()
        let completed = Completion(producer)
        completed.Publish()
        let immediate = Consume(completed)
        if !immediate.IsCompleted {
            Panic("Completed await unnecessarily suspended")
        }
        let value = await immediate
        if value != 42 {
            Panic("Completed await result mismatch")
        }
        completed.OnCompleted(completed.Observe)
        if completed.Deliveries != 0 {
            Panic("Explicit observer ran inline")
        }
        _ = await completed.Observed.Task
        if completed.Deliveries != 1 {
            Panic("Explicit observer delivery mismatch")
        }
        return 0
    }

    async func Cancelled() -> Task<int> {
        let producer = UnpumpedProducer()
        let cancelled = Completion(producer)
        let waiting = Consume(cancelled)
        cancelled.OnCompleted(cancelled.Observe)
        _ = neoCLR.Runtime.SchedulerSubmit(cancelled.Cancel)
        let check = CancellationCheck(waiting)
        // Outcome observation deliberately avoids awaiting a cancelled result.
        waiting.OnCompleted(check.Observe)
        _ = await check.Done.Task
        _ = await cancelled.Observed.Task
        if !waiting.IsCancelled || cancelled.Deliveries != 1 {
            Panic("Cancelled continuation mismatch")
        }
        return 0
    }
    class CancellationCheck {
        private val task: Task<int>
        val Done = Promise<int>()

        init(task: Task<int>) {
            self.task = task
        }

        func Observe() -> System.Void {
            if !task.IsCancelled {
                Panic("Await did not propagate cancellation")
            }
            Done.Complete(1)
            return ()
        }
    }

    func CancelledRegistrationRan() -> System.Void {
        Panic("Cancelled registration was dispatched")
        return ()
    }

    async func RegistrationLifecycle() -> Task<int> {
        let operation = Completion(UnpumpedProducer())
        let withdrawn = Continuation(operation.Publish)
        if !withdrawn.Cancel() || withdrawn.Cancel() {
            Panic("Registration cancellation was not one-shot")
        }
        if operation.IsCompleted {
            Panic("Registration cancellation changed operation state")
        }
        let delivery = Continuation(operation.Publish)
        delivery.Submit()
        if delivery.Cancel() {
            Panic("Cancellation retracted admitted work")
        }
        if operation.IsCompleted {
            Panic("Activation completed operation inline")
        }
        let value = await operation
        if value != 42 {
            Panic("Activated continuation lost result")
        }
        return 0
    }

    func WithdrawObservers(operation: Completion) {
        var index = 0
        while index < 128 {
            use observer = operation.Subscribe(CancelledRegistrationRan)
            index += 1
        }
    }

    func WithdrawOnReturn(operation: Completion) {
        use observer = operation.Subscribe(CancelledRegistrationRan)
        return
    }

    func DisposeTwice(operation: Completion) {
        // Deliberate explicit disposal tests idempotence in addition to use cleanup.
        use observer = operation.Subscribe(CancelledRegistrationRan)
        observer.Dispose()
        observer.Dispose()
        if observer.TrySubmit() {
            Panic("Withdrawn observer was reactivated")
        }
    }

    func ObserveCompleted(operation: Completion) {
        use observer = operation.Subscribe(operation.Observe)
        if observer.TrySubmit() {
            Panic("Admitted observer was submitted twice")
        }
        if operation.Deliveries != 0 {
            Panic("Observation was not deferred")
        }
    }

    async func ObserverDisposal() -> Task<int> {
        let operation = Completion(UnpumpedProducer())
        WithdrawObservers(operation)
        WithdrawOnReturn(operation)
        DisposeTwice(operation)
        if operation.IsCompleted {
            Panic("Observer disposal changed task state")
        }
        // A surviving waiter still completes; withdrawn subscriptions are skipped.
        _ = neoCLR.Runtime.SchedulerSubmit(operation.Publish)
        let value = await operation
        if value != 42 {
            Panic("Disposal disrupted surviving awaiter")
        }
        ObserveCompleted(operation)
        _ = await operation.Observed.Task
        if operation.Deliveries != 1 {
            Panic("Disposal retracted admitted work")
        }
        return 0
    }

    async func Main() -> Task<int> {
        _ = await Pending()
        Console.WriteLine("PASS multiple pending awaits without producer pump")
        _ = await Completed()
        Console.WriteLine("PASS completed await and deferred observer")
        _ = await Cancelled()
        Console.WriteLine("PASS cancellation without producer pump")
        _ = await RegistrationLifecycle()
        Console.WriteLine("PASS registration lifecycle is separate from task state")
        _ = await ObserverDisposal()
        Console.WriteLine("PASS scoped observer disposal preserves task state and admitted work")
        let abandoned = Continuation(CancelledRegistrationRan)
        Console.WriteLine("PASS dormant registration does not keep invocation alive")
        return 0
    }

}
