module SchedulerContinuations {
    import System.*
    import System.Collections.*

    // Alternative ownership experiment: pending callbacks are ordinary managed
    // edges. Runtime admission happens only when the operation completes.
    class Continuation : Disposable {
        private val destination: long
        private var callbacks = ArrayList<() -> System.Void>()
        private var submitted = false
        private var withdrawn = false

        init(callback: () -> System.Void) {
            destination = neoCLR.Runtime.SchedulerCapture()
            callbacks.Add(callback)
        }

        static func SubmitBatch(pending: ArrayList<Continuation>) {
            let destination = neoCLR.Runtime.SchedulerCapture()
            var count = 0
            for registration in pending {
                if registration.ValidatePending(destination) {
                    count += 1
                }
            }
            if count == 0 {
                return
            }
            let batch = ContinuationBatch(pending)
            // No managed registration changes until this single admission succeeds.
            _ = neoCLR.Runtime.SchedulerSubmitTo(destination, batch.Run)
            for registration in pending {
                registration.Admit()
            }
        }

        func ValidatePending(current: long) -> bool {
            if submitted || withdrawn {
                return false
            }
            if destination != current {
                System.Fail("Scheduler destination is not current")
            }
            return true
        }

        func Admit() {
            if !withdrawn {
                submitted = true
            }
        }

        func InvokeAdmitted() {
            if withdrawn || callbacks.Count == 0 {
                return
            }
            let callback = callbacks[0]
            callbacks = ArrayList<() -> System.Void>()
            callback()
        }

        func TrySubmit() -> bool {
            if submitted || withdrawn {
                return false
            }
            _ = neoCLR.Runtime.SchedulerSubmitTo(destination, callbacks[0])
            callbacks = ArrayList<() -> System.Void>()
            submitted = true
            return true
        }

        func Submit() {
            if !TrySubmit() {
                System.Fail("Continuation registration already consumed")
            }
        }

        func Cancel() -> bool {
            if submitted || withdrawn {
                return false
            }
            callbacks = ArrayList<() -> System.Void>()
            withdrawn = true
            return true
        }

        func Dispose() {
            _ = Cancel()
        }
    }

    // Transitional adapter: one runtime-owned callable roots the entire batch.
    // It drains in one turn; incremental runtime dispatch remains future work.
    class ContinuationBatch {
        private val pending: ArrayList<Continuation>

        init(pending: ArrayList<Continuation>) {
            self.pending = pending
        }

        func Run() -> System.Void {
            for registration in pending {
                registration.InvokeAdmitted()
            }
            return ()
        }
    }
}
