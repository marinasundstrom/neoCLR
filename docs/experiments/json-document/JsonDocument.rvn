import System.*
import System.Collections.*
import System.Result.*
import System.Text.*

public class DocumentReader {
    private field source: string
    private field bytes: Sequence<byte>
    private field position: int
    private field nodes: int

    init(text: string) {
        source = text
        bytes = Utf8.Encode(text)
        position = 0
        nodes = 0
    }

    private func Skip() {
        while position < bytes.Count && Whitespace(bytes[position]) {
            position += 1
        }
    }

    private func Take(value: byte) -> bool {
        Skip()
        if position < bytes.Count && bytes[position] == value {
            position += 1
            return true
        }
        return false
    }

    private func Slice(start: int) -> Result<string, string> {
        match source.SliceUtf8(start, position - start) {
            Ok(let text) => return Ok(text)
            Error(_) => return Error("Invalid token boundary")
        }
    }

    private func ReadString() -> Result<string, string> {
        Skip()
        let start = position
        if !Take((byte)34) {
            return Error("Expected string")
        }
        var escaped = false
        while position < bytes.Count {
            let value = bytes[position]
            position += 1
            if escaped {
                escaped = false
            } else if value == 92 {
                escaped = true
            } else if value == 34 {
                let token = Slice(start)?
                return ReadMessage(token)
            }
        }
        return Error("Unclosed string")
    }

    private func Value(depth: int) -> Result<JsonValue, string> {
        Skip()
        nodes += 1
        if nodes > 32 || position == bytes.Count {
            return Error("Missing value or node limit exceeded")
        }
        let first = bytes[position]
        if first == 34 {
            let text = ReadString()?
            return Ok(JsonValue.StringValue(text))
        }
        if first == 123 || first == 91 {
            if depth >= 4 {
                return Error("Container depth exceeds four")
            }
            position += 1
            let objectValue = first == 123
            var result = JsonValue.ArrayValue()
            var closing = (byte)93
            if objectValue {
                result = JsonValue.ObjectValue()
                closing = (byte)125
            }
            var containerClosed = Take(closing)
            while !containerClosed {
                var name = ""
                if objectValue {
                    name = ReadString()?
                    if !Take((byte)58) {
                        return Error("Expected colon")
                    }
                }
                let child = Value(depth + 1)?
                if objectValue {
                    _ = result.Put(name, child)?
                } else {
                    _ = result.Add(child)?
                }
                containerClosed = Take(closing)
                if !containerClosed && !Take((byte)44) {
                    return Error("Expected comma or container end")
                }
            }
            return Ok(result)
        }
        let start = position
        var tokenEnd = false
        while position < bytes.Count && !tokenEnd {
            let value = bytes[position]
            tokenEnd = (Whitespace(value) || value == 44 || value == 93 || value == 125)
            if !tokenEnd {
                position += 1
            }
        }
        let token = Slice(start)?
        if token.Equals("true") {
            return Ok(JsonValue.BooleanValue(true))
        }
        if token.Equals("false") {
            return Ok(JsonValue.BooleanValue(false))
        }
        if token.Equals("null") {
            return Ok(JsonValue.NullValue())
        }
        return JsonValue.NumberValue(token)
    }

    func Read() -> Result<JsonValue, string> {
        let result = Value(0)?
        Skip()
        if position != bytes.Count {
            return Error("Trailing content")
        }
        return Ok(result)
    }
}

public func ReadDocument(text: string) -> Result<JsonValue, string> {
    if text.GetUtf8ByteCount() > 128 {
        return Error("Document exceeds 128 UTF-8 bytes")
    }
    return DocumentReader(text).Read()
}

public class DocumentWriter {
    private field nodes: int
    private field output: string

    init() {
        nodes = 0
        output = ""
    }

    private func Append(text: string) -> Result<unit, string> {
        if text.GetUtf8ByteCount() > 128 - output.GetUtf8ByteCount() {
            return Error("Document exceeds 128 UTF-8 bytes")
        }
        output = String.Concat(output, text)
        return Ok(())
    }

    private func Value(value: JsonValue, depth: int) -> Result<unit, string> {
        nodes += 1
        if nodes > 32 {
            return Error("Document exceeds 32 values")
        }
        if value is JsonString {
            let text = value.AsString()?
            let quoted = WriteMessage(text)?
            return Append(quoted)
        }
        if value is JsonNumber {
            let text = value.NumberText()?
            return Append(text)
        }
        if value is JsonBoolean {
            let truth = value.AsBoolean()?
            if truth {
                return Append("true")
            }
            return Append("false")
        }
        if value is JsonNull {
            return Append("null")
        }
        if depth >= 4 {
            return Error("Container depth exceeds four (or cyclic tree)")
        }
        let objectValue = value is JsonObject
        if objectValue {
            _ = Append("{")?
        } else {
            _ = Append("[")?
        }
        for index in 0..<value.Count {
            if index > 0 {
                _ = Append(",")?
            }
            if objectValue {
                let name = value.Name(index)?
                let quoted = WriteMessage(name)?
                _ = Append(quoted)?
                _ = Append(":")?
            }
            let child = value.Item(index)?
            _ = Value(child, depth + 1)?
        }
        if objectValue {
            return Append("}")
        }
        return Append("]")
    }

    func Write(value: JsonValue) -> Result<string, string> {
        _ = Value(value, 0)?
        return Ok(output)
    }
}

public func WriteDocument(value: JsonValue) -> Result<string, string> {
    return DocumentWriter().Write(value)
}
