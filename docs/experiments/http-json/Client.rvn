import System.*
import System.Data.Json.*
import System.Option.*
import System.Result.*
import System.Tasks.*
import System.Web.Http.*

class ReportClient {
    async func SubmitReport(client: HttpClient) -> Task<Result<string, AppError>> {
        let content = PrepareReport()?
        let response = await client.Post("reports", content)
        return ReadReply(response)
    }

}

async func Main(arguments: string[]) -> Task<()> {
    if arguments.Length != 1 {
        System.Fail("Supply the server base URL, for example http://localhost:8080/")
        return ()
    }
    let client = HttpClient()
    client.BaseUri = Some(arguments[0])
    let result = await ReportClient().SubmitReport(client)
    if let Ok(reply) = result {
        Console.WriteLine(reply)
    } else if let Error(error) = result {
        System.Fail(error.ToString())
    }
}
