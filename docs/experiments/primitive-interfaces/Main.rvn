import System.*
import System.Result.*

func Check(value: bool, message: string) {
    if !value {
        Console.WriteLine(message)
        Panic(message)
    }
}

func Main() {
    let value0 = (sbyte)-1
    let object0: Object = value0
    Check(object0 is ComparableTo<sbyte>, "sbyte interface identity")
    let compare0 = (ComparableTo<sbyte>)object0
    Check(compare0.CompareTo((sbyte)1) == value0.CompareTo((sbyte)1), "sbyte borrowed receiver")
    Check(compare0.CompareTo((sbyte)1) < 0, "sbyte signed and width behavior")
    let value1 = (byte)42
    let object1: Object = value1
    Check(object1 is ComparableTo<byte>, "byte interface identity")
    let compare1 = (ComparableTo<byte>)object1
    Check(compare1.CompareTo((byte)43) == value1.CompareTo((byte)43), "byte borrowed receiver")
    Check(compare1.CompareTo((byte)43) < 0, "byte signed and width behavior")
    let value2 = (short)-32768
    let object2: Object = value2
    Check(object2 is ComparableTo<short>, "short interface identity")
    let compare2 = (ComparableTo<short>)object2
    Check(compare2.CompareTo((short)1) == value2.CompareTo((short)1), "short borrowed receiver")
    Check(compare2.CompareTo((short)1) < 0, "short signed and width behavior")
    let value3 = (ushort)65534
    let object3: Object = value3
    Check(object3 is ComparableTo<ushort>, "ushort interface identity")
    let compare3 = (ComparableTo<ushort>)object3
    Check(compare3.CompareTo((ushort)65535) == value3.CompareTo((ushort)65535), "ushort borrowed receiver")
    Check(compare3.CompareTo((ushort)65535) < 0, "ushort signed and width behavior")
    let value4 = -2147483648
    let object4: Object = value4
    Check(object4 is ComparableTo<int>, "int interface identity")
    let compare4 = (ComparableTo<int>)object4
    Check(compare4.CompareTo(1) == value4.CompareTo(1), "int borrowed receiver")
    Check(compare4.CompareTo(1) < 0, "int signed and width behavior")
    let value5 = (uint)4294967294L
    let object5: Object = value5
    Check(object5 is ComparableTo<uint>, "uint interface identity")
    let compare5 = (ComparableTo<uint>)object5
    Check(compare5.CompareTo((uint)4294967295L) == value5.CompareTo((uint)4294967295L), "uint borrowed receiver")
    Check(compare5.CompareTo((uint)4294967295L) < 0, "uint signed and width behavior")
    let value6 = Int64.MinValue
    let object6: Object = value6
    Check(object6 is ComparableTo<long>, "long interface identity")
    let compare6 = (ComparableTo<long>)object6
    Check(compare6.CompareTo(1L) == value6.CompareTo(1L), "long borrowed receiver")
    Check(compare6.CompareTo(1L) < 0, "long signed and width behavior")
    let Ok(max64) = UInt64.Parse("18446744073709551615") else {
        Panic("Unsigned boundary")
    }
    let value7 = max64 - (ulong)1
    let object7: Object = value7
    Check(object7 is ComparableTo<ulong>, "ulong interface identity")
    let compare7 = (ComparableTo<ulong>)object7
    Check(compare7.CompareTo(max64) == value7.CompareTo(max64), "ulong borrowed receiver")
    Check(compare7.CompareTo(max64) < 0, "ulong signed and width behavior")
    let value8 = (nint)-1
    let object8: Object = value8
    Check(object8 is ComparableTo<nint>, "nint interface identity")
    let compare8 = (ComparableTo<nint>)object8
    Check(compare8.CompareTo((nint)1) == value8.CompareTo((nint)1), "nint borrowed receiver")
    Check(compare8.CompareTo((nint)1) < 0, "nint signed and width behavior")
    let value9 = (nuint)42
    let object9: Object = value9
    Check(object9 is ComparableTo<nuint>, "nuint interface identity")
    let compare9 = (ComparableTo<nuint>)object9
    Check(compare9.CompareTo((nuint)43) == value9.CompareTo((nuint)43), "nuint borrowed receiver")
    Check(compare9.CompareTo((nuint)43) < 0, "nuint signed and width behavior")
    let value10 = (float)-1.5
    let object10: Object = value10
    Check(object10 is ComparableTo<float>, "float interface identity")
    let compare10 = (ComparableTo<float>)object10
    Check(compare10.CompareTo((float)1.5) == value10.CompareTo((float)1.5), "float borrowed receiver")
    Check(compare10.CompareTo((float)1.5) < 0, "float signed and width behavior")
    let value11 = -1.5
    let object11: Object = value11
    Check(object11 is ComparableTo<double>, "double interface identity")
    let compare11 = (ComparableTo<double>)object11
    Check(compare11.CompareTo(1.5) == value11.CompareTo(1.5), "double borrowed receiver")
    Check(compare11.CompareTo(1.5) < 0, "double signed and width behavior")
    let value12 = false
    let object12: Object = value12
    Check(object12 is ComparableTo<bool>, "bool interface identity")
    let compare12 = (ComparableTo<bool>)object12
    Check(compare12.CompareTo(true) == value12.CompareTo(true), "bool borrowed receiver")
    Check(compare12.CompareTo(true) < 0, "bool signed and width behavior")
    let value13 = Char.FromString("a")
    let object13: Object = value13
    Check(object13 is ComparableTo<char>, "char interface identity")
    let compare13 = (ComparableTo<char>)object13
    Check(compare13.CompareTo(Char.FromString("b")) == value13.CompareTo(Char.FromString("b")), "char borrowed receiver")
    Check(compare13.CompareTo(Char.FromString("b")) < 0, "char signed and width behavior")
    Check(!(object1 is ComparableTo<int>), "Exact generic interface")
    Check(!(object1 is EquatableTo<int>), "No equality interface for a different primitive type")
    let equatable = (EquatableTo<int>)object4
    Check(equatable.Equals(-2147483648), "Explicit integer equality interface")
    System.Runtime.GC.Collect()
    Check(compare2.CompareTo((short)1) < 0, "Borrowed box retained across GC")
    Check(compare11.CompareTo(1.5) < 0, "Floating box retained across GC")
    Console.WriteLine("Primitive interface contracts: passed")
}
