import System.*
import System.Introspection.*

interface Left {
    func Read() -> int
    func Clear()
}

interface Right {
    func Read() -> int
}

class Pair : Left, Right {
    private var value = 21

    func Left.Read() -> int => value

    func Right.Read() -> int => value * 2

    func Left.Clear() {
        value = 0
    }

    func Read() -> int => 99
}

class OnlyExplicit : Right {
    func Right.Read() -> int => 7
}

func Main() {
    let pair = Pair()
    let left: Left = pair
    let right: Right = pair
    if left.Read() != 21 || right.Read() != 42 || pair.Read() != 99 {
        System.Fail("Explicit interface mapping failed")
    }
    left.Clear()
    if left.Read() != 0 || right.Read() != 0 || pair.Read() != 99 {
        System.Fail("Explicit receiver identity failed")
    }
    let only: Right = OnlyExplicit()
    if only.Read() != 7 {
        System.Fail("Private implementation dispatch failed")
    }
    var hiddenCount = 0
    let flags = BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.DeclaredOnly
    for method in typeof(Pair).GetMethods(flags: flags) {
        if method.Name == "Left.Read" || method.Name == "Right.Read" || method.Name == "Left.Clear" {
            if !method.IsPrivate || method.IsStatic || method.IsVirtual || method.IsAbstract {
                System.Fail("Explicit implementation metadata failed")
            }
            hiddenCount = hiddenCount + 1
        }
    }
    if hiddenCount != 3 {
        System.Fail("Explicit implementation metadata missing")
    }
    Console.WriteLine("Explicit interface contracts passed")
}
