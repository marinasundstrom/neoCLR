import System.*
import System.Collections.*
import System.Introspection.*
import System.Option.*
import System.Result.*
import System.Runtime.Reflection.*
import System.Web.Http.*

public union RouteMappingError {
    case NoMatch
    case InvalidTarget(reason: string)
    case InvalidParameter(name: string, expectedType: string)
    case ConstructionFailed(reason: string)
}

class BoundRoute {
    private val pattern: RoutePattern
    private val constructor: ConstructorInfo
    private val carrier: ConstructorInfo
    private val names: Sequence<string>
    private val integers: Sequence<bool>

    init(pattern: RoutePattern, constructor: ConstructorInfo, carrier: ConstructorInfo,
         names: Sequence<string>, integers: Sequence<bool>) {
        self.pattern = pattern
        self.constructor = constructor
        self.carrier = carrier
        self.names = names
        self.integers = integers
    }

    val Pattern: RoutePattern => pattern

    func Construct(captures: RouteMatch) -> Result<Object, RouteMappingError> {
        let arguments = ArrayList<Object?>()
        for index in 0..<names.Count {
            if integers[index] {
                let value = match captures.GetInt32(names[index]) {
                    Ok(let number) => number
                    Error(_) => return Error(RouteMappingError.InvalidParameter(names[index], "Int32"))
                }
                arguments.Add(value)
            } else {
                let value = match captures.Get(names[index]) {
                    Ok(let text) => text
                    Error(_) => return Error(RouteMappingError.InvalidParameter(names[index], "String"))
                }
                arguments.Add(value)
            }
        }
        let payload = match constructor.Invoke(arguments) {
            Ok(let value) => value
            Error(_) => return Error(RouteMappingError.ConstructionFailed("Case construction failed"))
        }
        return match carrier.Invoke(payload) {
            Ok(let value) => Ok(value)
            Error(_) => Error(RouteMappingError.ConstructionFailed("Union construction failed"))
        }
    }
}

// Reusable experiment: accepts any supported route union, returns its boxed carrier.
public class RouteUnionMapper {
    private val routes: Sequence<BoundRoute>

    private init(routes: Sequence<BoundRoute>) {
        self.routes = routes
    }

    static func Create(type: TypeInfo) -> Result<RouteUnionMapper, string> {
        if !type.IsVisible || !type.IsUnion || !type.IsValueType || type.IsOpen || type.GenericArgumentCount != 0 {
            return Error("Expected a public nongeneric value union")
        }
        let nominal = (NominalTypeInfo)type
        let prepared = ArrayList<BoundRoute>()
        let carriers = type.GetConstructors()
        for discovered in nominal.Module.GetTypes() {
            let candidate = (NominalTypeInfo)discovered
            if let Some(parent) = candidate.DeclaringType {
                if parent.Equals(type) {
                    if !candidate.IsVisible || !candidate.IsValueType || candidate.IsEnum || candidate.IsOpen {
                        return Error("Unsupported nested route case")
                    }
                    var template = ""
                    var markers = 0
                    for attribute in candidate.GetCustomAttributesData() {
                        if attribute.AttributeType.Equals(typeof(RoutePatternAttribute)) {
                            markers += 1
                            let arguments = attribute.GetConstructorArguments()
                            if arguments.Count != 1 {
                                return Error("RoutePattern requires one string")
                            }
                            if arguments[0].Value is string text {
                                template = text
                            } else {
                                return Error("RoutePattern requires a non-null string")
                            }
                        }
                    }
                    if markers != 1 {
                        return Error("Each case requires exactly one RoutePattern")
                    }
                    let pattern = RoutePattern.Parse(template)?
                    for existing in prepared {
                        if existing.Pattern.Overlaps(pattern) {
                            return Error("Overlapping route patterns")
                        }
                    }
                    let constructors = candidate.GetConstructors()
                    if constructors.Count != 1 {
                        return Error("Expected one public case constructor")
                    }
                    let parameters = constructors[0].GetParameters()
                    let captures = pattern.GetParameterNames()
                    if captures.Count != parameters.Count {
                        return Error("Capture names must match case parameters")
                    }
                    let names = ArrayList<string>()
                    let integers = ArrayList<bool>()
                    for parameter in parameters {
                        var found = false
                        for capture in captures {
                            if capture == parameter.Name {
                                found = true
                            }
                        }
                        for name in names {
                            if name == parameter.Name {
                                return Error("Duplicate case parameter name")
                            }
                        }
                        if !found {
                            return Error("Capture names must match case parameters")
                        }
                        let integer = parameter.ParameterType.Equals(typeof(int))
                        if !integer && !parameter.ParameterType.Equals(typeof(string)) {
                            return Error("Only String and Int32 route parameters are supported")
                        }
                        names.Add(parameter.Name)
                        integers.Add(integer)
                    }
                    var bound = false
                    for carrier in carriers {
                        let payloads = carrier.GetParameters()
                        if payloads.Count == 1 && payloads[0].ParameterType.Equals(candidate) {
                            if bound {
                                return Error("Ambiguous union constructor")
                            }
                            if prepared.Count == 16 {
                                return Error("Route union exceeds 16 cases")
                            }
                            prepared.Add(BoundRoute(pattern, constructors[0], carrier, names, integers))
                            bound = true
                        }
                    }
                    if !bound {
                        return Error("Public union constructor missing")
                    }
                }
            }
        }
        if prepared.Count == 0 {
            return Error("Route union has no cases")
        }
        let snapshot: Sequence<BoundRoute> = prepared
        return Ok(RouteUnionMapper(snapshot))
    }

    func Parse(target: string) -> Result<Object, RouteMappingError> {
        for route in routes {
            let matched = match route.Pattern.Match(target) {
                Ok(let value) => value
                Error(let reason) => return Error(RouteMappingError.InvalidTarget(reason))
            }
            if let Some(captures) = matched {
                return route.Construct(captures)
            }
        }
        return Error(RouteMappingError.NoMatch)
    }
}
