import System.*
import System.Collections.*
import System.Optional.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func OpenServer() -> HttpServer {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) else { Panic("Listen") }
    let Ok(port) = server.GetLocalPort() else { Panic("Port") }
    Console.WriteLine(port)
    return server
}

func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
    let Ok(Some(media)) = request.GetContentType() else { Panic("Request type") }
    let Some(boundary) = media.GetParameter("boundary") else { Panic("Boundary") }
    if boundary != "AbC; 123" {
        Panic("Boundary case or quoting lost")
    }
    let response = HttpResponse(HttpStatusCode.OK, Array<HttpHeader>.Empty, HttpStringContent("{}", MediaTypes.Application.ProblemJson))
    let outcome: Result<HttpResponse, HttpError> = Ok(response)
    return Task.FromResult(outcome)
}

async func Main() -> Task<()> {
    let server = OpenServer()
    let result = await server.ServeOne(Respond)
    server.Close()
    let Ok(_) = result else { Panic("Serve") }
    Console.WriteLine("PASS media type server")
}
