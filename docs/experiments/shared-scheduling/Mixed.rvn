import System.*
import System.Runtime.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Networking.Sockets.*
import System.Result.*
import System.Optional.*
import System.Collections.*
import System.Data.Json.*
import System.Storage.*
import System.Web.Http.*

// Entry adapter selects the already qualified owned runtime-await pump while
// System.Web and Run keep native state-machine lowering. No GC admission bypass.
func Main() -> Task<unit> {
    return RuntimeAwaitProvider.Bridge.Start<unit>(() => {
        let pending = Run()
        if !RuntimeAwaitProvider.Bridge.Wait(pending) {
            return TaskOutcome<unit>.Cancelled
        }
        pending.GetResult()
        return TaskOutcome<unit>.Completed(())
    })
}

class MixedApplication {
    static func Response(text: string) -> Result<HttpServerResponse, HttpError> {
        return Ok(HttpServerResponse(HttpStatusCode.OK, ArrayList<HttpHeader>(), HttpStringContent(text)))
    }

    async func Respond(request: HttpServerRequest) -> Task<Result<HttpServerResponse, HttpError>> {
        if request.Method.Method != "GET" {
            Panic("Mixed method")
        }
        if request.Target == "/fanout/0" {
            return await Fanout0()
        }
        if request.Target == "/fanout/1" {
            return await Fanout1()
        }
        if request.Target == "/fanout/2" {
            return await Fanout2()
        }
        if request.Target == "/fanout/3" {
            return await Fanout3()
        }
        if request.Target == "/short/0" {
            return await Short0()
        }
        if request.Target == "/short/1" {
            return await Short1()
        }
        if request.Target == "/short/2" {
            return await Short2()
        }
        if request.Target == "/short/3" {
            return await Short3()
        }
        if request.Target == "/allocate/0" {
            return await Allocate0()
        }
        if request.Target == "/allocate/1" {
            return await Allocate1()
        }
        if request.Target == "/allocate/2" {
            return await Allocate2()
        }
        if request.Target == "/allocate/3" {
            return await Allocate3()
        }
        if request.Target == "/file-read/0" {
            return await Read0()
        }
        if request.Target == "/file-read/1" {
            return await Read1()
        }
        if request.Target == "/file-read/2" {
            return await Read2()
        }
        if request.Target == "/file-read/3" {
            return await Read3()
        }
        if request.Target == "/file-write/0" {
            return await Write0()
        }
        if request.Target == "/file-write/1" {
            return await Write1()
        }
        if request.Target == "/file-write/2" {
            return await Write2()
        }
        if request.Target == "/file-write/3" {
            return await Write3()
        }
        if request.Target == "/network/0" {
            return await Network0()
        }
        if request.Target == "/network/1" {
            return await Network1()
        }
        if request.Target == "/network/2" {
            return await Network2()
        }
        if request.Target == "/network/3" {
            return await Network3()
        }
        Panic("Unknown mixed endpoint")
        return Response("invalid")
    }

    async func Short0() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Short(0)
    }

    async func Short1() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Short(1)
    }

    async func Short2() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Short(2)
    }

    async func Short3() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Short(3)
    }

    async func Allocate0() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Allocate(0)
    }

    async func Allocate1() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Allocate(1)
    }

    async func Allocate2() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Allocate(2)
    }

    async func Allocate3() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Allocate(3)
    }

    async func Read0() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Read(0)
    }

    async func Read1() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Read(1)
    }

    async func Read2() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Read(2)
    }

    async func Read3() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Read(3)
    }

    async func Write0() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Write(0)
    }

    async func Write1() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Write(1)
    }

    async func Write2() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Write(2)
    }

    async func Write3() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Write(3)
    }

    async func Network0() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Network(0)
    }

    async func Network1() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Network(1)
    }

    async func Network2() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Network(2)
    }

    async func Network3() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Network(3)
    }

    async func Fanout0() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Fanout(0)
    }

    async func Fanout1() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Fanout(1)
    }

    async func Fanout2() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Fanout(2)
    }

    async func Fanout3() -> Task<Result<HttpServerResponse, HttpError>> {
        return await Fanout(3)
    }

    async func Fanout(variant: int) -> Task<Result<HttpServerResponse, HttpError>> {
        let id = variant
        // Explicit await and Task.Run's async-unwrapping overload preserve
        // completion dependency without implicit parent/child attachment.
        let Ok(_) = await Task.Run(() => Short(id)) else {
            Panic("Mixed nested task")
        }
        return Response("fanout:" + variant.ToString() + ":ok")
    }

    static async func Short(variant: int) -> Task<Result<HttpServerResponse, HttpError>> {
        let shared = Person()
        let alias = shared
        let first = Task.Run(() => {
            shared.id = 42
            return 1
        })
        let second = Task.Run(() => {
            alias.name = "shared"
            return 2
        })
        let third = Task.Run(() => {
            shared.active = true
            return 3
        })
        let fourth = Task.Run(() => 4)
        let firstValue = await first
        let secondValue = await second
        let thirdValue = await third
        let fourthValue = await fourth
        let total = firstValue + secondValue + thirdValue + fourthValue
        if total != 10 || alias.id != 42 || shared.name != "shared" || !alias.active || !Object.ReferenceEquals(shared, alias) {
            Panic("Mixed shared capture")
        }
        return Response("short:" + variant.ToString() + ":10")
    }

    async func Allocate(variant: int) -> Task<Result<HttpServerResponse, HttpError>> {
        let shared = Person()
        let count = 256 + variant * 256
        let result = await Task.Run(() => {
            var index = 0
            var checksum = 0
            while index < count {
                let item = Person()
                item.id = index
                shared.id = item.id
                checksum += item.id
                index += 1
            }
            return checksum
        })
        if result != count * (count - 1) / 2 || shared.id != count - 1 {
            Panic("Mixed allocation checksum")
        }
        return Response("allocate:" + variant.ToString() + ":" + result.ToString())
    }

    async func Read(variant: int) -> Task<Result<HttpServerResponse, HttpError>> {
        // FileText is blocking. Task.Run uses the shared owner scheduler here;
        // this test deliberately does not pretend the operation is async I/O.
        let text = await Task.Run(() => {
            let Ok(value) = FileText.ReadAllText("input.txt", 8192) else {
                Panic("Mixed file read")
            }
            return value
        })
        if text != "checked file payload" {
            Panic("Mixed file contents")
        }
        return Response("file-read:" + variant.ToString() + ":ok")
    }

    async func Write(variant: int) -> Task<Result<HttpServerResponse, HttpError>> {
        let path = "output-" + variant.ToString() + ".txt"
        let result = await Task.Run(() => {
            let Ok(_) = FileText.WriteAllText(path, "checked file payload", 8192) else {
                Panic("Mixed file write")
            }
            return 42
        })
        if result != 42 {
            Panic("Mixed file result")
        }
        return Response("file-write:" + variant.ToString() + ":ok")
    }

    async func Network(variant: int) -> Task<Result<HttpServerResponse, HttpError>> {
        use client = HttpClient()
        let Ok(text) = await client.GetString("http://127.0.0.1:19876/wait/" + variant.ToString()) else {
            Panic("Mixed downstream HTTP")
        }
        if text != "downstream:" + variant.ToString() {
            Panic("Mixed downstream contents")
        }
        return Response("network:" + variant.ToString() + ":ok")
    }
}

async func Run() -> Task<unit> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 64) else {
        Panic("Listen")
    }
    let Ok(control) = Socket.Listen("127.0.0.1", 0, 8) else {
        Panic("Control")
    }
    let Ok(port) = server.GetLocalPort() else {
        Panic("Port")
    }
    let Ok(controlPort) = control.GetLocalPort() else {
        Panic("Control port")
    }
    let application = MixedApplication()
    let lifetime = server.ServePersistent(application.Respond, 32, 16, CancellationToken.None)
    Console.WriteLine("READY")
    Console.WriteLine(port)
    Console.WriteLine(controlPort)
    let Ok(stop) = await control.Accept() else {
        Panic("Stop signal")
    }
    stop.Close()
    control.Close()
    server.Close()
    let Ok(_) = await lifetime else {
        Panic("Serve lifetime")
    }
    Console.WriteLine("DONE " + server.CompletedRequests.ToString() + " " + server.FailedRequests.ToString())
}
