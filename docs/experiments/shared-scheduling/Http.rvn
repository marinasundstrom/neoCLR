import System.*
import System.Runtime.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Networking.Sockets.*
import System.Result.*
import System.Optional.*
import System.Collections.*
import System.Data.Json.*
import System.Web.Http.*

// Entry adapter selects the already qualified owned runtime-await pump while
// System.Web and Run keep native state-machine lowering. No GC admission bypass.
func Main() -> Task<unit> {
    return RuntimeAwaitProvider.Bridge.Start<unit>(() => {
        let pending = Run()
        if !RuntimeAwaitProvider.Bridge.Wait(pending) {
            return TaskOutcome<unit>.Cancelled
        }
        pending.GetResult()
        return TaskOutcome<unit>.Completed(())
    })
}

// Reuse the standard three-field typed JSON workload from ../Model.rvn.
class BenchmarkApplication {
    async func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
        if request.Method.Method != "GET" {
            System.Fail("Benchmark method")
        }
        if request.Target == "/json" {
            let person = Person()
            let alias = person
            let result = await Task.Run(() => {
                var index = 0
                while index < 64 {
                    let temporary = Person()
                    temporary.id = index
                    person.id = temporary.id
                    index += 1
                }
                person.id = 42
                return person.id
            })
            if result != 42 || alias.id != 42 || !Object.ReferenceEquals(person, alias) {
                System.Fail("Scheduled shared capture lost")
            }
            person.name = "Café team"
            person.active = true
            return RespondWithPerson(person)
        }
        if request.Target != "/plain" {
            System.Fail("Benchmark route")
        }
        let state = Person()
        let value = await Task.Run(() => {
            state.id = 42
            return state.id
        })
        if value != 42 || state.id != 42 {
            System.Fail("Task.Run capture mutation lost")
        }
        return Ok(HttpResponse(HttpStatusCode.OK, ArrayList<HttpHeader>(), HttpStringContent("Hello, World!")))
    }
}

async func Run() -> Task<unit> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 64) else {
        System.Fail("Listen")
    }
    let Ok(control) = Socket.Listen("127.0.0.1", 0, 8) else {
        System.Fail("Control")
    }
    let Ok(port) = server.GetLocalPort() else {
        System.Fail("Port")
    }
    let Ok(controlPort) = control.GetLocalPort() else {
        System.Fail("Control port")
    }
    let application = BenchmarkApplication()
    let lifetime = server.ServePersistent(application.Respond, 32, 16, CancellationToken.None)
    Console.WriteLine("READY")
    Console.WriteLine(port)
    Console.WriteLine(controlPort)
    let Ok(stop) = await control.Accept() else {
        System.Fail("Stop signal")
    }
    stop.Close()
    control.Close()
    server.Close()
    let Ok(_) = await lifetime else {
        System.Fail("Serve lifetime")
    }
    Console.WriteLine("DONE " + server.CompletedRequests.ToString() + " " + server.FailedRequests.ToString())
}
