import System.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*
import System.Data.Json.*

class Response {
    val Number: int

    init(number: int) {
        Number = number
    }
}

func Make(choice: int) -> Result<Response, HttpError | JsonError> {
    if choice == 0 {
        return Ok(Response(42))
    }
    if choice == 1 {
        return Failure(HttpError.TimedOut)
    }
    return Failure(JsonError.InvalidIndex(42))
}

func Inspect(result: Result<Response, HttpError | JsonError>, choice: int) -> int {
    if let Ok(response) = result {
        if choice == 0 {
            return response.Number
        }
        return -1
    }
    if let Failure(error) = result {
        if choice == 1 {
            return match (HttpError)error {
                HttpError.TimedOut => 42
                _ => -1
            }
        }
        if choice == 2 {
            return match (JsonError)error {
                JsonError.InvalidIndex(let index) => index
                _ => -1
            }
        }
    }
    return -1
}

async func Main() -> Task<int> {
    let completedSuccess = await Task.FromResult(Make(0))
    let completedHttp = await Task.FromResult(Make(1))
    let completedJson = await Task.FromResult(Make(2))
    let queuedSuccess = await Task.Run(() => Make(0))
    let queuedHttp = await Task.Run(() => Make(1))
    let queuedJson = await Task.Run(() => Make(2))
    if Inspect(completedSuccess, 0) != 42 || Inspect(completedHttp, 1) != 42 || Inspect(completedJson, 2) != 42 {
        return 1
    }
    if Inspect(queuedSuccess, 0) != 42 || Inspect(queuedHttp, 1) != 42 || Inspect(queuedJson, 2) != 42 {
        return 2
    }
    return 42
}
