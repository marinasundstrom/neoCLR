class Other {}

func Keep(value: int | Other) -> int | Other {
    return value
}

func Main() -> int {
    let failure = CheckFailure()
    let stored = Keep(42)
    let reference = Keep(Other())
    if reference is Other {
        return match failure {
            Failure.Rejected(let code) => (int)stored + code - 42
        }
    }
    return 1
}

union Failure {
    case Rejected(code: int)
}

func KeepFailure(value: Failure | Other) -> Failure | Other {
    return value
}

func CheckFailure() -> Failure {
    let stored = KeepFailure(Failure.Rejected(42))
    return (Failure)stored
}
