import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func MakeRequest(url: string, size: int) -> HttpRequest {
    let bytes = (byte[])[for index in 0..size => (byte)(index % 256)]
    let Ok(request) = HttpRequest.Create(HttpMethod.Post, url, HttpMemoryContent(bytes)) else {
        Panic("Request construction failed")
    }
    return request
}

func Validate(result: Result<HttpResponse, HttpError>, size: int, expected: string) {
    if let Ok(response) = result {
        if expected != "ok" || (int)response.StatusCode != 200 || response.Content.Length != size {
            Panic("Unexpected response")
        }
        let content = (HttpMemoryContent)response.Content
        let body: ReadOnlySlice<byte> = content.Memory
        var index = 0
        while index < size {
            if body[index] != (byte)(index % 256) {
                Panic("Response byte mismatch")
            }
            index += 1
        }
        if response.GetHeaderValues("Link").Count != 0 {
            Panic("Informational headers leaked into final response")
        }
    } else if let Failure(reason) = result {
        CheckError(reason, expected)
    }
    Console.WriteLine("PASS client")
}

func ParseSize(value: string) -> int {
    let Ok(size) = Int32.Parse(value) else {
        Panic("Invalid size")
    }
    return size
}

async func Main(arguments: string[]) -> Task<()> {
    let size = ParseSize(arguments[1])
    let request = MakeRequest(arguments[0], size)
    let client = HttpClient()
    let result = await client.Send(request)
    client.Dispose()
    Validate(result, size, arguments[2])
}
