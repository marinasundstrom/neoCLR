import System.*

record class Key(Number: int)
record class Pair(Left: int, Right: int)
record class Person(Name: string, Age: int)
record class Entry(Owner: Person, Number: int)
record class OptionalEntry(Owner: Person?, Number: int)
record class OptionalPair(Left: Person?, Right: Person?)

func BuildName(prefix: string) -> string => prefix + "ven"

func Wrap(owner: Person?, number: int) -> OptionalEntry => OptionalEntry(owner, number)

func Main() {
    let first = Key(42)
    let second = Key(42)
    let alias = first
    let value: Object = first
    let equatable: Equatable<Key> = first
    if !Object.ReferenceEquals(first, alias) {
        System.Fault("Record assignment must preserve class identity")
    }
    if Object.ReferenceEquals(first, second) {
        System.Fault("Separate records must retain distinct identities")
    }
    if !first.Equals(second) || !value.Equals(second) || !equatable.Equals(second) || first != second {
        System.Fault("Record equality must agree through typed and Object views")
    }
    if first.GetHashCode() != second.GetHashCode() {
        System.Fault("Equal records must have equal hashes")
    }
    if first == Key(7) {
        System.Fault("Different record components must compare unequal")
    }
    if first.ToString() != "Key { Number = 42 }" {
        System.Fault("Unexpected record display")
    }
    let pair = Pair(42, 7)
    let (left, right) = pair
    if left != 42 || right != 7 || pair.GetHashCode() != HashCode.Combine(42, 7) {
        System.Fault("Deconstruction or ordered component hash differs")
    }
    var hash = HashCode()
    hash.Add(42)
    hash.Add(7)
    var independent = hash
    independent.Add(99)
    if hash.ToHashCode() != pair.GetHashCode() || independent.ToHashCode() == hash.ToHashCode() {
        System.Fault("Hash accumulator copies must retain independent state")
    }
    let person = Person("Raven", 42)
    let samePerson = Person(BuildName("Ra"), 42)
    let entry = Entry(person, 7)
    let sameEntry = Entry(samePerson, 7)
    let view: Equatable<Entry> = entry
    if !view.Equals(sameEntry) || entry != sameEntry || entry.GetHashCode() != sameEntry.GetHashCode() {
        System.Fault("Nested records must use component equality and hashes")
    }
    if entry == Entry(Person("Other", 42), 7) || entry == Entry(Person("Raven", 43), 7) {
        System.Fault("Different nested components must compare unequal")
    }
    let unicode = Person("Å", 42)
    let unicodeCopy = Person("Å", 42)
    if unicode != unicodeCopy || unicode.GetHashCode() != unicodeCopy.GetHashCode() || unicode == Person("Å", 42) {
        System.Fault("String equality and hashing must preserve contents without normalization")
    }
    let (name, age) = person
    let (owner, number) = entry
    if name != "Raven" || age != 42 || number != 7 || !Object.ReferenceEquals(owner, person) {
        System.Fault("Deconstruction must preserve string contents and reference identity")
    }
    if entry.ToString() != "Entry { Owner = Person { Name = Raven, Age = 42 }, Number = 7 }" {
        System.Fault("Unexpected nested record display")
    }
    let missing = OptionalEntry(null, 7)
    let sameMissing = Wrap(null, 7)
    let present = OptionalEntry(person, 7)
    let nullableView: Equatable<OptionalEntry> = missing
    if !nullableView.Equals(sameMissing) || missing != sameMissing || missing.GetHashCode() != sameMissing.GetHashCode() {
        System.Fault("Absent record components must compare and hash equally")
    }
    if missing == present || present == missing || missing == OptionalEntry(null, 8) {
        System.Fault("Presence and other components must affect equality")
    }
    let (missingOwner, missingNumber) = missing
    if missingOwner is not null || missingNumber != 7 || missing.ToString() != "OptionalEntry { Owner = , Number = 7 }" {
        System.Fault("Absent components must survive deconstruction and display")
    }
    if OptionalPair(null, null) != OptionalPair(null, null) || OptionalPair(person, null) == OptionalPair(null, person) {
        System.Fault("Null arguments must preserve their positions")
    }
    Console.WriteLine("Nullable record components preserve absence")
    Console.WriteLine(entry.ToString())
    Console.WriteLine(first.ToString())
    Console.WriteLine("Records retain reference identity and compare their components")
    Console.WriteLine("Deconstruction and ordered hashes agree")
}
