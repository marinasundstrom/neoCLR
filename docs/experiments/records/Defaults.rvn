import System.*

record struct TextValue(Text: string)
record class Owner(Name: string)
record struct Payload(Text: string, Owner: Owner)

func Main() {
    let absentText = default(TextValue)
    let emptyText = TextValue("")
    if absentText == emptyText || emptyText == absentText {
        Panic("Null and empty strings must remain different values")
    }
    let absent = default(Payload)
    let same = default(Payload)
    let present = Payload("", Owner("Raven"))
    let boxed: Object = absent
    let comparable: EquatableTo<Payload> = absent
    if absent != same || !boxed.Equals(same) || !comparable.Equals(same) || absent == present {
        Panic("Default reference components must compare safely")
    }
    if absent.GetHashCode() != HashCode.Combine(0, 0) || boxed.GetHashCode() != same.GetHashCode() {
        Panic("Null reference components must contribute zero to the hash")
    }
    if absent.ToString() != "Payload { Text = , Owner =  }" {
        Panic("Null reference components must display as empty fields")
    }
    let (text, owner) = absent
    if text is not null || owner is not null {
        Panic("Deconstruction must preserve null defaults")
    }
    Console.WriteLine(absent.ToString())
}
