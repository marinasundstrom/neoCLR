module RuntimeAsyncAwaitProbe {
    import System.*

    class Producer {
        val Operation: long

        init(operation: long) {
            Operation = operation
        }
        var Value = 0

        func Complete() -> System.Void {
            // The producer suspends too, retaining its receiver until resumption.
            let timer = neoCLR.Runtime.RuntimeAsyncDelay(20)
            _ = neoCLR.Runtime.RuntimeAsyncAwait(timer)
            System.Runtime.GC.Collect()
            Value = 25
            if !neoCLR.Runtime.RuntimeAsyncComplete(Operation, 17) {
                Panic("Completion rejected")
            }
            return ()
        }
    }

    class Exchange {
        val Parent: long
        val Reply: long
        val Done: long

        init(parent: long, reply: long, done: long) {
            Parent = parent
            Reply = reply
            Done = done
        }

        func Run() -> System.Void {
            _ = neoCLR.Runtime.RuntimeAsyncComplete(Parent, 17)
            let reply = neoCLR.Runtime.RuntimeAsyncAwait(Reply)
            if reply != 25 {
                Panic("Detached callback lost parent reply")
            }
            System.Runtime.GC.Collect()
            _ = neoCLR.Runtime.RuntimeAsyncComplete(Done, 42)
            return ()
        }
    }

    class AsyncBody {
        val Gate: long
        var Phase = 0

        init(gate: long) {
            Gate = gate
        }

        func RunAndCheckWaiter() -> int {
            let result = Run()
            if neoCLR.Runtime.RuntimeAsyncRelease(Gate) {
                Panic("Release retracted a parked waiter's result")
            }
            return result
        }

        func Run() -> int {
            Phase = 1
            _ = neoCLR.Runtime.RuntimeAsyncAwait(Gate)
            System.Runtime.GC.Collect()
            Phase = 2
            return 42
        }
    }

    func Nested(producer: Producer) -> int {
        let saved = 7
        let result = neoCLR.Runtime.RuntimeAsyncAwait(producer.Operation)
        return saved + result + producer.Value
    }

    func Main() -> int {
        let producer = Producer(neoCLR.Runtime.RuntimeAsyncCreate())
        _ = neoCLR.Runtime.SchedulerSubmit(producer.Complete)
        if Nested(producer) != 49 {
            Panic("Suspended call chain lost its state")
        }

        let completed = neoCLR.Runtime.RuntimeAsyncCreate()
        _ = neoCLR.Runtime.RuntimeAsyncComplete(completed, 42)
        if neoCLR.Runtime.RuntimeAsyncAwait(completed) != 42 {
            Panic("Already completed operation lost its result")
        }
        let exchange = Exchange(neoCLR.Runtime.RuntimeAsyncCreate(),
            neoCLR.Runtime.RuntimeAsyncCreate(), neoCLR.Runtime.RuntimeAsyncCreate())
        _ = neoCLR.Runtime.SchedulerSubmit(exchange.Run)
        if neoCLR.Runtime.RuntimeAsyncAwait(exchange.Parent) != 17 {
            Panic("Parent failed to resume independently")
        }
        System.Runtime.GC.Collect()
        _ = neoCLR.Runtime.RuntimeAsyncComplete(exchange.Reply, 25)
        if neoCLR.Runtime.RuntimeAsyncAwait(exchange.Done) != 42 {
            Panic("Detached callback failed to resume")
        }
        let body = AsyncBody(neoCLR.Runtime.RuntimeAsyncCreate())
        let invocation = neoCLR.Runtime.RuntimeAsyncStart(body.Run)
        if body.Phase != 1 {
            Panic("Async body did not run until its first suspension")
        }
        _ = neoCLR.Runtime.RuntimeAsyncComplete(body.Gate, 0)
        if neoCLR.Runtime.RuntimeAsyncAwait(invocation) != 42 || body.Phase != 2 {
            Panic("Async body did not publish its result")
        }
        if neoCLR.Runtime.RuntimeAsyncAwait(invocation) != 42 {
            Panic("Repeated await lost the completed result")
        }

        let shared = neoCLR.Runtime.RuntimeAsyncCreate()
        let first = AsyncBody(shared)
        let second = AsyncBody(shared)
        let firstTask = neoCLR.Runtime.RuntimeAsyncStart(first.RunAndCheckWaiter)
        let secondTask = neoCLR.Runtime.RuntimeAsyncStart(second.Run)
        _ = neoCLR.Runtime.RuntimeAsyncComplete(shared, 0)
        _ = neoCLR.Runtime.RuntimeAsyncAwait(firstTask)
        _ = neoCLR.Runtime.RuntimeAsyncAwait(secondTask)
        if !neoCLR.Runtime.RuntimeAsyncRelease(shared) {
            Panic("Completed operation could not be released")
        }
        if neoCLR.Runtime.RuntimeAsyncAwait(firstTask) + neoCLR.Runtime.RuntimeAsyncAwait(secondTask) != 84 {
            Panic("Shared operation did not complete both bodies")
        }
        Console.WriteLine("PASS runtime-owned operation suspension and resumption")
        return 0
    }
}

module neoCLR.Runtime {
    import System.Runtime.CompilerServices.*

    // Private POC intrinsics. These ordinary calls intentionally test runtime
    // frame retention without Raven async/state-machine lowering.
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncCreate() -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncStart(body: () -> int) -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncDelay(milliseconds: int) -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncComplete(operation: long, result: int) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncAwait(operation: long) -> int;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncRelease(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerSubmit(callback: () -> System.Void) -> int;
}
