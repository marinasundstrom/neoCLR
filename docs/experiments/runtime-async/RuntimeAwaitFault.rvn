module RuntimeAwaitFault {
    import System.*
    import System.Concurrency.Tasks.*

    async func FailAfterAwait(input: Task<int>) -> Task<int> {
        let value = await input
        Panic("runtime async sample terminal fault")
    }

    async func Main() -> Task<int> {
        let source = Promise<int>()
        let task = FailAfterAwait(source.Task)
        _ = source.Complete(42)
        let value = await task
        Console.WriteLine("UNREACHABLE")
        return value
    }
}
