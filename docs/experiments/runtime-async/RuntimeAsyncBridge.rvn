// Source-included experimental provider for the compiler's explicit native contract.
module RuntimeAwaitProvider {
    import System.*
    import System.Tasks.*
    import System.Tasks.TaskOutcome.*

    static class Bridge {
        static func Start<T>(callback: () -> TaskOutcome<T>) -> Task<T> {
            let body = Body<T>(callback)
            let handle = neoCLR.Runtime.RuntimeAsyncStart(body.Run)
            let lifetime = BodyLifetime(handle)
            if neoCLR.Runtime.RuntimeAsyncIsCompleted(handle) {
                lifetime.Release()
            } else {
                _ = neoCLR.Runtime.SchedulerSubmit(lifetime.Release)
            }
            return body.Task
        }

        static func Wait<T>(task: Task<T>) -> bool {
            if !task.IsCompleted {
                let signal = CompletionSignal()
                task.OnCompleted(signal.Complete)
                neoCLR.Runtime.RuntimeAsyncAwaitUnit(signal.Handle)
                if !neoCLR.Runtime.RuntimeAsyncRelease(signal.Handle) {
                    System.Fail("Completion signal still has a waiter")
                }
            }
            return !task.IsCancelled
        }

        static func Complete<T>(value: T) -> TaskOutcome<T> => Completed(value)
        static func Cancel<T>() -> TaskOutcome<T> => Cancelled
    }

    class Body<T> {
        private val callback: () -> TaskOutcome<T>
        private val source = Promise<T>()

        init(action: () -> TaskOutcome<T>) {
            callback = action
        }

        val Task: Task<T> => source.Task

        func Run() -> System.Void {
            match callback() {
                Completed(let value) => {
                    _ = source.Complete(value)
                }
                Cancelled => {
                    _ = source.Cancel()
                }
            }
        }
    }

    class BodyLifetime {
        private val handle: long
        init(handle: long) {
            self.handle = handle
        }

        // Runtime ownership ends after Body.Run returns, not when its Promise completes.
        func Release() -> System.Void {
            _ = neoCLR.Runtime.RuntimeAsyncWaitCompletion(handle)
            if !neoCLR.Runtime.RuntimeAsyncRelease(handle) {
                System.Fail("Completed body still has an owner")
            }
        }
    }

    class CompletionSignal {
        val Handle = neoCLR.Runtime.RuntimeAsyncCreate()

        // Deliberate managed-task notification adapter, including cancellation.
        func Complete() -> System.Void {
            if !neoCLR.Runtime.RuntimeAsyncCompleteUnit(Handle) {
                System.Fail("Completion signal was delivered twice")
            }
        }
    }

}

module neoCLR.Runtime {
    import System.Runtime.CompilerServices.*

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncCreate() -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncStart(body: () -> System.Void) -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncCompleteUnit(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncAwaitUnit(operation: long) -> System.Void;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncRelease(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncIsCompleted(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncWaitCompletion(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerSubmit(callback: () -> System.Void) -> int;
}
