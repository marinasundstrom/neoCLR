module RuntimeUseSample {
    import System.*
    import System.Concurrency.Tasks.*

    class Log {
        var Order = 0
        var Count = 0
    }

    class Resource : Disposable {
        private val log: Log
        private val id: int
        init(log: Log, id: int) {
            self.log = log
            self.id = id
        }
        func Dispose() {
            log.Order = log.Order * 10 + id
            log.Count = log.Count + 1
        }
    }

    async func Read(gate: Task<int>, log: Log) -> Task<int> {
        use first = Resource(log, 1)
        use second = Resource(log, 2)
        let value = await gate
        System.Runtime.GC.Collect()
        return value + 25
    }

    async func Unit(gate: Task<()>, log: Log) -> Task<()> {
        use resource = Resource(log, 3)
        await gate
    }

    class Observer {
        private val task: Task<int>
        private val source = Promise<bool>()
        init(task: Task<int>) {
            self.task = task
        }
        val Task: Task<bool> => source.Task
        // Cancellation observation deliberately does not propagate it into Main.
        func Complete() -> System.Void {
            _ = source.Complete(task.IsCancelled)
        }
    }

    async func Main() -> Task<int> {
        let normalLog = Log()
        let gate = Promise<int>()
        let pending = Read(gate.Task, normalLog)
        if normalLog.Count != 0 || pending.IsCompleted {
            Panic("Resource disposed before suspension ended")
        }
        System.Runtime.GC.Collect()
        _ = gate.Complete(17)
        let value = await pending
        if value != 42 || normalLog.Count != 2 || normalLog.Order != 21 {
            Panic("Return cleanup did not dispose in reverse order")
        }
        let cancelLog = Log()
        let cancelled = Promise<int>()
        let cancelling = Read(cancelled.Task, cancelLog)
        let observer = Observer(cancelling)
        cancelling.OnCompleted(observer.Complete)
        _ = cancelled.Cancel()
        let observed = await observer.Task
        if !observed || cancelLog.Count != 2 || cancelLog.Order != 21 {
            Panic("Cancellation bypassed scoped cleanup")
        }
        let unitLog = Log()
        let unitGate = Promise<()>()
        let unit = Unit(unitGate.Task, unitLog)
        _ = unitGate.Complete(())
        await unit
        if unitLog.Count != 1 || unitLog.Order != 3 {
            Panic("Implicit unit return bypassed cleanup")
        }
        Console.WriteLine("PASS runtime async scoped cleanup")
        return 0
    }
}
