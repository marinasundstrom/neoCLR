module RuntimeNativeContract

import System.*
import System.Concurrency.Tasks.*

async func Main() -> Task<int> {
    let operation = neoCLR.Runtime.RuntimeAsyncCreate()
    if neoCLR.Runtime.RuntimeAsyncIsCompleted(operation) {
        Panic("A new operation must be pending")
    }
    if neoCLR.Runtime.RuntimeAsyncRelease(operation) {
        Panic("A pending operation cannot be released")
    }
    if !neoCLR.Runtime.RuntimeAsyncCompleteUnit(operation) {
        Panic("A pending manual operation must accept completion")
    }
    if neoCLR.Runtime.RuntimeAsyncCompleteUnit(operation) {
        Panic("An operation must complete exactly once")
    }
    neoCLR.Runtime.RuntimeAsyncAwaitUnit(operation)
    if !neoCLR.Runtime.RuntimeAsyncWaitCompletion(operation) {
        Panic("Completion must remain observable")
    }
    if !neoCLR.Runtime.RuntimeAsyncRelease(operation) {
        Panic("A completed unowned operation must be released")
    }
    if neoCLR.Runtime.RuntimeAsyncRelease(operation) {
        Panic("An operation must release exactly once")
    }
    if neoCLR.Runtime.RuntimeAsyncCompleteUnit(operation) {
        Panic("A released operation cannot complete")
    }
    Console.WriteLine("PASS runtime async operation lifetime contract")
    return 0
}
