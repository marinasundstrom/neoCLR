module RuntimeAwaitLanguage {
    import System.*
    import System.Concurrency.Tasks.*
    import System.Runtime.CompilerServices.*

    // Source-local compatibility adapter, not a proposed public awaiter type.
    class Operation : TaskAwaiter {
        private val handle: long
        var CompleteOnRegistration = false
        var CancelOnRegistration = false
        var ResultReads = 0
        var Registrations = 0

        init(operation: long) {
            handle = operation
        }

        // Project the runtime outcome through the existing compiler protocol.
        val IsCancelled: bool => neoCLR.Runtime.RuntimeAsyncIsCancelled(handle)
        val IsCompleted: bool => neoCLR.Runtime.RuntimeAsyncIsCompleted(handle)
        func GetAwaiter() -> Operation => self
        func GetResult() -> int {
            ResultReads = ResultReads + 1
            return neoCLR.Runtime.RuntimeAsyncAwait(handle)
        }

        // Deliberate awaiter-protocol adapter. Application code below uses await.
        func OnCompleted(callback: () -> System.Void) {
            Registrations = Registrations + 1
            if CompleteOnRegistration {
                Complete()
            }
            if CancelOnRegistration {
                Cancel()
            }
            let continuation = Continuation(handle, callback)
            _ = neoCLR.Runtime.SchedulerSubmit(continuation.Run)
        }

        func Cancel() -> System.Void {
            if !neoCLR.Runtime.RuntimeAsyncCancel(handle) {
                System.Fail("Operation cancellation rejected")
            }
            return ()
        }

        func Complete() -> System.Void {
            if !neoCLR.Runtime.RuntimeAsyncComplete(handle, 17) {
                System.Fail("Operation completion rejected")
            }
            return ()
        }
    }

    class Continuation {
        private val handle: long
        private val callback: () -> System.Void

        init(operation: long, resume: () -> System.Void) {
            handle = operation
            callback = resume
        }

        func Run() -> System.Void {
            _ = neoCLR.Runtime.RuntimeAsyncWaitCompletion(handle)
            System.Runtime.GC.Collect()
            callback()
            return ()
        }
    }

    class UnitBody {
        val Gate: long
        var Phase = 0
        init(gate: long) {
            Gate = gate
        }
        // Deliberate direct boundary: tests retained frames, not compiler lowering.
        func Run() -> System.Void {
            Phase = 1
            neoCLR.Runtime.RuntimeAsyncAwaitUnit(Gate)
            System.Runtime.GC.Collect()
            Phase = 2
            return ()
        }
    }

    // Source-local protocol adapter for the unit-result runtime POC.
    class UnitOperation : TaskAwaiter {
        private val handle: long
        init(operation: long) {
            handle = operation
        }
        val IsCompleted: bool => neoCLR.Runtime.RuntimeAsyncIsCompleted(handle)
        val IsCancelled: bool => neoCLR.Runtime.RuntimeAsyncIsCancelled(handle)
        func GetAwaiter() -> UnitOperation => self
        func GetResult() -> System.Void => neoCLR.Runtime.RuntimeAsyncAwaitUnit(handle)
        func OnCompleted(callback: () -> System.Void) {
            let continuation = Continuation(handle, callback)
            _ = neoCLR.Runtime.SchedulerSubmit(continuation.Run)
        }
    }

    async func ReadUnit(operation: UnitOperation) -> Task<()> {
        await operation
        return ()
    }

    // Deliberate outcome-observation adapter: awaiting a cancelled task would
    // cancel this observer instead of letting Main assert the terminal outcome.
    class CancellationObserver {
        private val operation: Task<int>
        private val source = Promise<bool>()
        init(task: Task<int>) {
            operation = task
        }
        val Task: Task<bool> => source.Task
        func Run() -> System.Void {
            _ = source.Complete(operation.IsCompleted && operation.IsCancelled)
            return ()
        }
    }

    async func CheckCancellation(operation: Operation, submitCancel: bool) -> Task<()> {
        let task = Read(operation)
        let observer = CancellationObserver(task)
        task.OnCompleted(observer.Run)
        if submitCancel {
            _ = neoCLR.Runtime.SchedulerSubmit(operation.Cancel)
        }
        let cancelled = await observer.Task
        if !cancelled || operation.ResultReads != 0 {
            System.Fail("Cancellation did not propagate without reading a result")
        }
        return ()
    }

    async func Read(operation: Operation) -> Task<int> {
        let value = await operation
        return value + 25
    }

    async func Main() -> Task<int> {
        let pending = Operation(neoCLR.Runtime.RuntimeAsyncCreate())
        let task = Read(pending)
        _ = neoCLR.Runtime.SchedulerSubmit(pending.Complete)
        let result = await task
        if result != 42 {
            System.Fail("Ordinary await lost the result")
        }
        let repeated = await pending
        if repeated != 17 {
            System.Fail("Repeated await lost the result")
        }
        if pending.Registrations != 1 {
            System.Fail("Completed fast path registered a callback")
        }
        let racing = Operation(neoCLR.Runtime.RuntimeAsyncCreate())
        racing.CompleteOnRegistration = true
        let raceResult = await racing
        if raceResult != 17 || racing.Registrations != 1 {
            System.Fail("Completion between readiness check and registration was lost")
        }
        let cancelled = Operation(neoCLR.Runtime.RuntimeAsyncCreate())
        await CheckCancellation(cancelled, true)
        let alreadyCancelled = Operation(neoCLR.Runtime.RuntimeAsyncCreate())
        alreadyCancelled.Cancel()
        await CheckCancellation(alreadyCancelled, false)
        if alreadyCancelled.Registrations != 0 {
            System.Fail("Already cancelled await registered a callback")
        }
        let cancellationRace = Operation(neoCLR.Runtime.RuntimeAsyncCreate())
        cancellationRace.CancelOnRegistration = true
        await CheckCancellation(cancellationRace, false)
        // A cancelled operation must not cancel this invocation or unrelated work.
        let stillWorks = await pending
        if stillWorks != 17 {
            System.Fail("Cancellation corrupted an independent operation")
        }
        let unitBody = UnitBody(neoCLR.Runtime.RuntimeAsyncCreate())
        let unitHandle = neoCLR.Runtime.RuntimeAsyncStart(unitBody.Run)
        if unitBody.Phase != 1 {
            System.Fail("Unit body did not run until suspension")
        }
        let unitOperation = UnitOperation(unitHandle)
        let unitTask = ReadUnit(unitOperation)
        if !neoCLR.Runtime.RuntimeAsyncCompleteUnit(unitBody.Gate) {
            System.Fail("Unit gate completion failed")
        }
        await unitTask
        await unitOperation
        if unitBody.Phase != 2 {
            System.Fail("Unit body did not resume")
        }
        if !neoCLR.Runtime.RuntimeAsyncRelease(unitHandle) {
            System.Fail("Unit operation could not be released after observation")
        }
        Console.WriteLine("PASS ordinary Raven await through runtime suspension adapter")
        return 0
    }
}

module neoCLR.Runtime {
    import System.Runtime.CompilerServices.*

    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncCreate() -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncStart(body: () -> System.Void) -> long;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncCompleteUnit(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncAwaitUnit(operation: long) -> System.Void;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncRelease(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncIsCompleted(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncIsCancelled(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncWaitCompletion(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncCancel(operation: long) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncComplete(operation: long, result: int) -> bool;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func RuntimeAsyncAwait(operation: long) -> int;
    [MethodImpl(MethodImplOptions.InternalCall)]
    internal extern func SchedulerSubmit(callback: () -> System.Void) -> int;
}
