import System.Linq.*
import System.Option.*
import System.Result.*

class Item {
    var Value: int { get; set; } = 7
}

class Program {
    static func Main() -> int {
        let queue = ArrayQueue<int>()
        if queue.Dequeue() is Some(_) {
            return 1
        }
        var index = 0
        while index < 4 {
            queue.Enqueue(index)
            index = index + 1
        }
        if queue.Dequeue() is not Some(0) {
            return 2
        }
        if queue.Dequeue() is not Some(1) {
            return 3
        }
        while index < 12 {
            queue.Enqueue(index)
            index = index + 1
        }
        if queue.Peek() is not Some(2) || queue.Count != 10 {
            return 4
        }
        index = 2
        while index < 12 {
            if queue.Dequeue() is Some(let value) {
                if value != index {
                    return 5
                }
            } else {
                return 6
            }
            index = index + 1
        }
        if queue.Count != 0 {
            return 7
        }
        let items = ArrayQueue<Item>()
        let item = Item()
        items.Enqueue(item)
        if items.Dequeue() is Some(let alias) {
            alias.Value = 8
        } else {
            return 8
        }
        if item.Value != 8 || items.Count != 0 {
            return 9
        }
        items.Enqueue(item)
        items.Clear()
        if items.Count != 0 || items.Count != 0 {
            return 10
        }
        items.Enqueue(item)
        if items.Peek() is not Some(_) {
            return 11
        }
        let stack = ArrayStack<int>()
        if stack.Pop() is Some(_) || stack.Peek() is Some(_) {
            return 12
        }
        index = 0
        while index < 12 {
            stack.Push(index)
            index = index + 1
        }
        if stack.Peek() is not Some(11) || stack.Count != 12 {
            return 13
        }
        while index > 0 {
            index = index - 1
            if stack.Pop() is Some(let value) {
                if value != index {
                    return 14
                }
            } else {
                return 15
            }
        }
        if stack.Count != 0 {
            return 16
        }
        let references = ArrayStack<Item>()
        references.Push(item)
        if references.Pop() is Some(let alias) {
            alias.Value = 9
        } else {
            return 17
        }
        if item.Value != 9 || references.Count != 0 {
            return 18
        }
        references.Push(item)
        references.Clear()
        if references.Count != 0 || references.Count != 0 {
            return 19
        }
        references.Push(item)
        if references.Peek() is not Some(_) {
            return 20
        }
        if !CheckSnapshots() || !CheckSets() {
            return 21
        }
        if !CheckMaps() || !CheckMapConstruction() || !CheckCollectionConstruction() || !CheckForCleanup() || !CheckQueryCleanup() {
            return 30
        }
        Console.WriteLine("collections passed")
        return 0
    }
    static func CheckSnapshots() -> bool {
        let queue: Queue<int> = ArrayQueue<int>(3)
        queue.Enqueue(1)
        queue.Enqueue(2)
        let snapshot = queue.GetIterator()
        queue.Clear()
        queue.Enqueue(3)
        if !snapshot.MoveNext() || snapshot.Current != 1 || !snapshot.MoveNext() || snapshot.Current != 2 || snapshot.MoveNext() {
            return false
        }
        snapshot.Dispose()
        let stack: Stack<int> = ArrayStack<int>(3)
        stack.Push(1)
        stack.Push(2)
        let reversed = stack.GetIterator()
        stack.Clear()
        if !reversed.MoveNext() || reversed.Current != 2 || !reversed.MoveNext() || reversed.Current != 1 || reversed.MoveNext() {
            return false
        }
        reversed.Dispose()
        return true
    }

    static func CheckMaps() -> bool {
        let map: MutableMap<string, int> = HashMap<string, int>(StringComparer.Ordinal)
        if !map.TryAdd("answer", 42) || map.TryAdd("answer", 99) || !map.TryAdd("雪", 7) {
            return false
        }
        let view: Map<string, int> = map
        let iterable: Iterable<KeyValuePair<string, int>> = view
        let snapshot = iterable.GetIterator()
        map.Set("answer", 99)
        map.Set("later", 100)
        var total = 0
        var count = 0
        while snapshot.MoveNext() {
            let (key, value) = snapshot.Current
            if key == "answer" && value != 42 || key == "雪" && value != 7 || key == "later" {
                return false
            }
            total = total + value
            count = count + 1
        }
        snapshot.Dispose()
        if count != 2 || total != 49 || view.Count != 3 {
            return false
        }
        total = 0
        for pair in iterable {
            let (key, value) = pair
            total = total + value
        }
        let original = KeyValuePair<string, int>("copy", 12)
        let copy = original
        let (key, value) = copy
        return total == 206 && key == "copy" && value == 12 && original.Key == key && original.Value == value
    }

    static func CheckMapConstruction() -> bool {
        let pairs = ArrayList<KeyValuePair<string, int>>()
        pairs.Add(KeyValuePair<string, int>("Café", 7))
        pairs.Add(KeyValuePair<string, int>("雪", 9))
        let sequence: Sequence<KeyValuePair<string, int>> = pairs
        let copy = HashMap<string, int>(sequence, StringComparer.Ordinal)
        pairs[0] = KeyValuePair<string, int>("changed", 50)
        if copy.Find("Café") is not Some(7) || copy.Count != 2 {
            return false
        }
        let copiedMap = HashMap<string, int>(copy, StringComparer.Ordinal)
        copy.Set("Café", 70)
        if copiedMap.Find("Café") is not Some(7) {
            return false
        }
        let query = copiedMap.Filter(pair => pair.Value > 7)
        let materialized = query.ToMap(StringComparer.Ordinal)
        if materialized.Count != 1 || materialized.Find("雪") is not Some(9) {
            return false
        }
        let selected = sequence.ToMap(pair => pair.Key, pair => pair.Value + 1, StringComparer.Ordinal)
        if selected.Find("changed") is not Some(51) || selected.Find("雪") is not Some(10) {
            return false
        }
        let integers = ArrayList<KeyValuePair<int, int>>()
        integers.Add(KeyValuePair<int, int>(1, 2))
        integers.Add(KeyValuePair<int, int>(2, 3))
        let callbacks = HashMap<int, int>(integers, (left, right) => left == right, key => 1)
        if callbacks.Find(2) is not Some(3) || callbacks.Count != 2 {
            return false
        }
        let empty = ArrayList<KeyValuePair<string, int>>()
        if empty.ToMap(StringComparer.Ordinal).Count != 0 {
            return false
        }
        let objects = ArrayList<KeyValuePair<string, Item>>()
        let item = Item()
        objects.Add(KeyValuePair<string, Item>("item", item))
        let shared = HashMap<string, Item>(objects, StringComparer.OrdinalIgnoreCase)
        item.Value = 42
        if shared.Find("ITEM") is Some(let value) {
            return value.Value == 42
        }
        return false
    }

    static func Counts(input: ObservedNumbers, moves: int, reads: int) -> bool {
        return input.Requests == 1 && input.Moves == moves && input.Reads == reads && input.Disposals == 1
    }

    static func CheckQueryCleanup() -> bool {
        let any = ObservedNumbers()
        if !any.Any() || !Counts(any, 1, 0) {
            return false
        }
        let predicateAny = ObservedNumbers()
        if !predicateAny.Any(value => value == 2) || !Counts(predicateAny, 2, 2) {
            return false
        }
        let all = ObservedNumbers()
        if all.All(value => value < 3) || !Counts(all, 3, 3) {
            return false
        }
        let fold = ObservedNumbers()
        if fold.Fold(0, (sum, value) => sum + value) != 10 || !Counts(fold, 5, 4) {
            return false
        }
        let first = ObservedNumbers()
        if first.First() is not Some(1) || !Counts(first, 1, 1) {
            return false
        }
        let last = ObservedNumbers()
        if last.Last() is not Some(4) || !Counts(last, 5, 4) {
            return false
        }
        let single = ObservedNumbers()
        if single.Single() is not Error(SingleError.Multiple) || !Counts(single, 2, 1) {
            return false
        }
        let selectedFirst = ObservedNumbers()
        if selectedFirst.First(value => value == 2) is not Some(2) || !Counts(selectedFirst, 2, 2) {
            return false
        }
        let selectedLast = ObservedNumbers()
        if selectedLast.Last(value => value < 3) is not Some(2) || !Counts(selectedLast, 5, 4) {
            return false
        }
        let selectedSingle = ObservedNumbers()
        if selectedSingle.Single(value => value == 2) is not Ok(2) || !Counts(selectedSingle, 5, 4) {
            return false
        }
        let count = ObservedNumbers()
        if count.Count() != 4 || !Counts(count, 5, 0) {
            return false
        }
        let selectedCount = ObservedNumbers()
        if selectedCount.Count(value => value < 3) != 2 || !Counts(selectedCount, 5, 4) {
            return false
        }
        let list = ObservedNumbers()
        if list.ToList().Count != 4 || !Counts(list, 5, 4) {
            return false
        }
        let empty = ObservedNumbers()
        empty.Limit = 0
        if empty.Any() || !Counts(empty, 1, 0) {
            return false
        }
        let multiple = ObservedNumbers()
        if multiple.Single(value => value < 3) is not Error(SingleError.Multiple) || !Counts(multiple, 2, 2) {
            return false
        }
        let noMatch = ObservedNumbers()
        if noMatch.First(value => value > 4) is not None || !Counts(noMatch, 5, 4) {
            return false
        }
        return true
    }

    static func FirstFromLoop(input: Iterable<int>) -> int {
        for value in input {
            return value
        }
        return 0
    }

    static func CheckForCleanup() -> bool {
        let input = ObservedNumbers()
        var sum = 0
        for value in input {
            sum = sum + value
        }
        for value in input {
            break
        }
        for value in input {
            continue
        }
        if FirstFromLoop(input) != 1 || sum != 10 {
            return false
        }
        if input.Requests != 4 || input.Disposals != 4 {
            return false
        }
        outer: for value in input {
            for other in input {
                continue outer
            }
        }
        if input.Requests != 9 || input.Disposals != 9 {
            return false
        }
        input.Limit = 0
        for value in input {
            return false
        }
        return input.Requests == 10 && input.Disposals == 10
    }

    static func CheckCollectionConstruction() -> bool {
        let input = ObservedNumbers()
        let list = ArrayList<int>(input)
        let queue = ArrayQueue<int>(input)
        let stack = ArrayStack<int>(input)
        let set = HashSet<int>(input, ModuloTwo())
        if input.Requests != 4 || input.Moves != 20 || input.Reads != 16 || input.Disposals != 4 {
            return false
        }
        if list.Count != 4 || list[0] != 1 || list[3] != 4 || set.Count != 2 || !set.Contains(5) {
            return false
        }
        let copy = ArrayList<int>(list)
        list[0] = 99
        if copy[0] != 1 {
            return false
        }
        let query = ArrayList<int>(copy.Filter(value => value > 2))
        if query.Count != 2 || query[0] != 3 || query[1] != 4 {
            return false
        }
        let queueCopy = ArrayQueue<int>(queue)
        queue.Clear()
        let stackCopy = ArrayStack<int>(stack)
        stack.Clear()
        var expected = 1
        while expected <= 4 {
            if queueCopy.Dequeue() is Some(let queued) && stackCopy.Pop() is Some(let stacked) {
                if queued != expected || stacked != expected {
                    return false
                }
            } else {
                return false
            }
            expected = expected + 1
        }
        let ordinaryStack = ArrayStack<int>(copy)
        if ordinaryStack.Pop() is not Some(4) {
            return false
        }
        let setCopy = HashSet<int>(set, ModuloTwo())
        set.Clear()
        if setCopy.Count != 2 || !setCopy.Contains(6) {
            return false
        }
        let empty: int[] = []
        if ArrayList<int>(empty).Count != 0 || ArrayQueue<int>(empty).Count != 0 || ArrayStack<int>(empty).Count != 0 || HashSet<int>(empty, ModuloTwo()).Count != 0 {
            return false
        }
        let item = Item()
        let items: Item[] = [item]
        let copiedItems = ArrayList<Item>(items)
        let queuedItems = ArrayQueue<Item>(items)
        let stackedItems = ArrayStack<Item>(items)
        item.Value = 64
        if copiedItems[0].Value != 64 {
            return false
        }
        if queuedItems.Peek() is Some(let queued) && stackedItems.Peek() is Some(let stacked) {
            return queued.Value == 64 && stacked.Value == 64
        }
        return false
    }

    static func CheckSets() -> bool {
        let concrete = HashSet<int>(CollidingIntegers())
        let set: MutableSet<int> = concrete
        let view: Set<int> = concrete
        var index = 0
        while index < 24 {
            if !set.Add(index) || set.Add(index) {
                return false
            }
            index = index + 1
        }
        // Remove chain head, middle and tail, then reuse all free slots.
        if !set.Remove(23) || !set.Remove(12) || !set.Remove(0) || set.Remove(12) {
            return false
        }
        if view.Count != 21 || view.Contains(23) || view.Contains(12) || view.Contains(0) {
            return false
        }
        if !set.Add(24) || !set.Add(25) || !set.Add(26) || !set.Add(27) {
            return false
        }
        index = 1
        while index < 28 {
            if index != 12 && index != 23 && !view.Contains(index) {
                return false
            }
            index = index + 1
        }
        let snapshot = view.GetIterator()
        set.Clear()
        var captured = 0
        while snapshot.MoveNext() {
            captured = captured + 1
        }
        snapshot.Dispose()
        if captured != 25 || view.Count != 0 || !set.Add(42) {
            return false
        }
        let words = HashSet<string>(StringComparer.Ordinal)
        return words.Add("Café") && !words.Add("Café") && words.Add("café") && words.Add("雪") && words.Remove("Café") && words.Contains("café")
    }

}


class CollidingIntegers : EqualityComparer<int> {
    func Equals(left: int, right: int) -> bool => left == right
    func GetHashCode(value: int) -> int => 1
}

class ModuloTwo : EqualityComparer<int> {
    func Equals(left: int, right: int) -> bool => left % 2 == right % 2
    func GetHashCode(value: int) -> int => value % 2
}

class ObservedNumbers : Iterable<int> {
    var Limit: int { get; set; } = 4
    var Requests: int { get; set; } = 0
    var Moves: int { get; set; } = 0
    var Reads: int { get; set; } = 0
    var Disposals: int { get; set; } = 0

    func GetIterator() -> Iterator<int> {
        Requests = Requests + 1
        return ObservedNumberIterator(self)
    }
}

class ObservedNumberIterator : Iterator<int> {
    private var owner: ObservedNumbers
    private var index = 0

    init(owner: ObservedNumbers) {
        self.owner = owner
    }

    func MoveNext() -> bool {
        owner.Moves = owner.Moves + 1
        index = index + 1
        return index <= owner.Limit
    }

    val Current: int {
        get {
            owner.Reads = owner.Reads + 1
            return index
        }
    }

    func Dispose() {
        owner.Disposals = owner.Disposals + 1
    }
}
