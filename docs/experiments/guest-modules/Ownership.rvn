module Acme.CoffeeMaker.Tests

import System.*
import System.Introspection.*
import System.Option.*
import Acme.CoffeeMaker.*
import Acme.CoffeeMaker.Factories.*

func CheckOwnership() -> int {
    let machine = (NominalTypeInfo)typeof(Machine)
    let factory = (NominalTypeInfo)typeof(Factory)
    if let Some(owner) = machine.Module {
        if owner.Assembly.Name != "CoffeePackage" {
            return 7
        }
        if owner.Name != "Acme.CoffeeMaker" {
            return 1
        }
        if let Some(repeated) = machine.Module {
            if owner.Name != repeated.Name {
                return 2
            }
        } else {
            return 3
        }
        if let Some(other) = factory.Module {
            if other.Assembly.FullName != owner.Assembly.FullName || other.Assembly.Name != "CoffeePackage" {
                return 8
            }
            if other.Name != "Acme.CoffeeMaker.Factories" || owner.Name == other.Name {
                return 4
            }
        } else {
            return 5
        }
    } else {
        return 6
    }
    return 0
}
