unsafe func ReleaseValue(pointer: *int) -> unit {
    Release(pointer)
}

unsafe func Main() -> int {
    let pointer = (*int)Allocate(42, (nuint)4)
    if pointer == default(*int) {
        return -1
    }
    let failed = (*int)Allocate(42, (nuint)0)
    if failed != default(*int) {
        ReleaseValue(failed)
        ReleaseValue(pointer)
        return -2
    }
    if pointer != pointer {
        ReleaseValue(pointer)
        return -3
    }
    let initial = *pointer
    *pointer = initial + 1
    let result = Read(pointer) - 1
    Release(default(*int))
    ReleaseValue(pointer)
    return result + LiveCount() + CheckSize(ForwardSize(LargeSize())) + CheckOffset(ForwardOffset(SignedOffset()))
}

func ForwardSize(value: nuint) -> nuint {
    let copy = value
    return copy
}

func ForwardOffset(value: nint) -> nint {
    let copy = value
    return copy
}
