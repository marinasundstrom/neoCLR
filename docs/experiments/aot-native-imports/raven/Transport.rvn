unsafe func Main() -> int {
    let pointer = (*int)Allocate(42, (nuint)4)
    if pointer == default(*int) {
        return -1
    }
    let result = Read(pointer)
    Release(default(*unit))
    Release(pointer)
    let signed = ForwardSigned(SignedWide())
    let unsigned = ForwardUnsigned(UnsignedWide())
    if signed == default(long) || unsigned == default(ulong) {
        return -2
    }
    let floating = CheckFloating(
        ForwardSingle(SingleValue(0)), ForwardDouble(DoubleValue(0)), 123,
        ForwardSingle(SingleValue(1)), ForwardDouble(DoubleValue(1)),
        ForwardSingle(SingleValue(2)), ForwardDouble(DoubleValue(2)),
        ForwardSingle(SingleValue(3)), ForwardDouble(DoubleValue(3)),
        default(float), default(double), signed)
    return floating + CheckWide(signed, unsigned) + result + LiveCount() + CheckSize(ForwardSize(LargeSize())) + CheckOffset(ForwardOffset(SignedOffset()))
}

func ForwardSize(value: nuint) -> nuint {
    let copy = value
    return copy
}

func ForwardOffset(value: nint) -> nint {
    let copy = value
    return copy
}


func ForwardSigned(value: long) -> long {
    let copy = value
    return copy
}

func ForwardUnsigned(value: ulong) -> ulong {
    let copy = value
    return copy
}

func ForwardSingle(value: float) -> float {
    let copy = value
    return copy
}

func ForwardDouble(value: double) -> double {
    let copy = value
    return copy
}
