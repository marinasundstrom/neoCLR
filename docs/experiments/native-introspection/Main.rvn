import System.*
import System.Introspection.*
import System.Collections.*
import System.Runtime.Reflection.*
import System.Result.*
import System.Option.*

public class Report {
    init() { }
    var Name: string { get; set; } = "constructed"
}

func Main() -> int {
    let sequence = typeof(Sequence<Report>)
    if sequence.GenericArgumentCount != 1 || !sequence.GetGenericArgument(0).Equals(typeof(Report)) {
        return 26
    }
    let map = typeof(Map<string, ArrayList<Report>>)
    if map.GenericArgumentCount != 2 || !map.GetGenericArgument(0).Equals(typeof(string)) {
        return 27
    }
    let list = map.GetGenericArgument(1)
    if !list.Equals(typeof(ArrayList<Report>)) || !list.GetGenericArgument(0).Equals(typeof(Report)) {
        return 28
    }
    let info = (NominalTypeInfo)typeof(Report)
    Console.WriteLine(info.Name)
    if !info.IsNominalType {
        return 2
    }
    let value = match info.CreateInstance() {
        Ok(let created) => created
        Error(_) => return 3
    }
    let report = (Report)value
    if report.Name != "constructed" {
        return 4
    }
    if !value.GetType().Equals(info) {
        return 5
    }
    let properties = info.GetProperties()
    if properties.Count != 1 {
        return 12
    }
    let property = properties[0]
    if property.Name != "Name" || !property.PropertyType.Equals(typeof(string)) || !property.CanRead || !property.CanWrite {
        return 13
    }
    if property.SetValue(value, "reflected") is Error(_) {
        return 14
    }
    if property.GetValue(value) is Ok(let read) {
        if read is string text {
            if text != "reflected" || report.Name != text {
                return 15
            }
        } else {
            return 16
        }
    } else {
        return 17
    }
    if let Some(getter) = property.GetGetMethod() {
        if getter.Name != "get_Name" || !getter.IsPublic || !getter.ReturnType.Equals(typeof(string)) || getter.GetParameters().Count != 0 {
            return 18
        }
    } else {
        return 19
    }
    if let Some(setter) = property.GetSetMethod() {
        let parameters = setter.GetParameters()
        if setter.Name != "set_Name" || parameters.Count != 1 || parameters[0].Position != 0 || !parameters[0].ParameterType.Equals(typeof(string)) {
            return 20
        }
        if parameters[0].MetadataToken is None || parameters[0].Module is None {
            return 21
        }
    } else {
        return 22
    }
    if info.GetProperties(BindingFlags.NonPublic | BindingFlags.Instance).Count != 0 {
        return 23
    }
    if typeof(int[]).GetElementType() is Some(let element) {
        if !element.Equals(typeof(int)) {
            return 24
        }
    } else {
        return 25
    }
    let array = ArrayReflection.Create(typeof(int[]), [40, 2])
    if ArrayReflection.GetLength(array) != 2 || !array.GetType().Equals(typeof(int[])) {
        return 6
    }
    if ArrayReflection.GetValue(array, 0) is int number {
        if number != 40 {
            return 7
        }
    } else {
        return 8
    }
    let references = ArrayReflection.Create(typeof(Report[]), [report, null])
    if ArrayReflection.GetValue(references, 0) is Report shared {
        shared.Name = "shared"
    } else {
        return 9
    }
    if report.Name != "shared" || ArrayReflection.GetValue(references, 1) != null {
        return 10
    }
    let empty = ArrayReflection.Create(typeof(int[]), [])
    if ArrayReflection.GetLength(empty) != 0 {
        return 11
    }
    return 0
}
