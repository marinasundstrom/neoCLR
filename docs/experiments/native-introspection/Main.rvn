import System.*
import System.Introspection.*
import System.Runtime.Reflection.*
import System.Result.*

public class Report {
    init() { }
    var Name: string { get; set; } = "constructed"
}

func Main() -> int {
    let info = (NominalTypeInfo)typeof(Report)
    Console.WriteLine(info.Name)
    if !info.IsNominalType {
        return 2
    }
    let value = match info.CreateInstance() {
        Ok(let created) => created
        Error(_) => return 3
    }
    let report = (Report)value
    if report.Name != "constructed" {
        return 4
    }
    if !value.GetType().Equals(info) {
        return 5
    }
    return 0
}
