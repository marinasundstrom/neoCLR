import System.*

func Check(actual: string, expected: string) {
    if String.CompareOrdinal(actual, expected) != 0 {
        Panic("Trimming changed retained bytes or bounds")
    }
}

func Whitespace(text: string) {
    Check((text + "é👨‍👩‍👧‍👦" + text).Trim(), "é👨‍👩‍👧‍👦")
    Check((text + "x" + text).TrimStart(), "x" + text)
    Check((text + "x" + text).TrimEnd(), text + "x")
    Check(text.Trim(), "")
    Check(text.TrimStart(), "")
    Check(text.TrimEnd(), "")
}

func Main() {
    Whitespace("\u0009")
    Whitespace("\u000a")
    Whitespace("\u000b")
    Whitespace("\u000c")
    Whitespace("\u000d")
    Whitespace("\u0020")
    Whitespace("\u0085")
    Whitespace("\u00a0")
    Whitespace("\u1680")
    Whitespace("\u2000")
    Whitespace("\u2001")
    Whitespace("\u2002")
    Whitespace("\u2003")
    Whitespace("\u2004")
    Whitespace("\u2005")
    Whitespace("\u2006")
    Whitespace("\u2007")
    Whitespace("\u2008")
    Whitespace("\u2009")
    Whitespace("\u200a")
    Whitespace("\u2028")
    Whitespace("\u2029")
    Whitespace("\u202f")
    Whitespace("\u205f")
    Whitespace("\u3000")
    Check(" \t\r\nx\u00a0\u3000".Trim(), "x")
    Check("  x y  ".Trim(), "x y")
    Check(" \u0301 ".Trim(), "\u0301")
    Check("a \u0301".TrimEnd(), "a \u0301")
    Check("\u200b\ufeff\u180e".Trim(), "\u200b\ufeff\u180e")
    Check("\u0000".Trim(), "\u0000")
    let original = "é👨‍👩‍👧‍👦🇸🇪"
    if !Object.ReferenceEquals(original, original.Trim()) || !Object.ReferenceEquals(original, original.TrimStart()) || !Object.ReferenceEquals(original, original.TrimEnd()) {
        Panic("Unchanged trim must preserve owner")
    }
    let empty = ""
    if !Object.ReferenceEquals(empty, empty.Trim()) {
        Panic("Empty trim must preserve owner")
    }
    Check("".TrimStart(), "")
    Check("".TrimEnd(), "")
    Console.WriteLine("PASS string trimming")
}
