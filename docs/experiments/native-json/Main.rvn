import System.*
import System.Data.Json.*
import System.Result.*

public class Report {
    init() { }
    var Name: string { get; set; } = ""
    var Count: int { get; set; } = 0
    var Active: bool { get; set; } = false
}

public class Guarded {
    init() {
        System.Fail("Invalid input ran model code")
    }
    var Count: int { get; set; } = 0
    var Active: bool { get; set; } = false
}

public class Bulletin {
    init() { }
    var Title: string { get; set; } = ""
    var Current: Report { get; set; } = Report()
    var Previous: Report { get; set; } = Report()
}

public class NodeEnvelope {
    init() { }
    var Payload: JsonValue { get; set; } = JsonNull()
    var Details: JsonObject { get; set; } = JsonObject()
    var Items: JsonValue[] { get; set; } = []
}

public class GuardedNode {
    init() {
        System.Fail("Invalid node kind ran model code")
    }
    var Payload: JsonObject { get; set; } = JsonObject()
}

func CheckNodes() -> Result<bool, JsonError> {
    let input = "{\"Payload\":{\"message\":\"Café\"},\"Details\":{\"number\":1.25e2},\"Items\":[true,null,{\"value\":1}]}"
    let value = JsonSerializer.Deserialize<NodeEnvelope>(input)?
    if value.Payload is not JsonObject || value.Items.Length != 3 ||
       value.Items[0] is not JsonBoolean || value.Items[1] is not JsonNull ||
       value.Items[2] is not JsonObject {
        return Ok(false)
    }
    let number = value.Details.Field("number")?
    if number is JsonNumber numeric {
        if numeric.Text != "1.25e2" {
            return Ok(false)
        }
    } else {
        return Ok(false)
    }
    let text = JsonSerializer.Serialize(value)?
    if text != input {
        return Ok(false)
    }
    let copy = JsonSerializer.Deserialize<NodeEnvelope>(text)?
    let copiedText = JsonSerializer.Serialize(copy)?
    if copiedText != input {
        return Ok(false)
    }
    for scalar in ["null", "true", "1.25e2", "\"雪\"", "[]", "{}"] {
        let node = JsonSerializer.Deserialize<JsonValue>(scalar)?
        let serialized = JsonSerializer.Serialize(node)?
        if serialized != scalar {
            return Ok(false)
        }
    }
    let scalarString = JsonSerializer.Deserialize<JsonString>("\"text\"")?
    let scalarNumber = JsonSerializer.Deserialize<JsonNumber>("12.5")?
    let scalarBoolean = JsonSerializer.Deserialize<JsonBoolean>("false")?
    _ = JsonSerializer.Deserialize<JsonNull>("null")?
    let array = JsonSerializer.Deserialize<JsonArray>("[1]")?
    if scalarString.Value != "text" || scalarNumber.Text != "12.5" || scalarBoolean.Value || array.Count != 1 {
        return Ok(false)
    }
    if JsonSerializer.Deserialize<JsonObject>("[]") is not Error(JsonError.TypeMismatch(_)) ||
       JsonSerializer.Deserialize<JsonArray>("{}") is not Error(JsonError.TypeMismatch(_)) ||
       JsonSerializer.Deserialize<JsonString>("null") is not Error(JsonError.TypeMismatch(_)) ||
       JsonSerializer.Deserialize<GuardedNode>("{\"Payload\":[]}") is not Error(JsonError.TypeMismatch(_)) {
        return Ok(false)
    }
    let deep = JsonSerializer.DeserializeNode("[[[[]]]]")?
    value.Payload = deep
    if JsonSerializer.Serialize(value) is not Error(JsonError.LimitExceeded(_)) {
        return Ok(false)
    }
    let cycle = JsonArray()
    _ = cycle.Add(cycle)?
    value.Payload = cycle
    return Ok(JsonSerializer.Serialize(value) is Error(JsonError.LimitExceeded(_)))
}

func CheckDocument(input: string, canonical: string) -> Result<bool, JsonError> {
    let tree = JsonSerializer.DeserializeNode(input)?
    let text = JsonSerializer.SerializeNode(tree)?
    if text != canonical {
        return Ok(false)
    }
    let copy = JsonSerializer.DeserializeNode(text)?
    let copiedText = JsonSerializer.SerializeNode(copy)?
    return Ok(copiedText == canonical)
}

func CheckBulletin(input: string, canonical: string, title: string,
                   currentName: string, count: int, active: bool) -> Result<bool, JsonError> {
    let documentMatches = CheckDocument(input, canonical)?
    if !documentMatches {
        return Ok(false)
    }
    let value = JsonSerializer.Deserialize<Bulletin>(input)?
    if value.Title != title || value.Current.Name != currentName ||
       value.Current.Count != count || value.Current.Active != active ||
       value.Previous.Name != "Before" || value.Previous.Count != 0 || value.Previous.Active {
        return Ok(false)
    }
    let serialized = JsonSerializer.Serialize(value)?
    if serialized != canonical {
        return Ok(false)
    }
    let copy = JsonSerializer.Deserialize<Bulletin>(serialized)?
    return Ok(copy.Title == value.Title && copy.Current.Name == value.Current.Name &&
              copy.Current.Count == count && copy.Current.Active == active &&
              copy.Previous.Name == "Before" && copy.Previous.Count == 0 && !copy.Previous.Active)
}

func CheckArrays() -> Result<bool, JsonError> {
    let integers = JsonSerializer.Deserialize<int[]>("[1,-2,0]")?
    if integers.Length != 3 || integers[0] != 1 || integers[1] != -2 || integers[2] != 0 {
        return Ok(false)
    }
    let integerText = JsonSerializer.Serialize(integers)?
    let flags = JsonSerializer.Deserialize<bool[]>("[true,false]")?
    let names = JsonSerializer.Deserialize<string[]>("[\"Café\",\"雪\"]")?
    let empty = JsonSerializer.Deserialize<Report[]>("[]")?
    let reports = JsonSerializer.Deserialize<Report[]>("[{\"Name\":\"Café\",\"Count\":3,\"Active\":true}]")?
    let reportText = JsonSerializer.Serialize(reports)?
    return Ok(integerText == "[1,-2,0]" && flags.Length == 2 && flags[0] && !flags[1] &&
              names.Length == 2 && names[0] == "Café" && names[1] == "雪" && empty.Length == 0 &&
              reports.Length == 1 && reports[0].Name == "Café" && reports[0].Count == 3 && reports[0].Active &&
              reportText == "[{\"Name\":\"Café\",\"Count\":3,\"Active\":true}]")
}

func Main() -> int {
    if CheckNodes() is not Ok(true) {
        return 26
    }
    if CheckArrays() is not Ok(true) {
        return 25
    }
    if CheckBulletin(" {\"Title\":\"Weather\",\"Current\":{\"Name\":\"Café\",\"Count\":3,\"Active\":true},\"Previous\":{\"Name\":\"Before\",\"Count\":0,\"Active\":false}} ", "{\"Title\":\"Weather\",\"Current\":{\"Name\":\"Café\",\"Count\":3,\"Active\":true},\"Previous\":{\"Name\":\"Before\",\"Count\":0,\"Active\":false}}", "Weather", "Café", 3, true) is not Ok(true) {
        return 20
    }
    if CheckBulletin("{\"Title\":\"Empty title? No\",\"Current\":{\"Name\":\"雪\",\"Count\":-2147483648,\"Active\":false},\"Previous\":{\"Name\":\"Before\",\"Count\":0,\"Active\":false}}", "{\"Title\":\"Empty title? No\",\"Current\":{\"Name\":\"雪\",\"Count\":-2147483648,\"Active\":false},\"Previous\":{\"Name\":\"Before\",\"Count\":0,\"Active\":false}}", "Empty title? No", "雪", -2147483648, false) is not Ok(true) {
        return 21
    }
    if CheckDocument("{\"station\":\"Café\",\"readings\":[1,-2,0],\"flags\":[true,false,null],\"empty\":[],\"metadata\":{},\"detail\":{\"text\":\"雪\",\"decimal\":1.25e2}}", "{\"station\":\"Café\",\"readings\":[1,-2,0],\"flags\":[true,false,null],\"empty\":[],\"metadata\":{},\"detail\":{\"text\":\"雪\",\"decimal\":1.25e2}}") is not Ok(true) {
        return 22
    }
    if JsonSerializer.DeserializeNode("[1,]") is Ok(_) {
        return 23
    }
    if JsonSerializer.Deserialize<Bulletin>("{\"Title\":\"bad\",\"Current\":{\"Name\":\"ok\",\"Count\":3,\"Active\":true},\"Previous\":{\"Name\":\"Before\",\"Count\":\"wrong\",\"Active\":false}}") is Ok(_) {
        return 24
    }
    if JsonSerializer.Deserialize<Report>("{bad") is Ok(_) {
        return 3
    }
    if JsonSerializer.Deserialize<Report>("{\"Name\":\"Café\",\"Active\":true}") is Ok(_) {
        return 4
    }
    if JsonSerializer.Deserialize<Report>("{\"Name\":null,\"Count\":3,\"Active\":true}") is Ok(_) {
        return 5
    }
    if JsonSerializer.Deserialize<Report>("{\"Name\":\"Café\",\"Count\":3,\"Active\":1}") is Ok(_) {
        return 6
    }
    if JsonSerializer.Deserialize<Guarded>("{\"Count\":1,\"Active\":\"wrong\"}") is Ok(_) {
        return 7
    }
    let escaped = "{\"Name\":\"Café\\n\\\"\",\"Count\":-2147483648,\"Active\":false}"
    if let Ok(report) = JsonSerializer.Deserialize<Report>(escaped) {
        if report.Name != "Café\n\"" || report.Count != -2147483648 || report.Active {
            return 8
        }
        if let Ok(text) = JsonSerializer.Serialize(report) {
            if text != "{\"Name\":\"Café\\u000a\\\"\",\"Count\":-2147483648,\"Active\":false}" {
                return 9
            }
        } else {
            return 10
        }
    } else {
        return 11
    }
    let input = "{\"Name\":\"Café\",\"Count\":3,\"Active\":true}"
    if let Ok(report) = JsonSerializer.Deserialize<Report>(input) {
        if report.Name != "Café" || report.Count != 3 || !report.Active {
            return 1
        }
        if let Ok(text) = JsonSerializer.Serialize(report) {
            Console.WriteLine(text)
            return 0
        }
    }
    return 2
}
