import System.*
import System.Collections.*
import System.Data.Sql.*
import System.Data.PostgreSql.*
import System.Option.*
import System.Result.*
import System.Concurrency.Tasks.*

public class Person {
    init() { }
    var id: int { get; set; } = 0
    var name: string { get; set; } = ""
    var active: bool { get; set; } = false
}

public class WideParameters {
    init() { }
    val id: long => 2147483648L
}

func Check(value: bool, message: string) {
    if !value { System.Fail(message) }
}

async func Exercise(connection: SqlConnection) -> Task<Result<unit, SqlError>> {
    let values = ArrayList<SqlValue>()
    values.Add(SqlValue.Integer(42))
    values.Add(SqlValue.Text("Café'; SELECT 999; --"))
    values.Add(SqlValue.Boolean(true))
    let statement = SqlStatement("SELECT $1::int AS id, $2::text AS name, $3::bool AS active", values)
    let executed = await connection.Execute(statement)
    if let Failure(error) = executed { return Failure(error) }
    let Ok(mappedResult) = executed else { System.Fail("Expected successful SQL result") }
    let peopleResult = await SqlMapper.Query<Person>(connection, statement)
    if let Failure(error) = peopleResult { return Failure(error) }
    let Ok(people) = peopleResult else { System.Fail("Expected successful SQL result") }
    Check(people.Count == 1 && people[0].id == 42 && people[0].name == "Café'; SELECT 999; --" && people[0].active, "Mapped row")
    let selected = await SqlMapper.Query<string>(connection, statement, row => row.RequiredText("name"))
    Check(selected is Ok(_), "Callback mapping")
    let positional = await SqlMapper.Query<Person>(connection,
        "SELECT $1::int AS id, $2::text AS name, $3::bool AS active",
        43, "plain Café'; SELECT 999; --", true)
    let Ok(plain) = positional else { return Failure(SqlError.Mapping("Plain positional query")) }
    Check(plain.Count == 1 && plain[0].id == 43 && plain[0].name == "plain Café'; SELECT 999; --" && plain[0].active, "Plain positional values")
    let wide = await SqlMapper.Query<long>(connection, "SELECT $1::bigint AS id", row => row.Int64("id"), 2147483648L)
    let Ok(wideRows) = wide else { return Failure(SqlError.Mapping("Plain Int64 parameter")) }
    Check(wideRows[0] == 2147483648L, "Int64 parameter preserves width")
    let wideNamed = await SqlMapper.Query<long>(connection, "SELECT @id::bigint AS id", row => row.Int64("id"), WideParameters())
    let Ok(wideNamedRows) = wideNamed else { return Failure(SqlError.Mapping("Named Int64 parameter")) }
    Check(wideNamedRows[0] == 2147483648L, "Reflected Int64 parameter preserves width")
    let parameters = Person()
    parameters.id = 44
    parameters.name = "named Café'; SELECT 999; --"
    parameters.active = true
    let named = await SqlMapper.Query<Person>(connection,
        "SELECT @id::int AS id, @name::text AS name, @active::bool AS active WHERE @id::int = @id::int /* @missing /* nested */ */ -- @missing\n",
        parameters)
    let Ok(namedPeople) = named else { return Failure(SqlError.Mapping("Named object query")) }
    Check(namedPeople.Count == 1 && namedPeople[0].id == 44 && namedPeople[0].name == parameters.name && namedPeople[0].active, "Named values and repeated parameter")
    let quoted = await SqlMapper.Query<string>(connection,
        "SELECT '@missing' || \$\$@missing\$\$ || \$tag\$@missing\$tag\$ AS name, @id::int AS id",
        row => row.RequiredText("name"), parameters)
    let Ok(quotedValues) = quoted else { return Failure(SqlError.Mapping("Quoted parameter text")) }
    Check(quotedValues[0] == "@missing@missing@missing", "Quoted text unchanged")
    let noParameters = await SqlMapper.Query<Person>(connection,
        "SELECT 45 AS id, 'none'::text AS name, false AS active")
    Check(noParameters is Ok(_), "Empty params array")
    let nullParameter = await SqlMapper.Query<string>(connection,
        "SELECT COALESCE($1::text, 'null') AS name", row => row.RequiredText("name"), (Object?)null)
    let Ok(nullValue) = nullParameter else { return Failure(SqlError.Mapping("Plain null parameter")) }
    Check(nullValue[0] == "null", "Plain null maps to SQL NULL")
    let missingParameter = await SqlMapper.Query<Person>(connection, "SELECT @missing", parameters)
    Check(missingParameter is Failure(SqlError.Mapping(_)), "Missing named property")
    let mixedParameters = await SqlMapper.Query<Person>(connection, "SELECT @id, $1", parameters)
    Check(mixedParameters is Failure(SqlError.InvalidInput(_)), "Mixed placeholders rejected")
    let badMapping = await SqlMapper.Query<Person>(connection, "SELECT 'wrong'::text AS id")
    Check(badMapping is Failure(SqlError.Mapping(_)), "Query mapping error")
    let serverError = await SqlMapper.Query<Person>(connection, "SELEC invalid")
    Check(serverError is Failure(SqlError.Server("42601", _)), "Query SQLSTATE preserved")
    Check(await SqlMapper.Query<Person>(connection, "SELECT 46 AS id, 'recovered'::text AS name, true AS active") is Ok(_), "Query errors preserve caller connection")
    let nulls = ArrayList<SqlValue>()
    nulls.Add(SqlValue.Null)
    nulls.Add(SqlValue.Text(""))
    let nullable = await connection.Execute(SqlStatement("SELECT $1::text AS missing, $2::text AS empty", nulls))
    if let Failure(error) = nullable { return Failure(error) }
    let Ok(result) = nullable else { System.Fail("Expected successful SQL result") }
    Check(result.Row(0).Text("missing") is Ok(None), "NULL distinct from empty")
    Check(result.Row(0).Text("empty") is Ok(Some("")), "Empty text")
    Check(result.Row(0).RequiredText("missing") is Failure(_), "Required NULL fails")
    let emptyColumns = await connection.Execute(SqlStatement("SELECT FROM generate_series(1, 1)"))
    let Ok(emptyColumnRows) = emptyColumns else { return Failure(SqlError.Mapping("Zero-column SELECT failed")) }
    Check(emptyColumnRows.Count == 1 && emptyColumnRows.Row(0).Count == 0, "Zero-column row")
    let duplicate = await connection.Execute(SqlStatement("SELECT 1 AS id, 2 AS id"))
    if let Failure(error) = duplicate { return Failure(error) }
    let Ok(duplicateResult) = duplicate else { System.Fail("Expected successful SQL result") }
    Check(duplicateResult.Row(0).Text("id") is Failure(_), "Duplicate aliases")
    let created = await connection.Execute(SqlStatement("CREATE TEMP TABLE neoclr_sql_test (id integer PRIMARY KEY)"))
    if let Failure(error) = created { return Failure(error) }
    let began = await connection.Begin()
    if let Failure(error) = began { return Failure(error) }
    let Ok(transaction) = began else { System.Fail("Expected successful SQL result") }
    let nested = await connection.Begin()
    Check(nested is Failure(SqlError.InvalidState(_)), "Nested transaction rejected")
    let inserted = await connection.Execute(SqlStatement("INSERT INTO neoclr_sql_test VALUES (1)"))
    if let Failure(error) = inserted { return Failure(error) }
    let Ok(insertedResult) = inserted else { System.Fail("Expected successful SQL result") }
    Check(insertedResult.CommandTag == "INSERT 0 1", "Insert tag")
    let failed = await connection.Execute(SqlStatement("INSERT INTO neoclr_sql_test VALUES (1)"))
    Check(failed is Failure(SqlError.Server("23505", _)), "SQLSTATE preserved")
    let badCommit = await transaction.Commit()
    Check(badCommit is Failure(_), "Failed transaction cannot report commit")
    let rolledBack = await transaction.Rollback()
    if let Failure(error) = rolledBack { return Failure(error) }
    let counts = await connection.Execute(SqlStatement("SELECT count(*) AS total FROM neoclr_sql_test"))
    if let Failure(error) = counts { return Failure(error) }
    let Ok(countResult) = counts else { System.Fail("Expected successful SQL result") }
    let totalResult = countResult.Row(0).Int64("total")
    if let Failure(error) = totalResult { return Failure(error) }
    let Ok(total) = totalResult else { System.Fail("Expected successful SQL result") }
    Check(total == 0, "Rollback restored table")
    let syntax = await connection.Execute(SqlStatement("SELECT FROM"))
    Check(syntax is Failure(SqlError.Server("42601", _)), "Syntax SQLSTATE")
    let recovered = await connection.Execute(statement)
    if let Failure(error) = recovered { return Failure(error) }
    let started = await connection.Begin()
    if let Failure(error) = started { return Failure(error) }
    let Ok(committed) = started else { System.Fail("Expected successful SQL result") }
    let insertedAgain = await connection.Execute(SqlStatement("INSERT INTO neoclr_sql_test VALUES (2)"))
    if let Failure(error) = insertedAgain { return Failure(error) }
    let commit = await committed.Commit()
    if let Failure(error) = commit { return Failure(error) }
    let repeated = await committed.Commit()
    Check(repeated is Failure(_), "Completed transaction rejects reuse")
    committed.Dispose()
    let persisted = await connection.Execute(SqlStatement("SELECT count(*) AS total FROM neoclr_sql_test"))
    let Ok(persistedRows) = persisted else { return Failure(SqlError.Mapping("Commit count query failed")) }
    Check(persistedRows.Row(0).Int64("total") is Ok(1L), "Commit retained row and handle disposal left connection open")
    let invalid = await connection.Execute(SqlStatement("SELECT\u0000"))
    Check(invalid is Failure(SqlError.InvalidInput(_)), "NUL rejected before sending")
    let afterInvalid = await connection.Execute(statement)
    Check(afterInvalid is Ok(_), "Input rejection preserves connection")
    let abandoned = await connection.Begin()
    let Ok(abandon) = abandoned else { return Failure(SqlError.Mapping("Abandon begin failed")) }
    abandon.Dispose()
    // Returned rows own their data independently of transaction/connection lifetime.
    connection.Dispose()
    Check(result.Row(0).Text("empty") is Ok(Some("")), "Snapshot survives close")
    let afterClose = await connection.Execute(statement)
    Check(afterClose is Failure(_), "Closed connection rejects work")
    return Ok(())
}

async func Main(arguments: string[]) -> Task<()> {
    let Ok(port) = Int32.Parse(arguments[0]) else { System.Fail("Expected port") }
    let opened = await PostgresDatabase("postgres", "postgres", port, 60000).Open()
    if let Failure(error) = opened { Console.WriteLine(error.ToString()) }
    let Ok(openedConnection) = opened else { System.Fail("Open failed") }
    use connection = openedConnection
    let result = await Exercise(connection)
    if let Failure(error) = result { System.Fail(error.ToString()) }
    Console.WriteLine("PASS SQL PostgreSQL")
}
