import System.*
import System.Collections.*
import System.Data.Sql.*
import System.Option.*
import System.Result.*

func Check(condition: bool, message: string) {
    if !condition { System.Fail(message) }
}

func Main() {
    let names = ArrayList<string>()
    names.Add("id")
    let values = ArrayList<Option<string>>()
    values.Add(Some("2147483648"))
    let row = SqlRow(names, values)
    names[0] = "changed"
    values[0] = None
    Check(row.Column(0) is Ok("id"), "Column names copied")
    Check(row.Int32("id") is Error(_), "Int32 overflow")
    Check(row.Int64("id") is Ok(2147483648L), "Int64 explicit conversion")
    Check(row.Text(-1) is Error(_), "Negative index")
    Check(row.Text(1) is Error(_), "Upper index")
    Check(row.Text("missing") is Error(_), "Missing name")
    Check(row.Boolean("id") is Error(_), "Boolean conversion rejects integers")
    let parameters = ArrayList<SqlValue>()
    parameters.Add(SqlValue.Text("original"))
    let statement = SqlStatement("SELECT $1", parameters)
    parameters[0] = SqlValue.Null
    Check(statement.Parameter(0) is SqlValue.Text("original"), "Parameter sequence copied")
    let rows = ArrayList<SqlRow>()
    rows.Add(row)
    let result = SqlResult("SELECT 1", rows)
    rows.Add(row)
    Check(result.Count == 1, "Result rows copied")
    let mapping = SqlMapper.Map<int>(result, value => value.Int32("id"))
    Check(mapping is Error(_), "Mapping failure is propagated")
    let good = SqlMapper.Map<long>(result, value => value.Int64("id"))
    let Ok(mapped) = good else { System.Fail("Explicit Int64 map") }
    Check(mapped[0] == 2147483648L, "Explicit Int64 mapping result")
    Console.WriteLine("PASS SQL contracts")
}
