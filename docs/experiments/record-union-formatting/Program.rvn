import System.*
import System.Optional.*

union Choice {
    case Pair(left: int, right: string?)
    case Empty
}
record struct Optional(Value: Optional<int>)
record struct Nested(Value: Optional<Optional<string>>)
record struct PairValue(Value: Choice)

func Check(actual: string, expected: string) {
    if !actual.Equals(expected, StringComparison.Ordinal) {
        Console.WriteLine(actual)
        System.Fail("record union display mismatch")
    }
}

func Main() {
    Check(Optional(Some(42)).ToString(), "Optional { Value = Optional.Some(42) }")
    Check(Optional(None).ToString(), "Optional { Value = Optional.None }")
    let absent: Optional = default
    Check(absent.ToString(), "Optional { Value = <Uninitialized> }")
    Check(Nested(Some(Some("é"))).ToString(), "Nested { Value = Optional.Some(Optional.Some(\"é\")) }")
    Check(PairValue(Choice.Pair(7, null)).ToString(), "PairValue { Value = Choice.Pair(Left=7, Right=null) }")
    Check(PairValue(Choice.Empty).ToString(), "PairValue { Value = Choice.Empty }")
    let boxed: Object = Optional(Some(0))
    Check(boxed.ToString(), "Optional { Value = Optional.Some(0) }")
    Console.WriteLine("PASS record union formatting")
}
