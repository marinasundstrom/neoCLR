import System.*
import System.Text.*
import System.Optional.*

record struct Optional(Value: Optional<int>)

func Main(args: string[]) {
    var count = 0
    if args[0] != "baseline" {
        count = 128
    }
    var i = 0
    while i < count {
        var text = ""
        if args[0] == "generated" {
            text = Optional(Some(i)).ToString()
        } else {
            let builder = StringBuilder()
            builder.Append("Optional { ")
            builder.Append("Value = ")
            builder.Append("Optional.Some")
            builder.Append("(")
            builder.Append(i.ToString())
            builder.Append(")")
            builder.Append(" }")
            text = builder.ToString()
        }
        if text.GetUtf8ByteCount() < 34 {
            System.Fail("record display missing")
        }
        i += 1
    }
    Console.WriteLine("PASS")
}
