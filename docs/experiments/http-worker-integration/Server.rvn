import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Networking.Sockets.*
import System.Web.Http.*

class Application {
    private val identity: string

    init(identity: string) {
        self.identity = identity
    }

    async func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
        if request.Target == "/fault" {
            Panic("Injected HTTP worker failure")
        }
        let resumed = await Task.Run(() => 42)
        if resumed != 42 {
            Panic("Worker continuation failed")
        }
        return Ok(HttpResponse(200, ArrayList<HttpHeader>(), HttpStringContent(identity)))
    }
}

async func Main() -> Task<()> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 64) else { Panic("Listen failed") }
    let Ok(control) = Socket.Listen("127.0.0.1", 0, 1) else { Panic("Control failed") }
    let Ok(port) = server.GetLocalPort() else { Panic("Port failed") }
    let Ok(controlPort) = control.GetLocalPort() else { Panic("Control port failed") }
    let application = Application(controlPort.ToString())
    let lifetime = server.Serve(application.Respond)
    Console.WriteLine("READY " + port.ToString() + " " + controlPort.ToString())
    let Ok(signal) = await control.Accept() else { Panic("Control accept failed") }
    signal.Close()
    control.Close()
    server.Close()
    if let Failure(_) = await lifetime { Panic("Serve failed") }
    Console.WriteLine("DONE " + controlPort.ToString() + " " + server.CompletedRequests.ToString() + " " + server.FailedRequests.ToString())
}
