union Choice {
    case Some(int)
    case None
}

func Bind(item: Choice) -> int {
    let Choice.Some(value) = item else {
        return -1
    }
    return value
}

func Conditional(item: Choice) -> int {
    if let Choice.Some(value) = item {
        return value
    } else {
        return -2
    }
}

func Main() -> int {
    let some = Choice.Some(42)
    let none = Choice.None
    if Bind(some) != 42 || Bind(none) != -1 {
        return 1
    }
    if Conditional(some) != 42 || Conditional(none) != -2 {
        return 2
    }
    return 0
}
