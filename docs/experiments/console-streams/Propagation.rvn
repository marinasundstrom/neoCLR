import System.*
import System.IO.*
import System.Result.*
import System.Option.*

func ReadInput() -> Result<unit, TextReadError> {
    let Some(input) = Console.ReadLine()? else {
        Console.WriteLine("No input")
        return Ok(())
    }
    Console.WriteLine("Input is: $input")
    return Ok(())
}

func Main() {
    match ReadInput() {
        Ok(_) => { }
        Error(_) => {
            let diagnostics = Console.Error
            let Ok(_) = diagnostics.WriteLine("Could not read input") else {
                System.Fault("Could not write diagnostic")
                return
            }
            let Ok(_) = diagnostics.Flush() else {
                System.Fault("Could not write diagnostic")
                return
            }
        }
    }
}
