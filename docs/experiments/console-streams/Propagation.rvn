import System.*
import System.IO.*
import System.Result.*
import System.Optional.*

func ReadInput() -> Result<unit, TextReadError> {
    let result = Console.ReadLine()
    return DescribeInput(result)
}

func DescribeInput(result1: Result<Optional<string>, TextReadError>) -> Result<unit, TextReadError> {
    let Some(input) = result1? else {
        Console.WriteLine("No input")
        return Ok(())
    }
    Console.WriteLine("Input is: $input")
    return Ok(())
}

func Main() {
    match ReadInput() {
        Ok(_) => { }
        Failure(_) => {
            let diagnostics = Console.Error
            let result2 = diagnostics.WriteLine("Could not read input")
            let Ok(_) = result2 else {
                System.Fail("Could not write diagnostic")
                return ()
            }
            let result3 = diagnostics.Flush()
            let Ok(_) = result3 else {
                System.Fail("Could not write diagnostic")
                return ()
            }
        }
    }
    return ()
}
