import System.*
import System.IO.*
import System.Result.*
import System.Option.*

func ReadInput() -> Result<unit, TextReadError> {
    let result = Console.ReadLine()
    return DescribeInput(result)
}

func DescribeInput(result1: Result<Option<string>, TextReadError>) -> Result<unit, TextReadError> {
    if let Some(input) = result1? {
        Console.WriteLine("Input is: $input")
    } else {
        Console.WriteLine("No input")
        return Ok(())
    }
    return Ok(())
}

func Main() {
    match ReadInput() {
        Ok(_) => { }
        Error(_) => {
            let diagnostics = Console.Error
            let result1 = diagnostics.WriteLine("Could not read input")
            let Ok(_) = result1 else {
                System.Fail("Could not write diagnostic")
                return ()
            }
            let result2 = diagnostics.Flush()
            let Ok(_) = result2 else {
                System.Fail("Could not write diagnostic")
                return ()
            }
        }
    }
    return ()
}
