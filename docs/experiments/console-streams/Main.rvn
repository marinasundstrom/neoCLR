import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import System.Option.*

async func Main() -> Task<()> {
    await Console.Write("Name: ")
    let diagnostics = Console.Error
    let result1 = await Console.ReadLine(128)
    let Ok(line) = result1 else {
        let result2 = await diagnostics.WriteLine("Could not read a UTF-8 line (maximum 128 bytes)")
        let Ok(_) = result2 else {
            System.Fail("Could not write diagnostic")
            return ()
        }
        let result3 = await diagnostics.Flush()
        let Ok(_) = result3 else {
            System.Fail("Could not write diagnostic")
            return ()
        }
        return ()
    }
    let Some(name) = line else {
        Console.WriteLine("End of input")
        return ()
    }
    let output = Console.Out
    let result4 = await output.WriteLine("Hello, $name")
    let Ok(_) = result4 else {
        System.Fail("Could not write greeting")
        return ()
    }
    let result5 = await output.Flush()
    let Ok(_) = result5 else {
        System.Fail("Could not flush greeting")
        return ()
    }
    let result6 = await diagnostics.WriteLine("Read one line")
    let Ok(_) = result6 else {
        System.Fail("Could not write diagnostic")
        return ()
    }
    let result7 = await diagnostics.Flush()
    let Ok(_) = result7 else {
        System.Fail("Could not write diagnostic")
        return ()
    }
    return ()
}
