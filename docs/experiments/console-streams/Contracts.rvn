import System.*
import System.Concurrency.Tasks.*
import System.Concurrency.Tasks.TaskOutcome.*
import System.Concurrency.*
import System.IO.*
import System.Collections.*
import System.Result.*
import System.Optional.*

func Check(value: bool) {
    if !value {
        System.Fail("Console stream contract failed")
    }
}

class ShortOutput : OutputStream {
    private var bytes: List<byte> = ArrayList<byte>()
    private var closed: bool = false
    val Closed: bool => closed
    val Count: int => bytes.Count
    func ByteAt(index: int) -> byte => bytes[index]
    private func WriteCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Failure(StreamError.Closed)
        }
        if count == 0 {
            return Ok(0)
        }
        bytes.Add(buffer[offset])
        return Ok(1)
    }
    private func FlushCore() -> Result<unit, StreamError> {
        return Ok(())
    }
    func Close() {
        closed = true
    }

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(WriteAll(buffer, offset, count))
    }
    private func WriteAll(buffer: byte[], offset: int, count: int) -> Result<unit, StreamError> {
        var sent = 0
        while !(sent >= count) {
            let amount = WriteCore(buffer, offset + sent, count - sent)?
            if amount == 0 {
                return Failure(StreamError.IoFailure)
            }
            sent += amount
        }
        return Ok(())
    }
    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(FlushCore())
    }
}

class ZeroOutput : OutputStream {
    private func WriteCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        return Ok(0)
    }
    private func FlushCore() -> Result<unit, StreamError> {
        return Ok(())
    }
    func Close() { }

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(WriteAll(buffer, offset, count))
    }
    private func WriteAll(buffer: byte[], offset: int, count: int) -> Result<unit, StreamError> {
        var sent = 0
        while !(sent >= count) {
            let amount = WriteCore(buffer, offset + sent, count - sent)?
            if amount == 0 {
                return Failure(StreamError.IoFailure)
            }
            sent += amount
        }
        return Ok(())
    }
    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(FlushCore())
    }
}

func ReadExpected(reader: TextReader, bound: int, expected: string) -> Result<unit, TextReadError> {
    let Some(text) = CompletedValue(reader.ReadLine(bound))? else {
        System.Fail("Unexpected EOF")
        return Ok(())
    }
    Check(text == expected)
    return Ok(())
}

func ReadExpectedSync(reader: SyncTextReader, bound: int, expected: string) -> Result<unit, TextReadError> {
    let Some(text) = reader.ReadLine(bound)? else {
        System.Fail("Unexpected EOF")
    }
    Check(text == expected)
    return Ok(())
}

func Main() {
    let Ok(stopped) = StreamWriter.Create(ZeroOutput()) else {
        System.Fail("Unable to create text wrapper")
    }
    match CompletedValue(stopped.Write("x")) {
        Failure(let error) => Check((error is System.IO.StreamError.IoFailure))
        Ok(_) => System.Fail("Zero-progress output was accepted")
    }
    let destination = ShortOutput()
    let Ok(writer) = StreamWriter.Create(destination, true) else {
        System.Fail("Unable to create text wrapper")
    }
    match CompletedValue(writer.WriteLine("å")) {
        Ok(let count) => Check(count == 3)
        Failure(_) => System.Fail("Short writes were not handled")
    }
    Check(destination.Count == 3)
    Check(destination.ByteAt(0) == 195 && destination.ByteAt(1) == 165 && destination.ByteAt(2) == 10)
    writer.Close()
    Check(!destination.Closed)
    match CompletedValue(writer.Write("")) {
        Failure(let error) => Check((error is System.IO.StreamError.Closed))
        Ok(_) => System.Fail("Closed writer accepted text")
    }
    let Ok(owned) = StreamWriter.Create(destination) else {
        System.Fail("Unable to create text wrapper")
    }
    owned.Close()
    Check(destination.Closed)

    let input = Console.OpenStandardInput()
    let Ok(reader) = SyncStreamReader.Create(input, true) else {
        System.Fail("Unable to create text wrapper")
    }
    reader.NewLine = "\r\n"
    Check(ReadExpectedSync(reader, 2, "å") is Ok(_))
    reader.NewLine = "\n"
    Check(ReadExpectedSync(reader, 0, "") is Ok(_))
    reader.Close()
    // Closing the reader leaves this stream open, at the next unread byte.
    let Ok(next) = SyncStreamReader.Create(input) else {
        System.Fail("Unable to create text wrapper")
    }
    Check(ReadExpectedSync(next, 4, "tail") is Ok(_))
    let Ok(end) = next.ReadLine(0) else {
        System.Fail("Could not read EOF")
        return
    }
    Check(end is None)
    next.Close()
    let buffer: byte[] = [(byte)0]
    match input.Read(buffer[..0]) {
        Failure(let error) => Check((error is System.IO.StreamError.Closed))
        Ok(_) => System.Fail("Owned input was not closed")
    }
    // Closing a wrapper must not close the process channel.
    let closed = Console.OpenStandardOutput()
    closed.Close()
    match closed.Write(buffer) {
        Failure(let error) => Check((error is System.IO.StreamError.Closed))
        Ok(_) => System.Fail("Closed output accepted bytes")
    }
    let output = Console.OpenStandardOutput()
    let raw: byte[] = [(byte)65, (byte)10]
    match output.Write(raw) {
        Ok(_) => { }
        Failure(_) => System.Fail("Byte output failed")
    }
    let Ok(_) = output.Flush() else {
        System.Fail("Could not flush raw output")
        return
    }
    Console.Write(42)
    Console.WriteLine()
    Console.WriteLine("Console stream contracts passed")
}

// This fixture deliberately asserts immediate completion of memory/console providers.
func CompletedValue<T>(operation: Task<T>) -> T {
    let Some(Completed(value)) = operation.Outcome else {
        System.Fail("Expected inline fixture completion")
    }
    return value
}
