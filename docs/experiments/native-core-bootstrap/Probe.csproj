    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NeoClrMetadataProject>$(MSBuildThisFileDirectory)../../../tools/metadata/NeoCLR.Metadata.Experimental/NeoCLR.Metadata.Experimental.csproj</NeoClrMetadataProject>
