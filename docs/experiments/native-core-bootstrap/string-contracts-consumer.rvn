module Example.StringContracts

import System.*
import System.Collections.*

class TextCell : Sequence<string>, Iterator<string>, EquatableTo<string> {
    private val text: string
    private var visited = false
    private var disposed = false

    init(text: string) {
        self.text = text
    }

    val Count: int => 1
    val self[index: int]: string => text
    val Current: string => text
    val IsDisposed: bool => disposed

    func GetIterator() -> Iterator<string> {
        return self
    }

    func MoveNext() -> bool {
        if visited {
            return false
        }
        visited = true
        return true
    }

    func Dispose() {
        disposed = true
    }

    func Equals(other: string) -> bool {
        return String.CompareOrdinal(text, other) == 0
    }
}

func Main() -> int {
    let payload = "hé🙂\u0000text"
    let cell = TextCell(payload)
    let sequence: Sequence<string> = cell
    if sequence.Count != 1 {
        return 1
    }
    if String.CompareOrdinal(sequence[0], payload) != 0 {
        return 2
    }
    let iterator = sequence.GetIterator()
    if !iterator.MoveNext() {
        return 3
    }
    if String.CompareOrdinal(iterator.Current, payload) != 0 {
        return 4
    }
    if iterator.MoveNext() {
        return 5
    }
    iterator.Dispose()
    if !cell.IsDisposed {
        return 6
    }
    let equality: EquatableTo<string> = cell
    if !equality.Equals(payload) {
        return 7
    }
    if equality.Equals("different") {
        return 8
    }
    return 42
}
