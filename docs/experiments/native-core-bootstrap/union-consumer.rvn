module Example.Unions

import System.*
import System.Optional.*
import System.Result.*

func Unwrap(option: Optional<int>) -> int {
    let Some(value) = option else {
        return 2
    }
    return value
}

func Main() -> int {
    let present = Optional<int>.Some(40)
    let absent = Optional<int>.None()
    if Unwrap(absent) != 2 {
        return 1
    }
    let Ok(number) = Result<int, string>.Ok(Unwrap(present)) else {
        return 2
    }
    let failure = Result<int, string>.Failure("hé🙂\u0000error")
    let Failure(message) = failure else {
        return 3
    }
    if String.CompareOrdinal(message, "hé🙂\u0000error") != 0 {
        return 4
    }
    if let Some(_) = absent {
        return 5
    }
    if let Failure(_) = Result<int, string>.Ok(42) {
        return 6
    }
    if let Some(value) = present {
        if value != number {
            return 7
        }
    } else {
        return 8
    }
    if let Failure(text) = failure {
        if text.GetByteCount() != 13 {
            return 9
        }
    } else {
        return 10
    }
    var output = 99
    if absent.TryGetOutput(out output) || output != 0 {
        return 11
    }
    if !present.TryGetOutput(out output) || output != 40 {
        return 12
    }
    var residual = ""
    if !failure.TryGetResidual(out residual) || String.CompareOrdinal(residual, message) != 0 {
        return 13
    }
    var unit: System.Void = ()
    if !absent.TryGetResidual(out unit) {
        return 14
    }
    return number + Unwrap(absent)
}
