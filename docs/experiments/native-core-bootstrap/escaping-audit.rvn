module Example.EscapingAudit

import System.*

func Main() -> int {
    let payload = "quote\"slash\\end🙂\u0000"
    let actual = Option<string>.Some(payload).ToString()
    let escaped = "Option.Some(\"quote\\\"slash\\\\end🙂\u0000\")"
    if String.CompareOrdinal(actual, escaped) != 0 {
        return 1
    }
    let error = Result<string, string>.Error(payload).ToString()
    if String.CompareOrdinal(error, "Result.Error(\"quote\\\"slash\\\\end🙂\u0000\")") != 0 {
        return 2
    }
    if String.CompareOrdinal("aaaaa".Replace("aa", "X"), "XXa") != 0 {
        return 3
    }
    if String.CompareOrdinal("banana".Replace("na", ""), "ba") != 0 {
        return 4
    }
    return 42
}
