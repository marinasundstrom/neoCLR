module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedTimerTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main() -> Task<int> {
    // Preserve the combined synchronous sequence and the five async lifecycles.
    let suite = TestSuite()
    let synchronousChecks = CompletedTimerTest(await `Synchronous timers preserve one shot stop disposal repeat and reschedule lifecycles`())
    suite.Add("timers-synchronousChecks", "Synchronous timers preserve one shot stop disposal repeat and reschedule lifecycles", synchronousChecks.Invoke)
    let asyncRepeat = CompletedTimerTest(await `Async repeating timers wait for callback completion`())
    suite.Add("timers-asyncRepeat", "Async repeating timers wait for callback completion", asyncRepeat.Invoke)
    let asyncRestart = CompletedTimerTest(await `Restarting an async timer does not overlap callbacks`())
    suite.Add("timers-asyncRestart", "Restarting an async timer does not overlap callbacks", asyncRestart.Invoke)
    let asyncDispose = CompletedTimerTest(await `Disposal allows the active async callback to finish`())
    suite.Add("timers-asyncDispose", "Disposal allows the active async callback to finish", asyncDispose.Invoke)
    let asyncCancellation = CompletedTimerTest(await `Cancelled callbacks stop repeating timers`())
    suite.Add("timers-asyncCancellation", "Cancelled callbacks stop repeating timers", asyncCancellation.Invoke)
    let pendingCancellation = CompletedTimerTest(await `Pending callback cancellation stops repeating timers`())
    suite.Add("timers-pendingCancellation", "Pending callback cancellation stops repeating timers", pendingCancellation.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
