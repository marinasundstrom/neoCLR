import System.*
import System.Result.*
import System.Option.*
import System.Collections.*
import System.Tasks.*
import System.Text.*
import System.Networking.*
import System.Networking.Sockets.*

import System.Web.Http.*

async func ReadGreeting(client: HttpClient, url: string) -> Task<Result<string, string>> {
    // Keep the structured HTTP error inside the client; format it at this app boundary.
    return (await client.GetString(url)).MapError(error => error.ToString())
}

async func Main() -> Task<()> {
    CheckHandlers()
    Console.WriteLine("Handler checks passed")
    // The verifier substitutes an ephemeral port and controls the peer.
    let events = ArrayList<string>()
    let client = HttpClient(RecordingHandler("transport", HttpSocketHandler(), events))
    client.BaseUri = Some("http://localhost:19091/")
    let fetching = ReadGreeting(client, "greeting")
    TaskQueue.Default.Post(() => Console.WriteLine("Other work runs while HTTP is pending"))
    let result = await fetching
    Check(events.Count == 2)
    Check(events[0] == "transport before" && events[1] == "transport after")
    if let Ok(text) = result {
        Console.WriteLine("HTTP 200")
        Console.WriteLine(text)
    } else if let Error(message) = result {
        Console.WriteLine(String.Concat("HTTP error: ", message))
    }
    return ()
}
