import System.*
import System.Result.*
import System.Optional.*

static class InputOutcomes {
    static func Present(value: byte) -> Result<Optional<byte>, ConsoleReadError> {
        let option: Optional<byte> = Some(value)
        return Ok(option)
    }

    static func End() -> Result<Optional<byte>, ConsoleReadError> {
        let option: Optional<byte> = None()
        return Ok(option)
    }
}

func Main() -> int {
    let Ok(option) = InputOutcomes.Present((byte)255) else {
        return 1
    }
    let Some(value) = option else {
        return 2
    }
    if value != 255 {
        return 3
    }
    let Ok(absent) = InputOutcomes.End() else {
        return 4
    }
    if let None = absent {
        return 0
    }
    return 5
}
