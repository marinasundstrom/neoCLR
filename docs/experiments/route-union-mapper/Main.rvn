import System.*
import System.Result.*

public func Check(value: bool, message: string) {
    if !value {
        System.Fail(message)
    }
}

func Main() {
    let Ok(parser) = AppRoutesParser.Create() else {
        System.Fail("Mapper creation failed")
        return
    }
    Check(parser.Parse("/items") is Ok(AppRoutes.ListItems), "empty case")
    let Ok(AppRoutes.GetItem(first)) = parser.Parse("/items/42?details=true") else {
        System.Fail("Typed case missing")
        return
    }
    Check(first == 42, "typed parameter")
    let Ok(AppRoutes.GetItem(second)) = parser.Parse("/items/-7") else {
        System.Fail("Reused mapper failed")
        return
    }
    Check(second == -7 && first == 42, "independent captures")
    Check(parser.Parse("/missing") is Error(RouteMappingError.NoMatch), "no match")
    Check(parser.Parse("/items/no") is Error(RouteMappingError.InvalidParameter(_, _)), "invalid parameter")
    Check(parser.Parse("/items/2147483648") is Error(RouteMappingError.InvalidParameter(_, _)), "overflow")
    Check(parser.Parse("/items/%2F") is Error(RouteMappingError.InvalidTarget(_)), "invalid target")
    let Ok(AppRoutes.GetItem(encoded)) = parser.Parse("/items/%34%32") else {
        System.Fail("Encoded integer failed")
        return
    }
    Check(encoded == 42, "decoded parameter")
    let original: AppRoutes = AppRoutes.GetItem(9)
    var copy = original
    copy = AppRoutes.ListItems()
    let AppRoutes.GetItem(preserved) = original else {
        System.Fail("Union copy changed original")
        return
    }
    Check(preserved == 9 && copy is AppRoutes.ListItems, "union copy")
    let boxed: Object = original
    if boxed is AppRoutes restored {
        let AppRoutes.GetItem(value) = restored else {
            System.Fail("Boxed case changed")
            return
        }
        Check(value == 9, "union boxing")
    } else {
        System.Fail("Union box missing")
    }
    Console.WriteLine("Attributed route mapper checks passed")
}
