import System.*
import System.Option.*
import System.Result.*
import System.Web.Http.*

// Direct matching needs no application union or dispatch mechanism.
func ReadStationId(pattern: RoutePattern, target: string) -> Result<Option<int>, string> {
    let matched = pattern.Match(target)?
    let Some(parameters) = matched else {
        return Ok(None())
    }
    let id = parameters.GetInt32("stationId")?
    return Ok(Some(id))
}
