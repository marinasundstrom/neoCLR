import System.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

// Configure BaseUri to the service root before calling.
async func ReplaceText(client: HttpClient, text: string) -> Task<Result<HttpResponse, HttpError>> {
    let response = await client.Put("item", HttpStringContent(text))?
    if !response.IsSuccessStatusCode {
        return Failure(HttpError.UnsuccessfulStatus(response.StatusCode))
    }
    return Ok(response)
}
