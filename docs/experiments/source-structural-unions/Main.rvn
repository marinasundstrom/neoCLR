import System.*
import System.Introspection.*
import System.Concurrency.Tasks.*

class Response { val Code: int => 42 }
class HttpError { val Code: int => 43 }
class JsonError { val Code: int => 44 }

func Echo(value: Response | HttpError | JsonError) -> Response | HttpError | JsonError {
    return value
}

func Complete(value: Response | HttpError | JsonError) -> Task<Response | HttpError | JsonError> {
    let promise = Promise<Response | HttpError | JsonError>()
    _ = promise.Complete(value)
    return promise.Task
}

func Pending(value: Response | HttpError | JsonError) -> Task<Response | HttpError | JsonError> {
    let promise = Promise<Response | HttpError | JsonError>()
    TaskQueue.Default.Post(() => {
        _ = promise.Complete(value)
    })
    return promise.Task
}

async func Main() -> Task<int> {
    let info = typeof(Response | HttpError | JsonError)
    if info is UnionTypeInfo unionInfo {
        var count = 0
        for item in unionInfo.Types {
            count += 1
        }
        if count != 3 || !info.IsUnion { Panic("union descriptor") }
    } else { Panic("missing union descriptor") }
    let taskInfo = typeof(Task<Response | HttpError | JsonError>)
    if !taskInfo.GetGenericArgument(0).Equals(info) { Panic("generic union") }
    let local: Response | HttpError | JsonError = Echo(Response())
    let response = await Complete(local)
    if response is Response result {
        if result.Code != 42 { Panic("response payload") }
    } else { Panic("response alternative") }
    let http = await Complete(HttpError())
    if http is HttpError httpResult {
        if httpResult.Code != 43 { Panic("http payload") }
    } else { Panic("http alternative") }
    let json = await Complete(JsonError())
    if json is JsonError jsonResult {
        if jsonResult.Code != 44 { Panic("json payload") }
    } else { Panic("json alternative") }
    let pendingResponse = await Pending(Response())
    if pendingResponse is Response pendingResponseResult {
        if pendingResponseResult.Code != 42 {
            Panic("pending response payload")
        }
    } else {
        Panic("pending response alternative")
    }
    let pendingHttp = await Pending(HttpError())
    if pendingHttp is HttpError pendingHttpResult {
        if pendingHttpResult.Code != 43 {
            Panic("pending http payload")
        }
    } else {
        Panic("pending http alternative")
    }
    let pendingJson = await Pending(JsonError())
    if pendingJson is JsonError pendingJsonResult {
        if pendingJsonResult.Code != 44 {
            Panic("pending json payload")
        }
    } else {
        Panic("pending json alternative")
    }
    Console.WriteLine("Source structural union Task delivery passed")
    return 0
}
