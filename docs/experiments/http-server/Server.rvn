import System.*
import System.Collections.*
import System.Result.*
import System.Tasks.*
import System.Text.*
import System.Web.Http.*

func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
    let source = Promise<Result<HttpResponse, HttpError>>()
    if request.Method != "GET" || request.Target != "/greeting" || request.Headers.Count == 0 {
        _ = source.Complete(Error(HttpError.Handler("Unexpected request")))
        return source.Task
    }
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("Content-Type", "text/plain; charset=utf-8"))
    _ = source.Complete(Ok(HttpResponse(200, headers, Utf8.Encode("Café 🌍"))))
    return source.Task
}

async func Start(server: HttpServer) -> Task<()> {
    let serving = server.ServeOne(Respond)
    TaskQueue.Default.Post(() => Console.WriteLine("Other work runs while HTTP accept is pending"))
    let result = await serving
    server.Close()
    if let Ok(_) = result {
        Console.WriteLine("Served greeting; server closed")
    } else if let Error(message) = result {
        Console.WriteLine(String.Concat("Server error: ", message.ToString()))
    }
}

func ListenAndServe() -> Task<()> {
    if let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) {
        if let Ok(port) = server.GetLocalPort() {
            Console.WriteLine(port)
            return Start(server)
        }
        server.Close()
        System.Fail("Local port unavailable")
    }
    System.Fail("Listen failed")
    return Promise<()>().Task
}

async func Main() -> Task<()> {
    await ListenAndServe()
}
