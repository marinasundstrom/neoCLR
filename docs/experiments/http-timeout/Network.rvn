module NeoClr.RuntimeTests

import System.*
import System.Optional.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Time.*
import System.Web.Http.*
import NeoClr.Testing.*

[Test]
async func `Network timeout reports TimedOut`(url: string) -> Task<Result<unit, TestFailure>> {
    let client = HttpClient()
    client.Timeout = Some(Duration.FromTicks(20000000L))
    let result = await client.Get(url)
    client.Dispose()
    return Assert.True(result is Failure(HttpError.TimedOut), "Network request reports a timeout")
}

[Test]
async func `Disabled timeout permits a delayed network response`(url: string) -> Task<Result<unit, TestFailure>> {
    let client = HttpClient()
    client.Timeout = Optional<Duration>.None()
    let result = await client.Get(url)
    client.Dispose()
    let Ok(response) = result else { return Assert.True(false, "Delayed network request succeeds") }
    return Assert.Equal(200, (int)response.StatusCode)
}
