import System.*
import System.Collections.*
import System.Concurrency.*
import System.Optional.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Time.*
import System.Web.Http.*

class ImmediateHandler : HttpHandler {
    override func Send(request: HttpClientRequest, cancellationToken: CancellationToken) -> Task<Result<HttpClientResponse, HttpError>> {
        return Task.FromResult<Result<HttpClientResponse, HttpError>>(System.Result<HttpClientResponse, HttpError>.Ok(HttpClientResponse(200, ArrayList<HttpHeader>(), HttpMemoryContent(default(ReadOnlyMemory<byte>)))))
    }
}

func Main(arguments: string[]) {
    use client = HttpClient(ImmediateHandler())
    let mode = arguments[0]
    if mode == "zero" {
        client.Timeout = Some(Duration.FromTicks(0L))
    } else if mode == "negative" {
        client.Timeout = Some(Duration.FromTicks(-1L))
    } else if mode == "excessive" {
        client.Timeout = Some(Duration.FromTicks(21474836470001L))
    } else if mode == "started" {
        _ = client.Get("http://example.test/")
        client.Timeout = Optional<Duration>.None()
    } else if mode == "disposed" {
        client.Dispose()
        client.Timeout = Optional<Duration>.None()
    } else if mode == "cancelled-send" {
        use source = CancellationTokenSource()
        source.Cancel()
        _ = client.Get("http://example.test/", source.Token)
        client.Timeout = Optional<Duration>.None()
    }
    Console.WriteLine("ERROR invalid HTTP timeout change returned")
}
