module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedHttpTimeoutTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main(arguments: string[]) -> Task<int> {
    let suite = TestSuite()
    // Keep the separate long-request invocation and the original case order.
    if arguments.Length > 0 {
        let completed = CompletedHttpTimeoutTest(await `Default timeout permits requests beyond fifteen seconds`())
        suite.Add("http-timeout-long", "Default timeout permits requests beyond fifteen seconds", completed.Invoke)
    } else {
        let timeoutAndCleanup = CompletedHttpTimeoutTest(await `Timeout waits for handler acknowledgement`())
        suite.Add("http-timeout-timeoutAndCleanup", "Timeout waits for handler acknowledgement", timeoutAndCleanup.Invoke)
        let callerCancellation = CompletedHttpTimeoutTest(await `Caller cancellation remains cancellation`())
        suite.Add("http-timeout-callerCancellation", "Caller cancellation remains cancellation", callerCancellation.Invoke)
        let disposalCancellation = CompletedHttpTimeoutTest(await `Client disposal cancellation remains cancellation`())
        suite.Add("http-timeout-disposalCancellation", "Client disposal cancellation remains cancellation", disposalCancellation.Invoke)
        let callerAfterTimeout = CompletedHttpTimeoutTest(await `Caller cancellation after timeout remains cancellation`())
        suite.Add("http-timeout-callerAfterTimeout", "Caller cancellation after timeout remains cancellation", callerAfterTimeout.Invoke)
        let disabledAndCompleted = CompletedHttpTimeoutTest(await `Disabled timeout permits normal completion`())
        suite.Add("http-timeout-disabledAndCompleted", "Disabled timeout permits normal completion", disabledAndCompleted.Invoke)
        let completionWins = CompletedHttpTimeoutTest(await `Completed response removes pending timeout`())
        suite.Add("http-timeout-completionWins", "Completed response removes pending timeout", completionWins.Invoke)
        let independentRequests = CompletedHttpTimeoutTest(await `Concurrent requests own independent countdowns`())
        suite.Add("http-timeout-independentRequests", "Concurrent requests own independent countdowns", independentRequests.Invoke)
        let completedChurn = CompletedHttpTimeoutTest(await `Completed sends release timer capacity`())
        suite.Add("http-timeout-completedChurn", "Completed sends release timer capacity", completedChurn.Invoke)
        let normalResultAfterTimeout = CompletedHttpTimeoutTest(await `Normally completing handler retains its result after cancellation request`())
        suite.Add("http-timeout-normalResultAfterTimeout", "Normally completing handler retains its result after cancellation request", normalResultAfterTimeout.Invoke)
    }
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
