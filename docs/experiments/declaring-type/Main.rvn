import System.*
import System.Introspection.*

class Outer {
    class Inner { }
}

func Main() {
    match ((NominalTypeInfo)typeof(Outer.Inner)).DeclaringType {
        .Some(let owner) => {
            if !owner.Equals(typeof(Outer)) {
                Fail("Wrong declaring type")
            }
        }
        .None => Fail("Missing declaring type")
    }
    match ((NominalTypeInfo)typeof(Outer)).DeclaringType {
        .Some(_) => Fail("Unexpected declaring type")
        .None => { }
    }
    Console.WriteLine("PASS declaring type")
}
