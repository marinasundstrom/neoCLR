import System.*
import System.IO.*

public enum Color { Red = 1, Blue = 2 }
public enum Other { Red = 1 }

func Main() {
    if let .Some(parent) = typeof(Color).BaseType {
        if !parent.Equals(typeof(Enum)) { Panic("Enum base identity") }
    } else { Panic("Missing Enum base") }
    if !typeof(Color).IsSubclassOf(typeof(ValueType)) { Panic("Enum ValueType ancestry") }
    let boxed: Object = Color.Red
    if !(boxed is Enum) { Panic("Boxed enum ancestry") }
    if !(boxed is ValueType) { Panic("Boxed value ancestry") }
    if boxed is Other { Panic("Distinct enum identities collapsed") }
    if boxed is int { Panic("Enum box became integer") }
    let direct: Enum = Color.Blue
    let value: ValueType = Color.Red
    if direct is Color restored {
        if restored != Color.Blue { Panic("Enum payload changed") }
    } else { Panic("Enum unboxing failed") }
    if !(value is Color) { Panic("ValueType lost enum identity") }
    let integer: Object = 1
    if integer is Enum { Panic("Integer is Enum") }
    Console.WriteLine("enum ancestry, boxed identity and copies agree")
}
