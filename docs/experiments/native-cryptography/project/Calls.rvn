module neoCLR.Runtime

import System.Runtime.CompilerServices.*

// Test-owned private contracts until the managed cryptography facade lands.
[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoSha256(data: byte[], output: byte[]) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoHmacSha256(key: byte[], data: byte[], output: byte[]) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoHmacSha256Verify(key: byte[], data: byte[], tag: byte[]) -> bool;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoRandomFill(output: byte[]) -> int;
