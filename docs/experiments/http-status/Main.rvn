import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func Check(condition: bool) {
    if !condition {
        Panic("HTTP status contract failed")
    }
}

// Application-owned conversion preserves the HTTP cause; no global library conversion is imposed.
union AppError {
    case Http(reason: HttpError)
}

extension HttpErrorConversion for HttpError {
    static func implicit(error: HttpError) -> AppError {
        return AppError.Http(error)
    }
}

func FailedNumber() -> Result<int, HttpError> {
    return Failure(HttpError.UnsuccessfulStatus(HttpStatusCode.NotFound))
}

func ConvertedError() -> Result<int, AppError> {
    let value = FailedNumber()?
    return Ok(value)
}

func BoxedError() -> Result<int, Object> {
    let value = FailedNumber()?
    return Ok(value)
}

class StatusProbe {
    private var client: HttpClient = HttpClient()
    private var codes: int[] = [201, 204, 205, 304, 400, 404, 500, 599]
    private var index: int = 0
    private var failures: int = 0

    func Next() {
        if index == codes.Length {
            Invalid()
            return
        }
        let code = codes[index]
        let statusNumber = code
        let url = String.Concat("http://127.0.0.1:19091/", statusNumber.ToString())
        let pending = client.Get(url)
        pending.OnCompleted(() => {
            let Ok(response) = pending.GetResult() else {
                Panic("Final status was treated as transport failure")
                return
            }
            Check((int)response.StatusCode == code)
            Check(response.IsSuccessStatusCode == (code >= 200 && code <= 299))
            if code == 204 || code == 205 || code == 304 {
                Check(response.Content.Length == 0)
            } else {
                Check(response.Content.Length == 4)
            }
            Text(url, code)
        })
    }

    func Advance() {
        index += 1
        Next()
    }

    func AdvanceFailure() {
        failures += 1
        Invalid()
    }

    func Text(url: string, code: int) {
        let pending = client.GetString(url)
        pending.OnCompleted(() => {
            let result = pending.GetResult()
            if code >= 200 && code <= 299 {
                let Ok(text) = result else {
                    Panic("Successful text request failed")
                    return
                }
                Check(text == (if code == 204 || code == 205 { "" } else { "body" }))
            } else {
                let Failure(HttpError.UnsuccessfulStatus(actual)) = result else {
                    Panic("Non-success status cause lost")
                    return
                }
                Check((int)actual == code)
            }
            Console.WriteLine(code)
            Advance()
        })
    }

    func EofDelimited() {
        let pending = client.Get("http://127.0.0.1:19091/eof")
        pending.OnCompleted(() => {
            let Ok(response) = pending.GetResult() else {
                Panic("EOF-delimited response failed")
                return
            }
            Check((int)response.StatusCode == 201 && response.Content.Length == 4)
            Console.WriteLine("HTTP status and conversion checks passed")
        })
    }

    func Invalid() {
        if failures == 6 {
            EofDelimited()
            return
        }
        let failureNumber = failures
        let pending = client.Get(String.Concat("http://127.0.0.1:19091/invalid-", failureNumber.ToString()))
        pending.OnCompleted(() => {
            if failures == 2 {
                if let Failure(HttpError.Unsupported(_)) = pending.GetResult() {
                    Check(true)
                } else {
                    Panic("Informational response was accepted")
                }
            } else {
                if let Failure(HttpError.Protocol(_)) = pending.GetResult() {
                    Check(true)
                } else {
                    if let Failure(reason) = pending.GetResult() {
                        Panic("Malformed response returned " + reason.ToString())
                    }
                    Panic("Malformed response was accepted")
                }
            }
            AdvanceFailure()
        })
    }
}

func CheckNamedStatus() {
    let named = HttpStatusCode.NotFound
    Check((int)named == 404)
    Check(named.ToString() == "NotFound")
    let extension = (HttpStatusCode)599
    Check((int)extension == 599)
    Check(extension.ToString() == "599")
    let response = HttpResponse(named, ArrayList<HttpHeader>(), HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    let result: Result<HttpResponse, HttpError> = Ok(response)
    if let Ok(HttpResponse { StatusCode: HttpStatusCode.NotFound, Headers: headers }) = result {
        Check(headers.Count == 0)
    } else {
        Panic("Response property pattern failed")
    }
    let Ok(HttpResponse { StatusCode: HttpStatusCode.NotFound, Headers: boundHeaders }) = result else {
        Panic("Response property binding failed")
        return
    }
    Check(boundHeaders.Count == 0)
    if result is Ok(HttpResponse { StatusCode: HttpStatusCode.NotFound, Headers: let headers }) {
        Check(headers.Count == 0)
    } else {
        Panic("Response is-pattern capture failed")
    }
}

func Main() {
    CheckNamedStatus()
    let Failure(appError) = ConvertedError() else {
        Panic("Extension conversion did not return an error")
        return
    }
    let AppError.Http(reason) = appError else {
        Panic("Extension conversion did not wrap HTTP error")
        return
    }
    if let HttpError.UnsuccessfulStatus(code) = reason {
        Check(code == HttpStatusCode.NotFound)
    } else {
        Panic("Extension conversion did not preserve status")
    }
    if let Failure(boxed) = BoxedError() {
        Check(boxed.ToString() == "HTTP status 404")
    } else {
        Panic("Object error conversion failed")
    }
    StatusProbe().Next()
}
