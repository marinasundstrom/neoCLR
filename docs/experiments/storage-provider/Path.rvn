namespace StorageExperiment

import System.*
import System.Result.*
import System.Storage.Path


func RequirePath(text: string) -> Path {
    return match Path.Parse(text) {
        Ok(let path) => path
        Error(_) => {
            System.Fault("Invalid sample path")
            // Fault does not yet have compiler-visible non-returning semantics.
            RequirePath("/")
        }
    }
}
