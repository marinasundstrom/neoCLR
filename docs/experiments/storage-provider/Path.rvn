namespace StorageExperiment

import System.*
import System.Result.*

struct InvalidPathError { }

// Immutable value object with lexical equality. Kept application-owned while the
// logical grammar is evaluated; it is not the host-native System.Storage.Path API.
class Path {
    private field text: string

    private init(text: string) {
        self.text = text
    }

    val Text: string => text
    val IsAbsolute: bool => text.StartsWithOrdinal("/")
    val IsRelative: bool => !IsAbsolute

    static func Parse(text: string) -> Result<Path, InvalidPathError> {
        if text.IsEmpty || text.ContainsOrdinal("\u0000") {
            return Error(InvalidPathError())
        }
        // This first logical grammar deliberately excludes native drive/UNC syntax.
        if text.ContainsOrdinal("\\") || text.ContainsOrdinal(":") {
            return Error(InvalidPathError())
        }
        if text == "." || text == "/" {
            return Ok(Path(text))
        }
        if text.ContainsOrdinal("//") || text.EndsWithOrdinal("/") {
            return Error(InvalidPathError())
        }
        if text == ".." || text.StartsWithOrdinal("./") || text.StartsWithOrdinal("../") {
            return Error(InvalidPathError())
        }
        if text.ContainsOrdinal("/./") || text.ContainsOrdinal("/../") {
            return Error(InvalidPathError())
        }
        if text.EndsWithOrdinal("/.") || text.EndsWithOrdinal("/..") {
            return Error(InvalidPathError())
        }
        return Ok(Path(text))
    }

    func Equals(other: Path) -> bool {
        return text.Equals(other.Text)
    }

    func ToString() -> string {
        return text
    }
}


func RequirePath(text: string) -> Path {
    return match Path.Parse(text) {
        Ok(let path) => path
        Error(_) => {
            System.Fault("Invalid sample path")
            // Fault does not yet have compiler-visible non-returning semantics.
            RequirePath("/")
        }
    }
}
