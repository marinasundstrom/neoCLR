namespace StorageExperiment

import System.Storage.File
import System.Storage.Directory

import System.*
import System.Console.*
import System.Result.*
import System.Storage.StorageLookupError

func CheckResolved(result: Result<File, StorageLookupError>, expected: string, content: string) {
    match result {
        Ok(let file) => {
            if file.Path.Text != expected || file.Name != "note.txt" {
                System.Fail("Directory lookup changed the address")
            }
            match ReadFileText(file) {
                Ok(let text) => {
                    if text != content {
                        System.Fail("Directory lookup used the wrong context")
                    }
                }
                Error(let error) => System.Fail(error.ToString())
            }
        }
        Error(let error) => System.Fail(error.ToString())
    }
}

func DirectoryCases(provider: StorageProvider, content: string) {
    let target = RequirePath("/context/nested/note.txt")
    match provider.WriteText(target, content, 32) {
        Ok(_) => { }
        Error(let error) => System.Fail(error.ToString())
    }
    let context = ProviderDirectory(provider, RequirePath("/context"))
    CheckResolved(context.GetFile(RequirePath("nested/note.txt")), target.Text, content)
    let root = RequireDirectory(provider, RequirePath("/"))
    CheckResolved(root.GetFile(RequirePath("context/nested/note.txt")), target.Text, content)
    let relative = ProviderDirectory(provider, RequirePath("context"))
    CheckResolved(relative.GetFile(RequirePath("nested/note.txt")), "context/nested/note.txt", content)
    let current = RequireDirectory(provider, RequirePath("."))
    CheckResolved(current.GetFile(RequirePath("context/nested/note.txt")), "context/nested/note.txt", content)
    // Absolute syntax is valid for a provider, but rejected by a directory context.
    CheckResolved(provider.GetFile(target), target.Text, content)
    match context.GetFile(target) {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.InvalidPath) {
                System.Fail("Absolute path has wrong context error")
            }
        }
        Ok(_) => System.Fail("Absolute path replaced directory context")
    }
    // The string overload still accepts one child name, not a relative path.
    match context.GetFile("nested/note.txt") {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.InvalidPath) {
                System.Fail("Nested string has wrong error")
            }
        }
        Ok(_) => System.Fail("Direct-child overload accepted a nested string")
    }
    match context.GetFile(RequirePath("absent.txt")) {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.NotFound) {
                System.Fail("Missing relative lookup changed error")
            }
        }
        Ok(_) => System.Fail("Missing relative lookup succeeded")
    }
    match root.GetFile(RequirePath(".")) {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.WrongKind) {
                System.Fail("Current directory treated as file")
            }
        }
        Ok(_) => System.Fail("Current directory returned as file")
    }
}

func DirectoryLookupCases(provider: StorageProvider) {
    let root = RequireDirectory(provider, RequirePath("/"))
    let current = RequireDirectory(provider, RequirePath("."))
    if root.Path.Text != "/" || current.Path.Text != "." {
        System.Fail("Directory lookup changed logical spelling")
    }
    let item: System.Storage.StorageItem = root
    if item.Path.Text != "/" {
        System.Fail("Directory lost StorageItem contract")
    }
    match provider.GetDirectory(RequirePath("context/nested/note.txt")) {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.WrongKind) {
                System.Fail("File lookup as directory changed error")
            }
        }
        Ok(_) => System.Fail("File returned as directory")
    }
    match provider.GetDirectory(RequirePath("absent-directory")) {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.NotFound) {
                System.Fail("Missing directory changed error")
            }
        }
        Ok(_) => System.Fail("Missing directory returned")
    }
}

func Main() {
    let disk: StorageProvider = HostStorage(".")
    let memory: StorageProvider = MemoryStorage()
    DirectoryCases(disk, "lookup contents")
    DirectoryCases(memory, "lookup contents")
    DirectoryLookupCases(disk)
    DirectoryLookupCases(memory)
    let nested = RequireDirectory(disk, RequirePath("context/nested"))
    CheckResolved(nested.GetFile("note.txt"), "context/nested/note.txt", "lookup contents")
    // Memory keys do not imply directories; that is a provider policy.
    match memory.GetDirectory(RequirePath("context/nested")) {
        Error(let error) => {
            if !(error is System.Storage.StorageLookupError.NotFound) {
                System.Fail("Flat memory provider changed directory policy")
            }
        }
        Ok(_) => System.Fail("Memory lookup invented a directory")
    }
    WriteLine("Relative directory lookup contracts: passed")
}
