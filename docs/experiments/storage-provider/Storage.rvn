namespace StorageExperiment

import System.*
import System.Storage.Path
import System.Collections.*
import System.Streams.*
import System.Text.*
import System.Result.*
import System.Storage.FileReadError
import System.Storage.FileWriteError
import System.Storage.StorageLookupError

// Experimental application-owned contract. Text methods are a temporary adapter
// over existing helpers; byte streams are a separate incremental experiment.
interface StorageProvider {
    func GetFile(path: Path) -> Result<File, StorageLookupError>
    func OpenRead(path: Path) -> Result<InputStream, StreamError>
    func CreateNew(path: Path) -> Result<OutputStream, StreamError>
    func ReadText(path: Path, maxBytes: int) -> Result<string, FileReadError>
    func WriteText(path: Path, text: string, maxBytes: int) -> Result<unit, FileWriteError>
}

class File {
    private field provider: StorageProvider
    private field path: Path
    private field name: string

    init(provider: StorageProvider, path: Path) {
        self.provider = provider
        self.path = path
        self.name = System.Storage.Path.GetFileName(path.Text)
    }

    val Path: Path => path
    val Name: string => name

    func OpenRead() -> Result<InputStream, StreamError> {
        return provider.OpenRead(path)
    }

    func CreateNew() -> Result<OutputStream, StreamError> {
        return provider.CreateNew(path)
    }

    func ReadText(maxBytes: int) -> Result<string, FileReadError> {
        return provider.ReadText(path, maxBytes)
    }

    func WriteText(text: string, maxBytes: int) -> Result<unit, FileWriteError> {
        return provider.WriteText(path, text, maxBytes)
    }
}

class Directory {
    private field provider: StorageProvider
    private field path: Path

    init(provider: StorageProvider, path: Path) {
        self.provider = provider
        self.path = path
    }

    val Path: Path => path

    // This resolves a direct child address; it does not query existence.
    func FileAt(name: string) -> Result<File, FileReadError> {
        if name.IsEmpty || name == "." || name == ".." || name.ContainsOrdinal("/") {
            return Error(FileReadError(FileReadError.InvalidPath()))
        }
        var childText = path.Text + "/" + name
        if path.Text == "." {
            childText = name
        }
        if path.Text == "/" {
            childText = "/" + name
        }
        return match System.Storage.Path.Parse(childText) {
            Ok(let child) => Ok(File(provider, child))
            Error(_) => Error(FileReadError(FileReadError.InvalidPath()))
        }
    }

    // Validate a direct child, then query its provider. The result owns no stream.
    func GetFile(name: string) -> Result<File, StorageLookupError> {
        return match FileAt(name) {
            Ok(let descriptor) => provider.GetFile(descriptor.Path)
            Error(_) => Error(StorageLookupError(StorageLookupError.InvalidPath()))
        }
    }

    // A parsed absolute path is valid syntax, but cannot replace this context.
    func GetFile(relativePath: Path) -> Result<File, StorageLookupError> {
        if relativePath.IsAbsolute {
            return Error(StorageLookupError(StorageLookupError.InvalidPath()))
        }
        if relativePath.Text == "." {
            return provider.GetFile(path)
        }
        var resolved = path.Text + "/" + relativePath.Text
        if path.Text == "/" {
            resolved = "/" + relativePath.Text
        }
        if path.Text == "." {
            resolved = relativePath.Text
        }
        return match System.Storage.Path.Parse(resolved) {
            Ok(let child) => provider.GetFile(child)
            Error(_) => Error(StorageLookupError(StorageLookupError.InvalidPath()))
        }
    }

}

class HostStorage : StorageProvider {
    private field root: string

    init(root: string) {
        self.root = root
    }

    // Both absolute logical paths and relative paths resolve beneath this root.
    // This is address mapping, not a symlink-safe sandbox.
    private func Resolve(path: Path) -> string {
        let text = path.Text
        if text == "/" || text == "." {
            return root
        }
        if path.IsAbsolute {
            match text.SliceUtf8(1, text.GetUtf8ByteCount() - 1) {
                Ok(let relative) => return System.Storage.Path.Combine(root, relative)
                Error(_) => System.Fault("Invalid parsed path boundary")
            }
        }
        return System.Storage.Path.Combine(root, text)
    }

    func GetFile(path: Path) -> Result<File, StorageLookupError> {
        return match System.Storage.Metadata.GetKind(Resolve(path)) {
            Ok(let kind) => {
                if kind.IsFile {
                    return Ok(File(self, path))
                }
                Error(StorageLookupError(StorageLookupError.WrongKind()))
            }
            Error(let error) => Error(error)
        }
    }

    func OpenRead(path: Path) -> Result<InputStream, StreamError> {
        return match FileInputStream.Open(Resolve(path)) {
            Ok(let stream) => {
                let input: InputStream = stream
                Ok(input)
            }
            Error(let error) => Error(error)
        }
    }

    func CreateNew(path: Path) -> Result<OutputStream, StreamError> {
        return match FileOutputStream.CreateNew(Resolve(path)) {
            Ok(let stream) => {
                let output: OutputStream = stream
                Ok(output)
            }
            Error(let error) => Error(error)
        }
    }

    func ReadText(path: Path, maxBytes: int) -> Result<string, FileReadError> {
        return System.Storage.File.ReadAllText(Resolve(path), maxBytes)
    }

    func WriteText(path: Path, text: string, maxBytes: int) -> Result<unit, FileWriteError> {
        return System.Storage.File.WriteAllText(Resolve(path), text, maxBytes)
    }
}

// Bounded application-owned provider: one byte payload per logical address.
class MemoryStorage : StorageProvider {
    private field keys: List<string> = ArrayList<string>()
    private field contents: List<List<byte>> = ArrayList<List<byte>>()

    private func Key(path: Path) -> string {
        if path.Text == "." {
            return "/"
        }
        if path.IsAbsolute {
            return path.Text
        }
        return "/" + path.Text
    }

    private func Find(path: Path) -> int {
        let key = Key(path)
        var index = 0
        while index < keys.Count {
            if keys[index] == key {
                return index
            }
            index += 1
        }
        return -1
    }

    func GetFile(path: Path) -> Result<File, StorageLookupError> {
        if Key(path) == "/" {
            return Error(StorageLookupError(StorageLookupError.WrongKind()))
        }
        if Find(path) < 0 {
            return Error(StorageLookupError(StorageLookupError.NotFound()))
        }
        return Ok(File(self, path))
    }

    func OpenRead(path: Path) -> Result<InputStream, StreamError> {
        if Key(path) == "/" {
            return Error(StreamError(StreamError.WrongKind()))
        }
        let index = Find(path)
        if index < 0 {
            return Error(StreamError(StreamError.NotFound()))
        }
        let stream: InputStream = MemoryInput(contents[index])
        return Ok(stream)
    }

    func CreateNew(path: Path) -> Result<OutputStream, StreamError> {
        if Key(path) == "/" {
            return Error(StreamError(StreamError.WrongKind()))
        }
        if Find(path) >= 0 {
            return Error(StreamError(StreamError.AlreadyExists()))
        }
        if keys.Count >= 8 {
            return Error(StreamError(StreamError.LimitExceeded()))
        }
        let bytes: List<byte> = ArrayList<byte>()
        keys.Add(Key(path))
        contents.Add(bytes)
        let stream: OutputStream = MemoryOutput(bytes)
        return Ok(stream)
    }

    func ReadText(path: Path, maxBytes: int) -> Result<string, FileReadError> {
        if maxBytes < 0 {
            return Error(FileReadError(FileReadError.InvalidLimit()))
        }
        if Key(path) == "/" {
            return Error(FileReadError(FileReadError.NotRegularFile()))
        }
        let index = Find(path)
        if index < 0 {
            return Error(FileReadError(FileReadError.NotFound()))
        }
        let bytes = contents[index]
        if bytes.Count > maxBytes {
            return Error(FileReadError(FileReadError.TooLarge()))
        }
        return match Utf8.Decode(bytes) {
            Ok(let text) => Ok(text)
            Error(_) => Error(FileReadError(FileReadError.InvalidUtf8()))
        }
    }

    func WriteText(path: Path, text: string, maxBytes: int) -> Result<unit, FileWriteError> {
        if maxBytes < 0 {
            return Error(FileWriteError(FileWriteError.InvalidLimit()))
        }
        if Key(path) == "/" {
            return Error(FileWriteError(FileWriteError.NotRegularFile()))
        }
        let count = text.GetUtf8ByteCount()
        if count > maxBytes || count > 65536 {
            return Error(FileWriteError(FileWriteError.TooLarge()))
        }
        let index = Find(path)
        if index < 0 && keys.Count >= 8 {
            // The temporary whole-text error family has no capacity case.
            return Error(FileWriteError(FileWriteError.WriteFailed()))
        }
        let encoded = Utf8.Encode(text)
        let bytes: List<byte> = ArrayList<byte>()
        var position = 0
        while position < encoded.Count {
            bytes.Add(encoded[position])
            position += 1
        }
        // Publish only after validation/encoding. Existing streams retain old bytes.
        if index < 0 {
            keys.Add(Key(path))
            contents.Add(bytes)
        } else {
            contents[index] = bytes
        }
        return Ok(())
    }
}
