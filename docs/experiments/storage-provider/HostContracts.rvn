namespace StorageExperiment

import System.*
import System.Result.*
import System.Storage.File
import System.Storage.Directory
import System.Storage.StorageItem
import System.Storage.StorageLookupError

func Main() {
    let provider: System.Storage.StorageProvider = System.Storage.FileSystem("listing")
    let root = RequireDirectory(provider, RequirePath("/"))
    match root.GetItems(2) {
        Ok(let items) => {
            if items.Count != 2 || items[0].Name != "a-dir" || items[1].Name != "z.txt" {
                Panic("Mixed snapshot changed names or order")
            }
            if !(items[0] is Directory) || !(items[1] is File) {
                Panic("Mixed snapshot lost its interface branches")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match root.GetItems(1) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.LimitExceeded) {
                Panic("Over-bound listing changed error")
            }
        }
        Ok(_) => Panic("Listing silently truncated")
    }
    match root.GetItems(-1) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.InvalidRange) {
                Panic("Invalid listing bound changed error")
            }
        }
        Ok(_) => Panic("Negative listing bound accepted")
    }
    match root.GetDirectory("a-dir") {
        Ok(let child) => {
            match child.GetItems(0) {
                Ok(let items) => {
                    if items.Count != 0 {
                        Panic("Empty directory contains items")
                    }
                }
                Failure(let error) => Panic(error.ToString())
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match root.GetDirectory(RequirePath("a-dir")) {
        Ok(let child) => {
            if child.Path.Text != "/a-dir" {
                Panic("Relative directory traversal changed path")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match root.GetItem(RequirePath("z.txt")) {
        Ok(let item) => {
            if !(item is File) || item.Path.Text != "/z.txt" {
                Panic("Relative generic lookup changed item")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match root.GetDirectory(RequirePath("/a-dir")) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.InvalidPath) {
                Panic("Absolute child lookup changed error")
            }
        }
        Ok(_) => Panic("Absolute child replaced context")
    }
    System.Console.WriteLine("Integrated host provider and mixed enumeration: passed")
}
