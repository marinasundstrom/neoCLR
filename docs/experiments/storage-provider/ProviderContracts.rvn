namespace StorageExperiment

import System.*
import System.Result.*
import System.Storage.Path
import System.Storage.File
import System.Storage.Directory
import System.Storage.StorageItem
import System.IO.*

// Byte routing is a sample implementation detail, not a platform provider contract.
class UnavailableStorage : ByteStorage {
    private field calls: int
    val Calls: int => calls

    func OpenRead(path: Path) -> Result<InputStream, StreamError> {
        calls += 1
        return Error<StreamError>(StreamError.NotFound)
    }

    func CreateNew(path: Path) -> Result<OutputStream, StreamError> {
        calls += 1
        return Error<StreamError>(StreamError.AccessDenied)
    }
}

func Main() {
    let concrete = UnavailableStorage()
    let provider: ByteStorage = concrete
    let path = RequirePath("item.txt")
    let file = ProviderFile(provider, path)
    if file.Name != "item.txt" || !file.Path.Equals(path) || concrete.Calls != 0 {
        System.Fault("Descriptor construction or properties performed I/O")
    }
    match file.OpenRead() {
        Error(let error) => {
            if !(error is System.IO.StreamError.NotFound) {
                System.Fault("Provider read error changed")
            }
        }
        Ok(let stream) => {
            stream.Close()
            System.Fault("Unavailable provider opened a stream")
        }
    }
    match file.CreateNew() {
        Error(let error) => {
            if !(error is System.IO.StreamError.AccessDenied) {
                System.Fault("Provider creation error changed")
            }
        }
        Ok(let stream) => {
            stream.Close()
            System.Fault("Unavailable provider created a stream")
        }
    }
    if concrete.Calls != 2 {
        System.Fault("Descriptor did not delegate byte operations")
    }
    let item: StorageItem = file
    if item.Name != "item.txt" || !item.Path.Equals(path) {
        System.Fault("StorageItem lost provider properties")
    }
    let folder: Directory = ProviderDirectory(MemoryStorage(), RequirePath("/folder"))
    let items: StorageItem[] = [file, folder]
    if items[0].Name != "item.txt" || items[1].Name != "folder" {
        System.Fault("Mixed storage items lost their properties")
    }
    System.Console.WriteLine("Minimal platform provider contract: passed")
}
