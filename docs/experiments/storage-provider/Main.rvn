namespace StorageExperiment

import System.Storage.File
import System.Storage.Directory

import System.*
import System.Console.*
import System.Result.*
import System.Text.*

// This workflow receives a directory; it does not select the storage provider.
func RoundTrip(directory: Directory, provider: StorageProvider) {
    match directory.FileAt("notes.txt") {
        Ok(let file) => {
            WriteLine(file.Name)
            match provider.WriteText(file.Path, "Hello, värld!", 14) {
                Ok(_) => WriteLine("Written")
                Error(let error) => System.Fault(error.ToString())
            }
            match provider.ReadText(file.Path, 14) {
                Ok(let text) => WriteLine(text)
                Error(let error) => System.Fault(error.ToString())
            }
            match provider.WriteText(file.Path, "too large", 2) {
                Error(let error) => {
                    if !error.IsTooLarge {
                        System.Fault("Wrong bounded-write error")
                    }
                }
                Ok(_) => System.Fault("Oversized write succeeded")
            }
            match provider.ReadText(file.Path, 14) {
                Ok(let text) => {
                    if text != "Hello, värld!" {
                        System.Fault("Rejected write changed contents")
                    }
                }
                Error(let error) => System.Fault(error.ToString())
            }
            match provider.ReadText(file.Path, 13) {
                Error(let error) => {
                    if !error.IsTooLarge {
                        System.Fault("Wrong UTF-8 byte-limit error")
                    }
                }
                Ok(_) => System.Fault("Byte limit counted characters")
            }
            match file.OpenRead() {
                Ok(let input) => {
                    let result = ReadMessage(input)
                    input.Close()
                    match result {
                        Ok(let bytes) => {
                            match Utf8.Decode(bytes) {
                                Ok(let text) => {
                                    if text != "Hello, värld!" {
                                        System.Fault("Text and byte reads disagree")
                                    }
                                }
                                Error(_) => System.Fault("Written text was not valid UTF-8")
                            }
                        }
                        Error(let error) => System.Fault(error.ToString())
                    }
                }
                Error(let error) => System.Fault(error.ToString())
            }
            WriteLine("Text write visible through byte stream")
            WriteLine("Rejected write preserved contents")
        }
        Error(let error) => System.Fault(error.ToString())
    }
}

func RejectChild(directory: Directory, name: string) {
    match directory.FileAt(name) {
        Error(let error) => {
            if !error.IsInvalidPath {
                System.Fault("Wrong child-name error")
            }
        }
        Ok(_) => System.Fault("Invalid child name accepted")
    }
}

func Main() {
    let host: StorageProvider = HostStorage("sandbox")
    let memory: StorageProvider = MemoryStorage()
    // Parsing does not open storage. The same logical root works for both providers.
    let root = RequirePath("/")
    let disk = Directory(host, root)
    let temporary = Directory(memory, root)
    WriteLine("Disk")
    RoundTrip(disk, host)
    ByteRoundTrip(disk, host)
    WriteLine("Memory")
    RoundTrip(temporary, memory)
    ByteRoundTrip(temporary, memory)
    for directory in [disk, temporary] {
        match directory.GetFile("notes.txt") {
            Ok(let file) => {
                if file.Name != "notes.txt" {
                    System.Fault("Lookup lost the child name")
                }
                match ReadFileText(file) {
                    Ok(let text) => {
                        if text != "Hello, värld!" {
                            System.Fault("Lookup changed provider ownership")
                        }
                    }
                    Error(let error) => System.Fault(error.ToString())
                }
            }
            Error(let error) => System.Fault(error.ToString())
        }
    }
    WriteLine("File lookup reads the same contents on disk and memory")
    match temporary.FileAt("notes.txt") {
        Ok(let file) => {
            if !file.Path.Equals(RequirePath("/notes.txt")) {
                System.Fault("Directory replaced the provider address")
            }
            match ReadFileText(file) {
                Ok(let text) => {
                    if text != "Hello, värld!" {
                        System.Fault("A new descriptor lost provider state")
                    }
                }
                Error(let error) => System.Fault(error.ToString())
            }
        }
        Error(let error) => System.Fault(error.ToString())
    }
    RejectChild(disk, "../outside.txt")
    RejectChild(disk, "")
    RejectChild(disk, ".")
    RejectChild(disk, "..")
    RejectChild(disk, "child/name")
    RejectChild(disk, "child\\name")
    RejectChild(disk, "child\u0000name")
    WriteLine("Direct child required")
    let otherMemory: StorageProvider = MemoryStorage()
    let other = File(otherMemory, RequirePath("/notes.txt"))
    match otherMemory.ReadText(other.Path, 64) {
        Error(let error) => {
            if !error.IsNotFound {
                System.Fault("Wrong missing-file error")
            }
            WriteLine("Providers remain independent")
        }
        Ok(_) => System.Fault("Provider state leaked")
    }
}
