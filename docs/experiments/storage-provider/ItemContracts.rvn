namespace StorageExperiment

import System.*
import System.Result.*
import System.Storage.File
import System.Storage.Directory
import System.Storage.StorageItem
import System.Storage.StorageLookupError
import System.Storage.Path

// A platform provider resolves items; byte methods and text helpers are not required.
class MissingProvider : System.Storage.StorageProvider {
    func GetItem(path: Path) -> Result<StorageItem, StorageLookupError> {
        return Failure<StorageLookupError>(StorageLookupError.NotFound)
    }
    func GetFile(path: Path) -> Result<File, StorageLookupError> {
        return Failure<StorageLookupError>(StorageLookupError.NotFound)
    }
    func GetDirectory(path: Path) -> Result<Directory, StorageLookupError> {
        return Failure<StorageLookupError>(StorageLookupError.NotFound)
    }
}

func CheckItems(provider: System.Storage.StorageProvider) {
    match provider.GetItem(RequirePath("/lookup.txt")) {
        Ok(let item) => {
            if item.Name != "lookup.txt" || item.Path.Text != "/lookup.txt" {
                Panic("Generic file lookup lost its address")
            }
            if !(item is File) || item is Directory {
                Panic("Generic lookup returned the wrong branch")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match provider.GetItem(RequirePath("/")) {
        Ok(let item) => {
            if item.Path.Text != "/" || !(item is Directory) || item is File {
                Panic("Generic root lookup lost its directory branch")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match provider.GetItem(RequirePath("/missing-item")) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.NotFound) {
                Panic("Missing generic item changed error")
            }
        }
        Ok(_) => Panic("Generic lookup created an item")
    }
}

func Main() {
    let memory = MemoryStorage()
    match memory.WriteText(RequirePath("/lookup.txt"), "found", 5) {
        Ok(_) => { }
        Failure(let error) => Panic(error.ToString())
    }
    CheckItems(memory)
    // The preceding file-lookup fixture writes this native file.
    CheckItems(HostStorage("."))
    let missing: System.Storage.StorageProvider = MissingProvider()
    match missing.GetItem(RequirePath("anything")) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.NotFound) {
                Panic("Resolution-only provider changed error")
            }
        }
        Ok(_) => Panic("Resolution-only provider invented an item")
    }
    System.Console.WriteLine("Provider item interfaces: passed")
}
