namespace StorageExperiment

import System.*
import System.Collections.*
import System.IO.*
import System.Result.*
import System.Text.*

func TextInput(text: string) -> MemoryInput {
    let bytes: List<byte> = ArrayList<byte>()
    for value in Utf8.Encode(text) {
        bytes.Add(value)
    }
    return MemoryInput(bytes)
}

func ExpectText(reader: TextReader, limit: int, expected: string) {
    match reader.ReadToEnd(limit) {
        Ok(let text) => {
            if text != expected {
                Panic("Decoded text changed")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
}

func ExpectPosition(stream: SeekableStream, expected: long) {
    match stream.GetPosition() {
        Ok(let position) => {
            if position != expected {
                Panic("Stream position changed")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
}

func ReaderAndSeek(input: InputStream, seek: SeekableStream) {
    ExpectPosition(seek, 0)
    match seek.Seek(-1) {
        Failure(let error) => {
            if !(error is System.IO.StreamError.InvalidRange) {
                Panic("Invalid seek changed error")
            }
        }
        Ok(_) => Panic("Negative seek accepted")
    }
    ExpectPosition(seek, 0)
    match seek.Seek(99) {
        Ok(_) => { }
        Failure(let error) => Panic(error.ToString())
    }
    let probe: byte[] = [(byte)0]
    match input.Read(probe, 0, 1) {
        Ok(let count) => {
            if count != 0 {
                Panic("Read beyond EOF returned data")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    match seek.Seek(0) {
        Ok(_) => { }
        Failure(let error) => Panic(error.ToString())
    }
    let reader: TextReader = StreamReader(input, true)
    ExpectText(reader, 14, "Hello, värld!")
    ExpectText(reader, 0, "")
    ExpectPosition(seek, 14)
    reader.Close()
    match seek.Seek(0) {
        Ok(_) => { }
        Failure(let error) => Panic(error.ToString())
    }
    let owner: TextReader = StreamReader(input)
    match owner.ReadToEnd(13) {
        Failure(let error) => {
            if !(error is System.IO.TextReadError.LimitExceeded) {
                Panic("Text bound changed error")
            }
        }
        Ok(_) => Panic("Oversized text accepted")
    }
    ExpectPosition(seek, 14)
    owner.Close()
    owner.Close()
    match seek.GetPosition() {
        Failure(let error) => {
            if !(error is System.IO.StreamError.Closed) {
                Panic("Reader failed to close owned input")
            }
        }
        Ok(_) => Panic("Owned stream remained open")
    }
    match owner.ReadToEnd(-1) {
        Failure(let error) => {
            if !(error is System.IO.TextReadError.Closed) {
                Panic("Closed reader changed precedence")
            }
        }
        Ok(_) => Panic("Closed reader read text")
    }
}

class FailingInput : InputStream {
    private field calls: int = 0
    val Calls: int => calls
    func Read(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        calls += 1
        return Failure<StreamError>(StreamError.AccessDenied)
    }
    func Close() { }
}

func Main() {
    let memory = TextInput("Hello, värld!")
    ReaderAndSeek(memory, memory)
    match FileInputStream.Open("reader.txt") {
        Ok(let disk) => ReaderAndSeek(disk, disk)
        Failure(let error) => Panic(error.ToString())
    }
    let invalid: List<byte> = ArrayList<byte>()
    invalid.Add((byte)195)
    let bad = StreamReader(MemoryInput(invalid))
    match bad.ReadToEnd(1) {
        Failure(let error) => {
            if !(error is System.IO.TextReadError.InvalidUtf8) {
                Panic("Malformed UTF-8 changed error")
            }
        }
        Ok(_) => Panic("Malformed UTF-8 accepted")
    }
    bad.Close()
    let bom = StreamReader(TextInput("\uFEFFx"))
    ExpectText(bom, 4, "\uFEFFx")
    bom.Close()
    let empty = StreamReader(TextInput(""))
    ExpectText(empty, 0, "")
    empty.Close()
    let failing = FailingInput()
    let errors = StreamReader(failing)
    match errors.ReadToEnd(-1) {
        Failure(let error) => {
            if !(error is System.IO.TextReadError.InvalidRange) || failing.Calls != 0 {
                Panic("Invalid limit consumed input")
            }
        }
        Ok(_) => Panic("Negative text limit accepted")
    }
    match errors.ReadToEnd(8) {
        Failure(let error) => {
            if !(error is System.IO.TextReadError.AccessDenied) {
                Panic("Stream failure distinction lost")
            }
        }
        Ok(_) => Panic("Failed input succeeded")
    }
    errors.Close()
    System.Console.WriteLine("Text readers and seekability: passed")
}
