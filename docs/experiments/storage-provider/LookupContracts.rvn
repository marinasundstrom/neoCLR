namespace StorageExperiment

import System.Storage.File
import System.Storage.Directory

import System.*
import System.Console.*
import System.Result.*
import System.IO.*

func LookupCases(provider: StorageProvider) {
    match provider.GetFile(RequirePath("/missing")) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.NotFound) {
                Panic("Missing lookup did not return NotFound")
            }
        }
        Ok(_) => Panic("Lookup created a missing file")
    }
    match provider.GetFile(RequirePath("/")) {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.WrongKind) {
                Panic("Directory lookup did not return WrongKind")
            }
        }
        Ok(_) => Panic("Directory returned as file")
    }
    let directory = ProviderDirectory(provider, RequirePath("/"))
    match directory.GetFile("../escape") {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.InvalidPath) {
                Panic("Invalid child has wrong lookup error")
            }
        }
        Ok(_) => Panic("Lookup bypassed child validation")
    }
    match provider.WriteText(RequirePath("/lookup.txt"), "found", 5) {
        Ok(_) => { }
        Failure(let error) => Panic(error.ToString())
    }
    // Repeat lookup to check stable descriptor construction.
    var index = 0
    while index < 3 {
        match directory.GetFile("lookup.txt") {
            Ok(let file) => {
                if file.Name != "lookup.txt" || !file.Path.Equals(RequirePath("/lookup.txt")) {
                    Panic("Lookup descriptor changed address")
                }
            }
            Failure(let error) => Panic(error.ToString())
        }
        index += 1
    }
}

func Main() {
    LookupCases(HostStorage("."))
    LookupCases(MemoryStorage())
    match System.Storage.Metadata.GetKind("") {
        Failure(let error) => {
            if !(error is System.Storage.StorageLookupError.InvalidPath) {
                Panic("Empty native path has wrong error")
            }
        }
        Ok(_) => Panic("Empty native path accepted")
    }
    match System.Storage.Metadata.GetKind(".") {
        Ok(let kind) => {
            if !(kind == System.Storage.EntryKind.Directory) {
                Panic("Directory metadata lost its kind")
            }
        }
        Failure(let error) => Panic(error.ToString())
    }
    WriteLine("Typed disk and memory lookup contracts: passed")
}
