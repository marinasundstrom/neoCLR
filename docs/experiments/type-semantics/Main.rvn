import System.*
import System.IO.*

public record ReferenceRecord(var Number: int)
public class Reference {
    var Number: int { get; set; } = 1
}
public struct ValueCell {
    init() { }
    var Number: int { get; set; } = 1
}
public record struct ValueRecord(var Number: int)
public record struct ImmutableRecord(val Number: int)
public class InitOnly {
    val Number: int { get; init; } = 1
}

func Main() {
    if let .Some(parent) = typeof(Reference).BaseType {
        if !parent.Equals(typeof(Object)) {
            Panic("Class has the wrong base")
        }
    } else {
        Panic("Class Object base is missing")
    }
    if let .Some(referenceParent) = typeof(ReferenceRecord).BaseType {
        if !referenceParent.Equals(typeof(Object)) {
            Panic("Reference record has the wrong base")
        }
    } else {
        Panic("Reference record Object base is missing")
    }
    if let .Some(valueParent) = typeof(ValueCell).BaseType {
        if !valueParent.Equals(typeof(ValueType)) {
            Panic("Struct has the wrong base")
        }
    } else {
        Panic("Struct ValueType base is missing")
    }
    if let .Some(recordParent) = typeof(ValueRecord).BaseType {
        if !recordParent.Equals(typeof(ValueType)) {
            Panic("Record struct has the wrong base")
        }
    } else {
        Panic("Record struct ValueType base is missing")
    }
    if let .Some(rootParent) = typeof(ValueType).BaseType {
        if !rootParent.Equals(typeof(Object)) {
            Panic("ValueType has the wrong base")
        }
    } else {
        Panic("ValueType Object base is missing")
    }
    let initialized = InitOnly { Number = 42 }
    if initialized.Number != 42 {
        Panic("Init accessor did not initialize class")
    }
    let immutable = ImmutableRecord(42)
    if immutable.Number != 42 {
        Panic("Positional init accessor did not initialize record")
    }
    let referenceRecord = ReferenceRecord(1)
    let recordAlias = referenceRecord
    recordAlias.Number = 2
    if referenceRecord.Number != 2 {
        Panic("Reference record did not alias")
    }
    if typeof(ReferenceRecord).IsValueType {
        Panic("Ordinary record is a value type")
    }
    let reference = Reference()
    let alias = reference
    alias.Number = 2
    if reference.Number != 2 {
        Panic("Class assignment did not alias")
    }
    var value = ValueCell()
    var copy = value
    copy.Number = 2
    if value.Number != 1 {
        Panic("Struct assignment did not copy")
    }
    var valueRecord = ValueRecord(1)
    var recordCopy = valueRecord
    recordCopy.Number = 2
    if valueRecord.Number != 1 {
        Panic("Record struct assignment did not copy")
    }
    let boxed: Object = valueRecord
    valueRecord.Number = 3
    if !(boxed is ValueType) {
        Panic("Boxed record is not a ValueType")
    }
    let typedValue: ValueType = ValueRecord(42)
    if typedValue is ValueRecord typedRecord {
        if typedRecord.Number != 42 {
            Panic("ValueType assignment changed the boxed value")
        }
    } else {
        Panic("ValueType assignment lost the record identity")
    }
    let classBox: Object = reference
    if classBox is ValueType {
        Panic("Ordinary class matched ValueType")
    }
    if !typeof(ValueRecord).IsSubclassOf(typeof(ValueType)) {
        Panic("Record subclass relation is missing")
    }
    if boxed is ValueRecord unboxed {
        if unboxed.Number != 1 {
            Panic("Box did not preserve independent value")
        }
    } else {
        Panic("Box did not retain value-record identity")
    }
    if typeof(Reference).IsValueType {
        Panic("Class is a value type")
    }
    if !typeof(ValueCell).IsValueType {
        Panic("Struct is a reference type")
    }
    if !typeof(ValueRecord).IsValueType {
        Panic("Record struct is a reference type")
    }
    Console.WriteLine("classes and records alias; structs copy; boxing isolates; init accessors initialize")
}
