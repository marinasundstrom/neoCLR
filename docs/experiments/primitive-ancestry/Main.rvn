    if let .Some(enumParent) = typeof(StringComparison).BaseType {
        if !enumParent.Equals(typeof(Enum)) {
            Fail("Core enum base identity")
        }
    } else {
        Fail("Missing core Enum base")
    }
    let coreEnum: Enum = StringComparison.Ordinal
    if !(coreEnum is StringComparison) {
        Fail("Core enum box identity")
    }
    let number: ValueType = 42
    let wide: ValueType = 42L
    let flag: ValueType = true
    if !number.GetType().Equals(typeof(int)) {
        Fail("Boxed Int32 runtime type")
    }
    if !wide.GetType().Equals(typeof(long)) {
        Fail("Boxed Int64 runtime type")
    }
    if !flag.GetType().Equals(typeof(bool)) {
        Fail("Boxed Boolean runtime type")
    }
    if !(number is int) {
        Fail("Int32 box identity")
    }
    if !(wide is long) {
        Fail("Int64 box identity")
    }
    if !(flag is bool) {
        Fail("Boolean box identity")
    }
    if number is Enum {
        Fail("Primitive became Enum")
    }
    let boxed: Object = 7
    if !(boxed is ValueType) {
        Fail("Object value ancestry")
    }
    let text: Object = "text"
    if text is ValueType {
        Fail("String became ValueType")
    }
    if number is int restored {
        if restored != 42 { Fail("Unboxing changed payload") }
    } else {
        Fail("Unboxing failed")
    }
    Console.WriteLine("primitive ancestry and boxed values agree")
