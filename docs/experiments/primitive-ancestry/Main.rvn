        if !parent3.Equals(typeof(ValueType)) {
            Fail("UInt16 base identity")
        }
    } else {
        Fail("Missing UInt16 base")
    }
    if !typeof(UInt16).IsSubclassOf(typeof(ValueType)) {
        Fail("UInt16 subclass ancestry")
    }
