import System.*
import System.IO.*

func Main() {
    if let .Some(parent0) = typeof(SByte).BaseType {
        if !parent0.Equals(typeof(ValueType)) {
            Panic("SByte base identity")
        }
    } else {
        Panic("Missing SByte base")
    }
    if !typeof(SByte).IsSubclassOf(typeof(ValueType)) {
        Panic("SByte subclass ancestry")
    }
    if let .Some(parent1) = typeof(Byte).BaseType {
        if !parent1.Equals(typeof(ValueType)) {
            Panic("Byte base identity")
        }
    } else {
        Panic("Missing Byte base")
    }
    if !typeof(Byte).IsSubclassOf(typeof(ValueType)) {
        Panic("Byte subclass ancestry")
    }
    if let .Some(parent2) = typeof(Int16).BaseType {
        if !parent2.Equals(typeof(ValueType)) {
            Panic("Int16 base identity")
        }
    } else {
        Panic("Missing Int16 base")
    }
    if !typeof(Int16).IsSubclassOf(typeof(ValueType)) {
        Panic("Int16 subclass ancestry")
    }
    if let .Some(parent3) = typeof(UInt16).BaseType {
        if !parent3.Equals(typeof(ValueType)) {
            Panic("UInt16 base identity")
        }
    } else {
        Panic("Missing UInt16 base")
    }
    if !typeof(UInt16).IsSubclassOf(typeof(ValueType)) {
        Panic("UInt16 subclass ancestry")
    }
    if let .Some(parent4) = typeof(Int32).BaseType {
        if !parent4.Equals(typeof(ValueType)) {
            Panic("Int32 base identity")
        }
    } else {
        Panic("Missing Int32 base")
    }
    if !typeof(Int32).IsSubclassOf(typeof(ValueType)) {
        Panic("Int32 subclass ancestry")
    }
    if let .Some(parent5) = typeof(UInt32).BaseType {
        if !parent5.Equals(typeof(ValueType)) {
            Panic("UInt32 base identity")
        }
    } else {
        Panic("Missing UInt32 base")
    }
    if !typeof(UInt32).IsSubclassOf(typeof(ValueType)) {
        Panic("UInt32 subclass ancestry")
    }
    if let .Some(parent6) = typeof(Int64).BaseType {
        if !parent6.Equals(typeof(ValueType)) {
            Panic("Int64 base identity")
        }
    } else {
        Panic("Missing Int64 base")
    }
    if !typeof(Int64).IsSubclassOf(typeof(ValueType)) {
        Panic("Int64 subclass ancestry")
    }
    if let .Some(parent7) = typeof(UInt64).BaseType {
        if !parent7.Equals(typeof(ValueType)) {
            Panic("UInt64 base identity")
        }
    } else {
        Panic("Missing UInt64 base")
    }
    if !typeof(UInt64).IsSubclassOf(typeof(ValueType)) {
        Panic("UInt64 subclass ancestry")
    }
    if let .Some(parent8) = typeof(IntPtr).BaseType {
        if !parent8.Equals(typeof(ValueType)) {
            Panic("IntPtr base identity")
        }
    } else {
        Panic("Missing IntPtr base")
    }
    if !typeof(IntPtr).IsSubclassOf(typeof(ValueType)) {
        Panic("IntPtr subclass ancestry")
    }
    if let .Some(parent9) = typeof(UIntPtr).BaseType {
        if !parent9.Equals(typeof(ValueType)) {
            Panic("UIntPtr base identity")
        }
    } else {
        Panic("Missing UIntPtr base")
    }
    if !typeof(UIntPtr).IsSubclassOf(typeof(ValueType)) {
        Panic("UIntPtr subclass ancestry")
    }
    if let .Some(parent10) = typeof(Single).BaseType {
        if !parent10.Equals(typeof(ValueType)) {
            Panic("Single base identity")
        }
    } else {
        Panic("Missing Single base")
    }
    if !typeof(Single).IsSubclassOf(typeof(ValueType)) {
        Panic("Single subclass ancestry")
    }
    if let .Some(parent11) = typeof(Double).BaseType {
        if !parent11.Equals(typeof(ValueType)) {
            Panic("Double base identity")
        }
    } else {
        Panic("Missing Double base")
    }
    if !typeof(Double).IsSubclassOf(typeof(ValueType)) {
        Panic("Double subclass ancestry")
    }
    if let .Some(parent12) = typeof(Boolean).BaseType {
        if !parent12.Equals(typeof(ValueType)) {
            Panic("Boolean base identity")
        }
    } else {
        Panic("Missing Boolean base")
    }
    if !typeof(Boolean).IsSubclassOf(typeof(ValueType)) {
        Panic("Boolean subclass ancestry")
    }
    if let .Some(parent13) = typeof(Char).BaseType {
        if !parent13.Equals(typeof(ValueType)) {
            Panic("Char base identity")
        }
    } else {
        Panic("Missing Char base")
    }
    if !typeof(Char).IsSubclassOf(typeof(ValueType)) {
        Panic("Char subclass ancestry")
    }
    if let .Some(parent14) = typeof(RuntimeTypeHandle).BaseType {
        if !parent14.Equals(typeof(ValueType)) {
            Panic("RuntimeTypeHandle base identity")
        }
    } else {
        Panic("Missing RuntimeTypeHandle base")
    }
    if !typeof(RuntimeTypeHandle).IsSubclassOf(typeof(ValueType)) {
        Panic("RuntimeTypeHandle subclass ancestry")
    }
    if let .Some(enumParent) = typeof(StringComparison).BaseType {
        if !enumParent.Equals(typeof(Enum)) {
            Panic("Core enum base identity")
        }
    } else {
        Panic("Missing core Enum base")
    }
    let coreEnum: Enum = StringComparison.Ordinal
    if !(coreEnum is StringComparison) {
        Panic("Core enum box identity")
    }
    let number: ValueType = 42
    let wide: ValueType = 42L
    let flag: ValueType = true
    if !number.GetType().Equals(typeof(int)) {
        Panic("Boxed Int32 runtime type")
    }
    if !wide.GetType().Equals(typeof(long)) {
        Panic("Boxed Int64 runtime type")
    }
    if !flag.GetType().Equals(typeof(bool)) {
        Panic("Boxed Boolean runtime type")
    }
    if !(number is int) {
        Panic("Int32 box identity")
    }
    if !(wide is long) {
        Panic("Int64 box identity")
    }
    if !(flag is bool) {
        Panic("Boolean box identity")
    }
    if number is Enum {
        Panic("Primitive became Enum")
    }
    let boxed: Object = 7
    if !(boxed is ValueType) {
        Panic("Object value ancestry")
    }
    let text: Object = "text"
    if text is ValueType {
        Panic("String became ValueType")
    }
    if number is int restored {
        if restored != 42 { Panic("Unboxing changed payload") }
    } else {
        Panic("Unboxing failed")
    }
    Console.WriteLine("primitive ancestry and boxed values agree")
}
