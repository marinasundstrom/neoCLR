import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
    let result: Result<HttpResponse, HttpError> = if request.IsSecure {
        Error(HttpError.Handler("Cleartext request marked secure"))
    } else {
        Ok(HttpResponse(HttpStatusCode.OK, ArrayList<HttpHeader>(), HttpStringContent("plain")))
    }
    return Task.FromResult(result)
}

async func Main() -> Task<int> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) else { return 1 }
    let Ok(port) = server.GetLocalPort() else { return 2 }
    let serving = server.ServeOne(Respond)
    use client = HttpClient()
    let url = String.Concat(String.Concat("http://localhost:", port.ToString()), "/")
    let response = await client.Get(url)
    let completed = await serving
    server.Close()
    let Ok(received) = response else { return 3 }
    if let Error(_) = completed { return 4 }
    if received.Content.Length != 5 || !HasFirstByte(received.Content) { return 5 }
    Console.WriteLine("Managed cleartext exchange passed")
    return 0
}

func HasFirstByte(content: HttpContent) -> bool {
    let memory = (HttpMemoryContent)content
    let bytes: ReadOnlySlice<byte> = memory.Memory
    return bytes[0] == (byte)112
}
