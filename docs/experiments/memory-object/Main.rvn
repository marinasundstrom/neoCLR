module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Result.*
import NeoClr.Testing.*

func Equal(left: Object, right: Object) -> Result<unit, TestFailure> {
    _ = Assert.True(left.Equals(right) && right.Equals(left), "Memory region equality")?
    _ = Assert.True(left.GetHashCode() == right.GetHashCode(), "Memory region hashes")?
    _ = Assert.True(!left.Equals(null) && !left.Equals(0), "Memory wrong type")?
    return Ok(())
}

func Retain() -> Object {
    let memory: Memory<byte> = [1b, 2b, 3b, 4b]
    return memory.Slice(1, 2)
}

[Test]
func `Persistent memory regions preserve identity hashing and boxed ownership across collection`() -> Result<unit, TestFailure> {
    let data = [10b, 20b, 30b, 40b]
    let memory: Memory<byte> = data
    let same: Memory<byte> = data
    let readonly: ReadOnlyMemory<byte> = memory
    _ = Equal(memory, same)?
    _ = Equal(memory, readonly)?
    _ = Assert.True(memory.Equals(readonly) && memory.GetHashCode() == readonly.GetHashCode(), "Direct region calls")?
    _ = Assert.True(memory.ToString().ContainsOrdinal("Memory"), "Memory diagnostic display")?
    _ = Equal(memory.Slice(1, 2), readonly.Slice(1, 2))?
    _ = Assert.True(!((Object)memory).Equals(memory.Slice(1)), "Different offset and length")?
    _ = Assert.True(!((Object)memory.Slice(0, 2)).Equals(memory.Slice(1, 2)), "Different offset")?
    let other: Memory<byte> = [10b, 20b, 30b, 40b]
    _ = Assert.True(!((Object)memory).Equals(other), "Equal contents have distinct owners")?
    let retained: Object = memory.Slice(1, 2)
    let hash = retained.GetHashCode()
    data[1] = 99b
    _ = Equal(retained, readonly.Slice(1, 2))?
    _ = Assert.True(retained.GetHashCode() == hash, "Mutation preserves region hash")?
    _ = Equal(default(Memory<byte>), default(ReadOnlyMemory<byte>))?
    _ = Assert.True(((Object)default(Memory<byte>)).GetHashCode() == 0, "Default region hash")?
    _ = Equal(memory.Slice(4, 0), readonly.Slice(4, 0))?
    _ = Assert.True(!((Object)memory.Slice(0, 0)).Equals(memory.Slice(4, 0)), "Empty offsets remain distinct")?
    _ = Assert.True(!((Object)default(Memory<byte>)).Equals(memory.Slice(0, 0)), "Default has no owner")?
    let map = HashMap<Object, int>((left, right) => left.Equals(right), key => key.GetHashCode())
    _ = Assert.True(map.TryAdd(memory, 1) && !map.TryAdd(readonly, 2), "Readonly shares region identity")?
    let soleOwner = Retain()
    System.Runtime.GC.Collect()
    _ = Equal(retained, readonly.Slice(1, 2))?
    if retained is Memory<byte> restored {
        let view: Slice<byte> = restored
        _ = Assert.True(view[0] == 99b && view[1] == 30b, "Unboxed retained owner and window")?
    } else {
        return Assert.True(false, "Exact memory unboxing")
    }
    if soleOwner is Memory<byte> owned {
        let bytes: Slice<byte> = owned
        _ = Assert.True(bytes[0] == 2b && bytes[1] == 3b, "Box retains sole owner across GC")?
    } else {
        return Assert.True(false, "Sole owner unboxing")
    }
    _ = Assert.True(!(retained is ReadOnlyMemory<byte>), "Equality does not change nominal unboxing")?
    return Ok(())
}

func Main() -> int {
    let suite = TestSuite()
    suite.Add("memory-object", "Persistent memory regions preserve identity hashing and boxed ownership across collection", `Persistent memory regions preserve identity hashing and boxed ownership across collection`)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
