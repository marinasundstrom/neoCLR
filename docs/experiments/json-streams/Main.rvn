import System.*
import System.Collections.*
import System.IO.*
import System.Result.*
import System.Text.*

func Check(condition: bool) {
    if !condition {
        Panic("JSON stream contract failed")
    }
}

// One byte at a time deliberately splits multibyte UTF-8 characters.
class ShortInput : InputStream {
    private val bytes: Sequence<byte>
    private var position: int = 0
    private val failAt: int
    private var closed: bool = false

    init(bytes: Sequence<byte>, failAt: int) {
        self.bytes = bytes
        self.failAt = failAt
    }

    val Closed: bool => closed
    val Position: int => position

    func Read(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Failure(StreamError.Closed)
        }
        if position == failAt {
            return Failure(StreamError.IoFailure)
        }
        if count == 0 || position == bytes.Count {
            return Ok(0)
        }
        buffer[offset] = bytes[position]
        position += 1
        return Ok(1)
    }

    func Close() {
        closed = true
    }
}

class ShortOutput : OutputStream {
    private var bytes: List<byte> = ArrayList<byte>()
    private val failAt: int
    private val zeroProgress: bool
    private var closed: bool = false
    private var flushes: int = 0

    init(failAt: int, zeroProgress: bool) {
        self.failAt = failAt
        self.zeroProgress = zeroProgress
    }

    val Closed: bool => closed
    val Count: int => bytes.Count
    val Flushes: int => flushes
    val Bytes: Sequence<byte> => bytes

    func Write(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Failure(StreamError.Closed)
        }
        if bytes.Count == failAt {
            return Failure(StreamError.AccessDenied)
        }
        if count == 0 || zeroProgress {
            return Ok(0)
        }
        bytes.Add(buffer[offset])
        return Ok(1)
    }

    func Flush() -> Result<unit, StreamError> {
        flushes += 1
        return Ok(())
    }

    func Close() {
        closed = true
    }
}

// The same DOM travels through both entry points. Mapping application objects is later.
func RoundTrip(text: string) -> Result<string, string> {
    let original = JsonSerializer.Deserialize(text)?
    let canonical = JsonSerializer.Serialize(original)?
    let memory = MemoryStream()
    let write = JsonSerializer.Serialize(memory, original)
    let Ok(_) = write else {
        memory.Close()
        return Failure("Memory serialization failed")
    }
    let Ok(_) = memory.Seek(0) else {
        memory.Close()
        return Failure("Memory rewind failed")
    }
    let restored = JsonSerializer.Deserialize(memory)
    memory.Close()
    let value = restored?
    let actual = JsonSerializer.Serialize(value)?
    Check(actual == canonical)
    // Also force partial writes and reads independently of MemoryStream.
    let output = ShortOutput(-1, false)
    _ = JsonSerializer.Serialize(output, original)?
    Check(!output.Closed && output.Flushes == 0)
    let input = ShortInput(output.Bytes, -1)
    let shortValue = JsonSerializer.Deserialize(input)?
    Check(!input.Closed && input.Position == output.Count)
    let shortText = JsonSerializer.Serialize(shortValue)?
    Check(shortText == canonical)
    input.Close()
    output.Close()
    return Ok(actual)
}

func ReadFailure(input: ShortInput, expected: string) {
    match JsonSerializer.Deserialize(input) {
        Failure(let error) => Check(error == expected)
        Ok(_) => Panic("Invalid input accepted")
    }
    Check(!input.Closed)
    input.Close()
}

func MemoryContracts() {
    let memory = MemoryStream()
    let input: InputStream = memory
    let output: OutputStream = memory
    let seek: SeekableStream = memory
    let data: byte[] = [(byte)65, (byte)66, (byte)67]
    let Ok(initial) = memory.GetLength() else {
        Panic("Missing length")
        return
    }
    Check(initial == 0)
    let Ok(written) = output.Write(data, 0, 3) else {
        Panic("Memory write failed")
        return
    }
    Check(written == 3)
    let Ok(_) = seek.Seek(1) else {
        Panic("Seek failed")
        return
    }
    let Ok(_) = output.Write(data, 0, 1) else {
        Panic("Overwrite failed")
        return
    }
    let Ok(_) = seek.Seek(5) else {
        Panic("Gap seek failed")
        return
    }
    let Ok(_) = output.Write(data, 0, 0) else {
        Panic("Empty write failed")
        return
    }
    let Ok(before) = memory.GetLength() else {
        Panic("Missing length")
        return
    }
    Check(before == 3)
    let Ok(_) = output.Write(data, 2, 1) else {
        Panic("Gap write failed")
        return
    }
    let Ok(_) = seek.Seek(0) else {
        Panic("Rewind failed")
        return
    }
    let buffer: byte[] = [(byte)9, (byte)9, (byte)9, (byte)9, (byte)9, (byte)9, (byte)9, (byte)9]
    let Ok(read) = input.Read(buffer, 1, 7) else {
        Panic("Read failed")
        return
    }
    Check(read == 6 && buffer[0] == 9 && buffer[7] == 9)
    Check(buffer[1] == 65 && buffer[2] == 65 && buffer[3] == 67)
    Check(buffer[4] == 0 && buffer[5] == 0 && buffer[6] == 67)
    let Ok(eof) = input.Read(buffer, 0, 1) else {
        Panic("EOF failed")
        return
    }
    Check(eof == 0)
    match output.Write(data, 2147483647, 1) {
        Failure(let error) => Check(error is StreamError.InvalidRange)
        Ok(_) => Panic("Invalid write accepted")
    }
    match input.Read(buffer, -1, 1) {
        Failure(let error) => Check(error is StreamError.InvalidRange)
        Ok(_) => Panic("Invalid read accepted")
    }
    match seek.Seek(-1) {
        Failure(let error) => Check(error is StreamError.InvalidRange)
        Ok(_) => Panic("Negative seek accepted")
    }
    match seek.Seek(65537) {
        Failure(let error) => Check(error is StreamError.LimitExceeded)
        Ok(_) => Panic("Oversized seek accepted")
    }
    let Ok(position) = seek.GetPosition() else {
        Panic("Missing position")
        return
    }
    Check(position == 6)
    let Ok(_) = seek.Seek(65536) else {
        Panic("Boundary seek failed")
        return
    }
    match output.Write(data, 0, 1) {
        Failure(let error) => Check(error is StreamError.LimitExceeded)
        Ok(_) => Panic("Oversized write accepted")
    }
    let Ok(length) = memory.GetLength() else {
        Panic("Missing length")
        return
    }
    Check(length == 6)
    let Ok(_) = output.Flush() else {
        Panic("Flush failed")
        return
    }
    input.Close()
    output.Close()
    match memory.GetLength() {
        Failure(let error) => Check(error is StreamError.Closed)
        Ok(_) => Panic("Closed length accepted")
    }
    match seek.GetPosition() {
        Failure(let error) => Check(error is StreamError.Closed)
        Ok(_) => Panic("Closed position accepted")
    }
    match output.Write(data, 0, 0) {
        Failure(let error) => Check(error is StreamError.Closed)
        Ok(_) => Panic("Closed write accepted")
    }
    match input.Read(buffer, 0, 0) {
        Failure(let error) => Check(error is StreamError.Closed)
        Ok(_) => Panic("Closed read accepted")
    }
    match output.Flush() {
        Failure(let error) => Check(error is StreamError.Closed)
        Ok(_) => Panic("Closed flush accepted")
    }
    match seek.Seek(0) {
        Failure(let error) => Check(error is StreamError.Closed)
        Ok(_) => Panic("Closed seek accepted")
    }
}

func Main() {
    MemoryContracts()
    let text = "{\"station\":\"Café 😀\",\"readings\":[21,22.5],\"ready\":true,\"note\":null}"
    match RoundTrip(text) {
        Ok(let result) => Console.WriteLine(result)
        Failure(let error) => Panic(error)
    }
    let Ok(value) = JsonSerializer.Deserialize("[1,2]") else {
        Panic("Could not create test value")
        return
    }
    let failed = ShortOutput(2, false)
    match JsonSerializer.Serialize(failed, value) {
        Failure(let error) => Check(error == "Write: AccessDenied")
        Ok(_) => Panic("Output failure lost")
    }
    Check(failed.Count == 2 && !failed.Closed && failed.Flushes == 0)
    failed.Close()
    let zero = ShortOutput(-1, true)
    match JsonSerializer.Serialize(zero, value) {
        Failure(let error) => Check(error == "Write: IoFailure")
        Ok(_) => Panic("Zero-progress output accepted")
    }
    Check(!zero.Closed && zero.Count == 0)
    zero.Close()
    let cycle = JsonValue.ArrayValue()
    let Ok(_) = cycle.Add(cycle) else {
        Panic("Could not create cycle")
        return
    }
    let untouched = ShortOutput(-1, false)
    match JsonSerializer.Serialize(untouched, cycle) {
        Failure(_) => Check(untouched.Count == 0 && !untouched.Closed)
        Ok(_) => Panic("Cycle accepted")
    }
    untouched.Close()
    ReadFailure(ShortInput(Utf8.Encode("{}"), 1), "Read: IoFailure")
    let invalid: byte[] = [(byte)34, (byte)195, (byte)34]
    ReadFailure(ShortInput(invalid, -1), "Read: InvalidUtf8")
    let tooLarge: List<byte> = ArrayList<byte>()
    for index in 0..129 {
        tooLarge.Add((byte)32)
    }
    let oversized = ShortInput(tooLarge, -1)
    ReadFailure(oversized, "Read: LimitExceeded")
    Check(oversized.Position == 129)
    let malformed = ShortInput(Utf8.Encode("[1,"), -1)
    match JsonSerializer.Deserialize(malformed) {
        Failure(_) => Check(!malformed.Closed)
        Ok(_) => Panic("Truncated JSON accepted")
    }
    malformed.Close()
    var padding = ""
    for index in 0..126 {
        padding += "a"
    }
    let boundary = "\"" + padding + "\""
    match RoundTrip(boundary) {
        Ok(_) => {}
        Failure(let error) => Panic(error)
    }
    Console.WriteLine("JSON stream checks passed")
}
