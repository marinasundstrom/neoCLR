<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RavenRoot)/src/Raven.CodeAnalysis/Raven.CodeAnalysis.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../runtime/raven/src/System/Web/Http/HttpError.rvn" LogicalName="NeoCLR.HttpError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Networking/Sockets/SocketError.rvn" LogicalName="NeoCLR.SocketError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Networking/DnsError.rvn" LogicalName="NeoCLR.DnsError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/UriError.rvn" LogicalName="NeoCLR.UriError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Storage/StorageLookupError.rvn" LogicalName="NeoCLR.StorageLookupError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/IO/TextReadError.rvn" LogicalName="NeoCLR.TextReadError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/IO/StreamError.rvn" LogicalName="NeoCLR.StreamError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Storage/FileReadError.rvn" LogicalName="NeoCLR.FileReadError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Storage/FileWriteError.rvn" LogicalName="NeoCLR.FileWriteError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/ConsoleReadError.rvn" LogicalName="NeoCLR.ConsoleReadError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Text/Utf8SliceError.rvn" LogicalName="NeoCLR.Utf8SliceError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Int32ParseError.rvn" LogicalName="NeoCLR.Int32ParseError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/Linq/SingleError.rvn" LogicalName="NeoCLR.SingleError.rvn" />
    <EmbeddedResource Include="../../../runtime/raven/src/System/IntegerDivisionError.rvn" LogicalName="NeoCLR.IntegerDivisionError.rvn" />
    <None Update="samples/*.rvn" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireRaven" BeforeTargets="Restore;PrepareForBuild" Condition="'$(RavenRoot)' == ''">
    <Error Text="Pass -p:RavenRoot=/absolute/path/to/Raven at the documented revision." />
  </Target>
<ItemGroup><EmbeddedResource Include="../../../runtime/raven/src/System/Networking/IPAddressError.rvn" LogicalName="NeoCLR.IPAddressError.rvn" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../../../runtime/raven/src/System/Data/Json/JsonError.rvn" LogicalName="NeoCLR.JsonError.rvn" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../../../runtime/raven/src/System/Runtime/Reflection/ReflectionError.rvn" LogicalName="NeoCLR.ReflectionError.rvn" /></ItemGroup>
</Project>
