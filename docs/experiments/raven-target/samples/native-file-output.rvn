import System.*
import System.Console.*
import System.Result.*
import System.Storage.*

func Main() {
    let Ok(_) = FileText.WriteAllText("output.txt", "Hello, värld!", 64) else {
        Fail("Initial write failed")
    }
    let Error(error) = FileText.WriteAllText("output.txt", "replacement", 2) else {
        Fail("Oversized write succeeded")
    }
    if !(error is FileWriteError.TooLarge) {
        Fail("Unexpected write error")
    }
    WriteLine("File output passed")
}
