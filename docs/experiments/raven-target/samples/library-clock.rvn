import System.*
import System.Console.*

// Depend on the Raven-authored contract; the runtime supplies SystemClock.
func ShowLocalTime(clock: Clock) {
    let now = clock.Now.ToLocalDateTime()
    let date = now.Date
    let time = now.Time
    WriteLine(date.Year)
    WriteLine(date.Month)
    WriteLine(date.Day)
    WriteLine(time.Hour)
    WriteLine(time.Minute)
    WriteLine(time.Second)
}

func Main() {
    ShowLocalTime(SystemClock())
}
