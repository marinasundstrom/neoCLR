import System.*
import System.Console.*
func ShowInt(value: int) { WriteLine(value) }
func ShowString(value: string) { WriteLine(value) }
func Main() {
    let numbers = [7, 42]
    numbers.ForEach(ShowInt)
    let words = ["First", "Second"]
    words.ForEach(ShowString)
    let empty: int[] = Array<int>.Empty
    empty.ForEach(ShowInt)
    let emptyWords = Array<string>.Empty
    emptyWords.ForEach(ShowString)
    let nested = Array<int[]>.Empty
    for items in nested {
        items.ForEach(ShowInt)
    }
}
