import System.Option.*
import System.Introspection.*
import System.*
import System.Collections.*
import System.Console.*
func Main() {
    let types = ArrayList<TypeInfo>()
    let kind = typeof(int)
    types.Add(kind)
    types.Add(typeof(string))
    let copy = types.Copy()
    if copy[0].Equals(kind) {
        WriteLine("Copied TypeInfo reference")
    }
    for value in types {
        WriteLine(value.Name)
    }
    let nested = ArrayList<ArrayList<TypeInfo>>()
    nested.Add(types)
    nested[0].Add(typeof(Date))
    WriteLine(types.Count)
    WriteLine(copy.Count)
    let comparisons = ArrayList<Comparable<int>>()
    comparisons.Add(42)
    WriteLine(comparisons[0].CompareTo(42))
    let optional: Option<ArrayList<TypeInfo>> = Some(types)
    match optional {
        .Some(let some) => WriteLine(some.Count)
        .None => WriteLine("No list")
    }
    let outcomes = ArrayList<Result<int, OverflowError>>(1)
    outcomes.Add(Result<int, OverflowError>.Ok(42))
    outcomes.Add(Result<int, OverflowError>.Error(OverflowError()))
    outcomes.Add(Result<int, OverflowError>.Ok(7))
    let outcomesCopy = outcomes.Copy()
    WriteLine(outcomesCopy.Count)
    for outcome in outcomesCopy {
        match outcome {
            .Ok(let ok) => WriteLine(ok)
            .Error(let error) => WriteLine("Stored error")
        }
    }
    let functions = ArrayList<Func<int,int>>()
    functions.Add(Identity)
    WriteLine(functions[0](42))
    let result = Result<TypeInfo, OverflowError>.Ok(kind)
    match result {
        .Ok(let ok) => WriteLine(ok.Name)
        .Error(let error) => WriteLine("Overflow")
    }
}

func Identity(value: int) -> int {
    return value
}
