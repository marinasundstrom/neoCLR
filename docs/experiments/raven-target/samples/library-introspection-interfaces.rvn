import System.*
import System.Console.*
import System.Introspection.*

func RequireInterface(description: TypeInfo) {
    if description.IsInterface {
        WriteLine("Interface")
    } else {
        Fault("Expected an introspection interface")
    }
}

func Kind(member: MemberInfo) -> string {
    return match member {
        FieldInfo => "Field"
        MethodInfo => "Method"
        PropertyInfo => "Property"
        TypeInfo => "Type"
    }
}

func Main() {
    RequireInterface(typeof(TypeInfo))
    RequireInterface(typeof(ParameterInfo))
    RequireInterface(typeof(MemberInfo))
    RequireInterface(typeof(FieldInfo))
    RequireInterface(typeof(MethodInfo))
    RequireInterface(typeof(PropertyInfo))

    val member: MemberInfo = typeof(Date).GetProperties()[0]
    match member.DeclaringType {
        .Some(val owner) => WriteLine(owner.Name)
        .None => Fault("Expected a declaring type")
    }
    WriteLine(Kind(typeof(Date).GetFields(BindingFlags.Instance | BindingFlags.NonPublic)[0]))
    WriteLine(Kind(typeof(Date).GetMethods()[0]))
    WriteLine(Kind(member))
    WriteLine(Kind(typeof(Date)))
}
