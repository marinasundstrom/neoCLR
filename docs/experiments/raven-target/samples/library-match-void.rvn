import System.Result.*
import System.*
import System.Console.*

func Complete(value: int) -> Result<System.Void, OverflowError> {
    let amount = Math.Abs(value)?
    WriteLine(amount)
    return Ok(())
}

func Save(value: int) -> Result<System.Void, OverflowError> {
    Complete(value)?
    WriteLine("Saved")
    return Ok(())
}

func Show(value: int) {
    let result = Save(value)
    match result {
        .Ok(let done) => WriteLine("Completed")
        .Error(let error) => WriteLine("Overflow")
    }
}

func Main() {
    Show(-42); Show(-2147483648)
}
