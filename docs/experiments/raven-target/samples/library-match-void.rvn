import System.*
import System.Console.*

func Complete(value: int) -> Result<System.Void, OverflowError> {
    let amount = Math.Abs(value)?
    WriteLine(amount)
    return Result<System.Void, OverflowError>(Result.Ok<System.Void>(()))
}
func Save(value: int) -> Result<System.Void, OverflowError> {
    Complete(value)?
    WriteLine("Saved")
    return Result<System.Void, OverflowError>(Result.Ok<System.Void>(()))
}
func Show(value: int) {
    let result = Save(value)
    match result {
        Result.Ok<System.Void> done => WriteLine("Completed")
        Result.Error<OverflowError> error => WriteLine("Overflow")
    }
}
func Main() { Show(-42); Show(-2147483648) }
