import System.*
import System.Text.*
import System.Console.*
func ShowLong(value: long, other: long) {
    WriteLine(value.CompareTo(other))
}

func ShowChar(value: char, other: char) {
    WriteLine(value.CompareTo(other))
}

func Main() {
    let signed: sbyte = (sbyte)-1
    let octet: byte = 255b
    let small: short = (short)-32768
    let wide: ushort = (ushort)65535
    let unsigned: uint = (uint)-1
    let large: ulong = (ulong)-1L
    let single: float = 1.5f
    WriteLine(signed.CompareTo((sbyte)0))
    WriteLine(octet.CompareTo((byte)0))
    WriteLine(small.CompareTo((short)0))
    WriteLine(wide.CompareTo((ushort)0))
    WriteLine(unsigned.CompareTo((uint)0))
    WriteLine(large.CompareTo((ulong)0))
    WriteLine(single.CompareTo(1.5f))
    let native = default(nint)
    let unsignedNative = default(nuint)
    WriteLine(native.CompareTo(native))
    WriteLine(unsignedNative.CompareTo(unsignedNative))
    ShowLong(-9223372036854775808L, 9223372036854775807L)
    ShowChar('a', 'z')
    if UnicodeScalar.IsDigit((uint)1635) {
        WriteLine("Digit")
    }
    if UnicodeScalar.IsNumber((uint)8551) {
        WriteLine("Number")
    }
    if UnicodeScalar.IsLetter((uint)233) {
        WriteLine("Letter")
    }
    if UnicodeScalar.IsUpper((uint)65) {
        WriteLine("Upper")
    }
    if UnicodeScalar.IsLower((uint)97) {
        WriteLine("Lower")
    }
    if UnicodeScalar.IsSeparator((uint)32) {
        WriteLine("Separator")
    }
    if UnicodeScalar.IsControl((uint)10) {
        WriteLine("Control")
    }
    if UnicodeScalar.IsPunctuation((uint)33) {
        WriteLine("Punctuation")
    }
    if UnicodeScalar.IsSymbol((uint)36) {
        WriteLine("Symbol")
    }
    if UnicodeScalar.IsAscii((uint)65) {
        WriteLine("ASCII")
    }
    if UnicodeScalar.IsAsciiDigit((uint)51) {
        WriteLine("ASCII digit")
    }
    if UnicodeScalar.IsLetterOrDigit((uint)233) {
        WriteLine("Letter or digit")
    }
    if UnicodeScalar.IsWhiteSpace((uint)9) {
        WriteLine("Whitespace")
    }
}
