import System.Option.*
import System.*
import System.Console.*

func Magnitude(value: int) -> int {
    return match Math.Abs(value) {
        .Ok(let ok) => ok
        .Error(let error) => -1
    }
}

func Describe(value: Option<int>) -> string {
    return value match {
        .Some(let present) => "Present"
        .None => "Absent"
    }
}

func Show(value: int) {
    match Math.Abs(value) {
        .Ok(let ok) => {
            WriteLine(ok)
        }
        .Error(let error) => {
            WriteLine("Overflow")
        }
    }
}

func Main() {
    WriteLine(Magnitude(-42))
    WriteLine(Magnitude(-2147483648))
    WriteLine(Describe(Some(7)))
    WriteLine(Describe(None()))
    Show(-42)
    Show(-2147483648)
}
