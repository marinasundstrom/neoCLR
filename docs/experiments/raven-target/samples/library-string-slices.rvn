import System.*
import System.Text.*
import System.Console.*

func Extract(text: string, start: int, count: int) -> Result<string, Utf8SliceError> {
    let part = text.SliceUtf8(start, count)?
    WriteLine("Sliced")
    return Result<string, Utf8SliceError>.Ok(part)
}

func ShowSlice(result: Result<string, Utf8SliceError>) {
    match result {
        .Ok(let ok) => WriteLine(ok)
        .Error(let error) => {
            if (error is System.Text.Utf8SliceError.OutOfRange) {
                WriteLine("Out of range")
            } else if (error is System.Text.Utf8SliceError.InvalidBoundary) {
                WriteLine("Invalid boundary")
            }
        }
    }
}

func Main() {
    let text = "Aé😀Z"
    ShowSlice(Extract(text, 1, 2))
    ShowSlice(Extract(text, 3, 4))
    ShowSlice(Extract(text, 8, 0))
    ShowSlice(Extract(text, 2, 0))
    ShowSlice(Extract(text, 3, 3))
    ShowSlice(Extract(text, -1, 1))
    ShowSlice(Extract(text, 7, 2))
    ShowSlice(Extract(text, 0, 2147483647))
    ShowSlice(Extract(text, 2, 2147483647))
    ShowSlice(Extract(text, 0, -1))
    ShowSlice(Extract("", 0, 0))
}
