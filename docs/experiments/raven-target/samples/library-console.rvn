import System.*
import System.Console.*

func Read() -> Result<Optional<byte>, IO.ConsoleReadError> {
    let value = ReadByte()?
    return Result<Optional<byte>, IO.ConsoleReadError>.Ok(value)
}

func Show() {
    let result = Read()
    if result is .Ok(let ok) {
        if ok is .Some(let some) {
            WriteLine((int)some)
        } else {
            WriteLine("End of input")
        }
    } else if result is .Failure(let error) {
        WriteLine(error.ToString())
    }
}

func Main() {
    Show(); Show(); Show()
}
