import System.Option.*
import System.*
import System.Linq.*
import System.Introspection.*
import System.Runtime.*

class Widget {
    var Count: int = 0
}

func Main() {
    let widget: Object = Widget()
    let assembly = RuntimeContext.Current.ExecutingAssembly
    Console.WriteLine(assembly.Name)
    for reference in assembly.ReferencedAssemblies {
        Console.WriteLine(reference.Name)
        if reference.GetTypes().Count > 0 {
            Console.WriteLine("Runtime types available")
        }
    }
    for module in assembly.GetModules() {
        Console.WriteLine(module.Name)
        Console.WriteLine(module.MetadataToken)
        for typeInfo in module.GetTypes().OfType<NominalTypeInfo>() {
            Console.WriteLine(typeInfo.Name)
            if typeInfo.MetadataToken is Some(let token) && token > 0 {
                Console.WriteLine("Type token available")
            }
        }
    }
    let description = (NominalTypeInfo)widget.GetType()
    if let Some(module) = description.Module {
        Console.WriteLine(module.Assembly.Name)
    } else {
        System.Fail("Missing nominal module")
    }
    if let Some(token) = description.MetadataToken {
        if let Some(declaredToken) = ((NominalTypeInfo)typeof(Widget)).MetadataToken {
            if token == declaredToken {
                Console.WriteLine("Same definition token")
            }
        }
    }
}
