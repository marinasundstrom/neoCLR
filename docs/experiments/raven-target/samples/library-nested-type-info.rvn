import System.*
import System.Introspection.*

class Outer {
    public class Inner {
        var Value: int = 0
    }
}

func Main() {
    let nested: MemberInfo = (NominalTypeInfo)typeof(Outer.Inner)
    Console.WriteLine(nested.Name)
    match nested.DeclaringType {
        .Some(let owner) => {
            Console.WriteLine(owner.DisplayName)
            if owner.Equals(typeof(Outer)) {
                Console.WriteLine("Actual declaring type")
            }
        }
        .None => Panic("Expected a declaring type")
    }
    match ((NominalTypeInfo)typeof(Outer)).DeclaringType {
        .Some(_) => Panic("Top-level type has an owner")
        .None => Console.WriteLine("Top-level type")
    }
    match nested {
        NominalTypeInfo => Console.WriteLine("Type member")
        FieldInfo => Panic("Unexpected field")
        MethodInfo => Panic("Unexpected method")
        ConstructorInfo => Panic("Unexpected constructor")
        PropertyInfo => Panic("Unexpected property")
    }
}
