import System.*
import System.Result.*
import System.LocalTimeMapping.*
import System.Globalization.*
import System.Console.*

func Show(value: ZonedDateTime) {
    let Ok(text) = DateTimeFormat.Invariant.FormatLocalDateTime(value.LocalDateTime) else {
        System.Fault("Cannot format date")
    }
    WriteLine(text)
    WriteLine(value.Offset.Seconds)
    WriteLine(value.Instant.UnixTimeTicks)
}

func Describe(value: DateTime) {
    match value {
        LocalDateTime local => WriteLine("A civil date and time without a zone")
        ZonedDateTime zoned => Show(zoned)
    }
}

func Main() {
    let Ok(zone) = TimeZone.Find("Europe/Stockholm") else {
        System.Fault("Unknown zone")
    }
    let Ok(date) = Date.Create(2024, 10, 27) else {
        System.Fault("Invalid date")
    }
    let Ok(time) = Time.Create(2, 30, 0) else {
        System.Fault("Invalid time")
    }
    let local = LocalDateTime.Create(date, time)
    let Ok(mapping) = zone.MapLocal(local) else {
        System.Fault("Date outside zone range")
    }
    match mapping {
        Unique(let value) => Describe(value)
        Ambiguous(let earlier, let later) => {
            WriteLine("This local time occurs twice:")
            Describe(earlier)
            Describe(later)
        }
        Skipped => WriteLine("This local time does not occur")
    }
}
