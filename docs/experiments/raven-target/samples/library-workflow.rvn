import System.Option.*
import System.*
import System.Collections.*
import System.Console.*

func FindPrice(product: int) -> Option<int> {
    if product == 7 {
        return Some(-42)
    }
    if product == 8 {
        return Some(-2147483648)
    }
    return None()
}

func Process(product: int) -> Option<System.Void> {
    let price = FindPrice(product)
    if price is .Some(let found) {
        let amount = Math.Abs(found)
        if amount is .Ok(let ok) {
            WriteLine(ok)
            return Some(())
        } else if amount is .Error(let error) {
            WriteLine("Price overflow")
        }
    } else if price is .None {
        WriteLine("Product not found")
    }
    return None()
}

func Main() {
    let products = ArrayList<int>()
    products.Add(7)
    products.Add(8)
    products.Add(99)
    let queue: List<int> = products
    for product in queue {
        let completion = Process(product)
        if completion is .Some(let done) {
            WriteLine("Completed")
        } else if completion is .None {
            WriteLine("Skipped")
        }
    }
}
