import System.Result.*
import System.*
import System.Console.*

func ParseInput(text: string) -> Result<int, Int32ParseError> {
    let value = Int32.Parse(text)?
    WriteLine("Parsed")
    return Ok(value)
}

func ShowParse(result: Result<int, Int32ParseError>) {
    match result {
        .Ok(let ok) => WriteLine(ok)
        .Error(let error) => {
            if (error is Int32ParseError.InvalidFormat) {
                WriteLine("Invalid format")
            } else if (error is Int32ParseError.Overflow) {
                WriteLine("Overflow")
            }
        }
    }
}

func Main() {
    ShowParse(ParseInput("42"))
    ShowParse(ParseInput("-2147483648"))
    ShowParse(ParseInput("2147483647"))
    ShowParse(ParseInput("+7"))
    ShowParse(ParseInput("2147483648"))
    ShowParse(ParseInput("-2147483649"))
    ShowParse(ParseInput(""))
    ShowParse(ParseInput("42x"))
    ShowParse(ParseInput(" 42"))
    ShowParse(ParseInput("４２"))
}
