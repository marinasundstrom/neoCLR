import System.*
import System.Console.*
import System.Introspection.*

func Main() {
    let type = typeof(int)
    WriteLine(type.Name)
    if type.IsValueType {
        WriteLine("Value type")
    }

    // Descriptive queries use the shared Introspection model, not invocation APIs.
    let metadata: TypeInfo = type
    for method in metadata.GetMethods() {
        WriteLine(method.Name)
    }
}
