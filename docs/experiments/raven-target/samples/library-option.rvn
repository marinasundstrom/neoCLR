import System.Option.*
import System.*
import System.Console.*

func FindPrice(product: int) -> Option<int> {
    if product == 7 {
        return Some(42)
    }
    return None()
}

func ShowPrice(product: int) {
    let price = FindPrice(product)
    if price is .Some(let found) {
        WriteLine(found)
    } else if price is .None {
        WriteLine("Product not found")
    }
}

func Main() {
    ShowPrice(7)
    ShowPrice(99)
}
