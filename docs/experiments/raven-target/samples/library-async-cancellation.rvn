import System.*
import System.Concurrency.Tasks.*
import System.Optional.*
import System.Concurrency.Tasks.TaskOutcome.*
import System.Console.*

async func Read(input: Task<int>) -> Task<int> {
    let value = await input
    WriteLine("Read completed")
    return value + 1
}

func Main() {
    let promise = Promise<int>()
    let result = Read(promise.Task)
    // Observe cancellation explicitly: awaiting result would cancel Main before it prints.
    result.OnCompleted(() => {
        if result.Outcome is Some(Cancelled) {
            WriteLine("Cancelled")
        }
    })
    promise.Cancel()
}
