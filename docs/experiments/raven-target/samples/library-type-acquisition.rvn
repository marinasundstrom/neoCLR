import System.*
import System.Introspection.*
import System.Runtime.*

interface WidgetInfo {
    val Name: string { get }
}

class Widget : WidgetInfo {
    val Name: string => "widget"
}

func Main() {
    let widget: Object = Widget()
    if typeof(Widget).IsInstanceOfType(widget) {
        Console.WriteLine("Concrete class")
    }
    if !typeof(Widget).AssignableTo(typeof(Object)) {
        Panic("Widget must be assignable to Object")
    }
    let text: Object = "Hello"
    let description = text.GetType()
    Console.WriteLine(description.DisplayName)
    if description.Equals(typeof(string)) {
        Console.WriteLine("Same type")
    }
    let values = [1, 2, 3]
    let array: Object = values
    if array.GetType().IsArray {
        Console.WriteLine("Array type")
    }
    let number: Object = 42
    Console.WriteLine(number.GetType().DisplayName)
    let view: WidgetInfo = Widget()
    let boxed: Object = view
    Console.WriteLine(boxed.GetType().DisplayName)
}
