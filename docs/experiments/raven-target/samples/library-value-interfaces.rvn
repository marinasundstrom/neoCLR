import System.Introspection.*
import System.*
import System.Console.*
func Ordered(value: ComparableTo<int>) -> int {
    return value.CompareTo(42)
}

func Main() {
    var value = 42
    let comparable: ComparableTo<int> = value
    value = 100
    WriteLine(comparable.CompareTo(42))
    WriteLine(Ordered(43))
    let equatable: EquatableTo<int> = 42
    if equatable.Equals(42) {
        WriteLine("Equal integer")
    }
    let text: EquatableTo<string> = "hello"
    if text.Equals("hello") {
        WriteLine("Equal string")
    }
    let kind = typeof(int)
    let types: EquatableTo<TypeInfo> = kind
    if types.Equals(typeof(int)) {
        WriteLine("Equal type")
    }
    match Date.Create(2026, 9, 13) {
        .Ok(let ok) => CheckDate(ok)
        .Error(let error) => WriteLine("Invalid date")
    }
    let wide: ComparableTo<long> = 42L
    WriteLine(wide.CompareTo(42L))
    let boolean: ComparableTo<bool> = true
    WriteLine(boolean.CompareTo(true))
}

func CheckDate(date: Date) {
    let dates: ComparableTo<Date> = date
    WriteLine(dates.CompareTo(date))
    let equalDates: EquatableTo<Date> = date
    if equalDates.Equals(date) {
        WriteLine("Equal date")
    }
}
