import System.*
import System.Console.*

func Normalize(value: int) -> Result<int, OverflowError> {
    let amount = Math.Abs(value)?
    WriteLine("Continued")
    return Result<int, OverflowError>.Ok(amount)
}

func Show(value: int) {
    let result = Normalize(value)
    if result is .Ok(let ok) {
        WriteLine(ok)
    } else if result is .Error(let error) {
        WriteLine("Overflow propagated")
    }
}

func Main() {
    Show(-42)
    Show(-2147483648)
}
