import System.Option.*
import System.*
import System.Console.*

func Marker(completed: int) -> Option<System.Void> {
    if completed == 1 {
        return Some(())
    }
    return None()
}

func Show(completed: int) {
    let marker = Marker(completed)
    if marker is .Some(let done) {
        WriteLine("Completed without a payload")
    } else if marker is .None {
        WriteLine("Not completed")
    }
}

func Main() {
    Show(1)
    Show(0)
}
