import System.*
import System.Console.*
// Exercise case construction, carrier copying and generated case patterns.
func Main() {
    let error0 = Storage.FileReadError.InvalidLimit()
    WriteLine(error0.ToString())
    let restored1 = error0
    if restored1 is Storage.FileReadError.InvalidLimit {
        WriteLine("Confirmed")
    }
    let error1 = Storage.FileReadError.InvalidPath()
    WriteLine(error1.ToString())
    let restored2 = error1
    if restored2 is Storage.FileReadError.InvalidPath {
        WriteLine("Confirmed")
    }
    let error2 = Storage.FileReadError.NotFound()
    WriteLine(error2.ToString())
    let restored3 = error2
    if restored3 is Storage.FileReadError.NotFound {
