    let invalidrangeerror = InvalidRangeError()
    WriteLine(invalidrangeerror.ToString())
    let invaliddateerror = InvalidDateError()
    WriteLine(invaliddateerror.ToString())
    let invalidtimeerror = InvalidTimeError()
    WriteLine(invalidtimeerror.ToString())
    let overflowerror = OverflowError()
    WriteLine(overflowerror.ToString())
    let unavailable = default(EnvironmentError)
    WriteLine(unavailable.ToString())
    let message = "A domain error"
    WriteLine(message)
    WriteLine(message)
