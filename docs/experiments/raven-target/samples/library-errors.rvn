import System.*
import System.Console.*
// ABI regression: exercise case accessors and carrier reconstruction explicitly.
func Main() {
    let error0 = Storage.FileReadError(Storage.FileReadError.InvalidLimit())
    WriteLine(error0.ToString())
    let restored1 = Storage.FileReadError(error0.GetInvalidLimit())
    if restored1.IsInvalidLimit {
        WriteLine("Confirmed")
    }
    let error1 = Storage.FileReadError(Storage.FileReadError.InvalidPath())
    WriteLine(error1.ToString())
    let restored2 = Storage.FileReadError(error1.GetInvalidPath())
    if restored2.IsInvalidPath {
        WriteLine("Confirmed")
    }
    let error2 = Storage.FileReadError(Storage.FileReadError.NotFound())
    WriteLine(error2.ToString())
    let restored3 = Storage.FileReadError(error2.GetNotFound())
    if restored3.IsNotFound {
        WriteLine("Confirmed")
    }
    let error3 = Storage.FileReadError(Storage.FileReadError.AccessDenied())
    WriteLine(error3.ToString())
    let restored4 = Storage.FileReadError(error3.GetAccessDenied())
    if restored4.IsAccessDenied {
        WriteLine("Confirmed")
    }
    let error4 = Storage.FileReadError(Storage.FileReadError.NotRegularFile())
    WriteLine(error4.ToString())
    let restored5 = Storage.FileReadError(error4.GetNotRegularFile())
    if restored5.IsNotRegularFile {
        WriteLine("Confirmed")
    }
    let error5 = Storage.FileReadError(Storage.FileReadError.TooLarge())
    WriteLine(error5.ToString())
    let restored6 = Storage.FileReadError(error5.GetTooLarge())
    if restored6.IsTooLarge {
        WriteLine("Confirmed")
    }
    let error6 = Storage.FileReadError(Storage.FileReadError.ReadFailed())
    WriteLine(error6.ToString())
    let restored7 = Storage.FileReadError(error6.GetReadFailed())
    if restored7.IsReadFailed {
        WriteLine("Confirmed")
    }
    let error7 = Storage.FileReadError(Storage.FileReadError.InvalidUtf8())
    WriteLine(error7.ToString())
    let restored8 = Storage.FileReadError(error7.GetInvalidUtf8())
    if restored8.IsInvalidUtf8 {
        WriteLine("Confirmed")
    }
    let error8 = Storage.FileWriteError(Storage.FileWriteError.InvalidLimit())
    WriteLine(error8.ToString())
    let restored9 = Storage.FileWriteError(error8.GetInvalidLimit())
    if restored9.IsInvalidLimit {
        WriteLine("Confirmed")
    }
    let error9 = Storage.FileWriteError(Storage.FileWriteError.InvalidPath())
    WriteLine(error9.ToString())
    let restored10 = Storage.FileWriteError(error9.GetInvalidPath())
    if restored10.IsInvalidPath {
        WriteLine("Confirmed")
    }
    let error10 = Storage.FileWriteError(Storage.FileWriteError.NotFound())
    WriteLine(error10.ToString())
    let restored11 = Storage.FileWriteError(error10.GetNotFound())
    if restored11.IsNotFound {
        WriteLine("Confirmed")
    }
    let error11 = Storage.FileWriteError(Storage.FileWriteError.AccessDenied())
    WriteLine(error11.ToString())
    let restored12 = Storage.FileWriteError(error11.GetAccessDenied())
    if restored12.IsAccessDenied {
        WriteLine("Confirmed")
    }
    let error12 = Storage.FileWriteError(Storage.FileWriteError.NotRegularFile())
    WriteLine(error12.ToString())
    let restored13 = Storage.FileWriteError(error12.GetNotRegularFile())
    if restored13.IsNotRegularFile {
        WriteLine("Confirmed")
    }
    let error13 = Storage.FileWriteError(Storage.FileWriteError.TooLarge())
    WriteLine(error13.ToString())
    let restored14 = Storage.FileWriteError(error13.GetTooLarge())
    if restored14.IsTooLarge {
        WriteLine("Confirmed")
    }
    let error14 = Storage.FileWriteError(Storage.FileWriteError.WriteFailed())
    WriteLine(error14.ToString())
    let restored15 = Storage.FileWriteError(error14.GetWriteFailed())
    if restored15.IsWriteFailed {
        WriteLine("Confirmed")
    }
    let error15 = ConsoleReadError(ConsoleReadError.Unavailable())
    WriteLine(error15.ToString())
    let restored16 = ConsoleReadError(error15.GetUnavailable())
    if restored16.IsUnavailable {
        WriteLine("Confirmed")
    }
    let error16 = ConsoleReadError(ConsoleReadError.ReadFailed())
    WriteLine(error16.ToString())
    let restored17 = ConsoleReadError(error16.GetReadFailed())
    if restored17.IsReadFailed {
        WriteLine("Confirmed")
    }
    let error17 = Text.Utf8SliceError(Text.Utf8SliceError.OutOfRange())
    WriteLine(error17.ToString())
    let restored18 = Text.Utf8SliceError(error17.GetOutOfRange())
    if restored18.IsOutOfRange {
        WriteLine("Confirmed")
    }
    let error18 = Text.Utf8SliceError(Text.Utf8SliceError.InvalidBoundary())
    WriteLine(error18.ToString())
    let restored19 = Text.Utf8SliceError(error18.GetInvalidBoundary())
    if restored19.IsInvalidBoundary {
        WriteLine("Confirmed")
    }
    let error19 = Int32ParseError(Int32ParseError.InvalidFormat())
    WriteLine(error19.ToString())
    let restored20 = Int32ParseError(error19.GetInvalidFormat())
    if restored20.IsInvalidFormat {
        WriteLine("Confirmed")
    }
    let error20 = Int32ParseError(Int32ParseError.Overflow())
    WriteLine(error20.ToString())
    let restored21 = Int32ParseError(error20.GetOverflow())
