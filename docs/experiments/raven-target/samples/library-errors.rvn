    let restored14 = error13
    if restored14 is Storage.FileWriteError.TooLarge {
        WriteLine("Confirmed")
    }
    let error14 = Storage.FileWriteError.WriteFailed()
    WriteLine(error14.ToString())
    let restored15 = error14
    if restored15 is Storage.FileWriteError.WriteFailed {
        WriteLine("Confirmed")
    }
    let error15 = ConsoleReadError.Unavailable()
    WriteLine(error15.ToString())
    let restored16 = error15
    if restored16 is ConsoleReadError.Unavailable {
        WriteLine("Confirmed")
    }
    let error16 = ConsoleReadError.ReadFailed()
    WriteLine(error16.ToString())
    let restored17 = error16
    if restored17 is ConsoleReadError.ReadFailed {
        WriteLine("Confirmed")
    }
    let error17 = Text.Utf8SliceError.OutOfRange()
    WriteLine(error17.ToString())
    let restored18 = error17
    if restored18 is Text.Utf8SliceError.OutOfRange {
        WriteLine("Confirmed")
    }
    let error18 = Text.Utf8SliceError.InvalidBoundary()
    WriteLine(error18.ToString())
    let restored19 = error18
    if restored19 is Text.Utf8SliceError.InvalidBoundary {
