    let restored8 = error7
    if restored8 is Storage.FileReadError.InvalidUtf8 {
        WriteLine("Confirmed")
    }
    let error8 = Storage.FileWriteError.InvalidLimit()
    WriteLine(error8.ToString())
    let restored9 = error8
    if restored9 is Storage.FileWriteError.InvalidLimit {
        WriteLine("Confirmed")
    }
    let error9 = Storage.FileWriteError.InvalidPath()
    WriteLine(error9.ToString())
    let restored10 = error9
    if restored10 is Storage.FileWriteError.InvalidPath {
        WriteLine("Confirmed")
    }
    let error10 = Storage.FileWriteError.NotFound()
    WriteLine(error10.ToString())
    let restored11 = error10
    if restored11 is Storage.FileWriteError.NotFound {
        WriteLine("Confirmed")
    }
    let error11 = Storage.FileWriteError.AccessDenied()
    WriteLine(error11.ToString())
    let restored12 = error11
    if restored12 is Storage.FileWriteError.AccessDenied {
        WriteLine("Confirmed")
    }
    let error12 = Storage.FileWriteError.NotRegularFile()
