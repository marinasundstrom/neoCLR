import System.*
import System.Tasks.*
import System.Result.*
import System.Console.*

async func Read(input: Task<Result<int, string>>) -> Task<Result<int, string>> {
    let value = await input?
    return Ok(value + 1)
}

async func Print(input: Task<Result<int, string>>) -> Task<unit> {
    let result = await input
    match result {
        Ok(let value) => WriteLine(value)
        Error(let message) => WriteLine(message)
    }
    return ()
}

func Main() {
    let promise = Promise<Result<int, string>>()
    _ = Print(Read(promise.Task))
    promise.Complete(Error("Unavailable"))
}
