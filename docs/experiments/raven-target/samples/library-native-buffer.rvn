import System.*
import System.Console.*
import System.Runtime.InteropServices.*

// Signature/lifetime smoke test. Typed native access is demonstrated in direct IL
// until Raven's native integer and pointer conversions are supported by this target.
unsafe func Main() {
    let empty = NativeMemory.Alloc(default(nuint))
    NativeMemory.Free(empty)
    WriteLine("Native allocation released")
}
