import System.Introspection.*
import System.*
import System.Console.*
func Show(value: long) {
    WriteLine(value.CompareTo(42L))
}

func ShowType(value: TypeInfo) {
    WriteLine(value.DisplayName)
}

func Main() {
    let numbers: long[] = [42L, 0L]
    numbers[1] = 42L
    numbers.ForEach(Show)
    let bits: bool[] = [true, false]
    bits[1] = true
    if bits[0] && bits[1] {
        WriteLine("Boolean elements")
    }
    let types: TypeInfo[] = [typeof(int), typeof(string)]
    types.ForEach(ShowType)
    let comparisons: EquatableTo<int>[] = [42]
    if comparisons[0].Equals(42) {
        WriteLine(0)
    }
    let bytes: byte[] = [(byte)255]
    WriteLine((int)bytes[0])
    let shorts: ushort[] = [(ushort)65535]
    WriteLine((int)shorts[0])
    let chars: Character[] = ['é']
    WriteLine(chars[0].ToString())
    let nested: int[][] = [[42]]
    WriteLine(nested[0][0])
}
