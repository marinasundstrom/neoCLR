import System.*
import System.Tasks.*
import System.Result.*
import System.Console.*

async func Print(input: Task<Result<int, string>>) -> Task<unit> {
    let result = await input
    if let Ok(value) = result {
        WriteLine(value)
    } else if let Error(message) = result {
        WriteLine(message)
    }
}

async func Main() -> Task<unit> {
    let promise = Promise<Result<int, string>>()
    let printing = Print(promise.Task.MapResult(value => value + 1))
    promise.Complete(Ok(41))
    await printing
}
