import System.*
import System.Console.*
import System.Option.*
import System.Result.*

func Main() {
    var ok = Ok(42)
    let carrier: Result<int, string> = ok
    ok = Ok(7)
    WriteLine(ok.Value)
    match carrier {
        Ok(let value) => WriteLine(value)
        Error(_) => Fail("Expected success")
    }
    var some = Some("Before")
    some = Some("After")
    WriteLine(some.Value)
    var error = Error("Original error")
    error = Error("Updated error")
    WriteLine(error.Value)
}
