import System.*
import System.Console.*
func Main() {
    var ok = Result.Ok<int>(42)
    let carrier = Result<int, Error>(ok)
    ok.Value = 7
    WriteLine(ok.Value)
    match carrier {
        .Ok(let value) => WriteLine(value)
        .Error(_) => Fault("Expected success")
    }
    var some = Option.Some<string>("Before")
    some.Value = "After"
    WriteLine(some.Value)
    var error = Result.Error<string>("Original error")
    error.Value = "Updated error"
    WriteLine(error.Value)
}
