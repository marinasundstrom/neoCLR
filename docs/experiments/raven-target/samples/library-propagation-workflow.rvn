import System.Result.*
import System.Option.*
import System.*
import System.Console.*

func Find(found: int) -> Option<int> {
    if found == 1 {
        return Some(42)
    }
    return None()
}

func Read(found: int) -> Option<int> {
    let value = Find(found)?
    WriteLine("Value found")
    return Some(value)
}

func ShowProduct(found: int) {
    let result = Read(found)
    if result is .Some(let present) {
        WriteLine(present)
    } else if result is .None {
        WriteLine("Absent")
    }
}

func Complete(value: int) -> Result<System.Void, OverflowError> {
    let amount = Math.Abs(value)?
    WriteLine(amount)
    return Ok(())
}

func Save(value: int) -> Result<System.Void, OverflowError> {
    Complete(value)?
    WriteLine("Saved")
    return Ok(())
}

func ShowSave(value: int) {
    let result = Save(value)
    if result is .Ok(let done) {
        WriteLine("Completed")
    } else if result is .Error(let error) {
        WriteLine("Overflow")
    }
}

func Main() {
    let values = System.Collections.ArrayList<int>(2)
    values.Add(-42)
    values.Add(-2147483648)
    for value in values {
        ShowSave(value)
    }
    ShowProduct(1)
    ShowProduct(0)
}
