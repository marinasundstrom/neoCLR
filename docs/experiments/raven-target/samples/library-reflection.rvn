import System.*
import System.Console.*
import System.Reflection.*
func Show(value: bool) { if value { WriteLine("true") } else { WriteLine("false") } }
func Main() {
    let info = typeof(int)
    WriteLine(info.Name)
    WriteLine(info.FullName)
    WriteLine(info.Namespace)
    Show(info.Equals(TypeOf<int>.Of(42)))
    Show(info.IsArray)
    Show(info.IsByRef)
    Show(info.IsPointer)
    Show(info.IsReadOnly)
    Show(info.IsInterface)
    Show(info.IsAbstract)
    let methods = info.GetMethods()
    let method = methods[0]
    let first: MemberInfo = method
    WriteLine(first.Name)
    WriteLine(first.DeclaringType.Name)
    WriteLine(method.ReturnType.Name)
    Show(method.IsStatic)
    Show(method.IsPublic)
    Show(method.IsPrivate)
    Show(method.IsAssembly)
    Show(method.IsReceiverByRef)
    Show(method.IsReadOnly)
    Show(method.IsVirtual)
    Show(method.IsOverride)
    Show(method.IsAbstract)
    WriteLine(method.DefinitionIndex)
    let parameters = method.GetParameters()
    WriteLine(parameters[0].Name)
    WriteLine(parameters[0].Position)
    WriteLine(parameters[0].ParameterType.Name)
    Show(parameters[0].IsOut)
    Show(parameters[0].IsOutWhenTrue)
    Show(parameters[0].IsReadOnly)
    let property = typeof(Date).GetProperties()[0]
    let member: MemberInfo = property
    WriteLine(member.Name)
    WriteLine(property.PropertyType.Name)
    Show(property.IsStatic)
    Show(property.CanRead)
    Show(property.CanWrite)
    WriteLine(property.DefinitionIndex)
    WriteLine(property.GetIndexParameters().Length)
    let getter = property.GetGetMethod()
    if getter is Option.Some<MethodInfo> found { WriteLine(found.Value.Name) }
    Show(property.GetSetMethod().IsNone)
    Show(property.GetGetMethod(true).IsSome)
    Show(property.GetSetMethod(true).IsNone)
    let flags = BindingFlags.Public().Or(BindingFlags.Instance()).Or(BindingFlags.Static())
    WriteLine(flags.Value)
    Show(flags.HasFlag(BindingFlags.Public()))
    Show(flags.Equals(BindingFlags.FromValue(28)))
    WriteLine(flags.And(BindingFlags.Static()).Value)
    WriteLine(flags.Xor(BindingFlags.Static()).Value)
    WriteLine(flags.Not().Value)
    WriteLine(BindingFlags.Default().Value)
    WriteLine(BindingFlags.DeclaredOnly().Value)
    let fields = typeof(Date).GetFields(BindingFlags.NonPublic().Or(BindingFlags.Instance()))
    WriteLine(fields[0].Name)
    WriteLine(fields[0].FieldType.Name)
    WriteLine(fields[0].DefinitionIndex)
    Show(fields[0].IsPublic)
    Show(fields[0].IsPrivate)
    Show(fields[0].IsAssembly)
    Show(fields[0].IsStatic)
    WriteLine(typeof(int).GetFields().Length)
    WriteLine(typeof(int).GetMethods(flags).Length)
    WriteLine(typeof(Date).GetProperties(flags).Length)
    let generic = typeof(Option<int>)
    WriteLine(generic.GenericArgumentCount)
    WriteLine(generic.GetGenericArgument(0).Name)
    WriteLine(generic.GetGenericArguments()[0].Name)
    WriteLine(generic.GetInterfaces().Length)
    Show(typeof(FieldInfo).BaseType.IsSome)
    Show(info.GetElementType().IsNone)
    let array = typeof(int[])
    Show(array.IsArray)
    if array.GetElementType() is Option.Some<Type> element { WriteLine(element.Value.Name) }
    let enumeration = typeof(BindingFlags)
    Show(enumeration.IsEnum)
    WriteLine(enumeration.GetEnumNames()[0])
    WriteLine(enumeration.GetEnumUnderlyingType().Name)
}
