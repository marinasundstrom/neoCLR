import System.Option.*
import System.*
import System.Console.*
import System.Introspection.*

// All concrete member descriptors share these descriptive readers.
func ShowMemberName(member: MemberInfo) {
    WriteLine(member.Name)
}

func Show(value: bool) {
    if value {
        WriteLine("true")
    } else {
        WriteLine("false")
    }
}

func Main() {
    let info = (NominalTypeInfo)typeof(int)
    WriteLine(info.Name)
    WriteLine(info.FullName)
    WriteLine(info.Namespace)
    Show(info.Equals(other: typeof(int)))
    Show(info.IsValueType)
    Show(typeof(string).IsValueType)
    Show(typeof(TypeInfo).IsValueType)
    Show(typeof(int[]).IsValueType)
    Show(typeof(BindingFlags).IsValueType)
    Show(info.IsArray)
    Show(info.IsByRef)
    Show(info.IsPointer)
    Show(info.IsReadOnly)
    Show(info.IsInterface)
    Show(info.IsAbstract)
    let methods = info.GetMethods()
    let method = methods[0]
    let first: MemberInfo = method
    ShowMemberName(first)
    match first.DeclaringType {
        .Some(let owner) => WriteLine(owner.DisplayName)
        .None => Fail("Expected a declaring type")
    }
    WriteLine(method.ReturnType.DisplayName)
    Show(method.IsStatic)
    Show(method.IsPublic)
    Show(method.IsPrivate)
    Show(method.IsAssembly)
    Show(method.IsReceiverByRef)
    Show(method.IsReadOnly)
    Show(method.IsVirtual)
    Show(method.IsOverride)
    Show(method.IsAbstract)
    Show(method.DefinitionIndex is Some(let index) && index >= 0)
    let parameters = method.GetParameters()
    WriteLine(parameters[0].Name)
    WriteLine(parameters[0].Position)
    WriteLine(parameters[0].ParameterType.DisplayName)
    Show(parameters[0].IsOut)
    Show(parameters[0].IsOutWhenTrue)
    Show(parameters[0].IsReadOnly)
    let property = typeof(Date).GetProperties()[0]
    let member: MemberInfo = property
    ShowMemberName(member)
    WriteLine(property.PropertyType.DisplayName)
    Show(property.IsStatic)
    Show(property.CanRead)
    Show(property.CanWrite)
    WriteLine(property.DefinitionIndex)
    WriteLine(property.GetIndexParameters().Count)
    let getter = property.GetGetMethod()
    if getter is .Some(let found) {
        WriteLine(found.Name)
    }
    Show(property.GetSetMethod() is .None)
    Show(property.GetGetMethod(true) is .Some(_))
    Show(property.GetSetMethod(true) is .None)
    let flags = BindingFlags.Public | BindingFlags.Instance | BindingFlags.Static
    WriteLine((int)flags)
    Show((flags & BindingFlags.Public) == BindingFlags.Public)
    Show(flags == (BindingFlags)28)
    WriteLine((int)(flags & BindingFlags.Static))
    WriteLine((int)(flags ^ BindingFlags.Static))
    WriteLine(~(int)flags)
    WriteLine((int)BindingFlags.Default)
    WriteLine((int)BindingFlags.DeclaredOnly)
    let fields = typeof(Date).GetFields(flags: BindingFlags.NonPublic | BindingFlags.Instance)
    ShowMemberName(fields[0])
    WriteLine(fields[0].FieldType.DisplayName)
    WriteLine(fields[0].DefinitionIndex)
    Show(fields[0].IsPublic)
    Show(fields[0].IsPrivate)
    Show(fields[0].IsAssembly)
    Show(fields[0].IsStatic)
    WriteLine(typeof(int).GetFields().Count)
    Show(typeof(int).GetMethods(flags: flags).Count >= 5)
    WriteLine(typeof(Date).GetProperties(flags: flags).Count)
    let generic = typeof(Option<int>)
    WriteLine(generic.GenericArgumentCount)
    WriteLine(generic.GetGenericArgument(index: 0).DisplayName)
    WriteLine(generic.GetGenericArguments()[0].DisplayName)
    Show(generic.GetInterfaces().Count >= 1)
    Show(typeof(FieldInfo).BaseType is .None)
    Show(info.GetElementType() is .None)
    let array = typeof(int[])
    Show(array.IsArray)
    if array.GetElementType() is .Some(let element) {
        WriteLine(element.DisplayName)
    }
    let enumeration = typeof(BindingFlags)
    Show(enumeration.IsEnum)
    WriteLine(enumeration.GetEnumNames()[0])
    WriteLine(enumeration.GetEnumUnderlyingType().DisplayName)
}
