import System.*
import System.Console.*

func Main() {
    for member in typeof(int).GetMethods() {
        WriteLine(member.Name)
    }

    let empty: int[] = Array<int>.Empty
    for value in empty {
        WriteLine("Unexpected empty-array element")
    }

    let singleton: int[] = [42]
    singleton.ForEach(value => WriteLine(value))

    let values: int[] = [1, 2, 3]
    values.ForEach(value => WriteLine(value))
}
