import System.*
import System.Collections.*
import System.IO.*
import System.Console.*

class Order {
    var Id: int
    var Name: string
    var Status: string
    init(id: int, name: string) {
        Id = id
        Name = name
        Status = "Queued"
    }
}

interface OrderStore {
    func Add(order: Order)
    func Find(id: int) -> Option<Order>
    func Save(order: Order, limit: int) -> Result<System.Void, FileWriteError>
}

class FileOrderStore : OrderStore {
    var orders: ArrayList<Order>
    init() {
        orders = ArrayList<Order>()
    }
    func Add(order: Order) {
        orders.Add(order)
    }
    func Find(id: int) -> Option<Order> {
        for order in orders {
            if order.Id == id {
                return Option<Order>(Option.Some<Order>(order))
            }
        }
        return Option<Order>(Option.None())
    }
    func Save(order: Order, limit: int) -> Result<System.Void, FileWriteError> {
        File.WriteAllText("neoclr-orders.txt", String.Concat("Order: ", order.Name), limit)?
        order.Status = "Saved"
        return Result<System.Void, FileWriteError>(Result.Ok<System.Void>(()))
    }
}

func Process(store: OrderStore, id: int, limit: int) {
    let found = store.Find(id)
    if found is Option.Some<Order> present {
        let order = present.Value
        match store.Save(order, limit) {
            Result.Ok<System.Void> done => WriteLine(order.Status)
            Result.Error<FileWriteError> failure => {
                if failure.Value.IsTooLarge {
                    WriteLine("Order report exceeds limit")
                }
                else {
                    WriteLine("Order report could not be written")
                }
            }
        }
    } else {
        WriteLine("Order not found")
    }
}

func Main() {
    let store: OrderStore = FileOrderStore()
    let first = Order(7, "Coffee")
    let second = Order(8, "Tea")
    store.Add(first)
    store.Add(second)
    Process(store, 7, 64)
    Process(store, 8, 2)
    Process(store, 99, 64)
    WriteLine(first.Status)
    WriteLine(second.Status)
    match File.ReadAllText("neoclr-orders.txt", 64) {
        Result.Ok<string> text => WriteLine(text.Value)
        Result.Error<FileReadError> error => WriteLine("Order report could not be read")
    }
}
