import System.*
import System.Collections.*
import System.Linq.*
import System.IO.*
import System.Console.*
import System.Result.*
import System.Option.*

class Order {
    var Id: int
    var Name: string
    var Status: string
    init(id: int, name: string) {
        Id = id
        Name = name
        Status = "Queued"
    }
}

interface OrderStore {
    func Add(order: Order)
    func Find(id: int) -> Option<Order>
    func Pending() -> Iterable<Order>
    func Save(order: Order, limit: int) -> Result<System.Void, FileWriteError>
}

class FileOrderStore : OrderStore {
    var orders: ArrayList<Order>
    init() {
        orders = ArrayList<Order>()
    }
    func Add(order: Order) {
        orders.Add(order)
    }
    func Pending() -> Iterable<Order> {
        return orders.Where((order: Order) -> bool => order.Status.Equals("Queued"))
    }
    func Find(id: int) -> Option<Order> {
        for order in orders {
            if order.Id == id {
                return Some(order)
            }
        }
        return None()
    }
    func Save(order: Order, limit: int) -> Result<System.Void, FileWriteError> {
        File.WriteAllText("neoclr-orders.txt", String.Concat("Order: ", order.Name), limit)?
        order.Status = "Saved"
        return Ok(())
    }
}

func Process(store: OrderStore, id: int, limit: int) {
    let found = store.Find(id)
    if found is Some(let order) {
        match store.Save(order, limit) {
            .Ok => WriteLine(order.Status)
            .Error(let failure) => {
                if failure.IsTooLarge {
                    WriteLine("Order report exceeds limit")
                } else {
                    WriteLine("Order report could not be written")
                }
            }
        }
    } else {
        WriteLine("Order not found")
    }
}

func Main() {
    let store: OrderStore = FileOrderStore()
    let first = Order(7, "Coffee")
    let second = Order(8, "Tea")
    store.Add(first)
    store.Add(second)
    let pending = store.Pending()
    Process(store, 7, 64)
    Process(store, 8, 2)
    Process(store, 99, 64)
    WriteLine(first.Status)
    WriteLine(second.Status)
    match File.ReadAllText("neoclr-orders.txt", 64) {
        Ok(let text) => WriteLine(text)
        Error(let error) => WriteLine("Order report could not be read")
    }
    let pendingNames = pending.Select((order: Order) -> string => order.Name).ToList()
    WriteLine("Pending orders")
    for name in pendingNames {
        WriteLine(name)
    }
}
