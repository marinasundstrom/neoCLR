import System.*
import System.Console.*

func Find(found: int) -> Option<string> {
    if found == 1 { return Option<string>(Option.Some<string>("Found")) }
    return Option<string>(Option.None())
}
func Forward(found: int) -> Option<string> {
    let value = Find(found)?
    return Option<string>(Option.Some<string>(value))
}
func Main() {
    let ok = Result<long, Error>.Ok(42L)
    if ok.IsOk { WriteLine("Ok") }
    if ok.IsOkCase { WriteLine(ok.GetOkCase().Value.CompareTo(42L)) }
    let error = Result<long, Error>.Error(Error.FromMessage("Failure"))
    if error.IsErr { WriteLine("Error") }
    if error.IsErrorCase { WriteLine(error.GetErrorCase().Value.Message) }
    var extracted = default(Result.Ok<long>)
    if ok.TryGet(&extracted) { WriteLine(extracted.Value.CompareTo(42L)) }
    var residual = Error.FromMessage("Unchanged")
    if error.TryGetResidual(&residual) {
        let restored = Result<long, Error>.FromResidual(residual)
        WriteLine(restored.GetErrorCase().Value.Message)
    }
    let some = Forward(1)
    if some.IsSome { WriteLine(some.GetSomeCase().Value) }
    let none = Forward(0)
    if none.IsNone {
        let restored = Option<string>(none.GetNoneCase())
        if restored.IsNone { WriteLine("None") }
    }
    let nested = Option<Result<long, Error>>(Option.Some<Result<long, Error>>(ok))
    if nested is Option.Some<Result<long, Error>> present {
        WriteLine(present.Value.GetOkCase().Value.CompareTo(42L))
    }
}
