import System.Option.*
import System.Result.*
import System.*
import System.Console.*

func Find(found: int) -> Option<string> {
    if found == 1 {
        return Some("Found")
    }
    return None()
}

func Forward(found: int) -> Option<string> {
    let value = Find(found)?
    return Some(value)
}

func Main() {
    let ok: Result<long, string> = Ok(42L)
    if ok.IsOk {
        WriteLine("Ok")
    }
    if ok is Ok(let number) {
        WriteLine(number.CompareTo(42L))
    }
    let error: Result<long, string> = Error("Failure")
    if error.IsErr {
        WriteLine("Error")
    }
    if error is Error(let failure) {
        WriteLine(failure)
    }
    if ok is Ok(let extracted) {
        WriteLine(extracted.CompareTo(42L))
    }
    if error is Error(let residual) {
        let restored: Result<long, string> = Error(residual)
        if restored is Error(let restoredFailure) {
            WriteLine(restoredFailure)
        }
    }
    let some = Forward(1)
    if some is Some(let text) {
        WriteLine(text)
    }
    let none = Forward(0)
    if none.IsNone {
        let restored: Option<string> = None()
        if restored.IsNone {
            WriteLine("None")
        }
    }
    let nested: Option<Result<long, string>> = Some(ok)
    if nested is Some(Ok(let nestedNumber)) {
        WriteLine(nestedNumber.CompareTo(42L))
    }
}
