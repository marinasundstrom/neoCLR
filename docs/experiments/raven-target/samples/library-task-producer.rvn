import System.*
import System.Tasks.*
import System.Console.*

async func Print(task: Task<int>) -> Task<unit> {
    let value = await task
    WriteLine(value)
}

async func Main() -> Task<unit> {
    let promise = Promise<int>()
    let answer = promise.Task.Map(value => value + 1)
    let printing = Print(answer)
    promise.Complete(41)
    await printing
}
