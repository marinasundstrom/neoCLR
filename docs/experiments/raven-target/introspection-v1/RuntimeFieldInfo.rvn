namespace System.Runtime

import System.Introspection.*

// Only field acquisition is adapted in this probe. No new FieldInfo contract yet.
internal class RuntimeFieldInfo : MemberInfo {
    private field runtimeField: FieldInfo

    init(descriptor: FieldInfo) {
        runtimeField = descriptor
    }

    val Name: string { get => runtimeField.Name }
    val DeclaringType: TypeInfo {
        get => RuntimeTypeInfo(runtimeField.DeclaringType)
    }
}
