namespace System.Runtime

import System.Introspection.*

// Snapshot values come from the runtime adapter, never from a public legacy type.
internal class RuntimeFieldInfo : FieldInfo {
    private field storedName: string
    private field declaringType: TypeInfo
    private field fieldType: TypeInfo
    private field isPublic: bool
    private field isPrivate: bool
    private field isStatic: bool

    init(name: string, declaring: TypeInfo, type: TypeInfo,
         publicField: bool, privateField: bool, staticField: bool) {
        storedName = name
        declaringType = declaring
        fieldType = type
        isPublic = publicField
        isPrivate = privateField
        isStatic = staticField
    }

    val Name: string { get => storedName }
    val DeclaringType: TypeInfo { get => declaringType }
    val Type: TypeInfo { get => fieldType }
    val IsPublic: bool { get => isPublic }
    val IsPrivate: bool { get => isPrivate }
    val IsStatic: bool { get => isStatic }
}
