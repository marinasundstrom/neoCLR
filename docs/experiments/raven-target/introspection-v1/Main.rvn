import System.*
import System.Console.*
import System.Introspection.*
import System.Runtime.*

// Consumers depend only on the descriptive contract, not the backing class.
func Describe(type: TypeInfo) {
    WriteLine(type.Name)
    WriteLine(type.Namespace)
}

func DescribeMember(member: MemberInfo) {
    WriteLine(member.Name)
    Describe(member.DeclaringType)
}

func Main() {
    let integer: TypeInfo = RuntimeTypeInfo(typeof(int))
    let text: TypeInfo = RuntimeTypeInfo(typeof(string))
    Describe(integer)
    Describe(text)

    // Legacy acquisition is explicit until RuntimeContext discovery is implemented.
    let descriptor = typeof(Date).Info.GetFields(flags: BindingFlags.NonPublic | BindingFlags.Instance)[0]
    let member: MemberInfo = RuntimeFieldInfo(descriptor)
    DescribeMember(member)
}
