import System.*
import System.Console.*
import System.Introspection.*
import System.Runtime.*

// Consumers depend only on the descriptive contract, not the backing class.
func Describe(type: TypeInfo) {
    WriteLine(type.Name)
    WriteLine(type.Namespace)
}

func DescribeMember(member: MemberInfo) {
    WriteLine(member.Name)
    Describe(member.DeclaringType)
}

func CountFields(type: TypeInfo, flags: BindingFlags) -> int {
    var count = 0
    for descriptor in type.GetFields(flags: flags) {
        count += 1
    }
    return count
}

func Main() {
    let integer: TypeInfo = RuntimeTypeInfo(typeof(int))
    let text: TypeInfo = RuntimeTypeInfo(typeof(string))
    Describe(integer)
    Describe(text)

    // Legacy acquisition is explicit until RuntimeContext discovery is implemented.
    let date: TypeInfo = RuntimeTypeInfo(typeof(Date))
    for descriptor in date.GetFields(flags: BindingFlags.NonPublic | BindingFlags.Instance) {
        DescribeMember(descriptor)
        Describe(descriptor.Type)
        if descriptor.IsPrivate && !descriptor.IsPublic && !descriptor.IsStatic {
            WriteLine("Private instance field")
        }
    }
    WriteLine(CountFields(date, BindingFlags.Public | BindingFlags.Instance))
    WriteLine(CountFields(date, BindingFlags.NonPublic | BindingFlags.Static))
    WriteLine(CountFields(date, BindingFlags.NonPublic | BindingFlags.Instance | BindingFlags.DeclaredOnly))
}
