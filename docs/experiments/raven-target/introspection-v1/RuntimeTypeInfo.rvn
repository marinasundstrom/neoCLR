namespace System.Runtime

import System.*
import System.Collections.*
import System.Introspection.*

// Transitional adapter: the legacy runtime identity stays behind the interface.
// RuntimeContext discovery and unified type identity are separate migration steps.
internal class RuntimeTypeInfo : TypeInfo {
    private field runtimeType: Type

    init(type: Type) {
        runtimeType = type
    }

    val Name: string { get => runtimeType.Name }
    val Namespace: string { get => runtimeType.Namespace }

    func GetFields(flags: BindingFlags) -> Iterable<FieldInfo> {
        let fields = ArrayList<FieldInfo>()
        for descriptor in runtimeType.Info.GetFields(flags: flags) {
            let fieldInfo: FieldInfo = RuntimeFieldInfo(
                descriptor.Name,
                RuntimeTypeInfo(descriptor.DeclaringType),
                RuntimeTypeInfo(descriptor.FieldType),
                descriptor.IsPublic,
                descriptor.IsPrivate,
                descriptor.IsStatic)
            fields.Add(fieldInfo)
        }
        return fields
    }
}
