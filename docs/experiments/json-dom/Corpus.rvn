import System.*
import System.Data.Json.*
import System.Result.*

func RoundTrip(text: string) -> Result<string, JsonError> {
    let value = JsonSerializer.Deserialize(text)?
    return JsonSerializer.Serialize(value)
}

func Integer(text: string) -> Result<string, JsonError> {
    let value = JsonSerializer.Deserialize(text)?
    if value is JsonNumber number {
        let integer = number.AsInt32()?
        return Ok(integer.ToString())
    }
    return Error(JsonError.TypeMismatch("number"))
}

func Main(arguments: string[]) {
    for index in 1..<arguments.Length {
        let result = if arguments[0] == "integer" {
            Integer(arguments[index])
        } else {
            RoundTrip(arguments[index])
        }
        match result {
            Ok(let text) => Console.WriteLine(text)
            Error(_) => Console.WriteLine("ERROR")
        }
    }
}
