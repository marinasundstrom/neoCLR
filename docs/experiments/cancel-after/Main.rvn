module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedCancelAfterTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main() -> Task<int> {
    // Async discovery is unavailable; preserve the four sequential lifecycle awaits.
    let suite = TestSuite()
    let reset = CompletedCancelAfterTest(await `reset countdown and deferred zero`())
    suite.Add("cancel-after-reset", "reset countdown and deferred zero", reset.Invoke)
    let disable = CompletedCancelAfterTest(await `disable and reenable countdown`())
    suite.Add("cancel-after-disable", "disable and reenable countdown", disable.Invoke)
    let disposePending = CompletedCancelAfterTest(await `disposal suppresses timed cancellation`())
    suite.Add("cancel-after-disposePending", "disposal suppresses timed cancellation", disposePending.Invoke)
    let cancelEarly = CompletedCancelAfterTest(await `manual cancellation removes countdown`())
    suite.Add("cancel-after-cancelEarly", "manual cancellation removes countdown", cancelEarly.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
