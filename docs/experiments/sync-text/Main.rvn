import System.*
import System.Optional.*
import System.Result.*
import System.IO.*
import System.Text.*
import System.Collections.*
import System.Concurrency.*
import System.Concurrency.Tasks.*

class FragmentedInput : SyncInputStream {
    private val text: string
    private val chunk: int
    private var offset: int = 0
    private var reads: int = 0

    init(text: string, chunk: int) {
        self.text = text
        self.chunk = chunk
    }

    val Reads: int => reads

    func Read(buffer: Slice<byte>) -> Result<int, StreamError> {
        let count = buffer.Length
        reads += 1
        var copied = 0
        while copied < count && copied < chunk && offset < text.Utf8Bytes.Length {
            buffer[copied] = text.Utf8Bytes[offset]
            copied += 1
            offset += 1
        }
        let result: Result<int, StreamError> = Ok(copied)
        return result
    }

    func Close() { }
}

func Check(condition: bool, message: string) {
    if !condition {
        Panic(message)
    }
}

func Text(result: Result<string, TextReadError>, expected: string) {
    match result {
        Ok(let value) => Check(String.CompareOrdinal(value, expected) == 0, "Text bytes")
        Failure(let error) => Panic("Unexpected text error: " + error.ToString())
    }
}

func Character(result: Result<Optional<char>, TextReadError>, expected: string) {
    match result {
        Ok(Some(let value)) => Check(String.CompareOrdinal(value.ToString(), expected) == 0, "Grapheme bytes")
        _ => Panic("Expected character")
    }
}

func End(result: Result<Optional<char>, TextReadError>) {
    match result {
        Ok(None) => { }
        _ => Panic("Expected character EOF")
    }
}

func Main() {
    for chunk in [1, 2, 7, 256] {
        let input = FragmentedInput("é👩‍💻🇸🇪\r\nnext\nlast", chunk)
        let Ok(reader) = SyncStreamReader.Create(input) else {
            Panic("Unable to create text wrapper")
        }
        Character(reader.PeekChar(), "é")
        let reads = input.Reads
        Character(reader.PeekChar(), "é")
        Check(input.Reads == reads, "Repeated peek performed input")
        Character(reader.ReadChar(), "é")
        Text(reader.Read(2), "👩‍💻🇸🇪")
        Character(reader.PeekChar(), "\r\n")
        reader.NewLine = "\r\n"
        match reader.ReadLine(100) {
            Ok(Some(let line)) => Check(line.IsEmpty, "Peek before empty line")
            _ => Panic("Expected empty line")
        }
        reader.NewLine = "\n"
        Character(reader.ReadChar(), "n")
        match reader.ReadLine(100) {
            Ok(Some(let line)) => Check(line == "ext", "Mixed character and line cursor")
            _ => Panic("Expected remaining line")
        }
        Text(reader.Read(20), "last")
        End(reader.PeekChar())
        End(reader.ReadChar())
        Text(reader.Read(4), "")
        Text(reader.ReadToEnd(100), "")
        reader.Close()
        match reader.PeekChar() {
            Failure(TextReadError.Closed) => { }
            _ => Panic("Closed peek")
        }
    }

    let limitedInput = FragmentedInput("éx", 256)
    let Ok(limited) = SyncStreamReader.Create(limitedInput) else {
        Panic("Unable to create text wrapper")
    }
    Text(limited.Read(0, 0), "")
    Check(limitedInput.Reads == 0, "Zero read consumed input")
    match limited.Read(-1) {
        Failure(TextReadError.InvalidRange) => { }
        _ => Panic("Invalid count")
    }
    Check(limitedInput.Reads == 0, "Invalid read consumed input")
    match limited.Read(1, 1) {
        Failure(TextReadError.LimitExceeded) => { }
        _ => Panic("Expected byte limit")
    }
    Character(limited.PeekChar(), "é")
    Text(limited.Read(1, 2), "é")
    Text(limited.ReadToEnd(2), "x")

    for ending in ["\n", "\r\n", "\r", "END", "abab", "💥"] {
        let input = FragmentedInput("a" + ending + "b" + ending, 1)
        let Ok(lines) = SyncStreamReader.Create(input) else {
            Panic("Delimiter reader")
        }
        let textReader: SyncTextReader = lines
        textReader.NewLine = ending
        Check(textReader.NewLine == ending, "Interface newline property")
        Check(lines.ReadLine(1) is Ok(Some("a")), "First configured line")
        Check(lines.ReadLine(1) is Ok(Some("b")), "Second configured line")
        Check(lines.ReadLine(0) is Ok(None), "Delimiter EOF")
    }
    let exactInput = FragmentedInput("xéyéz", 1)
    let Ok(exact) = SyncStreamReader.Create(exactInput) else {
        Panic("Exact delimiter reader")
    }
    exact.NewLine = "é"
    Check(exact.ReadLine(4) is Ok(Some("xéy")), "Delimiter must compare UTF-8 ordinally")
    Check(exact.ReadLine(1) is Ok(Some("z")), "Delimiter tail")

    let invalidInput = FragmentedInput("aaabtail", 1)
    let Ok(overlap) = SyncStreamReader.Create(invalidInput) else {
        Panic("Overlap reader")
    }
    overlap.NewLine = ""
    Check(overlap.ReadLine(8) is Failure(TextReadError.InvalidRange), "Empty delimiter")
    Check(invalidInput.Reads == 0, "Invalid delimiter consumed input")
    overlap.NewLine = "aab"
    Check(overlap.ReadLine(1) is Ok(Some("a")), "Overlapping delimiter prefixes")
    overlap.NewLine = "il"
    Check(overlap.ReadLine(2) is Ok(Some("ta")), "Changed delimiter")

    let Ok(prefixReader) = SyncStreamReader.Create(FragmentedInput("xEN", 1)) else {
        Panic("Partial delimiter reader")
    }
    prefixReader.NewLine = "END"
    Check(prefixReader.ReadLine(3) is Ok(Some("xEN")), "Partial delimiter at EOF")
    let Ok(lfReader) = SyncStreamReader.Create(FragmentedInput("x\r\n", 1)) else {
        Panic("LF reader")
    }
    Check(lfReader.ReadLine(2) is Ok(Some("x\r")), "LF must preserve CR")

    let newlineOutput = MemoryStream()
    let Ok(createdWriter) = SyncStreamWriter.Create(newlineOutput, true) else {
        Panic("Newline writer")
    }
    let textWriter: SyncTextWriter = createdWriter
    textWriter.NewLine = "\r\n"
    Check(textWriter.WriteLine("x") is Ok(3), "CRLF writer bytes")
    textWriter.NewLine = "💥"
    Check(textWriter.WriteLine("") is Ok(4), "Unicode writer delimiter")
    textWriter.NewLine = ""
    Check(textWriter.WriteLine("y") is Ok(1), "Empty writer delimiter")
    Check(textWriter.Finish() is Ok(0), "Newline finish")
    textWriter.Close()
    Check(newlineOutput.Seek(0) is Ok(0), "Newline seek")
    let Ok(newlineReader) = SyncStreamReader.Create(newlineOutput) else {
        Panic("Newline output reader")
    }
    Text(newlineReader.ReadToEnd(20), "x\r\n💥y")

    let memory = MemoryStream()
    let Ok(writer) = SyncStreamWriter.Create(memory, true) else {
        Panic("Writer creation")
    }
    Check(writer.Write("é") is Ok(2), "UTF-8 write count")
    Check(writer.WriteLine("x") is Ok(2), "WriteLine count")
    Check(writer.Flush() is Ok(_), "Flush")
    Check(writer.Write("tail") is Ok(4), "Flush finalized encoder")
    Check(writer.Finish() is Ok(0), "Finish")
    Check(writer.Finish() is Ok(0), "Repeat finish")
    Check(writer.Write("bad") is Failure(StreamError.InvalidEncoding), "Write after finish")
    writer.Close()
    Check(writer.Flush() is Failure(StreamError.Closed), "Closed writer")
    Check(memory.Seek(0) is Ok(0), "leaveOpen")
    let Ok(roundtrip) = SyncStreamReader.Create(memory) else {
        Panic("Roundtrip reader creation")
    }
    Text(roundtrip.ReadToEnd(100), "éx\ntail")
    roundtrip.Close()
    Check(memory.GetLength() is Failure(StreamError.Closed), "Reader owns input")

    let ascii = MemoryStream()
    let Ok(asciiWriter) = SyncStreamWriter.Create(ascii, Encodings.Ascii) else {
        Panic("ASCII writer creation")
    }
    Check(ascii.GetLength() is Ok(0), "Creation wrote bytes")
    Check(asciiWriter.Write("é") is Failure(StreamError.InvalidEncoding), "ASCII rejection")
    asciiWriter.Close()
    Check(ascii.GetLength() is Failure(StreamError.Closed), "Writer owns output")
    Console.Write("PASS sync text wrappers\n")
}
