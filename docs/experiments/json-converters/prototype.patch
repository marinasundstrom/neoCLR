+/// <summary>Typed case registration for explicit union contracts.</summary>
+public extension JsonUnionCaseExtensions<T> for JsonUnionConverter<T> {
+    /// <summary>Registers a payload type, its JSON shape and typed union adapters.</summary>
+    /// <param name="kind">The JSON shape accepted and produced by this case.</param>
+    /// <param name="create">Constructs the union from its payload.</param>
+    /// <param name="extract">Returns Some(payload) for this case and None otherwise.</param>
+    /// <remarks>Configure before first use; later registration or invalid kinds cause a terminal Fault. Two cases with the same shape make that shape ambiguous on read. Payload conversion uses the active serializer's converter snapshot.</remarks>
+    func AddCase<TCase>(kind: JsonUnionCaseKind, create: (TCase) -> T, extract: (T) -> Option<TCase>) {
+        let kindValue = (int)kind
+        if kindValue < 1 {
+            System.Fail("Invalid JSON union case kind")
+        }
+        if kindValue > 5 {
+            System.Fail("Invalid JSON union case kind")
+        }
+        self.AddRegisteredCase(TypedJsonUnionCase<T, TCase>(kindValue, create, extract))
+    }
+
+}
+
+internal interface JsonUnionCase<T> {
+    val Kind: int { get }
+    func Extract(value: T) -> Option<Object>
+    func Read(value: JsonValue, state: JsonConverterState) -> Result<T, JsonError>
+    func Write(value: Object, state: JsonConverterState) -> Result<JsonValue, JsonError>
+}
+
+internal class TypedJsonUnionCase<T, TCase> : JsonUnionCase<T> {
+    // Same generic callback-storage compiler constraint as TypedJsonConverter.
+    private field kind: int
+    private field create: (TCase) -> T
+    private field extract: (T) -> Option<TCase>
+
+    init(kind: int, create: (TCase) -> T, extract: (T) -> Option<TCase>) {
+        self.kind = kind
+        self.create = create
+        self.extract = extract
+    }
+
+    val Kind: int => kind
+
+    func Extract(value: T) -> Option<Object> {
+        if extract(value) is Some(let payload) {
+            return Some(payload)
+        }
+        return None
+    }
+
+    func Read(value: JsonValue, state: JsonConverterState) -> Result<T, JsonError> {
+        let payload = ObjectMapper.Read(value, typeof(TCase), state)?
+        return Ok(create((TCase)payload))
+    }
+
+    func Write(value: Object, state: JsonConverterState) -> Result<JsonValue, JsonError> {
+        return ObjectMapper.WriteDeclared(value, typeof(TCase), state)
+    }
+}
+
+internal class JsonUnionShapes {
+    private init() { }
+
+    static func Kind(value: JsonValue) -> int {
+        if value is JsonString {
+            return 1
+        }
+        if value is JsonNumber {
+            return 2
+        }
+        if value is JsonBoolean {
+            return 3
+        }
+        if value is JsonArray {
+            return 4
+        }
+        if value is JsonObject {
+            return 5
+        }
+        return 0
+    }
+}
