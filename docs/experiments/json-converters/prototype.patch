+module System.Data.Json
+
+import System.*
+import System.Introspection.*
+import System.Result.*
+
+/// <summary>Converts a complete JSON node to and from a typed value.</summary>
+/// <remarks>Register with JsonSerializerOptions.Converters.Add. Callbacks receive explicit JsonNull nodes; return an error to reject null or invalid content. Callbacks run once per converted occurrence and may have user effects. This is a DOM contract, not a streaming reader or writer.</remarks>
+public interface JsonConverter<T> {
+    /// <summary>Reads a typed value from a complete node, including explicit JsonNull.</summary>
+    /// <param name="value">The parsed node for this occurrence.</param>
+    /// <returns>The converted value or a JSON error.</returns>
+    func Read(value: JsonValue) -> Result<T, JsonError>
+
+    /// <summary>Converts a typed value into a JSON node.</summary>
+    /// <param name="value">The value to represent.</param>
+    /// <returns>A node or a JSON error. The complete output document is checked for size, depth and cycles before stream output.</returns>
+    func Write(value: T) -> Result<JsonValue, JsonError>
+}
+
+internal interface JsonConverterRegistration {
+    func GetTargetType() -> TypeInfo
+    func ReadObject(value: JsonValue, state: JsonConverterState) -> Result<Object, JsonError>
+    func WriteObject(value: Object, state: JsonConverterState) -> Result<JsonValue, JsonError>
+}
+
+internal class TypedJsonConverter<T> : JsonConverterRegistration {
+    // Temporary compiler constraint: generic constructor assignment requires explicit storage.
+    private field converter: JsonConverter<T>
+
+    init(converter: JsonConverter<T>) {
+        self.converter = converter
+    }
+
+    func GetTargetType() -> TypeInfo {
+        return typeof(T)
+    }
+
+    func ReadObject(value: JsonValue, state: JsonConverterState) -> Result<Object, JsonError> {
+        if converter is JsonUnionConverter<T> unionConverter {
+            let convertedUnion = unionConverter.ReadCore(value, state)?
+            return Ok(convertedUnion)
+        }
+        let converted = converter.Read(value)?
+        return Ok(converted)
+    }
+
+    func WriteObject(value: Object, state: JsonConverterState) -> Result<JsonValue, JsonError> {
+        if converter is JsonUnionConverter<T> unionConverter {
+            return unionConverter.WriteCore((T)value, state)
+        }
+        return converter.Write((T)value)
+    }
+}
