+module System.Data.Json
+
+import System.*
+import System.Collections.*
+import System.Introspection.*
+import System.Option.*
+import System.Result.*
+
+/// <summary>Configures explicitly registered JSON converters.</summary>
+/// <remarks>Each serialization operation snapshots registrations before reading or mapping. The first exact-type registration wins. Instances and callback state remain shared; concurrent mutation is not supported.</remarks>
+public class JsonSerializerOptions {
+    private val converters = JsonConverterCollection()
+
+    init() { }
+
+    /// <summary>Gets the ordered converter registrations.</summary>
+    /// <remarks>Add converters before use. Mutations during a callback affect later operations, not the active operation. No converter factories or attribute precedence are implemented.</remarks>
+    val Converters: JsonConverterCollection => converters
+
+    internal func Snapshot() -> ArrayList<JsonConverterRegistration> {
+        return converters.Snapshot()
+    }
+}
+
+/// <summary>Ordered exact-type converter registrations.</summary>
+/// <remarks>The first registration for a type wins. Registration is append-only in this development API.</remarks>
+public class JsonConverterCollection {
+    private val registrations = ArrayList<JsonConverterRegistration>()
+
+    internal init() { }
+
+    /// <summary>Gets the number of registered converters, including duplicates.</summary>
+    val Count: int => registrations.Count
