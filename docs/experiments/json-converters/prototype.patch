+/// <summary>The JSON shape used to classify a union case.</summary>
+public enum JsonUnionCaseKind {
+    String = 1
+    Number = 2
+    Boolean = 3
+    Array = 4
+    Object = 5
+}
+
+/// <summary>Serializes registered union payloads directly, without a discriminator.</summary>
+/// <remarks>Development explicit union contract. Reads select exactly one case by JSON shape before invoking case code. Null represents the supplied empty union value. Case adapters use ordinary Raven construction and patterns; metadata-driven discovery, nullable payload cases and structural classifiers are not implemented.</remarks>
+public class JsonUnionConverter<T> : JsonConverter<T> {
+    // Generic constructor callback/value storage requires explicit fields in the current compiler.
+    private field empty: T
+    private field isEmpty: (T) -> bool
+    private val cases = ArrayList<JsonUnionCase<T>>()
+    private var started = false
+
+    /// <summary>Creates an explicit union contract with its empty state.</summary>
+    /// <param name="empty">The no-active-case value returned for JSON null.</param>
+    /// <param name="isEmpty">Tests whether a union has no active case.</param>
+    init(empty: T, isEmpty: (T) -> bool) {
+        self.empty = empty
+        self.isEmpty = isEmpty
+    }
+
+    internal func AddRegisteredCase(value: JsonUnionCase<T>) {
+        if started {
+            System.Fail("JSON union contract is already in use")
+        }
+        cases.Add(value)
+    }
+
+    /// <summary>Reads a union using built-in payload mapping.</summary>
+    /// <remarks>Use JsonSerializer with options to include registered payload converters.</remarks>
+    func Read(value: JsonValue) -> Result<T, JsonError> {
+        return ReadCore(value, JsonConverterState(JsonSerializerOptions()))
+    }
+
+    /// <summary>Writes the active union payload using built-in mapping.</summary>
+    /// <remarks>Use JsonSerializer with options to include registered payload converters.</remarks>
+    func Write(value: T) -> Result<JsonValue, JsonError> {
+        return WriteCore(value, JsonConverterState(JsonSerializerOptions()))
+    }
+
+    internal func ReadCore(value: JsonValue, state: JsonConverterState) -> Result<T, JsonError> {
+        started = true
+        if value is JsonNull {
+            return Ok(empty)
+        }
+        let kind = JsonUnionShapes.Kind(value)
+        var selected: JsonUnionCase<T>? = null
+        for candidate in cases {
+            if candidate.Kind == kind {
+                if selected is JsonUnionCase<T> {
+                    return Error(JsonError.UnsupportedMapping("Ambiguous JSON union case"))
+                }
+                selected = candidate
+            }
+        }
+        if selected is JsonUnionCase<T> found {
+            let child = state.Child()?
+            return found.Read(value, child)
+        }
+        return Error(JsonError.TypeMismatch("registered union case shape"))
+    }
+
+    internal func WriteCore(value: T, state: JsonConverterState) -> Result<JsonValue, JsonError> {
+        started = true
+        if isEmpty(value) {
+            return Ok(JsonNull())
+        }
+        var selected: JsonUnionCase<T>? = null
+        var payload: Object? = null
+        for candidate in cases {
+            if candidate.Extract(value) is Some(let extracted) {
+                if selected is JsonUnionCase<T> {
+                    return Error(JsonError.UnsupportedMapping("Multiple JSON union cases matched"))
+                }
+                selected = candidate
+                payload = extracted
+            }
+        }
+        if selected is JsonUnionCase<T> found && payload is Object content {
+            let child = state.Child()?
+            let node = found.Write(content, child)?
+            if JsonUnionShapes.Kind(node) != found.Kind {
+                return Error(JsonError.TypeMismatch("registered union case shape"))
+            }
+            return Ok(node)
+        }
+        return Error(JsonError.UnsupportedMapping("Unregistered active JSON union case"))
+    }
+}
