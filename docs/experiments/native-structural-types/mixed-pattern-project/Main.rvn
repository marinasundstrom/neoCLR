class Response {
    val Code: int => 42
}

func IsNegative(value: int) -> bool {
    return value < 0
}

func IsWide(value: long) -> bool {
    return value > 4294967295L
}

func Inspect(value: int | long | bool | Response) -> int {
    let result = match value {
        let number: int when IsNegative(number) => 11
        let number: int => number
        let number: long when IsWide(number) => 13
        let number: long => 17
        let flag: bool when flag => 19
        let flag: bool => 23
        let response: Response => response.Code
        _ => -1
    }
    return result
}

func Main() -> int {
    if Inspect(-1) != 11 {
        return 1
    }
    if Inspect(42) != 42 {
        return 2
    }
    if Inspect(4294967338L) != 13 {
        return 3
    }
    if Inspect(42L) != 17 {
        return 4
    }
    if Inspect(true) != 19 {
        return 5
    }
    if Inspect(false) != 23 {
        return 6
    }
    if Inspect(Response()) != 42 {
        return 7
    }
    return 42
}
