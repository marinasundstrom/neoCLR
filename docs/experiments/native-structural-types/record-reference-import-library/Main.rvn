public struct Response {
    val Number: int
    val Wide: long

    init(number: int, wide: long) {
        Number = number
        Wide = wide
    }
}

public class HttpError {
    val Code: int

    init(code: int) {
        Code = code
    }
}

public func Produce(choice: int) -> int | long | bool | Response | HttpError {
    if choice == 0 {
        return -1
    }
    if choice == 1 {
        return 42
    }
    if choice == 2 {
        return 4294967338L
    }
    if choice == 3 {
        return 42L
    }
    if choice == 4 {
        return true
    }
    if choice == 5 {
        return false
    }
    if choice == 6 {
        return Response(42, 4294967338L)
    }
    return HttpError(44)
}

public func Echo(value: HttpError | Response | bool | long | int) -> int | Response | HttpError | bool | long {
    return value
}
