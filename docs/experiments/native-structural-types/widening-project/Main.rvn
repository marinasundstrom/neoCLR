struct Response {
    val Value: int

    init(value: int) {
        Value = value
    }
}

func Select(value: int | long) -> int {
    return 42
}

func Select(value: int | long | bool) -> int {
    return -1
}

func Extend(value: int | long) -> Response | int | long {
    return value
}

func Echo(value: Response | int) -> bool | int | Response {
    return value
}

func Main() -> int {
    let narrow: int | long = 42
    if Select(narrow) != 42 {
        return -1
    }

    let scalar = match Extend(narrow) {
        int number => number
        _ => -1
    }
    if scalar != 42 {
        return -2
    }

    let response: Response | int = Response(42)
    return match Echo(response) {
        Response result => result.Value
        _ => -3
    }
}
