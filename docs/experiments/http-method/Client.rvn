module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*
import NeoClr.Testing.*

[Test]
async func `CONNECT remains unsupported`() -> Task<Result<unit, TestFailure>> {
    let Ok(request) = HttpClientRequest.Create(HttpMethod.Connect, "http://example.test/") else {
        return Assert.True(false, "Construct the CONNECT request")
    }
    let client = HttpClient()
    let result = await client.Send(request)
    client.Dispose()
    return Assert.True(result is Failure(HttpError.Unsupported(_)), "CONNECT must not pretend to tunnel")
}

[Test]
async func `Custom HTTP method client preserves response status and length`(url: string) -> Task<Result<unit, TestFailure>> {
    let Ok(request) = HttpClientRequest.Create(HttpMethod("m-SEARCH"), url, HttpStringContent("body")) else {
        return Assert.True(false, "Construct the custom method request")
    }
    let client = HttpClient()
    let result = await client.Send(request)
    client.Dispose()
    let Ok(response) = result else { return Assert.True(false, "Custom method request succeeds") }
    _ = Assert.Equal(200, (int)response.StatusCode)?
    return Assert.True(response.Content.Length == 4, "Custom method response has four body bytes")
}

async func Main(arguments: string[]) -> Task<int> {
    // Invalid constructors remain terminal-failure subprocess probes.
    if arguments[0] == "invalid" {
        _ = HttpMethod(arguments[1])
        Console.WriteLine("ERROR invalid method constructor returned")
        return 0
    }
    if arguments[0] == "connect" {
        let connectOutcome = await `CONNECT remains unsupported`()
        return ReportMethod("CONNECT remains unsupported", connectOutcome)
    }
    let customOutcome = await `Custom HTTP method client preserves response status and length`(arguments[0])
    return ReportMethod("Custom HTTP method client preserves response status and length", customOutcome)
}
