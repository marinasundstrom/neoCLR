import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func OpenServer() -> HttpServer {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) else { Panic("Listen failed") }
    let Ok(port) = server.GetLocalPort() else { Panic("Port unavailable") }
    Console.WriteLine(port)
    return server
}

func Echo(request: HttpServerRequest) -> Task<Result<HttpServerResponse, HttpError>> {
    if request.Method.Method != "m-SEARCH" || request.Content.Length != 4 {
        Panic("Custom method request mismatch")
    }
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("X-Method", request.Method.Method))
    return Task.FromResult<Result<HttpServerResponse, HttpError>>(System.Result<HttpServerResponse, HttpError>.Ok(HttpServerResponse(200, headers, request.Content)))
}

async func Main() -> Task<()> {
    let server = OpenServer()
    let result = await server.ServeOne(Echo)
    server.Close()
    let Ok(_) = result else { Panic("Custom method server failed") }
    Console.WriteLine("PASS custom method server")
}
