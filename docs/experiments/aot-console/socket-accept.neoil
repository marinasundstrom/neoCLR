.module NativeAccept
.type class Completion
.field Operation Int64
.method instance .ctor() -> noresult
ret
.end
.method instance Complete() -> Void
ldarg 0
ldfld Completion::Operation
call neoCLR.Runtime.SocketConnectResult(Int64)
dup
value.is Byte
brtrue Cancelled
value.unpack Int64
call neoCLR.Runtime.SocketClose(Int64)
pop
ldvoid
ret
Cancelled:
value.unpack Byte
conv.i4
ldc.i4 5
ceq
brtrue Done
ldc.i4 1
ldc.i4 0
div
pop
Done:
ldvoid
ret
.end
.end
.function Calculate(Int32 cancel) -> Int32
.local Int64 listener
.local Completion completion
ldstr "127.0.0.1"
ldc.i4 0
ldc.i4 4
call neoCLR.Runtime.SocketListen(String, Int32, Int32)
value.unpack Int64
stloc listener
newobj.ctor instance Completion::.ctor()
stloc completion
ldloc completion
ldloc listener
ldloc completion
function.bind fn<Void> = instance Completion::Complete()
call neoCLR.Runtime.SocketAccept(Int64, fn<Void>)
value.unpack Int64
stfld Completion::Operation
ldarg cancel
brfalse Port
ldloc completion
ldfld Completion::Operation
call neoCLR.Runtime.SocketCancel(Int64)
pop
Port:
ldloc listener
call neoCLR.Runtime.SocketLocalPort(Int64)
value.unpack Int32
ret
.end

.function neoCLR.Runtime.SocketListen(String address,Int32 port,Int32 backlog) -> Value
.methodimpl InternalCall
.end
.function neoCLR.Runtime.SocketLocalPort(Int64 handle) -> Value
.methodimpl InternalCall
.end
.function neoCLR.Runtime.SocketClose(Int64 handle) -> Value
.methodimpl InternalCall
.end

.function neoCLR.Runtime.SocketAccept(Int64 listener, fn<Void> callback) -> Value
.methodimpl InternalCall
.end
.function neoCLR.Runtime.SocketConnectResult(Int64 operation) -> Value
.methodimpl InternalCall
.end
.function neoCLR.Runtime.SocketCancel(Int64 operation) -> Boolean
.methodimpl InternalCall
.end
