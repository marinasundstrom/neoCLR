import System.*
import System.IO.*
import System.Result.*

func Main() -> int {
    let output = Console.OpenStandardOutput()
    let error = Console.OpenStandardError()
    let bytes = [(byte)65, (byte)0, (byte)66]
    let Ok(_) = output.Write(bytes[..0]) else {
        return 1
    }
    let Ok(_) = output.Write(bytes) else {
        return 4
    }
    let Ok(_) = output.Flush() else {
        return 6
    }
    let Ok(_) = error.Write(bytes[2..3]) else {
        return 7
    }
    let Ok(_) = error.Flush() else {
        return 8
    }
    output.Close()
    let Failure(_) = output.Write(bytes[..1]) else {
        return 9
    }
    let Failure(_) = output.Flush() else {
        return 10
    }
    Console.WriteLine("Closed output")
    return 0
}
