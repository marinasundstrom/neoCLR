.module Callbacks
.type class Counter
.field Number Int32
.method instance .ctor(Int32 number) -> noresult
ldarg 0
ldarg number
stfld Counter::Number
ret
.end
.method instance Add(Int32 delta) -> Int32
ldarg 0
ldarg 0
ldfld Counter::Number
ldarg delta
add
stfld Counter::Number
ldarg 0
ldfld Counter::Number
ret
.end
.end
.type class Holder
.field Callback fn<Int32,Int32>
.method instance .ctor(fn<Int32,Int32> callback) -> noresult
ldarg 0
ldarg callback
stfld Holder::Callback
ret
.end
.end
.function Make() -> fn<Int32,Int32>
ldc.i4 40
newobj.ctor instance Counter::.ctor(Int32)
function.bind fn<Int32,Int32> = instance Counter::Add(Int32)
ret
.end
.function Static(Int32 number) -> Int32
ldarg number
ldc.i4 2
add
ret
.end
.function Fail(Int32 number) -> Int32
ldarg number
ldc.i4 0
div
ret
.end
.function NewCounter() -> Counter
ldc.i4 42
newobj.ctor instance Counter::.ctor(Int32)
ret
.end
.function Empty() -> noresult
ret
.end
.function Unit() -> Void
ldvoid
ret
.end
.function Calculate(Int32 mode) -> Int32
.local Holder holder
.local Int32 count
.local Counter empty
.local fn<Int32,Int32> missing
ldarg mode
ldc.i4 1
ceq
brtrue Fault
ldarg mode
ldc.i4 2
ceq
brtrue NullBind
ldarg mode
ldc.i4 3
ceq
brtrue NullInvoke
function.bind fn<Counter> = NewCounter()
callvirt instance fn<Counter>::Invoke()
ldc.i4 0
callvirt instance Counter::Add(Int32)
pop
ldc.i4 42
function.bind fn<noresult Void> = Empty()
callvirt instance fn<noresult Void>::Invoke()
pop
function.bind fn<Void> = Unit()
callvirt instance fn<Void>::Invoke()
pop
call Make()
newobj.ctor instance Holder::.ctor(fn<Int32,Int32>)
stloc holder
ldc.i4 0
stloc count
Loop:
function.bind fn<Int32,Int32> = Static(Int32)
ldc.i4 40
callvirt instance fn<Int32,Int32>::Invoke(Int32)
pop
ldloc count
ldc.i4 1
add
stloc count
ldloc count
ldc.i4 1000
clt
brtrue Loop
ldloc holder
ldfld Holder::Callback
ldc.i4 1
callvirt instance fn<Int32,Int32>::Invoke(Int32)
pop
ldloc holder
ldfld Holder::Callback
ldc.i4 1
call instance fn<Int32,Int32>::Invoke(Int32)
ret
Fault:
function.bind fn<Int32,Int32> = Fail(Int32)
ldc.i4 42
callvirt instance fn<Int32,Int32>::Invoke(Int32)
ret
NullBind:
ldloca empty
initobj Counter
ldloc empty
function.bind fn<Int32,Int32> = instance Counter::Add(Int32)
ldc.i4 1
callvirt instance fn<Int32,Int32>::Invoke(Int32)
ret
NullInvoke:
ldloca missing
initobj fn<Int32,Int32>
ldloc missing
ldc.i4 1
callvirt instance fn<Int32,Int32>::Invoke(Int32)
ret
.end
