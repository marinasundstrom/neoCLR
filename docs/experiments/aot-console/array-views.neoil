.module ArrayViews
.interface Read<T>
.method instance Count() -> Int32
.end
.method instance Get(Int32 index) -> T
.end
.end
.interface Mutable<T>
.implements Read<T>
.method instance Set(Int32 index, T value) -> noresult
.end
.end
.interface Other
.end
.type class Storage<T>
.implements Mutable<T>
.field private Bytes arrayref<T>
.method instance .ctor() -> noresult
ret
.end
.method instance Count() -> Int32
ldarg 0
ldfld 0
ldlen
conv.i4
ret
.end
.method instance Get(Int32 index) -> T
ldarg 0
ldfld 0
ldarg index
ldelem T
ret
.end
.method instance Set(Int32 index, T value) -> noresult
ldarg 0
ldfld 0
ldarg index
ldarg value
stelem T
ret
.end
.end
.function Calculate(Int32 mode) -> Int32
.local arrayref<Byte> bytes
.local Mutable<Byte> view
ldarg mode
ldc.i4 4
beq Null
ldarg mode
ldc.i4 8
beq Empty
ldarg mode
ldc.i4 0
beq Ordinary
ldc.i4 2
array.reserve Byte
br Store
Ordinary:
ldc.i4 2
newarr Byte
Store:
stloc bytes
ldloc bytes
castclass Mutable<Byte>
stloc view
ldarg mode
ldc.i4 2
beq Unwritten
ldloc view
ldc.i4 0
ldc.i4 42
conv.u1
callvirt instance Mutable<Byte>::Set(Int32, Byte)
ldarg mode
ldc.i4 3
beq Outside
ldarg mode
ldc.i4 5
beq Missing
ldarg mode
ldc.i4 6
beq Wrong
ldarg mode
ldc.i4 7
beq Identity
ldarg mode
ldc.i4 9
beq Nominal
ldloc view
callvirt instance Read<Byte>::Count()
ldloc view
ldc.i4 0
callvirt instance Read<Byte>::Get(Int32)
add
ret
Unwritten:
ldloc view
ldc.i4 0
callvirt instance Read<Byte>::Get(Int32)
ret
Outside:
ldloc view
ldc.i4 2
callvirt instance Read<Byte>::Get(Int32)
ret
Null:
ldloca bytes
initobj arrayref<Byte>
ldloc bytes
castclass Read<Byte>
callvirt instance Read<Byte>::Count()
ret
Empty:
ldc.i4 0
newarr Byte
castclass Read<Byte>
callvirt instance Read<Byte>::Count()
ret
Missing:
ldloc bytes
isinst Other
ref.isnull
br Result
Wrong:
ldloc bytes
castclass Other
pop
ldc.i4 -1
ret
Identity:
ldloc view
castclass arrayref<Byte>
ldloc bytes
ref.eq
br Result
Nominal:
ldloc bytes
castclass Storage<Byte>
call instance Storage<Byte>::Count()
ret
Result:
brfalse Fail
ldc.i4 1
ret
Fail:
ldc.i4 0
ret
.end
