.module InterfaceViews
.interface View
.end
.interface OtherView
.end
.type class Cell
.implements View
.field Value Int32
.method instance .ctor(Int32 value) -> noresult
ldarg 0
ldarg value
stfld 0
ret
.end
.end
.type class Other
.implements OtherView
.method instance .ctor() -> noresult
ret
.end
.end
.function Copy(View input, out View& output) -> Void
ldarg output
ldarg input
stobj View
ldvoid
ret
.end
.function Calculate(Int32 mode) -> Int32
.local Cell cell
.local View view
.local View copy
.local Other other
ldarg mode
ldc.i4 2
beq Null
ldarg mode
ldc.i4 6
beq NullClass
ldc.i4 42
newobj.ctor instance Cell::.ctor(Int32)
stloc cell
ldloc cell
castclass View
stloc view
ldarg mode
ldc.i4 1
beq Invalid
ldarg mode
ldc.i4 3
beq InvalidView
ldarg mode
ldc.i4 4
beq Missing
ldarg mode
ldc.i4 5
beq Alias
ldarg mode
ldc.i4 7
beq Same
; A mismatched isinst must return null.
ldloc view
isinst Other
ref.isnull
brfalse Wrong
ldloc view
isinst OtherView
ref.isnull
brfalse Wrong
ldloc view
castclass Cell
ldfld Cell::Value
ret
Invalid:
ldloc view
castclass Other
pop
br Wrong
InvalidView:
newobj.ctor instance Other::.ctor()
castclass View
pop
br Wrong
Missing:
newobj.ctor instance Other::.ctor()
isinst View
ref.isnull
brtrue Yes
br Wrong
Alias:
ldloc view
ldloca copy
call Copy(View, View&)
pop
ldloc view
ldloc copy
ref.eq
brfalse Wrong
ldloc copy
castclass Cell
ldc.i4 99
stfld Cell::Value
ldloc cell
ldfld Cell::Value
ret
Same:
ldloc cell
isinst Cell
ldfld Cell::Value
ret
Null:
ldloca view
initobj View
ldloc view
castclass Other
ref.isnull
brtrue Yes
br Wrong
NullClass:
ldloca cell
initobj Cell
ldloc cell
isinst View
ref.isnull
brtrue Yes
br Wrong
Yes:
ldc.i4 1
ret
Wrong:
ldc.i4 -1
ret
.end
