.module ArrayViews
.type class Counter
.field Value Int32
.method instance .ctor(Int32 value) -> noresult
ldarg 0
ldarg value
stfld 0
ret
.end
.end
.type class OtherCounter
.field Value Int32
.end
.interface Read<T>
.method instance Count() -> Int32
.end
.method instance Get(Int32 index) -> T
.end
.end
.interface Mutable<T>
.implements Read<T>
.method instance Set(Int32 index, T value) -> noresult
.end
.end
.interface Other
.end
.type class Storage<T>
.implements Mutable<T>
.field private Counters arrayref<T>
.method instance .ctor() -> noresult
ret
.end
.method instance Count() -> Int32
ldarg 0
ldfld 0
ldlen
conv.i4
ret
.end
.method instance Get(Int32 index) -> T
ldarg 0
ldfld 0
ldarg index
ldelem T
ret
.end
.method instance Set(Int32 index, T value) -> noresult
ldarg 0
ldfld 0
ldarg index
ldarg value
stelem T
ret
.end
.end
.function Calculate(Int32 mode) -> Int32
.local arrayref<Counter> bytes
.local Mutable<Counter> view
ldc.i4 1
newarr OtherCounter
dup
castclass Read<OtherCounter>
callvirt instance Read<OtherCounter>::Count()
pop
isinst Read<Counter>
ref.isnull
brfalse Fail
ldarg mode
ldc.i4 10
beq DefaultNull
ldarg mode
ldc.i4 11
beq WrongArray
ldarg mode
ldc.i4 12
beq MissingArray
ldarg mode
ldc.i4 13
beq DirectMissingArray
ldarg mode
ldc.i4 14
beq NullMissingArray
ldarg mode
ldc.i4 4
beq Null
ldarg mode
ldc.i4 8
beq Empty
ldarg mode
ldc.i4 0
beq Ordinary
ldc.i4 2
array.reserve Counter
br Store
Ordinary:
ldc.i4 2
newarr Counter
Store:
stloc bytes
ldloc bytes
castclass Mutable<Counter>
stloc view
ldarg mode
ldc.i4 2
beq Unwritten
ldloc view
ldc.i4 0
ldc.i4 42
newobj instance Counter::.ctor(Int32)
callvirt instance Mutable<Counter>::Set(Int32, Counter)
ldarg mode
ldc.i4 3
beq Outside
ldarg mode
ldc.i4 5
beq Missing
ldarg mode
ldc.i4 6
beq Wrong
ldarg mode
ldc.i4 7
beq Identity
ldarg mode
ldc.i4 9
beq Nominal
ldloc view
callvirt instance Read<Counter>::Count()
ldloc view
ldc.i4 0
callvirt instance Read<Counter>::Get(Int32)
ldfld 0
add
ret
Unwritten:
ldloc view
ldc.i4 0
callvirt instance Read<Counter>::Get(Int32)
ldfld 0
ret
Outside:
ldloc view
ldc.i4 2
callvirt instance Read<Counter>::Get(Int32)
ldfld 0
ret
Null:
ldloca bytes
initobj arrayref<Counter>
ldloc bytes
castclass Read<Counter>
callvirt instance Read<Counter>::Count()
ret
Empty:
ldc.i4 0
newarr Counter
castclass Read<Counter>
callvirt instance Read<Counter>::Count()
ret
Missing:
ldloc bytes
isinst Read<OtherCounter>
ref.isnull
br Result
Wrong:
ldloc bytes
castclass Read<OtherCounter>
pop
ldc.i4 -1
ret
Identity:
ldloc view
castclass arrayref<Counter>
ldloc bytes
ref.eq
br Result
Nominal:
ldloc bytes
castclass Storage<Counter>
call instance Storage<Counter>::Count()
ret
DefaultNull:
ldc.i4 1
newarr Counter
ldc.i4 0
ldelem Counter
ldfld 0
ret
WrongArray:
ldc.i4 0
newarr Counter
castclass Read<Counter>
castclass arrayref<OtherCounter>
pop
ldc.i4 -1
ret
MissingArray:
ldc.i4 0
newarr Counter
castclass Read<Counter>
isinst arrayref<OtherCounter>
ref.isnull
br Result
DirectMissingArray:
