import System.*
import System.IO.*
import System.Result.*

func Main() -> int {
    let input = Console.OpenStandardInput()
    let buffer: byte[] = [(byte)0, (byte)0]
    let Ok(empty) = input.Read(buffer, 0, 0) else {
        return 1
    }
    if empty != 0 {
        return 2
    }
    let Error(_) = input.Read(buffer, -1, 1) else {
        return 3
    }
    let Ok(count) = input.Read(buffer, 1, 1) else {
        return 4
    }
    Console.WriteLine(count)
    if count != 0 {
        Console.WriteLine(buffer[1])
    } else {
        Console.WriteLine("End of input")
    }
    input.Close()
    let Error(_) = input.Read(buffer, 0, 1) else {
        return 5
    }
    Console.WriteLine("Closed input")
    return 0
}
