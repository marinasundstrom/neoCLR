.module NativeIntrospection
.type class Account
.end
.type class Model<T>
.end
.function Show(RuntimeTypeHandle type) -> Void
ldarg type
call neoCLR.Runtime.TypeName(RuntimeTypeHandle)
call neoCLR.Runtime.WriteLine(String)
ret
.end
.function Calculate() -> Int32
ldtoken Int32
call Show(RuntimeTypeHandle)
pop
ldtoken Account
call Show(RuntimeTypeHandle)
pop
ldtoken Model<Int32>
call Show(RuntimeTypeHandle)
pop
ldtoken Model<String>
call Show(RuntimeTypeHandle)
pop
ldtoken Account
call neoCLR.Runtime.TypeArgumentCount(RuntimeTypeHandle)
ldc.i4 0
ceq
brfalse Fail
ldtoken Model<Int32>
call neoCLR.Runtime.TypeArgumentCount(RuntimeTypeHandle)
ldc.i4 1
ceq
brfalse Fail
ldtoken Model<Int32>
ldtoken Model<String>
call neoCLR.Runtime.TypeEquals(RuntimeTypeHandle,RuntimeTypeHandle)
brtrue Fail
ldc.i4 42
ret
Fail:
ldc.i4 -1
ret
.end
