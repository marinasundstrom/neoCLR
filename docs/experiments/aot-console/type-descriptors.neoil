.module NativeIntrospection
.type class Account
.end
.type internal Concealed
.end
.type class Model<T>
.end
.function Show(RuntimeTypeHandle type) -> Void
ldarg type
call neoCLR.Runtime.TypeName(RuntimeTypeHandle)
call neoCLR.Runtime.WriteLine(String)
ret
.end
.function Calculate() -> Int32
ldtoken Int32
call Show(RuntimeTypeHandle)
pop
ldtoken Account
call Show(RuntimeTypeHandle)
pop
ldtoken Model<Int32>
call Show(RuntimeTypeHandle)
pop
ldtoken Model<String>
call Show(RuntimeTypeHandle)
pop
ldtoken arrayref<Int32>
call Show(RuntimeTypeHandle)
pop
ldtoken arrayref<Model<Int32>>
call Show(RuntimeTypeHandle)
pop
ldtoken arrayref<Int32>
call neoCLR.Runtime.TypeArgumentCount(RuntimeTypeHandle)
ldc.i4 0
ceq
brfalse Fail
ldtoken arrayref<Int32>
ldc.i4 0
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brfalse Fail
ldtoken arrayref<Int32>
ldc.i4 12
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brtrue Fail
ldtoken arrayref<Concealed>
ldc.i4 11
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brtrue Fail
ldtoken Account
call neoCLR.Runtime.TypeArgumentCount(RuntimeTypeHandle)
ldc.i4 0
ceq
brfalse Fail
ldtoken Model<Int32>
call neoCLR.Runtime.TypeArgumentCount(RuntimeTypeHandle)
ldc.i4 1
ceq
brfalse Fail
ldtoken Model<Int32>
ldtoken Model<String>
call neoCLR.Runtime.TypeEquals(RuntimeTypeHandle,RuntimeTypeHandle)
brtrue Fail
ldtoken Int32
ldc.i4 7
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brfalse Fail
ldtoken Account
ldc.i4 7
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brtrue Fail
ldtoken Account
ldc.i4 8
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brfalse Fail
ldtoken Account
ldc.i4 11
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brfalse Fail
ldtoken Account
ldc.i4 12
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brfalse Fail
ldtoken Account
ldc.i4 13
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brtrue Fail
ldtoken Model<Concealed>
ldc.i4 11
call neoCLR.Runtime.TypeShape(RuntimeTypeHandle,Int32)
brtrue Fail
ldc.i4 42
ret
Fail:
ldc.i4 -1
ret
.end
