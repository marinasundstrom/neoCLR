.module ReflectionConstruction
.type class abstract System.Object
.end
.type class Model
.field Number Int32
.method instance .ctor() -> noresult
ldarg 0
ldc.i4 42
stfld Model::Number
ret
.end
.end
.type class Private
.method private instance .ctor() -> noresult
ret
.end
.end
.type class Missing
.end
.type class abstract Abstract
.end
.type class Broken
.method instance .ctor() -> noresult
fault "constructor failed"
.end
.end
.function neoCLR.Runtime.ReflectionConstructionCheck(RuntimeTypeHandle) -> Int32
.methodimpl InternalCall
.end
.function neoCLR.Runtime.ReflectionConstruct(RuntimeTypeHandle) -> System.Object
.methodimpl InternalCall
.end
.function Calculate(Int32 mode) -> Int32
ldarg mode
ldc.i4 1
beq Private
ldarg mode
ldc.i4 2
beq Missing
ldarg mode
ldc.i4 3
beq Abstract
ldarg mode
ldc.i4 4
beq Broken
ldtoken Model
call neoCLR.Runtime.ReflectionConstructionCheck(RuntimeTypeHandle)
ldc.i4 0
ceq
brfalse Failed
ldtoken Model
call neoCLR.Runtime.ReflectionConstruct(RuntimeTypeHandle)
castclass Model
ldfld Model::Number
ret
Private:
ldtoken Private
call neoCLR.Runtime.ReflectionConstructionCheck(RuntimeTypeHandle)
ret
Missing:
ldtoken Missing
call neoCLR.Runtime.ReflectionConstructionCheck(RuntimeTypeHandle)
ret
Abstract:
ldtoken Abstract
call neoCLR.Runtime.ReflectionConstructionCheck(RuntimeTypeHandle)
ret
Broken:
ldtoken Broken
call neoCLR.Runtime.ReflectionConstruct(RuntimeTypeHandle)
pop
Failed:
ldc.i4 -1
ret
.end
