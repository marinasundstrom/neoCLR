.module InheritedDisplay
.type class abstract Base
.extends System.Object
.field Text String
.method instance .ctor(String text) -> noresult
ldarg 0
call instance System.Object::.ctor()
ldarg 0
ldarg text
stfld 0
ret
.end
.method instance override ToString() -> String
ldarg 0
ldfld 0
ret
.end
.end
.type class Child
.extends Base
.field Number Int32
.method instance .ctor(String text) -> noresult
ldarg 0
ldarg text
call instance Base::.ctor(String)
ldarg 0
ldc.i4 42
stfld 1
ret
.end
.method instance NumberValue() -> Int32
ldarg 0
ldfld 1
ret
.end
.end
.function Calculate(Int32 mode) -> Int32
.local Base value
ldarg mode
brtrue Null
ldstr "inherited text"
newobj.ctor instance Child::.ctor(String)
castclass Base
stloc value
ldloc value
castclass Child
callvirt instance Child::NumberValue()
ldc.i4 42
ceq
brtrue Invoke
ldstr "wrong child layout"
call neoCLR.Runtime.Fault(String)
pop
br Invoke
Null:
ldloca value
initobj Base
Invoke:
ldloc value
callvirt instance Base::ToString()
call neoCLR.Runtime.Fault(String)
pop
ldc.i4 0
ret
.end
