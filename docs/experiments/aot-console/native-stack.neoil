.module NativeStack
.function Recurse(Int32 depth) -> Int32
ldarg depth
ldc.i4 0
ceq
brtrue Done
ldarg depth
ldc.i4 1
sub
call Recurse(Int32)
ret
Done:
ldc.i4 42
ret
.end
.function Callback() -> Void
ldc.i4 -1
call Recurse(Int32)
pop
ldvoid
ret
.end
.function Calculate(Int32 depth) -> Int32
.local fn<Void> callback
ldarg depth
ldc.i4 -2
ceq
brtrue Bind
ldarg depth
call Recurse(Int32)
ret
Bind:
function.bind fn<Void> = Callback()
stloc callback
ldc.i4 0
ret
.end
