import System.*

func Compare(left: string, right: string) {
    Console.WriteLine(left == right)
    Console.WriteLine(left != right)
}

func Join(left: string, right: string) -> string {
    return left + right
}

func Main() -> int {
    Compare("", "")
    Compare("", "x")
    Compare("hé😀", "hé😀")
    Compare("a\u0000x", "a\u0000y")
    Compare("a\u0000x", "a\u0000x")
    Compare("é", "é")
    Compare("same", "Same")
    let text = Join("hé", "😀")
    Compare(text, "hé😀")
    return 0
}
