import System.*
import System.Result.*
import System.Option.*

func Main() -> int {
    Console.WriteLine("Type one byte:")
    let Ok(option) = Console.ReadByte() else {
        Console.WriteLine("Input failed")
        return 1
    }
    if let Some(value) = option {
        Console.WriteLine(value)
        Console.WriteLine(-2147483647 - 1)
        Console.WriteLine(2147483647)
    } else {
        Console.WriteLine("End of input")
    }
    return 0
}
