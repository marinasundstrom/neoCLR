module NeoClr.RuntimeTests

import System.*
import System.Result.*
import NeoClr.Testing.*

class Label {
    override func ToString() -> string => "label"
}

class CustomFormat : Formattable {
    func ToString(format: string, culture: System.Globalization.Culture) -> string {
        return if format.IsEmpty { "default" } else { "custom:" + format }
    }
}

struct FormattedValue : Formattable {
    func ToString(format: string, culture: System.Globalization.Culture) -> string => "value:" + format
}

struct FormattedPayload : Formattable {
    private val text: string
    init(text: string) {
        self.text = text
    }
    func ToString(format: string, culture: System.Globalization.Culture) -> string => text + format
}

func Check(actual: string, expected: string) -> Result<unit, TestFailure> {
    return Assert.True(String.CompareOrdinal(actual, expected) == 0, "Expected '" + expected + "', actual '" + actual + "'")
}

[Test]
func `Composite formatting preserves text dispatch retained values and console output`() -> Result<unit, TestFailure> {
    _ = Check(String.Format("{{}}"), "{}")?
    _ = Check(String.Format("plain 👩‍💻", 42), "plain 👩‍💻")?
    _ = Check(String.Format("{0} {0}", 42), "42 42")?
    _ = Check(String.Format("{1}/{0}", "a", "b"), "b/a")?
    _ = Check(String.Format("{2}/{0}/{1}", "a", true, 17), "17/a/True")?
    _ = Check(String.Format("{{{0}}}", "é"), "{é}")?
    _ = Check(String.Format("{{}}", null), "{}")?
    _ = Check(String.Format("[{0,3}][{1,-3}]", "é", "👩‍💻"), "[  é][👩‍💻  ]")?
    _ = Check(String.Format("{0,1}|{1}", "long", null), "long|")?
    _ = Check(String.Format("{0:}", Label()), "label")?
    _ = Check(String.Format("{0, 0 }", "x"), "x")?
    _ = Check(String.Format("{3}:{0}", "a", "b", "c", "d"), "d:a")?
    let arguments: object?[] = ["a", 2, null, "d"]
    _ = Check(String.Format("{3}:{1}:{2}", arguments), "d:2:")?
    _ = Check(String.Format("{0}", Character.FromString("🇸🇪")), "🇸🇪")?
    _ = Check(String.Format("a\u0000{0}z", "é"), "a\u0000éz")?
    _ = Check(String.Format("{0}|{0:é}|{0,12:tag}", CustomFormat()), "default|custom:é|  custom:tag")?
    _ = Check(String.Format("{0:token}", FormattedValue()), "value:token")?
    let payload: object = FormattedPayload(String.Concat("retained", ":"))
    let unrelated = String.Concat("other", " allocation")
    _ = Check(unrelated, "other allocation")?
    _ = Check(String.Format("{0:tag}", payload), "retained:tag")?
    _ = Check(String.Format("{0:ignored}", Label()), "label")?
    _ = Check(String.Format("{0:anything}", null), "")?
    Console.WriteLine("line:{0}", 1)
    Console.WriteLine("line:{0}:{1}", 1, 2)
    Console.WriteLine("line:{0}:{1}:{2}", 1, 2, 3)
    Console.WriteLine("line:{3}", 1, 2, 3, 4)
    Console.Write("write:{0}", 1)
    Console.Write(":{0}:{1}", 2, 3)
    Console.Write(":{0}:{1}:{2}", 4, 5, 6)
    Console.Write(":{3}", 7, 8, 9, 10)
    Console.WriteLine()
    return Ok(())
}

func Main() -> int {
    let suite = TestSuite()
    suite.Add("composite-formatting", "Composite formatting preserves text dispatch retained values and console output", `Composite formatting preserves text dispatch retained values and console output`)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
