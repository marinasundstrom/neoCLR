namespace HttpErrorProbe

import System.*

public union HttpError {
    case InvalidRequest(message: string)
    case Transport(cause: TransportError)
    case TimedOut
    case Limit(reason: HttpLimit)

    val IsTransportFailure: bool {
        get {
            if let Transport(_) = self {
                return true
            }
            return false
        }
    }

    override func ToString() -> string {
        if let InvalidRequest(message) = self {
            return message
        }
        if let Transport(cause) = self {
            return cause.ToString()
        }
        return "TimedOut"
    }
}

public union TransportError {
    case ConnectionRefused(address: string)

    override func ToString() -> string {
        if let ConnectionRefused(address) = self {
            return address
        }
        return "No transport error"
    }
}

public union HttpLimit {
    case Headers
    case Body
}
