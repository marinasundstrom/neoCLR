module NeoClr.RuntimeTests

import System.*
import System.Result.*
import NeoClr.Testing.*
record struct Label(Value: int)
record struct Details(Name: string?, Enabled: bool, Count: long, Mark: System.Character)
record struct Envelope(Item: Label)

func Check(actual: string, expected: string) -> Result<unit, TestFailure> {
    return Assert.True(actual.Equals(expected, StringComparison.Ordinal), "Record display bytes")
}

[Test]
func `Record scalar and nested displays preserve structure`() -> Result<unit, TestFailure> {
    _ = Check(Label(42).ToString(), "Label { Value = 42 }")?
    _ = Check(Label(-2147483647 - 1).ToString(), "Label { Value = -2147483648 }")?
    _ = Check(Envelope(Label(-7)).ToString(), "Envelope { Item = Label { Value = -7 } }")?
    return Ok(())
}

[Test]
func `Record text displays preserve quoting and Unicode bytes`() -> Result<unit, TestFailure> {
    _ = Check(Details(null, false, 9223372036854775807, 'é').ToString(), "Details { Name = null, Enabled = False, Count = 9223372036854775807, Mark = 'é' }")?
    _ = Check(Details("hello", true, -9, 'x').ToString(), "Details { Name = \"hello\", Enabled = True, Count = -9, Mark = 'x' }")?
    _ = Check(Details("a\\b\"c", true, 0, '\'').ToString(), "Details { Name = \"a\\\\b\\\"c\", Enabled = True, Count = 0, Mark = '\\'' }")?
    _ = Check(Details("é", false, 0, 'é').ToString(), "Details { Name = \"é\", Enabled = False, Count = 0, Mark = 'é' }")?
    return Ok(())
}

[Test]
func `Boxed records retain synthesized display`() -> Result<unit, TestFailure> {
    let boxed: Object = Label(17)
    _ = Check(boxed.ToString(), "Label { Value = 17 }")?
    return Ok(())
}

func Main() -> int {
    let suite = TestSuite()
    suite.Add("record-format-1", "Record scalar and nested displays preserve structure", `Record scalar and nested displays preserve structure`)
    suite.Add("record-format-2", "Record text displays preserve quoting and Unicode bytes", `Record text displays preserve quoting and Unicode bytes`)
    suite.Add("record-format-3", "Boxed records retain synthesized display", `Boxed records retain synthesized display`)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
