import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func Respond(request: HttpServerRequest) -> Task<Result<HttpServerResponse, HttpError>> {
    let headers = ArrayList<HttpHeader>()
    var status = 200
    var body = HttpStringContent("Café 🌍")
    if request.Target == "/204" {
        status = 204
        body = HttpStringContent("")
    }
    if request.Target == "/205" {
        status = 205
        body = HttpStringContent("")
    }
    if request.Target == "/304" {
        status = 304
        body = HttpStringContent("")
    }
    if request.Target == "/299" {
        status = 299
    }
    if request.Target == "/reserved" {
        headers.Add(HttpHeader("CoNtEnT-LeNgTh", "10"))
    }
    if request.Target == "/injection" {
        headers.Add(HttpHeader("X-Test", "good\r\nInjected: bad"))
    }
    headers.Add(HttpHeader("X-Test", "ok"))
    return Task.FromResult<Result<HttpServerResponse, HttpError>>(System.Result<HttpServerResponse, HttpError>.Ok(HttpServerResponse(status, headers, body)))
}

async func Main() -> Task<()> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) else {
        Panic("Listen failed")
    }
    let Ok(port) = server.GetLocalPort() else {
        Panic("Port failed")
    }
    Console.WriteLine(port)
    for index in 0..8 {
        let result = await server.ServeOne(Respond)
        if let Failure(_) = result {
            if index < 6 {
                Panic("Valid response failed")
            }
        } else if index >= 6 {
            Panic("Invalid response accepted")
        }
    }
    server.Close()
    Console.WriteLine("DONE")
}
