import System.*

public func Check(value: bool, message: string) {
    if !value {
        System.Fail(message)
    }
}

public func Main(args: string[]) {
    if args[0].Equals("reader") {
        CheckReader()
    } else if args[0].Equals("reader-boundary") {
        CheckReaderBoundary()
    } else {
        CheckReaderLimit()
    }
}
