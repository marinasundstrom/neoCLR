import System.Collections.*

class Bounds {
    var Trace: int = 0

    func Read(value: int) -> int {
        Trace = Trace * 10 + value
        return value
    }
}

func Zero() -> int => 0

func Main() -> int {
    let bounds = Bounds()
    var sum = 0
    for value in bounds.Read(1)..bounds.Read(5) by bounds.Read(2) {
        sum += value
    }
    if sum != 9 || bounds.Trace != 152 {
        return 1
    }
    for value in 5..1 by -2 {
        sum += value
    }
    for value in 0..<3 {
        sum += value
    }
    for value in 3..<0 by -1 {
        sum += value
    }
    if sum != 27 {
        return 2
    }
    for value in 1..3 by Zero() {
        return 3
    }
    for value in 1..3 by -1 {
        return 4
    }
    var visited = 0
    outer: for value in 1..3 {
        for inner in 1..3 {
            if inner == 2 {
                continue outer
            }
            visited += 1
        }
    }
    if visited != 3 {
        return 5
    }
    let callbacks = ArrayList<() -> int>()
    for value in 1..3 {
        callbacks.Add(() => value)
    }
    if callbacks[0]() * 100 + callbacks[1]() * 10 + callbacks[2]() != 123 {
        return 6
    }
    let start: long = 4294967296
    let end: long = 4294967300
    let step: long = 2
    var count = 0
    for value in start..<end by step {
        count += 1
    }
    if count != 2 {
        return 7
    }
    for value in 1..10 {
        if value == 1 {
            continue
        }
        if value == 3 {
            break
        }
        sum += value
    }
    if sum != 29 {
        return 8
    }
    return 42
}
