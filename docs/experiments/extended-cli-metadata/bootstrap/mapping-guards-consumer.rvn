import System.Result.*

import Guards.*

func Main() -> int {
    if Operations.NullGuard() != 7 { return 1 }
    if Operations.Guard(true) != 11 { return 2 }
    if Operations.Guard(false) != 12 { return 3 }
    if Operations.Guard("text") != 13 { return 4 }
    if let Error(reason) = TerminalGuard.Read(true) {
        if reason != "failed" { return 5 }
    } else { return 6 }
    if let Ok(value) = TerminalGuard.Read(false) {
        if value is int number { return number }
    }
    return 7
}
