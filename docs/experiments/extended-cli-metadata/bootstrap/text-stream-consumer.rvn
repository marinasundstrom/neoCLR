import System.*
import System.IO.*
import System.Text.*
import System.Result.*
import System.Option.*

func Main() -> int {
    let memory = MemoryStream()
    let output: OutputStream = memory
    let input: InputStream = memory
    let seek: SeekableStream = memory
    let writer = StreamWriter(output, true)
    let text = "Aé😀"
    let Ok(written) = writer.WriteLine(text) else { return 1 }
    if written != 8 {
        return 2
    }
    let Ok(_) = writer.Finish() else { return 3 }
    let Ok(_) = writer.Flush() else { return 4 }
    writer.Close()
    let Ok(length) = memory.GetLength() else { return 5 }
    if length != 8L {
        return 6
    }
    let Ok(_) = seek.Seek(0L) else { return 7 }
    let reader = StreamReader(input, true)
    let Ok(Some(line)) = reader.ReadLine(64) else { return 8 }
    if line != text {
        return 9
    }
    let Ok(None) = reader.ReadLine(64) else { return 10 }
    reader.Close()
    let Ok(_) = seek.Seek(0L) else { return 11 }
    let all: TextReader = StreamReader(input, true)
    let Ok(rest) = all.ReadToEnd(64) else { return 12 }
    if rest != text + "\n" {
        return 13
    }
    all.Close()
    let Ok(_) = seek.Seek(0L) else { return 14 }
    let bounded = StreamReader(input, true)
    match bounded.ReadToEnd(2) {
        Error(TextReadError.LimitExceeded) => {}
        _ => return 15
    }
    let invalid = MemoryStream()
    let bytes: byte[] = [(byte)240]
    let Ok(_) = invalid.Write(bytes, 0, 1) else { return 16 }
    let Ok(_) = invalid.Seek(0L) else { return 17 }
    let broken = StreamReader(invalid)
    match broken.ReadToEnd(64) {
        Error(TextReadError.InvalidUtf8) => {}
        _ => return 18
    }
    broken.Close()
    match invalid.GetLength() {
        Error(StreamError.Closed) => {}
        _ => return 19
    }
    return 42
}
