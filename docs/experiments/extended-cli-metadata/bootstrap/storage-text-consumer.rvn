import System.*
import System.Result.*
import System.Storage.*
import System.Storage.FileText.*

func Main() {
    match WriteAllText("storage-demo/text.txt", "värld", 16) {
        Ok(_) => { }
        Failure(_) => Panic("Write failed")
    }
    match WriteAllText("storage-demo/text.txt", "replacement", 1) {
        Failure(FileWriteError.TooLarge) => { }
        _ => Panic("Write bound was ignored")
    }
    match ReadAllText("storage-demo/text.txt", 16) {
        Ok(let text) => {
            if text != "värld" {
                Panic("Rejected write changed the file")
            }
        }
        Failure(_) => Panic("Read failed")
    }
    match ReadAllText("storage-demo/text.txt", 1) {
        Failure(FileReadError.TooLarge) => { }
        _ => Panic("Read bound was ignored")
    }
    match ReadAllText("storage-demo/missing.txt", 16) {
        Failure(FileReadError.NotFound) => { }
        _ => Panic("Missing file status was lost")
    }
    Console.WriteLine("Native bounded file text passed")
}
