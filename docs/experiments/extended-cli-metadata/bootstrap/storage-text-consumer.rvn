import System.*
import System.Result.*
import System.Storage.*
import System.Storage.FileText.*

func Main() {
    match WriteAllText("storage-demo/text.txt", "värld", 16) {
        Ok(_) => { }
        Error(_) => System.Fail("Write failed")
    }
    match WriteAllText("storage-demo/text.txt", "replacement", 1) {
        Error(FileWriteError.TooLarge) => { }
        _ => System.Fail("Write bound was ignored")
    }
    match ReadAllText("storage-demo/text.txt", 16) {
        Ok(let text) => {
            if text != "värld" {
                System.Fail("Rejected write changed the file")
            }
        }
        Error(_) => System.Fail("Read failed")
    }
    match ReadAllText("storage-demo/text.txt", 1) {
        Error(FileReadError.TooLarge) => { }
        _ => System.Fail("Read bound was ignored")
    }
    match ReadAllText("storage-demo/missing.txt", 16) {
        Error(FileReadError.NotFound) => { }
        _ => System.Fail("Missing file status was lost")
    }
    Console.WriteLine("Native bounded file text passed")
}
