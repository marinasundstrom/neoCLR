import System.*
import System.Concurrency.Tasks.*
import System.Result.*

func Forward(input: Task<Result<int, string>>) -> Task<Result<int, string>> => input

class Reader {
    private var resumed: int = 0

    async func Read(input: Task<Result<int, string>>) -> Task<Result<int, string>> {
        let value = await Forward(input)?
        resumed = resumed + 1
        return Ok(value + 1)
    }

    val Resumed: int => resumed
}

func Main() {
    let reader = Reader()
    let source = Promise<Result<int, string>>()
    let pending = reader.Read(source.Task)
    if pending.IsCompleted {
        Panic("Propagation completed before await")
    }
    _ = source.Complete(Ok(41))
    TaskQueue.Default.Drain()
    if pending.GetResult() is Ok(let value) {
        if value != 42 || reader.Resumed != 1 {
            Panic("Successful await propagation lost its value")
        }
    } else {
        Panic("Successful await propagated an error")
    }
    let failed = Promise<Result<int, string>>()
    let error = reader.Read(failed.Task)
    _ = failed.Complete(Failure("expected"))
    TaskQueue.Default.Drain()
    if error.GetResult() is Failure(let message) {
        if message != "expected" || reader.Resumed != 1 {
            Panic("Error propagation continued past the return")
        }
    } else {
        Panic("Await error was lost")
    }
    Console.WriteLine("Native async propagation checks passed")
}
