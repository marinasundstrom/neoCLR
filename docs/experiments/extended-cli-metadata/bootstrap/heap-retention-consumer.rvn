import System.*

alias Heap = System.Runtime.GC

class Box {
    var Value: int = 0
}

func Main() {
    let before = Heap.CollectionCount
    let allocated = Heap.AllocatedObjectCount
    let reclaimed = Heap.ReclaimedObjectCount
    let box = Box()
    let same = box
    box.Value = 42
    Heap.Collect()
    Heap.KeepAlive(box)
    if Heap.CollectionCount <= before {
        Panic("Explicit collection was not recorded")
    }
    if Heap.AllocatedObjectCount < allocated || Heap.ReclaimedObjectCount < reclaimed {
        Panic("Heap counters moved backwards")
    }
    if Heap.HeapObjectCount > Heap.PeakHeapObjectCount || Heap.HeapObjectCount > Heap.HeapObjectLimit {
        Panic("Heap count exceeds its bounds")
    }
    if box.Value != 42 || !Object.ReferenceEquals(box, same) {
        Panic("Collection changed a live object's contents or identity")
    }
    same.Value = 73
    if box.Value != 73 {
        Panic("Shared object identity was lost")
    }
    Console.WriteLine("Native source heap passed")
}
