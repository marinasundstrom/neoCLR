import System.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

async func SendReport(client: HttpClient, url: string, text: string) -> Task<Result<HttpClientResponse, HttpError>> {
    let request = HttpClientRequest.Post(url, HttpStringContent(text))?
    let acceptsText = request.WithHeader("Accept", "text/plain")?
    let identified = acceptsText.WithHeader("X-Request-Id", "sample-42")?
    return await client.Send(identified)
}
