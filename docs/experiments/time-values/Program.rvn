import System.*
import System.Time.*
import System.Collections.*
import System.Result.*

record struct Generic<T>(Value: T)

func Check(condition: bool, message: string) {
    if !condition {
        System.Fail(message)
    }
}

func DateOf(day: int) -> Date {
    let Ok(value) = Date.FromDayNumber(day) else { System.Fail("date factory") }
    return value
}
func TimeOf(ticks: long) -> TimeOfDay {
    let Ok(value) = TimeOfDay.FromTicks(ticks) else { System.Fail("time factory") }
    return value
}
func OffsetOf(seconds: int) -> TimeOffset {
    let Ok(value) = TimeOffset.FromSeconds(seconds) else { System.Fail("offset factory") }
    return value
}

record struct DateRecord(Value: Date)

func CheckDate(value: Date, same: Date, greater: Date) {
    Check(value.Equals(same) && !value.Equals(greater), "Date typed equality")
    Check(value.GetHashCode() == same.GetHashCode(), "Date equal hashes")
    let equatable: EquatableTo<Date> = value
    Check(equatable.Equals(same) && !equatable.Equals(greater), "Date equality interface")
    let comparable: ComparableTo<Date> = value
    Check(comparable.CompareTo(same) == 0 && comparable.CompareTo(greater) < 0 && greater.CompareTo(value) > 0, "Date ordering")
    let boxed: Object = value
    let second: Object = same
    Check(boxed.Equals(second) && second.Equals(boxed), "Date separate boxes")
    Check(!boxed.Equals(greater) && !boxed.Equals(null) && !boxed.Equals(0), "Date boxed type and null checks")
    Check(boxed.GetHashCode() == value.GetHashCode(), "Date boxed hash")
    let wrapper = DateRecord(value)
    Check(wrapper == DateRecord(same) && wrapper != DateRecord(greater), "Date record")
    Check(wrapper.GetHashCode() == DateRecord(same).GetHashCode(), "Date record hash")
    let generic = Generic<Date>(value)
    Check(generic == Generic<Date>(same) && generic != Generic<Date>(greater), "Date generic")
    Check(generic.GetHashCode() == Generic<Date>(same).GetHashCode(), "Date generic hash")
    Check(Generic<Object>(boxed) == Generic<Object>(second) && Generic<Object>(boxed) != Generic<Object>(greater), "Date erased generic")
    let pair = KeyValuePair<Date, int>(value, 3)
    Check(pair == KeyValuePair<Date, int>(same, 3) && pair != KeyValuePair<Date, int>(greater, 3), "Date imported pair")
}

