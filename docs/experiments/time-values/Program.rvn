record struct LocalDateTimeRecord(Value: LocalDateTime)

func CheckLocalDateTime(value: LocalDateTime, same: LocalDateTime, greater: LocalDateTime) {
    Check(value.Equals(same) && !value.Equals(greater), "LocalDateTime typed equality")
    Check(value.GetHashCode() == same.GetHashCode(), "LocalDateTime equal hashes")
    let equatable: EquatableTo<LocalDateTime> = value
    Check(equatable.Equals(same) && !equatable.Equals(greater), "LocalDateTime equality interface")
    let comparable: ComparableTo<LocalDateTime> = value
    Check(comparable.CompareTo(same) == 0 && comparable.CompareTo(greater) < 0 && greater.CompareTo(value) > 0, "LocalDateTime ordering")
    let boxed: Object = value
    let second: Object = same
    Check(boxed.Equals(second) && second.Equals(boxed), "LocalDateTime separate boxes")
    Check(!boxed.Equals(greater) && !boxed.Equals(null) && !boxed.Equals(0), "LocalDateTime boxed type and null checks")
    Check(boxed.GetHashCode() == value.GetHashCode(), "LocalDateTime boxed hash")
    let wrapper = LocalDateTimeRecord(value)
    Check(wrapper == LocalDateTimeRecord(same) && wrapper != LocalDateTimeRecord(greater), "LocalDateTime record")
    Check(wrapper.GetHashCode() == LocalDateTimeRecord(same).GetHashCode(), "LocalDateTime record hash")
    let generic = Generic<LocalDateTime>(value)
    Check(generic == Generic<LocalDateTime>(same) && generic != Generic<LocalDateTime>(greater), "LocalDateTime generic")
    Check(generic.GetHashCode() == Generic<LocalDateTime>(same).GetHashCode(), "LocalDateTime generic hash")
    Check(Generic<Object>(boxed) == Generic<Object>(second) && Generic<Object>(boxed) != Generic<Object>(greater), "LocalDateTime erased generic")
    let pair = KeyValuePair<LocalDateTime, int>(value, 3)
    Check(pair == KeyValuePair<LocalDateTime, int>(same, 3) && pair != KeyValuePair<LocalDateTime, int>(greater, 3), "LocalDateTime imported pair")
}

func Main() {
    CheckDate(DateOf(0), DateOf(0), DateOf(1))
    CheckDate(DateOf(3652057), DateOf(3652057), DateOf(3652058))
    CheckTimeOfDay(TimeOf(0), TimeOf(0), TimeOf(1))
    CheckTimeOfDay(TimeOf(863999999998L), TimeOf(863999999998L), TimeOf(863999999999L))
    CheckTimeOfDay(TimeOf(1), TimeOf(1), TimeOf(4294967297L))
    CheckInstant(Instant.FromUnixTimeTicks(-9223372036854775807L - 1L), Instant.FromUnixTimeTicks(-9223372036854775807L - 1L), Instant.FromUnixTimeTicks(9223372036854775807L))
    CheckInstant(Instant.FromUnixTimeTicks(-1), Instant.FromUnixTimeTicks(-1), Instant.FromUnixTimeTicks(0))
    CheckInstant(Instant.FromUnixTimeTicks(1), Instant.FromUnixTimeTicks(1), Instant.FromUnixTimeTicks(4294967297L))
    CheckTimeOffset(OffsetOf(-64800), OffsetOf(-64800), OffsetOf(64800))
    CheckTimeOffset(OffsetOf(0), OffsetOf(0), OffsetOf(1))
    let start = LocalDateTime.Create(DateOf(0), TimeOf(0))
    let nextTick = LocalDateTime.Create(DateOf(0), TimeOf(1))
    CheckLocalDateTime(start, start, nextTick)
    let endDay = LocalDateTime.Create(DateOf(0), TimeOf(863999999999L))
    let nextDay = LocalDateTime.Create(DateOf(1), TimeOf(0))
    CheckLocalDateTime(endDay, endDay, nextDay)
    CheckLocalDateTime(LocalDateTime.Create(DateOf(3652058), TimeOf(863999999998L)), LocalDateTime.Create(DateOf(3652058), TimeOf(863999999998L)), LocalDateTime.Create(DateOf(3652058), TimeOf(863999999999L)))
    let dateDefault: Date = default
    let timeDefault: TimeOfDay = default
    let instantDefault: Instant = default
    let offsetDefault: TimeOffset = default
    let localDefault: LocalDateTime = default
    Check(dateDefault.Equals(DateOf(0)) && timeDefault.Equals(TimeOf(0)), "civil defaults")
    Check(instantDefault.Equals(Instant.FromUnixTimeTicks(0)) && offsetDefault.Equals(TimeOffset.Zero), "timeline defaults")
    Check(localDefault.Equals(start), "local default")
    let zeroInstant = Instant.FromUnixTimeTicks(0)
    let collision = Instant.FromUnixTimeTicks(4294967297L)
    Check(zeroInstant.GetHashCode() == collision.GetHashCode() && !zeroInstant.Equals(collision), "hash collision is not equality")
    Check(TimeOf(1).GetHashCode() != TimeOf(4294967297L).GetHashCode(), "high time bits")
    Check(start.GetHashCode() != nextTick.GetHashCode() && start.GetHashCode() != nextDay.GetHashCode(), "both local fields hashed")
    let instantBox: Object = zeroInstant
    Check(!instantBox.Equals(Duration.FromTicks(0)), "different tick value types")
    Console.WriteLine("PASS time values")
}
