record struct InstantRecord(Value: Instant)

func CheckInstant(value: Instant, same: Instant, greater: Instant) {
    Check(value.Equals(same) && !value.Equals(greater), "Instant typed equality")
    Check(value.GetHashCode() == same.GetHashCode(), "Instant equal hashes")
    let equatable: EquatableTo<Instant> = value
    Check(equatable.Equals(same) && !equatable.Equals(greater), "Instant equality interface")
    let comparable: ComparableTo<Instant> = value
    Check(comparable.CompareTo(same) == 0 && comparable.CompareTo(greater) < 0 && greater.CompareTo(value) > 0, "Instant ordering")
    let boxed: Object = value
    let second: Object = same
    Check(boxed.Equals(second) && second.Equals(boxed), "Instant separate boxes")
    Check(!boxed.Equals(greater) && !boxed.Equals(null) && !boxed.Equals(0), "Instant boxed type and null checks")
    Check(boxed.GetHashCode() == value.GetHashCode(), "Instant boxed hash")
    let wrapper = InstantRecord(value)
    Check(wrapper == InstantRecord(same) && wrapper != InstantRecord(greater), "Instant record")
    Check(wrapper.GetHashCode() == InstantRecord(same).GetHashCode(), "Instant record hash")
    let generic = Generic<Instant>(value)
    Check(generic == Generic<Instant>(same) && generic != Generic<Instant>(greater), "Instant generic")
    Check(generic.GetHashCode() == Generic<Instant>(same).GetHashCode(), "Instant generic hash")
    Check(Generic<Object>(boxed) == Generic<Object>(second) && Generic<Object>(boxed) != Generic<Object>(greater), "Instant erased generic")
    let pair = KeyValuePair<Instant, int>(value, 3)
    Check(pair == KeyValuePair<Instant, int>(same, 3) && pair != KeyValuePair<Instant, int>(greater, 3), "Instant imported pair")
}

