import System.*
import System.Result.*
import System.Optional.*

func Check(value: bool, message: string) {
    if !value {
        Panic(message)
    }
}

func Read(reader: ConsoleKeyReader) -> ConsoleKeyInfo {
    let Ok(Some(info)) = reader.ReadKey() else {
        Panic("expected key")
    }
    return info
}

func Scalar(info: ConsoleKeyInfo, expected: int) {
    let Some(value) = info.TextScalar else {
        Panic("expected scalar")
    }
    Check(value == expected, "scalar value")
}

func Main(args: string[]) {
    let mode = args[0]
    if mode == "redirected" {
        let Failure(ConsoleKeyError.Unavailable) = Console.OpenKeyInput() else {
            Panic("redirected input must reject key acquisition")
        }
        Console.WriteLine("PASS")
        return
    }
    if mode == "text-first" {
        let Ok(Some(_)) = Console.PeekChar() else {
            Panic("peek")
        }
        let Failure(ConsoleKeyError.Busy) = Console.OpenKeyInput() else {
            Panic("text cursor must retain ownership")
        }
        let Ok(Some(text)) = Console.ReadLine() else {
            Panic("line")
        }
        Check(text == "abc", "peek retained")
        Console.WriteLine("PASS")
        return
    }
    let Ok(keys) = Console.OpenKeyInput(true) else {
        Panic("open key input")
    }
    // Deliberately omit use in this mode to exercise invocation fault cleanup.
    if mode == "fault" {
        Panic("key session fault cleanup")
    }
    use scope = keys
    let Failure(ConsoleKeyError.Busy) = Console.OpenKeyInput() else {
        Panic("exclusive keys")
    }
    let Failure(_) = Console.ReadByte() else {
        Panic("text cannot steal keys")
    }
    Console.WriteLine("READY")
    if mode == "handoff" {
        let Failure(ConsoleKeyError.InvalidUtf8) = keys.ReadKey() else {
            Panic("handoff invalid UTF8")
        }
        let Ok(_) = keys.Close() else {
            Panic("handoff close")
        }
        Console.WriteLine("TEXT")
        let Ok(Some(text)) = Console.ReadLine() else {
            Panic("handoff line")
        }
        Check(text == "ztail", "retained byte before text")
        Console.WriteLine("PASS")
        return
    }
    if mode == "baseline" || mode == "allocation" {
        var index = 0
        while index < 128 {
            if mode == "allocation" {
                Scalar(Read(keys), 97)
            }
            index += 1
        }
    } else {
        let a = Read(keys)
        Check((int)a.Key == 65 && !a.Shift && !a.Control && !a.Alt, "letter")
        Scalar(a, 97)
        let control = Read(keys)
        Check((int)control.Key == 67 && control.Control, "Ctrl+C capture")
        let arrow = Read(keys)
        Check((int)arrow.Key == 259 && arrow.Control && arrow.Shift, "modified arrow")
        Scalar(Read(keys), 233)
        Scalar(Read(keys), 128512)
        let alt = Read(keys)
        Check(alt.Alt, "Alt text")
        Scalar(alt, 120)
        Check((int)Read(keys).Key == 27, "standalone Escape")
        let Failure(ConsoleKeyError.UnsupportedSequence) = keys.ReadKey() else {
            Panic("unsupported sequence")
        }
        let Failure(ConsoleKeyError.InvalidUtf8) = keys.ReadKey() else {
            Panic("invalid UTF8")
        }
        // The invalid continuation byte is the following 'z'. Closing hands it back.
    }
    let Ok(_) = keys.Close() else {
        Panic("close keys")
    }
    let Failure(ConsoleKeyError.Closed) = keys.ReadKey() else {
        Panic("closed keys")
    }
    if mode == "keys" {
        let Ok(reopened) = Console.OpenKeyInput() else {
            Panic("reopen keys")
        }
        use next = reopened
        Scalar(Read(reopened), 122)
        let Ok(_) = reopened.Close() else {
            Panic("close reopened")
        }
        Console.WriteLine("TEXT")
        let Ok(Some(text)) = Console.ReadLine() else {
            Panic("text after keys")
        }
        Check(text == "tail", "text handoff")
    }
    Console.WriteLine("PASS")
}
