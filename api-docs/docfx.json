{
  "metadata": [
    {
      "src": [
        {
          "src": "../target/api-docs/input",
          "files": [
            "NeoCLR.CoreProbe.dll"
          ]
        }
      ],
      "dest": "api",
      "filter": "filter.yml",
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "*.md",
          "toc.yml",
          "api/*.yml"
        ],
        "exclude": [
          "README.md"
        ]
      },
      {
        "src": "namespaces",
        "files": [
          "*.md"
        ],
        "dest": "api"
      }
    ],
    "output": "../target/website/docs",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appTitle": "neoCLR API reference",
      "_appName": "neoCLR",
      "_appFooter": "Experimental application platform \u00b7 Preview 9 API \u00b7 C#/VB signatures are metadata notation",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "en",
      "_appLogoPath": "images/mark.svg"
    },
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ]
  }
}
