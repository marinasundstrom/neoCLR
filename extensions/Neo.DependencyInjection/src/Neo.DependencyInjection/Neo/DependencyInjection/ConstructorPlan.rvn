module Neo.DependencyInjection

import System.*
import System.Diagnostics.CodeAnalysis.*
import System.Collections.*
import System.Introspection.*
import System.Optional.*
import System.Result.*
import System.Runtime.Reflection.*

/// Reasons automatic constructor activation cannot prepare or invoke an implementation.
public enum ActivationError {
    UnsupportedType
    MissingConstructor
    AmbiguousConstructor
    InvocationFailed
}

internal class ConstructorPlan {
    private val constructor: ConstructorInfo
    private val storedParameters: Sequence<ParameterInfo>

    private init(selected: ConstructorInfo) {
        constructor = selected
        storedParameters = selected.GetParameters()
    }

    internal val ParameterCount: int => storedParameters.Count

    // Availability is metadata-only: never resolve services while choosing a constructor.
    internal static func Prepare([DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicConstructors)] type: TypeInfo, available: (TypeInfo) -> bool) -> Result<ConstructorPlan, ActivationError> {
        if type.IsAbstract || type.IsInterface || type.ContainsGenericParameters || type.IsValueType {
            return Failure(ActivationError.UnsupportedType)
        }
        let constructors = type.GetConstructors()
        var selected: Optional<ConstructorInfo> = None
        var count = -1
        for candidate in constructors {
            if !candidate.IsPublic || candidate.IsStatic {
                continue
            }
            let parameters = candidate.GetParameters()
            var usable = true
            for parameter in parameters {
                if !available(parameter.ParameterType) {
                    usable = false
                }
            }
            if usable && parameters.Count > count {
                selected = Some(candidate)
                count = parameters.Count
            }
        }
        let Some(best) = selected else {
            return Failure(ActivationError.MissingConstructor)
        }
        let bestParameters = best.GetParameters()
        // Like the default .NET container, another applicable constructor is
        // ambiguous if it requires a service type absent from the chosen one.
        for candidate in constructors {
            if candidate.DefinitionIndex == best.DefinitionIndex || !candidate.IsPublic || candidate.IsStatic {
                continue
            }
            let parameters = candidate.GetParameters()
            var usable = true
            var subset = true
            for parameter in parameters {
                if !available(parameter.ParameterType) {
                    usable = false
                }
                var found = false
                for bestParameter in bestParameters {
                    if parameter.ParameterType.Equals(bestParameter.ParameterType) {
                        found = true
                    }
                }
                if !found {
                    subset = false
                }
            }
            if usable && !subset {
                return Failure(ActivationError.AmbiguousConstructor)
            }
        }
        return Ok(ConstructorPlan(best))
    }

    internal func ParameterType(index: int) -> TypeInfo => storedParameters[index].ParameterType

    internal func Invoke(arguments: Object?[]) -> Result<Object, ActivationError> {
        if constructor.Invoke(arguments) is Ok(let instance) { return Ok(instance) }
        return Failure(ActivationError.InvocationFailed)
    }

}
