module Neo.Localization

import System.*
import System.Optional.*

/// Lookup-first composite formatting. Missing resources are never interpreted as format strings.
/// Find is safe for missing keys; invalid composite templates retain String.Format's fault behavior.
/// Fixed argument overloads avoid allocating an argument array (value arguments can still box).
public extension LocalizerFormatting for Localizer {
    /// Resolves the key, then formats the translation; returns the key unchanged when absent.
    val self[key: string, arg0: object?]: string {
        get {
            if self.Find(key) is Some(let template) {
                return String.Format(self.Culture, template, arg0)
            }
            return self[key]
        }
    }

    /// Resolves and formats a translation, or returns None without formatting when missing.
    func Find(key: string, arg0: object?) -> Optional<string> {
        if self.Find(key) is Some(let template) {
            return Some(String.Format(self.Culture, template, arg0))
        }
        return None
    }

    /// Resolves the key, then formats the translation; returns the key unchanged when absent.
    val self[key: string, arg0: object?, arg1: object?]: string {
        get {
            if self.Find(key) is Some(let template) {
                return String.Format(self.Culture, template, arg0, arg1)
            }
            return self[key]
        }
    }

    /// Resolves and formats a translation, or returns None without formatting when missing.
    func Find(key: string, arg0: object?, arg1: object?) -> Optional<string> {
        if self.Find(key) is Some(let template) {
            return Some(String.Format(self.Culture, template, arg0, arg1))
        }
        return None
    }

    /// Resolves the key, then formats the translation; returns the key unchanged when absent.
    val self[key: string, arg0: object?, arg1: object?, arg2: object?]: string {
        get {
            if self.Find(key) is Some(let template) {
                return String.Format(self.Culture, template, arg0, arg1, arg2)
            }
            return self[key]
        }
    }

    /// Resolves and formats a translation, or returns None without formatting when missing.
    func Find(key: string, arg0: object?, arg1: object?, arg2: object?) -> Optional<string> {
        if self.Find(key) is Some(let template) {
            return Some(String.Format(self.Culture, template, arg0, arg1, arg2))
        }
        return None
    }

    /// Resolves the key, then formats the translation; returns the key unchanged when absent.
    val self[key: string, params arguments: object?[]]: string {
        get {
            if self.Find(key) is Some(let template) {
                return String.Format(self.Culture, template, arguments)
            }
            return self[key]
        }
    }

    /// Resolves and formats a translation, or returns None without formatting when missing.
    func Find(key: string, params arguments: object?[]) -> Optional<string> {
        if self.Find(key) is Some(let template) {
            return Some(String.Format(self.Culture, template, arguments))
        }
        return None
    }

}
