module Neo.Configuration.Tests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedReloadTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main(args: string[]) -> Task<int> {
    if args.Length != 1 { Panic("Expected fixture directory") }
    // Await the combined lifecycle before reporting its result; preserve READY phases.
    let completed = CompletedReloadTest(await `JSON reload is opt in and updates DI consumers while preserving valid data`(args[0]))
    let suite = TestSuite()
    suite.Add("configuration-reload", "JSON reload is opt in and updates DI consumers while preserving valid data", completed.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
