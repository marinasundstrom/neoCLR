module Neo.Configuration

import Neo.Configuration.Json.*

/// Registers JSON sources. Files are read when Build or Reload calls provider Load.
public extension JsonConfigurationExtensions for ConfigurationBuilder {
    /// Adds a JSON file; optional missing-file handling and automatic reload are off by default.
    func AddJsonFile(path: string, optional: bool = false, reloadOnChange: bool = false) -> ConfigurationBuilder => self.Add(JsonConfigurationSource(path, optional, reloadOnChange))
}
