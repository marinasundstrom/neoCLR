module NeoClr.WebTests

import System.*
import System.Result.*
import Neo.Web.*
import NeoClr.Testing.*

// Exercise the member through an imported open generic union, not only closed cases.
func StatusOf<T>(result: HttpResult<T>) -> int => result.StatusCode

[Test]
func `Typed results preserve content and exhaustively describe response alternatives`() -> Result<unit, TestFailure> {
    let created = HttpResult<string>.Created("created")
    let number = HttpResult<int>.Ok(42)
    let actual = match number {
        HttpResult<int>.Ok(let value) => value
        _ => 0
    }
    _ = Assert.Equal(42, actual)?
    _ = Assert.Equal(200, number.StatusCode)?
    _ = Assert.Equal(200, StatusOf(number))?
    _ = Assert.Equal(201, created.StatusCode)?
    _ = Assert.Equal(201, StatusOf(created))?
    _ = Assert.Equal(404, StatusOf(HttpResult<string>.NotFound))?
    return Assert.Equal(400, StatusOf(HttpResult<string>.BadRequest))
}
