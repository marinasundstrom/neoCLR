module Neo.Web

import System.*
import System.Result.*

/// Closed HTTP outcomes with a statically typed success payload.
/// The experimental endpoint adapter writes string payloads as UTF-8 text/plain.
public union HttpResult<T> {
    /// A 200 response carrying a typed payload.
    case Ok(value: T)
    /// A 201 response carrying a typed payload.
    case Created(value: T)
    /// An empty 400 response.
    case BadRequest
    /// An empty 404 response.
    case NotFound

    /// The HTTP status code projected from the active case: 200, 201, 400 or 404.
    /// Available for every payload type; reading it does not execute or serialize the result.
    val StatusCode: int => match self {
        HttpResult<T>.Ok(_) => 200
        HttpResult<T>.Created(_) => 201
        HttpResult<T>.BadRequest => 400
        HttpResult<T>.NotFound => 404
    }
}

internal static class HttpResultWriter {
    static func Write(result: HttpResult<string>, context: HttpContext) {
        match result {
            HttpResult<string>.Ok(let value) => context.RespondText(result.StatusCode, value)
            HttpResult<string>.Created(let value) => context.RespondText(result.StatusCode, value)
            HttpResult<string>.BadRequest => context.Respond(result.StatusCode)
            HttpResult<string>.NotFound => context.Respond(result.StatusCode)
        }
    }
}
