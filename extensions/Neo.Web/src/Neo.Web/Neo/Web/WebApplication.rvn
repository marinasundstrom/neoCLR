module Neo.Web

import System.*
import System.Collections.*
import System.Result.*
import System.Optional.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import Neo.Configuration.*
import Neo.DependencyInjection.*
import Neo.Logging.*
import System.Web.Http.*
import Neo.Web.HttpContext

/// A single-run, cooperative HTTP application. Stop and await RunAsync before disposal.
public class WebApplication : Disposable {
    private var middleware = ArrayList<WebMiddleware>()
    private var pipeline: WebRequestPipeline? = null
    private var endpoints = ArrayList<WebEndpoint>()
    private val emptyRoute: RouteMatch
    private var terminal: WebEndpoint? = null
    private val validator: RoutePattern
    private val ownedLogging: LoggerFactory
    private val logger: Logger
    private val address: string
    private val port: int
    private val backlog: int
    private val stopping = CancellationTokenSource()
    private var server: HttpServer? = null
    private var started = false
    private var running = false
    private var disposed = false

    /// Root service provider; request handlers should resolve scoped services from Neo.Web.HttpContext.Services.
    val Services: ServiceProvider
    /// Application-owned live configuration root, disposed after services.
    val Configuration: ConfigurationRoot

    internal init(services: ServiceProvider, configuration: ConfigurationRoot, logging: LoggerFactory,
        logger: Logger, address: string, port: int, backlog: int) {
        Services = services
        Configuration = configuration
        ownedLogging = logging
        self.logger = logger
        self.address = address
        self.port = port
        self.backlog = backlog
        validator = RoutePattern.Parse("/")!
        let Some(route) = validator.Match("/")! else { Panic("Empty route match unavailable") }
        emptyRoute = route
    }

    /// Creates an empty configuration/default-DI builder with an empty Information-level logger factory.
    static func CreateBuilder() -> WebApplicationBuilder => WebApplicationBuilder()

    /// Registers a context callback. Invalid methods/patterns and equal-precedence overlaps are rejected atomically.
    /// Registration freezes on RunAsync; literal segments outrank captures, independent of registration order.
    func MapContext(method: string, pattern: string,
        handler: (HttpContext) -> Task<Result<unit, WebError>>) -> Result<unit, WebError> {
        if started || disposed { return Failure(WebError.InvalidState) }
        let parsedMethod = HttpMethod.Parse(method)
        if let Failure(error) = parsedMethod { return Failure(WebError.Transport(error)) }
        return Register(parsedMethod!, pattern, handler)
    }

    /// Registers a fixed context handler for every HTTP method matching this route pattern.
    /// A method-specific endpoint wins at equal route precedence; equal all-method overlaps reject.
    func Map(pattern: string, handler: (HttpContext) -> Task<Result<unit, WebError>>) -> Result<unit, WebError> {
        return Register(null, pattern, handler)
    }

    /// Registers the terminal context handler for requests left unmatched by routing.
    /// This configures the request pipeline; RunAsync controls application lifetime.
    /// Only one terminal handler is allowed. Malformed targets and method mismatches retain 400/405.
    func Run(handler: (HttpContext) -> Task<Result<unit, WebError>>) -> Result<unit, WebError> {
        if started || disposed || terminal is not null { return Failure(WebError.InvalidState) }
        terminal = WebEndpoint(null, validator, "/", handler)
        return Ok(())
    }

    private func Register(method: HttpMethod?, pattern: string,
        handler: (HttpContext) -> Task<Result<unit, WebError>>) -> Result<unit, WebError> {
        if started || disposed { return Failure(WebError.InvalidState) }
        let parsed = RoutePattern.Parse(pattern)
        if let Failure(patternError) = parsed { return Failure(WebError.Routing(patternError)) }
        let endpoint = WebEndpoint(method, parsed!, pattern, handler)
        for existing in endpoints {
            var sameMethod = existing.Method is null && method is null
            if existing.Method is HttpMethod previous && method is HttpMethod current {
                sameMethod = previous.Equals(current)
            }
            if sameMethod && existing.Priority == endpoint.Priority && existing.Pattern.Overlaps(endpoint.Pattern) {
                return Failure(WebError.Routing("Ambiguous route: " + pattern))
            }
        }
        endpoints.Add(endpoint)
        return Ok(())
    }

    /// Returns this application on success. Adds middleware in registration order. Await next(context) to continue, or return to short-circuit.
    /// Pass the supplied context to next and await it at most once; do not retain the continuation.
    /// The request scope remains alive until the outermost middleware settles. Registration freezes on RunAsync.
    func Use(handler: (HttpContext, (HttpContext) -> Task<Result<unit, WebError>>) -> Task<Result<unit, WebError>>) -> Result<WebApplication, WebError> {
        if started || disposed { return Failure(WebError.InvalidState) }
        middleware.Add(WebMiddleware(handler))
        return Ok(self)
    }

    /// Returns this application on success. Registers a DI-backed stage with the same ordering and next contract as Use(handler).
    /// Register T in Services before Build. It is resolved from each request's
    /// scope only when reached; activation errors follow the existing sanitized 500 path.
    /// Service lifetime and disposal follow DI registration. Registration freezes on RunAsync.
    func UseMiddleware<T: Middleware>() -> Result<WebApplication, WebError> {
        if started || disposed { return Failure(WebError.InvalidState) }
        let stage = ServiceMiddleware<T>()
        return Use(stage.InvokeAsync)
    }

    private func BuildPipeline() -> WebRequestPipeline {
        var current = WebRequestPipeline(self.Route)
        var index = middleware.Count
        while index > 0 {
            index -= 1
            let step = BoundWebMiddleware(middleware[index].Handler, current.Handler)
            current = WebRequestPipeline(step.Invoke)
        }
        return current
    }

    /// Registers a GET function value. Reflection and binding planning happen once at registration.
    /// Binds HttpContext, named string/int route parameters and request-scoped services.
    func MapGet<T: func>(pattern: string, handler: T) -> Result<unit, WebError> {
        return Map("GET", pattern, handler)
    }

    /// Registers a POST function value with the same binding and typed-result contract as MapGet.
    func MapPost<T: func>(pattern: string, handler: T) -> Result<unit, WebError> {
        return Map("POST", pattern, handler)
    }

    private func Map<T: func>(method: string, pattern: string, handler: T) -> Result<unit, WebError> {
        if started || disposed { return Failure(WebError.InvalidState) }
        let plan = HandlerPlan.Create(pattern, handler, handler.Function)?
        return MapContext(method, pattern, plan.Execute)
    }

    /// Gets the listener's assigned port while running, including when configured with port zero.
    func GetLocalPort() -> Result<int, WebError> {
        if !running { return Failure(WebError.InvalidState) }
        if server is HttpServer active {
            if let Ok(value) = active.GetLocalPort() { return Ok(value) }
        }
        return Failure(WebError.InvalidState)
    }

    /// Freezes routes, opens the listener and returns its joined lifetime. Caller cancellation cancels the task.
    /// Pre-cancellation opens no socket and leaves registration available. A listen attempt consumes the application.
    func RunAsync(cancellationToken: CancellationToken = default) -> Task<Result<unit, WebError>> {
        if started || disposed {
            return Task.FromResult<Result<unit, WebError>>(Result<unit, WebError>.Failure(WebError.InvalidState))
        }
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, WebError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        started = true
        pipeline = BuildPipeline()
        let listening = HttpServer.Listen(address, port, backlog)
        if let Failure(error) = listening {
            return Task.FromResult<Result<unit, WebError>>(Result<unit, WebError>.Failure(WebError.Transport(error)))
        }
        let active = listening!
        server = active
        running = true
        let registration = cancellationToken.Register(self.Stop)
        let pending = active.Serve(self.Dispatch, cancellationToken)
        let result = Promise<Result<unit, WebError>>()
        // Outcome adapter: cancellation must clear running and release registration too.
        pending.OnCompleted(() => {
            registration.Dispose()
            stopping.Cancel()
            running = false
            if pending.IsCancelled {
                _ = result.Cancel()
            } else {
                if let Failure(error) = pending.GetResult() {
                    _ = result.Complete(Result<unit, WebError>.Failure(WebError.Transport(error)))
                } else {
                    _ = result.Complete(Result<unit, WebError>.Ok(()))
                }
            }
        })
        return result.Task
    }

    /// Closes connections and requests cooperative application cancellation; RunAsync joins started handlers.
    /// Calling Stop before RunAsync has no effect.
    func Stop() {
        if !running { return }
        stopping.Cancel()
        if server is HttpServer active { active.Close() }
    }

    private func Route(context: HttpContext) -> Task<Result<unit, WebError>> {
        let request = context.Request
        if let Failure(_) = validator.Match(request.Target) {
            context.RespondText(400, "Bad request")
            return Task.FromResult<Result<unit, WebError>>(Result<unit, WebError>.Ok(()))
        }
        var selected: WebEndpoint? = null
        var captured: RouteMatch? = null
        let allowed = ArrayList<string>()
        for endpoint in endpoints {
            let matched = endpoint.Pattern.Match(request.Target)!
            if let Some(route) = matched {
                var matchesMethod = endpoint.Method is null
                if endpoint.Method is HttpMethod required {
                    var present = false
                    for method in allowed {
                        if method == required.Method { present = true }
                    }
                    if !present { allowed.Add(required.Method) }
                    matchesMethod = required.Equals(request.Method)
                }
                if matchesMethod {
                    var choose = true
                    if selected is WebEndpoint previous {
                        choose = endpoint.Priority > previous.Priority ||
                            endpoint.Priority == previous.Priority && previous.Method is null && endpoint.Method is not null
                    }
                    if choose {
                        selected = endpoint
                        captured = route
                    }
                }
            }
        }
        if selected is WebEndpoint chosen {
            if captured is RouteMatch route {
                context.SetRouteValues(route)
                return chosen.Handler(context)
            }
        }
        if allowed.Count == 0 {
            if terminal is WebEndpoint fallback {
                return fallback.Handler(context)
            }
            context.RespondText(404, "Not found")
        } else {
            let methods: string[] = [for index in 0..allowed.Count => allowed[index]]
            context.RespondMethodNotAllowed(methods)
        }
        return Task.FromResult<Result<unit, WebError>>(Result<unit, WebError>.Ok(()))
    }

    private func Dispatch(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
        let response = HttpResponse(200, ArrayList<HttpHeader>(), HttpStringContent(""))
        let scope = Services.CreateScope()
        if let Failure(_) = scope {
            logger.LogError("Request scope creation failed")
            response.Respond(HttpStatusCode.InternalServerError, HttpStringContent("Internal server error"))
            return Task.FromResult<Result<HttpResponse, HttpError>>(Result<HttpResponse, HttpError>.Ok(response))
        }
        let view = Neo.Web.HttpContext(request, response, scope!, emptyRoute, stopping.Token)
        let pending = pipeline!.Handler(view)
        let result = Promise<Result<HttpResponse, HttpError>>()
        // Outcome adapter: release the scope on success, typed failure and cancellation.
        // All exposed response operations own buffered data before this callback settles.
        pending.OnCompleted(() => {
            let completedResponse = view.Finish()
            if pending.IsCancelled {
                completedResponse.Dispose()
                _ = result.Cancel()
            } else {
                if let Failure(error) = pending.GetResult() {
                    if error is WebError.BadRequest(_) {
                        completedResponse.Respond(HttpStatusCode.BadRequest, HttpStringContent("Bad request"))
                    } else {
                        logger.LogError("Request handler failed")
                        completedResponse.Respond(HttpStatusCode.InternalServerError, HttpStringContent("Internal server error"))
                    }
                }
                _ = result.Complete(Result<HttpResponse, HttpError>.Ok(completedResponse))
            }
        })
        return result.Task
    }

    /// Disposes services, the default logger factory and configuration, in that order. Active disposal faults.
    func Dispose() {
        if disposed { return }
        if running { Panic("Stop and await RunAsync before disposing WebApplication") }
        disposed = true
        endpoints = ArrayList<WebEndpoint>()
        terminal = null
        middleware = ArrayList<WebMiddleware>()
        pipeline = null
        Services.Dispose()
        ownedLogging.Dispose()
        Configuration.Dispose()
        stopping.Dispose()
        server = null
    }
}

internal class WebEndpoint {
    val Method: HttpMethod?
    val Pattern: RoutePattern
    val Priority: int
    val Handler: (HttpContext) -> Task<Result<unit, WebError>>

    init(method: HttpMethod?, pattern: RoutePattern, source: string,
        handler: (HttpContext) -> Task<Result<unit, WebError>>) {
        Method = method
        Pattern = pattern
        Handler = handler
        // The validated grammar has at most sixteen segments. A literal at the first
        // differing position wins. Raw '{' starts a capture; escaped braces are literals.
        let bytes = source.Utf8Bytes
        var priority = 0
        var segment = 0
        for index in 1..bytes.Length {
            if index == 1 || bytes[index - 1] == 47 {
                if bytes[index] != 123 { priority += 1 << (15 - segment) }
                segment += 1
            }
        }
        Priority = priority
    }
}

internal class WebRequestPipeline {
    val Handler: (HttpContext) -> Task<Result<unit, WebError>>
    init(handler: (HttpContext) -> Task<Result<unit, WebError>>) { Handler = handler }
}

internal class WebMiddleware {
    val Handler: (HttpContext, (HttpContext) -> Task<Result<unit, WebError>>) -> Task<Result<unit, WebError>>
    init(handler: (HttpContext, (HttpContext) -> Task<Result<unit, WebError>>) -> Task<Result<unit, WebError>>) { Handler = handler }
}

internal class BoundWebMiddleware {
    private val handler: (HttpContext, (HttpContext) -> Task<Result<unit, WebError>>) -> Task<Result<unit, WebError>>
    private val next: (HttpContext) -> Task<Result<unit, WebError>>
    init(handler: (HttpContext, (HttpContext) -> Task<Result<unit, WebError>>) -> Task<Result<unit, WebError>>,
        next: (HttpContext) -> Task<Result<unit, WebError>>) {
        self.handler = handler
        self.next = next
    }
    func Invoke(context: HttpContext) -> Task<Result<unit, WebError>> => handler(context, next)
}
