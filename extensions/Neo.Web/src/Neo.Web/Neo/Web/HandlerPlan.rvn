module Neo.Web

import System.*
import System.Concurrency.*
import System.Collections.*
import System.Concurrency.Tasks.*
import System.Introspection.*
import System.Optional.*
import System.Result.*
import System.Runtime.CompilerServices.*
import System.Runtime.Reflection.*
import System.Web.Http.*
import Neo.Web.HttpContext
import Neo.DependencyInjection.*
import System.Web.Http.Json.*

// Registration-owned metadata. Request arguments are separate for concurrent requests.
internal class HandlerParameter {
    val Kind: int
    val Name: string
    val Type: TypeInfo
    val Body: JsonBodyPlan?
    init(kind: int, name: string, type: TypeInfo, body: JsonBodyPlan?) {
        Kind = kind
        Name = name
        Type = type
        Body = body
    }
}

internal class HandlerPlan {
    private val handler: Object
    private val parameters: Sequence<HandlerParameter>
    private val resultKind: int
    private init(handler: Object, parameters: Sequence<HandlerParameter>, resultKind: int) {
        self.handler = handler
        self.parameters = parameters
        self.resultKind = resultKind
    }

    static func Create(pattern: RoutePattern, verb: HttpMethod, services: ServiceProvider, handler: Object, method: MethodInfo) -> Result<HandlerPlan, WebError> {
        if method.ContainsGenericParameters {
            return Failure(WebError.InvalidOptions("Handler must have a closed signature"))
        }
        let result = method.ReturnType
        var kind = 0
        if result.Equals(typeof(Task<HttpResult<string>>)) { kind = 1 }
        else if !result.Equals(typeof(HttpResult<string>)) {
            return Failure(WebError.InvalidOptions("Handler must return HttpResult<string> or Task<HttpResult<string>>"))
        }
        let names = pattern.GetParameterNames()
        let bindings = ArrayList<HandlerParameter>()
        var bodyCount = 0
        for parameter in method.GetParameters() {
            let type = parameter.ParameterType
            if parameter.IsOut || parameter.IsOutWhenTrue || parameter.IsReadOnly || type.IsByRef || type.ContainsGenericParameters {
                return Failure(WebError.InvalidOptions("Handler parameters must be closed values without ref/out contracts"))
            }
            // Source attributes are registration inputs, never request-time reflection.
            var source = 0
            var name = parameter.Name
            for attribute in parameter.GetCustomAttributesData() {
                var selected = 0
                if attribute.AttributeType.Equals(typeof(FromRouteAttribute)) { selected = 1 }
                else if attribute.AttributeType.Equals(typeof(FromServicesAttribute)) { selected = 2 }
                else if attribute.AttributeType.Equals(typeof(FromQueryAttribute)) { selected = 3 }
                else if attribute.AttributeType.Equals(typeof(FromBodyAttribute)) { selected = 4 }
                if selected != 0 {
                    if source != 0 {
                        return Failure(WebError.InvalidOptions("Conflicting binding sources: " + parameter.Name))
                    }
                    source = selected
                    if selected == 1 || selected == 3 {
                        for argument in attribute.GetNamedArguments() {
                            if argument.MemberName == "Name" {
                                if argument.TypedValue.Value is string explicitName {
                                    name = explicitName
                                } else if argument.TypedValue.Value is not null {
                                    return Failure(WebError.InvalidOptions("Invalid binding name: " + parameter.Name))
                                }
                            }
                        }
                    }
                }
            }
            // Kinds: service=0, context=1, route=2, query=3, body=4, request=5, response=6.
            var binding = 0
            var route = false
            for capture in names {
                if capture == name { route = true }
            }
            let scalar = type.Equals(typeof(string)) || type.Equals(typeof(int)) || type.Equals(typeof(bool))
            if source == 1 {
                if !route || !scalar { return Failure(WebError.InvalidOptions("Invalid route binding: " + parameter.Name)) }
                binding = 2
            } else if source == 3 {
                if !scalar { return Failure(WebError.InvalidOptions("Query parameter must be string, int or bool: " + parameter.Name)) }
                binding = 3
            } else if source == 4 { binding = 4 }
            else if source == 2 {
                if type.IsValueType || type.IsFunctionType || type.IsPointer {
                    return Failure(WebError.InvalidOptions("Unsupported service type: " + parameter.Name))
                }
            } else if type.Equals(typeof(HttpContext)) { binding = 1 }
            else if type.Equals(typeof(HttpServerRequest)) { binding = 5 }
            else if type.Equals(typeof(HttpServerResponse)) { binding = 6 }
            else if type.Equals(typeof(CancellationToken)) { binding = 7 }
            else if scalar { binding = if route { 2 } else { 3 } }
            else if services.IsService(type) { binding = 0 }
            else {
                if verb.Equals(HttpMethod.Get) {
                    return Failure(WebError.InvalidOptions("GET body binding requires FromBody: " + parameter.Name))
                }
                binding = 4
            }
            if binding == 4 {
                bodyCount += 1
                if bodyCount > 1 { return Failure(WebError.InvalidOptions("Only one request body parameter is supported")) }
                if type.IsFunctionType || type.IsPointer || type.IsInterface || type.IsValueType && !scalar {
                    return Failure(WebError.InvalidOptions("Unsupported body type: " + parameter.Name))
                }
            }
            var body: JsonBodyPlan? = null
            if binding == 4 { body = JsonBodyPlan.Create(type)? }
            bindings.Add(HandlerParameter(binding, name, type, body))
        }
        return Ok(HandlerPlan(handler, bindings, kind))
    }

    private async func Bind(context: HttpContext) -> Task<Result<Object?[], WebError>> {
        let arguments = CheckedStorage.Reserve<Object?>(parameters.Count)
        var query: QueryValues? = null
        var index = 0
        while index < parameters.Count {
            let parameter = parameters[index]
            if parameter.Kind == 1 { arguments[index] = context }
            else if parameter.Kind == 5 { arguments[index] = context.Request }
            else if parameter.Kind == 6 { arguments[index] = context.Response }
            else if parameter.Kind == 7 { arguments[index] = context.RequestAborted }
            else if parameter.Kind == 2 || parameter.Kind == 3 {
                var text = ""
                if parameter.Kind == 2 {
                    let Ok(value) = context.RouteValues.Get(parameter.Name) else {
                        return Failure(WebError.BadRequest("Missing route value: " + parameter.Name))
                    }
                    text = value
                } else {
                    if query is null { query = QueryValues.Parse(context.Request.Target)? }
                    text = query!.Get(parameter.Name)?
                }
                arguments[index] = ConvertScalar(text, parameter)?
            } else if parameter.Kind == 4 {
                let Ok(Some(media)) = context.Request.GetContentType() else {
                    return Failure(WebError.UnsupportedMediaType)
                }
                if media.Type != "application" || media.SubType != "json" && !(media.Suffix is Some("json")) {
                    return Failure(WebError.UnsupportedMediaType)
                }
                if let Some(charset) = media.CharSet {
                    if String.CompareOrdinalIgnoreCase(charset, "utf-8") != 0 {
                        return Failure(WebError.UnsupportedMediaType)
                    }
                }
                let read = await context.Request.Content.ReadJsonNode(context.RequestAborted)
                let Ok(value) = read else { return Failure(WebError.BadRequest("Invalid JSON body")) }
                arguments[index] = parameter.Body!.Read(value)?
            } else {
                let resolved = context.Services.GetRequiredService(parameter.Type)
                if let Failure(error) = resolved { return Failure(WebError.Services(error)) }
                arguments[index] = resolved!
            }
            index += 1
        }
        return Ok(arguments)
    }

    private static func ConvertScalar(text: string, parameter: HandlerParameter) -> Result<Object, WebError> {
        if parameter.Type.Equals(typeof(string)) { return Ok(text) }
        if parameter.Type.Equals(typeof(int)) {
            let Ok(number) = Int32.Parse(text) else {
                return Failure(WebError.BadRequest("Invalid integer: " + parameter.Name))
            }
            return Ok(number)
        }
        if String.CompareOrdinalIgnoreCase(text, "true") == 0 { return Ok(true) }
        if String.CompareOrdinalIgnoreCase(text, "false") == 0 { return Ok(false) }
        return Failure(WebError.BadRequest("Invalid boolean: " + parameter.Name))
    }

    async func Execute(context: HttpContext) -> Task<Result<unit, WebError>> {
        let arguments = (await Bind(context))?
        let invoked = FunctionReflection.Invoke(handler, arguments)
        if let Failure(_) = invoked { return Failure(WebError.InvalidOptions("Handler invocation failed")) }
        let value = invoked!
        if value is null { return Failure(WebError.InvalidOptions("Handler returned null")) }
        if resultKind == 1 && value is Task<HttpResult<string>> pendingResult {
            let result = await pendingResult
            HttpResultWriter.Write(result, context)
        } else if resultKind == 0 && value is HttpResult<string> result {
            HttpResultWriter.Write(result, context)
        } else {
            return Failure(WebError.InvalidOptions("Handler result does not match its declared contract"))
        }
        return Ok(())
    }
}
