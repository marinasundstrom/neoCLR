module Neo.Logging

import System.*
import Neo.DependencyInjection.*
import System.Result.*

/// Adds the default synchronous console provider.
public extension ConsoleLoggingExtensions for LoggerFactory {
    /// Transfers ownership of a new console provider to this factory.
    func AddConsole() {
        self.AddProvider(ConsoleLoggerProvider())
    }
}

/// DI registration for the factory and ordinary open-generic typed logger adapter.
public extension LoggingServices for ServiceCollection {
    /// Registers a container-owned default factory and singleton typed loggers; preserves overrides.
    /// The default factory has no providers. Resolve LoggerFactory and configure it at startup.
    func AddLogging() -> Result<unit, ServiceError> {
        _ = self.TryAdd(ServiceDescriptor(typeof(LoggerFactory), ServiceSource.Constructor(typeof(DefaultLoggerFactory)), ServiceLifetime.Singleton))?
        return self.RegisterTypedLoggers()
    }

    /// Registers a caller-owned factory and singleton typed loggers; preserves existing overrides.
    func AddLogging(factory: LoggerFactory) -> Result<unit, ServiceError> {
        _ = self.TryAdd(ServiceDescriptor(typeof(LoggerFactory), ServiceSource.Instance(factory), ServiceLifetime.Singleton))?
        return self.RegisterTypedLoggers()
    }

    private func RegisterTypedLoggers() -> Result<unit, ServiceError> {
        _ = self.TryAdd(ServiceDescriptor(typeof(Logger<>), ServiceSource.Constructor(typeof(DefaultLogger<>)), ServiceLifetime.Singleton))?
        return Ok(())
    }
}
