<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(NeoClrBundleRoot)/lib/NeoCLR.ClassLibrary.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Neo.Logging.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../tools/testing/NeoCLR.Testing/NeoClr/Testing/*.rvn" />
    <Compile Include="../../../../tools/testing/NeoCLR.Testing/NeoClr/RuntimeTests/Main.rvn" />
    <Compile Include="$(NeoClrTestRegistry)" />
    <Compile Include="NeoClr/RuntimeTests/*.rvn" />
  </ItemGroup>
</Project>
