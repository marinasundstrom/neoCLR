.module Arrays
.entry Main

.function Main() -> Void
    .local System.Array<Int32> values
    .local System.Array<Int32> alias
    .local Int32 index
    ldc.i4 3
    ldc.i4 10
    call System.Array<Int32>::Allocate(Int32,Int32)
    stloc values
    ldloc values
    stloc alias
    ldloc alias
    ldc.i4 1
    ldc.i4 42
    call instance System.Array<Int32>::Set(Int32,Int32)
    pop
    ldc.i4 0
    stloc index
    br Test
Print:
    ldloc values
    ldloc index
    call instance System.Array<Int32>::Get(Int32)
    call System.Console::WriteLine(Int32)
    pop
    ldloc index
    ldc.i4 1
    add
    stloc index
Test:
    ldloc index
    ldloc values
    call instance System.Array<Int32>::get_Length()
    blt Print
    ; Both descriptors name the same storage; free it exactly once.
    ldloc values
    call instance System.Array<Int32>::Free()
    ret
.end
