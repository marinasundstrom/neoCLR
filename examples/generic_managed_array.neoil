.module GenericManagedArray
.entry Main
.function Main() -> Int32
    .local System.Array<Int32> values
    ldc.i4 2
    newarr Int32
    stloc values
    ldloc values
    ldc.i4 0
    ldc.i4 42
    call instance System.Array<Int32>::set_Item(Int32,Int32)
    ldloc values
    ldc.i4 0
    call instance System.Array<Int32>::get_Item(Int32)
    ret
.end
