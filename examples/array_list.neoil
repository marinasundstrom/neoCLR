.module ArrayListDemo
.entry Main

.function Main() -> Void
    .local System.Collections.ArrayList<Int32> values
    .local System.Collections.ArrayList<Int32>& alias
    .local Int32 index
    ldc.i4 1
    call System.Collections.ArrayList<Int32>::Allocate(Int32)
    stloc values
    ldloca values
    stloc alias
    ldc.i4 0
    stloc index
    br Test
Fill:
    ; Grow through the alias. Both names address the same descriptor.
    ldloc alias
    ldloc index
    ldloc index
    mul.ovf
    call instance System.Collections.ArrayList<Int32>::Add(Int32)
    pop
    ldloc index
    ldc.i4 1
    add
    stloc index
Test:
    ldloc index
    ldc.i4 5
    blt Fill
    ldstr "ArrayList count:"
    call System.Console::WriteLine(String)
    pop
    ldloca values
    call instance System.Collections.ArrayList<Int32>::get_Count()
    call System.Console::WriteLine(Int32)
    pop
    ldc.i4 0
    stloc index
    br PrintTest
Print:
    ldloca values
    ldloc index
    call instance System.Collections.ArrayList<Int32>::get_Item(Int32)
    call System.Console::WriteLine(Int32)
    pop
    ldloc index
    ldc.i4 1
    add
    stloc index
PrintTest:
    ldloc index
    ldloca values
    call instance System.Collections.ArrayList<Int32>::get_Count()
    blt Print
    ldloca values
    call instance System.Collections.ArrayList<Int32>::Free()
    ret
.end
