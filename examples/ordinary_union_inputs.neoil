.module OrdinaryUnionInputs

.function Create(Int32 value) -> System.Result<Int32,String>
    ldarg value
    newobj instance System.Result.Ok<Int32>::.ctor(Int32)
    newobj instance System.Result<Int32,String>::.ctor(System.Result.Ok<Int32>)
    ret
.end

.function Read(System.Result<Int32,String> result) -> Int32
    ldarg result
    call instance System.Result<Int32,String>::get_IsOk()
    brfalse Failed
    ldarg result
    call instance System.Result<Int32,String>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    ret
Failed:
    ldc.i4 -1
    ret
.end
