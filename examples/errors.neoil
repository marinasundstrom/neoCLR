.module Errors
.entry Main

.function ReadPositive(String text) -> System.Result<Int32,String>
    .local System.Result<Int32,System.Int32ParseError> parsed
    .local Int32 value
    ldarg text
    call System.Int32::Parse(String)
    stloc parsed
    ldloc parsed
    call instance System.Result<Int32,System.Int32ParseError>::get_IsErrorCase()
    brtrue ParseFailed
    ldloc parsed
    call instance System.Result<Int32,System.Int32ParseError>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    stloc value
    ldloc value
    ldc.i4 0
    bgt Success
    ldstr "Expected a positive number: "
    ldarg text
    call System.String::Concat(String,String)
    newobj instance System.Result.Error<String>::.ctor(String)
    newobj instance System.Result<Int32,String>::.ctor(System.Result.Error<String>)
    ret
ParseFailed:
    ldloc parsed
    call instance System.Result<Int32,System.Int32ParseError>::GetErrorCase()
    call instance System.Result.Error<System.Int32ParseError>::get_Value()
    call instance System.Int32ParseError::ToString()
    newobj instance System.Result.Error<String>::.ctor(String)
    newobj instance System.Result<Int32,String>::.ctor(System.Result.Error<String>)
    ret
Success:
    ldloc value
    newobj instance System.Result.Ok<Int32>::.ctor(Int32)
    newobj instance System.Result<Int32,String>::.ctor(System.Result.Ok<Int32>)
    ret
.end

.function Report(System.Result<Int32,String> result) -> Void
    ldarg result
    dup
    call instance System.Result<Int32,String>::get_IsOkCase()
    brtrue Success
    call instance System.Result<Int32,String>::GetErrorCase()
    call instance System.Result.Error<String>::get_Value()
    call System.Console::WriteLine(String)
    ret
Success:
    call instance System.Result<Int32,String>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    call System.Console::WriteLine(Int32)
    ret
.end

.function Main() -> Void
    ldstr "42"
    call ReadPositive(String)
    call Report(System.Result<Int32,String>)
    pop
    ldstr "oops"
    call ReadPositive(String)
    call Report(System.Result<Int32,String>)
    pop
    ldstr "-1"
    call ReadPositive(String)
    call Report(System.Result<Int32,String>)
    pop
    ldstr "Execution continued"
    call System.Console::WriteLine(String)
    ret
.end
