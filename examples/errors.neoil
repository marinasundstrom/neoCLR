.module Errors
.entry Main

.function ReadPositive(String text) -> System.Result<Int32,Error>
    .local System.Result<Int32,Error> parsed
    .local Int32 value
    ldarg text
    call System.Int32::Parse(String)
    stloc parsed
    ldloc parsed
    call instance System.Result<Int32,Error>::get_IsErrorCase()
    brtrue ParseFailed
    ldloc parsed
    call instance System.Result<Int32,Error>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    stloc value
    ldloc value
    ldc.i4 0
    bgt Success
    ldstr "Expected a positive number: "
    ldarg text
    call System.String::Concat(String,String)
    call System.Error::FromMessage(String)
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<Int32,Error>::.ctor(System.Result.Error<Error>)
    ret
ParseFailed:
    ldloc parsed
    ret
Success:
    ldloc value
    newobj instance System.Result.Ok<Int32>::.ctor(Int32)
    newobj instance System.Result<Int32,Error>::.ctor(System.Result.Ok<Int32>)
    ret
.end

.function Report(System.Result<Int32,Error> result) -> Void
    ldarg result
    dup
    call instance System.Result<Int32,Error>::get_IsOkCase()
    brtrue Success
    call instance System.Result<Int32,Error>::GetErrorCase()
    call instance System.Result.Error<Error>::get_Value()
    call instance System.Error::ToString()
    call System.Console::WriteLine(String)
    ret
Success:
    call instance System.Result<Int32,Error>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    call System.Console::WriteLine(Int32)
    ret
.end

.function Main() -> Void
    ldstr "42"
    call ReadPositive(String)
    call Report(System.Result<Int32,Error>)
    pop
    ldstr "oops"
    call ReadPositive(String)
    call Report(System.Result<Int32,Error>)
    pop
    ldstr "-1"
    call ReadPositive(String)
    call Report(System.Result<Int32,Error>)
    pop
    ldstr "Execution continued"
    call System.Console::WriteLine(String)
    ret
.end
