.module ConsoleTyped
.entry Main

; Demonstrates the ordinary nested System.Result<System.Optional<Byte>,ConsoleReadError> Console API.
.function Main() -> Void
    .local System.Result.Ok<System.Optional<Byte>> success
    .local System.Optional.Some<Byte> some
    .local System.Result.Failure<System.ConsoleReadError> failure
    call System.Console::ReadByte()
    dup
    ldloca success
    call instance System.Result<System.Optional<Byte>,System.ConsoleReadError>::TryGet(System.Result.Ok<System.Optional<Byte>>&)
    brfalse Failed
    pop
    ldloc success
    call instance System.Result.Ok<System.Optional<Byte>>::get_Value()
    dup
    ldloca some
    call instance System.Optional<Byte>::TryGet(System.Optional.Some<Byte>&)
    brfalse EndOfInput
    pop
    ldloc some
    call instance System.Optional.Some<Byte>::get_Value()
    call System.Console::WriteLine(Int32)
    ret
Failed:
    ldloca failure
    call instance System.Result<System.Optional<Byte>,System.ConsoleReadError>::TryGet(System.Result.Failure<System.ConsoleReadError>&)
    brtrue ErrorExtracted
    fault "Expected Error case"
ErrorExtracted:
    ldloc failure
    call instance System.Result.Failure<System.ConsoleReadError>::get_Value()
    call instance System.ConsoleReadError::ToString()
    call System.Console::WriteLine(String)
    ret
EndOfInput:
    pop
    ldstr "End of input"
    call System.Console::WriteLine(String)
    ret
.end
