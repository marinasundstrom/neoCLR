.module Memory
.entry Main

.type Point
    .field X Int32
    .field Y Int32
.end

.function Main() -> Void
    .local Point* source
    .local Point* destination
    ldc.i4 1
    heap.alloc Point
    stloc source
    ldc.i4 1
    heap.alloc Point
    stloc destination

    ldloc source
    initobj Point
    ldloc source
    ldflda 0
    ldc.i4 42
    stind.i4
    ldloc destination
    ldloc source
    cpobj Point
    ldloc destination
    ldobj Point
    ldfld 0
    call System.Console::WriteLine(Int32)
    pop

    ; Fill the record with zero bytes, then copy the original byte range back.
    ldloc destination
    ldc.i4 0
    sizeof Point
    initblk
    ldloc destination
    ldloc source
    sizeof Point
    cpblk
    ldloc destination
    ldobj Point
    ldfld 0
    call System.Console::WriteLine(Int32)
    pop
    ldloc source
    heap.free
    pop
    ldloc destination
    heap.free
    ret
.end
