.module ConsoleInput
.entry Main

; Read up to nine ASCII digits, terminated by LF or EOF.
; CR is ignored so redirected CRLF input works too.
.function ReadNumber() -> System.Result<System.Option<Int32>,Error>
    .local Int32 number
    .local Int32 digits
    .local Byte byte
    ldc.i4 0
    stloc number
    ldc.i4 0
    stloc digits
Read:
    call System.Console::ReadByte()
    dup
    call instance System.Result<System.Option<Byte>,Error>::get_IsErrorCase()
    brtrue InputFailed
    call instance System.Result<System.Option<Byte>,Error>::GetOkCase()
    call instance System.Result.Ok<System.Option<Byte>>::get_Value()
    dup
    call instance System.Option<Byte>::get_IsNone()
    brtrue Eof
    call instance System.Option<Byte>::GetSomeCase()
    call instance System.Option.Some<Byte>::get_Value()
    stloc byte
    ldloc byte
    ldc.i4 13
    beq Read
    ldloc byte
    ldc.i4 10
    beq Finish
    ldloc byte
    ldc.i4 48
    blt Invalid
    ldloc byte
    ldc.i4 57
    bgt Invalid
    ldloc digits
    ldc.i4 9
    beq TooLong
    ldloc number
    ldc.i4 10
    mul
    ldloc byte
    ldc.i4 48
    sub
    add
    stloc number
    ldloc digits
    ldc.i4 1
    add
    stloc digits
    br Read
Eof:
    pop
    ldloc digits
    brtrue Finish
    newobj instance System.Option.None::.ctor()
    newobj instance System.Option<Int32>::.ctor(System.Option.None)
    newobj instance System.Result.Ok<System.Option<Int32>>::.ctor(System.Option<Int32>)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Ok<System.Option<Int32>>)
    ret
Finish:
    ldloc digits
    brfalse Empty
    ldloc number
    newobj instance System.Option.Some<Int32>::.ctor(Int32)
    newobj instance System.Option<Int32>::.ctor(System.Option.Some<Int32>)
    newobj instance System.Result.Ok<System.Option<Int32>>::.ctor(System.Option<Int32>)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Ok<System.Option<Int32>>)
    ret
InputFailed:
    call instance System.Result<System.Option<Byte>,Error>::GetErrorCase()
    call instance System.Result.Error<Error>::get_Value()
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
Invalid:
    error "Expected ASCII digits"
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
TooLong:
    error "At most nine digits"
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
Empty:
    error "Empty input"
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
.end

.function Main() -> Void
    ldstr "Enter an unsigned number (up to nine digits):"
    call System.Console::WriteLine(String)
    pop
    call ReadNumber()
    dup
    call instance System.Result<System.Option<Int32>,Error>::get_IsErrorCase()
    brtrue Failed
    call instance System.Result<System.Option<Int32>,Error>::GetOkCase()
    call instance System.Result.Ok<System.Option<Int32>>::get_Value()
    dup
    call instance System.Option<Int32>::get_IsNone()
    brtrue Eof
    call instance System.Option<Int32>::GetSomeCase()
    call instance System.Option.Some<Int32>::get_Value()
    ldc.i4 2
    mul
    call System.Console::WriteLine(Int32)
    ret
Failed:
    call instance System.Result<System.Option<Int32>,Error>::GetErrorCase()
    call instance System.Result.Error<Error>::get_Value()
    call instance System.Error::ToString()
    call System.Console::WriteLine(String)
    ret
Eof:
    pop
    ldstr "End of input"
    call System.Console::WriteLine(String)
    ret
.end
