.module ConsoleInput
.entry Main

; Read up to nine ASCII digits, terminated by LF or EOF.
; CR is ignored so redirected CRLF input works too.
.function ReadNumber() -> System.Result<System.Option<Int32>,Error>
    .local System.Result.Ok<System.Option<Byte>> success
    .local System.Option.Some<Byte> some
    .local System.Result.Error<System.IO.ConsoleReadError> failure
    .local Int32 number
    .local Int32 digits
    .local Byte byte
    ldc.i4 0
    stloc number
    ldc.i4 0
    stloc digits
Read:
    call System.Console::ReadByte()
    dup
    ldloca success
    call instance System.Result<System.Option<Byte>,System.IO.ConsoleReadError>::TryGet(System.Result.Ok<System.Option<Byte>>&)
    brfalse InputFailed
    pop
    ldloc success
    call instance System.Result.Ok<System.Option<Byte>>::get_Value()
    dup
    ldloca some
    call instance System.Option<Byte>::TryGet(System.Option.Some<Byte>&)
    brfalse Eof
    pop
    ldloc some
    call instance System.Option.Some<Byte>::get_Value()
    stloc byte
    ldloc byte
    ldc.i4 13
    beq Read
    ldloc byte
    ldc.i4 10
    beq Finish
    ldloc byte
    ldc.i4 48
    blt Invalid
    ldloc byte
    ldc.i4 57
    bgt Invalid
    ldloc digits
    ldc.i4 9
    beq TooLong
    ldloc number
    ldc.i4 10
    mul
    ldloc byte
    ldc.i4 48
    sub
    add
    stloc number
    ldloc digits
    ldc.i4 1
    add
    stloc digits
    br Read
Eof:
    pop
    ldloc digits
    brtrue Finish
    newobj instance System.Option.None::.ctor()
    newobj instance System.Option<Int32>::.ctor(System.Option.None)
    newobj instance System.Result.Ok<System.Option<Int32>>::.ctor(System.Option<Int32>)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Ok<System.Option<Int32>>)
    ret
Finish:
    ldloc digits
    brfalse Empty
    ldloc number
    newobj instance System.Option.Some<Int32>::.ctor(Int32)
    newobj instance System.Option<Int32>::.ctor(System.Option.Some<Int32>)
    newobj instance System.Result.Ok<System.Option<Int32>>::.ctor(System.Option<Int32>)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Ok<System.Option<Int32>>)
    ret
InputFailed:
    ldloca failure
    call instance System.Result<System.Option<Byte>,System.IO.ConsoleReadError>::TryGet(System.Result.Error<System.IO.ConsoleReadError>&)
    brtrue ErrorExtracted
    fault "Expected Error case"
ErrorExtracted:
    ldloc failure
    call instance System.Result.Error<System.IO.ConsoleReadError>::get_Value()
    call instance System.IO.ConsoleReadError::ToString()
    call System.Error::FromMessage(String)
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
Invalid:
    error "Expected ASCII digits"
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
TooLong:
    error "At most nine digits"
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
Empty:
    error "Empty input"
    newobj instance System.Result.Error<Error>::.ctor(Error)
    newobj instance System.Result<System.Option<Int32>,Error>::.ctor(System.Result.Error<Error>)
    ret
.end

.function Main() -> Void
    .local System.Result.Ok<System.Option<Int32>> success
    .local System.Option.Some<Int32> some
    .local System.Result.Error<Error> failure
    ldstr "Enter an unsigned number (up to nine digits):"
    call System.Console::WriteLine(String)
    pop
    call ReadNumber()
    dup
    ldloca success
    call instance System.Result<System.Option<Int32>,Error>::TryGet(System.Result.Ok<System.Option<Int32>>&)
    brfalse Failed
    pop
    ldloc success
    call instance System.Result.Ok<System.Option<Int32>>::get_Value()
    dup
    ldloca some
    call instance System.Option<Int32>::TryGet(System.Option.Some<Int32>&)
    brfalse Eof
    pop
    ldloc some
    call instance System.Option.Some<Int32>::get_Value()
    ldc.i4 2
    mul
    call System.Console::WriteLine(Int32)
    ret
Failed:
    ldloca failure
    call instance System.Result<System.Option<Int32>,Error>::TryGet(System.Result.Error<Error>&)
    brtrue ErrorExtracted
    fault "Expected Error case"
ErrorExtracted:
    ldloc failure
    call instance System.Result.Error<Error>::get_Value()
    call instance System.Error::ToString()
    call System.Console::WriteLine(String)
    ret
Eof:
    pop
    ldstr "End of input"
    call System.Console::WriteLine(String)
    ret
.end
