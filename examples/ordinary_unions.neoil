.module OrdinaryUnions
.entry Main

.function Describe(System.Result<Int32,Int32> result) -> Void
    ldarg result
    call instance System.Result<Int32,Int32>::get_IsOk()
    brfalse Failed
    ldstr "success"
    call System.Console::WriteLine(String)
    pop
    ldarg result
    call instance System.Result<Int32,Int32>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    call System.Console::WriteLine(Int32)
    ret
Failed:
    ldstr "failure"
    call System.Console::WriteLine(String)
    pop
    ldarg result
    call instance System.Result<Int32,Int32>::GetErrorCase()
    call instance System.Result.Error<Int32>::get_Value()
    call System.Console::WriteLine(Int32)
    ret
.end

.function Main() -> Void
    ldc.i4 7
    newobj instance System.Result.Ok<Int32>::.ctor(Int32)
    newobj instance System.Result<Int32,Int32>::.ctor(System.Result.Ok<Int32>)
    call Describe(System.Result<Int32,Int32>)
    pop
    ldc.i4 7
    newobj instance System.Result.Error<Int32>::.ctor(Int32)
    newobj instance System.Result<Int32,Int32>::.ctor(System.Result.Error<Int32>)
    call Describe(System.Result<Int32,Int32>)
    pop
    ldvoid
    newobj instance System.Option.Some<Void>::.ctor(Void)
    newobj instance System.Option<Void>::.ctor(System.Option.Some<Void>)
    call instance System.Option<Void>::get_IsSome()
    brfalse Invalid
    ldstr "Some<Void> is present"
    call System.Console::WriteLine(String)
    ret
Invalid:
    fault "Some<Void> lost its variant"
.end
