record Counter(Value: int) {
    readonly virtual func Read() -> int { return this.Value }
    func Add(amount: int) -> () { this.Value = this.Value + amount }
}
record OffsetCounter(Offset: int): Counter {
    readonly override func Read() -> int { return this.Value + this.Offset }
}
func Read(readonly counter: Counter&) -> int { return counter.Read() }
func Make() -> Counter& { return new OffsetCounter(20, 1) }
func Main() -> int {
    var local = OffsetCounter(19, 1)
    local.Add(1)
    return Read(&local) + Read(Make())
}
