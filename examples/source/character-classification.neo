func Main() -> int {
    let digit: char = '٧'
    if !System.Char.IsDigit(digit) { return -1 }
    if System.Char.IsAsciiDigit(digit) { return -2 }
    if !System.Char.IsAsciiDigit('7') { return -3 }
    if !System.Char.IsLetter('é') { return -4 }
    if !System.Char.IsWhiteSpace('\n') { return -5 }
    if !System.Char.IsHighSurrogate('\uD800') { return -6 }
    System.Console.WriteLine("Unicode digits, ASCII digits, letters and whitespace checked")
    return 42
}
