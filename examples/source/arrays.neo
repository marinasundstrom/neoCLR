import System.Console.*

record Counter(Age: int)

func Second(values: int[]&) -> int& {
    return &values[1]
}

func MakeValues() -> int[]& {
    let values: int[]& = new int[3]
    values[1] = 40
    return values
}

func Main() -> int {
    var local: int[3] = [1, 2, 3]
    let copy = local
    let localElement = Second(&local)
    localElement = 9
    WriteLine(copy[1])
    WriteLine(local[1])

    let shared = MakeValues()
    let element = Second(shared)
    element = element + 2
    WriteLine(shared.Length)
    WriteLine(shared[1])

    let words: string[]& = new string[2] { "Neo", "Neo" }
    words[1] = "CLR"
    WriteLine(words[0])
    WriteLine(words[1])
    return shared[1]
}
