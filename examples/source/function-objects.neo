import System.Console.*


class Counter {
    var Value: int
    init(value: int) { this.Value = value }
    func Add(amount: int) -> int {
        this.Value = this.Value + amount
        return this.Value
    }
}
func Identity<T>(value: T) -> T { return value }
func Apply(callback: fn<int,int>, value: int) -> int {
    return callback(value)
}
func MakeCallback() -> fn<int,int> {
    let counter = new Counter(40)
    return counter.Add
}
func Main() -> int {
    let identity: fn<int,int> = Identity<int>
    WriteLine(Apply(identity, 42))
    let callback = MakeCallback()
    WriteLine(callback.Invoke(1))
    return callback(1)
}
