.module TypeArities
.entry Main

.type Container
    .method static Describe() -> String
        ldstr "companion"
        ret
    .end
.end
.type Container<T>
    .field Value T
    .method static Describe() -> String
        ldstr "one parameter"
        ret
    .end
    .method instance Read() -> T
        ldarg this
        ldfld Container<T>::Value
        ret
    .end
.end
.type Container<T,E>
    .field First T
    .field Second E
    .method static Describe() -> String
        ldstr "two parameters"
        ret
    .end
.end

.function Main() -> Void
    call Container::Describe()
    call System.Console::WriteLine(String)
    pop
    call Container<Int32>::Describe()
    call System.Console::WriteLine(String)
    pop
    call Container<Int32,String>::Describe()
    call System.Console::WriteLine(String)
    pop
    ldc.i4 42
    newobj Container<Int32>
    call instance Container<Int32>::Read()
    call System.Console::WriteLine(Int32)
    ret
.end
