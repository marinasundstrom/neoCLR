.module Constructors
.entry Main

.type Box<T>
    .field private Stored T
    .method public instance .ctor(T value) -> Void
        ldarg value
        newobj Box<T>
        starg this
        ldvoid
        ret
    .end
    .property instance Value() -> T
        .get instance Box<T>::get_Value()
    .end
    .method public instance get_Value() -> T
        ldarg this
        ldfld Box<T>::Stored
        ret
    .end
.end

.function Main() -> Void
    ldc.i4 42
    newobj instance Box<Int32>::.ctor(Int32)
    call instance Box<Int32>::get_Value()
    call System.Console::WriteLine(Int32)
    pop
    ldstr "Constructed through a public constructor"
    newobj instance Box<String>::.ctor(String)
    call instance Box<String>::get_Value()
    call System.Console::WriteLine(String)
    ret
.end
