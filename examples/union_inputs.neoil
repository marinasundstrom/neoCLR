.module UnionInputs

.function Describe(System.Result<Void,String> value) -> String
    ldarg value
    call instance System.Result<Void,String>::get_IsOkCase()
    brtrue Success
    ldstr "Failed"
    ret
Success:
    ldstr "Succeeded"
    ret
.end

.function Echo(System.Option<String> value) -> System.Option<String>
    ldarg value
    ret
.end

.function Success() -> System.Result<Void,String>
ldvoid
newobj instance System.Result.Ok<Void>::.ctor(Void)
newobj instance System.Result<Void,String>::.ctor(System.Result.Ok<Void>)
ret
.end
