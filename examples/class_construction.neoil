.module ClassConstruction
.entry Main
.type class Counter
.field Age Int32
.method instance .ctor(Int32 age) -> noresult
    ldarg this
    ldarg age
    stfld Counter::Age
    ret
.end
.method instance Get() -> Int32
    ldarg this
    ldfld Counter::Age
    ret
.end
.end
.function Main() -> noresult
    ldc.i4 42
    newobj instance Counter::.ctor(Int32)
    call instance Counter::Get()
    call System.Console::WriteLine(Int32)
    pop
    ret
.end
