.module FileInput
.entry Main

.function ReadNumber(String path) -> System.Result<Int32,Error>
    ldarg path
    ldc.i4 1024
    call System.IO.File::ReadAllText(String,Int32)
    dup
    call instance System.Result<String,System.Error>::get_IsErrorCase()
    brtrue Failed
    call instance System.Result<String,System.Error>::GetOkCase()
    call instance System.Result.Ok<String>::get_Value()
    call System.Int32::Parse(String)
    ret
Failed:
    call instance System.Result<String,System.Error>::GetErrorCase()
    call instance System.Result.Error<System.Error>::get_Value()
    newobj instance System.Result.Error<System.Error>::.ctor(System.Error)
    newobj instance System.Result<Int32,System.Error>::.ctor(System.Result.Error<System.Error>)
    ret
.end

.function Report(String path) -> Void
    ldarg path
    call ReadNumber(String)
    dup
    call instance System.Result<Int32,System.Error>::get_IsErrorCase()
    brtrue Failed
    call instance System.Result<Int32,System.Error>::GetOkCase()
    call instance System.Result.Ok<Int32>::get_Value()
    ldc.i4 2
    mul
    call System.Console::WriteLine(Int32)
    ret
Failed:
    call instance System.Result<Int32,System.Error>::GetErrorCase()
    call instance System.Result.Error<System.Error>::get_Value()
    call instance System.Error::ToString()
    call System.Console::WriteLine(String)
    ret
.end

.function Main() -> Void
    ldstr "examples/data/number.txt"
    call Report(String)
    pop
    ldstr "examples/data/not_a_number.txt"
    call Report(String)
    pop
    ldstr "File input handled"
    call System.Console::WriteLine(String)
    ret
.end
