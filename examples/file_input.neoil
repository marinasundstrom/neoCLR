.module FileInput
.entry Main

.function ReadNumber(String path) -> System.Result<Int32,Error>
    ldarg path
    ldc.i4 1024
    call System.IO.File::ReadAllText(String,Int32)
    dup
    is.case Err
    brtrue Failed
    ldcase Ok
    call System.Int32::Parse(String)
    ret
Failed:
    ldcase Err
    newobj instance System.Err<Error>::.ctor(Error)
    newobj instance System.Result<Int32,Error>::.ctor(System.Err<Error>)
    ret
.end

.function Report(String path) -> Void
    ldarg path
    call ReadNumber(String)
    dup
    call instance System.Result<Int32,Error>::get_IsErr()
    brtrue Failed
    call instance System.Result<Int32,Error>::GetOk()
    call instance System.Ok<Int32>::get_Value()
    ldc.i4 2
    mul
    call System.Console::WriteLine(Int32)
    ret
Failed:
    call instance System.Result<Int32,Error>::GetErr()
    call instance System.Err<Error>::get_Value()
    call instance System.Error::ToString()
    call System.Console::WriteLine(String)
    ret
.end

.function Main() -> Void
    ldstr "examples/data/number.txt"
    call Report(String)
    pop
    ldstr "examples/data/not_a_number.txt"
    call Report(String)
    pop
    ldstr "File input handled"
    call System.Console::WriteLine(String)
    ret
.end
