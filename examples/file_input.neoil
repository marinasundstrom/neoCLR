.module FileInput
.entry Main

.function ReadNumber(String path) -> System.Result<Int32,String>
    .local System.Result.Ok<String> fileText
    .local System.Result.Ok<Int32> parsedNumber
    .local System.Result.Error<System.Int32ParseError> parseFailure
    .local System.Result.Error<System.IO.FileReadError> readFailure
    ldarg path
    ldc.i4 1024
    call System.IO.File::ReadAllText(String,Int32)
    dup
    ldloca fileText
    call instance System.Result<String,System.IO.FileReadError>::TryGet(System.Result.Ok<String>&)
    brfalse Failed
    pop
    ldloc fileText
    call instance System.Result.Ok<String>::get_Value()
    call System.Int32::Parse(String)
    dup
    ldloca parsedNumber
    call instance System.Result<Int32,System.Int32ParseError>::TryGet(System.Result.Ok<Int32>&)
    brfalse ParseFailed
    pop
    ldloc parsedNumber
    call instance System.Result.Ok<Int32>::get_Value()
    newobj instance System.Result.Ok<Int32>::.ctor(Int32)
    newobj instance System.Result<Int32,String>::.ctor(System.Result.Ok<Int32>)
    ret
ParseFailed:
    ldloca parseFailure
    call instance System.Result<Int32,System.Int32ParseError>::TryGet(System.Result.Error<System.Int32ParseError>&)
    brtrue ParseErrorExtracted
    fault "Expected Error case"
ParseErrorExtracted:
    ldloc parseFailure
    call instance System.Result.Error<System.Int32ParseError>::get_Value()
    call instance System.Int32ParseError::ToString()
    newobj instance System.Result.Error<String>::.ctor(String)
    newobj instance System.Result<Int32,String>::.ctor(System.Result.Error<String>)
    ret
Failed:
    ldloca readFailure
    call instance System.Result<String,System.IO.FileReadError>::TryGet(System.Result.Error<System.IO.FileReadError>&)
    brtrue ReadErrorExtracted
    fault "Expected Error case"
ReadErrorExtracted:
    ldloc readFailure
    call instance System.Result.Error<System.IO.FileReadError>::get_Value()
    call instance System.IO.FileReadError::ToString()
    newobj instance System.Result.Error<System.String>::.ctor(System.String)
    newobj instance System.Result<Int32,System.String>::.ctor(System.Result.Error<System.String>)
    ret
.end

.function Report(String path) -> Void
    .local System.Result.Ok<Int32> success
    .local System.Result.Error<System.String> failure
    ldarg path
    call ReadNumber(String)
    dup
    ldloca success
    call instance System.Result<Int32,System.String>::TryGet(System.Result.Ok<Int32>&)
    brfalse Failed
    pop
    ldloc success
    call instance System.Result.Ok<Int32>::get_Value()
    ldc.i4 2
    mul
    call System.Console::WriteLine(Int32)
    ret
Failed:
    ldloca failure
    call instance System.Result<Int32,System.String>::TryGet(System.Result.Error<System.String>&)
    brtrue ErrorExtracted
    fault "Expected Error case"
ErrorExtracted:
    ldloc failure
    call instance System.Result.Error<System.String>::get_Value()
    call System.Console::WriteLine(String)
    ret
.end

.function Main() -> Void
    ldstr "examples/data/number.txt"
    call Report(String)
    pop
    ldstr "examples/data/not_a_number.txt"
    call Report(String)
    pop
    ldstr "File input handled"
    call System.Console::WriteLine(String)
    ret
.end
