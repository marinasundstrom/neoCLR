.module NamedSlots
.entry Main

.type Point
    .field X int32
    .field Y int32

    .method instance Sum(int32 offset) -> int32
        ldarg this
        ldfld 0
        ldarg this
        ldfld 1
        add
        ldarg offset
        add
        ret
    .end
.end

.function Main() -> Result<Void,Error>
    .local Point point
    .local string message
    ldc.i4 10
    ldc.i4 20
    newobj Point
    stloc point
    ldloc point
    ldc.i4 12
    call instance Point::Sum(int32)
    call instance System.Int32::ToString()
    stloc message
    ldloc message
    call System.Console::WriteLine(string)
    ok Error
    ret
.end
