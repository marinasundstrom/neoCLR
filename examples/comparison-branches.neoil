.module ComparisonBranches
.entry Main

.function Main() -> Void
    ldc.i4 42
    ldc.i4 42
    beq Passed0
    fault "beq failed"
Passed0:
    ldc.r8 NaN
    ldc.r8 0
    bne.un Passed1
    fault "bne.un failed"
Passed1:
    ldc.i4 2
    ldc.i4 1
    bgt Passed2
    fault "bgt failed"
Passed2:
    ldc.i4 -1
    ldc.i4 0
    bgt.un Passed3
    fault "bgt.un failed"
Passed3:
    ldc.i4 -1
    ldc.i4 0
    blt Passed4
    fault "blt failed"
Passed4:
    ldc.i4 0
    ldc.i4 -1
    blt.un Passed5
    fault "blt.un failed"
Passed5:
    ldc.r8 1
    ldc.r8 1
    bge Passed6
    fault "bge failed"
Passed6:
    ldc.r8 NaN
    ldc.r8 0
    bge.un Passed7
    fault "bge.un failed"
Passed7:
    ldc.r8 1
    ldc.r8 1
    ble Passed8
    fault "ble failed"
Passed8:
    ldc.r8 0
    ldc.r8 NaN
    ble.un Passed9
    fault "ble.un failed"
Passed9:
    ldstr "Comparison branches passed"
    call System.Console::WriteLine(String)
    ret
.end
