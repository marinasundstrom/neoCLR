.module ControlFlow
.entry Main

.function Describe(Int32 value) -> String
    ldarg value
    switch (Zero, One, Many)
    ldstr "outside table"
    ret
Zero:
    ldstr "zero"
    ret
One:
    ldstr "one"
    ret
Many:
    ldstr "two"
    ret
.end

.function Main() -> Void
    .local Int32 index
    ptr.null Int32
    brfalse Start
    fault "null pointer condition was true"
Start:
    ldc.i4 0
    stloc index
Loop:
    ; Zero remaining iterations exits without a Boolean comparison.
    ldc.i4 4
    ldloc index
    sub
    brfalse Done
    ldloc index
    call Describe(Int32)
    call System.Console::WriteLine(String)
    pop
    ldloc index
    ldc.i4 1
    add
    stloc index
    br Loop
Done:
    ldvoid
    ret
.end
