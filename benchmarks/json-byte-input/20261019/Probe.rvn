import System.*
import System.Concurrency.Tasks.*
import System.Data.Json.*
import System.IO.*
import System.Result.*
import System.Web.Http.Json.*

async func Main() -> Task<()> {
    let sources = ["[1,2,3,4,5,6,7,8]", "{\"first\":\"hello\",\"second\":\"hello\"}", "{\"escaped\":\"é😀\\n\\u0000\\\"\"}"]
    for source in sources {
        for index in 0..200 {
            let Ok(node) = JsonSerializer.DeserializeNode(source) else {
                Panic("Probe parse failed")
            }
            let Ok(actual) = JsonSerializer.SerializeNode(node) else {
                Panic("Probe serialize failed")
            }
            let Ok(reparsed) = JsonSerializer.DeserializeNode(actual) else {
                Panic("Probe reparse failed")
            }
            if JsonSerializer.SerializeNode(reparsed) is Error(_) {
                Panic("Round trip failed")
            }
        }
    }
    Console.WriteLine("PASS JSON byte input probe")
}
