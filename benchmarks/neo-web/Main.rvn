module Benchmarks.NeoWeb

import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Concurrency.*
import Neo.Web.*
import Neo.DependencyInjection.*
import Examples.Web.*
import Neo.Web.HttpContext
import System.Web.Http.*

func Value() -> HttpResult<string> => HttpResult<string>.Ok("42")

func ContextValue(context: HttpContext) -> Task<Result<unit, WebError>> {
    context.RespondText("42")
    return Task.FromResult<Result<unit, WebError>>(Result<unit, WebError>.Ok(()))
}

func Direct(request: HttpServerRequest) -> Task<Result<HttpServerResponse, HttpError>> {
    return Task.FromResult<Result<HttpServerResponse, HttpError>>(Result<HttpServerResponse, HttpError>.Ok(HttpServerResponse(200, ArrayList<HttpHeader>(), HttpStringContent("42"))))
}

// Paired cases isolate transport callbacks, scopes and selected binding paths.
func DirectContext(context: System.Web.Http.HttpContext) -> Task<Result<unit, HttpError>> {
    context.RespondText("42")
    return Task.FromResult<Result<unit, HttpError>>(Result<unit, HttpError>.Ok(()))
}

class ScopedDirect {
    private val services: ServiceProvider
    init(services: ServiceProvider) { self.services = services }
    func Handle(context: System.Web.Http.HttpContext) -> Task<Result<unit, HttpError>> {
        use scope = services.CreateScope()!
        return DirectContext(context)
    }
}

public class BenchmarkService {
    func Value() -> string => "42"
}

func ServiceValue(service: BenchmarkService) -> HttpResult<string> => HttpResult<string>.Ok(service.Value())
func QueryValue(value: int) -> HttpResult<string> => HttpResult<string>.Ok(value.ToString())
func CancellationValue(token: CancellationToken) -> HttpResult<string> {
    if !token.CanBeCancelled { return HttpResult<string>.BadRequest }
    return HttpResult<string>.Ok("42")
}

// External harness owns process termination after measuring completed exchanges.
async func Main(arguments: string[]) -> Task<int> {
    if arguments.Length != 1 { return 1 }
    if arguments[0] == "direct" || arguments[0] == "direct-context" || arguments[0] == "direct-scope" {
        let server = HttpServer.Listen("127.0.0.1", 0, 128)!
        use services = DefaultServiceCollection().Build()!
        let scoped = ScopedDirect(services)
        // Select before starting: one Serve invocation owns the listener.
        let serverLifetime = if arguments[0] == "direct" {
            server.Serve(Direct)
        } else if arguments[0] == "direct-scope" {
            server.Serve(scoped.Handle)
        } else {
            server.Serve(DirectContext)
        }
        Console.WriteLine("LISTENING http://127.0.0.1:" + server.GetLocalPort()!.ToString())
        _ = await serverLifetime
        server.Close()
        return 0
    }
    use builder = WebApplication.CreateBuilder()
    builder.Server.Port = 0
    if arguments[0] == "cached" || arguments[0] == "uncached" {
        _ = builder.Services.AddSingleton<DemoResponseCache>((provider) => Ok(DemoResponseCache()))!
        _ = builder.Services.AddScoped<DemoResponseCacheMiddleware>()!
    }
    if arguments[0] == "service" {
        builder.Services.AddScoped<BenchmarkService>((provider) => Ok(BenchmarkService()))!
    }
    use app = builder.Build()!
    if arguments[0] == "generic" { app.MapGet("/", Value)! }
    else if arguments[0] == "cancellation" { app.MapGet("/", CancellationValue)! }
    else if arguments[0] == "query" { app.MapGet("/", QueryValue)! }
    else if arguments[0] == "service" { app.MapGet("/", ServiceValue)! }
    else if arguments[0] == "context-middleware" {
        app.Use((context, next) => next(context))!
        app.MapContext("GET", "/", ContextValue)!
    }
    else if arguments[0] == "context" { app.MapContext("GET", "/", ContextValue)! }
    else if arguments[0] == "cached" || arguments[0] == "uncached" {
        if arguments[0] == "cached" { app.UseMiddleware<DemoResponseCacheMiddleware>()! }
        app.MapGet("/cached", Computed)!
        app.MapGet("/cache-stats", CacheStatistics)!
    }
    else { return 1 }
    let lifetime = app.RunAsync()
    Console.WriteLine("LISTENING http://127.0.0.1:" + app.GetLocalPort()!.ToString())
    _ = await lifetime
    return 0
}
