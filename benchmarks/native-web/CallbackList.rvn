import System.*
import System.Collections.*

class Counter {
    private var number: int

    init(number: int) {
        self.number = number
    }

    func Add(delta: int) -> int {
        number += delta
        return number
    }
}

func AddTwo(value: int) -> int => value + 2

func Main() -> int {
    let callbacks = ArrayList<(int) -> int>()
    var index = 0
    while index < 20 {
        callbacks.Add(Counter(index).Add)
        index += 1
    }
    let copy = callbacks.Copy()
    index = 0
    while index < 20 {
        if callbacks[index](1) != index + 1 {
            return 1
        }
        callbacks[index] = AddTwo
        index += 1
    }
    // Only the copied array now retains the original receivers.
    index = 0
    while index < 1000 {
        callbacks[0] = Counter(index).Add
        index += 1
    }
    index = 0
    while index < 20 {
        if copy[index](1) != index + 2 {
            return 2
        }
        index += 1
    }
    return 0
}
