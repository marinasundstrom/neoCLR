import System.*

class Counter {
    private var number: int

    init(number: int) {
        self.number = number
    }

    func Add(delta: int) -> int {
        number += delta
        return number
    }
}

func Main() -> int {
    let values: Counter[] = [Counter(40), Counter(1)]
    let alias = values
    if alias[0].Add(2) != 42 || values[0].Add(0) != 42 {
        return 1
    }
    let saved: Counter[] = [values[0]]
    values[0] = Counter(0)
    var index = 0
    while index < 1000 {
        alias[1] = Counter(index)
        index += 1
    }
    if saved[0].Add(0) != 42 || Object.ReferenceEquals(saved[0], values[0]) {
        return 2
    }
    let nullable: Counter?[] = [null, saved[0]]
    if !Object.ReferenceEquals(nullable[0], null) || !Object.ReferenceEquals(nullable[1], saved[0]) {
        return 3
    }
    let empty: Counter[] = []
    if empty.Length != 0 {
        return 4
    }
    return 0
}
