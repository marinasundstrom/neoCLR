import System.*
import System.Collections.*
import System.Introspection.*
import System.Web.Http.*

func Main() -> int {
    let named = HttpStatusCode.NotFound
    let extension = (HttpStatusCode)599
    let negative = (HttpStatusCode)(-1)
    if (int)named != 404 || (int)extension != 599 || (int)negative != -1 {
        return 1
    }
    if named != HttpStatusCode.NotFound || extension == named {
        return 2
    }
    let flags = BindingFlags.Public | BindingFlags.Static
    if (flags & BindingFlags.Public) != BindingFlags.Public {
        return 3
    }
    let values = ArrayList<HttpStatusCode>()
    var index = 0
    while index < 20 {
        values.Add(extension)
        index += 1
    }
    let copy = values.Copy()
    values[0] = HttpStatusCode.OK
    if (int)copy[0] != 599 || (int)values[0] != 200 {
        return 4
    }
    return 0
}
