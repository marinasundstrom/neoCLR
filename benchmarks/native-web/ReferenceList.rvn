import System.*
import System.Collections.*

class Counter {
    private var number: int

    init(number: int) {
        self.number = number
    }

    func Add(delta: int) -> int {
        number += delta
        return number
    }
}

func Main() -> int {
    let values = ArrayList<Counter>()
    var index = 0
    while index < 20 {
        values.Add(Counter(index))
        index += 1
    }
    let copy = values.Copy()
    index = 0
    while index < 20 {
        if values[index].Add(1) != index + 1 {
            return 1
        }
        values[index] = Counter(0)
        index += 1
    }
    // Only the copied array now retains the original objects.
    index = 0
    while index < 1000 {
        values[0] = Counter(index)
        index += 1
    }
    if !Object.ReferenceEquals(copy[0], copy[0]) || Object.ReferenceEquals(copy[0], values[0]) {
        return 3
    }
    let absent: Object? = null
    if !Object.ReferenceEquals(absent, null) || Object.ReferenceEquals(copy[0], absent)
        || Object.ReferenceEquals(absent, copy[0]) {
        return 4
    }
    let text = String.Concat("same ", "text")
    let otherText = String.Concat("same ", "text")
    if !Object.ReferenceEquals(text, text) || Object.ReferenceEquals(text, otherText) || text != otherText {
        return 5
    }
    index = 0
    while index < 20 {
        if copy[index].Add(1) != index + 2 {
            return 2
        }
        index += 1
    }
    return 0
}
