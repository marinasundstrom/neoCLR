module Benchmarks.Json

import System.*
import System.Data.Json.*
import System.Result.*
import NeoClr.Benchmarking.*

func Main(arguments: string[]) {
    let text = DocumentText()
    let Ok(node) = JsonSerializer.DeserializeNode(text) else {
        Panic("JSON setup failed")
    }
    let Ok(canonical) = JsonSerializer.SerializeNode(node) else {
        Panic("JSON setup round trip failed")
    }
    if canonical != text {
        Panic("JSON setup changed nested content")
    }
    let suite = BenchmarkSuite()
    suite.Add("json.nodes.serialize", () => {
        let Ok(output) = JsonSerializer.SerializeNode(node) else {
            Panic("JSON serialization failed")
        }
        if output != text {
            Panic("JSON serialization changed the document")
        }
        return 1
    })
    RegisterDiscoveredBenchmarks(suite)
    suite.Run(arguments)
}

func DocumentText() -> string => "{\"name\":\"Café 🌍\",\"station\":{\"active\":true},\"readings\":[21,22,null],\"tags\":[\"indoor\",\"north\"]}"

[Benchmark("Deserialize a nested Unicode JSON document")]
func DeserializeNodes() -> int {
    let text = DocumentText()
    let Ok(value) = JsonSerializer.DeserializeNode(text) else {
        Panic("JSON deserialization failed")
    }
    if value is JsonObject document {
        if document.Count != 4 {
            Panic("JSON object shape changed")
        }
        if document.Field("name") is Ok(JsonString name) && name.Value == "Café 🌍" {
            return 1
        }
    }
    Panic("JSON deserialization changed the document")
    return 0
}
