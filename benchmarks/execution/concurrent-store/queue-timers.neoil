.module LiveQueueTimers
.type class Queue
.field Count Int64
.field Child arrayref<Byte>
.end
.function Drain(Queue queue) -> Void
ldarg queue
call Current()
ref.eq
brtrue current_ok
ldc.i4 1
ldc.i4 0
div
pop
current_ok:
ldarg queue
ldarg queue
ldfld Queue::Count
ldc.i8 1
add
stfld Queue::Count
ldarg queue
ldc.i4 16
newarr Byte
stfld Queue::Child
ldarg queue
ldfld Queue::Count
ldc.i8 0
beq bad
ldvoid
ret
bad:
ldc.i4 1
ldc.i4 0
div
pop
ldvoid
ret
.end
.function Write(Int32 value) -> Int32
ldarg value
ret
.end
.function Main(Int32 value) -> Int32
ldarg value
ret
.end
.function Register(Queue queue) -> Void
ldvoid
ret
.end
.function Default() -> Queue
fault "native replacement"
.end
.function Current() -> Queue
fault "native replacement"
.end
.function Start(Int32 milliseconds,fn<Void> callback) -> Int64
ldc.i8 0
ret
.end
.function Cancel(Int64 timer) -> Boolean
ldc.bool false
ret
.end
