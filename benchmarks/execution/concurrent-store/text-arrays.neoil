.module LiveTextArrays
.function Dummy(Int32 value) -> Int32
ldarg value
ret
.end
.function Write(arrayref<String> first,arrayref<String> second,String value) -> Int32
.local arrayref<String> temp
ldc.i4 1
array.reserve String
stloc temp
ldloc temp
ldc.i4 0
ldarg value
stelem String
ldarg first
ldc.i4 0
ldloc temp
ldc.i4 0
ldelem String
stelem String
ldarg second
ldc.i4 0
ldarg value
stelem String
ldc.i4 0
ret
.end
.function Main(Int32 value) -> Int32
ldarg value
ret
.end
