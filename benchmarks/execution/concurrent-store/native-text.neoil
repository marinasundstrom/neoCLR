.function Write(out String& first,out String& second,String value) -> Int32
.local String combined
ldarg value
ldarg value
call neoCLR.Runtime.StringConcat(String,String)
stloc combined
ldarg first
ldloc combined
stobj String
ldloc combined
ldarg value
call neoCLR.Runtime.StringConcat(String,String)
stloc combined
ldarg second
ldloc combined
stobj String
ldloc combined
call neoCLR.Runtime.StringByteCount(String)
ret
.end
