.module LiveAsyncWrappersPump
.type class abstract System.Object
.end
.type class Counter
.extends System.Object
.field Number Int32
.field Buffer arrayref<Byte>
.field Operation Int64
.field ObservedOwner System.Object
.field Body Int64
.method instance Run() -> Void
ldarg 0
call neoCLR.Runtime.RuntimeAsyncCurrentOwner()
stfld Counter::ObservedOwner
ldarg 0
ldfld Counter::Operation
call neoCLR.Runtime.RuntimeAsyncAwaitUnit(Int64)
ldarg 0
ldc.i4 8
newarr Byte
stfld Counter::Buffer
ldarg 0
ldc.i4 42
stfld Counter::Number
ldvoid
ret
.end
.method instance Fail() -> void
ldc.i4 1
ldc.i4 0
div
pop
ret
.end
.end
.function neoCLR.Runtime.RuntimeAsyncCreate() -> Int64
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncCompleteUnit(Int64 operation) -> Boolean
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncAwaitUnit(Int64 operation) -> void
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncRelease(Int64 operation) -> Boolean
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncIsCompleted(Int64 operation) -> Boolean
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncWaitCompletion(Int64 operation) -> Boolean
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncStart(fn<Void> callback) -> Int64
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncCreateOwned(System.Object owner) -> Int64
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncCurrentOwner() -> System.Object
.methodimpl InternalCall
.end
.function neoCLR.Runtime.RuntimeAsyncStartManaged(System.Object owner,fn<Void> callback) -> Int64
.methodimpl InternalCall
.end
.function Write(Counter value) -> Int32
ldarg value
function.bind fn<Void> = instance Counter::Run()
pop
ldarg value
function.bind fn<void> = instance Counter::Fail()
pop
ldc.i4 0
ret
.end
.function Main(Int32 value) -> Int32
ldarg value
ret
.end
.function Pump() -> Void
ldvoid
ret
.end
.function Drain(Counter queue) -> Void
ldvoid
ret
.end
