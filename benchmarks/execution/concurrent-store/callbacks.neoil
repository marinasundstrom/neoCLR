.module LiveCallbacks
.type class Counter
.field Number Int32
.field Buffer arrayref<Byte>
.method instance Run() -> Void
ldarg 0
ldc.i4 8
newarr Byte
stfld Counter::Buffer
ldarg 0
ldc.i4 42
stfld Counter::Number
ldvoid
ret
.end
.method instance Fail() -> void
ldc.i4 1
ldc.i4 0
div
pop
ret
.end
.end
.function Write(Counter value) -> Int32
ldarg value
function.bind fn<Void> = instance Counter::Run()
pop
ldarg value
function.bind fn<void> = instance Counter::Fail()
pop
ldc.i4 0
ret
.end
.function Main(Int32 value) -> Int32
ldarg value
ret
.end
