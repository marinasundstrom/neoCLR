import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
    if request.Method.Method != "GET" || request.Target != "/greeting" {
        Panic("Unexpected benchmark request")
    }
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("Content-Type", "text/plain; charset=utf-8"))
    let body = (byte[])[for index in 0..8192 => (byte)120]
    let result: Result<HttpResponse, HttpError> = Ok(HttpResponse(200, headers, HttpMemoryContent(body)))
    return Task.FromResult(result)
}

async func Main() -> Task<()> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) else {
        Panic("Listen failed")
    }
    let Ok(port) = server.GetLocalPort() else {
        server.Close()
        Panic("Local port unavailable")
    }
    Console.WriteLine(port)
    var count = 0
    while count < 32 {
        let result = await server.ServeOne(Respond)
        if let Error(error) = result {
            server.Close()
            Panic(error.ToString())
        }
        count += 1
    }
    server.Close()
    Console.WriteLine("DONE")
}
