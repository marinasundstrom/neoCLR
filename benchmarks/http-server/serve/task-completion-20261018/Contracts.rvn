import System.*
import System.Concurrency.Tasks.*

class Observer {
    var Count: int = 0
    var Order: int = 0
    func First() {
        Order = Order * 10 + 1
        TaskQueue.Default.Post(self.Third)
    }
    func Second() {
        Order = Order * 10 + 2
    }
    func Third() {
        Order = Order * 10 + 3
    }
    func Hit() {
        Count = Count + 1
    }
}

func Require(condition: bool) {
    if !condition {
        System.Fail("Task completion contract failed")
    }
}

func Main() {
    let queue = TaskQueue.Default
    let observer = Observer()
    // Explicit callbacks test deferred observation before and after settlement.
    for index in 0..10 {
        let completed = Promise<int>(queue)
        let task = completed.Task
        Require(completed.Complete(index))
        Require(!completed.Complete(999))
        Require(!completed.Cancel())
        Require(task.GetResult() == index)
        task.OnCompleted(observer.Hit)
        Require(observer.Count == index * 4)
        queue.Drain()
        Require(observer.Count == index * 4 + 1)

        let cancelled = Promise<int>(queue)
        Require(cancelled.Cancel())
        Require(!cancelled.Cancel())
        Require(!cancelled.Complete(999))
        Require(cancelled.Task.State == TaskState.Cancelled)
        cancelled.Task.OnCompleted(observer.Hit)
        Require(observer.Count == index * 4 + 1)
        queue.Drain()

        let pending = Promise<int>(queue)
        pending.Task.OnCompleted(observer.Hit)
        Require(pending.Complete(42))
        Require(observer.Count == index * 4 + 2)
        queue.Drain()
        Require(pending.Task.GetResult() == 42)

        let pendingCancel = Promise<int>(queue)
        pendingCancel.Task.OnCompleted(observer.Hit)
        Require(pendingCancel.Cancel())
        Require(observer.Count == index * 4 + 3)
        queue.Drain()
        Require(observer.Count == index * 4 + 4)
    }
    let ordered = Promise<int>(queue)
    ordered.Task.OnCompleted(observer.First)
    ordered.Task.OnCompleted(observer.Second)
    Require(ordered.Complete(42))
    Require(observer.Order == 0)
    queue.Drain()
    Require(observer.Order == 123)
    // Force queue growth, ring wraparound and reuse across empty drains.
    for round in 0..3 {
        observer.Order = 0
        queue.Post(observer.First)
        queue.Post(observer.Second)
        for index in 0..7 {
            queue.Post(observer.Hit)
        }
        Require(observer.Order == 0)
        queue.Drain()
        Require(observer.Order == 123)
        Require(observer.Count == 40 + (round + 1) * 7)
        queue.Drain()
        Require(observer.Order == 123)
    }
    Console.WriteLine("Task completion contracts passed")
}
