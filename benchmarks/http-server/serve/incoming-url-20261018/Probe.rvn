import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import System.Time.*
import System.Web.Http.*

// Accept intentionally exposes parser outcomes for this low-level regression probe.
async func Main() -> Task<()> {
    let options = HttpServerOptions()
    options.RequestReadTimeout = Duration.FromTicks(600000000L)
    options.ResponseWriteTimeout = Duration.FromTicks(600000000L)
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 16, options) else {
        System.Fail("Listen failed")
    }
    let Ok(port) = server.GetLocalPort() else { System.Fail("Port failed") }
    Console.WriteLine(port)
    var running = true
    while running {
        let result = await server.Accept()
        if let Ok(context) = result {
            let request = context.Request
            Console.WriteLine("OK")
            Console.WriteLine(request.Host)
            Console.WriteLine(request.Port)
            Console.WriteLine(request.Target)
            Console.WriteLine(request.Method.Method)
            Console.WriteLine(request.IsSecure)
            context.Respond(HttpStatusCode.OK, request.Content)
            if (await context.Complete()) is Error(_) { System.Fail("Response failed") }
            running = request.Target != "/stop"
            context.Dispose()
        } else if let Error(reason) = result {
            let kind = match reason {
                HttpError.InvalidUri(_) => "URI"
                HttpError.InvalidRequest(_) => "REQUEST"
                HttpError.Unsupported(_) => "UNSUPPORTED"
                HttpError.LimitExceeded(_) => "LIMIT"
                HttpError.Protocol(_) => "PROTOCOL"
                _ => "OTHER"
            }
            Console.WriteLine(kind)
            let detail = match reason {
                HttpError.InvalidUri(let value) => value.ToString()
                HttpError.InvalidRequest(let message) => message
                HttpError.Unsupported(let message) => message
                HttpError.LimitExceeded(let message) => message
                HttpError.Protocol(let message) => message
                _ => "Unexpected error"
            }
            Console.WriteLine(detail)
        }
    }
    server.Close()
    Console.WriteLine("DONE")
}
