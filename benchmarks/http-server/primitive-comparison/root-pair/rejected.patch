+/* Resume needs two independent strong roots. Admit both against one complete
+ * heap walk and reserve both slots before publishing either handle. */
+int32_t neoclr_gc_host_root_create_pair_v1(neoclr_aot_context *context,
+    void *first, void *second, uint64_t output[2]) {
+    if (!context || !output || !validated_bases(&context->text, first, second)) return 3;
+    host_root *slots[2] = {NULL, NULL};
+    unsigned count = 0;
+    for (uint32_t i = 0; i < NEOCLR_GC_HOST_ROOT_LIMIT && count < 2; i++)
+        if (!host_roots[i].context) slots[count++] = &host_roots[i];
+    if (count != 2) return NEOCLR_AOT_FAULT_NATIVE_MEMORY_LIMIT;
+    uint64_t handle = atomic_load_explicit(&next_host_handle, memory_order_relaxed);
+    do {
+        if (handle > UINT64_MAX - 2) return NEOCLR_AOT_FAULT_NATIVE_MEMORY_LIMIT;
+    } while (!atomic_compare_exchange_weak_explicit(&next_host_handle, &handle, handle + 2,
+                memory_order_relaxed, memory_order_relaxed));
+    void *values[2] = {first, second};
+    for (unsigned i = 0; i < 2; i++) {
+        *slots[i] = (host_root){.context = context, .value = values[i],
+            .handle = handle + i, .next = host_head};
+        if (host_head) host_head->previous = slots[i];
+        host_head = slots[i];
+    }
+    output[0] = handle;
+    output[1] = handle + 1;
+    return 0;
+}
 int32_t neoclr_gc_host_root_create_owned_v1(neoclr_aot_context *context, void *owner,
     void *value, uint64_t *output) {
     return host_root_create(context, owner, value, 1, output);
