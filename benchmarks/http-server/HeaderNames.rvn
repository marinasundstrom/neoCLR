import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

internal static class HeaderIdentity {
    private static var previous: HttpServerRequest?

    static func Check(request: HttpServerRequest) {
        System.Runtime.GC.Collect()
        if previous is HttpServerRequest last {
            for header in request.Headers {
                let name = header.Name
                let known = name == "host" || name == "connection" || name == "content-length" ||
                    name == "transfer-encoding" || name == "content-type" || name == "accept" ||
                    name == "accept-encoding" || name == "authorization" || name == "cookie" ||
                    name == "user-agent" || name == "cache-control"
                if known {
                    for old in last.Headers {
                        if old.Name == name && !Object.ReferenceEquals(old.Name, name) {
                            Panic("Known header name identity changed")
                        }
                    }
                }
            }
        }
        previous = request
    }
}

func InspectHeaders(request: HttpServerRequest) -> Task<Result<HttpServerResponse, HttpError>> {
    HeaderIdentity.Check(request)
    var text = ""
    for header in request.Headers {
        text = text + header.Name + "=" + header.Value + "\n"
    }
    return Task.FromResult(Result<HttpServerResponse, HttpError>.Ok(
        HttpServerResponse(200, ArrayList<HttpHeader>(), HttpStringContent(text))))
}

async func Main() -> Task<()> {
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 4) else {
        Panic("Listen failed")
    }
    let Ok(port) = server.GetLocalPort() else {
        Panic("Port unavailable")
    }
    Console.WriteLine(port)
    var index = 0
    while index < HeaderCases.Count {
        let result = await server.ServeOne(InspectHeaders)
        if let Failure(error) = result {
            Console.WriteLine("ERROR:" + error.ToString())
        } else {
            Console.WriteLine("OK")
        }
        index += 1
    }
    server.Close()
    Console.WriteLine("DONE")
}
