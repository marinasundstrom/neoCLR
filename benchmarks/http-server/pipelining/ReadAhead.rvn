import System.*
import System.Runtime.*
import System.Optional.*
import System.Concurrency.*
import System.Networking.Sockets.*
import System.Result.*
import System.Web.Http.*

func Check(value: bool) {
    if !value { Panic("Read-ahead contract failed") }
}

func OwnedWindow(start: int, end: int) -> HttpReadAhead {
    let bytes: byte[] = [for index in 0..8 => (byte)(10 + index)]
    let input = HttpReadAhead()
    Check(input.Save(bytes, start, end) is Ok(_))
    return input
}

func ConnectionWindow() {
    let Ok(socket) = Socket.Listen("127.0.0.1", 0, 8) else { Panic("Fixture listener") }
    let connection = HttpConnection(socket)
    let bytes: byte[] = [(byte)7, (byte)8, (byte)9]
    let target: byte[] = [(byte)0, (byte)0]
    Check(connection.RetainReadAhead(bytes, 1, 3) is Ok(_))
    Check(connection.RetainReadAhead(bytes, 0, 1) is Failure(_))
    // This path must complete synchronously from buffered input without socket I/O.
    // Observing completion directly makes an unintended transport read fail the test.
    let cancellation = CancellationTokenSource()
    cancellation.Cancel()
    Check(connection.Receive(target, 0, 1, cancellation.Token).IsCancelled)
    let first = connection.Receive(target, 0, 1, CancellationToken.None)
    Check(first.IsCompleted && first.GetResult() is Ok(1))
    Check(target[0] == 8)
    let second = connection.Receive(target, 1, 1, CancellationToken.None)
    Check(second.IsCompleted && second.GetResult() is Ok(1))
    Check(target[1] == 9)
    Check(connection.RetainReadAhead(bytes, 0, 1) is Ok(_))
    connection.Close()
    connection.Close()
    Check(connection.RetainReadAhead(bytes, 0, 0) is Failure(_))
    cancellation.Dispose()
}


func BodyWindow(chunked: bool) {
    let Ok(socket) = Socket.Listen("127.0.0.1", 0, 8) else { Panic("Fixture listener") }
    let connection = HttpConnection(socket)
    let bytes: byte[] = if chunked { [(byte)50, (byte)13, (byte)10, (byte)65, (byte)66, (byte)13, (byte)10, (byte)48, (byte)13, (byte)10, (byte)13, (byte)10, (byte)78, (byte)69, (byte)88, (byte)84] } else { [(byte)65, (byte)66, (byte)78, (byte)69, (byte)88, (byte)84] }
    let body = HttpBodyInput(connection, bytes, 0, bytes.Length,
        if chunked { -3 } else { 2 }, 32, None(), false, false)
    let target: byte[] = [(byte)0, (byte)0, (byte)0, (byte)0]
    Check(!body.TryReleaseForReuse())
    // Immediate observation verifies that the coalesced body never reads the socket.
    let read = body.Read(target, 0, 4)
    Check(read.IsCompleted && read.GetResult() is Ok(2))
    Check(target[0] == 65 && target[1] == 66)
    Check(body.TryReleaseForReuse())
    Check(!body.TryReleaseForReuse())
    body.Close()
    GC.Collect()
    let next = connection.Receive(target, 0, 4, CancellationToken.None)
    Check(next.IsCompleted && next.GetResult() is Ok(4))
    Check(target[0] == 78 && target[1] == 69 && target[2] == 88 && target[3] == 84)
    connection.Close()
}

func RejectedBodyWindow() {
    let Ok(socket) = Socket.Listen("127.0.0.1", 0, 8) else { Panic("Fixture listener") }
    let connection = HttpConnection(socket)
    let bytes: byte[] = [(byte)65]
    let owning = HttpBodyInput(connection, bytes, 0, 0, 0, 32, None(), true, false)
    Check(!owning.TryReleaseForReuse())
    let body = HttpBodyInput(connection, bytes, 0, 1, 0, 32, None(), false, false)
    Check(connection.RetainReadAhead(bytes, 0, 1) is Ok(_))
    // Collision must not retire the body or replace the previously retained input.
    Check(!body.TryReleaseForReuse())
    let target: byte[] = [(byte)0]
    let next = connection.Receive(target, 0, 1, CancellationToken.None)
    Check(next.IsCompleted && next.GetResult() is Ok(1) && target[0] == 65)
    Check(body.TryReleaseForReuse())
    body.Close()
    owning.Close()
}

func SessionWindow() {
    let Ok(socket) = Socket.Listen("127.0.0.1", 0, 8) else { Panic("Fixture listener") }
    let connection = HttpConnection(socket)
    let Ok(settings) = HttpServerSettings.Create(HttpServerOptions()) else { Panic("Settings") }
    let session = HttpRequestSession(connection, settings, false)
    var wire = ""
    for index in 0..128 {
        wire += if index % 2 == 0 { "GET /one HTTP/1.1\r\nHost: localhost\r\n\r\n" } else { "GET /two HTTP/1.1\r\nHost: localhost\r\n\r\n" }
    }
    let bytes = HttpText.Snapshot(HttpText.Encode(wire))
    if !(bytes.Length > 4096) { Panic("Session check 1") }
    if !(connection.RetainReadAhead(bytes, 0, bytes.Length) is Ok(_)) { Panic("Session check 2") }
    for index in 0..128 {
        let read = session.Read(CancellationToken.None)
        if !(read.IsCompleted) { Panic("Session check 3") }
        let Ok(request) = read.GetResult() else { Panic("Session request") }
        if !(request.Target == (if index % 2 == 0 { "/one" } else { "/two" })) { Panic("Session check 4") }
        if !(session.Read(CancellationToken.None).GetResult() is Failure(_)) { Panic("Session check 5") }
        GC.Collect()
        if !(session.Retire()) { Panic("Session check 6") }
        if !(!session.Retire()) { Panic("Session check 7") }
    }
    session.Close()
    session.Close()
    if !(session.Read(CancellationToken.None).GetResult() is Failure(_)) { Panic("Session check 8") }
}


func SessionBodyWindow(consume: bool) {
    let Ok(socket) = Socket.Listen("127.0.0.1", 0, 8) else { Panic("Fixture listener") }
    let connection = HttpConnection(socket)
    let Ok(settings) = HttpServerSettings.Create(HttpServerOptions()) else { Panic("Settings") }
    let session = HttpRequestSession(connection, settings, false)
    let bytes = HttpText.Snapshot(HttpText.Encode("POST /body HTTP/1.1\r\nHost: localhost\r\nContent-Length: 2\r\n\r\nABGET /tail HTTP/1.1\r\nHost: localhost\r\n\r\n"))
    Check(connection.RetainReadAhead(bytes, 0, bytes.Length) is Ok(_))
    let read = session.Read(CancellationToken.None)
    Check(read.IsCompleted)
    let Ok(request) = read.GetResult() else { Panic("Session body request") }
    Check(request.Target == "/body")
    if consume {
        let Some(stream) = request.Content.TryGetStream() else { Panic("Session body stream") }
        let target: byte[] = [(byte)0, (byte)0]
        let bodyRead = stream.Read(target, 0, 2)
        Check(bodyRead.IsCompleted && bodyRead.GetResult() is Ok(2))
        Check(target[0] == 65 && target[1] == 66)
        Check(session.Retire())
        GC.Collect()
        let next = session.Read(CancellationToken.None)
        Check(next.IsCompleted)
        let Ok(tail) = next.GetResult() else { Panic("Session tail request") }
        Check(tail.Target == "/tail")
        Check(session.Retire())
    } else {
        Check(!session.Retire())
        Check(session.Read(CancellationToken.None).GetResult() is Failure(_))
    }
    session.Close()
}

func Main() {
    var cases = 0
    for start in 0..9 {
        for end in start..9 {
            let source: byte[] = [for index in 0..8 => (byte)(10 + index)]
            let target: byte[] = [for index in 0..4 => (byte)99]
            // OwnedWindow has returned; only input retains its source array.
            let input = OwnedWindow(start, end)
            Check(input.Count == end - start)
            if end > start {
                Check(input.Save(source, 0, 1) is Failure(_))
                Check(input.Read(target, 4, 1) is Failure(_))
                Check(input.Count == end - start)
                Check(input.Read(target, 4, 0) is Ok(0))
            }
            GC.Collect()
            var position = start
            while input.Count > 0 {
                let Ok(count) = input.Read(target, 1, 2) else { Panic("Read failed") }
                Check(count > 0 && count <= 2)
                var index = 0
                while index < count {
                    Check(target[index + 1] == source[position + index])
                    index += 1
                }
                Check(target[0] == 99 && target[3] == 99)
                position += count
                GC.Collect()
            }
            Check(position == end)
            Check(input.Read(target, 0, 4) is Ok(0))
            Check(input.Save(source, 7, 8) is Ok(_))
            Check(input.Read(target, 0, 4) is Ok(1))
            Check(target[0] == 17)
            input.Close()
            input.Close()
            Check(input.Count == 0)
            Check(input.Save(source, 0, 0) is Failure(_))
            Check(input.Read(target, 0, 0) is Failure(_))
            cases += 1
        }
    }
    let invalid = HttpReadAhead()
    let bytes: byte[] = [(byte)1, (byte)2]
    Check(invalid.Save(bytes, -1, 1) is Failure(_))
    Check(invalid.Save(bytes, 2, 1) is Failure(_))
    Check(invalid.Save(bytes, 0, 3) is Failure(_))
    Check(invalid.Read(bytes, -1, 1) is Failure(_))
    Check(invalid.Read(bytes, 0, -1) is Failure(_))
    Check(invalid.Count == 0)
    Check(invalid.Save(bytes, 0, 2) is Ok(_))
    Check(invalid.Read(bytes, 0, 1) is Failure(_))
    Check(invalid.Count == 2)
    Check(cases == 45)
    ConnectionWindow()
    BodyWindow(false)
    BodyWindow(true)
    RejectedBodyWindow()
    SessionWindow()
    SessionBodyWindow(true)
    SessionBodyWindow(false)
    Console.WriteLine("Read-ahead: 45 windows passed")
}
