<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(NeoClrBundleRoot)/lib/NeoCLR.ClassLibrary.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RavenNeoClrRuntimeAsyncHelper></RavenNeoClrRuntimeAsyncHelper>
    <AssemblyName>WireTests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Remove="System.Web" />
    <Compile Include="Wire.rvn" />
    <Compile Include="$(NeoClrBundleRoot)/lib/RuntimeAwait.rvn" />
    <!-- Compile exact System.Web sources so session/parser internals need no friend grant. -->
    <Compile Include="../../../runtime/raven/src/System/Web/**/*.rvn" />
  </ItemGroup>
</Project>
