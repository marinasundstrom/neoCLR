import System.*
import System.Collections.*
import System.Concurrency.Tasks.*
import System.Data.Json.*
import System.Result.*
import System.Web.Http.*
import System.Web.Http.Json.*

async func Main() -> Task<()> {
    let sources = ["[1,2,3,4,5,6,7,8]", "{\"first\":\"Café 😀\",\"second\":\"hello\"}", "{\"escaped\":\"é😀\\n\\u0000\\\"\"}"]
    for source in sources {
        let Ok(node) = JsonSerializer.DeserializeNode(source) else {
            Panic("Fixture parse failed")
        }
        let Ok(expected) = JsonSerializer.SerializeNode(node) else {
            Panic("Fixture serialization failed")
        }
        let bytes = source.Utf8Bytes.ToArray()
        let list = ArrayList<byte>()
        for value in bytes {
            list.Add(value)
        }
        let contents = [HttpContent(bytes), HttpContent(list)]
        for content in contents {
            for index in 0..100 {
                let Ok(value) = JsonContent.ReadNode(content) else {
                    Panic("HTTP JSON parse failed")
                }
                let Ok(actual) = JsonSerializer.SerializeNode(value) else {
                    Panic("HTTP JSON serialization failed")
                }
                if !actual.Equals(expected) {
                    Panic("HTTP JSON content mismatch")
                }
            }
        }
    }
    Console.WriteLine("PASS JSON byte input probe")
}
