import System.*
import System.Collections.*

class Reading {
    val Value: int

    init(value: int) {
        Value = value
    }
}

// Scalar processing with no objects allocated inside the work loop.
func Main() {
    var total = 0
    var phase = 0
    while phase < 65536 {
        var offset = 0
        while offset < 1024 {
            let step = phase * 1024 + offset
            total += step % 17
            offset += 1
        }
        phase += 1
    }
    Console.WriteLine(total)
}
