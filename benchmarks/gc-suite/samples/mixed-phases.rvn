import System.*
import System.Collections.*

class Reading {
    val Value: int

    init(value: int) {
        Value = value
    }
}

// Alternating eight-phase allocation-heavy and compute-only periods.
func Main() {
    var total = 0
    var phase = 0
    while phase < 2048 {
        var offset = 0
        while offset < 1024 {
            let step = phase * 1024 + offset
            if phase % 16 < 8 {
                let reading = Reading(step % 17)
                total += reading.Value
            } else {
                total += step % 17
            }
            offset += 1
        }
        phase += 1
    }
    Console.WriteLine(total)
}
