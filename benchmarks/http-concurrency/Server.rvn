import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Web.Http.*
import System.Time.*

func Respond(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
    if request.Method.Method == "POST" && request.Content.Length != 8 {
        System.Fail("Incomplete request body")
    }
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("Content-Type", "text/plain; charset=utf-8"))
    let response: Result<HttpResponse, HttpError> = Ok(HttpResponse(200, headers, HttpContent.FromText("Café 🌍").Bytes))
    return Task.FromResult(response)
}

// Cancellation-observation adapter: awaiting a cancelled task itself would fault.
func ObserveCancellation(pending: Task<Result<HttpContext, HttpError>>) -> Task<bool> {
    let observed = Promise<bool>()
    pending.OnCompleted(() => {
        _ = observed.Complete(pending.IsCancelled)
    })
    return observed.Task
}

async func Main() -> Task<()> {
    let width = 4
    let options = HttpServerOptions()
    options.RequestReadTimeout = Duration.FromTicks(600000000L)
    let Ok(server) = HttpServer.Listen("127.0.0.1", 0, 16, options) else {
        System.Fail("Listen failed")
    }
    let Ok(port) = server.GetLocalPort() else {
        System.Fail("Port unavailable")
    }
    Console.WriteLine(port)
    for batch in 0..4 {
        let operations = ArrayList<Task<Result<System.Void, HttpError>>>()
        operations.Add(server.ServeOne(Respond))
        let headStop = CancellationTokenSource()
        let middleStop = CancellationTokenSource()
        let tailStop = CancellationTokenSource()
        let head = server.Accept(headStop.Token)
        for index in 1..(width / 2) {
            operations.Add(server.ServeOne(Respond))
        }
        let middle = server.Accept(middleStop.Token)
        for index in (width / 2)..width {
            operations.Add(server.ServeOne(Respond))
        }
        let tail = server.Accept(tailStop.Token)
        middleStop.Cancel()
        tailStop.Cancel()
        headStop.Cancel()
        if !head.IsCancelled || !middle.IsCancelled || !tail.IsCancelled {
            System.Fail("Queued cancellation was not immediate")
        }
        headStop.Dispose()
        middleStop.Dispose()
        tailStop.Dispose()
        // Repeated cancelled admissions must not accumulate queue nodes or slots.
        for index in 0..32 {
            let stop = CancellationTokenSource()
            let cancelled = server.Accept(stop.Token)
            stop.Cancel()
            if !cancelled.IsCancelled {
                System.Fail("Cancelled accept retained admission")
            }
            stop.Dispose()
        }
        Console.WriteLine("BATCH")
        for operation in operations {
            if let Error(error) = await operation {
                System.Fail(error.ToString())
            }
        }
    }
    let waiting = ArrayList<Task<Result<HttpContext, HttpError>>>()
    for index in 0..16 {
        waiting.Add(server.Accept())
    }
    if let Ok(_) = await server.Accept() {
        System.Fail("Exceeded admission limit")
    }
    server.Close()
    for pending in waiting {
        if !(await ObserveCancellation(pending)) {
            System.Fail("Shutdown did not cancel pending accept")
        }
    }
    Console.WriteLine("DONE")
}
