module Benchmarks.Discovery

import System.*
import NeoClr.Benchmarking.*

[Benchmark]
func `Sum a sequence of integers`() -> int {
    var total = 0
    for value in 0..100 {
        total += value
    }
    if total != 4950 {
        System.Fail("Sum changed")
    }
    return 1
}

[Benchmark]
func Multiply() -> int {
    var total = 1
    for value in 1..6 {
        total *= value
    }
    if total != 120 {
        System.Fail("Product changed")
    }
    return 1
}

func Main(arguments: string[]) {
    let suite = BenchmarkSuite()
    suite.Add("manual", () => 1)
    RegisterDiscoveredBenchmarks(suite)
    suite.Run(arguments)
}

[Benchmark]
[Arguments(5)]
[Arguments(9)]
func `Add café. 世界 😀`(value: int) -> int {
    if value != 5 {
        if value != 9 { System.Fail("Wrong inline argument") }
    }
    return 1
}

func `Inputs with spaces. λ`() -> int[] => [3, 7]

[Benchmark]
[ArgumentsSource("Inputs with spaces. λ")]
func `Accept source rows`(value: int) -> int {
    if value != 3 {
        if value != 7 { System.Fail("Wrong source argument") }
    }
    return 1
}
