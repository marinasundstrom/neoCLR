module NeoClr.Benchmarking

import System.*
import System.Collections.*
import System.Result.*

// Development tooling contract; not part of the distributed runtime library.
class BenchmarkCase {
    val Name: string
    private val operation: () -> int

    init(name: string, operation: () -> int) {
        Name = name
        self.operation = operation
    }

    func Invoke() -> int => operation()
}

class BenchmarkSuite {
    private val cases = ArrayList<BenchmarkCase>()

    func Add(name: string, operation: () -> int) {
        if name == "" {
            Panic("Benchmark name must not be empty")
        }
        for item in cases {
            if item.Name == name {
                Panic("Duplicate benchmark name")
            }
        }
        cases.Add(BenchmarkCase(name, operation))
    }

    func Run(arguments: string[]) {
        if arguments.Length == 1 {
            if arguments[0] == "--list" {
                Console.WriteLine("NEOBENCH/1 CASES")
                for item in cases {
                    Console.WriteLine(item.Name)
                }
                Console.WriteLine("NEOBENCH/1 END")
                return
            }
        }
        if arguments.Length != 3 {
            Panic("Expected benchmark name, warmup count and operation count")
        }
        let Ok(warmups) = Int32.Parse(arguments[1]) else {
            Panic("Invalid warmup count")
        }
        let Ok(operations) = Int32.Parse(arguments[2]) else {
            Panic("Invalid operation count")
        }
        if warmups < 0 {
            Panic("Benchmark count outside supported range")
        }
        if warmups > 10000 {
            Panic("Benchmark count outside supported range")
        }
        if operations < 1 {
            Panic("Benchmark count outside supported range")
        }
        if operations > 10000 {
            Panic("Benchmark count outside supported range")
        }
        for item in cases {
            if item.Name == arguments[0] {
                Console.WriteLine("NEOBENCH/1 READY")
                var index = 0
                while index < warmups {
                    if item.Invoke() != 1 {
                        Panic("Warmup correctness check failed")
                    }
                    index += 1
                }
                Console.WriteLine("NEOBENCH/1 BEGIN")
                index = 0
                var checksum = 0
                while index < operations {
                    let result = item.Invoke()
                    if result != 1 {
                        Panic("Benchmark correctness check failed")
                    }
                    checksum += result
                    index += 1
                }
                Console.WriteLine("NEOBENCH/1 END")
                Console.WriteLine(checksum)
                return
            }
        }
        Panic("Unknown benchmark name")
    }
}
