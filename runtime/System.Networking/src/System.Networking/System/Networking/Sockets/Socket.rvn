module System.Networking.Sockets

import System.*
import System.Networking.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Concurrency.*
import System.Collections.*
import System.Runtime.CompilerServices.*

public class Socket {
    private field handle: long

    internal init(handle: long) {
        self.handle = handle
    }

    /// Waits without consuming bytes until TCP receive EOF or a transport error is observed.
    /// Queued unread bytes delay EOF observation. One observer per socket is supported;
    /// ordinary receives may proceed concurrently. There is no implicit timeout.
    /// Cancellation stops only this observation, after provider acknowledgement.
    async func WaitForReadClosure(cancellationToken: CancellationToken = default) -> Task<Result<unit, SocketError>> {
        let source = Promise<Result<int, SocketError>>()
        let completion = SocketTransferCompletion(source, cancellationToken)
        completion.StartReadClosure(handle)
        let result = await source.Task
        if let Failure(error) = result { return Failure(error) }
        return Ok(())
    }

    /// Connects to an address value. IPv6 transport is not supported yet.
    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(address: IPAddress, port: int, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<Socket, SocketError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        if address is IPv4Address {
            return Connect(address.ToString(), port, cancellationToken)
        }
        let source = Promise<Result<Socket, SocketError>>()
        _ = source.Complete(Failure(SocketError.UnsupportedAddressFamily()))
        return source.Task
    }

    /// Tries address values within the existing bounded connection policy.
    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(addresses: Sequence<IPAddress>, port: int, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        return ConnectUntil(addresses, port, 0, cancellationToken)
    }

    /// <summary>Performs the operation within a shared deadline without renewing its budget.</summary>
    /// <remarks>Pre-requested cancellation takes precedence over an expired deadline; expiry otherwise returns TimedOut.</remarks>
    static func ConnectUntil(addresses: Sequence<IPAddress>, port: int, deadline: NetworkDeadline, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        if !cancellationToken.IsCancellationRequested && deadline.IsExpired {
            let source = Promise<Result<Socket, SocketError>>()
            _ = source.Complete(Failure(SocketError.TimedOut))
            return source.Task
        }
        return ConnectUntil(addresses, port, deadline.Stamp, cancellationToken)
    }

    internal static func ConnectUntil(addresses: Sequence<IPAddress>, port: int, deadline: long, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<Socket, SocketError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        if addresses.Count == 0 {
            let empty = Promise<Result<Socket, SocketError>>()
            _ = empty.Complete(Failure(SocketError.InvalidRange()))
            return empty.Task
        }
        if addresses.Count > 16 {
            let excessive = Promise<Result<Socket, SocketError>>()
            _ = excessive.Complete(Failure(SocketError.LimitExceeded()))
            return excessive.Task
        }
        let text = ArrayList<string>()
        var index = 0
        while index < addresses.Count {
            let address = addresses[index]
            if !(address is IPv4Address) {
                let source = Promise<Result<Socket, SocketError>>()
                _ = source.Complete(Failure(SocketError.UnsupportedAddressFamily()))
                return source.Task
            }
            text.Add(address.ToString())
            index += 1
        }
        return ConnectUntil(text, port, deadline, cancellationToken)
    }

    /// Listens on an address value. IPv6 transport is not supported yet.
    static func Listen(address: IPAddress, port: int, backlog: int) -> Result<Socket, SocketError> {
        if address is IPv4Address {
            return Listen(address.ToString(), port, backlog)
        }
        return Failure(SocketError.UnsupportedAddressFamily())
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(address: string, port: int, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        let source = Promise<Result<Socket, SocketError>>()
        let completion = SocketConnectCompletion(source, cancellationToken)
        completion.Start(address, port)
        return source.Task
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(addresses: Sequence<string>, port: int, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        return ConnectUntil(addresses, port, 0, cancellationToken)
    }

    /// <summary>Performs the operation within a shared deadline without renewing its budget.</summary>
    /// <remarks>Pre-requested cancellation takes precedence over an expired deadline; expiry otherwise returns TimedOut.</remarks>
    static func ConnectUntil(addresses: Sequence<string>, port: int, deadline: NetworkDeadline, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        if !cancellationToken.IsCancellationRequested && deadline.IsExpired {
            let source = Promise<Result<Socket, SocketError>>()
            _ = source.Complete(Failure(SocketError.TimedOut))
            return source.Task
        }
        return ConnectUntil(addresses, port, deadline.Stamp, cancellationToken)
    }

    internal static func ConnectUntil(addresses: Sequence<string>, port: int, deadline: long, cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        let source = Promise<Result<Socket, SocketError>>()
        let completion = SocketConnectCompletion(source, cancellationToken)
        completion.StartAddressesUntil(addresses, port, deadline)
        return source.Task
    }

    static func Listen(address: string, port: int, backlog: int) -> Result<Socket, SocketError> {
        let payload = neoCLR.Runtime.SocketListen(address, port, backlog)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(Socket(neoCLR.Runtime.UnpackValue<long>(payload)))
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    func Accept(cancellationToken: CancellationToken = default) -> Task<Result<Socket, SocketError>> {
        let source = Promise<Result<Socket, SocketError>>()
        let completion = SocketConnectCompletion(source, cancellationToken)
        completion.StartAccept(handle)
        return source.Task
    }

    func GetLocalPort() -> Result<int, SocketError> {
        let payload = neoCLR.Runtime.SocketLocalPort(handle)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(neoCLR.Runtime.UnpackValue<int>(payload))
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    func Receive(buffer: Memory<byte>, cancellationToken: CancellationToken = default) -> Task<Result<int, SocketError>> {
        return ReceiveUntil(buffer, 0, cancellationToken)
    }

    /// <summary>Performs the operation within a shared deadline without renewing its budget.</summary>
    /// <remarks>Pre-requested cancellation takes precedence over an expired deadline; expiry otherwise returns TimedOut.</remarks>
    func ReceiveUntil(buffer: Memory<byte>, deadline: NetworkDeadline, cancellationToken: CancellationToken = default) -> Task<Result<int, SocketError>> {
        if !cancellationToken.IsCancellationRequested && deadline.IsExpired {
            let source = Promise<Result<int, SocketError>>()
            _ = source.Complete(Failure(SocketError.TimedOut))
            return source.Task
        }
        return ReceiveUntil(buffer, deadline.Stamp, cancellationToken)
    }

    internal func ReceiveUntil(buffer: Memory<byte>, deadline: long, cancellationToken: CancellationToken = default) -> Task<Result<int, SocketError>> {
        let source = Promise<Result<int, SocketError>>()
        let completion = SocketTransferCompletion(source, cancellationToken)
        completion.StartReceiveUntil(handle, buffer, deadline)
        return source.Task
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    func Send(buffer: ReadOnlyMemory<byte>, cancellationToken: CancellationToken = default) -> Task<Result<int, SocketError>> {
        return SendUntil(buffer, 0, cancellationToken)
    }

    /// <summary>Performs the operation within a shared deadline without renewing its budget.</summary>
    /// <remarks>Pre-requested cancellation takes precedence over an expired deadline; expiry otherwise returns TimedOut.</remarks>
    func SendUntil(buffer: ReadOnlyMemory<byte>, deadline: NetworkDeadline, cancellationToken: CancellationToken = default) -> Task<Result<int, SocketError>> {
        if !cancellationToken.IsCancellationRequested && deadline.IsExpired {
            let source = Promise<Result<int, SocketError>>()
            _ = source.Complete(Failure(SocketError.TimedOut))
            return source.Task
        }
        return SendUntil(buffer, deadline.Stamp, cancellationToken)
    }

    internal func SendUntil(buffer: ReadOnlyMemory<byte>, deadline: long, cancellationToken: CancellationToken = default) -> Task<Result<int, SocketError>> {
        let source = Promise<Result<int, SocketError>>()
        let completion = SocketTransferCompletion(source, cancellationToken)
        completion.StartSendUntil(handle, buffer, deadline)
        return source.Task
    }

    func Close() {
        _ = neoCLR.Runtime.SocketClose(handle)
    }

    internal static func DecodeError(code: byte) -> SocketError {
        if code == 1 {
            return SocketError.Closed()
        }
        if code == 2 {
            return SocketError.Busy()
        }
        if code == 3 {
            return SocketError.InvalidRange()
        }
        if code == 4 {
            return SocketError.LimitExceeded()
        }
        if code == 5 {
            return SocketError.Cancelled()
        }
        if code == 6 {
            return SocketError.InvalidAddress()
        }
        if code == 7 {
            return SocketError.ConnectionRefused()
        }
        if code == 8 {
            return SocketError.ConnectionReset()
        }
        if code == 9 {
            return SocketError.AccessDenied()
        }
        if code == 10 {
            return SocketError.TimedOut()
        }
        if code == 11 {
            return SocketError.IoFailure()
        }
        if code == 12 {
            return SocketError.InvalidOperation()
        }
        if code == 13 {
            return SocketError.AddressInUse()
        }
        Panic("invalid native socket error")
        return SocketError.IoFailure()
    }
}

internal class SocketConnectCompletion {
    private var source: Promise<Result<Socket, SocketError>>
    private var operation: long
    private var token: CancellationToken
    private var registration: CancellationRegistration?
    private var cancellationWon: bool

    internal init(source: Promise<Result<Socket, SocketError>>, token: CancellationToken) {
        self.source = source
        operation = 0
        self.token = token
        registration = null
        cancellationWon = false
    }

    internal func Start(address: string, port: int) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = neoCLR.Runtime.SocketConnect(address, port, self.Complete)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            operation = neoCLR.Runtime.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func StartAddresses(addresses: Sequence<string>, port: int) {
        StartAddressesUntil(addresses, port, 0)
    }

    internal func StartAddressesUntil(addresses: Sequence<string>, port: int, deadline: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        let count = addresses.Count
        if count <= 0 {
            _ = source.Complete(Failure(SocketError.InvalidRange()))
            return
        }
        if count > 16 {
            _ = source.Complete(Failure(SocketError.LimitExceeded()))
            return
        }
        let snapshot = CheckedStorage.Reserve<string>(count)
        var index = 0
        while index < count {
            snapshot[index] = addresses[index]
            index += 1
        }
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            neoCLR.Runtime.SocketConnectAddresses(snapshot, port, self.Complete)
        } else {
            neoCLR.Runtime.SocketConnectAddressesUntil(snapshot, port, deadline, self.Complete)
        }
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            operation = neoCLR.Runtime.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func StartAccept(handle: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = neoCLR.Runtime.SocketAccept(handle, self.Complete)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            operation = neoCLR.Runtime.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func RequestCancellation() {
        cancellationWon = neoCLR.Runtime.SocketCancel(operation)
    }

    internal func Complete() {
        let active = registration
        registration = null
        if active is CancellationRegistration current {
            current.Dispose()
        }
        let payload = neoCLR.Runtime.SocketConnectResult(operation)
        operation = 0
        if cancellationWon {
            _ = source.Cancel()
            return
        }
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            _ = source.Complete(Ok(Socket(neoCLR.Runtime.UnpackValue<long>(payload))))
        }
    }
}

internal class SocketTransferCompletion {
    private var source: Promise<Result<int, SocketError>>
    private var operation: long
    private var token: CancellationToken
    private var registration: CancellationRegistration?
    private var cancellationWon: bool

    internal init(source: Promise<Result<int, SocketError>>, token: CancellationToken) {
        self.source = source
        operation = 0
        self.token = token
        registration = null
        cancellationWon = false
    }

    internal func StartReadClosure(handle: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = neoCLR.Runtime.SocketWaitReadClosure(handle, self.Complete)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            operation = neoCLR.Runtime.UnpackValue<long>(payload)
            if token.CanBeCancelled { registration = token.Register(self.RequestCancellation) }
        }
    }

    internal func StartReceive(handle: long, buffer: Memory<byte>) {
        StartReceiveUntil(handle, buffer, 0)
    }

    internal func StartReceiveUntil(handle: long, buffer: Memory<byte>, deadline: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            neoCLR.Runtime.SocketReceive(handle, buffer, self.Complete)
        } else {
            neoCLR.Runtime.SocketReceiveUntil(handle, buffer, deadline, self.Complete)
        }
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            operation = neoCLR.Runtime.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func StartSend(handle: long, buffer: ReadOnlyMemory<byte>) {
        StartSendUntil(handle, buffer, 0)
    }

    internal func StartSendUntil(handle: long, buffer: ReadOnlyMemory<byte>, deadline: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            neoCLR.Runtime.SocketSend(handle, buffer, self.Complete)
        } else {
            neoCLR.Runtime.SocketSendUntil(handle, buffer, deadline, self.Complete)
        }
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            operation = neoCLR.Runtime.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func RequestCancellation() {
        cancellationWon = neoCLR.Runtime.SocketCancel(operation)
    }

    internal func Complete() {
        let active = registration
        registration = null
        if active is CancellationRegistration current {
            current.Dispose()
        }
        let payload = neoCLR.Runtime.SocketTransferResult(operation)
        operation = 0
        if cancellationWon {
            _ = source.Cancel()
            return
        }
        if neoCLR.Runtime.IsValue<byte>(payload) {
            _ = source.Complete(Failure(Socket.DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload))))
        } else {
            _ = source.Complete(Ok(neoCLR.Runtime.UnpackValue<int>(payload)))
        }
    }
}
