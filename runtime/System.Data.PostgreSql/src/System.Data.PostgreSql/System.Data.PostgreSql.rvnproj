<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../NativeLibrary.props" />
  <PropertyGroup>
    <AssemblyName>System.Data.PostgreSql</AssemblyName>
    <!-- Explicit existing native async experiment; no ordinary .NET target change. -->
    <RavenNeoClrRuntimeAsyncHelper>RuntimeAwaitProvider.Bridge</RavenNeoClrRuntimeAsyncHelper>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="System/**/*.rvn" />
    <Compile Include="../../../compiler-services/RuntimeAwait.rvn" />
    <ProjectReference Include="../../../System.Runtime/src/System.Runtime/System.Runtime.rvnproj" />
    <ProjectReference Include="../../../System.Data/src/System.Data/System.Data.rvnproj" />
    <ProjectReference Include="../../../System.Networking/src/System.Networking/System.Networking.rvnproj" />
  </ItemGroup>
</Project>
