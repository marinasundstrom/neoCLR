module System.Web.Http.Json

import System.*
import System.Diagnostics.CodeAnalysis.*
import System.Concurrency.*
import System.Data.Json.*
import System.Introspection.*
import System.IO.*
import System.Optional.*
import System.Text.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

/// Asynchronous JSON reads for buffered or streaming request and response content.
public extension HttpContentJsonExtensions for HttpContent {
    /// Pre-cancellation skips conversion and returns a cancelled task.
    /// Buffered conversion is synchronous and cannot be interrupted once started.
    func ReadFromJson<[DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] T>(cancellationToken: CancellationToken = default) -> Task<Result<T, JsonError>> {
        if !cancellationToken.IsCancellationRequested && !self.IsBuffered {
            if self.IsDisposed || self.BeginUpload() is Failure(_) {
                return Task.FromResult<Result<T, JsonError>>(Result<T, JsonError>.Failure(JsonError.Read(TextReadError.IoFailure)))
            }
            if let Some(stream) = self.TryGetStream() {
                return JsonSerializer.Deserialize<T>(HttpContentTextInput(self, stream, cancellationToken))
            }
        }
        let source = Promise<Result<T, JsonError>>()
        if cancellationToken.IsCancellationRequested {
            _ = source.Cancel()
        } else {
            _ = source.Complete(JsonContent.Read<T>(self))
        }
        return source.Task
    }

    /// Reads JSON using a runtime type; cancellation applies to asynchronous stream reads.
    func ReadFromJson([DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] type: TypeInfo, cancellationToken: CancellationToken = default) -> Task<Result<Object, JsonError>> {
        if !cancellationToken.IsCancellationRequested && !self.IsBuffered {
            if self.IsDisposed || self.BeginUpload() is Failure(_) {
                return Task.FromResult<Result<Object, JsonError>>(Result<Object, JsonError>.Failure(JsonError.Read(TextReadError.IoFailure)))
            }
            if let Some(stream) = self.TryGetStream() {
                return JsonSerializer.Deserialize(HttpContentTextInput(self, stream, cancellationToken), type)
            }
        }
        let source = Promise<Result<Object, JsonError>>()
        if cancellationToken.IsCancellationRequested {
            _ = source.Cancel()
        } else {
            _ = source.Complete(JsonContent.Read(self, type))
        }
        return source.Task
    }

    /// Parses a JSON DOM; cancellation applies to asynchronous stream reads.
    func ReadJsonNode(cancellationToken: CancellationToken = default) -> Task<Result<JsonValue, JsonError>> {
        if !cancellationToken.IsCancellationRequested && !self.IsBuffered {
            if self.IsDisposed || self.BeginUpload() is Failure(_) {
                return Task.FromResult<Result<JsonValue, JsonError>>(Result<JsonValue, JsonError>.Failure(JsonError.Read(TextReadError.IoFailure)))
            }
            if let Some(stream) = self.TryGetStream() {
                return JsonSerializer.DeserializeNode(HttpContentTextInput(self, stream, cancellationToken))
            }
        }
        let source = Promise<Result<JsonValue, JsonError>>()
        if cancellationToken.IsCancellationRequested {
            _ = source.Cancel()
        } else {
            _ = source.Complete(JsonContent.ReadNode(self))
        }
        return source.Task
    }
}
