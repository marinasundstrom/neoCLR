module System.Web.Http

import System.*

// Fixed, bounded catalog. Interning only on a cache miss makes competing first
// readers publish the same immutable string. Later reads need no intern lookup.
// Storage and the intern pool belong to the runtime invocation, not the process.
/// Common HTTP field names. Values are canonical lowercase strings; field lookup is ASCII case-insensitive.
/// Custom field names remain supported as strings. Only this fixed catalog is interned.
public static class HttpHeaderNames {
    private static var host: string?
    private static var connection: string?
    private static var contentLength: string?
    private static var transferEncoding: string?
    private static var expect: string?
    private static var contentEncoding: string?
    private static var contentType: string?
    private static var accept: string?
    private static var acceptEncoding: string?
    private static var authorization: string?
    private static var cookie: string?
    private static var userAgent: string?
    private static var cacheControl: string?

    /// The Host field name.
    static val Host: string {
        get {
            if host is string cached {
                return cached
            }
            let value = String.Intern("host")
            host = value
            return value
        }
    }

    /// The Connection field name.
    static val Connection: string {
        get {
            if connection is string cached {
                return cached
            }
            let value = String.Intern("connection")
            connection = value
            return value
        }
    }

    /// The ContentLength field name.
    static val ContentLength: string {
        get {
            if contentLength is string cached {
                return cached
            }
            let value = String.Intern("content-length")
            contentLength = value
            return value
        }
    }

    /// The TransferEncoding field name.
    static val TransferEncoding: string {
        get {
            if transferEncoding is string cached {
                return cached
            }
            let value = String.Intern("transfer-encoding")
            transferEncoding = value
            return value
        }
    }

    /// The Expect field name.
    static val Expect: string {
        get {
            if expect is string cached {
                return cached
            }
            let value = String.Intern("expect")
            expect = value
            return value
        }
    }

    /// The ContentEncoding field name.
    static val ContentEncoding: string {
        get {
            if contentEncoding is string cached {
                return cached
            }
            let value = String.Intern("content-encoding")
            contentEncoding = value
            return value
        }
    }

    /// The ContentType field name.
    static val ContentType: string {
        get {
            if contentType is string cached {
                return cached
            }
            let value = String.Intern("content-type")
            contentType = value
            return value
        }
    }

    /// The Accept field name.
    static val Accept: string {
        get {
            if accept is string cached {
                return cached
            }
            let value = String.Intern("accept")
            accept = value
            return value
        }
    }

    /// The AcceptEncoding field name.
    static val AcceptEncoding: string {
        get {
            if acceptEncoding is string cached {
                return cached
            }
            let value = String.Intern("accept-encoding")
            acceptEncoding = value
            return value
        }
    }

    /// The Authorization field name.
    static val Authorization: string {
        get {
            if authorization is string cached {
                return cached
            }
            let value = String.Intern("authorization")
            authorization = value
            return value
        }
    }

    /// The Cookie field name.
    static val Cookie: string {
        get {
            if cookie is string cached {
                return cached
            }
            let value = String.Intern("cookie")
            cookie = value
            return value
        }
    }

    /// The UserAgent field name.
    static val UserAgent: string {
        get {
            if userAgent is string cached {
                return cached
            }
            let value = String.Intern("user-agent")
            userAgent = value
            return value
        }
    }

    /// The CacheControl field name.
    static val CacheControl: string {
        get {
            if cacheControl is string cached {
                return cached
            }
            let value = String.Intern("cache-control")
            cacheControl = value
            return value
        }
    }
    /// The Set-Cookie field name. Repeated values must remain separate.
    static val SetCookie: string => "set-cookie"
}
