module System.Web.Http

import System.*
import System.Collections.*
import System.Optional.*
import System.Result.*

/// Read-only HTTP fields in wire order. Repeated names remain separate.
/// Incoming messages expose this contract; use MutableHttpHeaderCollection for outgoing mutation.
public interface HttpHeaderCollection : Sequence<HttpHeader> {
    /// A reusable immutable empty collection, cached within the runtime invocation.
    static val Empty: HttpHeaderCollection => ReadOnlyHttpHeaderCollection.Empty

    /// Copies entries into an independent read-only collection. Does not validate outgoing framing.
    static func Snapshot(headers: Sequence<HttpHeader>) -> HttpHeaderCollection {
        return ReadOnlyHttpHeaderCollection(headers)
    }

    /// All matching raw values in order; empty for absent or invalid names. Independent snapshot, without comma splitting.
    val self[name: string]: Sequence<string> { get }
    /// Whether a valid ASCII case-insensitive field name is present. Invalid names return false.
    func Contains(name: string) -> bool
    /// None when absent, Some for a single value (including empty), Protocol for invalid names or repeated fields.
    func GetSingle(name: string) -> Result<Optional<string>, HttpError>
    /// Parses one Content-Type; None when absent, Protocol for malformed or duplicate fields. Does not read the body.
    func GetContentType() -> Result<Optional<MediaType>, HttpError>
}

/// Outgoing header mutation. Message-owned implementations apply their transport/content policy.
/// Incoming views and Empty do not implement this interface. No concurrent mutation is supported.
public interface MutableHttpHeaderCollection : HttpHeaderCollection {
    /// Creates an independent collection with name/value validation; framing is validated when sent.
    static func Create() -> MutableHttpHeaderCollection {
        return HttpMutableHeaderCollection(Array<HttpHeader>.Empty, false)
    }

    /// Replaces all fields of this name. Invalid input fails without mutation.
    func Set(name: string, value: string) -> Result<unit, HttpError>
    /// Appends a separate field value. Does not split or join commas; invalid input fails without mutation.
    func Append(name: string, value: string) -> Result<unit, HttpError>
    /// Removes all matching fields, returning whether any existed. Invalid or controlled names fail without mutation.
    func Remove(name: string) -> Result<bool, HttpError>
}
