module System.Web.Http

import System.*
import System.IO.*
import System.Result.*
import System.Optional.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Networking.*
import System.Networking.Sockets.*
import System.Networking.Security.*

// HTTP keeps its deadline across every underlying TLS read/write, including handshake.
internal class HttpSocketStream : InputStream, OutputStream {
    private val socket: Socket
    internal var Deadline: Optional<NetworkDeadline> = None()
    internal var LastError: Optional<SocketError> = None()
    internal init(socket: Socket) { self.socket = socket }
    func Read(buffer: byte[], offset: int, count: int) -> Task<Result<int, StreamError>> {
        return Read(buffer, offset, count, CancellationToken.None)
    }
    async func Read(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        let destination: Memory<byte> = buffer
        let window = destination.Slice(offset, count)
        let pending = if let Some(deadline) = Deadline {
            socket.ReceiveUntil(window, deadline, cancellationToken)
        } else { socket.Receive(window, cancellationToken) }
        if let Ok(read) = await pending {
            return Ok(read)
        }
        if let Failure(error) = pending.GetResult() { LastError = Some(error) }
        return Failure(StreamError.IoFailure)
    }
    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }
    async func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        let source: ReadOnlyMemory<byte> = buffer
        let window = source.Slice(offset, count)
        var sent = 0
        while sent < window.Length {
            let pending = if let Some(deadline) = Deadline {
                socket.SendUntil(window.Slice(sent), deadline, cancellationToken)
            } else { socket.Send(window.Slice(sent), cancellationToken) }
            let result = await pending
            if let Failure(error) = result {
                LastError = Some(error)
                return Failure(StreamError.IoFailure)
            }
            let Ok(written) = result else { Panic("Missing socket write outcome") }
            if written <= 0 || written > count - sent {
                return Failure(StreamError.IoFailure)
            }
            sent += written
        }
        return Ok(())
    }
    func Flush() -> Task<Result<unit, StreamError>> { return Flush(CancellationToken.None) }
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        let source = Promise<Result<unit, StreamError>>()
        if cancellationToken.IsCancellationRequested { _ = source.Cancel() }
        else { _ = source.Complete(Ok(())) }
        return source.Task
    }
    func Close() { socket.Close() }
}

internal class HttpConnection {
    private val transport: HttpSocketStream
    private var ssl: SslStream? = null
    private var readAhead: HttpReadAhead? = null
    private var closed = false

    // Move the entire unread window into the protocol session. No prefix copy
    // may leave a second tail behind when the session finishes one message.
    internal func TakeReadAhead() -> HttpReadAhead? {
        let retained = readAhead
        readAhead = null
        return retained
    }

    // Transfer only unread input; this private path prepares persistent-session support.
    // The receiving caller relinquishes the buffer after success.
    internal func RetainReadAhead(buffer: byte[], start: int, end: int) -> Result<unit, HttpError> {
        if closed || start < 0 || end < start || end > buffer.Length {
            return Failure(HttpError.InvalidRequest("Invalid connection read-ahead"))
        }
        if readAhead is HttpReadAhead retained {
            return retained.Save(buffer, start, end)
        }
        if start == end {
            return Ok(())
        }
        let created = HttpReadAhead()
        _ = created.Save(buffer, start, end)?
        readAhead = created
        return Ok(())
    }

    internal init(socket: Socket) { transport = HttpSocketStream(socket) }
    internal async func AuthenticateClient(options: SslClientAuthenticationOptions, host: string, token: CancellationToken) -> Task<Result<unit, HttpError>> {
        let stream = SslStream(transport, transport)
        ssl = stream
        if let Failure(error) = await stream.AuthenticateAsClient(options, host, token) {
            return Failure(HttpError.Tls(error))
        }
        return Ok(())
    }
    internal async func AuthenticateServer(options: SslServerAuthenticationOptions, deadline: NetworkDeadline, token: CancellationToken) -> Task<Result<unit, HttpError>> {
        transport.Deadline = Some(deadline)
        let stream = SslStream(transport, transport)
        ssl = stream
        if let Failure(error) = await stream.AuthenticateAsServer(options, token) {
            if deadline.IsExpired {
                return Failure(HttpError.TimedOut)
            }
            return Failure(HttpError.Tls(error))
        }
        return Ok(())
    }
    private func ToHttpError(error: StreamError) -> HttpError {
        if let Some(deadline) = transport.Deadline {
            if deadline.IsExpired {
                return HttpError.TimedOut
            }
        }
        if let Some(reason) = transport.LastError {
            return HttpError.Transport(reason)
        }
        return HttpError.SecureTransport(error)
    }
    internal func ReceiveUntil(buffer: byte[], offset: int, count: int, deadline: NetworkDeadline, token: CancellationToken) -> Task<Result<int, HttpError>> {
        transport.Deadline = Some(deadline)
        return Receive(buffer, offset, count, token)
    }
    internal async func Receive(buffer: byte[], offset: int, count: int, token: CancellationToken) -> Task<Result<int, HttpError>> {
        if readAhead is HttpReadAhead retained {
            if retained.Count > 0 {
                if token.IsCancellationRequested {
                    let cancelled = Promise<Result<int, HttpError>>()
                    _ = cancelled.Cancel()
                    return await cancelled.Task
                }
                if let Some(deadline) = transport.Deadline {
                    if deadline.IsExpired { return Failure(HttpError.TimedOut) }
                }
                return retained.Read(buffer, offset, count)
            }
        }
        let input: InputStream = if ssl is SslStream secure { secure } else { transport }
        let result = await input.Read(buffer, offset, count, token)
        if let Ok(read) = result {
            return Ok(read)
        }
        let Failure(error) = result else { Panic("Missing stream read outcome") }
        return Failure(ToHttpError(error))
    }
    internal func SendUntil(buffer: byte[], offset: int, count: int, deadline: NetworkDeadline, token: CancellationToken) -> Task<Result<int, HttpError>> {
        transport.Deadline = Some(deadline)
        return Send(buffer, offset, count, token)
    }
    internal async func Send(buffer: byte[], offset: int, count: int, token: CancellationToken) -> Task<Result<int, HttpError>> {
        let output: OutputStream = if ssl is SslStream secure { secure } else { transport }
        if let Failure(error) = await output.Write(buffer, offset, count, token) {
            return Failure(ToHttpError(error))
        }
        return Ok(count)
    }
    internal async func Shutdown(token: CancellationToken) -> Task<Result<unit, HttpError>> {
        if ssl is SslStream secure {
            if let Failure(error) = await secure.Shutdown(token) {
                return Failure(ToHttpError(error))
            }
        }
        return Ok(())
    }
    internal func Close() {
        if closed { return }
        closed = true
        if readAhead is HttpReadAhead retained { retained.Close() }
        readAhead = null
        if ssl is SslStream secure { secure.Close() }
        transport.Close()
    }
}
