module System.Web.Http

import System.Runtime.CompilerServices.*
import System.Optional.*
import System.Concurrency.Tasks.*
import System.Concurrency.*
import System.Networking.*
import System.Networking.Security.*
import System.Networking.Sockets.*
import System.*
import System.Collections.*
import System.Result.*
import System.Text.*
import System.IO.*
import System.Time.*

// Provisional bounded HTTP response contracts.
public class HttpHeader {
    private var storedName: string
    val Name: string => storedName
    private var storedValue: string
    val Value: string => storedValue

    init(name: string, value: string) {
        storedName = name
        storedValue = value
    }

    internal static func FindValues(headers: Sequence<HttpHeader>, name: string) -> Sequence<string> {
        let values = ArrayList<string>()
        if !ReadOnlyHttpHeaderCollection.ValidName(name) {
            return values
        }
        var index = 0
        while index < headers.Count {
            if ReadOnlyHttpHeaderCollection.Matches(ReadOnlyHttpHeaderCollection.NameAt(headers, index), name) {
                values.Add(ReadOnlyHttpHeaderCollection.ValueAt(headers, index))
            }
            index += 1
        }
        return values
    }
}

internal class HttpResponseDecoder {
    internal init(isHead: bool) {
        self.isHead = isHead
    }
    private var isHead: bool
    private var chunks: HttpChunkDecoder? = null
    private var informational = 0
    private var headerBytes = 0
    private var chunked: bool = false
    private var ended: bool = false
    private var head: ArrayList<byte> = ArrayList<byte>()
    private var body: ArrayList<byte> = ArrayList<byte>()
    private var headers: HttpHeaderFields = HttpHeaderFields()
    private var expected: int = -1
    private var statusCode: int = 0
    private var reasonEnd: int = 13
    private var failed: bool = false

    internal val HeadersComplete: bool => expected != -1 && !failed
    internal val BodyLength: int => expected
    internal val EmptyOnly: bool => statusCode == 205
    internal func FinishHeaders() -> HttpClientResponse {
        let response = HttpClientResponse(statusCode, headers, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
        response.SetReason(head, reasonEnd)
        return response
    }

    internal val Complete: bool => (ended || (expected >= 0 && body.Count == expected)) && !failed

    internal func Push(value: byte) -> Result<bool, HttpError> {
        if failed {
            return Failure(HttpError.Protocol("Decoder already failed"))
        }
        let result = PushCore(value)
        if let Failure(message) = result {
            failed = true
            return Failure(message)
        }
        return result
    }

    private func PushCore(value: byte) -> Result<bool, HttpError> {
        if Complete {
            return Failure(HttpError.Protocol("Bytes after response"))
        }
        if expected == -2 {
            if body.Count >= HttpWireLimits.BodyBytes {
                return Failure(HttpError.LimitExceeded("Body limit exceeded"))
            }
            if statusCode == 205 {
                return Failure(HttpError.Protocol("Status 205 cannot contain content"))
            }
            body.Add(value)
            return Ok(false)
        }
        if expected == -3 {
            if chunks is HttpChunkDecoder decoder {
                ended = decoder.Push(value)?
                return Ok(Complete)
            }
            return Failure(HttpError.Protocol("Missing chunk decoder"))
        }
        if expected >= 0 {
            body.Add(value)
            return Ok(Complete)
        }
        if headerBytes >= HttpWireLimits.HeaderBytes {
            return Failure(HttpError.LimitExceeded("Header limit exceeded"))
        }
        let count = head.Count
        if value == 10 && (count == 0 || head[count - 1] != 13) {
            return Failure(HttpError.Protocol("Bare LF in headers"))
        }
        if count > 0 && head[count - 1] == 13 && value != 10 {
            return Failure(HttpError.Protocol("Bare CR in headers"))
        }
        if value != 9 && value != 10 && value != 13 && !(value >= 32 && value <= 126) {
            return Failure(HttpError.Protocol("Invalid header byte"))
        }
        headerBytes += 1
        head.Add(value)
        let size = head.Count
        if size >= 4 && head[size - 4] == 13 && head[size - 3] == 10 && head[size - 2] == 13 && head[size - 1] == 10 {
            let length = ParseHead()?
            if statusCode < 200 {
                informational += 1
                if informational > HttpWireLimits.InformationalResponses {
                    return Failure(HttpError.LimitExceeded("Informational response limit exceeded"))
                }
                head = ArrayList<byte>()
                headers = HttpHeaderFields()
                statusCode = 0
            } else {
                expected = length
                if expected == -3 {
                    chunks = HttpChunkDecoder(body, statusCode == 205, HttpWireLimits.BodyBytes)
                }
            }
        }
        return Ok(Complete)
    }

    internal func EndOfInput() -> Result<HttpClientResponse, HttpError> {
        if expected == -2 && !failed {
            ended = true
        }
        if !Complete {
            return Failure(HttpError.Protocol("EOF before complete response"))
        }
        return Finish()
    }

    private func Token(value: byte) -> bool {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 33 || value == 35 ||
            value == 36 || value == 37 || value == 38 || value == 39 ||
            value == 42 || value == 43 || value == 45 || value == 46 ||
            value == 94 || value == 95 || value == 96 || value == 124 || value == 126
    }

    private func Text(start: int, end: int, lower: int) -> Result<string, HttpError> {
        let bytes = ArrayList<byte>()
        var index = start
        while index < end {
            var value = head[index]
            if lower == 1 && value >= 65 && value <= 90 {
                value = (byte)((int)value + 32)
            }
            bytes.Add(value)
            index += 1
        }
        if let Ok(text) = HttpText.Decode(bytes) {
            return Ok(text)
        }
        return Failure(HttpError.Protocol("Invalid header text"))
    }

    private func ParseHead() -> Result<int, HttpError> {
        var start = 0
        var line = 0
        var length = -1
        var end = 0
        while end + 1 < head.Count {
            if head[end] != 13 || head[end + 1] != 10 {
                end += 1
                continue
            }
            if line == 0 {
                if end < 13 || Text(0, 9, 0)? != "HTTP/1.1 " || head[12] != 32 {
                    return Failure(HttpError.Protocol("Invalid status line"))
                }
                var code = 0
                var digitIndex = 9
                while digitIndex < 12 {
                    let digit = (int)head[digitIndex] - 48
                    if !(digit >= 0 && digit <= 9) {
                        return Failure(HttpError.Protocol("Invalid status code"))
                    }
                    code = code * 10 + digit
                    digitIndex += 1
                }
                if !(code >= 100 && code <= 599) {
                    return Failure(HttpError.Protocol("Invalid status code"))
                }
                if code == 101 {
                    return Failure(HttpError.Unsupported("Protocol upgrades are not implemented"))
                }
                statusCode = code
                reasonEnd = end
            } else if end == start {
                if chunked && length >= 0 {
                    return Failure(HttpError.Protocol("Ambiguous response framing"))
                }
                if statusCode < 200 {
                    if chunked || length >= 0 {
                        return Failure(HttpError.Protocol("Informational responses cannot contain framing headers"))
                    }
                    return Ok(0)
                }
                if statusCode == 204 {
                    if chunked {
                        return Failure(HttpError.Protocol("Transfer-Encoding is prohibited for status 204"))
                    }
                    if length >= 0 {
                        return Failure(HttpError.Protocol("Content-Length is prohibited for status 204"))
                    }
                    return Ok(0)
                }
                if statusCode == 304 || isHead {
                    // Content-Length describes the selected representation, not a message body.
                    return Ok(0)
                }
                if chunked {
                    return Ok(-3)
                }
                if length < 0 {
                    return Ok(-2)
                }
                if statusCode == 205 && length != 0 {
                    return Failure(HttpError.Protocol("Status 205 cannot contain content"))
                }
                return Ok(length)
            } else {
                if headers.Count >= HttpWireLimits.HeaderCount {
                    return Failure(HttpError.LimitExceeded("Header count exceeded"))
                }
                var colon = start
                while colon < end && head[colon] != 58 {
                    if !Token(head[colon]) {
                        return Failure(HttpError.Protocol("Invalid header name"))
                    }
                    colon += 1
                }
                if colon == start || colon == end {
                    return Failure(HttpError.Protocol("Missing header name or colon"))
                }
                let name = Text(start, colon, 1)?
                var first = colon + 1
                var last = end
                while first < last && (head[first] == 32 || head[first] == 9) {
                    first += 1
                }
                while last > first && (head[last - 1] == 32 || head[last - 1] == 9) {
                    last -= 1
                }
                let value = Text(first, last, 0)?
                if name == "content-encoding" {
                    return Failure(HttpError.Unsupported("Unsupported encoding"))
                }
                if name == "transfer-encoding" {
                    if chunked {
                        return Failure(HttpError.Protocol("Duplicate Transfer-Encoding"))
                    }
                    if Text(first, last, 1)? != "chunked" {
                        return Failure(HttpError.Unsupported("Unsupported transfer encoding"))
                    }
                    chunked = true
                }
                if name == "content-length" {
                    if length >= 0 {
                        return Failure(HttpError.Protocol("Duplicate Content-Length"))
                    }
                    if first == last {
                        return Failure(HttpError.Protocol("Empty Content-Length"))
                    }
                    var number = 0
                    var index = first
                    while index < last {
                        let digit = (int)head[index] - 48
                        if !(digit >= 0 && digit <= 9) {
                            return Failure(HttpError.Protocol("Invalid Content-Length"))
                        }
                        // Bound before multiplication, avoiding integer overflow.
                        let limit = if statusCode == 304 || isHead { 2147483647 } else { HttpWireLimits.BodyBytes }
                        if number > (limit - digit) / 10 {
                            if statusCode == 304 || isHead {
                                return Failure(HttpError.LimitExceeded("Content-Length metadata limit exceeded"))
                            }
                            return Failure(HttpError.LimitExceeded("Body limit exceeded"))
                        }
                        number = number * 10 + digit
                        index += 1
                    }
                    length = number
                }
                headers.Add(name, value)
            }
            line += 1
            start = end + 2
            end = start
        }
        return Failure(HttpError.Protocol("Incomplete headers"))
    }

    internal func Finish() -> Result<HttpClientResponse, HttpError> {
        if !Complete {
            return Failure(HttpError.Protocol("Incomplete or invalid response"))
        }
        let response = HttpClientResponse(statusCode, headers, HttpMemoryContent(HttpText.Snapshot(body)))
        response.SetReason(head, reasonEnd)
        return Ok(response)
    }
}


// Request and handler contracts are independent of socket transport.
/// Base contract for a reusable request pipeline or terminal transport.
public abstract class HttpHandler : Disposable {
    protected init() { }

    abstract func Send(request: HttpClientRequest, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>>

    /// Releases resources owned by the handler. Stateless handlers need no override.
    virtual func Dispose() { }
}

/// Base for middleware which forwards to an owned inner handler.
public abstract class DelegatingHandler : HttpHandler {
    private var inner: HttpHandler? = null
    private var started = false
    private var disposed = false

    protected init() { }

    protected init(innerHandler: HttpHandler) {
        inner = innerHandler
    }

    /// The owned next handler. Assign before the first send or disposal.
    var InnerHandler: HttpHandler? {
        get => inner
        set {
            if disposed || started {
                Panic("Handler pipeline is already started or disposed")
            }
            if value is not HttpHandler {
                Panic("Inner handler cannot be null")
            }
            inner = value
        }
    }

    /// Forwards to the inner handler, freezing pipeline configuration.
    override func Send(request: HttpClientRequest, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        if disposed {
            Panic("HTTP handler is disposed")
        }
        let target = inner
        if target is HttpHandler handler {
            started = true
            return handler.Send(request, cancellationToken)
        }
        Panic("Inner handler has not been assigned")
    }

    /// Disposes the owned inner handler once. Overrides must call base.Dispose().
    override func Dispose() {
        if disposed {
            return
        }
        disposed = true
        let target = inner
        if target is HttpHandler handler {
            handler.Dispose()
        }
    }
}

public abstract class HttpContent : Disposable {
    private var input: Optional<InputStream> = None()
    private var inputLength: int = 0
    private var leaveOpen: bool = true
    private var started: bool = false
    private var disposed: bool = false
    internal val IsDisposed: bool => disposed

    /// True when content already has a complete byte sequence.
    val IsBuffered: bool => input is None
    /// Declared byte count, or -1 for incoming chunked/close-delimited content.
    val Length: int {
        get {
            if self is HttpMemoryContent memoryContent {
                return memoryContent.Memory.Length
            }
            if IsBuffered {
                return storedBytes.Count
            }
            return inputLength
        }
    }

    internal static func Incoming(stream: InputStream, length: int) -> HttpContent {
        return HttpStreamContent.IncomingBody(stream, length)
    }

    protected init() { }

    protected init(contentType: MediaType) {
        SetMediaType(contentType)
    }

    protected init(bytes: Sequence<byte>, contentType: MediaType) {
        buffered = bytes
        SetMediaType(contentType)
    }

    protected init(contentType: string) {
        mediaType = Some(contentType)
    }

    protected init(stream: InputStream, length: int, leaveOpen: bool) {
        input = Some(stream)
        inputLength = length
        self.leaveOpen = leaveOpen
    }

    /// Returns the one-shot input stream, or None for buffered content. Does not read.
    /// The content owns the stream unless HttpStreamContent.Create was passed leaveOpen=true.
    func TryGetStream() -> Optional<InputStream> {
        if let Some(stream) = input { return Some(stream) }
        return None()
    }

    /// Returns buffered bytes without reading or consuming an input stream.
    internal func TryGetBytes() -> Optional<Sequence<byte>> {
        if IsBuffered && self is not HttpMemoryContent {
            return Some(storedBytes)
        }
        return None()
    }

    /// <summary>Copies buffered or streaming content with bounded staging and backpressure.</summary>
    /// <param name="destination">Borrowed output; keep it open until completion.</param>
    /// <param name="cancellationToken">Cancellation propagates as a cancelled task, including before empty copies.</param>
    /// <returns>Success after the body is written, or HttpError.Content preserving the stream error. A reused streaming body returns InvalidRequest.</returns>
    /// <remarks>Never flushes or closes either stream. Stream content is consumed once, including after failure or cancellation once started. Known lengths stop exactly at that length and reject early EOF; unknown incoming lengths end at EOF. Do not concurrently read, copy, upload or mutate the body. Array bodies are written directly; other sources use at most 1024 staging bytes. This operation does not add HTTP framing.</remarks>
    async func CopyTo(destination: OutputStream, cancellationToken: CancellationToken = default) -> Task<Result<unit, HttpError>> {
        if cancellationToken.IsCancellationRequested {
            return await CancelledCopy()
        }
        if disposed {
            return Failure(HttpError.Content(StreamError.Closed))
        }
        _ = BeginUpload()?
        if IsBuffered {
            if buffered is byte[] bytes {
                if bytes.Length == 0 {
                    return Ok(())
                }
                return CopyResult(await destination.Write(bytes, 0, bytes.Length, cancellationToken))
            }
            let count = Length
            if count == 0 {
                return Ok(())
            }
            let sequenceBuffer = CheckedStorage.Reserve<byte>(if count < 1024 { count } else { 1024 })
            var offset = 0
            while offset < count {
                if cancellationToken.IsCancellationRequested {
                    return await CancelledCopy()
                }
                if disposed {
                    return Failure(HttpError.Content(StreamError.Closed))
                }
                let sequenceRemaining = count - offset
                let sequenceTake = if sequenceRemaining < sequenceBuffer.Length { sequenceRemaining } else { sequenceBuffer.Length }
                if self is HttpMemoryContent content {
                    CopyMemoryWindow(content.Memory, offset, sequenceBuffer, sequenceTake)
                } else {
                    var index = 0
                    while index < sequenceTake {
                        sequenceBuffer[index] = storedBytes[offset + index]
                        index += 1
                    }
                }
                _ = CopyResult(await destination.Write(sequenceBuffer, 0, sequenceTake, cancellationToken))?
                offset += sequenceTake
            }
            return Ok(())
        }
        let Some(stream) = input else {
            return Failure(HttpError.Content(StreamError.IoFailure))
        }
        var remaining = inputLength
        if remaining == 0 {
            return Ok(())
        }
        let buffer = CheckedStorage.Reserve<byte>(if remaining > 0 && remaining < 1024 { remaining } else { 1024 })
        while remaining != 0 {
            if cancellationToken.IsCancellationRequested {
                return await CancelledCopy()
            }
            if disposed {
                return Failure(HttpError.Content(StreamError.Closed))
            }
            let take = if remaining > 0 && remaining < buffer.Length { remaining } else { buffer.Length }
            let result = await stream.Read(buffer, 0, take, cancellationToken)
            let Ok(read) = result else {
                if result is Failure(let reason) {
                    return Failure(HttpError.Content(reason))
                }
                return Failure(HttpError.Content(StreamError.IoFailure))
            }
            if read < 0 || read > take || (read == 0 && remaining > 0) {
                return Failure(HttpError.Content(StreamError.IoFailure))
            }
            if cancellationToken.IsCancellationRequested {
                return await CancelledCopy()
            }
            if disposed {
                return Failure(HttpError.Content(StreamError.Closed))
            }
            if read == 0 {
                return Ok(())
            }
            _ = CopyResult(await destination.Write(buffer, 0, read, cancellationToken))?
            if remaining > 0 {
                remaining -= read
            }
        }
        return Ok(())
    }

    private static func CopyMemoryWindow(memory: ReadOnlyMemory<byte>, offset: int, destination: byte[], count: int) {
        let source: ReadOnlySlice<byte> = memory
        var index = 0
        while index < count {
            destination[index] = source[offset + index]
            index += 1
        }
    }

    private static func CopyResult(result: Result<unit, StreamError>) -> Result<unit, HttpError> {
        return match result {
            Ok(_) => Ok(())
            Failure(let reason) => Failure(HttpError.Content(reason))
        }
    }

    private static func CancelledCopy() -> Task<Result<unit, HttpError>> {
        // Cancellation bridge only; ordinary transfers use await directly.
        let source = Promise<Result<unit, HttpError>>()
        _ = source.Cancel()
        return source.Task
    }

    /// Releases owned stream content; borrowed sources remain open. Idempotent.
    func Dispose() {
        if !disposed {
            disposed = true
            if !leaveOpen {
                if let Some(stream) = input {
                    stream.Close()
                }
            }
        }
    }

    internal func BeginUpload() -> Result<unit, HttpError> {
        if !IsBuffered {
            if started || disposed {
                return Failure(HttpError.InvalidRequest("Stream content has already been consumed or disposed"))
            }
            started = true
        }
        return Ok(())
    }

    internal async func ReadUpload(buffer: byte[], count: int, cancellationToken: CancellationToken) -> Task<Result<int, HttpError>> {
        if let Some(stream) = input {
            if disposed {
                return Failure(HttpError.Content(StreamError.Closed))
            }
            let result = await stream.Read(buffer, 0, count, cancellationToken)
            if let Failure(reason) = result {
                return Failure(HttpError.Content(reason))
            }
            if let Ok(read) = result {
                if read <= 0 || read > count {
                    return Failure(HttpError.Content(StreamError.IoFailure))
                }
                return Ok(read)
            }
        }
        return Failure(HttpError.InvalidRequest("Content has no stream source"))
    }

    private var hasParsedMediaType = false
    private var parsedMediaType: Result<Optional<MediaType>, HttpError> = Ok(None())

    /// <summary>Parses this producer's declared Content-Type without consuming its body.</summary>
    /// <returns>Some for valid metadata, None when absent, or a parsing error for legacy string metadata.</returns>
    /// <remarks>Incoming message headers belong to HttpClientRequest/HttpClientResponse; use their GetContentType methods for received content.</remarks>
    func GetContentType() -> Result<Optional<MediaType>, HttpError> {
        if !hasParsedMediaType {
            parsedMediaType = ParseContentType()
            hasParsedMediaType = true
        }
        if let Ok(value) = parsedMediaType {
            return Ok(value)
        }
        if let Failure(error) = parsedMediaType {
            return Failure(error)
        }
        Panic("Content-Type cache has no outcome")
        return Ok(None())
    }

    private func ParseContentType() -> Result<Optional<MediaType>, HttpError> {
        if let Some(text) = mediaType {
            let value = MediaType.Parse(text)?
            return Ok(Some(value))
        }
        return Ok(None())
    }

    internal func SetMediaType(value: MediaType) {
        mediaType = Some(value.ToString())
        parsedMediaType = Ok(Some(value))
        hasParsedMediaType = true
    }

    private var mediaType: Optional<string> = None()
    internal val MediaTypeText: Optional<string> {
        get {
            if let Some(value) = mediaType {
                return Some(value)
            }
            return None()
        }
    }
    private var buffered: Sequence<byte>? = null
    private val storedBytes: Sequence<byte> => buffered ?? Array<byte>.Empty
    // Internal sequence bridge for wire code; not part of the public content API.
    internal val Bytes: Sequence<byte> {
        get {
            if !IsBuffered || self is HttpMemoryContent {
                Panic("Content has no sequence storage")
            }
            return storedBytes
        }
    }

    protected init(bytes: Sequence<byte>) {
        buffered = bytes
    }

    /// Wraps bytes and an outbound Content-Type; socket validation occurs before I/O.
    protected init(bytes: Sequence<byte>, contentType: string) {
        buffered = bytes
        mediaType = Some(contentType)
    }


}

public class HttpClient : Disposable {
    private var started = false
    private var timeout: Optional<Duration> = Some(Duration.FromTicks(1000000000L))

    /// The total cooperative request budget, including custom handlers and response buffering.
    /// Defaults to Some(100 seconds); None disables the client countdown.
    /// Positive durations through Int32.MaxValue milliseconds are accepted; fractions round upward.
    /// Invalid values, changes after sending starts, and changes after disposal fault.
    /// Expiry requests cancellation and waits for handler cleanup before HttpError.TimedOut.
    /// Caller/disposal cancellation takes precedence. Normal handler results are preserved.
    /// Requires scheduler progress and cooperating handlers; transport phase limits still apply.
    var Timeout: Optional<Duration> {
        get {
            if let Some(duration) = timeout {
                return Some(duration)
            }
            return None()
        }
        set {
            if let Some(duration) = value {
                if duration.Ticks <= 0L {
                    Panic("HTTP timeout is out of range")
                }
                if duration.Ticks > 21474836470000L {
                    Panic("HTTP timeout is out of range")
                }
            } else if let System.Optional.None = value {
                // Explicitly disabled, without a negative-duration sentinel.
            } else {
                Panic("Timeout requires Some or None")
            }
            EnsureUsable()
            if started {
                Panic("HTTP timeout cannot change after sending starts")
            }
            timeout = value
        }
    }

    private val lifetime = CancellationTokenSource()
    private var disposed = false
    private var ownsHandler = true
    private var defaultHeaders: Sequence<HttpHeader> = ArrayList<HttpHeader>()

    /// Client-wide application headers, copied on get/set and validated at Send.
    var DefaultRequestHeaders: Sequence<HttpHeader> {
        get {
            let snapshot = ArrayList<HttpHeader>()
            for header in defaultHeaders {
                snapshot.Add(header)
            }
            return snapshot
        }
        set {
            let snapshot = ArrayList<HttpHeader>()
            for header in value {
                snapshot.Add(header)
            }
            defaultHeaders = snapshot
        }
    }

    private var handler: HttpHandler
    private var baseUri: Optional<string> = None()

    /// Optional absolute base URL, validated when a verb helper constructs a request.
    var BaseUri: Optional<string> {
        get {
            if let Some(text) = baseUri {
                return Some(text)
            }
            return None()
        }
        set {
            if let Some(text) = value {
                baseUri = Some(text)
            } else if let System.Optional.None = value {
                baseUri = None()
            } else {
                Panic("BaseUri requires Some or None")
            }
        }
    }

    init() {
        handler = HttpSocketHandler()
    }

    /// Creates a client which owns the supplied handler.
    init(handler: HttpHandler) {
        self.handler = handler
    }

    /// Creates a client with explicit handler ownership.
    init(handler: HttpHandler, disposeHandler: bool) {
        self.handler = handler
        ownsHandler = disposeHandler
    }

    /// Cancels pending requests and disposes the handler when this client owns it.
    /// Repeated disposal is harmless; completed responses remain caller-owned.
    func Dispose() {
        if disposed {
            return
        }
        disposed = true
        lifetime.Cancel()
        lifetime.Dispose()
        if ownsHandler {
            handler.Dispose()
        }
    }

    private func EnsureUsable() {
        if disposed {
            Panic("HTTP client is disposed")
        }
    }

    /// Sends a prepared request, forwarding the token through the handler pipeline.
    func Send(request: HttpClientRequest, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        return Send(request, HttpCompletionOption.ResponseContentRead, cancellationToken)
    }

    /// Selects buffered completion or ownership transfer at final response headers.
    /// Headers-only completion ends the client timeout; body reads require their own token.
    func Send(request: HttpClientRequest, completionOption: HttpCompletionOption, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if completionOption != HttpCompletionOption.ResponseContentRead && completionOption != HttpCompletionOption.ResponseHeadersRead {
            return FailedResponse(HttpError.InvalidRequest("Unknown HTTP completion option"))
        }
        started = true
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let prepared = request.WithDefaults(defaultHeaders)
        if let Failure(error) = prepared {
            return FailedResponse(error)
        }
        let Ok(outgoing) = prepared else {
            Panic("Request preparation returned no outcome")
        }
        outgoing.HeadersOnly = completionOption == HttpCompletionOption.ResponseHeadersRead
        let operation = HttpSendScope(outgoing, cancellationToken, lifetime.Token)
        if let Some(delay) = timeout {
            operation.StartTimeout(delay)
        }
        return operation.Attach(handler.Send(outgoing, operation.Token))
    }

    /// Sends an absolute URL without a base, or a relative URL when BaseUri is set.
    /// Uses the same address rules, with cooperative cancellation.
    func Get(url: string, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Get(uri, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        Panic("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Uses the same base-resolution rules as the string overload.
    /// Uses the same address rules, with cooperative cancellation.
    func Get(uri: Uri, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreateRequest(uri)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        Panic("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    /// Posts buffered content using the same BaseUri and handler rules as Get.
    /// Posts content with cooperative exchange cancellation.
    func Post(url: string, content: HttpContent, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Post(uri, content, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        Panic("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Posts content to a URI using the same base-resolution rules as Get.
    /// Posts content through Send, forwarding the cancellation token unchanged.
    func Post(uri: Uri, content: HttpContent, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreatePost(uri, content)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        Panic("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreatePost(uri: Uri, content: HttpContent) -> Result<HttpClientRequest, HttpError> {
        return HttpClientRequest.Post(ResolveAddress(uri)?, content)
    }

    /// Sends PUT buffered content using the same BaseUri and handler rules as Get.
    /// Sends PUT content with cooperative exchange cancellation.
    func Put(url: string, content: HttpContent, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Put(uri, content, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        Panic("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Sends PUT content to a URI using the same base-resolution rules as Get.
    /// Sends PUT content through Send, forwarding the cancellation token unchanged.
    func Put(uri: Uri, content: HttpContent, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreatePut(uri, content)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        Panic("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreatePut(uri: Uri, content: HttpContent) -> Result<HttpClientRequest, HttpError> {
        return HttpClientRequest.Put(ResolveAddress(uri)?, content)
    }

    /// Sends PATCH buffered content using the same BaseUri and handler rules as Get.
    /// Sends PATCH content with cooperative exchange cancellation.
    func Patch(url: string, content: HttpContent, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Patch(uri, content, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        Panic("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Sends PATCH content to a URI using the same base-resolution rules as Get.
    /// Sends PATCH content through Send, forwarding the cancellation token unchanged.
    func Patch(uri: Uri, content: HttpContent, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreatePatch(uri, content)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        Panic("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreatePatch(uri: Uri, content: HttpContent) -> Result<HttpClientRequest, HttpError> {
        return HttpClientRequest.Patch(ResolveAddress(uri)?, content)
    }

    /// Sends DELETE without content to an absolute URL without a base, or a relative URL when BaseUri is set.
    /// Uses the same address rules, with cooperative cancellation.
    func Delete(url: string, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Delete(uri, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        Panic("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Uses the same base-resolution rules as the string overload.
    /// Uses the same address rules, with cooperative cancellation.
    func Delete(uri: Uri, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreateDelete(uri)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        Panic("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreateDelete(uri: Uri) -> Result<HttpClientRequest, HttpError> {
        return HttpClientRequest.Delete(ResolveAddress(uri)?)
    }

    /// Sends HEAD without content to an absolute URL without a base, or a relative URL when BaseUri is set.
    /// Uses the same address rules, with cooperative cancellation.
    func Head(url: string, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Head(uri, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        Panic("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Uses the same base-resolution rules as the string overload.
    /// Uses the same address rules, with cooperative cancellation.
    func Head(uri: Uri, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreateHead(uri)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        Panic("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreateHead(uri: Uri) -> Result<HttpClientRequest, HttpError> {
        return HttpClientRequest.Head(ResolveAddress(uri)?)
    }

    /// Fetches a bounded response and decodes its buffered body as strict UTF-8.
    /// Fetches UTF-8 text, preserving HTTP failures and acknowledged task cancellation.
    func GetString(url: string, cancellationToken: CancellationToken = default) -> Task<Result<string, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            let source = Promise<Result<string, HttpError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Get(url, cancellationToken).Map(DecodeText)
    }

    /// Fetches a bounded response and decodes its buffered body as strict UTF-8.
    /// Fetches UTF-8 text, preserving HTTP failures and acknowledged task cancellation.
    func GetString(uri: Uri, cancellationToken: CancellationToken = default) -> Task<Result<string, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            let source = Promise<Result<string, HttpError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Get(uri, cancellationToken).Map(DecodeText)
    }

    private static func DecodeText(result: Result<HttpClientResponse, HttpError>) -> Result<string, HttpError> {
        let response = result?
        if !response.IsSuccessStatusCode {
            return Failure(HttpError.UnsuccessfulStatus(response.StatusCode))
        }
        if !response.Content.IsBuffered {
            return Failure(HttpError.Unsupported("Response content is not buffered"))
        }
        if response.Content is HttpMemoryContent memoryContent {
            return match HttpText.Decode(memoryContent.Memory) {
                Ok(let text) => Ok(text)
                Failure(_) => Failure(HttpError.Protocol("Invalid UTF-8 body"))
            }
        }
        if let Ok(text) = HttpText.Decode(response.Content.Bytes) {
            return Ok(text)
        }
        return Failure(HttpError.Protocol("Invalid UTF-8 body"))
    }

    private static func Cancelled() -> Task<Result<HttpClientResponse, HttpError>> {
        let source = Promise<Result<HttpClientResponse, HttpError>>()
        _ = source.Cancel()
        return source.Task
    }

    private func CreateRequest(uri: Uri) -> Result<HttpClientRequest, HttpError> {
        return HttpClientRequest.Get(ResolveAddress(uri)?)
    }

    private func ResolveAddress(uri: Uri) -> Result<Uri, HttpError> {
        // Snapshot the configuration before calling user-supplied handlers.
        let configured = baseUri
        if let Some(baseText) = configured {
            if uri.IsAbsolute || uri.Text.StartsWithOrdinal("//") {
                return Failure(HttpError.InvalidRequest("A relative URL without authority is required with BaseUri"))
            }
            let parsed = Uri.Parse(baseText)
            if let Failure(reason) = parsed {
                return Failure(HttpError.InvalidUri(reason))
            } else if let Ok(baseAddress) = parsed {
                // Validate HTTP policy on the base before allowing resolution.
                _ = HttpClientRequest.Get(baseAddress)?
                let resolved = baseAddress.Resolve(uri)
                if let Ok(address) = resolved {
                    return Ok(address)
                } else if let Failure(reason) = resolved {
                    return Failure(HttpError.InvalidUri(reason))
                }
            }
            Panic("URI resolution returned no outcome")
            return Failure(HttpError.InvalidRequest("Invalid URI"))
        }
        return Ok(uri)
    }

    private static func FailedResponse(reason: HttpError) -> Task<Result<HttpClientResponse, HttpError>> {
        let source = Promise<Result<HttpClientResponse, HttpError>>()
        _ = source.Complete(Failure(reason))
        return source.Task
    }

}

public class HttpSocketHandler : HttpHandler {
    private val sslOptions: SslClientAuthenticationOptions? = null
    private val lifetime = CancellationTokenSource()
    private var disposed = false

    init() { }

    /// Uses explicit TLS trust for HTTPS. The caller owns these immutable options.
    init(sslOptions: SslClientAuthenticationOptions) { self.sslOptions = sslOptions }

    /// Requests cancellation of this handler's pending exchanges, once.
    override func Dispose() {
        if disposed {
            return
        }
        disposed = true
        lifetime.Cancel()
        lifetime.Dispose()
    }

    /// Uses one token across lookup, connect and transfers, closing before cancellation completes.
    override func Send(request: HttpClientRequest, cancellationToken: CancellationToken = default) -> Task<Result<HttpClientResponse, HttpError>> {
        if disposed {
            Panic("HTTP handler is disposed")
        }
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<HttpClientResponse, HttpError>>()
            _ = source.Cancel()
            return source.Task
        }
        let operation = HttpSendScope(request, cancellationToken, lifetime.Token)
        let exchange = HttpExchange(request, operation.Token, sslOptions)
        return operation.Attach(exchange.Execute())
    }
}

// Private continuation adapter, replaceable when runtime suspension is available.
// Each Send owns independent buffers, pending tasks and one socket.
internal class HttpExchange {
    private var uploadRemaining: int = 0
    private var ownsUpload: bool = false
    private var token: CancellationToken
    private var request: HttpClientRequest
    private var source: Promise<Result<HttpClientResponse, HttpError>>
    private var socket: Optional<HttpConnection>
    private var lookup: Optional<Task<Result<Sequence<IPAddress>, DnsError>>>
    private var connecting: Optional<Task<Result<Socket, SocketError>>>
    private var transfer: Optional<Task<Result<int, HttpError>>>
    private var outgoing: Sequence<byte>
    private var sent: int
    private var buffer: byte[]
    private var decoder: HttpResponseDecoder

    private val sslOptions: SslClientAuthenticationOptions?
    private var authentication: Task<Result<unit, HttpError>>? = null
    internal init(request: HttpClientRequest, token: CancellationToken, sslOptions: SslClientAuthenticationOptions?) {
        self.sslOptions = sslOptions
        self.token = token
        self.request = request
        source = Promise<Result<HttpClientResponse, HttpError>>()
        socket = None()
        lookup = None()
        connecting = None()
        transfer = None()
        outgoing = ArrayList<byte>()
        sent = 0
        buffer = CheckedStorage.Reserve<byte>(256)
        decoder = HttpResponseDecoder(String.CompareOrdinalIgnoreCase(request.Method.Method, "HEAD") == 0)
    }

    internal func Execute() -> Task<Result<HttpClientResponse, HttpError>> {
        if request.IsSecure && sslOptions is null {
            _ = source.Complete(Failure(HttpError.InvalidRequest("HTTPS requires explicit TLS trust options")))
            return source.Task
        }
        // Validate and snapshot before starting the network exchange budget.
        let encoded = request.Encode()
        if let Ok(bytes) = encoded {
            outgoing = bytes
        } else if let Failure(reason) = encoded {
            _ = source.Complete(Failure(reason))
            return source.Task
        }
        if let Failure(reason) = request.Content.BeginUpload() {
            _ = source.Complete(Failure(reason))
            return source.Task
        }
        if !request.Content.IsBuffered {
            ownsUpload = true
            uploadRemaining = request.Content.Length
        }
        let pending = Dns.GetHostAddresses(request.Host, token)
        lookup = Some(pending)
        pending.OnCompleted(self.OnLookup)
        return source.Task
    }

    private func Cleanup() {
        if ownsUpload {
            ownsUpload = false
            request.Content.Dispose()
        }
        if let Some(connection) = socket {
            connection.Close()
        }
        socket = None()
        lookup = None()
        connecting = None()
        transfer = None()
    }

    private func Cancel() {
        Cleanup()
        _ = source.Cancel()
    }

    private func Finish(result: Result<HttpClientResponse, HttpError>) {
        Cleanup()
        _ = source.Complete(result)
    }

    private func OnLookup() {
        if let Some(pending) = lookup {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            lookup = None()
            if let Ok(addresses) = result {
                let next = Socket.Connect(addresses, request.Port, token)
                connecting = Some(next)
                next.OnCompleted(self.OnConnected)
            } else if let Failure(reason) = result {
                Finish(Failure(HttpError.NameResolution(reason)))
            }
        }
    }

    private func OnConnected() {
        if let Some(pending) = connecting {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            connecting = None()
            if let Ok(connection) = result {
                let transport = HttpConnection(connection)
                socket = Some(transport)
                if request.IsSecure && sslOptions is SslClientAuthenticationOptions options {
                    let pending = transport.AuthenticateClient(options, request.Host, token)
                    authentication = pending
                    pending.OnCompleted(self.OnAuthenticated)
                } else { SendNext() }
            } else if let Failure(reason) = result {
                Finish(Failure(HttpError.Transport(reason)))
            }
        }
    }

    // Outcome adapter preserves outer HTTP cancellation and cleanup ownership.
    private func OnAuthenticated() {
        if authentication is Task<Result<unit, HttpError>> pending {
            authentication = null
            if pending.IsCancelled { Cancel(); return }
            if let Failure(error) = pending.GetResult() { Finish(Failure(error)); return }
            SendNext()
        }
    }

    private var uploadRead: Optional<Task<Result<int, HttpError>>> = None()

    // Outcome observation is part of the existing socket callback adapter: cancellation
    // must settle the outer operation without accessing a cancelled task's result.
    private func OnUploadRead() {
        if let Some(pending) = uploadRead {
            uploadRead = None()
            if pending.IsCancelled || token.IsCancellationRequested {
                Cancel()
                return
            }
            let reading = pending.GetResult()
            if let Failure(reason) = reading {
                Finish(Failure(reason))
                return
            }
            if let Ok(read) = reading {
                let chunk = ArrayList<byte>()
                var index = 0
                while index < read {
                    chunk.Add(buffer[index])
                    index += 1
                }
                outgoing = chunk
                sent = 0
                uploadRemaining -= read
                SendNext()
            }
        }
    }

    private func SendNext() {
        if token.IsCancellationRequested {
            Cancel()
            return
        }
        if let Some(connection) = socket {
            if sent == outgoing.Count {
                if uploadRemaining == 0 {
                    ReceiveNext()
                    return
                }
                let requested = if uploadRemaining < 256 { uploadRemaining } else { 256 }
                let reading = request.Content.ReadUpload(buffer, requested, token)
                uploadRead = Some(reading)
                reading.OnCompleted(self.OnUploadRead)
                return
            }
            var count = 0
            while count < 256 && sent + count < outgoing.Count {
                buffer[count] = outgoing[sent + count]
                count += 1
            }
            let pending = connection.Send(buffer, 0, count, token)
            transfer = Some(pending)
            pending.OnCompleted(self.OnSent)
        }
    }

    private func OnSent() {
        if let Some(pending) = transfer {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            transfer = None()
            if let Ok(count) = result {
                if count > 0 {
                    sent += count
                    SendNext()
                } else {
                    Finish(Failure(HttpError.Protocol("Send made no progress")))
                }
            } else if let Failure(reason) = result {
                Finish(Failure(reason))
            }
        }
    }

    private func ReceiveNext() {
        if let Some(connection) = socket {
            let pending = connection.Receive(buffer, 0, 256, token)
            transfer = Some(pending)
            pending.OnCompleted(self.OnReceived)
        }
    }

    private func OnReceived() {
        if let Some(pending) = transfer {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            transfer = None()
            if let Ok(count) = result {
                if count == 0 {
                    Finish(decoder.EndOfInput())
                    return
                }
                var index = 0
                while index < count && !decoder.Complete && !(request.HeadersOnly && decoder.HeadersComplete) {
                    let progress = decoder.Push(buffer[index])
                    if let Failure(message) = progress {
                        Finish(Failure(message))
                        return
                    }
                    index += 1
                }
                if request.HeadersOnly && decoder.HeadersComplete {
                    if let Some(connection) = socket {
                        let length = decoder.BodyLength
                        let stream = HttpBodyInput(connection, buffer, index, count, length,
                            HttpWireLimits.BodyBytes, None(), true, decoder.EmptyOnly)
                        let response = decoder.FinishHeaders()
                        response.SetContent(HttpContent.Incoming(stream, if length < 0 { -1 } else { length }))
                        socket = None()
                        Finish(Ok(response))
                    }
                } else if decoder.Complete {
                    Finish(decoder.Finish())
                } else {
                    ReceiveNext()
                }
            } else if let Failure(reason) = result {
                Finish(Failure(reason))
            }
        }
    }
}


// Cancellation-outcome adapter: await cannot currently observe a cancelled task.
// Cancellation requests are cooperative; completion waits for provider cleanup.
internal class HttpSendScope {
    private val caller: CancellationToken
    private val owner: CancellationToken
    private var timeoutSource: CancellationTokenSource? = null
    private var timeoutRegistration: CancellationRegistration? = null
    private var timedOut = false
    private val request: HttpClientRequest
    private val cancellation = CancellationTokenSource()
    private val source = Promise<Result<HttpClientResponse, HttpError>>()
    private var callerRegistration: CancellationRegistration? = null
    private var ownerRegistration: CancellationRegistration? = null
    private var pending: Optional<Task<Result<HttpClientResponse, HttpError>>> = None()
    private var closed = false

    internal init(request: HttpClientRequest, caller: CancellationToken, owner: CancellationToken) {
        self.caller = caller
        self.owner = owner
        self.request = request
        callerRegistration = caller.Register(self.Cancel)
        ownerRegistration = owner.Register(self.Cancel)
    }

    internal val Token: CancellationToken => cancellation.Token

    internal func StartTimeout(delay: Duration) {
        let timer = CancellationTokenSource()
        timeoutSource = timer
        timeoutRegistration = timer.Token.Register(self.TimeoutElapsed)
        timer.CancelAfter(delay)
    }

    private func TimeoutElapsed() {
        if closed {
            return
        }
        if let Some(task) = pending {
            if task.IsCompleted {
                return
            }
        }
        timedOut = true
        cancellation.Cancel()
    }

    private func Cancel() {
        if !closed {
            cancellation.Cancel()
        }
    }

    internal func Attach(task: Task<Result<HttpClientResponse, HttpError>>) -> Task<Result<HttpClientResponse, HttpError>> {
        pending = Some(task)
        if task.IsCompleted {
            Complete()
        } else {
            task.OnCompleted(self.Complete)
        }
        return source.Task
    }

    private func Complete() {
        if closed {
            return
        }
        let Some(task) = pending else {
            Panic("HTTP operation has no pending task")
        }
        closed = true
        pending = None()
        if callerRegistration is CancellationRegistration caller {
            caller.Dispose()
        }
        if ownerRegistration is CancellationRegistration owner {
            owner.Dispose()
        }
        callerRegistration = null
        ownerRegistration = null
        if timeoutRegistration is CancellationRegistration registration {
            registration.Dispose()
        }
        if timeoutSource is CancellationTokenSource timer {
            timer.Dispose()
        }
        timeoutRegistration = null
        timeoutSource = null
        cancellation.Dispose()
        if task.IsCancelled {
            // Like HttpClient's .NET cancellation classification, an explicit caller
            // or client-lifetime request takes precedence over timeout at acknowledgement.
            // Copy readonly struct fields before invoking their getters: the current
            // native compiler does not emit defensive copies for field receivers.
            let callerToken = self.caller
            let ownerToken = self.owner
            if timedOut && !callerToken.IsCancellationRequested && !ownerToken.IsCancellationRequested {
                _ = source.Complete(Failure(HttpError.TimedOut))
            } else {
                _ = source.Cancel()
            }
        } else {
            let result = task.GetResult()
            if let Ok(response) = result {
                response.Associate(request)
            }
            _ = source.Complete(result)
        }
    }
}
