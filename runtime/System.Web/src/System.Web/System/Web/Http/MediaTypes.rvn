module System.Web.Http.MediaTypes

import System.*
import System.Web.Http.*

/// <remarks>Presets do not imply codecs, serializers or multipart support. Add required parameters separately.</remarks>
/// <summary>Common application media types.</summary>
public static class Application {
    private static var cachedJson: MediaType?
    /// <summary>application/json, without parameters.</summary>
    static val Json: MediaType {
        get {
            if cachedJson is MediaType cached {
                return cached
            }
            let value = MediaType.Known(String.Intern("application/json"))
            cachedJson = value
            return value
        }
    }
    private static var cachedProblemJson: MediaType?
    /// <summary>application/problem+json, without parameters.</summary>
    static val ProblemJson: MediaType {
        get {
            if cachedProblemJson is MediaType cached {
                return cached
            }
            let value = MediaType.Known(String.Intern("application/problem+json"))
            cachedProblemJson = value
            return value
        }
    }
    private static var cachedOctetStream: MediaType?
    /// <summary>application/octet-stream, without parameters.</summary>
    static val OctetStream: MediaType {
        get {
            if cachedOctetStream is MediaType cached {
                return cached
            }
            let value = MediaType.Known(String.Intern("application/octet-stream"))
            cachedOctetStream = value
            return value
        }
    }
    private static var cachedXml: MediaType?
    /// <summary>application/xml, without parameters.</summary>
    static val Xml: MediaType {
        get {
            if cachedXml is MediaType cached {
                return cached
            }
            let value = MediaType.Known(String.Intern("application/xml"))
            cachedXml = value
            return value
        }
    }
    private static var cachedFormUrlEncoded: MediaType?
    /// <summary>application/x-www-form-urlencoded, without parameters.</summary>
    static val FormUrlEncoded: MediaType {
        get {
            if cachedFormUrlEncoded is MediaType cached {
                return cached
            }
            let value = MediaType.Known(String.Intern("application/x-www-form-urlencoded"))
            cachedFormUrlEncoded = value
            return value
        }
    }
    private static var cachedPdf: MediaType?
    /// <summary>application/pdf, without parameters.</summary>
    static val Pdf: MediaType {
        get {
            if cachedPdf is MediaType cached {
                return cached
            }
            let value = MediaType.Known(String.Intern("application/pdf"))
            cachedPdf = value
            return value
        }
    }
}
