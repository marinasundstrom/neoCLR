module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Optional.*
import NeoClr.Testing.*

import System.Collections.*
import System.Web.Http.*

[Test]
func `HTTP header lookup preserves repeated values without splitting commas`() -> Result<unit, TestFailure> {
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("Set-Cookie", "a=1; Expires=Wed, 21 Oct 2030 07:28:00 GMT"))
    headers.Add(HttpHeader("set-cookie", "b=2"))
    headers.Add(HttpHeader("X-List", "one, two"))
    headers.Add(HttpHeader("x-list", "three"))
    let response = HttpResponse(HttpStatusCode.OK, headers, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    let cookies = response.GetHeaderValues("sEt-CoOkIe")
    _ = Assert.Equal(2, cookies.Count)?
    _ = Assert.Equal(headers[0].Value, cookies[0])?
    _ = Assert.Equal("b=2", cookies[1])?
    let values = response.GetHeaderValues("X-LIST")
    _ = Assert.Equal(2, values.Count)?
    _ = Assert.Equal("one, two", values[0])?
    return Assert.Equal("three", values[1])
}

[Test]
func `HTTP header lookup distinguishes empty values from absent fields`() -> Result<unit, TestFailure> {
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("X-Empty", ""))
    let response = HttpResponse(HttpStatusCode.OK, headers, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    let values = response.GetHeaderValues("x-empty")
    _ = Assert.Equal(1, values.Count)?
    _ = Assert.Equal("", values[0])?
    return Assert.Equal(0, response.GetHeaderValues("missing").Count)
}

[Test]
func `HTTP header lookup rejects invalid names`() -> Result<unit, TestFailure> {
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("X-List", "one"))
    headers.Add(HttpHeader("X-İ", "invalid name"))
    let response = HttpResponse(HttpStatusCode.OK, headers, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    for name in ["", " X-List", "X-List:", "X-İ", "X-List\r\n"] {
        _ = Assert.Equal(0, response.GetHeaderValues(name).Count)?
    }
    return Assert.True(true, "Invalid lookup names never match")
}

[Test]
func `HTTP header lookup snapshots remain independent of later additions`() -> Result<unit, TestFailure> {
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("Set-Cookie", "a=1"))
    headers.Add(HttpHeader("set-cookie", "b=2"))
    let response = HttpResponse(HttpStatusCode.OK, headers, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    let snapshot = response.GetHeaderValues("set-cookie")
    headers.Add(HttpHeader("SET-COOKIE", "c=3"))
    _ = Assert.Equal(2, snapshot.Count)?
    return Assert.Equal(3, response.GetHeaderValues("set-cookie").Count)
}

[Test]
func `HTTP request lookup exposes content headers without inventing provider headers`() -> Result<unit, TestFailure> {
    let Ok(post) = HttpRequest.Post("http://example.test/echo", HttpStringContent("Hello")) else {
        return Assert.True(false, "Construct POST request")
    }
    let types = post.GetHeaderValues("content-type")
    _ = Assert.Equal(1, types.Count)?
    _ = Assert.Equal("text/plain; charset=utf-8", types[0])?
    let Ok(get) = HttpRequest.Get("http://example.test/") else {
        return Assert.True(false, "Construct GET request")
    }
    return Assert.Equal(0, get.GetHeaderValues("Host").Count)
}

[Test]
func `HTTP response constructors retain memory content and replace only content type metadata`() -> Result<unit, TestFailure> {
    let data: byte[] = [(byte)255, (byte)65, (byte)66, (byte)255]
    let memory: ReadOnlyMemory<byte> = data
    let content = HttpMemoryContent(memory[1..3], "application/octet-stream")
    let headers = ArrayList<HttpHeader>()
    headers.Add(HttpHeader("content-TYPE", "old"))
    headers.Add(HttpHeader("X-Preserved", "yes"))
    headers.Add(HttpHeader("Content-Type", "duplicate"))
    let response = HttpResponse(HttpStatusCode.OK, headers, content)
    _ = Assert.True(Object.ReferenceEquals(content, response.Content), "Content identity retained")?
    _ = Assert.Equal(3, headers.Count)?
    _ = Assert.Equal("old", headers[0].Value)?
    _ = Assert.Equal(2, response.Headers.Count)?
    _ = Assert.Equal("yes", response.GetHeaderValues("X-Preserved")[0])?
    _ = Assert.Equal(1, response.GetHeaderValues("Content-Type").Count)?
    _ = Assert.Equal("application/octet-stream", response.GetHeaderValues("Content-Type")[0])?
    data[1] = (byte)90
    let retained = (HttpMemoryContent)response.Content
    let selected: ReadOnlySlice<byte> = retained.Memory
    _ = Assert.Equal(2, selected.Length)?
    _ = Assert.Equal((byte)90, selected[0])?
    let numeric = HttpResponse(201, headers, content)
    return Assert.True(Object.ReferenceEquals(content, numeric.Content), "Numeric constructor retains producer")
}

class RangeEndpoints {
    var Calls = 0
    func Start() -> int {
        Calls = Calls * 10 + 1
        return 2
    }
    func End() -> int {
        Calls = Calls * 10 + 2
        return 5
    }
}

func DynamicBytes(start: int, end: int) -> byte[] => [for index in start..end => (byte)index]
func InclusiveBytes(start: int, end: int) -> byte[] => [for index in start..=end => (byte)7]

[Test]
func `HTTP byte producers allocate runtime sized arrays with ordered single endpoint evaluation`() -> Result<unit, TestFailure> {
    let endpoints = RangeEndpoints()
    let bytes: byte[] = [for index in endpoints.Start()..endpoints.End() => (byte)index]
    _ = Assert.Equal(12, endpoints.Calls)?
    _ = Assert.Equal(3, bytes.Length)?
    _ = Assert.Equal((byte)2, bytes[0])?
    _ = Assert.Equal((byte)4, bytes[2])?
    _ = Assert.Equal(0, DynamicBytes(5, 2).Length)?
    _ = Assert.Equal(0, DynamicBytes(2, 2).Length)?
    _ = Assert.Equal(0, InclusiveBytes(5, 2).Length)?
    _ = Assert.Equal(1, InclusiveBytes(2147483647, 2147483647).Length)?
    let body = HttpMemoryContent(bytes)
    let response = HttpResponse(200, ArrayList<HttpHeader>(), body)
    return Assert.Equal(3, response.Content.Length)
}

class ResponseInput : System.IO.InputStream {
    var Reads = 0
    var Closes = 0
    func Close() { Closes += 1 }
    func Read(buffer: byte[], offset: int, count: int) -> System.Concurrency.Tasks.Task<Result<int, System.IO.StreamError>> {
        return Read(buffer, offset, count, System.Concurrency.CancellationToken.None)
    }
    func Read(buffer: byte[], offset: int, count: int, token: System.Concurrency.CancellationToken) -> System.Concurrency.Tasks.Task<Result<int, System.IO.StreamError>> {
        Reads += 1
        let result: Result<int, System.IO.StreamError> = Ok(0)
        return System.Concurrency.Tasks.Task.FromResult(result)
    }
}

[Test]
func `HTTP response construction never reads or changes stream ownership`() -> Result<unit, TestFailure> {
    let input = ResponseInput()
    let Ok(content) = HttpStreamContent.Create(input, 7, false) else {
        return Assert.True(false, "Stream content constructed")
    }
    let response = HttpResponse(200, ArrayList<HttpHeader>(), content)
    _ = Assert.True(Object.ReferenceEquals(content, response.Content), "Stream identity retained")?
    _ = Assert.Equal(7, response.Content.Length)?
    _ = Assert.Equal(0, input.Reads)?
    _ = Assert.Equal(0, input.Closes)?
    response.Content.Dispose()
    content.Dispose()
    return Assert.Equal(1, input.Closes)
}

[Test]
func `HTTP messages expose HTTP 1.1 and dispose owned content without reading`() -> Result<unit, TestFailure> {
    let input = ResponseInput()
    let Ok(content) = HttpStreamContent.Create(input, 3, false) else { return Assert.True(false, "Create stream content") }
    let Ok(request) = HttpRequest.Post("http://example.test/", content) else { return Assert.True(false, "Create request") }
    _ = Assert.Equal(1, request.Version.Major)?
    _ = Assert.Equal(1, request.Version.Minor)?
    _ = Assert.True(request.Version.Equals(HttpVersion.Http11), "Version value equality")?
    _ = Assert.Equal("1.1", request.Version.ToString())?
    let Ok(alias) = request.WithHeader("X-Test", "value") else { return Assert.True(false, "Create alias") }
    let resource: Disposable = request
    resource.Dispose()
    request.Dispose()
    alias.Dispose()
    _ = Assert.Equal(0, input.Reads)?
    _ = Assert.Equal(1, input.Closes)?
    _ = Assert.True(request.WithHeader("X-Test", "other") is Failure(_), "Disposed request rejects derivation")?
    let borrowed = ResponseInput()
    let Ok(body) = HttpStreamContent.Create(borrowed, 3, true) else { return Assert.True(false, "Create borrowed stream") }
    let response = HttpResponse(200, ArrayList<HttpHeader>(), body)
    _ = Assert.True(response.Version.Equals(request.Version), "Response protocol version")?
    let responseResource: Disposable = response
    responseResource.Dispose()
    response.Dispose()
    _ = Assert.Equal(0, borrowed.Reads)?
    return Assert.Equal(0, borrowed.Closes)
}

[Test]
func `Header collections expose named snapshots and ordered fields`() -> Result<unit, TestFailure> {
    let source = ArrayList<HttpHeader>()
    source.Add(HttpHeader("Set-Cookie", "a=1; Expires=Wed, 21 Oct 2030 07:28:00 GMT"))
    source.Add(HttpHeader("set-cookie", "b=2"))
    let headers = HttpHeaderCollection(source)
    source.Add(HttpHeader("SET-COOKIE", "c=3"))
    _ = Assert.Equal(2, headers.Count)?
    let values = headers[HttpHeaderNames.SetCookie]
    _ = Assert.Equal(2, values.Count)?
    _ = Assert.Equal(source[0].Value, values[0])?
    _ = Assert.Equal("b=2", values[1])?
    _ = Assert.Equal(0, headers["missing"].Count)?
    _ = Assert.Equal(0, headers["bad name"].Count)?
    var count = 0
    for header in headers {
        _ = Assert.Equal(source[count].Value, header.Value)?
        count += 1
    }
    return Assert.Equal(2, count)
}

[Test]
func `Single header access distinguishes absence empty duplicate and invalid names`() -> Result<unit, TestFailure> {
    let headers = HttpHeaderCollection([
        HttpHeader("X-Empty", ""),
        HttpHeader("Content-Type", "text/plain; charset=utf-8"),
        HttpHeader("Set-Cookie", "a=1"),
        HttpHeader("set-cookie", "b=2")
    ])
    _ = Assert.True(headers.GetSingle("missing") is Ok(None), "Absent field")?
    let Ok(Some(empty)) = headers.GetSingle("x-EMPTY") else {
        return Assert.True(false, "Empty value is present")
    }
    _ = Assert.Equal("", empty)?
    _ = Assert.True(headers.GetSingle(HttpHeaderNames.SetCookie) is Failure(_), "Duplicates rejected")?
    for name in ["", "x empty", "x:\r\n", "X-İ"] {
        _ = Assert.True(headers.GetSingle(name) is Failure(_), "Invalid name rejected")?
    }
    let Ok(Some(mediaType)) = headers.GetContentType() else {
        return Assert.True(false, "Parse content type")
    }
    _ = Assert.Equal("text", mediaType.Type)?
    _ = Assert.Equal("plain", mediaType.SubType)?
    _ = Assert.True(HttpHeaderCollection().GetContentType() is Ok(None), "Absent type")?
    let malformed = HttpHeaderCollection([HttpHeader("Content-Type", "bad")])
    _ = Assert.True(malformed.GetContentType() is Failure(_), "Malformed type")?
    let duplicate = HttpHeaderCollection([HttpHeader("Content-Type", "text/plain"), HttpHeader("content-type", "text/plain")])
    return Assert.True(duplicate.GetContentType() is Failure(_), "Duplicate type")
}

[Test]
func `Message header views retain source behavior and follow replacement on next access`() -> Result<unit, TestFailure> {
    let source = ArrayList<HttpHeader>()
    source.Add(HttpHeader("X-Test", "one"))
    let response = HttpResponse(200, source, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    let view = response.Headers
    _ = Assert.True(Object.ReferenceEquals(view, response.Headers), "View cached")?
    source.Add(HttpHeader("x-test", "two"))
    _ = Assert.Equal(2, view["X-Test"].Count)?
    _ = Assert.True(response.SetHeader("x-test", "replacement") is Ok(_), "Replace field")?
    _ = Assert.Equal(2, view["x-test"].Count)?
    _ = Assert.Equal("replacement", response.Headers["X-Test"][0])?
    let Ok(request) = HttpRequest.Post("http://example.test/", HttpStringContent("hello")) else {
        return Assert.True(false, "Construct request")
    }
    _ = Assert.Equal("text/plain; charset=utf-8", request.Headers[HttpHeaderNames.ContentType][0])?
    let Ok(copy) = request.WithHeader("X-Test", "new") else {
        return Assert.True(false, "Derive request")
    }
    _ = Assert.Equal(0, request.Headers["x-test"].Count)?
    return Assert.Equal("new", copy.Headers["x-test"][0])
}

[Test]
func `Empty header collections are reusable read only message inputs`() -> Result<unit, TestFailure> {
    let empty = HttpHeaderCollection.Empty
    _ = Assert.True(Object.ReferenceEquals(empty, HttpHeaderCollection.Empty), "Empty view reused")?
    _ = Assert.Equal(0, empty.Count)?
    _ = Assert.True(!empty.Contains(HttpHeaderNames.ContentType), "No fields")?
    _ = Assert.True(empty.GetSingle(HttpHeaderNames.ContentType) is Ok(None), "No single value")?
    let response = HttpResponse(200, empty, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    _ = Assert.True(response.SetHeader("X-Test", "one") is Ok(_), "Message derives storage")?
    _ = Assert.Equal("one", response.Headers["X-Test"][0])?
    return Assert.Equal(0, HttpHeaderCollection.Empty.Count)
}
