module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedHeaderAllocationTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main() -> Task<int> {
    // Preserve case order; framework allocations occur outside measured regions.
    let suite = TestSuite()
    let lookup = CompletedHeaderAllocationTest(`Single header lookup and cached views allocate no managed objects`())
    suite.Add("http-header-allocations-lookup", "Single header lookup and cached views allocate no managed objects", lookup.Invoke)
    let parsed = CompletedHeaderAllocationTest(await `Parsed HTTP fields materialize entries only for positional access`())
    suite.Add("http-header-allocations-parsed", "Parsed HTTP fields materialize entries only for positional access", parsed.Invoke)
    let response = CompletedHeaderAllocationTest(`Respond without content type retains headers without managed allocations`())
    suite.Add("http-header-allocations-response", "Respond without content type retains headers without managed allocations", response.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
