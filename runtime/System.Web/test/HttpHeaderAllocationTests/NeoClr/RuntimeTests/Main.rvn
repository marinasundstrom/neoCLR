module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Interpreter-only allocation diagnostics; await the real HTTP consumer explicitly.
func Report(result: Result<unit, TestFailure>, name: string) {
    if result is Failure(let failure) { Panic(failure.ToString()) }
    Console.WriteLine("PASS " + name)
}

async func Main() -> Task<int> {
    Report(`Single header lookup and cached views allocate no managed objects`(), "Single header lookup and cached views allocate no managed objects")
    Report(await `Parsed HTTP fields materialize entries only for positional access`(), "Parsed HTTP fields materialize entries only for positional access")
    Console.WriteLine("Tests: 2, passed: 2, failed: 0, skipped: 0")
    return 0
}
