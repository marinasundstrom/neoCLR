module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// The discovery runner is synchronous. Await these lifecycle tests explicitly.
func Report(result: Result<unit, TestFailure>, name: string) {
    if result is Failure(_) { Panic(name) }
    Console.WriteLine("PASS " + name)
}

async func Main() -> Task<int> {
    Report(await `HTTP content copy awaits writes before reading more and preserves ownership`(), "HTTP content copy awaits writes before reading more and preserves ownership")
    Report(await `HTTP memory content preserves selected windows and aliases across copies`(), "HTTP memory content preserves selected windows and aliases across copies")
    Report(await `HTTP content copy preserves stream failures and rejects truncated or invalid reads`(), "HTTP content copy preserves stream failures and rejects truncated or invalid reads")
    Report(await `HTTP content copy respects declared lengths and skips empty I/O`(), "HTTP content copy respects declared lengths and skips empty I/O")
    Report(await `HTTP content copy cancellation skips pre-cancelled input and stops pending writes`(), "HTTP content copy cancellation skips pre-cancelled input and stops pending writes")
    Report(await `HTTP content copy rejects disposed bodies and stops before the next source read`(), "HTTP content copy rejects disposed bodies and stops before the next source read")
    Report(await `HTTP string reader consumes generic streams and preserves owned text and errors`(), "HTTP string reader consumes generic streams and preserves owned text and errors")
    Report(await `HTTP stream creation validates before taking ownership or reading`(), "HTTP stream creation validates before taking ownership or reading")
    Console.WriteLine("Tests: 8, passed: 8, failed: 0, skipped: 0")
    return 0
}
