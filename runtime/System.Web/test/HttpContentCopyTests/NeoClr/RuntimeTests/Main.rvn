module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedContentCopyTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main() -> Task<int> {
    // Discovery is synchronous; await each complete lifecycle in its original order.
    let suite = TestSuite()
    let ownership = CompletedContentCopyTest(await `HTTP content copy awaits writes before reading more and preserves ownership`())
    suite.Add("http-content-copy-ownership", "HTTP content copy awaits writes before reading more and preserves ownership", ownership.Invoke)
    let memory = CompletedContentCopyTest(await `HTTP memory content preserves selected windows and aliases across copies`())
    suite.Add("http-content-copy-memory", "HTTP memory content preserves selected windows and aliases across copies", memory.Invoke)
    let errors = CompletedContentCopyTest(await `HTTP content copy preserves stream failures and rejects truncated or invalid reads`())
    suite.Add("http-content-copy-errors", "HTTP content copy preserves stream failures and rejects truncated or invalid reads", errors.Invoke)
    let lengths = CompletedContentCopyTest(await `HTTP content copy respects declared lengths and skips empty I/O`())
    suite.Add("http-content-copy-lengths", "HTTP content copy respects declared lengths and skips empty I/O", lengths.Invoke)
    let cancellation = CompletedContentCopyTest(await `HTTP content copy cancellation skips pre-cancelled input and stops pending writes`())
    suite.Add("http-content-copy-cancellation", "HTTP content copy cancellation skips pre-cancelled input and stops pending writes", cancellation.Invoke)
    let disposal = CompletedContentCopyTest(await `HTTP content copy rejects disposed bodies and stops before the next source read`())
    suite.Add("http-content-copy-disposal", "HTTP content copy rejects disposed bodies and stops before the next source read", disposal.Invoke)
    let text = CompletedContentCopyTest(await `HTTP string reader consumes generic streams and preserves owned text and errors`())
    suite.Add("http-content-copy-text", "HTTP string reader consumes generic streams and preserves owned text and errors", text.Invoke)
    let creation = CompletedContentCopyTest(await `HTTP stream creation validates before taking ownership or reading`())
    suite.Add("http-content-copy-creation", "HTTP stream creation validates before taking ownership or reading", creation.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
