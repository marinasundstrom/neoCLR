module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Result.*
import System.Web.Http.*
import NeoClr.Testing.*

[Test]
func `HTTP predefined method values use canonical tokens`() -> Result<unit, TestFailure> {
    _ = Assert.Equal("GET", HttpMethod.Get.Method)?
    _ = Assert.Equal("HEAD", HttpMethod.Head.Method)?
    _ = Assert.Equal("POST", HttpMethod.Post.Method)?
    _ = Assert.Equal("PUT", HttpMethod.Put.Method)?
    _ = Assert.Equal("PATCH", HttpMethod.Patch.Method)?
    _ = Assert.Equal("DELETE", HttpMethod.Delete.Method)?
    _ = Assert.Equal("OPTIONS", HttpMethod.Options.Method)?
    _ = Assert.Equal("TRACE", HttpMethod.Trace.Method)?
    _ = Assert.Equal("CONNECT", HttpMethod.Connect.Method)?
    return Assert.Equal("QUERY", HttpMethod.Query.Method)
}

[Test]
func `HTTP method parsing canonicalizes every known name`() -> Result<unit, TestFailure> {
    for name in ["get", "head", "post", "put", "patch", "delete", "options", "trace", "connect", "query"] {
        let Ok(method) = HttpMethod.Parse(name) else {
            return Assert.True(false, "Known method parses")
        }
        _ = Assert.Equal(name.ToUpperInvariant(), method.Method)?
    }
    return Assert.True(true, "All known names canonicalized")
}

[Test]
func `HTTP custom method construction and parsing preserve spelling`() -> Result<unit, TestFailure> {
    let method = HttpMethod("m-SEARCH")
    _ = Assert.Equal("m-SEARCH", method.Method)?
    _ = Assert.Equal("m-SEARCH", method.ToString())?
    let Ok(parsed) = HttpMethod.Parse("m-SEARCH") else {
        return Assert.True(false, "Custom method parses")
    }
    _ = Assert.Equal("m-SEARCH", parsed.Method)?
    return Assert.Equal("get", HttpMethod("get").Method)
}

[Test]
func `HTTP method validation admits token punctuation and rejects separators`() -> Result<unit, TestFailure> {
    let punctuation = "!#$%&'*+-.^_`|~09AZaz"
    let Ok(valid) = HttpMethod.Parse(punctuation) else {
        return Assert.True(false, "HTTP token punctuation is valid")
    }
    _ = Assert.Equal(punctuation, valid.Method)?
    for invalid in ["", " GET", "GET ", "GE\tT", "GET\r\nX: y", "a/b", "a:b", "a(b)", "é", "😀"] {
        let Failure(HttpError.InvalidRequest(_)) = HttpMethod.Parse(invalid) else {
            return Assert.True(false, "Invalid method is rejected")
        }
    }
    return Assert.True(true, "Invalid methods rejected")
}

[Test]
func `HTTP method equality and hashes ignore ASCII case`() -> Result<unit, TestFailure> {
    let left = HttpMethod("m-search")
    let right = HttpMethod("M-SEARCH")
    _ = Assert.True(left.Equals(right), "Typed equality")?
    _ = Assert.Equal(left.GetHashCode(), right.GetHashCode())?
    let boxed: Object = left
    _ = Assert.True(boxed.Equals(right), "Object equality dispatch")?
    _ = Assert.True(!boxed.Equals(null), "Null is unequal")?
    return Assert.True(!left.Equals(HttpMethod.Get), "Different methods differ")
}

class MethodComparer : EqualityComparer<HttpMethod> {
    func Equals(left: HttpMethod, right: HttpMethod) -> bool => left.Equals(right)
    func GetHashCode(value: HttpMethod) -> int => value.GetHashCode()
}

[Test]
func `HTTP methods retain case-insensitive identity in a set`() -> Result<unit, TestFailure> {
    let methods = HashSet<HttpMethod>(MethodComparer())
    methods.Add(HttpMethod("fetch"))
    methods.Add(HttpMethod("FETCH"))
    _ = Assert.Equal(1, methods.Count)?
    return Assert.True(methods.Contains(HttpMethod("Fetch")), "Case insensitive set lookup")
}

[Test]
func `HTTP request factories retain predefined and custom methods`() -> Result<unit, TestFailure> {
    let Ok(get) = HttpClientRequest.Get("http://example.test/") else {
        return Assert.True(false, "GET construction")
    }
    _ = Assert.True(get.Method.Equals(HttpMethod.Get), "GET method value")?
    let custom = HttpMethod("FETCH")
    let Ok(request) = HttpClientRequest.Create(custom, "http://example.test/", HttpStringContent("body")) else {
        return Assert.True(false, "Custom request construction")
    }
    _ = Assert.True(Object.ReferenceEquals(custom, request.Method), "Method retained")?
    _ = Assert.Equal(4, request.Content.Length)?
    let Ok(copy) = request.WithHeader("X-Test", "value") else {
        return Assert.True(false, "Header copy")
    }
    return Assert.True(copy.Method.Equals(custom), "Copy retains method")
}

[Test]
func `HTTP URI request factories support custom methods and empty content`() -> Result<unit, TestFailure> {
    let Ok(uri) = Uri.Parse("http://example.test/") else {
        return Assert.True(false, "URI parse")
    }
    let Ok(request) = HttpClientRequest.Create(HttpMethod.Options, uri) else {
        return Assert.True(false, "URI request construction")
    }
    _ = Assert.Equal("OPTIONS", request.Method.Method)?
    _ = Assert.Equal(0, request.Content.Length)?
    let Ok(withContent) = HttpClientRequest.Create(HttpMethod("FETCH"), uri, HttpStringContent("body")) else {
        return Assert.True(false, "URI content construction")
    }
    let Ok(empty) = HttpClientRequest.Create(HttpMethod("FETCH"), "http://example.test/") else {
        return Assert.True(false, "URL empty construction")
    }
    _ = Assert.Equal(0, empty.Content.Length)?
    return Assert.Equal(4, withContent.Content.Length)
}

[Test]
func `HTTP coffee requests retain BREW and unnamed status codes`() -> Result<unit, TestFailure> {
    let Ok(request) = HttpClientRequest.Create(HttpMethod("BREW"), "http://example.test/pot-1", HttpStringContent("start")) else {
        return Assert.True(false, "BREW request construction")
    }
    _ = Assert.Equal("BREW", request.Method.Method)?
    let response = HttpClientResponse(418, ArrayList<HttpHeader>(), HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    _ = Assert.Equal(418, (int)response.StatusCode)?
    _ = Assert.True(!response.IsSuccessStatusCode, "Teapot response is unsuccessful")?
    response.Respond((HttpStatusCode)471, HttpStringContent("Custom failure"))
    _ = Assert.Equal(471, (int)response.StatusCode)?
    _ = Assert.True(!response.IsSuccessStatusCode, "Custom client error is unsuccessful")?
    let extensionSuccess = HttpClientResponse((HttpStatusCode)299, ArrayList<HttpHeader>(), HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    return Assert.True(extensionSuccess.IsSuccessStatusCode, "Unnamed success follows its status class")
}
