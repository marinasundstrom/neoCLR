module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Result.*
import System.Text.*
import System.Web.Http.*
import NeoClr.Testing.*

func LargePrefix() -> string {
    var text = "x"
    for index in 0..16 {
        text = String.Concat(text, text)
    }
    return match text.SliceUtf8(0, 65535) {
        Ok(let prefix) => prefix
        Failure(_) => {
            Panic("ASCII fixture boundary")
            ""
        }
    }
}

// The current TestAttribute contract is synchronous. Buffered ReadText completes
// immediately, so GetResult observes that contract without scheduling a wait.
[Test]
func `HTTP buffered text preserves scalars beyond the one-shot codec quota`() -> Result<unit, TestFailure> {
    let text = String.Concat(LargePrefix(), "😀é")
    _ = Assert.True(Encodings.Utf8.Encode(text) is Failure(EncodingError.LimitExceeded), "Fixture exceeds one-shot quota")?
    let content = HttpStringContent(text)
    _ = Assert.True(content is HttpStringContent, "Text factory creates specialization")?
    _ = Assert.Equal(65541, content.Length)?
    let Ok(decoded) = HttpStringContent.Read(content).GetResult() else {
        return Failure(TestFailure("Large body decode", "Ok", "Error"))
    }
    return Assert.Equal(text, decoded)
}

[Test]
func `HTTP buffered text rejects malformed and truncated large bodies`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [for index in 0..65537 => (byte)120]
    bytes[bytes.Length - 1] = (byte)195
    _ = Assert.True(HttpStringContent.Read(HttpMemoryContent(bytes)).GetResult() is Failure(_), "Truncated final scalar")?
    bytes[bytes.Length - 1] = (byte)128
    _ = Assert.True(HttpStringContent.Read(HttpMemoryContent(bytes)).GetResult() is Failure(_), "Stray continuation")?
    bytes[bytes.Length - 1] = (byte)65
    let Ok(text) = HttpStringContent.Read(HttpMemoryContent(bytes)).GetResult() else {
        return Failure(TestFailure("Fresh decode after errors", "Ok", "Error"))
    }
    return Assert.True(text.EndsWithOrdinal("xA"), "Valid body remains readable")
}

[Test]
func `HTTP buffered text preserves empty BOM and NUL data`() -> Result<unit, TestFailure> {
    for text in ["", "\uFEFFcafé\u0000🌍"] {
        let Ok(decoded) = HttpStringContent.Read(HttpStringContent(text)).GetResult() else {
            return Failure(TestFailure("Buffered text decode", "Ok", "Error"))
        }
        _ = Assert.Equal(text, decoded)?
    }
    return Assert.True(true, "Complete text preserved")
}
