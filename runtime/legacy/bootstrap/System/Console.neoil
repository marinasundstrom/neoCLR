; LEGACY CLASS-LIBRARY MIRROR — obsolete for library development.
; Authoritative source: runtime/raven/src; native projects: runtime/raven/projects.
; Retained for bootstrap/tests pending archival; see runtime/README.md.
.type System.Console
    ; The host returns a bounded erased payload; platform IL constructs the carriers.
    .method static ReadByte() -> System.Result<System.Optional<Byte>,System.ConsoleReadError>
        .local Int32 failure
        call neoCLR.Runtime.ConsoleReadByte()
        dup
        value.is Int32
        brtrue Failed
        dup
        value.is Void
        brtrue EndOfInput
        value.unpack Byte
        newobj.ctor instance System.Optional.Some<Byte>::.ctor(Byte)
        newobj.ctor instance System.Optional<Byte>::.ctor(System.Optional.Some<Byte>)
        newobj.ctor instance System.Result.Ok<System.Optional<Byte>>::.ctor(System.Optional<Byte>)
        newobj.ctor instance System.Result<System.Optional<Byte>,System.ConsoleReadError>::.ctor(System.Result.Ok<System.Optional<Byte>>)
        ret
    Failed:
        value.unpack Int32
        stloc failure
        ldloc failure
        ldc.i4 1
        beq Unavailable
        ldloc failure
        ldc.i4 2
        beq ReadFailed
        fault "invalid native I/O status"
    Unavailable:
        newobj instance System.ConsoleReadError.Unavailable::.ctor()
        newobj instance System.ConsoleReadError::.ctor(System.ConsoleReadError.Unavailable)
        br WrapError
    ReadFailed:
        newobj instance System.ConsoleReadError.ReadFailed::.ctor()
        newobj instance System.ConsoleReadError::.ctor(System.ConsoleReadError.ReadFailed)
        br WrapError
    WrapError:
        newobj instance System.Result.Failure<System.ConsoleReadError>::.ctor(System.ConsoleReadError)
        newobj instance System.Result<System.Optional<Byte>,System.ConsoleReadError>::.ctor(System.Result.Failure<System.ConsoleReadError>)
        ret
    EndOfInput:
        pop
        newobj.ctor instance System.Optional.None::.ctor()
        newobj.ctor instance System.Optional<Byte>::.ctor(System.Optional.None)
        newobj.ctor instance System.Result.Ok<System.Optional<Byte>>::.ctor(System.Optional<Byte>)
        newobj.ctor instance System.Result<System.Optional<Byte>,System.ConsoleReadError>::.ctor(System.Result.Ok<System.Optional<Byte>>)
        ret
    .end

    .method static WriteLine(string value) -> Void
        ldarg value
        call neoCLR.Runtime.WriteLine(string)
        ret
    .end

    .method static WriteLine(int32 value) -> Void
        ldarg value
        call instance System.Int32::ToString()
        call System.Console.WriteLine(string)
        ret
    .end

.end

