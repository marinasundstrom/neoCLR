.function neoCLR.Library.System.Int32ParseError.RuntimeBooleanFromInt32(Int32 value) -> Boolean
    ldarg value
    ldc.i4 0
    beq False
    ldarg value
    ldc.i4 1
    beq True
    fault "Non-canonical CLI Boolean"
False:
    ldc.bool false
    ret
True:
    ldc.bool true
    ret
.end
.function neoCLR.Library.System.Int32ParseError.RuntimeBooleanToInt32(Boolean value) -> Int32
