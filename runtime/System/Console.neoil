.type System.Console
    ; The host returns a bounded erased payload; platform IL constructs the carriers.
    .method static ReadByte() -> System.Result<System.Option<Byte>,System.IO.ConsoleReadError>
        .local Int32 failure
        call neoCLR.Runtime.ConsoleReadByte()
        dup
        value.is Int32
        brtrue Failed
        dup
        value.is Void
        brtrue EndOfInput
        value.unpack Byte
        newobj.ctor instance System.Option.Some<Byte>::.ctor(Byte)
        newobj.ctor instance System.Option<Byte>::.ctor(System.Option.Some<Byte>)
        newobj.ctor instance System.Result.Ok<System.Option<Byte>>::.ctor(System.Option<Byte>)
        newobj.ctor instance System.Result<System.Option<Byte>,System.IO.ConsoleReadError>::.ctor(System.Result.Ok<System.Option<Byte>>)
        ret
    Failed:
        value.unpack Int32
        stloc failure
        ldloc failure
        ldc.i4 1
        beq Unavailable
        ldloc failure
        ldc.i4 2
        beq ReadFailed
        fault "invalid native I/O status"
    Unavailable:
        newobj instance System.IO.ConsoleReadError.Unavailable::.ctor()
        newobj instance System.IO.ConsoleReadError::.ctor(System.IO.ConsoleReadError.Unavailable)
        br WrapError
    ReadFailed:
        newobj instance System.IO.ConsoleReadError.ReadFailed::.ctor()
        newobj instance System.IO.ConsoleReadError::.ctor(System.IO.ConsoleReadError.ReadFailed)
        br WrapError
    WrapError:
        newobj instance System.Result.Error<System.IO.ConsoleReadError>::.ctor(System.IO.ConsoleReadError)
        newobj instance System.Result<System.Option<Byte>,System.IO.ConsoleReadError>::.ctor(System.Result.Error<System.IO.ConsoleReadError>)
        ret
    EndOfInput:
        pop
        newobj.ctor instance System.Option.None::.ctor()
        newobj.ctor instance System.Option<Byte>::.ctor(System.Option.None)
        newobj.ctor instance System.Result.Ok<System.Option<Byte>>::.ctor(System.Option<Byte>)
        newobj.ctor instance System.Result<System.Option<Byte>,System.IO.ConsoleReadError>::.ctor(System.Result.Ok<System.Option<Byte>>)
        ret
    .end

    .method static WriteLine(string value) -> Void
        ldarg value
        call neoCLR.Runtime.WriteLine(string)
        ret
    .end

    .method static WriteLine(int32 value) -> Void
        ldarg value
        call instance System.Int32::ToString()
        call System.Console.WriteLine(string)
        ret
    .end

.end

