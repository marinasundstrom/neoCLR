.type System.Math
    .include "../raven/generated/Math.methods.neoil"

    .method static Abs(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathAbs(Double)
        ret
    .end

    .method static Sqrt(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathSqrt(Double)
        ret
    .end

    .method static Floor(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathFloor(Double)
        ret
    .end

    .method static Ceiling(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathCeiling(Double)
        ret
    .end

    .method static Truncate(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathTruncate(Double)
        ret
    .end

    .method static Round(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathRound(Double)
        ret
    .end

    .method static Exp(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathExp(Double)
        ret
    .end

    .method static Log(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathLog(Double)
        ret
    .end

    .method static Log10(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathLog10(Double)
        ret
    .end

    .method static Sin(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathSin(Double)
        ret
    .end

    .method static Cos(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathCos(Double)
        ret
    .end

    .method static Tan(Double value) -> Double
        ldarg value
        call neoCLR.Runtime.MathTan(Double)
        ret
    .end

    .method static Pow(Double left, Double right) -> Double
        ldarg left
        ldarg right
        call neoCLR.Runtime.MathPow(Double,Double)
        ret
    .end

    .method static Min(Double left, Double right) -> Double
