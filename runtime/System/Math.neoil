        call neoCLR.Runtime.MathMin(Double,Double)
        ret
    .end

    .method static Max(Double left, Double right) -> Double
        ldarg left
        ldarg right
        call neoCLR.Runtime.MathMax(Double,Double)
        ret
    .end

.end

.include "../raven/generated/Math.helpers.neoil"
