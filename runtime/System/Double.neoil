.type System.Double
    .implements System.Comparable<Double>
    .method instance readonly byref CompareTo(Double other) -> Int32
        ldarg this
        ldobj Double
        ldarg this
        ldobj Double
        ceq
        brfalse ReceiverNaN
        ldarg other
        ldarg other
        ceq
        brfalse Greater
        ldarg this
        ldobj Double
        ldarg other
        blt Less
        ldarg this
        ldobj Double
        ldarg other
        bgt Greater
    Equal:
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    ReceiverNaN:
        ldarg other
        ldarg other
        ceq
        brfalse Equal
        br Less
    .end
.end

