    .method instance ToString() -> String
        ldarg this
        call instance System.IO.ConsoleReadError::get_IsUnavailable()
        brtrue Unavailable
        ldarg this
        call instance System.IO.ConsoleReadError::get_IsReadFailed()
        brtrue ReadFailed
        fault "invalid I/O error case"
    Unavailable:
        ldstr "ConsoleUnavailable"
        ret
    ReadFailed:
        ldstr "ConsoleReadFailed"
        ret
    .end
.end
