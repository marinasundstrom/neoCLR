        call instance System.IO.FileWriteError::get_IsInvalidLimit()
        brtrue InvalidLimit
        ldarg this
        call instance System.IO.FileWriteError::get_IsInvalidPath()
        brtrue InvalidPath
        ldarg this
        call instance System.IO.FileWriteError::get_IsNotFound()
