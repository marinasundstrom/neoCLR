; Raven-authored delegate declarations; invocation is runtime-owned.
.include "../raven/generated/Func.methods.neoil"
.include "../raven/generated/Func.helpers.neoil"

; Managed-array callback consumer, independent of the legacy native Array<T> buffer.
.type System.Array
    .method static ForEach<T>(readonly T[]& array, System.Func<T,Void> action) -> Void
        .local Int32 index
        ldc.i4 0
        stloc index
        br Test
    Body:
        ldarg action
        ldarg array
        ldloc index
        ldelem T
        call instance System.Func<T,Void>::Invoke(T)
        pop
        ldloc index
        ldc.i4 1
        add
        stloc index
    Test:
        ldloc index
        ldarg array
        ldlen
        conv.i4
        blt Body
        ldvoid
        ret
    .end
.end
