.type System.UIntPtr
    .implements System.Comparable<UIntPtr>
    .method instance readonly byref CompareTo(UIntPtr other) -> Int32
        ldarg this
        ldobj UIntPtr
        ldarg other
        blt.un Less
        ldarg this
        ldobj UIntPtr
        ldarg other
        bgt.un Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

