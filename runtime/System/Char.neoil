.type System.Char
    .implements System.Comparable<Char>
    .method instance readonly byref CompareTo(Char other) -> Int32
        ldarg this
        ldobj Char
        ldarg other
        blt.un Less
        ldarg this
        ldobj Char
        ldarg other
        bgt.un Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

