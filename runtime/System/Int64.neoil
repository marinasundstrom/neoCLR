.type System.Int64
    .implements System.Comparable<Int64>
    .method instance readonly byref CompareTo(Int64 other) -> Int32
        ldarg this
        ldobj Int64
        ldarg other
        blt Less
        ldarg this
        ldobj Int64
        ldarg other
        bgt Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

