.type System.Int32
    .method static Parse(string value) -> System.Result<Int32,Error>
        ldarg 0
        call neoCLR.Runtime.ParseInt32(string)
        dup
        value.is Int32
        brfalse Failed
        value.unpack Int32
        newobj instance System.Result.Ok<Int32>::.ctor(Int32)
        newobj instance System.Result<Int32,Error>::.ctor(System.Result.Ok<Int32>)
        ret
    Failed:
        value.unpack Error
        newobj instance System.Result.Error<Error>::.ctor(Error)
        newobj instance System.Result<Int32,Error>::.ctor(System.Result.Error<Error>)
        ret
    .end

    .method static Divide(int32 dividend, int32 divisor) -> Result<Int32,Error>
        ldarg divisor
        ldc.i4 0
        ceq
        brtrue DivisionByZero
        ldarg dividend
        ldc.i4 -2147483648
        ceq
        brtrue CheckOverflow
        br Divide
        CheckOverflow:
        ldarg divisor
        ldc.i4 -1
        ceq
        brtrue Overflow
        Divide:
        ldarg dividend
        ldarg divisor
        div
        ok Error
        ret
        DivisionByZero:
        error "DivisionByZero"
        err Int32
        ret
        Overflow:
        error "Overflow"
        err Int32
        ret
    .end

    .method instance ToString() -> string
        ldarg this
        call neoCLR.Runtime.Int32ToString(int32)
        ret
    .end
.end

