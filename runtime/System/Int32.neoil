.type System.Int32
    .implements System.Comparable<Int32>
    .implements System.Equatable<Int32>
    .method static Parse(string value) -> System.Result<Int32,System.Int32ParseError>
        .local Byte failure
        ldarg 0
        call neoCLR.Runtime.ParseInt32(string)
        dup
        value.is Int32
        brfalse Failed
        value.unpack Int32
        newobj instance System.Result.Ok<Int32>::.ctor(Int32)
        newobj instance System.Result<Int32,System.Int32ParseError>::.ctor(System.Result.Ok<Int32>)
        ret
    Failed:
        value.unpack Byte
        stloc failure
        ldloc failure
        ldc.i4 1
        beq InvalidFormat
        ldloc failure
        ldc.i4 2
        beq Overflow
        fault "invalid native parse status"
    Overflow:
        newobj instance System.Int32ParseError.Overflow::.ctor()
        newobj instance System.Int32ParseError::.ctor(System.Int32ParseError.Overflow)
        br WrapError
    InvalidFormat:
        newobj instance System.Int32ParseError.InvalidFormat::.ctor()
        newobj instance System.Int32ParseError::.ctor(System.Int32ParseError.InvalidFormat)
    WrapError:
        newobj instance System.Result.Error<System.Int32ParseError>::.ctor(System.Int32ParseError)
        newobj instance System.Result<Int32,System.Int32ParseError>::.ctor(System.Result.Error<System.Int32ParseError>)
        ret
    .end

    .method static Divide(int32 dividend, int32 divisor) -> System.Result<Int32,System.IntegerDivisionError>
        ldarg divisor
        ldc.i4 0
        ceq
        brtrue DivisionByZero
        ldarg dividend
        ldc.i4 -2147483648
        ceq
        brtrue CheckOverflow
        br Divide
        CheckOverflow:
        ldarg divisor
        ldc.i4 -1
        ceq
        brtrue Overflow
        Divide:
        ldarg dividend
        ldarg divisor
        div
        newobj instance System.Result.Ok<Int32>::.ctor(Int32)
        newobj instance System.Result<Int32,System.IntegerDivisionError>::.ctor(System.Result.Ok<Int32>)
        ret
        DivisionByZero:
        newobj instance System.IntegerDivisionError.DivisionByZero::.ctor()
        newobj instance System.IntegerDivisionError::.ctor(System.IntegerDivisionError.DivisionByZero)
        newobj instance System.Result.Error<System.IntegerDivisionError>::.ctor(System.IntegerDivisionError)
        newobj instance System.Result<Int32,System.IntegerDivisionError>::.ctor(System.Result.Error<System.IntegerDivisionError>)
        ret
        Overflow:
        newobj instance System.IntegerDivisionError.Overflow::.ctor()
        newobj instance System.IntegerDivisionError::.ctor(System.IntegerDivisionError.Overflow)
        newobj instance System.Result.Error<System.IntegerDivisionError>::.ctor(System.IntegerDivisionError)
        newobj instance System.Result<Int32,System.IntegerDivisionError>::.ctor(System.Result.Error<System.IntegerDivisionError>)
        ret
    .end

    .method instance readonly byref Equals(Int32 other) -> Boolean
        ldarg this
        ldobj Int32
        ldarg other
        ceq
        ret
    .end

    .method instance ToString() -> string
        ldarg this
        call neoCLR.Runtime.Int32ToString(int32)
        ret
    .end
    .method instance readonly byref CompareTo(Int32 other) -> Int32
        ldarg this
        ldobj Int32
        ldarg other
        blt Less
        ldarg this
        ldobj Int32
        ldarg other
        bgt Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

