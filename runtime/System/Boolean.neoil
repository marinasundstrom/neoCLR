.type System.Boolean
    .implements System.Comparable<Boolean>
    .method instance readonly byref CompareTo(Boolean other) -> Int32
        ldarg this
        ldobj Boolean
        ldarg other
        ceq
        brtrue Equal
        ldarg this
        ldobj Boolean
        brtrue Greater
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    Equal:
        ldc.i4 0
        ret
    .end
.end
