; Value descriptor. Explicit ArrayList<T>& aliases share the entire list.
; Ordinary copies share Data until growth, and copy Count independently.
.type System.Collections.ArrayList<T>
    .implements System.Collections.List<T>
    .field private Data T[]&
    .field private Count Int32

    .method static Allocate(Int32 capacity) -> System.Collections.ArrayList<T>
        ldarg capacity
        ldc.i4 0
        blt Invalid
        ldarg capacity
        array.alloc T
        ldc.i4 0
        newobj System.Collections.ArrayList<T>
        ret
    Invalid:
        fault "ArrayList capacity must be non-negative"
    .end

    .property instance Count() -> Int32
        .get instance System.Collections.ArrayList<T>::get_Count()
    .end
    .method instance readonly byref get_Count() -> Int32
        ldarg this
        ldobj System.Collections.ArrayList<T>
        ldfld 1
        ret
    .end
    .property instance Capacity() -> Int32
        .get instance System.Collections.ArrayList<T>::get_Capacity()
    .end
    .method instance readonly byref get_Capacity() -> Int32
        ldarg this
        ldobj System.Collections.ArrayList<T>
        ldfld 0
        ldlen
        conv.ovf.i4
        ret
    .end
    .method private instance readonly byref CheckIndex(Int32 index) -> Void
        ldarg index
        ldc.i4 0
        blt Invalid
        ldarg index
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        bge Invalid
        ldvoid
        ret
    Invalid:
        fault "ArrayList index out of range"
    .end
    .property instance Item(Int32) -> T
        .get instance System.Collections.ArrayList<T>::get_Item(Int32)
        .set instance System.Collections.ArrayList<T>::set_Item(Int32,T)
    .end
    .method instance readonly byref get_Item(Int32 index) -> T
        ldarg this
        ldarg index
        call instance System.Collections.ArrayList<T>::CheckIndex(Int32)
        pop
        ldarg this
        ldobj System.Collections.ArrayList<T>
        ldfld 0
        ldarg index
        ldelem T
        ret
    .end
    .method instance byref set_Item(Int32 index, T value) -> Void
        ldarg this
        ldarg index
        call instance System.Collections.ArrayList<T>::CheckIndex(Int32)
        pop
        ldarg this
        ldobj System.Collections.ArrayList<T>
        ldfld 0
        ldarg index
        ldarg value
        stelem T
        ldvoid
        ret
    .end
    .method instance byref Add(T value) -> Void
        .local T[]& data
        .local T[]& oldData
        .local Int32 count
        .local Int32 capacity
        .local Int32 index
        ldarg this
        ldobj System.Collections.ArrayList<T>
        ldfld 0
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        ldloc data
        ldlen
        conv.ovf.i4
        stloc capacity
        ldloc count
        ldloc capacity
        blt Store
        ldloc capacity
        brtrue Double
        ldc.i4 4
        stloc capacity
        br Allocate
    Double:
        ldloc capacity
        ldc.i4 2
        mul.ovf
        stloc capacity
    Allocate:
        ldloc data
        stloc oldData
        ldloc capacity
        array.alloc T
        stloc data
        ldc.i4 0
        stloc index
        br Test
    Copy:
        ldloc data
        ldloc index
        ldloc oldData
        ldloc index
        ldelem T
        stelem T
        ldloc index
        ldc.i4 1
        add
        stloc index
    Test:
        ldloc index
        ldloc count
        blt Copy
    Store:
        ldloc data
        ldloc count
        ldarg value
        stelem T
        ldarg this
        ldloc data
        ldloc count
        ldc.i4 1
        add.ovf
        newobj System.Collections.ArrayList<T>
        stobj System.Collections.ArrayList<T>
        ldvoid
        ret
    .end
.end
