; Value wrapper with coherent shared managed state. Copy() duplicates the sequence.
.type internal System.Collections.ArrayListState<T>
    .field internal Data T[]&
    .field internal Count Int32
.end
.type System.Collections.ArrayList<T>
    .implements System.Collections.List<T>
    .field private State System.Collections.ArrayListState<T>&

    .method static Allocate(Int32 capacity) -> System.Collections.ArrayList<T>
        ldarg capacity
        ldc.i4 0
        blt Invalid
        ldarg capacity
        array.alloc T
        ldc.i4 0
        newobj System.Collections.ArrayListState<T>
        heap.new
        newobj System.Collections.ArrayList<T>
        ret
    Invalid:
        fault "ArrayList capacity must be non-negative"
    .end

    .method instance readonly byref GetIterator() -> System.Collections.Iterator<T>&
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Count
        call System.Collections.ArrayIterator<T>::Create(T[]&,Int32)
        ret
    .end

    .property instance Count() -> Int32
        .get instance System.Collections.ArrayList<T>::get_Count()
    .end
    .method instance readonly byref get_Count() -> Int32
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Count
        ret
    .end
    .property instance Capacity() -> Int32
        .get instance System.Collections.ArrayList<T>::get_Capacity()
    .end
    .method instance readonly byref get_Capacity() -> Int32
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        ldlen
        conv.ovf.i4
        ret
    .end
    .method private instance readonly byref CheckIndex(Int32 index) -> Void
        ldarg index
        ldc.i4 0
        blt Invalid
        ldarg index
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        bge Invalid
        ldvoid
        ret
    Invalid:
        fault "ArrayList index out of range"
    .end
    .property instance Item(Int32) -> T
        .get instance System.Collections.ArrayList<T>::get_Item(Int32)
        .set instance System.Collections.ArrayList<T>::set_Item(Int32,T)
    .end
    .method instance readonly byref get_Item(Int32 index) -> T
        ldarg this
        ldarg index
        call instance System.Collections.ArrayList<T>::CheckIndex(Int32)
        pop
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        ldarg index
        ldelem T
        ret
    .end
    .method instance byref set_Item(Int32 index, T value) -> Void
        ldarg this
        ldarg index
        call instance System.Collections.ArrayList<T>::CheckIndex(Int32)
        pop
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        ldarg index
        ldarg value
        stelem T
        ldvoid
        ret
    .end
    .method instance byref Add(T value) -> Void
        .local T[]& data
        .local T[]& oldData
        .local Int32 count
        .local Int32 capacity
        .local Int32 index
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        ldloc data
        ldlen
        conv.ovf.i4
        stloc capacity
        ldloc count
        ldloc capacity
        blt Store
        ldloc capacity
        brtrue Double
        ldc.i4 4
        stloc capacity
        br Allocate
    Double:
        ldloc capacity
        ldc.i4 2
        mul.ovf
        stloc capacity
    Allocate:
        ldloc data
        stloc oldData
        ldloc capacity
        array.alloc T
        stloc data
        ldc.i4 0
        stloc index
        br Test
    Copy:
        ldloc data
        ldloc index
        ldloc oldData
        ldloc index
        ldelem T
        stelem T
        ldloc index
        ldc.i4 1
        add
        stloc index
    Test:
        ldloc index
        ldloc count
        blt Copy
    Store:
        ldloc data
        ldloc count
        ldarg value
        stelem T
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldloc data
        stfld System.Collections.ArrayListState<T>::Data
        pop
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldloc count
        ldc.i4 1
        add.ovf
        stfld System.Collections.ArrayListState<T>::Count
        pop
        ldvoid
        ret
    .end
    ; Independent sequence, shallow element copies; spare capacity is not copied.
    .method instance readonly byref Copy() -> System.Collections.ArrayList<T>
        .local System.Collections.ArrayList<T> copy
        .local T[]& data
        .local Int32 count
        .local Int32 index
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        ldloc count
        call System.Collections.ArrayList<T>::Allocate(Int32)
        stloc copy
        ldc.i4 0
        stloc index
        br Test
    CopyElement:
        ldloca copy
        ldloc data
        ldloc index
        ldelem T
        call instance System.Collections.ArrayList<T>::Add(T)
        pop
        ldloc index
        ldc.i4 1
        add.ovf
        stloc index
    Test:
        ldloc index
        ldloc count
        blt CopyElement
        ldloc copy
        ret
    .end

    ; Predicate searches retain the same initial buffer/extent as GetIterator.
    .method instance readonly byref FindIndex(System.Func<T,Boolean> match) -> Int32
        .local System.Collections.Iterator<T>& iterator
        .local Int32 index
        ldarg this
        call instance System.Collections.ArrayList<T>::GetIterator()
        stloc iterator
        ldc.i4 0
        stloc index
    Next:
        ldloc iterator
        callvirt instance System.Collections.Iterator<T>::MoveNext()
        brfalse Missing
        ldarg match
        ldloc iterator
        callvirt instance System.Collections.Iterator<T>::get_Current()
        call instance System.Func<T,Boolean>::Invoke(T)
        brtrue Found
        ldloc index
        ldc.i4 1
        add.ovf
        stloc index
        br Next
    Found:
        ldloc iterator
        interface.borrow System.Disposable
        callvirt instance System.Disposable::Dispose()
        pop
        ldloc index
        ret
    Missing:
        ldloc iterator
        interface.borrow System.Disposable
        callvirt instance System.Disposable::Dispose()
        pop
        ldc.i4 -1
        ret
    .end

    .method instance readonly byref Exists(System.Func<T,Boolean> match) -> Boolean
        ldarg this
        ldarg match
        call instance System.Collections.ArrayList<T>::FindIndex(System.Func<T,Boolean>)
        ldc.i4 0
        clt
        ldc.bool false
        ceq
        ret
    .end

    .method instance readonly byref Find(System.Func<T,Boolean> match) -> System.Option<T>
        .local System.Collections.Iterator<T>& iterator
        .local T value
        ldarg this
        call instance System.Collections.ArrayList<T>::GetIterator()
        stloc iterator
    Next:
        ldloc iterator
        callvirt instance System.Collections.Iterator<T>::MoveNext()
        brfalse Missing
        ldloc iterator
        callvirt instance System.Collections.Iterator<T>::get_Current()
        stloc value
        ldarg match
        ldloc value
        call instance System.Func<T,Boolean>::Invoke(T)
        brtrue Found
        br Next
    Found:
        ldloc iterator
        interface.borrow System.Disposable
        callvirt instance System.Disposable::Dispose()
        pop
        ldloc value
        newobj instance System.Option.Some<T>::.ctor(T)
        newobj instance System.Option<T>::.ctor(System.Option.Some<T>)
        ret
    Missing:
        ldloc iterator
        interface.borrow System.Disposable
        callvirt instance System.Disposable::Dispose()
        pop
        newobj instance System.Option.None::.ctor()
        newobj instance System.Option<T>::.ctor(System.Option.None)
        ret
    .end
.end
