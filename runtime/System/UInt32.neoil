.type System.UInt32
    .implements System.Comparable<UInt32>
    .method instance readonly byref CompareTo(UInt32 other) -> Int32
        ldarg this
        ldobj UInt32
        ldarg other
        blt.un Less
        ldarg this
        ldobj UInt32
        ldarg other
        bgt.un Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

