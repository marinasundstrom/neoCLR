    .property instance Year() -> Int32
        .get instance System.Date::get_Year()
    .end
    .method instance readonly byref get_Year() -> Int32
        .local Int32 remaining
        .local Int32 year
        .local Int32 cycles
        ldarg this
        ldfld 0
        stloc remaining
        ldloc remaining
        ldc.i4 146097
        div
        ldc.i4 400
        mul
        stloc year
        ldloc remaining
        ldc.i4 146097
        rem
        stloc remaining
        ldloc remaining
        ldc.i4 36524
        div
        ldc.i4 3
        call System.Math::Min(Int32,Int32)
        stloc cycles
        ldloc year
        ldloc cycles
        ldc.i4 100
        mul
        add
        stloc year
        ldloc remaining
        ldloc cycles
        ldc.i4 36524
        mul
        sub
        stloc remaining
        ldloc year
        ldloc remaining
        ldc.i4 1461
        div
        ldc.i4 4
        mul
        add
        stloc year
        ldloc remaining
        ldc.i4 1461
        rem
        ldc.i4 365
        div
        ldc.i4 3
        call System.Math::Min(Int32,Int32)
        ldloc year
        add
        ldc.i4 1
        add
        ret
    .end

    .property instance DayOfYear() -> Int32
        .get instance System.Date::get_DayOfYear()
    .end
    .method instance readonly byref get_DayOfYear() -> Int32
        ldarg this
        ldfld 0
        ldarg this
        call instance System.Date::get_Year()
        call System.Date::DaysBeforeYear(Int32)
        sub
        ldc.i4 1
        add
        ret
    .end

    .property instance Month() -> Int32
        .get instance System.Date::get_Month()
    .end
    .method instance readonly byref get_Month() -> Int32
        .local Int32 year
        .local Int32 remaining
        .local Int32 month
        .local Int32 length
        ldarg this
        call instance System.Date::get_Year()
        stloc year
        ldarg this
        call instance System.Date::get_DayOfYear()
        stloc remaining
        ldc.i4 1
        stloc month
        Next:
        ldloc year
        ldloc month
        call System.Date::DaysInMonth(Int32,Int32)
        stloc length
        ldloc remaining
        ldloc length
        ble Done
        ldloc remaining
        ldloc length
        sub
        stloc remaining
        ldloc month
        ldc.i4 1
        add
        stloc month
        br Next
        Done:
        ldloc month
        ret
    .end

    .property instance Day() -> Int32
        .get instance System.Date::get_Day()
    .end
    .method instance readonly byref get_Day() -> Int32
        ldarg this
        call instance System.Date::get_DayOfYear()
        ldarg this
        call instance System.Date::get_Year()
        ldarg this
        call instance System.Date::get_Month()
        call System.Date::DaysBeforeMonth(Int32,Int32)
        sub
        ret
    .end

    .method instance readonly byref Equals(System.Date other) -> Boolean
        ldarg this
        ldfld 0
        ldarg other
        ldfld 0
        ceq
        ret
    .end

    .method instance readonly byref CompareTo(System.Date other) -> Int32
        ldarg this
        ldfld 0
        ldarg other
        ldfld 0
        blt Less
        ldarg this
        ldfld 0
        ldarg other
        ldfld 0
        bgt Greater
        ldc.i4 0
        ret
        Less:
        ldc.i4 -1
        ret
        Greater:
        ldc.i4 1
        ret
    .end

.end
