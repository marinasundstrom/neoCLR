.type System.Environment
    .method static GetCommandLineArgs() -> String[]
        call neoCLR.Runtime.EnvironmentArguments()
        ret
    .end
    .method static GetCurrentDirectory() -> System.Result<String,System.EnvironmentError>
        call neoCLR.Runtime.EnvironmentCurrentDirectory()
        dup
        value.is Int32
        brtrue Failed
        value.unpack String
    Success:
        newobj.ctor instance System.Result.Ok<String>::.ctor(String)
        newobj.ctor instance System.Result<String,System.EnvironmentError>::.ctor(System.Result.Ok<String>)
        ret
    Failed:
        pop
        newobj System.EnvironmentError
        newobj.ctor instance System.Result.Failure<System.EnvironmentError>::.ctor(System.EnvironmentError)
        newobj.ctor instance System.Result<String,System.EnvironmentError>::.ctor(System.Result.Failure<System.EnvironmentError>)
        ret
    .end
    .method static GetEnvironmentVariable(String name) -> System.Result<System.Optional<String>,System.EnvironmentError>
        ldarg name
        call neoCLR.Runtime.EnvironmentVariable(String)
        dup
        value.is Int32
        brtrue Failed
        dup
        value.is Void
        brtrue Missing
        value.unpack String
        newobj.ctor instance System.Optional.Some<String>::.ctor(String)
        newobj.ctor instance System.Optional<String>::.ctor(System.Optional.Some<String>)
    Success:
        newobj.ctor instance System.Result.Ok<System.Optional<String>>::.ctor(System.Optional<String>)
        newobj.ctor instance System.Result<System.Optional<String>,System.EnvironmentError>::.ctor(System.Result.Ok<System.Optional<String>>)
        ret
    Missing:
        pop
        newobj.ctor instance System.Optional.None::.ctor()
        newobj.ctor instance System.Optional<String>::.ctor(System.Optional.None)
        br Success
    Failed:
        pop
        newobj System.EnvironmentError
        newobj.ctor instance System.Result.Failure<System.EnvironmentError>::.ctor(System.EnvironmentError)
        newobj.ctor instance System.Result<System.Optional<String>,System.EnvironmentError>::.ctor(System.Result.Failure<System.EnvironmentError>)
        ret
    .end
.end
