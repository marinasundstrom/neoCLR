.type System.SByte
    .implements System.Comparable<SByte>
    .method instance readonly byref CompareTo(SByte other) -> Int32
        ldarg this
        ldobj SByte
        ldarg other
        blt Less
        ldarg this
        ldobj SByte
        ldarg other
        bgt Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

