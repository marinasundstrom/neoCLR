.type System.IntPtr
    .implements System.Comparable<IntPtr>
    .method instance readonly byref CompareTo(IntPtr other) -> Int32
        ldarg this
        ldobj IntPtr
        ldarg other
        blt Less
        ldarg this
        ldobj IntPtr
        ldarg other
        bgt Greater
        ldc.i4 0
        ret
    Less:
        ldc.i4 -1
        ret
    Greater:
        ldc.i4 1
        ret
    .end
.end

