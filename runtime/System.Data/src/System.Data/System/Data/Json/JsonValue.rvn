module System.Data.Json

import System.*
import System.Collections.*
import System.Result.*

// Closed reference hierarchy. Members belong to the kind that supports them.
public sealed class JsonValue {
    protected init() { }

    /// <summary>Converts this node to compact JSON text, including JSON quoting and escaping for strings.</summary>
    /// <returns>JSON text or a validation/quota error. This does not return an unquoted scalar display value.</returns>
    func ToJsonString() -> Result<string, JsonError> {
        return JsonSerializer.SerializeNode(self)
    }

    /// <summary>Converts this node to JSON text using the selected formatting.</summary>
    /// <param name="options">Formatting options; WriteIndented enables two-space indentation and LF newlines.</param>
    /// <returns>JSON text or a validation/quota error, including when formatting exceeds the output byte limit.</returns>
    func ToJsonString(options: JsonSerializerOptions) -> Result<string, JsonError> {
        return JsonSerializer.SerializeNode(self, options)
    }
}

/// <summary>A JSON object with ordinal field names and a read-only map view.</summary>
/// <remarks>Field and Find provide safe lookup. The indexer faults when a field is absent. Keys and pair iteration are shallow snapshots in insertion order; JsonNull remains an explicit present value. Mutation uses duplicate-rejecting Add.</remarks>
public class JsonObject : JsonValue, Map<string, JsonValue> {
    private var names: ArrayList<string> = ArrayList<string>()
    private var values: ArrayList<JsonValue> = ArrayList<JsonValue>()

    init(): base() { }

    val Count: int => values.Count

    /// <summary>Gets a shallow snapshot of field names in insertion order.</summary>
    val Keys: Sequence<string> => names.Copy()

    /// <summary>Gets an existing JSON field value.</summary>
    /// <param name="name">The exact ordinal field name.</param>
    /// <remarks>Missing fields cause a terminal Fault. Prefer Field or Find when absence is expected. A present JsonNull is returned unchanged.</remarks>
    val self[name: string]: JsonValue {
        get {
            for index in 0..names.Count {
                if String.CompareOrdinal(names[index], name) == 0 {
                    return values[index]
                }
            }
            System.Fail("JsonObject field not found")
        }
    }

    /// <summary>Finds a field, returning None when absent and Some for every present node, including JsonNull.</summary>
    /// <param name="name">The exact ordinal field name.</param>
    func Find(name: string) -> Optional<JsonValue> {
        if Field(name) is Ok(let value) {
            return Optional<JsonValue>.Some(value)
        }
        return Optional<JsonValue>.None
    }

    /// <summary>Tests whether an exact ordinal field name is present.</summary>
    /// <param name="name">The field name to test.</param>
    func ContainsKey(name: string) -> bool {
        return Find(name) is Optional<JsonValue>.Some(_)
    }

    /// <summary>Returns a shallow snapshot of field pairs in insertion order.</summary>
    /// <returns>An owned iterator retaining the original node references. Later additions do not alter its pairs.</returns>
    func GetIterator() -> Iterator<KeyValuePair<string, JsonValue>> {
        let pairs = ArrayList<KeyValuePair<string, JsonValue>>(names.Count)
        for index in 0..names.Count {
            pairs.Add(KeyValuePair<string, JsonValue>(names[index], values[index]))
        }
        return pairs.GetIterator()
    }

    func Field(name: string) -> Result<JsonValue, JsonError> {
        for index in 0..names.Count {
            if String.CompareOrdinal(names[index], name) == 0 {
                return Ok(values[index])
            }
        }
        return Failure(JsonError.MissingField(name))
    }

    func Item(index: int) -> Result<JsonValue, JsonError> {
        if index < 0 || index >= values.Count {
            return Failure(JsonError.InvalidIndex(index))
        }
        return Ok(values[index])
    }

    func Name(index: int) -> Result<string, JsonError> {
        if index < 0 || index >= names.Count {
            return Failure(JsonError.InvalidIndex(index))
        }
        return Ok(names[index])
    }

    // Add only: duplicate names never silently replace earlier values.
    func Add(name: string, value: JsonValue) -> Result<unit, JsonError> {
        for previous in names {
            if String.CompareOrdinal(previous, name) == 0 {
                return Failure(JsonError.DuplicateField(name))
            }
        }
        names.Add(name)
        values.Add(value)
        return Ok(())
    }
}

/// <summary>A JSON array with a read-only sequence view.</summary>
/// <remarks>Indexing faults on invalid indices; Item returns a recoverable error. Iteration captures a shallow ordered snapshot; node contents remain shared. Mutation uses Add; storage follows the runtime allocation budget.</remarks>
public class JsonArray : JsonValue, Sequence<JsonValue> {
    private var values: ArrayList<JsonValue> = ArrayList<JsonValue>()

    init(): base() { }

    val Count: int => values.Count

    /// <summary>Gets the original node at a zero-based index, including JsonNull.</summary>
    /// <param name="index">The zero-based element index.</param>
    /// <remarks>Invalid indices cause a terminal Fault. Prefer Item when an invalid index is expected.</remarks>
    val self[index: int]: JsonValue {
        get {
            if index < 0 || index >= values.Count {
                System.Fail("JsonArray index out of range")
            }
            return values[index]
        }
    }

    /// <summary>Returns a shallow snapshot iterator in element order.</summary>
    /// <returns>An owned iterator retaining original node references. Later additions do not alter the snapshot.</returns>
    func GetIterator() -> Iterator<JsonValue> {
        return values.Copy().GetIterator()
    }

    func Item(index: int) -> Result<JsonValue, JsonError> {
        if index < 0 || index >= values.Count {
            return Failure(JsonError.InvalidIndex(index))
        }
        return Ok(values[index])
    }

    func Add(value: JsonValue) -> Result<unit, JsonError> {
        values.Add(value)
        return Ok(())
    }
}

public class JsonString : JsonValue {
    private var value: string = ""

    init(value: string): base() {
        self.value = value
    }

    val Value: string => value
}

public class JsonNumber : JsonValue {
    private var text: string = ""

    private init(text: string): base() {
        self.text = text
    }

    val Text: string => text

    static func Parse(text: string) -> Result<JsonNumber, JsonError> {
        if !JsonSyntax.ValidNumber(text) {
            return Failure(JsonError.InvalidNumber)
        }
        return Ok(JsonNumber(text))
    }

    func AsInt32() -> Result<int, JsonError> {
        return match Int32.Parse(text) {
            Ok(let value) => Ok(value)
            Failure(_) => Failure(JsonError.NumberOutOfRange)
        }
    }
}

public class JsonBoolean : JsonValue {
    private var value: bool = false

    init(value: bool): base() {
        self.value = value
    }

    val Value: bool => value
}

public class JsonNull : JsonValue {
    init(): base() { }
}
