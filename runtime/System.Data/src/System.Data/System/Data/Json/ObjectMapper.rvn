module System.Data.Json

import System.*
import System.Diagnostics.CodeAnalysis.*
import System.Collections.*
import System.Introspection.*
import System.Optional.*
import System.Result.*
import System.Runtime.Reflection.*
import System.Runtime.CompilerServices.*

internal class ObjectMapper {
    init() { }

    private static func IsNodeType(type: TypeInfo) -> bool {
        return type.AssignableTo(typeof(JsonValue))
    }

    private static func MatchesNode(value: JsonValue, type: TypeInfo) -> bool {
        return type.IsInstanceOfType(value)
    }

    private static func CheckType(type: TypeInfo) -> Result<unit, JsonError> {
        if IsNodeType(type) || type.Equals(typeof(string)) || type.Equals(typeof(int)) || type.Equals(typeof(bool)) {
            return Ok(())
        }
        let collection = neoCLR.Runtime.ReflectionCollectionKind(type)
        if collection != 0 {
            return CheckType(type.GetGenericArgument(collection - 1))
        }
        if type.IsArray {
            if let Some(element) = type.GetElementType() {
                return CheckType(element)
            }
        }
        // Primitive descriptors are nominal too; admitting records must not turn
        // unsupported numeric values into empty JSON objects.
        if type.Equals(typeof(SByte)) || type.Equals(typeof(Byte)) ||
           type.Equals(typeof(Int16)) || type.Equals(typeof(UInt16)) ||
           type.Equals(typeof(UInt32)) || type.Equals(typeof(Int64)) ||
           type.Equals(typeof(UInt64)) || type.Equals(typeof(IntPtr)) ||
           type.Equals(typeof(UIntPtr)) || type.Equals(typeof(Single)) ||
           type.Equals(typeof(Double)) || type.Equals(typeof(Character)) ||
           type.Equals(typeof(RuntimeTypeHandle)) {
            return Failure(JsonError.UnsupportedMapping("Unsupported scalar type"))
        }
        if type is NominalTypeInfo nominal {
            if nominal.IsUnionDeclaration {
                return Failure(JsonError.UnsupportedMapping("Nominal unions require an explicit JSON mapping"))
            }
        }
        if (type.IsValueType && (!type.IsNominalType || type.IsEnum || type.IsUnion)) || type.IsInterface || type.IsArray || type.IsByRef || type.IsPointer || type.IsOpen || type.GenericArgumentCount != 0 {
            return Failure(JsonError.UnsupportedMapping("Expected a scalar, typed array or nongeneric object record"))
        }
        return Ok(())
    }

    private static func CheckProperty(property: PropertyInfo) -> Result<unit, JsonError> {
        if property.GetIndexParameters().Count != 0 {
            return Failure(JsonError.UnsupportedMapping("Indexed property: " + property.Name))
        }
        return CheckType(property.PropertyType)
    }

    static func Write(value: Object) -> Result<JsonValue, JsonError> {
        return WriteValue(value, value.GetType(), 0)
    }

    private static func WriteValue(value: Object?, type: TypeInfo, depth: int) -> Result<JsonValue, JsonError> {
        _ = CheckType(type)?
        let present: Object = value ?? return Failure(JsonError.UnsupportedMapping("Null mapped value"))
        if IsNodeType(type) {
            if present is JsonValue node {
                if MatchesNode(node, type) {
                    // The final writer validates the whole mixed tree, including
                    // node depth, occurrences, cycles and encoded byte limits.
                    return Ok(node)
                }
            }
            return Failure(JsonError.TypeMismatch("declared JSON node kind"))
        }
        let collection = neoCLR.Runtime.ReflectionCollectionKind(type)
        let actual = present.GetType()
        if collection != 0 {
            if neoCLR.Runtime.ReflectionCollectionKind(actual) != collection ||
               !actual.GetGenericArgument(collection - 1).Equals(type.GetGenericArgument(collection - 1)) {
                return Failure(JsonError.UnsupportedMapping("Incompatible collection value"))
            }
        } else if !actual.Equals(type) {
            return Failure(JsonError.UnsupportedMapping("Polymorphic mapped value"))
        }
        if present is string text {
            return Ok(JsonString(text))
        }
        if present is int number {
            let scalar = JsonNumber.Parse(number.ToString())?
            return Ok(scalar)
        }
        if present is bool flag {
            return Ok(JsonBoolean(flag))
        }
        if depth >= 4 {
            return Failure(JsonError.LimitExceeded("Container depth exceeds four (or cyclic graph)"))
        }
        if collection != 0 {
            let element = type.GetGenericArgument(collection - 1)
            let count = neoCLR.Runtime.ReflectionCollectionCount(type, present)
            if count > 31 {
                return Failure(JsonError.LimitExceeded("Collection exceeds 31 items"))
            }
            if collection == 1 {
                let sequence = JsonArray()
                for index in 0..count {
                    let item = neoCLR.Runtime.ReflectionCollectionGet(type, present, index)
                    let child = WriteValue(item, element, depth + 1)?
                    _ = sequence.Add(child)?
                }
                return Ok(sequence)
            }
            let map = JsonObject()
            for index in 0..count {
                let key = neoCLR.Runtime.ReflectionCollectionKey(type, present, index)
                let item = neoCLR.Runtime.ReflectionCollectionGet(type, present, index)
                let child = WriteValue(item, element, depth + 1)?
                _ = map.Add(key, child)?
            }
            return Ok(map)
        }
        if type.IsArray {
            let Some(element) = type.GetElementType() else {
                return Failure(JsonError.UnsupportedMapping("Missing array element type"))
            }
            let count = ArrayReflection.GetLength(present)
            if count > 31 {
                return Failure(JsonError.LimitExceeded("Array exceeds 31 items"))
            }
            let array = JsonArray()
            for index in 0..count {
                let child = ArrayReflection.GetValue(present, index)
                let node = WriteValue(child, element, depth + 1)?
                _ = array.Add(node)?
            }
            return Ok(array)
        }
        let document = JsonObject()
        for property in type.GetProperties() {
            if !property.IsStatic && property.GetGetMethod() is Some(_) {
                _ = CheckProperty(property)?
                let item: Object? = match property.GetValue(present) {
                    Ok(let content) => content
                    Failure(let reason) => return Failure(JsonError.Reflection(reason))
                }
                let node = WriteValue(item, property.PropertyType, depth + 1)?
                _ = document.Add(property.Name, node)?
            }
        }
        return Ok(document)
    }

    static func Read(value: JsonValue, [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] type: TypeInfo) -> Result<Object, JsonError> {
        // Validate the entire input tree before executing any model user code.
        _ = ReadValue(value, type, 0, 0)?
        return ReadValue(value, type, 0, 1)
    }

    // Pass 0 validates; pass 1 constructs. Integer mode avoids the current bridge
    // limitation on Boolean conversions at multi-argument private calls.
    private static func ReadValue(value: JsonValue, [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] type: TypeInfo, depth: int, construct: int) -> Result<Object, JsonError> {
        _ = CheckType(type)?
        if IsNodeType(type) {
            if MatchesNode(value, type) {
                return Ok(value)
            }
            return Failure(JsonError.TypeMismatch("declared JSON node kind"))
        }
        if type.Equals(typeof(string)) {
            if value is JsonString text {
                return Ok(text.Value)
            }
            return Failure(JsonError.TypeMismatch("string"))
        }
        if type.Equals(typeof(int)) {
            if value is JsonNumber number {
                let parsed = number.AsInt32()?
                return Ok(parsed)
            }
            return Failure(JsonError.TypeMismatch("Int32"))
        }
        if type.Equals(typeof(bool)) {
            if value is JsonBoolean flag {
                return Ok(flag.Value)
            }
            return Failure(JsonError.TypeMismatch("Boolean"))
        }
        if type.IsValueType {
            return Failure(JsonError.UnsupportedMapping("Value-record deserialization requires constructor mapping"))
        }
        if depth >= 4 {
            return Failure(JsonError.LimitExceeded("Container depth exceeds four"))
        }
        let collection = neoCLR.Runtime.ReflectionCollectionKind(type)
        if collection != 0 {
            let element = type.GetGenericArgument(collection - 1)
            if collection == 1 {
                if value is JsonArray sequence {
                    let items = CheckedStorage.Reserve<Object>(sequence.Count)
                    for index in 0..sequence.Count {
                        let child = sequence.Item(index)?
                        let mapped = ReadValue(child, element, depth + 1, construct)?
                        items[index] = mapped
                    }
                    if construct == 0 {
                        return Ok(sequence)
                    }
                    return Ok(neoCLR.Runtime.ReflectionCollectionCreate(type, items, []))
                }
                return Failure(JsonError.TypeMismatch("array"))
            }
            if value is JsonObject map {
                let items = CheckedStorage.Reserve<Object>(map.Count)
                let keys = CheckedStorage.Reserve<string>(map.Count)
                for index in 0..map.Count {
                    let key = map.Name(index)?
                    let child = map.Item(index)?
                    let mapped = ReadValue(child, element, depth + 1, construct)?
                    keys[index] = key
                    items[index] = mapped
                }
                if construct == 0 {
                    return Ok(map)
                }
                return Ok(neoCLR.Runtime.ReflectionCollectionCreate(type, items, keys))
            }
            return Failure(JsonError.TypeMismatch("object"))
        }
        if type.IsArray {
            let Some(element) = type.GetElementType() else {
                return Failure(JsonError.UnsupportedMapping("Missing array element type"))
            }
            if value is JsonArray array {
                let items = CheckedStorage.Reserve<Object>(array.Count)
                for index in 0..array.Count {
                    let child = array.Item(index)?
                    let mapped = ReadValue(child, element, depth + 1, construct)?
                    items[index] = mapped
                }
                if construct == 0 {
                    return Ok(array)
                }
                return Ok(ArrayReflection.Create(type, items))
            }
            return Failure(JsonError.TypeMismatch("array"))
        }
        if value is JsonObject document {
            let properties = ArrayList<PropertyInfo>()
            let values = ArrayList<Object>()
            for property in type.GetProperties() {
                if !property.IsStatic && property.GetSetMethod() is Some(_) {
                    _ = CheckProperty(property)?
                    let item = document.Field(property.Name)?
                    let mapped = ReadValue(item, property.PropertyType, depth + 1, construct)?
                    values.Add(mapped)
                    properties.Add(property)
                }
            }
            if construct == 0 {
                return Ok(document)
            }
            let instance = match type.CreateInstance() {
                Ok(let created) => created
                Failure(let reason) => return Failure(JsonError.Reflection(reason))
            }
            for index in 0..properties.Count {
                if let Failure(reason) = properties[index].SetValue(instance, values[index]) {
                    return Failure(JsonError.Reflection(reason))
                }
            }
            return Ok(instance)
        }
        return Failure(JsonError.TypeMismatch("object"))
    }
}
