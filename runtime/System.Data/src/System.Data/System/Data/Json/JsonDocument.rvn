module System.Data.Json

import System.*
import System.Collections.*
import System.Result.*
import System.Text.*

internal class DocumentReader {
    private var position: int
    private val options: JsonDocumentOptions
    private val maxDepth: int

    init(options: JsonDocumentOptions) {
        self.options = options
        maxDepth = if options.MaxDepth == 0 { 64 } else { options.MaxDepth }
        position = 0
    }

    static func Validate(options: JsonDocumentOptions) -> Result<unit, JsonError> {
        if options.MaxDepth < 0 {
            return Failure(JsonError.InvalidOptions("MaxDepth must be non-negative"))
        }
        if options.CommentHandling != JsonCommentHandling.Disallow && options.CommentHandling != JsonCommentHandling.Skip {
            return Failure(JsonError.InvalidOptions("Document comments must be Disallow or Skip"))
        }
        return Ok(())
    }

    private func Skip(bytes: ReadOnlySlice<byte>) -> Result<unit, JsonError> {
        let length = bytes.Length
        while position < length {
            if JsonSyntax.Whitespace(bytes[position]) {
                position += 1
            } else if options.CommentHandling == JsonCommentHandling.Skip && bytes[position] == 47 && length - position >= 2 {
                let next = bytes[position + 1]
                if next == 47 {
                    position += 2
                    while position < length && bytes[position] != 10 && bytes[position] != 13 {
                        position += 1
                    }
                } else if next == 42 {
                    position += 2
                    var closed = false
                    while length - position >= 2 && !closed {
                        if bytes[position] == 42 && bytes[position + 1] == 47 {
                            position += 2
                            closed = true
                        } else {
                            position += 1
                        }
                    }
                    if !closed {
                        return Failure(JsonError.Syntax("Unclosed comment"))
                    }
                } else {
                    return Ok(())
                }
            } else {
                return Ok(())
            }
        }
        return Ok(())
    }

    private func Take(bytes: ReadOnlySlice<byte>, value: byte) -> Result<bool, JsonError> {
        _ = Skip(bytes)?
        if position < bytes.Length && bytes[position] == value {
            position += 1
            return Ok(true)
        }
        return Ok(false)
    }

    private func DecodeToken(bytes: ReadOnlySlice<byte>) -> Result<string, JsonError> {
        return JsonSyntax.DecodeUtf8(bytes)
    }

    private func ReadString(bytes: ReadOnlySlice<byte>) -> Result<string, JsonError> {
        let length = bytes.Length
        _ = Skip(bytes)?
        let start = position
        if !(Take(bytes, (byte)34)?) {
            return Failure(JsonError.Syntax("Expected string"))
        }
        var escaped = false
        var needsDecoding = false
        while position < length {
            let value = bytes[position]
            position += 1
            if escaped {
                escaped = false
            } else if value == 92 {
                escaped = true
                needsDecoding = true
            } else if value == 34 {
                if !needsDecoding {
                    return DecodeToken(bytes.Slice(start + 1, position - start - 2))
                }
                return MessageReader().Read(bytes.Slice(start, position - start), position - start)
            } else if value <= 31 {
                needsDecoding = true
            }
        }
        return Failure(JsonError.Syntax("Unclosed string"))
    }

    private func Value(bytes: ReadOnlySlice<byte>, depth: int) -> Result<JsonValue, JsonError> {
        let length = bytes.Length
        _ = Skip(bytes)?
        if position == length {
            return Failure(JsonError.Syntax("Missing value"))
        }
        let first = bytes[position]
        if first == 34 {
            let text = ReadString(bytes)?
            let value: JsonValue = JsonString(text)
            return Ok(value)
        }
        if first == 123 || first == 91 {
            if depth >= maxDepth {
                return Failure(JsonError.LimitExceeded("Container depth exceeds MaxDepth"))
            }
            position += 1
            let objectValue = first == 123
            var result: JsonValue = JsonArray()
            var closing = (byte)93
            if objectValue {
                result = JsonObject()
                closing = (byte)125
            }
            var containerClosed = Take(bytes, closing)?
            while !containerClosed {
                var name = ""
                if objectValue {
                    name = ReadString(bytes)?
                    if !(Take(bytes, (byte)58)?) {
                        return Failure(JsonError.Syntax("Expected colon"))
                    }
                }
                let child = Value(bytes, depth + 1)?
                if objectValue {
                    _ = ((JsonObject)result).Add(name, child)?
                } else {
                    _ = ((JsonArray)result).Add(child)?
                }
                containerClosed = Take(bytes, closing)?
                if !containerClosed {
                    if !(Take(bytes, (byte)44)?) {
                        return Failure(JsonError.Syntax("Expected comma or container end"))
                    }
                    if options.AllowTrailingCommas {
                        containerClosed = Take(bytes, closing)?
                    }
                }
            }
            return Ok(result)
        }
        let start = position
        var tokenEnd = false
        while position < length && !tokenEnd {
            let value = bytes[position]
            tokenEnd = (JsonSyntax.Whitespace(value) || value == 44 || value == 93 || value == 125 || value == 47)
            if !tokenEnd {
                position += 1
            }
        }
        let tokenLength = position - start
        let token = bytes.Slice(start, tokenLength)
        if tokenLength == 4 && JsonSyntax.TokenEquals(token, "true") {
            let value: JsonValue = JsonBoolean(true)
            return Ok(value)
        }
        if tokenLength == 5 && JsonSyntax.TokenEquals(token, "false") {
            let value: JsonValue = JsonBoolean(false)
            return Ok(value)
        }
        if tokenLength == 4 && JsonSyntax.TokenEquals(token, "null") {
            let value: JsonValue = JsonNull()
            return Ok(value)
        }
        let number = JsonNumber.Parse(DecodeToken(token)?)?
        let numericValue: JsonValue = number
        return Ok(numericValue)
    }

    func Read(bytes: ReadOnlySlice<byte>) -> Result<JsonValue, JsonError> {
        let result = Value(bytes, 0)?
        _ = Skip(bytes)?
        if position != bytes.Length {
            return Failure(JsonError.Syntax("Trailing content"))
        }
        return Ok(result)
    }
}

internal class DocumentWriter {
    private var nodes: int
    private var output: byte[] = System.Runtime.CompilerServices.CheckedStorage.Reserve<byte>(0)
    private var size: int = 0
    private val indented: bool

    init(indented: bool) {
        self.indented = indented
        nodes = 0
    }

    private func Reserve(count: int) {
        if count <= output.Length - size {
            return
        }
        var capacity = 32
        if output.Length > 0 {
            capacity = output.Length * 2
        }
        if capacity < size + count {
            capacity = size + count
        }
        if capacity > 1024 {
            capacity = 1024
        }
        let grown = System.Runtime.CompilerServices.CheckedStorage.Reserve<byte>(capacity)
        var index = 0
        while index < size {
            grown[index] = output[index]
            index += 1
        }
        output = grown
    }

    private func Append(text: string) -> Result<unit, JsonError> {
        if text.GetUtf8ByteCount() > 1024 - size {
            return Failure(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        let bytes = text.Utf8Bytes
        Reserve(bytes.Length)
        var index = 0
        while index < bytes.Length {
            output[size] = bytes[index]
            size += 1
            index += 1
        }
        return Ok(())
    }

    private func Hex(value: int) -> byte {
        return (byte)(if value < 10 { 48 + value } else { 87 + value })
    }

    private func AppendMessage(text: string) -> Result<unit, JsonError> {
        if text.GetUtf8ByteCount() > 1022 {
            return Failure(JsonError.LimitExceeded("Message exceeds payload limit"))
        }
        let bytes = text.Utf8Bytes
        var count = 2
        var index = 0
        while index < bytes.Length {
            let value = bytes[index]
            count += if value <= 31 { 6 } else if value == 34 || value == 92 { 2 } else { 1 }
            if count > 1024 {
                return Failure(JsonError.LimitExceeded("Escaped message exceeds payload limit"))
            }
            index += 1
        }
        if count > 1024 - size {
            return Failure(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        Reserve(count)
        output[size] = (byte)34
        size += 1
        index = 0
        while index < bytes.Length {
            let value = bytes[index]
            if value == 34 || value == 92 {
                output[size] = (byte)92
                output[size + 1] = value
                size += 2
            } else if value <= 31 {
                output[size] = (byte)92
                output[size + 1] = (byte)117
                output[size + 2] = (byte)48
                output[size + 3] = (byte)48
                output[size + 4] = Hex(value / 16)
                output[size + 5] = Hex(value % 16)
                size += 6
            } else {
                output[size] = value
                size += 1
            }
            index += 1
        }
        output[size] = (byte)34
        size += 1
        return Ok(())
    }

    private func AppendByte(value: byte) -> Result<unit, JsonError> {
        if size == 1024 {
            return Failure(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        Reserve(1)
        output[size] = value
        size += 1
        return Ok(())
    }

    private func Line(depth: int) -> Result<unit, JsonError> {
        if indented {
            _ = AppendByte((byte)10)?
            for index in 0..depth {
                _ = AppendByte((byte)32)?
                _ = AppendByte((byte)32)?
            }
        }
        return Ok(())
    }

    private func Value(value: JsonValue, depth: int) -> Result<unit, JsonError> {
        nodes += 1
        if nodes > 32 {
            return Failure(JsonError.LimitExceeded("Document exceeds 32 values"))
        }
        if value is JsonString {
            let text = ((JsonString)value).Value
            return AppendMessage(text)
        }
        if value is JsonNumber {
            let text = ((JsonNumber)value).Text
            return Append(text)
        }
        if value is JsonBoolean {
            let truth = ((JsonBoolean)value).Value
            if truth {
                return Append("true")
            }
            return Append("false")
        }
        if value is JsonNull {
            return Append("null")
        }
        if depth >= 4 {
            return Failure(JsonError.LimitExceeded("Container depth exceeds four (or cyclic tree)"))
        }
        let objectValue = value is JsonObject
        if objectValue {
            _ = AppendByte((byte)123)?
        } else {
            _ = AppendByte((byte)91)?
        }
        var count = 0
        if objectValue {
            count = ((JsonObject)value).Count
        } else {
            count = ((JsonArray)value).Count
        }
        for index in 0..count {
            if index > 0 {
                _ = AppendByte((byte)44)?
            }
            _ = Line(depth + 1)?
            if objectValue {
                let name = ((JsonObject)value).Name(index)?
                _ = AppendMessage(name)?
                _ = AppendByte((byte)58)?
                if indented {
                    _ = AppendByte((byte)32)?
                }
            }
            let child = if objectValue {
                ((JsonObject)value).Item(index)?
            } else {
                ((JsonArray)value).Item(index)?
            }
            _ = Value(child, depth + 1)?
        }
        if count > 0 {
            _ = Line(depth)?
        }
        if objectValue {
            return AppendByte((byte)125)
        }
        return AppendByte((byte)93)
    }

    func Write(value: JsonValue) -> Result<string, JsonError> {
        _ = Value(value, 0)?
        return match Encodings.Utf8.Decode(output[..size]) {
            Ok(let text) => Ok(text)
            Failure(_) => Failure(JsonError.Syntax("Invalid UTF-8"))
        }
    }

    func WriteBytes(value: JsonValue) -> Result<byte[], JsonError> {
        _ = Value(value, 0)?
        return Ok(output[..size].ToArray())
    }
}
