module System.IO

import System.*
import System.Collections.*
import System.Concurrency.*
import System.Result.*
import System.Optional.*
import System.Runtime.CompilerServices.*
import System.Text.*
import System.Time.*

/// Recoverable watcher setup, transport and notification-loss errors.
public enum FileSystemWatcherError {
    InvalidPath = 1
    NotFound = 2
    AccessDenied = 3
    IoFailure = 4
    Closed = 5
    BufferOverflow = 6
    InvalidEncoding = 7
    PlatformNotSupported = 8
    ResourceLimit = 9
}

/// A physical path within a watched root. The full path is derived from the root and Name.
public class FileSystemChange {
    private val root: string
    val Name: string
    val FullPath: string => root + Name

    internal init(root: string, name: string) {
        if root.IsEmpty || root.ContainsOrdinal("\u0000") || name.IsEmpty || name.ContainsOrdinal("\u0000") {
            Panic("Invalid filesystem notification path")
        }
        let separator = if root.EndsWithOrdinal("\\") { "\\" } else { "/" }
        if !root.EndsWithOrdinal(separator) || name.StartsWithOrdinal(separator) ||
            name == "." || name == ".." || name.StartsWithOrdinal("." + separator) ||
            name.StartsWithOrdinal(".." + separator) || name.EndsWithOrdinal(separator + ".") ||
            name.EndsWithOrdinal(separator + "..") || name.ContainsOrdinal(separator + "." + separator) ||
            name.ContainsOrdinal(separator + ".." + separator) {
            Panic("Invalid filesystem notification relative name")
        }
        if name.EndsWithOrdinal(separator) || name.ContainsOrdinal(separator + separator) {
            Panic("Invalid filesystem notification path")
        }
        self.root = root
        Name = name
    }
    internal func SharesRoot(other: FileSystemChange) -> bool => root == other.root
}

/// Both paths of a known rename; ordinary changes cannot carry rename-only data.
public class FileSystemRename {
    val OldPath: FileSystemChange
    val NewPath: FileSystemChange

    internal init(oldPath: FileSystemChange, newPath: FileSystemChange) {
        if !oldPath.SharesRoot(newPath) {
            Panic("Rename paths must share a watched root")
        }
        OldPath = oldPath
        NewPath = newPath
    }
}

/// Watches a physical directory using the OS provider. Access and callbacks are owner-queue serialized.
/// Dispose explicitly to stop the timer and release the native subscription. No finalizer is supplied.
public class FileSystemWatcher : Disposable {
    private var path: string
    private var filter: string
    private var recursive = false
    private var handle = 0L
    private var disposed = false
    private var timer: Timer? = null
    private val notifications = FileWatchHandlers()

    /// Creates a stopped watcher for all names in path.
    init(path: string) { self.path = path; filter = "*" }
    /// Creates a stopped watcher with a filename filter supporting * and ?.
    init(path: string, filter: string) { self.path = path; self.filter = filter }

    /// Physical directory path. Change settings while stopped; relative paths resolve at Start.
    var Path: string {
        get => path
        set { CheckStopped(); path = value }
    }
    /// Basename pattern (* and ?), compared ordinally; Windows ignores case. Empty means *.
    var Filter: string {
        get => filter
        set { CheckStopped(); filter = value }
    }
    /// Whether descendants are watched. Defaults to false; change while stopped.
    var IncludeSubdirectories: bool {
        get => recursive
        set { CheckStopped(); recursive = value }
    }
    /// Starts or stops notifications. Start failures panic; TryStart preserves typed errors.
    var EnableRaisingEvents: bool {
        get => handle != 0L
        set {
            if value {
                if TryStart() is Failure(_) { Panic("Unable to start FileSystemWatcher; use TryStart for diagnostics") }
            } else { Stop() }
        }
    }

    /// Subscribes to all notifications. Dispose the registration to release its callback.
    /// The union case determines the payload; rescan notifications never fabricate a change.
    func Subscribe(callback: (FileSystemNotification) -> Void) -> Disposable {
        if disposed {
            Panic("FileSystemWatcher is disposed")
        }
        return notifications.Add(callback)
    }

    /// Starts watching before returning. Repeated starts are harmless; disposal returns Closed.
    /// Notifications run on the invocation completion queue, at most 64 per 50 ms timer tick.
    func TryStart() -> Result<unit, FileSystemWatcherError> {
        if disposed { return Failure(FileSystemWatcherError.Closed) }
        if handle != 0L { return Ok(()) }
        if path.IsEmpty || path.ContainsOrdinal("\u0000") || filter.ContainsOrdinal("\u0000") || filter.ContainsOrdinal("/") || filter.ContainsOrdinal("\\") {
            return Failure(FileSystemWatcherError.InvalidPath)
        }
        var recurse = 0
        if recursive { recurse = 1 }
        let opened = neoCLR.Runtime.FileWatch(0, path, filter, 0L, recurse)
        if neoCLR.Runtime.IsValue<byte>(opened) {
            return Failure((FileSystemWatcherError)(int)neoCLR.Runtime.UnpackValue<byte>(opened))
        }
        let next = neoCLR.Runtime.UnpackValue<long>(opened)
        handle = next
        let schedule = Timer(Poll)
        timer = schedule
        schedule.Start(Duration.FromTicks(500000L), Duration.FromTicks(500000L))
        return Ok(())
    }

    /// Stops delivery and releases the native subscription. Pending notifications are discarded.
    func Stop() {
        let schedule = timer
        timer = null
        if schedule is Timer current { current.Dispose() }
        let previous = handle
        handle = 0L
        if previous != 0L { _ = neoCLR.Runtime.FileWatch(2, "", "", previous, 0) }
    }
    /// Stops permanently, releasing subscriptions and handlers. Idempotent.
    func Dispose() {
        if disposed { return }
        disposed = true
        Stop()
        notifications.Clear()
    }
    private func CheckStopped() {
        if disposed { Panic("FileSystemWatcher is disposed") }
        if handle != 0L { Panic("Stop FileSystemWatcher before changing settings") }
    }
    private func Poll() {
        let generation = handle
        var count = 0
        while handle == generation && handle != 0L && count < 64 {
            let packet = ReadPacket(generation)
            if packet.Length == 0 { return }
            if packet[0] == 0 {
                notifications.Invoke(FileSystemNotification.RescanRequired((FileSystemWatcherError)(int)packet[1]))
                return
            }
            var fields = ArrayList<string>()
            var start = 1
            var index = 1
            while index < packet.Length {
                if packet[index] == 0 {
                    let bytes: ReadOnlySlice<byte> = packet
                    let text = match Encodings.Utf8.Decode(bytes.Slice(start, index - start)) {
                        Ok(let value) => value
                        Failure(_) => { notifications.Invoke(FileSystemNotification.RescanRequired(FileSystemWatcherError.InvalidEncoding)); return }
                    }
                    fields.Add(text)
                    start = index + 1
                }
                index += 1
            }
            if fields.Count != 4 { Panic("Invalid file watcher provider packet") }
            let change = DecodePath(fields[0], fields[1])
            let notification = match (int)packet[0] {
                1 => FileSystemNotification.Created(change)
                2 => FileSystemNotification.Deleted(change)
                4 => FileSystemNotification.Changed(change)
                8 => FileSystemNotification.Renamed(FileSystemRename(DecodePath(fields[2], fields[3]), change))
                _ => { Panic("Invalid file watcher notification kind") }
            }
            notifications.Invoke(notification)
            count += 1
        }
    }
    // The trusted OS provider supplies canonical absolute paths and root-relative names.
    // Verify their relationship once; never retain two independently supplied path strings.
    private func DecodePath(fullPath: string, name: string) -> FileSystemChange {
        if name.IsEmpty || !fullPath.EndsWithOrdinal(name) || fullPath.Length <= name.Length {
            Panic("Invalid file watcher path pair")
        }
        let root = fullPath[..(fullPath.Length - name.Length)]
        if !root.EndsWithOrdinal("/") && !root.EndsWithOrdinal("\\") {
            Panic("Invalid file watcher root")
        }
        return FileSystemChange(root, name)
    }
    private func ReadPacket(current: long) -> byte[] {
        let payload = neoCLR.Runtime.FileWatch(1, "", "", current, 0)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return [(byte)0, neoCLR.Runtime.UnpackValue<byte>(payload)]
        }
        let text = neoCLR.Runtime.UnpackValue<string>(payload)
        return neoCLR.Runtime.Utf8Encode(text)
    }
}

internal class FileWatchHandlers {
    private var handlers = ArrayList<FileWatchRegistration>()
    internal func Add(callback: (FileSystemNotification) -> Void) -> Disposable {
        let next = ArrayList<FileWatchRegistration>()
        for handler in handlers {
            if handler.IsActive { next.Add(handler) }
        }
        let registration = FileWatchRegistration(callback)
        next.Add(registration)
        handlers = next
        return registration
    }
    internal func Clear() {
        for handler in handlers { handler.Dispose() }
        handlers = ArrayList<FileWatchRegistration>()
    }
    internal func Invoke(notification: FileSystemNotification) {
        let snapshot = handlers
        for callback in snapshot { callback.Invoke(notification) }
    }
}

internal class FileWatchRegistration : Disposable {
    private var callback: Optional<(FileSystemNotification) -> Void>
    init(callback: (FileSystemNotification) -> Void) { self.callback = Some(callback) }
    internal val IsActive: bool => callback is Some(_)
    internal func Invoke(notification: FileSystemNotification) {
        let current = callback
        if current is Some(let invoke) { invoke(notification) }
    }
    func Dispose() { callback = None }
}
