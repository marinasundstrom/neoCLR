module System.IO

import System.*
import System.Result.*
import System.Text.*
import System.Runtime.CompilerServices.*

/// <summary>Synchronous buffered text output with explicit stream ownership.</summary>
public class SyncStreamWriter : SyncTextWriter {
    /// <summary>String appended by WriteLine. Defaults to LF; an empty string appends nothing.</summary>
    /// <remarks>Each operation snapshots this setting before transferring bytes.</remarks>
    var NewLine: string { get; set; } = "\n"

    private init(output: SyncOutputStream, encoding: Encoding, leaveOpen: bool) {
        self.output = output
        encoder = encoding.CreateEncoder()
        self.leaveOpen = leaveOpen
    }

    /// <summary>Creates a synchronous text wrapper using UTF-8, without transferring bytes.</summary>
    static func Create(output: SyncOutputStream) -> Result<SyncStreamWriter, StreamError> {
        return Create(output, Encodings.Utf8, false)
    }

    /// <summary>Creates a UTF-8 wrapper with explicit ownership of the underlying stream.</summary>
    static func Create(output: SyncOutputStream, leaveOpen: bool) -> Result<SyncStreamWriter, StreamError> {
        return Create(output, Encodings.Utf8, leaveOpen)
    }

    /// <summary>Creates a wrapper using the supplied encoding without transferring bytes.</summary>
    static func Create(output: SyncOutputStream, encoding: Encoding) -> Result<SyncStreamWriter, StreamError> {
        return Create(output, encoding, false)
    }

    /// <summary>Creates a wrapper with the supplied encoding and ownership policy.</summary>
    /// <remarks>Current initialization is infallible for valid providers; decoding and I/O errors occur during operations.
    /// No input is read or output written. Use one buffering wrapper per stream direction.</remarks>
    static func Create(output: SyncOutputStream, encoding: Encoding, leaveOpen: bool) -> Result<SyncStreamWriter, StreamError> {
        return Ok(SyncStreamWriter(output, encoding, leaveOpen))
    }

    /// <summary>Encodes and writes text; returns the number of encoded bytes.</summary>
    func Write(text: string) -> Result<int, StreamError> => Run(text, false, false)

    /// <summary>Encodes and writes text followed by NewLine; returns the encoded byte count.</summary>
    func WriteLine(text: string) -> Result<int, StreamError> => Run(text, true, false)

    /// <summary>Finalizes encoding. Repeated successful finalization returns zero.</summary>
    func Finish() -> Result<int, StreamError> => Run("", false, true)

    private val output: SyncOutputStream
    private var leaveOpen: bool
    private var encoder: Encoder
    private var closed: bool = false
    private var finished: bool = false
    private var failed: bool = false
    private var finishing: bool = false
    private val operation: TextIOOperation = TextIOOperation(true)
    private val buffer: byte[] = CheckedStorage.Reserve<byte>(256)

    private func Begin() -> Result<unit, StreamError> {
        if closed {
            return Failure(StreamError.Closed)
        }
        if operation.Active {
            return Failure(StreamError.Busy)
        }
        operation.Begin()
        return Ok(())
    }

    private func Prepare(text: string, line: bool, final: bool) -> Result<unit, StreamError> {
        if failed || operation.WasAbandoned || finished {
            return Failure(StreamError.InvalidEncoding)
        }
        let ending = if line { NewLine } else { "" }
        let endingBytes = ending.Utf8Bytes.Length
        if endingBytes > 65536 || text.Utf8Bytes.Length > 65536 - endingBytes {
            return Failure(StreamError.LimitExceeded)
        }
        let content = if ending.IsEmpty { text } else { text + ending }
        match encoder.Accept(content, final) {
            Ok(_) => { }
            Failure(EncodingError.LimitExceeded) => return Failure(StreamError.LimitExceeded)
            Failure(_) => return Failure(StreamError.InvalidEncoding)
        }
        finishing = final
        return Ok(())
    }

    private func Drain(total: int) -> Result<EncoderProgress, StreamError> {
        let step = match encoder.Drain(buffer) {
            Ok(let value) => value
            Failure(_) => {
                failed = true
                return Failure(StreamError.InvalidEncoding)
            }
        }
        if !(step.BytesWritten >= 0) || step.BytesWritten > buffer.Length {
            System.Fail("Invalid encoder byte count")
        }
        if step.BytesWritten > 65536 - total {
            failed = true
            return Failure(StreamError.LimitExceeded)
        }
        return Ok(step)
    }

    private func Run(text: string, line: bool, final: bool) -> Result<int, StreamError> {
        match Begin() {
            Ok(_) => { }
            Failure(let error) => return Failure(error)
        }
        use lease = operation
        let result = WriteCore(text, line, final)
        operation.Complete()
        return result
    }

    private func WriteCore(text: string, line: bool, final: bool) -> Result<int, StreamError> {
        if final && finished && !failed && !operation.WasAbandoned {
            return Ok(0)
        }
        match Prepare(text, line, final) {
            Ok(_) => { }
            Failure(let error) => return Failure(error)
        }
        return Pump()
    }

    private func Pump() -> Result<int, StreamError> {
        if output is SyncOutputStream destination {
            var total = 0
            while true {
                let step = match Drain(total) {
                    Ok(let value) => value
                    Failure(let error) => return Failure(error)
                }
                let result = destination.Write(buffer[..step.BytesWritten])
                if closed {
                    failed = true
                    return Failure(StreamError.Closed)
                }
                match result {
                    Ok(_) => total += step.BytesWritten
                    Failure(let error) => {
                        failed = true
                        return Failure(error)
                    }
                }
                if TextWriteSupport.CompleteStep(step, finishing) {
                    match step.State {
                        EncoderState.Finished => { finished = true }
                        _ => { }
                    }
                    return Ok(total)
                }
            }
            return Failure(StreamError.IoFailure)

        }
        return Failure(StreamError.WrongAccess)
    }

    /// <summary>Flushes the underlying output without finalizing the encoder.</summary>
    func Flush() -> Result<unit, StreamError> {
        match Begin() {
            Ok(_) => { }
            Failure(let error) => return Failure(error)
        }
        use lease = operation
        if output is SyncOutputStream destination {
            let result = destination.Flush()
            operation.Complete()
            if closed {
                return Failure(StreamError.Closed)
            }
            return result
        }
        operation.Complete()
        return Failure(StreamError.WrongAccess)
    }

    /// <summary>Closes this wrapper and its output unless leaveOpen was selected. Does not flush or finish.</summary>
    func Close() {
        if !closed {
            closed = true
            if !leaveOpen {
                output.Close()
            }
        }
    }
}
