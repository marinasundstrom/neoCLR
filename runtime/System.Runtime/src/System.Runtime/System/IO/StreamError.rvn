module System.IO

import System.Error

public union StreamError : Error {
    /// A human-readable case description; use patterns to classify this failure.
    val Message: string => ToString()

    /// Leaf failures have no underlying cause.
    val Cause: System.Optional<Error> => System.Optional<Error>.None

    /// Leaf failures do not capture stacks implicitly.
    val StackTrace: System.Optional<System.Diagnostics.StackTrace> => System.Optional<System.Diagnostics.StackTrace>.None

    case InvalidPath
    case NotFound
    case AccessDenied
    case WrongKind
    case AlreadyExists
    case Closed
    case InvalidRange
    case LimitExceeded
    case WrongAccess
    case IoFailure
    case InvalidEncoding
    /// Malformed or truncated binary content, including gzip checksum and format failures.
    case InvalidData

    /// Another text write, flush or finalization is pending.
    case Busy

    override func ToString() -> string {
        return match self {
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            WrongKind => "WrongKind"
            AlreadyExists => "AlreadyExists"
            Closed => "Closed"
            InvalidRange => "InvalidRange"
            LimitExceeded => "LimitExceeded"
            WrongAccess => "WrongAccess"
            InvalidData => "InvalidData"
            InvalidEncoding => "InvalidEncoding"
            IoFailure => "IoFailure"
            Busy => "Busy"
            _ => "Empty"
        }
    }
}
