module System.IO

import System.*
import System.Collections.*
import System.Result.*
import System.Optional.*
import System.Text.*
import System.Runtime.CompilerServices.*

/// <summary>Synchronous buffered text input with explicit stream ownership.</summary>
public class SyncStreamReader : SyncTextReader {
    /// <summary>Exact nonempty line delimiter, removed from ReadLine results. Defaults to LF.</summary>
    /// <remarks>Each operation snapshots this setting before transferring bytes.</remarks>
    var NewLine: string { get; set; } = "\n"

    private init(input: SyncInputStream, encoding: Encoding, leaveOpen: bool) {
        self.input = input
        decoder = encoding.CreateDecoder()
        self.leaveOpen = leaveOpen
    }

    /// <summary>Creates a synchronous text wrapper using UTF-8, without transferring bytes.</summary>
    static func Create(input: SyncInputStream) -> Result<SyncStreamReader, TextReadError> {
        return Create(input, Encodings.Utf8, false)
    }

    /// <summary>Creates a UTF-8 wrapper with explicit ownership of the underlying stream.</summary>
    static func Create(input: SyncInputStream, leaveOpen: bool) -> Result<SyncStreamReader, TextReadError> {
        return Create(input, Encodings.Utf8, leaveOpen)
    }

    /// <summary>Creates a wrapper using the supplied encoding without transferring bytes.</summary>
    static func Create(input: SyncInputStream, encoding: Encoding) -> Result<SyncStreamReader, TextReadError> {
        return Create(input, encoding, false)
    }

    /// <summary>Creates a wrapper with the supplied encoding and ownership policy.</summary>
    /// <remarks>Current initialization is infallible for valid providers; decoding and I/O errors occur during operations.
    /// No input is read or output written. Use one buffering wrapper per stream direction.</remarks>
    static func Create(input: SyncInputStream, encoding: Encoding, leaveOpen: bool) -> Result<SyncStreamReader, TextReadError> {
        return Ok(SyncStreamReader(input, encoding, leaveOpen))
    }

    private var lineDelimiter: TextLineDelimiter?

    private val input: SyncInputStream
    private var decoder: Decoder
    private var leaveOpen: bool
    private var closed: bool = false
    private var eof: bool = false
    private var pendingText: string = ""
    private var lastRead: int = 0
    private val operation: TextIOOperation = TextIOOperation(false)
    private var pendingOffset: int = 0
    private var peeked: Optional<Character> = None
    private val readBuffer: byte[] = CheckedStorage.Reserve<byte>(256)

    private func DrainPending() -> string {
        let result = if pendingOffset == 0 {
            pendingText
        } else {
            pendingText[pendingOffset..]
        }
        pendingText = ""
        pendingOffset = 0
        peeked = None
        return result
    }

    private func DecodePart(buffer: byte[], count: int, request: int, remaining: int) -> Result<string, TextReadError> {
        if !(count >= 0) || count > request {
            Panic("Invalid input read count")
        }
        lastRead = count
        if count > remaining {
            return Failure(TextReadError.LimitExceeded)
        }
        if count == 0 {
            eof = true
        }
        let decoded = match decoder.Decode(buffer[..count], eof) {
            Ok(let text) => text
            Failure(EncodingError.InvalidUtf8) => return Failure(TextReadError.InvalidUtf8)
            Failure(EncodingError.LimitExceeded) => return Failure(TextReadError.LimitExceeded)
            Failure(_) => return Failure(TextReadError.InvalidEncoding)
        }
        if decoded.Utf8Bytes.Length > 65536 {
            return Failure(TextReadError.LimitExceeded)
        }
        return Ok(decoded)
    }

    /// <summary>Peeks at the next Unicode grapheme without advancing the text cursor.</summary>
    /// <returns>Some Character, None at EOF, or a decoding, I/O, Busy or limit error.</returns>
    /// <remarks>May read underlying input and retain lookahead. Repeated peeks reuse the cached Character.
    /// A grapheme may require a subsequent boundary or EOF. The maximum grapheme size is 65536 UTF-8 bytes.</remarks>
    func PeekChar() -> Result<Optional<Character>, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if operation.Active {
            return Failure(TextReadError.Busy)
        }
        operation.Begin()
        use lease = operation
        let result = PeekCharCore()
        operation.Complete()
        return result
    }

    /// <summary>Reads one Unicode grapheme and advances the shared text cursor.</summary>
    /// <returns>Some Character, None at EOF, or a decoding, I/O, Busy or limit error.</returns>
    /// <remarks>Shares buffered lookahead with PeekChar, counted reads and line reads.
    /// Counts graphemes rather than UTF-8 bytes or Unicode scalars; maximum 65536 UTF-8 bytes.</remarks>
    func ReadChar() -> Result<Optional<Character>, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if operation.Active {
            return Failure(TextReadError.Busy)
        }
        operation.Begin()
        use lease = operation
        let result = PeekCharCore()
        if result is Ok(Some(_)) {
            pendingOffset += 1
            peeked = None
        }
        operation.Complete()
        return result
    }

    /// <summary>Reads a requested number of graphemes with a separate UTF-8 byte bound.</summary>
    /// <param name="count">Grapheme count, from zero through 65536.</param>
    /// <param name="maxUtf8Bytes">Maximum returned UTF-8 bytes, from zero through 65536.</param>
    /// <returns>The requested text, a shorter remainder at EOF, or TextReadError.</returns>
    /// <remarks>Zero count consumes nothing. Invalid bounds consume nothing. A result-limit error
    /// retains buffered text for retry; decoding/I/O errors do not rewind the source. Concurrent reads return Busy.</remarks>
    func Read(count: int) -> Result<string, TextReadError> {
        return Read(count, 65536)
    }

    /// <summary>Reads a requested number of graphemes with a separate UTF-8 byte bound.</summary>
    /// <param name="count">Grapheme count, from zero through 65536.</param>
    /// <param name="maxUtf8Bytes">Maximum returned UTF-8 bytes, from zero through 65536.</param>
    /// <returns>The requested text, a shorter remainder at EOF, or TextReadError.</returns>
    /// <remarks>Zero count consumes nothing. Invalid bounds consume nothing. A result-limit error
    /// retains buffered text for retry; decoding/I/O errors do not rewind the source. Concurrent reads return Busy.</remarks>
    func Read(count: int, maxUtf8Bytes: int) -> Result<string, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if operation.Active {
            return Failure(TextReadError.Busy)
        }
        if count < 0 || maxUtf8Bytes < 0 {
            return Failure(TextReadError.InvalidRange)
        }
        if count > 65536 || maxUtf8Bytes > 65536 {
            return Failure(TextReadError.LimitExceeded)
        }
        if count == 0 {
            return Ok("")
        }
        operation.Begin()
        use lease = operation
        let result = ReadCore(count, maxUtf8Bytes)
        operation.Complete()
        return result
    }

    private func PeekCharCore() -> Result<Optional<Character>, TextReadError> {
        if peeked is Some(let cached) {
            return Ok(Some(cached))
        }
        let available = match EnsureCharacters(1) {
            Ok(let value) => value
            Failure(let error) => return Failure(error)
        }
        if available == 0 {
            return Ok(None)
        }
        let character = pendingText[pendingOffset]
        // Ordinary buffered input needs no intermediate String. Only the oversized
        // boundary case needs a per-grapheme size check after lookahead completed it.
        if pendingText.Utf8Bytes.Length > 65536 {
            if character.ToString().Utf8Bytes.Length > 65536 {
                return Failure(TextReadError.LimitExceeded)
            }
        }
        peeked = Some(character)
        return Ok(Some(character))
    }

    private func ReadCore(count: int, maxUtf8Bytes: int) -> Result<string, TextReadError> {
        let available = match EnsureCharacters(count) {
            Ok(let value) => value
            Failure(let error) => return Failure(error)
        }
        if available == 0 {
            return Ok("")
        }
        let end = pendingOffset + available
        let result = if pendingOffset == 0 && end == pendingText.Length {
            pendingText
        } else {
            pendingText[pendingOffset..end]
        }
        if result.Utf8Bytes.Length > maxUtf8Bytes {
            return Failure(TextReadError.LimitExceeded)
        }
        pendingOffset = end
        peeked = None
        return Ok(result)
    }

    private func EnsureCharacters(count: int) -> Result<int, TextReadError> {
        while true {
            let available = pendingText.Length - pendingOffset
            // Retain the last unfinished grapheme until another boundary or EOF.
            // LF has an unconditional boundary after it, so interactive line input
            // need not wait for a second line just to consume its final newline.
            let complete = pendingText.EndsWithOrdinal("\n")
            if available > count || eof || (available >= count && complete) {
                return Ok(if available < count { available } else { count })
            }
            pendingText = DrainPending()
            if pendingText.Utf8Bytes.Length > 65536 {
                return Failure(TextReadError.LimitExceeded)
            }
            let part = match ReadPart(readBuffer, 256, 256) {
                Ok(let text) => text
                Failure(let error) => return Failure(error)
            }
            pendingText = String.Concat(pendingText, part)
        }
        return Failure(TextReadError.IoFailure)
    }

    func ReadLine(maxUtf8Bytes: int) -> Result<Optional<string>, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if operation.Active {
            return Failure(TextReadError.Busy)
        }
        operation.Begin()
        use lease = operation
        let result = ReadLineCore(maxUtf8Bytes)
        operation.Complete()
        return result
    }

    private func GetLineDelimiter() -> Result<TextLineDelimiter, TextReadError> {
        let ending = NewLine
        if ending.IsEmpty {
            return Failure(TextReadError.InvalidRange)
        }
        if ending.Utf8Bytes.Length > 65536 {
            return Failure(TextReadError.LimitExceeded)
        }
        if lineDelimiter is TextLineDelimiter cached {
            if String.CompareOrdinal(cached.Text, ending) == 0 {
                return Ok(cached)
            }
        }
        let created = TextLineDelimiter(ending)
        lineDelimiter = created
        return Ok(created)
    }

    private func ReadLineCore(maxUtf8Bytes: int) -> Result<Optional<string>, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if maxUtf8Bytes < 0 {
            return Failure(TextReadError.InvalidRange)
        }
        if maxUtf8Bytes > 65536 {
            return Failure(TextReadError.LimitExceeded)
        }
        let delimiter = GetLineDelimiter()?
        let buffer = readBuffer
        let line = ArrayList<byte>()
        var matched = 0
        while true {
            let part = DrainPending()
            let byteCount = part.Utf8Bytes.Length
            var index = 0
            while index < byteCount {
                let value = part.Utf8Bytes[index]
                let previous = matched
                matched = delimiter.Advance(matched, value)
                if matched == delimiter.Length {
                    match part.SliceUtf8(index + 1, byteCount - index - 1) {
                        Ok(let suffix) => pendingText = suffix
                        Failure(_) => Panic("Invalid decoded line suffix")
                    }
                    return TextReadSupport.DecodeLine(line, line.Count)
                }
                let confirmed = previous + 1 - matched
                if confirmed > maxUtf8Bytes - line.Count {
                    return Failure(TextReadError.LimitExceeded)
                }
                var emitted = 0
                while emitted < confirmed {
                    line.Add(if emitted < previous { delimiter.ByteAt(emitted) } else { value })
                    emitted += 1
                }
                index += 1
            }
            if eof {
                if matched > maxUtf8Bytes - line.Count {
                    return Failure(TextReadError.LimitExceeded)
                }
                var prefix = 0
                while prefix < matched {
                    line.Add(delimiter.ByteAt(prefix))
                    prefix += 1
                }
                if line.Count == 0 {
                    let absent: Optional<string> = None()
                    return Ok(absent)
                }
                return TextReadSupport.DecodeLine(line, line.Count)
            }
            match ReadPart(buffer, 1, 1) {
                Ok(let decoded) => pendingText = decoded
                Failure(let error) => return Failure(error)
            }
        }
        return Failure(TextReadError.IoFailure)
    }

    func ReadToEnd(maxUtf8Bytes: int) -> Result<string, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if operation.Active {
            return Failure(TextReadError.Busy)
        }
        operation.Begin()
        use lease = operation
        let result = ReadToEndCore(maxUtf8Bytes)
        operation.Complete()
        return result
    }

    private func ReadToEndCore(maxUtf8Bytes: int) -> Result<string, TextReadError> {
        if closed {
            return Failure(TextReadError.Closed)
        }
        if maxUtf8Bytes < 0 {
            return Failure(TextReadError.InvalidRange)
        }
        if maxUtf8Bytes > 65536 {
            return Failure(TextReadError.LimitExceeded)
        }
        let buffer = readBuffer
        var text = DrainPending()
        var accepted = 0
        while true {
            if text.Utf8Bytes.Length > maxUtf8Bytes {
                return Failure(TextReadError.LimitExceeded)
            }
            if eof {
                return Ok(text)
            }
            var request = maxUtf8Bytes - accepted + 1
            if request > buffer.Length {
                request = buffer.Length
            }
            match ReadPart(buffer, request, maxUtf8Bytes - accepted) {
                Ok(let part) => text = String.Concat(text, part)
                Failure(let error) => return Failure(error)
            }
            accepted += lastRead
            if accepted > maxUtf8Bytes {
                return Failure(TextReadError.LimitExceeded)
            }
        }
        return Failure(TextReadError.IoFailure)
    }

    private func ReadPart(buffer: byte[], request: int, remaining: int) -> Result<string, TextReadError> {
        if input is SyncInputStream source {
            let count = match source.Read(buffer[..request]) {
                Ok(let value) => value
                Failure(let error) => return Failure(TextReadSupport.FromStream(error))
            }
            if closed {
                return Failure(TextReadError.Closed)
            }
            return DecodePart(buffer, count, request, remaining)
        }
        return Failure(TextReadError.WrongAccess)
    }

    func Close() {
        if !closed {
            closed = true
            pendingText = ""
            pendingOffset = 0
            peeked = None
            if !leaveOpen {
                input.Close()
            }
        }
    }

}
