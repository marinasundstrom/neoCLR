module System

import System.*

import System.Optional.*


/// <summary>An immutable Unicode extended grapheme cluster backed by preserved UTF-8 text.</summary>
/// <remarks>Character literals infer this type. Equality and hashing use canonical Unicode equivalence; this is not a numeric code unit.</remarks>
public struct Character : ComparableTo<Character>, EquatableTo<Character> {
    // Immutable grapheme storage is supplied by the runtime.
    #pragma warning disable-next-line RAV9032
    private field m_value: Character

    /// <summary>Creates one Character from a complete extended grapheme cluster.</summary>
    /// <param name="text">Exactly one non-empty grapheme, preserving its UTF-8 spelling.</param>
    /// <returns>The original grapheme value.</returns>
    /// <remarks>Invalid empty or multi-grapheme text faults; use TryFromString for recoverable validation.</remarks>
    static func FromString(text: string) -> Character {
        return neoCLR.Runtime.CharFromString(text)
    }

    /// <summary>Creates a Character when text is exactly one extended grapheme cluster.</summary>
    /// <param name="text">Non-null UTF-8 text to validate; empty or multiple graphemes return None.</param>
    /// <returns>Some containing the original grapheme spelling, or None.</returns>
    /// <remarks>Uses Unicode 17 boundaries and preserves bytes without normalization.
    /// Checks whether the first grapheme occupies the entire input; no temporary String or Character array is created.
    /// Successful construction follows the runtime's Character storage and Optional allocation rules.</remarks>
    static func TryFromString(text: string) -> Optional<Character> {
        if !neoCLR.Runtime.CharIsSingleGrapheme(text) {
            return None
        }
        return Some(neoCLR.Runtime.CharFromString(text))
    }

    override func ToString() -> string {
        return neoCLR.Runtime.CharText(m_value)
    }

    /// Tests canonical equivalence of graphemes without allocating text.
    func Equals(other: Character) -> bool {
        return neoCLR.Runtime.CharCompareCanonical(m_value, other) == 0
    }

    /// <summary>Compares graphemes using an explicit text policy.</summary>
    /// <param name="other">The grapheme to compare.</param>
    /// <param name="comparison">Canonical, Ordinal byte identity, or OrdinalIgnoreCase simple-fold scalar identity.</param>
    /// <returns>True when the entire graphemes match under the selected policy.</returns>
    /// <remarks>Unknown modes fault with RuntimeError. Simple folding does not normalize or expand.
    /// Compares Character storage directly without converting it to String; original bytes are preserved.</remarks>
    func Equals(other: Character, comparison: StringComparison) -> bool {
        if comparison == StringComparison.Canonical {
            return neoCLR.Runtime.CharCompareCanonical(m_value, other) == 0
        }
        if comparison == StringComparison.Ordinal {
            return neoCLR.Runtime.CharCompareOrdinal(m_value, other) == 0
        }
        if comparison == StringComparison.OrdinalIgnoreCase {
            return neoCLR.Runtime.CharCompareOrdinalIgnoreCase(m_value, other) == 0
        }
        Panic("Unsupported StringComparison")
        return false
    }

    override func Equals(other: Object?) -> bool {
        if other is Character character {
            return Equals(character)
        }
        return false
    }

    /// Hashes canonical grapheme identity without changing stored bytes.
    override func GetHashCode() -> int => neoCLR.Runtime.CharHashCanonical(m_value)

    /// Orders canonical NFD scalar sequences, without linguistic collation.
    func CompareTo(other: Character) -> int {
        return neoCLR.Runtime.CharCompareCanonical(m_value, other)
    }
}
