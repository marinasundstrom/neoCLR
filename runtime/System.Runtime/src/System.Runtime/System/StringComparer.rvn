module System


/// Consistent string equality, hashing and ordering under a consistent Unicode text policy.
public class StringComparer : Collections.EqualityComparer<string>, Collections.Comparer<string> {
    // Explicit field: the current compiler cannot constructor-assign an uninitialized private val.
    private field policy: int

    // A CLI integer avoids a top-level Boolean adapter crossing private constructor access.
    private init(mode: int) {
        policy = mode
    }

    /// Canonical Unicode 17 text identity and NFD scalar ordering, preserving stored bytes.
    static val Default: StringComparer => StringComparer(2)

    /// Returns a stateless ordinal policy. Instance identity is not guaranteed.
    static val Ordinal: StringComparer => StringComparer(0)

    /// Uses Unicode 17 default simple folding for equality, hashing and ordering.
    static val OrdinalIgnoreCase: StringComparer => StringComparer(1)

    func Equals(left: string, right: string) -> bool {
        if policy == 1 {
            return String.CompareOrdinalIgnoreCase(left, right) == 0
        }
        return Compare(left, right) == 0
    }

    func GetHashCode(value: string) -> int {
        if policy == 2 {
            return neoCLR.Runtime.StringHashCanonical(value)
        }
        if policy == 1 {
            return neoCLR.Runtime.StringHashOrdinalIgnoreCase(value)
        }
        return neoCLR.Runtime.StringHashOrdinal(value)
    }

    func Compare(left: string, right: string) -> int {
        if policy == 2 {
            return String.Compare(left, right)
        }
        if policy == 1 {
            return String.CompareOrdinalIgnoreCase(left, right)
        }
        return String.CompareOrdinal(left, right)
    }
}
