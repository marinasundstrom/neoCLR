module System.Time

import System.*

public struct Duration : ComparableTo<Duration>, EquatableTo<Duration>, Formattable {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func FromTicks(ticks: long) -> Duration {
        return Duration(ticks)
    }

    /// <summary>Parses invariant [-][d.]hh:mm:ss[.fraction], with 1–8 day digits and 1–7 fraction digits.</summary>
    /// <param name="value">Complete ASCII text without whitespace or a leading plus sign.</param>
    /// <returns>The duration, or InvalidFormat for unsupported syntax or OutOfRange for invalid fields or tick overflow.</returns>
    /// <remarks>Leading day zeros are accepted within the eight-digit bound. Full signed Int64 ticks are supported.</remarks>
    static func Parse(value: string) -> Result<Duration, DateTimeParseError> {
        return CivilParser.ParseDuration(value)
    }

    val Ticks: long => StoredTicks

    /// Compares the complete signed tick count.
    func Equals(other: Duration) -> bool {
        return StoredTicks == other.StoredTicks
    }

    /// Compares another boxed Duration by tick count; null and other types are unequal.
    override func Equals(other: Object?) -> bool {
        return other is Duration value && Equals(value)
    }

    /// Returns an execution-local value hash consistent with tick equality; not a persistent identifier.
    override func GetHashCode() -> int {
        return (int)StoredTicks ^ (int)(StoredTicks >> 32)
    }

    func CompareTo(other: Duration) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
    /// Formats the invariant constant representation, including every tick of precision.
    override func ToString() -> string => FormatDuration("c", ".")

    /// Formats with Culture.Current for g/G; c, t and T are invariant.
    func ToString(format: string) -> string => ToString(format, Globalization.Culture.Current)

    /// Supports empty/c/t/T (invariant), g (optional day and fractional digits) and
    /// G (day and seven fractional digits always present). Swedish g/G uses a comma.
    /// Unsupported specifiers fault. All signed Int64 tick values are supported.
    func ToString(format: string, culture: Globalization.Culture) -> string {
        let separator = Globalization.NumberFormat.DecimalSeparator(culture)
        return FormatDuration(format, separator)
    }

    private func FormatDuration(format: string, separator: string) -> string {
        let constant = format == "" || format == "c" || format == "t" || format == "T"
        if !constant && format != "g" && format != "G" {
            Panic("Unsupported Duration format")
        }
        // Split before negating: Int64.MinValue itself cannot be made positive.
        var days = StoredTicks / 864000000000L
        var remaining = StoredTicks % 864000000000L
        let builder = Text.StringBuilder()
        if StoredTicks < 0L {
            builder.Append("-")
            days = -days
            remaining = -remaining
        }
        let digits = Globalization.DateTimeFormatDigits()
        if days != 0L || format == "G" {
            builder.Append(days.ToString())
            builder.Append(if constant { "." } else { ":" })
        }
        let hours = (int)(remaining / 36000000000L)
        builder.Append(digits.Pad(hours, if format == "g" { 1 } else { 2 }))
        builder.Append(":" + digits.Pad((int)(remaining / 600000000L % 60L), 2))
        builder.Append(":" + digits.Pad((int)(remaining / 10000000L % 60L), 2))
        let fraction = (int)(remaining % 10000000L)
        if fraction != 0 || format == "G" {
            builder.Append(if constant { "." } else { separator })
            var text = digits.Pad(fraction, 7)
            if format == "g" {
                var length = text.Length
                while length > 0 && text.Utf8Bytes[length - 1] == 48 {
                    length -= 1
                }
                text = text[..length]
            }
            builder.Append(text)
        }
        return builder.ToString()
    }

}
