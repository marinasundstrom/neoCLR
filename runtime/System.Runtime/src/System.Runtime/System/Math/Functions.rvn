module System.Math

import System.OverflowError
import System.InvalidRangeError
import System.Result.*

/// The ratio of a circle's circumference to its diameter, rounded to Double precision.
public const Pi: double = 3.14159265358979323846

/// Euler's number, the base of natural logarithms, rounded to Double precision.
public const E: double = 2.7182818284590452354

/// One full turn in radians (twice Pi), rounded to Double precision.
public const Tau: double = 6.283185307179586476925

public func Abs(value: int) -> System.Result<int, OverflowError> {
    if value == -2147483648 {
        return Failure(OverflowError())
    }
    if value < 0 {
        return Ok(0 - value)
    }
    return Ok(value)
}

public func Min(left: int, right: int) -> int {
    if left < right {
        return left
    }
    return right
}

public func Max(left: int, right: int) -> int {
    if left > right {
        return left
    }
    return right
}

public func Sign(value: int) -> int {
    if value < 0 {
        return -1
    }
    if value > 0 {
        return 1
    }
    return 0
}

public func Clamp(value: int, min: int, max: int) -> System.Result<int, InvalidRangeError> {
    if min > max {
        return Failure(InvalidRangeError())
    }
    return Ok(Min(Max(value, min), max))
}

public func Abs(value: double) -> double {
    return neoCLR.Runtime.MathAbs(value)
}

public func Sqrt(value: double) -> double {
    return neoCLR.Runtime.MathSqrt(value)
}

public func Floor(value: double) -> double {
    return neoCLR.Runtime.MathFloor(value)
}

public func Ceiling(value: double) -> double {
    return neoCLR.Runtime.MathCeiling(value)
}

public func Truncate(value: double) -> double {
    return neoCLR.Runtime.MathTruncate(value)
}

public func Round(value: double) -> double {
    return neoCLR.Runtime.MathRound(value)
}

public func Exp(value: double) -> double {
    return neoCLR.Runtime.MathExp(value)
}

public func Log(value: double) -> double {
    return neoCLR.Runtime.MathLog(value)
}

public func Log10(value: double) -> double {
    return neoCLR.Runtime.MathLog10(value)
}

public func Sin(value: double) -> double {
    return neoCLR.Runtime.MathSin(value)
}

public func Cos(value: double) -> double {
    return neoCLR.Runtime.MathCos(value)
}

public func Tan(value: double) -> double {
    return neoCLR.Runtime.MathTan(value)
}

public func Pow(left: double, right: double) -> double {
    return neoCLR.Runtime.MathPow(left, right)
}

public func Min(left: double, right: double) -> double {
    return neoCLR.Runtime.MathMin(left, right)
}

public func Max(left: double, right: double) -> double {
    return neoCLR.Runtime.MathMax(left, right)
}
