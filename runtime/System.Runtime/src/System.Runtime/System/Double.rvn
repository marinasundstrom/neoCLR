module System

import System.Result.*

public struct Double : Number, EquatableTo<double>, Formattable {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: double

    static val Zero: double => (double)0
    static val One: double => (double)1

    /// Represents an IEEE not-a-number value. Use IsNaN to test for any NaN.
    public const NaN: double = (double)0.0 / (double)0.0
    /// Represents positive infinity.
    public const PositiveInfinity: double = (double)1.0 / (double)0.0
    /// Represents negative infinity.
    public const NegativeInfinity: double = (double)(-1.0) / (double)0.0

    /// Returns true for every NaN representation, regardless of sign or payload.
    static func IsNaN(value: double) -> bool => value != value
    /// Returns true for positive or negative infinity.
    static func IsInfinity(value: double) -> bool => value == PositiveInfinity || value == NegativeInfinity
    /// Returns true only for positive infinity.
    static func IsPositiveInfinity(value: double) -> bool => value == PositiveInfinity
    /// Returns true only for negative infinity.
    static func IsNegativeInfinity(value: double) -> bool => value == NegativeInfinity
    /// Returns true for finite values, including either signed zero.
    static func IsFinite(value: double) -> bool => !IsNaN(value) && !IsInfinity(value)

    static func +(left: double, right: double) -> double => (double)(left + right)
    static func -(left: double, right: double) -> double => (double)(left - right)
    static func *(left: double, right: double) -> double => (double)(left * right)
    static func /(left: double, right: double) -> double => (double)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<double, NumberParseError> {
        let payload = neoCLR.Runtime.ParseDouble(value)
        if neoCLR.Runtime.IsValue<double>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<double>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<int>(payload)
        if status == 1 {
            return Failure(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Failure(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Failure(NumberParseError.InvalidFormat())
    }

    /// Tests value equality; NaNs compare equal and signed zeros compare equal.
    func Equals(other: double) -> bool => m_value == other || (m_value != m_value && other != other)

    /// Returns invariant shortest round-trip text, preserving negative zero.
    func ToString() -> string => ToString("G", Globalization.Culture.Invariant)

    /// Parses explicit culture punctuation with strict three-digit grouping; whitespace is not accepted.
    static func Parse(text: string, culture: Globalization.Culture) -> Result<double, NumberParseError> {
        let normalized = Globalization.NumericParsing.Normalize(text, culture, true)?
        return Parse(normalized)
    }

    /// Formats with the current culture using G, R, F, N or E; precision is 0–99.
    func ToString(format: string) -> string => ToString(format, Globalization.Culture.Current)

    /// Formats with explicit culture. R ignores valid precision; unsupported formats fault.
    func ToString(format: string, culture: Globalization.Culture) -> string {
        let code = Globalization.FloatingFormatting.FormatCode(format)
        let precision = Globalization.FloatingFormatting.Precision(format)
        return neoCLR.Runtime.FormatDouble(m_value, code, precision, culture.Name == "sv-SE")
    }

    func CompareTo(other: double) -> int {
        if m_value != m_value {
            if other != other {
                return 0
            }
            return -1
        }
        if other != other {
            return 1
        }
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
