module System

import System.Result.*

// Bounded ASCII URI-reference grammar; parsing performs no I/O.
public class Uri : EquatableTo<Uri> {
    private field text: string
    private field scheme: string
    private field authority: string
    private field path: string
    private field query: string
    private field fragment: string

    private init(text: string, scheme: string, authority: string, path: string, query: string, fragment: string) {
        self.text = text
        self.scheme = scheme
        self.authority = authority
        self.path = path
        self.query = query
        self.fragment = fragment
    }

    val Text: string => text
    val IsAbsolute: bool => !scheme.IsEmpty
    val IsRelative: bool => scheme.IsEmpty

    private static func Part(text: string, start: int, end: int) -> string {
        if start == end {
            return ""
        }
        if start == 0 && end == text.GetUtf8ByteCount() {
            return text
        }
        if let Ok(part) = text.SliceUtf8(start, end - start) {
            return part
        }
        System.Fail("Invalid internal URI boundary")
        return ""
    }

    private static func Alpha(value: byte) -> bool {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
    }

    private static func Digit(value: byte) -> bool {
        return value >= 48 && value <= 57
    }

    private static func Hex(value: byte) -> bool {
        return Digit(value) || (value >= 65 && value <= 70) || (value >= 97 && value <= 102)
    }

    static func Parse(text: string) -> Result<Uri, UriError> {
        if text.GetUtf8ByteCount() > 4096 {
            return Failure(UriError.TooLong())
        }
        let count = text.GetUtf8ByteCount()
        // Borrow immutable UTF-8 storage; validation needs no encoded byte array.
        let bytes = text.Utf8Bytes
        var index = 0
        while index < count {
            let value = bytes[index]
            if value == 37 {
                if index + 2 >= count || !Hex(bytes[index + 1]) || !Hex(bytes[index + 2]) {
                    return Failure(UriError.InvalidFormat())
                }
                index += 3
                continue
            }
            if !(Alpha(value) || Digit(value) || value == 45 || value == 46 || value == 95 || value == 126 ||
                value == 58 || value == 47 || value == 63 || value == 35 || value == 64 ||
                value == 33 || value == 36 || value == 38 || value == 39 || value == 40 || value == 41 ||
                value == 42 || value == 43 || value == 44 || value == 59 || value == 61) {
                if value == 91 || value == 93 {
                    return Failure(UriError.UnsupportedAuthority())
                }
                return Failure(UriError.InvalidFormat())
            }
            index += 1
        }
        var parsedScheme = ""
        var parsedAuthority = ""
        var parsedQuery = ""
        var parsedFragment = ""
        var start = 0
        index = 0
        while index < count && bytes[index] != 47 && bytes[index] != 63 && bytes[index] != 35 {
            if bytes[index] == 58 {
                if index == 0 || !Alpha(bytes[0]) {
                    return Failure(UriError.InvalidFormat())
                }
                var position = 1
                while position < index {
                    let value = bytes[position]
                    if !(Alpha(value) || Digit(value) || value == 43 || value == 45 || value == 46) {
                        return Failure(UriError.InvalidFormat())
                    }
                    position += 1
                }
                parsedScheme = Part(text, 0, index + 1)
                start = index + 1
                break
            }
            index += 1
        }
        if start + 1 < count && bytes[start] == 47 && bytes[start + 1] == 47 {
            index = start + 2
            var at = -1
            var colon = -1
            while index < count && bytes[index] != 47 && bytes[index] != 63 && bytes[index] != 35 {
                if bytes[index] == 64 {
                    if at >= 0 {
                        return Failure(UriError.InvalidFormat())
                    }
                    at = index
                    colon = -1
                } else if bytes[index] == 58 {
                    colon = index
                }
                index += 1
            }
            // A reg-name host has no colons. User info may have them.
            var position = start + 2
            if at >= 0 {
                position = at + 1
            }
            while position < index {
                if bytes[position] == 58 && position != colon {
                    return Failure(UriError.InvalidFormat())
                }
                if colon >= 0 && position > colon && !Digit(bytes[position]) {
                    return Failure(UriError.InvalidFormat())
                }
                position += 1
            }
            parsedAuthority = Part(text, start, index)
            start = index
        }
        index = start
        while index < count && bytes[index] != 63 && bytes[index] != 35 {
            index += 1
        }
        let parsedPath = Part(text, start, index)
        if index < count && bytes[index] == 63 {
            start = index
            index += 1
            while index < count && bytes[index] != 35 {
                index += 1
            }
            parsedQuery = Part(text, start, index)
        }
        if index < count {
            start = index
            index += 1
            while index < count {
                if bytes[index] == 35 {
                    return Failure(UriError.InvalidFormat())
                }
                index += 1
            }
            parsedFragment = Part(text, start, count)
        }
        return Ok(Uri(text, parsedScheme, parsedAuthority, parsedPath, parsedQuery, parsedFragment))
    }

    private static func Parent(path: string) -> string {
        var index = path.GetUtf8ByteCount() - 1
        while index >= 0 {
            if path.Utf8Bytes[index] == 47 {
                return Part(path, 0, index)
            }
            index -= 1
        }
        return ""
    }

    // RFC 3986 section 5.2.4. Percent-encoded dots are not decoded here.
    private static func RemoveDots(path: string) -> string {
        var input = path
        var output = ""
        while !input.IsEmpty {
            let count = input.GetUtf8ByteCount()
            if input.StartsWithOrdinal("../") {
                input = Part(input, 3, count)
            } else if input.StartsWithOrdinal("./") {
                input = Part(input, 2, count)
            } else if input.StartsWithOrdinal("/./") {
                input = Part(input, 2, count)
            } else if input == "/." {
                input = "/"
            } else if input.StartsWithOrdinal("/../") {
                input = Part(input, 3, count)
                output = Parent(output)
            } else if input == "/.." {
                input = "/"
                output = Parent(output)
            } else if input == "." || input == ".." {
                input = ""
            } else {
                var end = 1
                while end < count && input.Utf8Bytes[end] != 47 {
                    end += 1
                }
                output = String.Concat(output, Part(input, 0, end))
                input = Part(input, end, count)
            }
        }
        return output
    }

    func Resolve(reference: string) -> Result<Uri, UriError> {
        let parsed = Parse(reference)?
        return Resolve(parsed)
    }

    func Resolve(reference: Uri) -> Result<Uri, UriError> {
        if !IsAbsolute {
            return Failure(UriError.BaseNotAbsolute())
        }
        var resolvedScheme = scheme
        var resolvedAuthority = authority
        var resolvedPath = reference.path
        var resolvedQuery = reference.query
        if reference.IsAbsolute {
            resolvedScheme = reference.scheme
            resolvedAuthority = reference.authority
            resolvedPath = RemoveDots(reference.path)
        } else if !reference.authority.IsEmpty {
            resolvedAuthority = reference.authority
            resolvedPath = RemoveDots(reference.path)
        } else if reference.path.IsEmpty {
            resolvedPath = path
            if reference.query.IsEmpty {
                resolvedQuery = query
            }
        } else {
            if !reference.path.StartsWithOrdinal("/") {
                var prefix = ""
                var end = path.GetUtf8ByteCount() - 1
                while end >= 0 {
                    if path.Utf8Bytes[end] == 47 {
                        prefix = Part(path, 0, end + 1)
                        break
                    }
                    end -= 1
                }
                if path.IsEmpty && !authority.IsEmpty {
                    prefix = "/"
                }
                resolvedPath = String.Concat(prefix, reference.path)
            }
            resolvedPath = RemoveDots(resolvedPath)
        }
        let resolvedPrefix = String.Concat(resolvedScheme, resolvedAuthority)
        let suffix = String.Concat(resolvedQuery, reference.fragment)
        let resolvedText = String.Concat(String.Concat(resolvedPrefix, resolvedPath), suffix)
        if resolvedText.GetUtf8ByteCount() > 4096 {
            return Failure(UriError.TooLong())
        }
        // A newly leading double slash changes the authority boundary. Preserve
        // the existing parse semantics for that ambiguous composition.
        if resolvedAuthority.IsEmpty && resolvedPath.StartsWithOrdinal("//") {
            return Parse(resolvedText)
        }
        return Ok(Uri(resolvedText, resolvedScheme, resolvedAuthority, resolvedPath, resolvedQuery, reference.fragment))
    }

    func Equals(other: Uri) -> bool => String.CompareOrdinal(text, other.Text) == 0

    override func Equals(other: Object?) -> bool {
        if other is Uri uri {
            return Equals(uri)
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(neoCLR.Runtime.StringHashOrdinal(text))
        return hash.ToHashCode()
    }

    override func ToString() -> string => text
}
