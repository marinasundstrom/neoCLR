module System.Runtime

import System.*
import System.Introspection.*
import System.Runtime.CompilerServices.*

public class RuntimeContext {
    private init() { }

    static val Current: RuntimeContext {
        get => RuntimeContext()
    }

    val ExecutingAssembly: AssemblyInfo {
        get => neoCLR.Runtime.ExecutingAssembly()
    }

    func GetTypeInfoFromHandle(handle: RuntimeTypeHandle) -> TypeInfo {
        return System.Introspection.RuntimeTypeInfo.FromHandle(handle)
    }
}
