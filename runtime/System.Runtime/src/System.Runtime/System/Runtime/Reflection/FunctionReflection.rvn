module System.Runtime.Reflection

import System.*
import System.Result.*
import System.Runtime.CompilerServices.*

/// <summary>Checked dynamic invocation of native structural function values.</summary>
/// <remarks>Provisional development API. Target faults propagate; this API does not catch them.
/// Exact boxed scalars and compatible references are supported. No coercion, ref/out
/// copyback or arbitrary value marshalling is provided.</remarks>
public static class FunctionReflection {
    /// <summary>Validates arguments and invokes a bound function.</summary>
    /// <param name="function">The function value, including its bound receiver or captures.</param>
    /// <param name="arguments">Arguments in signature order; use an empty array for no parameters.</param>
    /// <returns>Ok containing the boxed result, reference or null for a no-result call.
    /// InvalidReceiver indicates null or a non-function; InvalidArguments indicates an
    /// incorrect count or type; UnsupportedType indicates an unsupported signature.</returns>
    static func Invoke(function: Object?, arguments: Object?[]) -> Result<Object?, ReflectionError> {
        let status = neoCLR.Runtime.InvokeFunctionCheck(function, arguments)
        if status == 0 {
            return Ok(neoCLR.Runtime.InvokeFunction(function, arguments))
        }
        if status == 6 {
            return Failure(ReflectionError.InvalidReceiver)
        }
        if status == 8 {
            return Failure(ReflectionError.InvalidArguments)
        }
        return Failure(ReflectionError.UnsupportedType)
    }
}
