module System.Collections

/// <summary>A key and value transported together as a deconstructable value.</summary>
/// <param name="Key">The key.</param>
/// <param name="Value">The associated value.</param>
/// <remarks>Native development supports construction, copying, getters, initialization-only accessors and deconstruction. Generated equality and hashing use the declared key and value types, including canonical text equality. Unsupported component Object contracts may fault; generic formatting remains unavailable.</remarks>
public record struct KeyValuePair<K, V>(val Key: K, val Value: V)
