module System.Collections

/// Adapts equality and hash callbacks into one reusable policy.
public class FunctionEqualityComparer<T> : EqualityComparer<T> {
    // Explicit storage: the pinned compiler treats uninitialized private var as getter-only.
    private field equal: (T, T) -> bool
    private field hash: (T) -> int

    init(equal: (T, T) -> bool, hash: (T) -> int) {
        self.equal = equal
        self.hash = hash
    }

    func Equals(left: T, right: T) -> bool {
        return equal(left, right)
    }

    func GetHashCode(value: T) -> int {
        return hash(value)
    }
}
