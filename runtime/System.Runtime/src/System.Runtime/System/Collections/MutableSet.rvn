module System.Collections

/// A set supporting insertion, removal and clearing.
public interface MutableSet<T> : Set<T> {
    /// Adds an element and returns whether membership changed.
    func Add(value: T) -> bool
    /// Removes an equivalent element and returns whether membership changed.
    func Remove(value: T) -> bool
    /// Removes all elements.
    func Clear()
    /// <summary>Looks up the stored equivalent value using this set's equality policy.</summary>
    /// <param name="value">The value to match.</param>
    /// <returns>Some containing the stored value, including a permitted null; otherwise None.</returns>
    func Find(value: T) -> System.Optional<T>
}
