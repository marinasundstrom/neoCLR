module neoCLR.Runtime

import System.*
import System.Runtime.CompilerServices.*

// Private runtime services. Managed cryptography owns the public API.
[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoSha256(data: ReadOnlySlice<byte>, output: Slice<byte>) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoHmacSha256(key: ReadOnlySlice<byte>, data: ReadOnlySlice<byte>, output: Slice<byte>) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoHmacSha256Verify(key: ReadOnlySlice<byte>, data: ReadOnlySlice<byte>, tag: ReadOnlySlice<byte>) -> bool;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CryptoRandomFill(output: Slice<byte>) -> int;
