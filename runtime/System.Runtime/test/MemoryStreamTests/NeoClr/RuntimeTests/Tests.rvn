module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Optional.*
import NeoClr.Testing.*

import System.IO.*
import System.IO.Compression.*
import System.Text.*
import System.Time.*
import System.Concurrency.Tasks.*
import System.Concurrency.Tasks.TaskOutcome.*
import System.Concurrency.*

[Test]
func `MemoryStream overwrites preserve length and untouched bytes`() -> Result<unit, TestFailure> {
    let stream = MemoryStream()
    let bytes: byte[] = [(byte)65, (byte)66, (byte)67]
    _ = Assert.True(stream.GetLength() is Ok(0L), "New stream must have zero length")?
    _ = Assert.True(CompletedValue(stream.Write(bytes, 0, 3)) is Ok(_), "Write complete buffer")?
    _ = Assert.True(stream.Seek(1) is Ok(_), "Seek inside content")?
    _ = Assert.True(CompletedValue(stream.Write(bytes, 0, 1)) is Ok(_), "Overwrite one byte")?
    _ = Assert.True(stream.GetLength() is Ok(3L), "Overwrite must not grow length")?
    _ = Assert.True(stream.Seek(0) is Ok(_), "Rewind")?
    let output: byte[] = [(byte)0, (byte)0, (byte)0]
    _ = Assert.True(CompletedValue(stream.Read(output, 0, 3)) is Ok(3), "Read stored bytes")?
    stream.Close()
    return Assert.True(output[0] == 65 && output[1] == 65 && output[2] == 67, "Only the overwritten byte changes")
}

[Test]
func `MemoryStream gap writes zero-fill while empty writes preserve length`() -> Result<unit, TestFailure> {
    let stream = MemoryStream()
    let bytes: byte[] = [(byte)65, (byte)66, (byte)67]
    _ = Assert.True(CompletedValue(stream.Write(bytes, 0, 3)) is Ok(_), "Write initial content")?
    _ = Assert.True(stream.Seek(5) is Ok(_), "Seek beyond end")?
    _ = Assert.True(CompletedValue(stream.Write(bytes, 0, 0)) is Ok(_), "Empty write succeeds")?
    _ = Assert.True(stream.GetLength() is Ok(3L), "Empty write must not extend the stream")?
    _ = Assert.True(CompletedValue(stream.Write(bytes, 2, 1)) is Ok(_), "Write after gap")?
    _ = Assert.True(stream.Seek(0) is Ok(_), "Rewind")?
    let output: byte[] = [(byte)9, (byte)9, (byte)9, (byte)9, (byte)9, (byte)9, (byte)9, (byte)9]
    _ = Assert.True(CompletedValue(stream.Read(output, 1, 7)) is Ok(6), "Read only available bytes into offset")?
    _ = Assert.True(output[0] == 9 && output[7] == 9, "Read must preserve outside destination range")?
    _ = Assert.True(output[1] == 65 && output[2] == 66 && output[3] == 67, "Original bytes survive")?
    _ = Assert.True(output[4] == 0 && output[5] == 0 && output[6] == 67, "Gap must be zero-filled")?
    _ = Assert.True(CompletedValue(stream.Read(output, 0, 1)) is Ok(0), "EOF returns zero")?
    stream.Close()
    return Assert.True(true, "Gap and EOF checks completed")
}

[Test]
func `MemoryStream rejects invalid buffer and seek ranges without moving`() -> Result<unit, TestFailure> {
    let stream = MemoryStream()
    let bytes: byte[] = [(byte)1]
    _ = Assert.True(CompletedValue(stream.Write(bytes, 2147483647, 1)) is Failure(StreamError.InvalidRange), "Overflowing write range")?
    _ = Assert.True(CompletedValue(stream.Read(bytes, -1, 1)) is Failure(StreamError.InvalidRange), "Negative read offset")?
    _ = Assert.True(stream.Seek(-1) is Failure(StreamError.InvalidRange), "Negative seek")?
    _ = Assert.True(stream.GetPosition() is Ok(0L), "Rejected operations must preserve position")?
    _ = Assert.True(stream.GetLength() is Ok(0L), "Rejected operations must preserve length")?
    stream.Close()
    return Assert.True(true, "Range checks completed")
}

[Test]
func `MemoryStream quota errors preserve length and position`() -> Result<unit, TestFailure> {
    let stream = MemoryStream()
    let bytes: byte[] = [(byte)1]
    _ = Assert.True(CompletedValue(stream.Write(bytes, 0, 1)) is Ok(_), "Write initial byte")?
    _ = Assert.True(stream.Seek(65537) is Failure(StreamError.LimitExceeded), "Seek beyond quota")?
    _ = Assert.True(stream.GetPosition() is Ok(1L), "Rejected seek must not move")?
    _ = Assert.True(stream.Seek(65536) is Ok(_), "Exact boundary seek")?
    _ = Assert.True(CompletedValue(stream.Write(bytes, 0, 1)) is Failure(StreamError.LimitExceeded), "Write beyond quota")?
    _ = Assert.True(stream.GetLength() is Ok(1L), "Rejected write must not extend length")?
    _ = Assert.True(stream.GetPosition() is Ok(65536L), "Rejected write must not move")?
    stream.Close()
    return Assert.True(true, "Quota checks completed")
}

[Test]
func `MemoryStream closure is shared across interfaces and idempotent`() -> Result<unit, TestFailure> {
    let stream = MemoryStream()
    let input: InputStream = stream
    let output: OutputStream = stream
    let seek: SeekableStream = stream
    _ = Assert.True(CompletedValue(output.Flush()) is Ok(_), "Flush open memory stream")?
    input.Close()
    output.Close()
    let bytes: byte[] = [(byte)0]
    _ = Assert.True(stream.GetLength() is Failure(StreamError.Closed), "Closed length")?
    _ = Assert.True(seek.GetPosition() is Failure(StreamError.Closed), "Closed position")?
    _ = Assert.True(CompletedValue(output.Write(bytes, 0, 0)) is Failure(StreamError.Closed), "Closed empty write")?
    _ = Assert.True(CompletedValue(input.Read(bytes, 0, 0)) is Failure(StreamError.Closed), "Closed empty read")?
    _ = Assert.True(CompletedValue(output.Flush()) is Failure(StreamError.Closed), "Closed flush")?
    return Assert.True(seek.Seek(0) is Failure(StreamError.Closed), "Closed seek")
}

[Test]
func `MemoryStream async interfaces preserve complete writes short reads and EOF`() -> Result<unit, TestFailure> {
    let task = AsyncMemoryChecks.RoundTrip()
    // Observe settlement to assert the memory fast path; ordinary consumers await.
    let Some(Completed(result)) = task.Outcome else {
        return Assert.True(false, "Memory operations must settle without scheduled work")
    }
    return Assert.True(result, "Awaited memory exchange and settled outcomes")
}

internal class AsyncMemoryChecks {
    async static func RoundTrip() -> Task<bool> {
        let stream = MemoryStream()
        let input: InputStream = stream
        let output: OutputStream = stream
        let bytes: byte[] = [(byte)11, (byte)22, (byte)33]
        let written = await Write(output, bytes)
        let rewound = stream.Seek(0) is Ok(0L)
        let destination: byte[] = [(byte)99, (byte)99, (byte)99, (byte)99]
        let received = await input.Read(destination, 1, 3, CancellationToken.None)
        return Check(input, output, bytes, destination, written && rewound && received is Ok(2))
    }

    async static func Write(output: OutputStream, bytes: byte[]) -> Task<bool> {
        let result = await output.Write(bytes, 1, 2, CancellationToken.None)
        return result is Ok(_)
    }

    static func Check(input: InputStream, output: OutputStream, bytes: byte[], destination: byte[], validExchange: bool) -> bool {
        // Observe settled outcomes here to verify the memory fast path.
        let flushed = output.Flush(CancellationToken.None).Outcome
        let eof = input.Read(destination, 0, 1, CancellationToken.None).Outcome
        let empty = input.Read(destination, 4, 0, CancellationToken.None).Outcome
        input.Close()
        output.Close()
        let closedWrite = output.Write(bytes, 0, 0, CancellationToken.None).Outcome
        let closedFlush = output.Flush(CancellationToken.None).Outcome
        return validExchange
            && flushed is Some(Completed(Ok(_)))
            && eof is Some(Completed(Ok(0)))
            && empty is Some(Completed(Ok(0)))
            && closedWrite is Some(Completed(Failure(StreamError.Closed)))
            && closedFlush is Some(Completed(Failure(StreamError.Closed)))
            && destination[0] == 99 && destination[1] == 22 && destination[2] == 33 && destination[3] == 99
    }
}

[Test]
func `MemoryStream async cancellation and rejected ranges preserve storage`() -> Result<unit, TestFailure> {
    let stream = MemoryStream()
    use cancellation = CancellationTokenSource()
    cancellation.Cancel()
    let bytes: byte[] = [(byte)42]
    // Cancellation has no success value to await; inspect the documented outcome.
    _ = Assert.True(stream.Write(bytes, 0, 1, cancellation.Token).IsCancelled, "Cancelled write")?
    _ = Assert.True(stream.Read(bytes, -1, 1, cancellation.Token).IsCancelled, "Cancellation precedes range validation")?
    _ = Assert.True(stream.Flush(cancellation.Token).IsCancelled, "Cancelled flush")?
    _ = Assert.True(stream.GetLength() is Ok(0L) && stream.GetPosition() is Ok(0L), "No mutation on cancellation")?
    let Some(Completed(Failure(StreamError.InvalidRange))) = stream.Write(bytes, 2147483647, 1, CancellationToken.None).Outcome else {
        return Assert.True(false, "Overflow-safe range rejection")
    }
    _ = Assert.True(stream.Seek(65536) is Ok(_), "Quota boundary")?
    let Some(Completed(Failure(StreamError.LimitExceeded))) = stream.Write(bytes, 0, 1, CancellationToken.None).Outcome else {
        return Assert.True(false, "Quota rejection")
    }
    _ = Assert.True(stream.GetLength() is Ok(0L) && stream.GetPosition() is Ok(65536L), "Rejected writes preserve state")?
    stream.Close()
    return Assert.True(stream.Read(bytes, 0, 1, cancellation.Token).IsCancelled, "Pre-cancellation precedes closed state")
}

// These fixtures promise inline completion; observation verifies that contract.
// Consumers of potentially pending streams use await instead.
func CompletedValue<T>(operation: System.Concurrency.Tasks.Task<T>) -> T {
    let Some(Completed(value)) = operation.Outcome else {
        Panic("Expected an immediately completed fixture operation")
    }
    return value
}


[Test]
func `Omitted interface tokens are non cancellable while explicit tokens still cancel`() -> Result<(), TestFailure> {
    let stream = MemoryStream()
    let input: InputStream = stream
    let output: OutputStream = stream
    let bytes: byte[] = [(byte)42]
    _ = Assert.True(CompletedValue(output.Write(bytes, 0, 1)) is Ok(_), "Default output token")?
    _ = Assert.True(CompletedValue(output.Flush()) is Ok(_), "Default flush token")?
    _ = stream.Seek(0)
    let received: byte[] = [(byte)0]
    _ = Assert.True(CompletedValue(input.Read(received, offset: 0, count: 1)) is Ok(1), "Named call with omitted token")?
    _ = Assert.True(received[0] == 42, "Bytes survive default-token calls")?
    use cancellation = CancellationTokenSource()
    cancellation.Cancel()
    _ = Assert.True(input.Read(received, 0, 1, cancellationToken: cancellation.Token).IsCancelled, "Explicit input cancellation")?
    _ = Assert.True(output.Flush(cancellationToken: cancellation.Token).IsCancelled, "Explicit output cancellation")?
    stream.Close()
    return Ok(())
}

[Test]
func `Text and gzip factory defaults retain ownership and explicit encoding choices`() -> Result<(), TestFailure> {
    let owned = MemoryStream()
    let Ok(writer) = StreamWriter.Create(owned, Encodings.Utf8) else {
        return Assert.True(false, "Create encoded writer with omitted ownership")
    }
    writer.Close()
    _ = Assert.True(owned.GetLength() is Failure(StreamError.Closed), "Default writer owns its output")?
    let borrowed = MemoryStream()
    let Ok(reader) = StreamReader.Create(borrowed, leaveOpen: true) else {
        return Assert.True(false, "Create reader with explicit ownership")
    }
    reader.Close()
    _ = Assert.True(borrowed.GetLength() is Ok(0L), "Explicit leaveOpen is retained")?
    let Ok(syncReader) = SyncStreamReader.Create(borrowed, Encodings.Ascii, leaveOpen: true) else {
        return Assert.True(false, "Create explicit synchronous decoder")
    }
    syncReader.Close()
    let Ok(syncWriter) = SyncStreamWriter.Create(borrowed) else {
        return Assert.True(false, "Create synchronous writer with defaults")
    }
    syncWriter.Close()
    _ = Assert.True(borrowed.GetLength() is Failure(StreamError.Closed), "Default synchronous writer owns output")?
    let compressed = MemoryStream()
    GZipStream.CreateCompressor(compressed).Close()
    _ = Assert.True(compressed.GetLength() is Failure(StreamError.Closed), "Default compressor owns output")?
    let source = MemoryStream()
    GZipStream.CreateDecompressor(source, leaveOpen: true).Close()
    _ = Assert.True(source.GetLength() is Ok(0L), "Decompressor can borrow input")?
    source.Close()
    return Ok(())
}

[Test]
func `Watcher and time creation preserve omitted and explicit scalar defaults`() -> Result<(), TestFailure> {
    use all = FileSystemWatcher(path: ".")
    use json = FileSystemWatcher(".", filter: "*.json")
    _ = Assert.Equal("*", all.Filter)?
    _ = Assert.Equal("*.json", json.Filter)?
    let Ok(whole) = TimeOfDay.Create(1, 2, 3) else {
        return Assert.True(false, "Create whole-second time")
    }
    let Ok(fractional) = TimeOfDay.Create(1, 2, 3, fractionTicks: 7) else {
        return Assert.True(false, "Create fractional time")
    }
    _ = Assert.Equal(0, whole.FractionTicks)?
    return Assert.Equal(7, fractional.FractionTicks)
}
