module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Result.*
import System.Optional.*
import NeoClr.Testing.*

[Test]
func `Index preserves direction and resolves end boundaries`() -> Result<unit, TestFailure> {
    let start = Index.Start
    let end = Index.End
    let last: Index = ^1
    let converted: Index = 2
    _ = Assert.Equal(0, start.Value)?
    _ = Assert.True(!start.IsFromEnd && end.IsFromEnd, "Direction")?
    _ = Assert.Equal(4, end.GetOffset(4))?
    _ = Assert.Equal(3, last.GetOffset(4))?
    _ = Assert.Equal(3, (^1).GetOffset(4))?
    _ = Assert.Equal(2, converted.GetOffset(4))?
    _ = Assert.Equal(-1, Index.FromEnd(5).GetOffset(4))?
    _ = Assert.Equal("^1", last.ToString())?
    _ = Assert.Equal("2", converted.ToString())?
    return Assert.Equal(2147483647, Index.FromStart(2147483647).Value)
}

[Test]
func `Index and Range typed equality agrees with hashing`() -> Result<unit, TestFailure> {
    let first = Index.FromEnd(2)
    let same = Index(2, true)
    _ = Assert.True(first.Equals(same), "Index equality")?
    _ = Assert.Equal(first.GetHashCode(), same.GetHashCode())?
    _ = Assert.True(!first.Equals(Index.FromStart(2)), "Direction matters")?
    let left = Range(Index.FromStart(1), first)
    let right = Range(Index.FromStart(1), same)
    _ = Assert.True(left.Equals(right), "Range equality")?
    _ = Assert.Equal(left.GetHashCode(), right.GetHashCode())?
    return Assert.Equal("1..^2", left.ToString())
}

[Test]
func `Range resolution accepts empty and full boundaries`() -> Result<unit, TestFailure> {
    let all = Range.All
    let empty = all.GetOffsetAndLength(0)
    _ = Assert.True(empty.Item1 == 0 && empty.Item2 == 0, "Empty source")?
    let full = all.GetOffsetAndLength(4)
    _ = Assert.True(full.Item1 == 0 && full.Item2 == 4, "Full source")?
    let atEnd = Range(Index.End, Index.End).GetOffsetAndLength(4)
    _ = Assert.True(atEnd.Item1 == 4 && atEnd.Item2 == 0, "Empty at end")?
    let middle: Range = 1..^1
    let bounds = middle.GetOffsetAndLength(4)
    return Assert.True(bounds.Item1 == 1 && bounds.Item2 == 2, "Half-open range")
}

[Test]
func `Array range syntax supports omitted and end-relative boundaries`() -> Result<unit, TestFailure> {
    let values: int[] = [10, 20, 30, 40]
    let middle = values[1..^1]
    let prefix = values[..2]
    let suffix = values[2..]
    let all = values[..]
    let empty = values[^0..]
    let selected: Range = 1..3
    let stored = values[selected]
    let none: int[] = []
    let noneCopy = none[..]
    _ = Assert.True(stored.Length == 2 && stored[0] == 20, "Stored half-open range")?
    _ = Assert.Equal(0, noneCopy.Length)?
    _ = Assert.True(middle.Length == 2 && middle[0] == 20 && middle[1] == 30, "Middle")?
    _ = Assert.True(prefix.Length == 2 && prefix[1] == 20, "Prefix")?
    _ = Assert.True(suffix.Length == 2 && suffix[0] == 30, "Suffix")?
    _ = Assert.Equal(4, all.Length)?
    return Assert.Equal(0, empty.Length)
}

[Test]
func `Array indexes support values and from-end assignment`() -> Result<unit, TestFailure> {
    let values: int[] = [10, 20, 30]
    let last: Index = ^1
    _ = Assert.Equal(30, values[last])?
    values[^2] = 42
    values[last] = 99
    _ = Assert.Equal(42, values[1])?
    return Assert.Equal(99, values[^1])
}

[Test]
func `Array slices copy storage and preserve reference elements`() -> Result<unit, TestFailure> {
    let values: int[] = [10, 20, 30]
    let copy = values[..]
    copy[0] = 99
    _ = Assert.Equal(10, values[0])?
    let item = Box(7)
    let objects: Box[] = [item, Box(8)]
    let selected = objects[..1]
    _ = Assert.True(Object.ReferenceEquals(item, selected[0]), "Shallow copy")?
    selected[0] = Box(9)
    return Assert.True(Object.ReferenceEquals(item, objects[0]), "Independent array storage")
}

class Box {
    val Value: int
    init(value: int) { Value = value }
}

class ObservedArray {
    var Calls: int = 0
    private val values: int[] = [10, 20, 30]
    func Read() -> int[] {
        Calls = Calls * 10 + 1
        return values
    }
    func Boundary() -> int {
        Calls = Calls * 10 + 2
        return 1
    }
}

[Test]
func `Array indexing and slicing evaluate operands once in source order`() -> Result<unit, TestFailure> {
    let observed = ObservedArray()
    _ = Assert.Equal(30, observed.Read()[^observed.Boundary()])?
    _ = Assert.Equal(12, observed.Calls)?
    observed.Calls = 0
    let slice = observed.Read()[observed.Boundary()..^observed.Boundary()]
    _ = Assert.Equal(122, observed.Calls)?
    _ = Assert.Equal(1, slice.Length)?
    return Assert.Equal(20, slice[0])
}

struct MutableCounter {
    private var count: int
    func Next() -> int {
        count += 1
        return count
    }
}

class ReadOnlyCounter {
    private val counter: MutableCounter = default(MutableCounter)
    func Read() -> int => counter.Next() + counter.Next()
}

[Test]
func `Read-only value fields use defensive copies for method calls`() -> Result<unit, TestFailure> {
    let value = ReadOnlyCounter()
    _ = Assert.Equal(2, value.Read())?
    return Assert.Equal(2, value.Read())
}

[Test]
func `Array safe access returns options and results for invalid bounds`() -> Result<unit, TestFailure> {
    let values: int[] = [10, 20, 30]
    _ = Assert.True(values.Get(-1) is None, "Negative index")?
    _ = Assert.True(values.Get(3) is None, "Past end")?
    _ = Assert.True(values.Get(Index.End) is None, "End boundary is not an element")?
    _ = Assert.True(values.Get(Index.FromEnd(4)) is None, "Before start")?
    if values.Get(^1) is Some(let last) {
        _ = Assert.Equal(30, last)?
    } else {
        return Assert.True(false, "Last element missing")
    }
    _ = Assert.True(values.Slice(Range(2, 1)) is Failure(_), "Reversed range")?
    _ = Assert.True(values.Slice(Range(0, 4)) is Failure(_), "Past end range")?
    _ = Assert.True(Range.All.TryGetOffsetAndLength(-1) is Failure(_), "Negative length")?
    if values.Slice(1..^0) is Ok(let copy) {
        _ = Assert.Equal(2, copy.Length)?
        _ = Assert.Equal(20, copy[0])?
        copy[0] = 99
        _ = Assert.Equal(20, values[1])?
    } else {
        return Assert.True(false, "Valid slice missing")
    }
    let empty: int[] = []
    if empty.Slice(Range.All) is Ok(let copy) {
        return Assert.Equal(0, copy.Length)
    }
    return Assert.True(false, "Empty slice missing")
}

[Test]
func `String ranges preserve graphemes and half-open boundaries`() -> Result<unit, TestFailure> {
    let text = "Aé👩‍💻🇸🇪Z"
    _ = Assert.Equal(5, text.Length)?
    _ = Assert.Equal("é👩‍💻🇸🇪", text[1..^1])?
    _ = Assert.Equal("Aé", text[..2])?
    _ = Assert.Equal("🇸🇪Z", text[^2..])?
    _ = Assert.Equal(text, text[..])?
    _ = Assert.Equal("", text[^0..])?
    _ = Assert.Equal("", ""[..])?
    let last: Index = ^1
    _ = Assert.Equal("Z", text[last].ToString())?
    return Assert.Equal("👩‍💻", text[^3].ToString())
}

[Test]
func `String safe access rejects invalid grapheme bounds`() -> Result<unit, TestFailure> {
    let text = "é🙂"
    _ = Assert.True(text.Get(-1) is None, "Negative")?
    _ = Assert.True(text.Get(2) is None, "End")?
    _ = Assert.True(text.Get(Index.End) is None, "From end zero")?
    _ = Assert.True(text.Slice(Range(2, 1)) is Failure(_), "Reversed")?
    _ = Assert.True(text.Slice(Range(0, 3)) is Failure(_), "Past end")?
    _ = Assert.True(text.Slice(Range.StartAt(^3)) is Failure(_), "Before start")?
    if text.Get(^1) is Some(let last) {
        _ = Assert.Equal("🙂", last.ToString())?
    } else {
        return Assert.True(false, "Missing last grapheme")
    }
    if text.Slice(0..1) is Ok(let part) {
        return Assert.Equal("é", part)
    }
    return Assert.True(false, "Missing slice")
}

[Test]
func `String slicing evaluates receiver and bounds once`() -> Result<unit, TestFailure> {
    let observed = ObservedText()
    let part = observed.Read()[observed.Boundary()..^observed.Boundary()]
    _ = Assert.Equal(122, observed.Calls)?
    return Assert.Equal("é", part)
}

class ObservedText {
    var Calls: int = 0
    func Read() -> string {
        Calls = Calls * 10 + 1
        return "AéZ"
    }
    func Boundary() -> int {
        Calls = Calls * 10 + 2
        return 1
    }
}

[Test]
func `ArrayList supports directional mutation and independent range copies`() -> Result<unit, TestFailure> {
    let list = System.Collections.ArrayList<int>(8)
    list.Add(10)
    list.Add(20)
    list.Add(30)
    list[^1] = 40
    _ = Assert.Equal(40, list[^1])?
    let copy = list[1..^0]
    _ = Assert.Equal(2, copy.Length)?
    copy[0] = 99
    _ = Assert.Equal(20, list[1])?
    _ = Assert.Equal(0, list[^0..].Length)?
    _ = Assert.True(list.Get(Index.End) is None, "Count rather than capacity")?
    return Assert.True(list.Slice(0..4) is Failure(_), "Range excludes spare capacity")
}

[Test]
func `Sequence slicing consumes one iterator without indexed reads`() -> Result<unit, TestFailure> {
    let observed = ObservedSequence(5)
    let sequence: System.Collections.Sequence<int> = observed
    if sequence.Slice(1..^1) is Ok(let copy) {
        _ = Assert.Equal(3, copy.Length)?
        _ = Assert.Equal(2, copy[0])?
        _ = Assert.Equal(4, copy[2])?
    } else {
        return Assert.True(false, "Missing sequence slice")
    }
    _ = Assert.Equal(1, observed.Acquired)?
    _ = Assert.Equal(4, observed.Advanced)?
    _ = Assert.Equal(3, observed.Reads)?
    return Assert.Equal(1, observed.Disposed)
}

[Test]
func `Sequence invalid and empty slices do not acquire iterators`() -> Result<unit, TestFailure> {
    let observed = ObservedSequence(5)
    let sequence: System.Collections.Sequence<int> = observed
    _ = Assert.True(sequence.Slice(4..2) is Failure(_), "Reversed")?
    _ = Assert.True(sequence.Slice(..6) is Failure(_), "Past end")?
    _ = Assert.True(sequence.Get(5) is None, "Invalid index")?
    if sequence.Slice(^0..) is Ok(let copy) {
        _ = Assert.Equal(0, copy.Length)?
    } else {
        return Assert.True(false, "Missing empty slice")
    }
    return Assert.Equal(0, observed.Acquired)
}

[Test]
func `Sequence slicing disposes when enumeration ends before Count`() -> Result<unit, TestFailure> {
    let observed = ObservedSequence(2)
    let sequence: System.Collections.Sequence<int> = observed
    _ = Assert.True(sequence.Slice(1..4) is Failure(_), "Short source")?
    _ = Assert.Equal(1, observed.Reads)?
    return Assert.Equal(1, observed.Disposed)
}

[Test]
func `Sequence safe indexing and slicing work through array aliases`() -> Result<unit, TestFailure> {
    let values: int[] = [10, 20, 30]
    let sequence: System.Collections.Sequence<int> = values
    if sequence.Get(^1) is Some(let last) {
        _ = Assert.Equal(30, last)?
    } else {
        return Assert.True(false, "Last element")
    }
    if sequence.Slice(..2) is Ok(let copy) {
        copy[0] = 99
        return Assert.Equal(10, values[0])
    }
    return Assert.True(false, "Missing slice")
}

class ObservedSequence : System.Collections.Sequence<int> {
    private val available: int
    var Acquired: int = 0
    var Advanced: int = 0
    var Reads: int = 0
    var Disposed: int = 0
    init(available: int) { self.available = available }
    val Count: int => 5
    val self[index: int]: int {
        get {
            Panic("Slice must not read the sequence indexer")
            return 0
        }
    }
    func GetIterator() -> System.Collections.Iterator<int> {
        Acquired += 1
        return ObservedSequenceIterator(self, available)
    }
}

class ObservedSequenceIterator : System.Collections.Iterator<int> {
    private val owner: ObservedSequence
    private val available: int
    private var position: int = 0
    init(owner: ObservedSequence, available: int) {
        self.owner = owner
        self.available = available
    }
    func MoveNext() -> bool {
        owner.Advanced += 1
        position += 1
        return position <= available
    }
    val Current: int {
        get {
            owner.Reads += 1
            return position
        }
    }
    func Dispose() { owner.Disposed += 1 }
}


[Test]
func `Sequence extension indexers provide default access and independent slices`() -> Result<unit, TestFailure> {
    let values: int[] = [10, 20, 30]
    let sequence: Sequence<int> = values
    _ = Assert.Equal(30, sequence[^1])?
    let copy = sequence[1..]
    _ = Assert.Equal(2, copy.Length)?
    copy[0] = 99
    _ = Assert.Equal(20, values[1])?
    let observed: Sequence<int> = ObservedSequence(5)
    let fallback = observed[1..^1]
    return Assert.Equal(3, fallback.Length)
}

[Test]
func `Sequence slicing delegates to the list range contract`() -> Result<unit, TestFailure> {
    let observed = DirectList()
    let list: List<int> = observed
    list[^1] = 30
    _ = Assert.Equal(30, list[^1])?
    let sequence: Sequence<int> = list
    if sequence.Slice(1..) is Ok(let copy) {
        _ = Assert.Equal(1, observed.Slices)?
        _ = Assert.Equal(2, copy.Length)?
        copy[0] = 99
        _ = Assert.Equal(20, list[1])?
    } else {
        return Assert.True(false, "Expected list slice")
    }
    let fullCopy = sequence[..]
    _ = Assert.Equal(2, observed.Slices)?
    return Assert.Equal(3, fullCopy.Length)
}

class DirectList : List<int> {
    private val values: int[] = [10, 20, 3]
    var Slices: int = 0
    val Count: int => values.Length
    var self[index: int]: int {
        get => values[index]
        set { values[index] = value }
    }
    var self[index: Index]: int {
        get => values[index]
        set { values[index] = value }
    }
    val self[range: Range]: int[] {
        get {
            Slices += 1
            return values[range]
        }
    }
    func Add(value: int) { Panic("Fixed test list") }
    func GetIterator() -> Iterator<int> {
        Panic("List slicing must use the range indexer")
    }
}

extension TestListAccess for ArrayList<int> {
    var self[index: bool]: int {
        get => self[0]
        set { self[0] = value }
    }
}

[Test]
func `Native extension indexers support writes and compound assignment`() -> Result<unit, TestFailure> {
    let values = ArrayList<int>()
    values.Add(1)
    values[true] = 2
    values[true] += 40
    return Assert.Equal(42, values[true])
}
