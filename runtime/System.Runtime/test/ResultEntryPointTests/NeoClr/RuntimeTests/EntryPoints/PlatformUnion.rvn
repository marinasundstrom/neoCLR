module NeoClr.RuntimeTests.EntryPoints
import System.*
import System.Storage.*
import System.Result.*
import System.Concurrency.Tasks.*

async func Main(args: string[]) -> Task<Result<(), FileReadError | NumberParseError>> {
    await Task.CompletedTask
    if args.Length > 0 {
        if args[0] == "file" { return Failure(FileReadError.NotFound) }
        return Failure(NumberParseError.InvalidFormat)
    }
    return Ok(())
}
