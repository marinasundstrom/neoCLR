module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Result.*
import System.Text.*
import NeoClr.Testing.*

func Decoded(result: Result<string, EncodingError>, expected: string) -> Result<unit, TestFailure> {
    let Ok(text) = result else {
        return Failure(TestFailure("Decode", expected, "Error"))
    }
    return Assert.Equal(expected, text)
}

func Invalid(bytes: byte[]) -> Result<unit, TestFailure> {
    let decoder = Encodings.Utf8.CreateDecoder()
    _ = Assert.True(decoder.Decode(bytes, true) is Failure(EncodingError.InvalidUtf8), "Malformed UTF-8 rejected")?
    return Assert.True(decoder.Decode(bytes[..0], false) is Failure(EncodingError.Finished), "Malformed decoder is terminal")
}

[Test]
func `Encoding providers preserve UTF-8 and reject non-ASCII text`() -> Result<unit, TestFailure> {
    let source = "\u0000Aé😀é\u007f"
    let Ok(bytes) = Encodings.Utf8.Encode(source) else {
        return Failure(TestFailure("UTF-8 encode", "Ok", "Error"))
    }
    let Ok(text) = Encodings.Utf8.Decode(ArrayList<byte>(bytes)[..]) else {
        return Failure(TestFailure("UTF-8 round trip", "Ok", "Error"))
    }
    _ = Assert.Equal(source, text)?
    let Ok(ascii) = Encodings.Ascii.Encode("\u0000A\u007f") else {
        return Failure(TestFailure("ASCII encode", "Ok", "Error"))
    }
    _ = Assert.Equal(3, ascii.Count)?
    _ = Assert.True(ascii[0] == 0 && ascii[1] == 65 && ascii[2] == 127, "ASCII byte identity")?
    return Assert.True(Encodings.Ascii.Encode("prefix é") is Failure(EncodingError.UnrepresentableText), "Strict ASCII")
}

[Test]
func `UTF-8 decoding preserves text at every byte split`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [(byte)65, (byte)195, (byte)169, (byte)226, (byte)130, (byte)172, (byte)240, (byte)159, (byte)152, (byte)128]
    for split in 0..=(bytes.Length) {
        let decoder = Encodings.Utf8.CreateDecoder()
        let Ok(first) = decoder.Decode(bytes[..split], false) else {
            return Failure(TestFailure("First fragment", "Ok", "Error"))
        }
        let Ok(last) = decoder.Decode(bytes[split..], true) else {
            return Failure(TestFailure("Last fragment", "Ok", "Error"))
        }
        _ = Assert.Equal("Aé€😀", first + last)?
    }
    return Assert.True(true, "All split points")
}

[Test]
func `UTF-8 decoders reject malformed scalars and truncated final input`() -> Result<unit, TestFailure> {
    _ = Invalid([(byte)128])?
    _ = Invalid([(byte)192, (byte)175])?
    _ = Invalid([(byte)224, (byte)128, (byte)128])?
    _ = Invalid([(byte)237, (byte)160, (byte)128])?
    _ = Invalid([(byte)244, (byte)144, (byte)128, (byte)128])?
    _ = Invalid([(byte)65, (byte)226, (byte)65])?
    return Invalid([(byte)240, (byte)159, (byte)152])
}

[Test]
func `Decoder sessions copy pending input and preserve BOM data`() -> Result<unit, TestFailure> {
    let first = Encodings.Utf8.CreateDecoder()
    let second = Encodings.Utf8.CreateDecoder()
    let head: byte[] = [(byte)195]
    let tail: byte[] = [(byte)169]
    _ = Decoded(first.Decode(head[..1], false), "")?
    head[0] = (byte)65
    _ = Decoded(second.Decode(head[..1], true), "A")?
    _ = Decoded(first.Decode(tail[..1], true), "é")?
    _ = Assert.True(first.Decode(tail[..0], false) is Failure(EncodingError.Finished), "Final decode is terminal")?
    let bom: byte[] = [(byte)239, (byte)187, (byte)191, (byte)65]
    return Decoded(Encodings.Utf8.CreateDecoder().Decode(bom[..4], true), "\ufeffA")
}

[Test]
func `Decoder windows preserve text and ASCII errors are terminal`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [(byte)0, (byte)65, (byte)127]
    let decoder = Encodings.Ascii.CreateDecoder()
    _ = Decoded(decoder.Decode(bytes[..3], false), "\u0000A\u007f")?
    _ = Decoded(decoder.Decode(bytes[3..3], true), "")?
    let strict = Encodings.Ascii.CreateDecoder()
    let invalid: byte[] = [(byte)65, (byte)128]
    _ = Assert.True(strict.Decode(invalid[..2], false) is Failure(EncodingError.InvalidData), "Strict ASCII bytes")?
    return Assert.True(strict.Decode(bytes[..1], false) is Failure(EncodingError.Finished), "Invalid ASCII is terminal")
}

[Test]
func `Encoders preserve accepted input through one-byte drains`() -> Result<unit, TestFailure> {
    let encoder = Encodings.Utf8.CreateEncoder()
    var source = "é😀é"
    _ = Assert.True(encoder.Accept(source, false) is Ok(_), "Accept source")?
    source = "changed"
    _ = Assert.True(encoder.Accept("other", false) is Failure(EncodingError.Busy), "Pending input cannot be overwritten")?
    let buffer: byte[] = [(byte)99, (byte)99, (byte)99]
    let Ok(zero) = encoder.Drain(buffer[1..1]) else {
        return Failure(TestFailure("Zero drain", "Ok", "Error"))
    }
    _ = Assert.True(zero.BytesWritten == 0 && zero.State is EncoderState.NeedsOutput, "Explicit zero progress")?
    let output = ArrayList<byte>()
    for index in 0..9 {
        let Ok(step) = encoder.Drain(buffer[1..2]) else {
            return Failure(TestFailure("Drain", "Ok", "Error"))
        }
        _ = Assert.True(step.BytesWritten == 1 && buffer[0] == 99 && buffer[2] == 99, "Only offered byte changed")?
        output.Add(buffer[1])
        if index == 8 {
            _ = Assert.True(step.State is EncoderState.Ready, "All bytes drained")?
        } else {
            _ = Assert.True(step.State is EncoderState.NeedsOutput, "More bytes pending")?
        }
    }
    let Ok(text) = Encodings.Utf8.Decode(output[..]) else {
        return Failure(TestFailure("Drained bytes", "UTF-8", "Error"))
    }
    _ = Assert.Equal("é😀é", text)?
    _ = Assert.True(encoder.Accept("", true) is Ok(_), "Empty final input")?
    let Ok(final) = encoder.Drain(buffer[..0]) else {
        return Failure(TestFailure("Final drain", "Ok", "Error"))
    }
    _ = Assert.True(final.State is EncoderState.Finished && final.BytesWritten == 0, "Empty final completion")?
    _ = Assert.True(encoder.Accept("", false) is Failure(EncodingError.Finished), "Accept after finish")?
    return Assert.True(encoder.Drain(buffer[..1]) is Failure(EncodingError.Finished), "Drain after finish")
}

[Test]
func `Encoder chunks preserve scalars across the internal byte boundary`() -> Result<unit, TestFailure> {
    var prefix = "x"
    for index in 0..8 {
        prefix = prefix + prefix
    }
    let Ok(head) = prefix.SliceUtf8(0, 255) else {
        return Failure(TestFailure("Prefix", "255 bytes", "Error"))
    }
    let source = head + "😀é"
    let encoder = Encodings.Utf8.CreateEncoder()
    _ = Assert.True(encoder.Accept(source, true) is Ok(_), "Accept boundary text")?
    let buffer: byte[] = [(byte)0, (byte)0, (byte)0]
    let output = ArrayList<byte>()
    var finished = false
    for attempt in 0..88 {
        if !finished {
            let Ok(step) = encoder.Drain(buffer[..3]) else {
                return Failure(TestFailure("Boundary drain", "Ok", "Error"))
            }
            for index in 0..step.BytesWritten {
                output.Add(buffer[index])
            }
            finished = step.State is EncoderState.Finished
        }
    }
    _ = Assert.True(finished, "Bounded drain must complete")?
    let Ok(text) = Encodings.Utf8.Decode(output[..]) else {
        return Failure(TestFailure("Boundary bytes", "UTF-8", "Error"))
    }
    return Assert.Equal(source, text)
}

[Test]
func `ASCII encoder preflight is retryable and factories are independent`() -> Result<unit, TestFailure> {
    let provider = Encodings.Ascii
    let first = provider.CreateEncoder()
    let second = provider.CreateEncoder()
    _ = Assert.True(first.Accept("prefix é", true) is Failure(EncodingError.UnrepresentableText), "Strict preflight")?
    _ = Assert.True(first.Accept("A", true) is Ok(_), "Retry after preflight")?
    _ = Assert.True(second.Accept("B", true) is Ok(_), "Independent acceptance")?
    let buffer: byte[] = [(byte)0]
    let Ok(a) = first.Drain(buffer) else {
        return Failure(TestFailure("First drain", "Ok", "Error"))
    }
    _ = Assert.True(a.BytesWritten == 1 && a.State is EncoderState.Finished && buffer[0] == 65, "First session")?
    let Ok(b) = second.Drain(buffer) else {
        return Failure(TestFailure("Second drain", "Ok", "Error"))
    }
    return Assert.True(b.BytesWritten == 1 && b.State is EncoderState.Finished && buffer[0] == 66, "Second session")
}

[Test]
func `One-shot decoding preserves Unicode BOM NUL and empty sequences`() -> Result<unit, TestFailure> {
    let text = "\uFEFF\u0000Aé😀"
    let Ok(bytes) = Encodings.Utf8.Encode(text) else {
        return Failure(TestFailure("One-shot encode", "Ok", "Error"))
    }
    _ = Decoded(Encodings.Utf8.Decode(ArrayList<byte>(bytes)[..]), text)?
    let empty = Array<byte>.Empty
    _ = Decoded(Encodings.Utf8.Decode(empty), "")?
    _ = Decoded(Encodings.Ascii.Decode(empty), "")?
    let ascii: byte[] = [(byte)0, (byte)65, (byte)127]
    return Decoded(Encodings.Ascii.Decode(ascii), "\u0000A\u007f")
}

[Test]
func `One-shot errors do not poison providers and results are snapshots`() -> Result<unit, TestFailure> {
    let bad: byte[] = [(byte)195]
    let overlong: byte[] = [(byte)192, (byte)128]
    _ = Assert.True(Encodings.Utf8.Decode(bad) is Failure(EncodingError.InvalidUtf8), "Truncated scalar rejected")?
    _ = Assert.True(Encodings.Utf8.Decode(overlong) is Failure(EncodingError.InvalidUtf8), "Overlong scalar rejected")?
    _ = Assert.True(Encodings.Ascii.Decode(bad) is Failure(EncodingError.InvalidData), "Non-ASCII byte rejected")?
    let good: byte[] = [(byte)65]
    let Ok(text) = Encodings.Utf8.Decode(good) else {
        return Failure(TestFailure("Retry after one-shot error", "Ok", "Error"))
    }
    good[0] = (byte)66
    _ = Assert.Equal("A", text)?
    return Decoded(Encodings.Ascii.Decode(good), "B")
}

[Test]
func `One-shot decoding borrows only its window and owns its result`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [(byte)255, (byte)195, (byte)169, (byte)0, (byte)65, (byte)255]
    let Ok(text) = Encodings.Utf8.Decode(bytes[1..5]) else {
        return Failure(TestFailure("Borrowed window", "Ok", "Error"))
    }
    bytes[1] = (byte)66
    _ = Assert.Equal("é\u0000A", text)?
    _ = Decoded(Encodings.Utf8.Decode(bytes[6..]), "")?
    _ = Decoded(Encodings.Ascii.Decode(bytes[3..5]), "\u0000A")?
    return Assert.True(Encodings.Utf8.Decode(bytes[..1]) is Failure(EncodingError.InvalidUtf8), "Invalid window")
}
