import System.*
import System.Result.*
import NeoClr.Testing.*

class CallbackState {
    var Value: int = 0
    func Add(value: int) -> int {
        Value += value
        return Value
    }
}

func AddOne(value: int) -> int => value + 1

[Test]
unsafe func `Native callbacks accept Raven module functions`() -> Result<unit, TestFailure> {
    return Assert.Equal(42, Apply(AddOne, 41))
}

[Test]
unsafe func `Native callbacks preserve captures across repeated calls`() -> Result<unit, TestFailure> {
    let state = CallbackState()
    let callback: (int) -> int = value => {
        state.Value += 1
        System.Runtime.GC.Collect()
        return value + state.Value
    }
    let result = Twice(callback, 19)
    _ = Assert.Equal(42, result)?
    return Assert.Equal(2, state.Value)
}

[Test]
unsafe func `Native callbacks retain bound receivers for the call`() -> Result<unit, TestFailure> {
    let state = CallbackState()
    let result = Apply(state.Add, 42)
    _ = Assert.Equal(42, state.Value)?
    return Assert.Equal(42, result)
}

[Test]
unsafe func `Native unit callbacks discard the logical Void result`() -> Result<unit, TestFailure> {
    let state = CallbackState()
    let callback: (int) -> unit = value => {
        System.Runtime.GC.Collect()
        state.Value = value
    }
    Notify(callback, 42)
    return Assert.Equal(42, state.Value)
}

static class CallbackResults {
    static func Empty<T>(value: int) -> T => default(T)
}

[Test]
unsafe func `Native callbacks preserve generic unit value returns`() -> Result<unit, TestFailure> {
    let callback: (int) -> unit = CallbackResults.Empty<unit>
    let value: System.Void = callback(1)
    Notify(callback, 2)
    let same: unit = value
    _ = same
    return Ok(())
}

[Test]
unsafe func `Native returned functions remain callable across collection`() -> Result<unit, TestFailure> {
    let function = GetFunction()
    System.Runtime.GC.Collect()
    _ = Assert.Equal(42, function(41))?
    return Assert.Equal(42, Apply(function, 41))
}

[Test]
unsafe func `Native returned void functions produce logical unit values`() -> Result<unit, TestFailure> {
    let function = GetNotification()
    System.Runtime.GC.Collect()
    let value: System.Void = function(42)
    let same: unit = value
    _ = same
    _ = Assert.Equal(42, NotificationValue())?
    Notify(function, 43)
    return Assert.Equal(43, NotificationValue())
}
