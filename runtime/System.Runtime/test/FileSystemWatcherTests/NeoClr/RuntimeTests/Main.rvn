module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedWatcherTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main(args: string[]) -> Task<int> {
    if args.Length != 1 { Panic("Expected fixture directory") }
    // Keep explicit async execution and the host-driven filesystem phase order.
    let suite = TestSuite()
    let defaults = CompletedWatcherTest(`Watchers start disabled and disposal permanently closes them`())
    suite.Add("filewatch-defaults", "Watchers start disabled and disposal permanently closes them", defaults.Invoke)
    let setup = CompletedWatcherTest(`Watcher setup preserves invalid and missing directory errors`())
    suite.Add("filewatch-setup", "Watcher setup preserves invalid and missing directory errors", setup.Invoke)
    let physical = CompletedWatcherTest(await `Physical notifications filter descendants and respect stop restart and disposal`(args[0]))
    suite.Add("filewatch-physical", "Physical notifications filter descendants and respect stop restart and disposal", physical.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
