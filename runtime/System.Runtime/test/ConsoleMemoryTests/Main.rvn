module NeoClr.RuntimeTests

import System.*
import NeoClr.Testing.*

func Main(arguments: string[]) -> int {
    if arguments.Length == 2 && arguments[0] == "--guard" {
        let bytes: byte[] = [(byte)165, (byte)40, (byte)0, (byte)255, (byte)166]
        let source: ReadOnlySlice<byte> = bytes
        let output = Console.OpenStandardOutput()
        if arguments[1] == "negative" {
            _ = output.Write(source.Slice(-1, 1))
        }
        if arguments[1] == "oversized" {
            _ = output.Write(source.Slice(4, 2))
        }
        if arguments[1] == "beyond-end" {
            _ = output.Write(source.Slice(6, 0))
        }
        Console.WriteLine("ERROR invalid window did not fault")
        return 0
    }
    let suite = TestSuite()
    RegisterDiscoveredTests(suite)
    // Success reporting would contaminate the binary streams under test.
    let report = suite.Run()
    if report.ExitCode != 0 {
        ConsoleReporter.Write(report)
    }
    return report.ExitCode
}
