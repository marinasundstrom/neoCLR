module NeoClr.RuntimeTests

import System.*
import System.Result.*
import NeoClr.Testing.*

[Test("Decimal arithmetic preserves exact base ten values")]
func AArithmetic() -> Result<unit, TestFailure> {
    let a = Decimal(1, 0, 0, false, (byte)1)
    let b = Decimal(2, 0, 0, false, (byte)1)
    _ = Assert.Equal("0.3", (a + b).ToString())?
    _ = Assert.Equal("0.02", (a * b).ToString())?
    _ = Assert.Equal("0.5", (a / b).ToString())?
    _ = Assert.Equal("-0.1", (a - b).ToString())?
    _ = Assert.Equal("1", (Decimal(7) % Decimal(3)).ToString())?
    return Assert.Equal("79228162514264337593543950335", Decimal.MaxValue.ToString())
}

[Test("Decimal equality normalizes scale without changing storage")]
func BEquality() -> Result<unit, TestFailure> {
    let a = Decimal(10, 0, 0, false, (byte)1)
    let b = Decimal(100, 0, 0, false, (byte)2)
    _ = Assert.True(a == b && a.Equals(b), "Numerical equality")?
    _ = Assert.True(a.GetHashCode() == b.GetHashCode(), "Matching hashes")?
    _ = Assert.Equal("1.00", b.ToString())?
    let zero = Decimal(0, 0, 0, true, (byte)3)
    _ = Assert.True(zero == Decimal.Zero && Decimal.IsNegative(zero), "Signed zero")?
    return Assert.Equal("0.000", zero.ToString())
}

[Test("Decimal parsing formatting and rounding preserve precision")]
func CText() -> Result<unit, TestFailure> {
    let Ok(a) = Decimal.Parse("1234.565") else { return Assert.True(false, "Parse") }
    _ = Assert.Equal("1234.56", Decimal.Round(a, 2).ToString())?
    _ = Assert.Equal("1234.56", a.ToString("F2", Globalization.Culture.Invariant))?
    _ = Assert.Equal("-2", Decimal.Floor(Decimal(15, 0, 0, true, (byte)1)).ToString())?
    let Ok(third) = Decimal.Parse("0.3333333333333333333333333333") else { return Assert.True(false, "Parse third") }
    return Assert.True(Decimal(1) / Decimal(3) == third, "Division precision")
}

[Test("Decimal syntax uses ordinary value method contracts")]
func DSyntax() -> Result<unit, TestFailure> {
    let a: decimal = 1.25m
    let b: decimal = 2
    _ = Assert.Equal("3.25", DecimalSum(a, b).ToString())?
    _ = Assert.Equal("3.25", (a + b).ToString())?
    _ = Assert.Equal("-1.25", (-a).ToString())?
    let boxed: object = a
    _ = Assert.True(boxed.Equals(a), "Boxed equality")?
    let typed: EquatableTo<Decimal> = a
    return Assert.True(typed.Equals(a), "Typed equality contract")
}

[Test("Decimal boundaries reject overflow and round midpoint ties")]
func EBoundaries() -> Result<unit, TestFailure> {
    let Ok(maximum) = Decimal.Parse("79228162514264337593543950335") else { return Assert.True(false, "Maximum parse") }
    _ = Assert.True(maximum == Decimal.MaxValue, "Maximum value")?
    var result = Decimal.One
    _ = Assert.True(!Decimal.TryParse("79228162514264337593543950336", out result) && result == Decimal.Zero, "Overflow resets output")?
    _ = Assert.True(!Decimal.TryParse("1234567890123456789012345678901234567890123456789012345678901234567890123456789012345", out result), "Long integer overflow")?
    let Ok(even) = Decimal.Parse("0.00000000000000000000000000005") else { return Assert.True(false, "Even midpoint") }
    let Ok(odd) = Decimal.Parse("0.00000000000000000000000000015") else { return Assert.True(false, "Odd midpoint") }
    _ = Assert.True(even == Decimal.Zero, "Tie rounds to zero")?
    _ = Assert.Equal("0.0000000000000000000000000002", odd.ToString())?
    let words = Decimal.GetBits(maximum)
    return Assert.True(words[0] == -1 && words[1] == -1 && words[2] == -1 && words[3] == 0, "Maximum representation")
}

[Test("Decimal culture formatting and representation use existing contracts")]
func GContracts() -> Result<unit, TestFailure> {
    let culture = Globalization.Culture.SwedishSweden
    let Ok(value) = Decimal.Parse("1 234,50", culture) else { return Assert.True(false, "Culture parsing") }
    let text: Formattable = value
    _ = Assert.Equal("1 234,50", text.ToString("N2", culture))?
    let words = Decimal.GetBits(value)
    _ = Assert.True(words.Length == 4 && words[0] == 123450 && words[3] == 131072, "Representation words")?
    _ = Assert.Equal("1234.50", value.ToString())?
    return Assert.Equal("-9223372036854775808", Decimal(Int64.MinValue).ToString())
}

func DecimalSum<T>(left: T, right: T) -> T where T: Number => left + right
