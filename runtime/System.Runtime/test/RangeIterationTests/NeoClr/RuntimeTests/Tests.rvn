module NeoClr.RuntimeTests

import System.*
import System.Result.*
import NeoClr.Testing.*

[Test]
func `Int32 range terminates at inclusive maximum with continue`() -> Result<unit, TestFailure> {
    var count = 0
    for value in 2147483646..=2147483647 {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(2, count)
}

[Test]
func `Int32 range terminates at overshooting positive step`() -> Result<unit, TestFailure> {
    var count = 0
    for value in 2147483646..=2147483647 by 2 {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(1, count)
}

[Test]
func `Int32 range terminates at inclusive minimum with continue`() -> Result<unit, TestFailure> {
    var count = 0
    for value in -2147483647..=-2147483648 by -1 {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(2, count)
}

[Test]
func `Int32 range terminates at minimum valued step`() -> Result<unit, TestFailure> {
    var count = 0
    for value in 0..=-2147483648 by -2147483648 {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(2, count)
}

[Test]
func `Int64 range terminates at inclusive maximum with continue`() -> Result<unit, TestFailure> {
    var count = 0
    for value in 9223372036854775806L..=9223372036854775807L {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(2, count)
}

[Test]
func `Int64 range terminates at overshooting positive step`() -> Result<unit, TestFailure> {
    var count = 0
    for value in 9223372036854775806L..=9223372036854775807L by 2L {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(1, count)
}

[Test]
func `Int64 range terminates at inclusive minimum with continue`() -> Result<unit, TestFailure> {
    var count = 0
    for value in -9223372036854775807L..=-9223372036854775808L by -1L {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(2, count)
}

[Test]
func `Int64 range terminates at minimum valued step`() -> Result<unit, TestFailure> {
    var count = 0
    for value in 0L..=-9223372036854775808L by -9223372036854775808L {
        count += 1
        _ = Assert.True(count <= 3, "Iteration must stop before wrapping")?
        continue
    }
    return Assert.Equal(2, count)
