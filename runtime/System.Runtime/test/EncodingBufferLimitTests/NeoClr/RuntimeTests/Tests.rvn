module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Text.*
import NeoClr.Testing.*

[Test]
func `UTF-8 decoder quota rejection preserves an incomplete scalar`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [for index in 0..65537 => (byte)120]
    let decoder = Encodings.Utf8.CreateDecoder()
    let head: byte[] = [(byte)195]
    let Ok(prefix) = decoder.Decode(head[..1], false) else {
        return Failure(TestFailure("Pending scalar", "Ok", "Error"))
    }
    _ = Assert.Equal("", prefix)?
    _ = Assert.True(decoder.Decode(bytes[..65537], true) is Failure(EncodingError.LimitExceeded), "Oversized final input rejected")?
    bytes[0] = (byte)169
    let Ok(text) = decoder.Decode(bytes[..1], true) else {
        return Failure(TestFailure("Retry scalar", "Ok", "Error"))
    }
    return Assert.Equal("é", text)
}

[Test]
func `ASCII decoder accepts the maximum input after rejecting an oversized call`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [for index in 0..65537 => (byte)120]
    let decoder = Encodings.Ascii.CreateDecoder()
    _ = Assert.True(decoder.Decode(bytes, true) is Failure(EncodingError.LimitExceeded), "Oversized ASCII input rejected")?
    let Ok(text) = decoder.Decode(bytes[1..65537], true) else {
        return Failure(TestFailure("Maximum ASCII input", "Ok", "Error"))
    }
    _ = Assert.Equal(65536, text.GetUtf8ByteCount())?
    return Assert.True(text.StartsWithOrdinal("xxx") && text.EndsWithOrdinal("xxx"), "Maximum input content")
}

[Test]
func `Encoder drain quotas preserve accepted text and destination bytes`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [for index in 0..65538 => (byte)99]
    let encoder = Encodings.Utf8.CreateEncoder()
    _ = Assert.True(encoder.Accept("é😀", true) is Ok(_), "Accept final text")?
    _ = Assert.True(encoder.Drain(bytes[1..65538]) is Failure(EncodingError.LimitExceeded), "Oversized drain rejected")?
    _ = Assert.True(bytes[0] == 99 && bytes[1] == 99 && bytes[65537] == 99, "Rejected drain leaves destination")?
    let Ok(step) = encoder.Drain(bytes[1..65537]) else {
        return Failure(TestFailure("Maximum drain capacity", "Ok", "Error"))
    }
    _ = Assert.True(step.State is EncoderState.Finished && step.BytesWritten == 6, "Maximum capacity drains only pending bytes")?
    _ = Assert.True(bytes[0] == 99 && bytes[7] == 99 && bytes[65537] == 99, "Outside output remains untouched")?
    let Ok(text) = Encodings.Utf8.CreateDecoder().Decode(bytes[1..7], true) else {
        return Failure(TestFailure("Drained bytes", "UTF-8", "Error"))
    }
    return Assert.Equal("é😀", text)
}

[Test]
func `UTF-8 decoder maximum input counts new bytes separately from carried bytes`() -> Result<unit, TestFailure> {
    let bytes: byte[] = [for index in 0..65536 => (byte)120]
    let head: byte[] = [(byte)240, (byte)159, (byte)152]
    let decoder = Encodings.Utf8.CreateDecoder()
    _ = Assert.True(decoder.Decode(head[..3], false) is Ok(""), "Carry three bytes")?
    bytes[0] = (byte)128
    let Ok(text) = decoder.Decode(bytes[..65536], true) else {
        return Failure(TestFailure("Maximum chunk with carry", "Ok", "Error"))
    }
    _ = Assert.Equal(65539, text.GetUtf8ByteCount())?
    return Assert.True(text.StartsWithOrdinal("😀") && text.EndsWithOrdinal("xxx"), "Carry is emitted exactly once")
}

[Test]
func `Native buffer comprehensions preserve selector indices and range endpoints`() -> Result<unit, TestFailure> {
    let seed = 7
    let values: int[] = [for index in 2..=4 => index + seed]
    _ = Assert.True(values.Length == 3 && values[0] == 9 && values[1] == 10 && values[2] == 11, "Inclusive range and selector")?
    let empty: int[] = [for index in 4..4 => index]
    _ = Assert.Equal(0, empty.Length)?
    let reversed: int[] = [for index in 4..=2 => index]
    _ = Assert.Equal(0, reversed.Length)?
    let limit: int[] = [for index in 2147483647..=2147483647 => index]
    return Assert.True(limit.Length == 1 && limit[0] == 2147483647, "Inclusive maximum does not overflow")
}

[Test]
func `One-shot decoding enforces byte limits and accepts the maximum`() -> Result<unit, TestFailure> {
    let oversized: byte[] = [for index in 0..65537 => (byte)120]
    _ = Assert.True(Encodings.Utf8.Decode(oversized) is Failure(EncodingError.LimitExceeded), "UTF-8 quota")?
    _ = Assert.True(Encodings.Ascii.Decode(oversized) is Failure(EncodingError.LimitExceeded), "ASCII quota")?
    let maximum: byte[] = [for index in 0..65536 => (byte)120]
    let Ok(utf8) = Encodings.Utf8.Decode(maximum) else {
        return Failure(TestFailure("Maximum UTF-8 decode", "Ok", "Error"))
    }
    let Ok(ascii) = Encodings.Ascii.Decode(maximum) else {
        return Failure(TestFailure("Maximum ASCII decode", "Ok", "Error"))
    }
    _ = Assert.Equal(65536, utf8.GetUtf8ByteCount())?
    return Assert.Equal(utf8, ascii)
}
