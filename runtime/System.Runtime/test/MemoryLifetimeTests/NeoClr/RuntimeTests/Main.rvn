module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// The discovery runner is synchronous. Await these lifecycle tests explicitly.
func Report(result: Result<unit, TestFailure>, name: string) {
    if result is Failure(_) { Panic(name) }
    Console.WriteLine("PASS " + name)
}

async func Main() -> Task<int> {
    Report(await ARead(), "Pending Memory destinations survive collection and preserve surrounding bytes")
    Report(await BWrite(), "Pending ReadOnlyMemory sources survive repeated suspension and collection")
    Report(await CCancel(), "Cancelled and rejected Memory transfers do not write or resume twice")
    Report(await DEmpty(), "Default and end-position Memory windows remain empty after suspension")
    Console.WriteLine("Tests: 4, passed: 4, failed: 0, skipped: 0")
    return 0
}
