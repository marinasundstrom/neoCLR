module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// Store the completed result in a reference owner; the native compiler does not
// support directly capturing this Result value in a closure.
class CompletedMemoryTest {
    private val outcome: Result<unit, TestFailure>

    init(outcome: Result<unit, TestFailure>) {
        self.outcome = outcome
    }

    func Invoke() -> Result<unit, TestFailure> {
        return match outcome {
            Ok(_) => Ok(())
            Failure(let failure) => Failure(failure)
        }
    }
}

async func Main() -> Task<int> {
    // Discovery is synchronous; preserve the explicit sequential lifecycle awaits.
    let suite = TestSuite()
    let destination = CompletedMemoryTest(await `Pending Memory destinations survive collection and preserve surrounding bytes`())
    suite.Add("memory-lifetimes-destination", "Pending Memory destinations survive collection and preserve surrounding bytes", destination.Invoke)
    let source = CompletedMemoryTest(await `Pending ReadOnlyMemory sources survive repeated suspension and collection`())
    suite.Add("memory-lifetimes-source", "Pending ReadOnlyMemory sources survive repeated suspension and collection", source.Invoke)
    let cancellation = CompletedMemoryTest(await `Cancelled and rejected Memory transfers do not write or resume twice`())
    suite.Add("memory-lifetimes-cancellation", "Cancelled and rejected Memory transfers do not write or resume twice", cancellation.Invoke)
    let empty = CompletedMemoryTest(await `Default and end-position Memory windows remain empty after suspension`())
    suite.Add("memory-lifetimes-empty", "Default and end-position Memory windows remain empty after suspension", empty.Invoke)
    let report = suite.Run()
    ConsoleReporter.Write(report)
    return report.ExitCode
}
