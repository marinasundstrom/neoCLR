module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Linq.*
import System.Optional.*
import System.Result.*
import NeoClr.Testing.*

[Test]
func `For completion disposes its iterator`() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    var sum = 0
    for value in input {
        sum = sum + value
    }
    _ = Assert.Equal(10, sum)?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test]
func `For continue preserves traversal and disposal`() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    for value in input {
        continue
    }
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test]
func `For return disposes before returning to its caller`() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.Equal(1, FirstFromLoop(input))?
    return CheckObservation(input, 1, 1, 1, 1)
}

[Test]
func `Labeled continue disposes each inner iterator`() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    outer: for value in input {
        for other in input {
            continue outer
        }
    }
    return CheckObservation(input, 5, 9, 8, 5)
}

[Test]
func `For disposes an empty iterator`() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    input.Limit = 0
    for value in input {
        return Assert.True(false, "Empty input must not enter the loop")
    }
    return CheckObservation(input, 1, 1, 0, 1)
}

func FirstFromLoop(input: Iterable<int>) -> int {
    for value in input {
        return value
    }
    return 0
}
