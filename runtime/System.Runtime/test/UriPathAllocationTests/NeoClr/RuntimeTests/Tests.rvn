module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Storage.Path
import NeoClr.Testing.*

[Test]
func `Path parsing allocates only the requested value`() -> Result<unit, TestFailure> {
    let text = "notes/naïve.txt"
    _ = Path.Parse(text)
    let before = System.Runtime.GC.AllocatedObjectCount
    var index = 0
    var valid = true
    while index < 32 {
        valid = valid && (Path.Parse(text) is Ok(_))
        index += 1
    }
    let allocated = System.Runtime.GC.AllocatedObjectCount - before
    _ = Assert.True(valid, "Paths remain valid")?
    return Assert.True(allocated == 32, String.Concat("Path parse objects: ", allocated.ToString()))
}

[Test]
func `URI parsing allocates only the requested value`() -> Result<unit, TestFailure> {
    let text = "https://example.test/a/b?q=one#part"
    _ = Uri.Parse(text)
    let before = System.Runtime.GC.AllocatedObjectCount
    var index = 0
    var valid = true
    while index < 32 {
        valid = valid && (Uri.Parse(text) is Ok(_))
        index += 1
    }
    let allocated = System.Runtime.GC.AllocatedObjectCount - before
    _ = Assert.True(valid, "URIs remain valid")?
    return Assert.True(allocated == 32, String.Concat("URI parse objects: ", allocated.ToString()))
}

[Test]
func `URI string resolution avoids encoded buffers and reparsing`() -> Result<unit, TestFailure> {
    let Ok(baseUri) = Uri.Parse("http://example.test/a/b/c?q=one") else { return Assert.True(false, "Base URI") }
    let reference = "../d?x=two#part"
    _ = baseUri.Resolve(reference)
    let before = System.Runtime.GC.AllocatedObjectCount
    var index = 0
    var valid = true
    while index < 32 {
        valid = valid && (baseUri.Resolve(reference) is Ok(_))
        index += 1
    }
    let allocated = System.Runtime.GC.AllocatedObjectCount - before
    _ = Assert.True(valid, "Resolved URIs remain valid")?
    return Assert.True(allocated == 64, String.Concat("URI string resolution objects: ", allocated.ToString()))
}

[Test]
func `URI value resolution allocates only the result value`() -> Result<unit, TestFailure> {
    let Ok(baseUri) = Uri.Parse("http://example.test/a/b/c?q=one") else { return Assert.True(false, "Base URI") }
    let Ok(reference) = Uri.Parse("../d?x=two#part") else { return Assert.True(false, "Reference URI") }
    _ = baseUri.Resolve(reference)
    let before = System.Runtime.GC.AllocatedObjectCount
    var index = 0
    var valid = true
    while index < 32 {
        valid = valid && (baseUri.Resolve(reference) is Ok(_))
        index += 1
    }
    let allocated = System.Runtime.GC.AllocatedObjectCount - before
    _ = Assert.True(valid, "Resolved URIs remain valid")?
    return Assert.True(allocated == 32, String.Concat("URI value resolution objects: ", allocated.ToString()))
}
