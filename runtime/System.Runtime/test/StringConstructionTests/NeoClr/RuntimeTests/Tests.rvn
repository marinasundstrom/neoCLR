module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Optional.*
import NeoClr.Testing.*

import System.Collections.*

[Test]
func `String construction copies character storage`() -> Result<unit, TestFailure> {
    let characters: Character[] = ['F', 'o', 'o']
    let copied = String(characters)
    characters[0] = 'B'
    _ = Assert.Equal("Foo", copied)?
    return Assert.Equal("Boo", String(characters))
}

[Test]
func `String exposes a readonly character sequence`() -> Result<unit, TestFailure> {
    let text = String(['F', 'o', 'o'])
    let sequence: Sequence<Character> = text
    _ = Assert.Equal(text.Length, sequence.Count)?
    _ = Assert.True(sequence[1] == 'o', "Sequence index preserves character")?
    return Assert.Equal(text, String(sequence))
}

[Test]
func `String construction accepts an empty character sequence`() -> Result<unit, TestFailure> {
    let empty: Character[] = []
    return Assert.Equal("", String(empty))
}

[Test]
func `String construction preserves and merges grapheme boundaries`() -> Result<unit, TestFailure> {
    let emoji = Character.FromString("👩‍💻")
    let graphemes: Character[] = [Character.FromString("é"), emoji]
    let text = String(graphemes)
    _ = Assert.Equal("é👩‍💻", text)?
    _ = Assert.Equal(2, text.Length)?
    _ = Assert.True(text[1] == emoji, "Index returns whole grapheme")?
    let merging: Character[] = ['e', Character.FromString("́")]
    return Assert.Equal(1, String(merging).Length)
}

[Test]
func `String named arguments preserve public parameter contracts`() -> Result<unit, TestFailure> {
    let text = String.Concat(right: "o", left: "Fo")
    _ = Assert.Equal(String(characters: ['F', 'o', 'o']), text)?
    _ = Assert.True(text.Equals(other: "Foo"), "Named equality operand")?
    _ = Assert.True(String.CompareOrdinal(right: "Food", left: text) < 0, "Named comparison order")?
    _ = Assert.True(text.ContainsOrdinal(substring: "oo"), "Named substring")?
    _ = Assert.True(text.StartsWithOrdinal(prefix: "Fo"), "Named prefix")?
    _ = Assert.True(text.EndsWithOrdinal(suffix: "oo"), "Named suffix")?
    if text.SliceUtf8(byteLength: 1, byteStart: 1) is Ok(let piece) {
        return Assert.Equal("o", piece)
    }
    return Assert.True(false, "Named UTF-8 slice must succeed")
}

[Test]
func `Character literals preserve graphemes and allow char identifiers`() -> Result<unit, TestFailure> {
    let char = 'é'
    let explicit: Character = char
    let canonical = Character.FromString("é")
    _ = Assert.True(explicit == canonical, "Canonical grapheme identity")?
    _ = Assert.Equal(explicit.GetHashCode(), canonical.GetHashCode())?
    _ = Assert.Equal("é", explicit.ToString())?
    _ = Assert.Equal("System.Character", typeof(Character).DisplayName)?
    let boxed: Object = explicit
    return Assert.True(boxed.Equals(canonical), "Boxed and typed character identity agree")
}
