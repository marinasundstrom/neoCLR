module NeoClr.RuntimeTests

import System.*
import NeoClr.Testing.*

static class FileFixture {
    private static var path = ""
    static val Path: string => path

    static func Configure(value: string) {
        path = value
    }
}

func Main(arguments: string[]) -> int {
    if arguments.Length == 0 {
        Console.WriteLine("File memory tests require an isolated file path")
        return 2
    }
    FileFixture.Configure(arguments[0])
    let suite = TestSuite()
    RegisterDiscoveredTests(suite)
    return TestRunner.Run(suite, arguments[1..].ToArray())
}
