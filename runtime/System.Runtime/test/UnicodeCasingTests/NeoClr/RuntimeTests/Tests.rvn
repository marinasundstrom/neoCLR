module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Optional.*
import NeoClr.Testing.*

[Test]
func `Invariant casing supports full Unicode expansions`() -> Result<unit, TestFailure> {
    _ = Assert.Equal("STRASSE FFI", "Straße ﬃ".ToUpperInvariant())?
    return Assert.Equal("i̇ıi", "İıI".ToLowerInvariant())
}

[Test]
func `Invariant lowercase respects contextual Greek sigma`() -> Result<unit, TestFailure> {
    _ = Assert.Equal("ος", "ΟΣ".ToLowerInvariant())?
    _ = Assert.Equal("οσα", "ΟΣΑ".ToLowerInvariant())?
    _ = Assert.Equal("aς́", "AΣ́".ToLowerInvariant())?
    _ = Assert.Equal("aσ́b", "AΣ́B".ToLowerInvariant())?
    return Assert.Equal("σ", "Σ".ToLowerInvariant())
}

[Test]
func `Invariant uppercase preserves emoji and supplementary letters`() -> Result<unit, TestFailure> {
    return Assert.Equal("𐐀𐐀👩‍💻", "𐐀𐐨👩‍💻".ToUpperInvariant())
}

[Test]
func CasingNoNormalization() -> Result<unit, TestFailure> {
    return Assert.Equal("É É", "é é".ToUpperInvariant())
}

[Test]
func `Invariant casing preserves embedded NUL and empty strings`() -> Result<unit, TestFailure> {
    _ = Assert.Equal("A\u0000B", "a\u0000b".ToUpperInvariant())?
    return Assert.Equal("", "".ToLowerInvariant())
}

[Test]
func CasingNotOrdinalFolding() -> Result<unit, TestFailure> {
    return Assert.True(String.CompareOrdinalIgnoreCase("ß", "ss") != 0, "Ordinal comparison must not apply full casing expansion")
}
