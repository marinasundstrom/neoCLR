module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Time.*
import NeoClr.Testing.*

[Test]
func `Zoned parsing preserves UTC and the pinned database version`() -> Result<unit, TestFailure> {
    _ = Assert.Equal("2025b", TimeZone.DatabaseVersion)?
    let Ok(value) = ZonedDateTime.Parse("1970-01-01T00:00:00Z", TimeZone.Utc) else {
        return Failure(TestFailure("UTC parse", "Ok", "Error"))
    }
    _ = Assert.Equal("UTC", value.Zone.Id)?
    _ = Assert.True(value.Instant.UnixTimeTicks == 0L, "Unix epoch")?
    return Assert.Equal(0, value.Offset.Seconds)
}

[Test]
func `Zoned parsing validates winter and summer offsets`() -> Result<unit, TestFailure> {
    let Ok(zone) = TimeZone.Find("Europe/Stockholm") else {
        return Failure(TestFailure("Zone lookup", "Ok", "Error"))
    }
    for text in ["2024-01-15T12:00:00+01:00", "2024-07-15T12:00:00+02:00"] {
        let Ok(value) = ZonedDateTime.Parse(text, zone) else {
            return Failure(TestFailure("Season parse", "Ok", text))
        }
        _ = Assert.Equal(12, value.LocalDateTime.Time.Hour)?
        _ = Assert.Equal("Europe/Stockholm", value.Zone.Id)?
    }
    _ = Assert.True(ZonedDateTime.Parse("2024-07-15T12:00:00+01:00", zone) is Failure(DateTimeParseError.OffsetMismatch), "Summer offset must match")?
    return Assert.True(ZonedDateTime.Parse("2024-01-15T12:00:00Z", zone) is Failure(DateTimeParseError.OffsetMismatch), "Z must match zone UTC offset")
}

[Test]
func `Explicit offsets select both DST overlap candidates without losing ticks`() -> Result<unit, TestFailure> {
    let Ok(zone) = TimeZone.Find("Europe/Stockholm") else {
        return Failure(TestFailure("Zone lookup", "Ok", "Error"))
    }
    let Ok(earlier) = ZonedDateTime.Parse("2024-10-27T02:30:00.1234567+02:00", zone) else {
        return Failure(TestFailure("Earlier overlap", "Ok", "Error"))
    }
    let Ok(later) = ZonedDateTime.Parse("2024-10-27T02:30:00.1234567+01:00", zone) else {
        return Failure(TestFailure("Later overlap", "Ok", "Error"))
    }
    _ = Assert.True(later.Instant.UnixTimeTicks - earlier.Instant.UnixTimeTicks == 36000000000L, "Overlap candidates differ by one hour")?
    _ = Assert.Equal(1234567, earlier.LocalDateTime.Time.FractionTicks)?
    return Assert.Equal(1234567, later.LocalDateTime.Time.FractionTicks)
}

[Test]
func `Zoned parsing rejects skipped local times for either adjacent offset`() -> Result<unit, TestFailure> {
    let Ok(zone) = TimeZone.Find("Europe/Stockholm") else {
        return Failure(TestFailure("Zone lookup", "Ok", "Error"))
    }
    for text in ["2024-03-31T02:30:00+01:00", "2024-03-31T02:30:00+02:00"] {
        _ = Assert.True(ZonedDateTime.Parse(text, zone) is Failure(DateTimeParseError.OffsetMismatch), "Gap cannot be normalized silently")?
    }
    return Assert.True(true, "Skipped local times rejected")
}

[Test]
func `Zoned parsing handles half hour transitions`() -> Result<unit, TestFailure> {
    let Ok(zone) = TimeZone.Find("Australia/Lord_Howe") else {
        return Failure(TestFailure("Zone lookup", "Ok", "Error"))
    }
    let Ok(first) = ZonedDateTime.Parse("2024-04-07T01:45:00+11:00", zone) else {
        return Failure(TestFailure("First half-hour candidate", "Ok", "Error"))
    }
    let Ok(second) = ZonedDateTime.Parse("2024-04-07T01:45:00+10:30", zone) else {
        return Failure(TestFailure("Second half-hour candidate", "Ok", "Error"))
    }
    _ = Assert.True(second.Instant.UnixTimeTicks - first.Instant.UnixTimeTicks == 18000000000L, "Half-hour overlap")?
    return Assert.True(ZonedDateTime.Parse("2024-10-06T02:15:00+10:30", zone) is Failure(DateTimeParseError.OffsetMismatch), "Half-hour gap")
}

[Test]
func `Zoned parsing enforces rule bounds and historical second precision`() -> Result<unit, TestFailure> {
    for text in ["1900-01-01T00:00:00Z", "2099-12-31T23:59:59.9999999Z", "1969-12-31T23:59:59.9999999Z"] {
        _ = Assert.True(ZonedDateTime.Parse(text, TimeZone.Utc) is Ok(_), "Supported UTC boundary")?
    }
    for text in ["1899-12-31T23:59:59.9999999Z", "2100-01-01T00:00:00Z"] {
        _ = Assert.True(ZonedDateTime.Parse(text, TimeZone.Utc) is Failure(DateTimeParseError.OutOfRange), "Named rules range")?
    }
    let Ok(paris) = TimeZone.Find("Europe/Paris") else {
        return Failure(TestFailure("Paris lookup", "Ok", "Error"))
    }
    let Ok(historical) = ZonedDateTime.Parse("1900-01-02T00:00:00+00:09:21", paris) else {
        return Failure(TestFailure("Historical seconds", "Ok", "Error"))
    }
    _ = Assert.Equal(561, historical.Offset.Seconds)?
    return Assert.True(ZonedDateTime.Parse("1900-01-01T00:00:00+00:09:21", paris) is Failure(DateTimeParseError.OutOfRange), "UTC also must be in range")
}

[Test]
func `Zoned parsing preserves lexical and civil range errors`() -> Result<unit, TestFailure> {
    for text in ["", "2024-01-01T00:00:00", "2024-01-01T00:00:00Z[UTC]", "2024-01-01 00:00:00Z"] {
        _ = Assert.True(ZonedDateTime.Parse(text, TimeZone.Utc) is Failure(DateTimeParseError.InvalidFormat), "Strict timestamp grammar")?
    }
    for text in ["2023-02-29T00:00:00Z", "2024-01-01T24:00:00Z", "2024-01-01T00:00:00+18:00:01"] {
        _ = Assert.True(ZonedDateTime.Parse(text, TimeZone.Utc) is Failure(DateTimeParseError.OutOfRange), "Civil and offset ranges")?
    }
    return Assert.True(true, "Error categories retained")
}

[Test]
func `Named zone lookup remains ordinal and accepts pinned aliases`() -> Result<unit, TestFailure> {
    for name in ["", "europe/stockholm", "Not/AZone", "UTC\u0000", "Europe/Stockholm "] {
        _ = Assert.True(TimeZone.Find(name) is Failure(TimeZoneError.UnknownZone), "Unknown or differently cased zone")?
    }
    let Ok(alias) = TimeZone.Find("Etc/UTC") else {
        return Failure(TestFailure("Alias lookup", "Ok", "Error"))
    }
    let Ok(value) = ZonedDateTime.Parse("2024-01-01T00:00:00-00:00", alias) else {
        return Failure(TestFailure("Alias parse", "Ok", "Error"))
    }
    return Assert.Equal("Etc/UTC", value.Zone.Id)
}
