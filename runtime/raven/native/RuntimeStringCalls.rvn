// Preserve ordinal value equality, including nulls, without recursing through
// the public String equality operators implemented using this helper.
internal func StringEquals(left: string, right: string) -> bool {
    if left is null {
        return right is null
    }
    if right is null {
        return false
    }
    return StringCompareOrdinal(left, right) == 0
}


// Canonical services preserve stored UTF-8 bytes. Char operations consume the
// grapheme directly, avoiding intermediate CharText string allocations.
[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func StringCompareCanonical(left: string, right: string) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func StringHashCanonical(text: string) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CharCompareCanonical(left: char, right: char) -> int;

[MethodImpl(MethodImplOptions.InternalCall)]
internal extern func CharHashCanonical(value: char) -> int;
