; Provisional capability contracts. Read access does not imply immutable storage.
.interface System.Collections.Collection<T>
    .implements System.Collections.Iterable<T>
    .property instance Count() -> Int32
        .get instance System.Collections.Collection<T>::get_Count()
    .end
    .method instance get_Count() -> Int32
    .end
.end
.interface System.Collections.Sequence<T>
    .implements System.Collections.Collection<T>
    .property instance Item(Int32) -> T
        .get instance System.Collections.Sequence<T>::get_Item(Int32)
    .end
    .method instance get_Item(Int32 index) -> T
    .end
.end
.interface System.Collections.MutableSequence<T>
    .implements System.Collections.Sequence<T>
    .property instance Item(Int32) -> T
        .get instance System.Collections.MutableSequence<T>::get_Item(Int32)
        .set instance System.Collections.MutableSequence<T>::set_Item(Int32,T)
    .end
    .method instance get_Item(Int32 index) -> T
    .end
    .method instance set_Item(Int32 index, T value) -> void
    .end
.end
