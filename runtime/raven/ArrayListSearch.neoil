    .method instance FindAll(System.Func<T,Boolean> match) -> System.Collections.ArrayList<T>
        .local arrayref<T> data
        .local Int32 count
        .local Int32 index
        .local T value
        .local System.Collections.ArrayList<T> result
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        newobj instance System.Collections.ArrayList<T>::.ctor()
        stloc result
        ldc.i4 0
        stloc index
        br Test
    Read:
        ldloc data
        ldloc index
        ldelem T
        stloc value
        ldarg match
        ldloc value
        call instance System.Func<T,Boolean>::Invoke(T)
        brfalse Next
        ldloc result
        ldloc value
        call instance System.Collections.ArrayList<T>::Add(T)
    Next:
        ldloc index
        ldc.i4 1
        add.ovf
        stloc index
    Test:
        ldloc index
        ldloc count
        blt Read
        ldloc result
        ret
    .end
