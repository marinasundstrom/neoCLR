    .method instance Exists(System.Func<T,Boolean> match) -> Boolean
        .local arrayref<T> data
        .local Int32 count
        .local Int32 index
        .local T value
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        ldc.i4 0
        stloc index
        br Test
    Read:
        ldloc data
        ldloc index
        ldelem T
        stloc value
        ldarg match
        ldloc value
        call instance System.Func<T,Boolean>::Invoke(T)
        brtrue Found
        ldloc index
        ldc.i4 1
        add.ovf
        stloc index
    Test:
        ldloc index
        ldloc count
        blt Read
        ldc.bool false
        ret
    Found:
        ldc.bool true
        ret
    .end

    .method instance TrueForAll(System.Func<T,Boolean> match) -> Boolean
        .local arrayref<T> data
        .local Int32 count
        .local Int32 index
        .local T value
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        ldc.i4 0
        stloc index
        br Test
    Read:
        ldloc data
        ldloc index
        ldelem T
        stloc value
        ldarg match
        ldloc value
        call instance System.Func<T,Boolean>::Invoke(T)
        brfalse Found
        ldloc index
        ldc.i4 1
        add.ovf
