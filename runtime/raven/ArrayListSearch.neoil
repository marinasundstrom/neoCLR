; Members inserted into the Raven-profile ArrayList<T> class.
; Capture the initial buffer and count, retaining existing predicate-search timing.

    .method instance Find(System.Func<T,Boolean> match) -> System.Option<T>
        .local arrayref<T> data
        .local Int32 count
        .local Int32 index
        .local T value
        ldarg this
        ldfld System.Collections.ArrayList<T>::State
        ldfld System.Collections.ArrayListState<T>::Data
        stloc data
        ldarg this
        call instance System.Collections.ArrayList<T>::get_Count()
        stloc count
        ldc.i4 0
        stloc index
        br Test
    Read:
        ldloc data
        ldloc index
        ldelem T
        stloc value
        ldarg match
        ldloc value
        call instance System.Func<T,Boolean>::Invoke(T)
        brtrue Found
        ldloc index
        ldc.i4 1
        add.ovf
        stloc index
    Test:
        ldloc index
        ldloc count
        blt Read
        newobj instance System.Option.None::.ctor()
        newobj instance System.Option<T>::.ctor(System.Option.None)
        ret
    Found:
        ldloc value
        newobj instance System.Option.Some<T>::.ctor(T)
        newobj instance System.Option<T>::.ctor(System.Option.Some<T>)
        ret
    .end

