[Test("JSON streams retry single-byte reads and writes without taking ownership")]
func StreamPartialRoundTrip() -> Result<unit, TestFailure> {
    let text = "{\"station\":\"Café 😀\",\"readings\":[21,22.5],\"ready\":true,\"note\":null}"
    let Ok(original) = JsonSerializer.DeserializeNode(text) else {
        return Assert.True(false, "Parse round-trip document")
    }
    let output = ShortOutput(-1, false)
    _ = Assert.True(CompletedValue(JsonSerializer.SerializeNode(output, original)) is Ok(_), "Partial writes must complete")?
    _ = Assert.True(!output.Closed, "Serializer borrows output")?
    _ = Assert.Equal(0, output.Flushes)?
    let input = ShortInput(output.Bytes, -1)
    let restored = CompletedValue(JsonSerializer.DeserializeNode(input))
    _ = Assert.True(!input.Closed, "Deserializer borrows input")?
    _ = Assert.Equal(output.Count, input.Position)?
    input.Close()
    output.Close()
    if restored is Ok(let value) {
        if JsonSerializer.SerializeNode(value) is Ok(let actual) {
            return Assert.Equal(text, actual)
        }
    }
    return Assert.True(false, "Single-byte chunks must preserve multibyte UTF-8 and node values")
}

[Test("JSON memory stream round trip preserves document content")]
func StreamMemoryRoundTrip() -> Result<unit, TestFailure> {
    let text = "{\"values\":[1,null,\"雪\"]}"
    let Ok(value) = JsonSerializer.DeserializeNode(text) else {
        return Assert.True(false, "Parse source document")
    }
    let memory = MemoryStream()
    _ = Assert.True(CompletedValue(JsonSerializer.SerializeNode(memory, value)) is Ok(_), "Write document")?
    _ = Assert.True(memory.Seek(0) is Ok(_), "Serializer must leave memory stream open")?
    let result = CompletedValue(JsonSerializer.DeserializeNode(memory))
    _ = Assert.True(memory.GetPosition() is Ok(_), "Deserializer must leave memory stream open")?
    memory.Close()
    if result is Ok(let restored) {
        if JsonSerializer.SerializeNode(restored) is Ok(let actual) {
            return Assert.Equal(text, actual)
        }
    }
    return Assert.True(false, "Memory document round trip must succeed")
}

[Test("JSON stream reads preserve the underlying I/O failure")]
func StreamReadFailure() -> Result<unit, TestFailure> {
    let input = ShortInput(EncodedBytes("{}")?, 1)
    let result = CompletedValue(JsonSerializer.DeserializeNode(input))
    _ = Assert.True(!input.Closed, "Failure must not close borrowed input")?
    input.Close()
    return Assert.True(result is Failure(JsonError.Read(TextReadError.IoFailure)), "JSON stream reads preserve the underlying I/O failure")
}

[Test("JSON stream reads reject split invalid UTF-8")]
func StreamInvalidUtf8() -> Result<unit, TestFailure> {
    let bytes: byte[] = [(byte)34, (byte)195, (byte)34]
    let input = ShortInput(bytes, -1)
    let result = CompletedValue(JsonSerializer.DeserializeNode(input))
    _ = Assert.True(!input.Closed, "Failure must not close borrowed input")?
    input.Close()
    return Assert.True(result is Failure(JsonError.Read(TextReadError.InvalidUtf8)), "JSON stream reads reject split invalid UTF-8")
}

[Test("JSON stream reads reject a truncated document")]
func StreamTruncated() -> Result<unit, TestFailure> {
    let input = ShortInput(EncodedBytes("[1,")?, -1)
    let result = CompletedValue(JsonSerializer.DeserializeNode(input))
    _ = Assert.True(!input.Closed, "Failure must not close borrowed input")?
    input.Close()
    return Assert.True(result is Failure(JsonError.Syntax(_)), "JSON stream reads reject a truncated document")
}

[Test("JSON stream input quota counts bytes and preserves ownership")]
func StreamReadQuota() -> Result<unit, TestFailure> {
    let bytes = ArrayList<byte>()
    var index = 0
    while index < 1025 {
        bytes.Add((byte)32)
        index = index + 1
    }
    let input = ShortInput(bytes, -1)
    let result = CompletedValue(JsonSerializer.DeserializeNode(input))
    _ = Assert.Equal(1025, input.Position)?
    _ = Assert.True(!input.Closed, "Quota failure must not close input")?
    input.Close()
    return Assert.True(result is Failure(JsonError.Read(TextReadError.LimitExceeded)), "Oversized stream must return read quota failure")
}

[Test("JSON stream writes preserve partial output and failure cause")]
func StreamWriteFailure() -> Result<unit, TestFailure> {
    let Ok(value) = JsonSerializer.DeserializeNode("[1,2]") else {
        return Assert.True(false, "Parse source document")
    }
    let output = ShortOutput(2, false)
    let result = CompletedValue(JsonSerializer.SerializeNode(output, value))
    _ = Assert.Equal(2, output.Count)?
    _ = Assert.Equal(0, output.Flushes)?
    _ = Assert.True(!output.Closed, "Write failure must not close output")?
    output.Close()
    return Assert.True(result is Failure(JsonError.Write(StreamError.AccessDenied)), "Underlying write error must survive")
}

[Test("JSON stream writes reject zero progress without looping")]
func StreamZeroProgress() -> Result<unit, TestFailure> {
    let output = ShortOutput(-1, true)
    let result = CompletedValue(JsonSerializer.SerializeNode(output, JsonNull()))
    _ = Assert.Equal(0, output.Count)?
    _ = Assert.Equal(0, output.Flushes)?
    _ = Assert.True(!output.Closed, "Zero-progress failure must not close output")?
    output.Close()
    return Assert.True(result is Failure(JsonError.Write(StreamError.IoFailure)), "Zero progress must return I/O failure")
}

[Test("JSON stream serialization detects cycles before writing")]
func StreamCyclePreflight() -> Result<unit, TestFailure> {
    let cycle = JsonArray()
    _ = Assert.True(cycle.Add(cycle) is Ok(_), "Create cyclic input")?
    let output = ShortOutput(-1, false)
    let result = CompletedValue(JsonSerializer.SerializeNode(output, cycle))
    _ = Assert.Equal(0, output.Count)?
    _ = Assert.Equal(0, output.Flushes)?
    _ = Assert.True(!output.Closed, "Validation failure must not close output")?
    output.Close()
    return Assert.True(result is Failure(JsonError.LimitExceeded(_)), "Cycle must fail before output begins")
}

[Test("JSON stream boundary counts UTF-8 bytes rather than characters")]
func StreamUnicodeBoundary() -> Result<unit, TestFailure> {
    let content = Repeat511("é")
    let text = "\"" + content + "\""
    _ = Assert.Equal(1024, text.GetUtf8ByteCount())?
    let input = ShortInput(EncodedBytes(text)?, -1)
    let result = CompletedValue(JsonSerializer.DeserializeNode(input))
    _ = Assert.True(!input.Closed, "Boundary success must preserve ownership")?
    input.Close()
    if result is Ok(let node) {
        if node is JsonString value {
            _ = Assert.Equal(content, value.Value)?
        } else {
            return Assert.True(false, "Boundary document must be a string")
        }
    } else {
        return Assert.True(false, "Exact UTF-8 quota must parse")
    }
    return Assert.True(JsonSerializer.DeserializeNode(text + " ") is Failure(JsonError.LimitExceeded(_)), "One extra byte must exceed document quota")
}

[Test("JSON stream output quota includes escaping and validates before writes")]
func StreamEscapedOutputQuota() -> Result<unit, TestFailure> {
    let content = Repeat511("\\")
    let value = JsonString(content)
    let Ok(text) = JsonSerializer.SerializeNode(value) else {
        return Assert.True(false, "Exact escaped quota must serialize")
    }
    _ = Assert.Equal(1024, text.GetUtf8ByteCount())?
    let output = ShortOutput(-1, false)
    _ = Assert.True(CompletedValue(JsonSerializer.SerializeNode(output, value)) is Ok(_), "Write exact escaped quota")?
    _ = Assert.Equal(1024, output.Count)?
    _ = Assert.True(!output.Closed, "Successful write borrows output")?
    output.Close()
    let untouched = ShortOutput(-1, false)
    let rejected = CompletedValue(JsonSerializer.SerializeNode(untouched, JsonString(content + "a")))
    _ = Assert.Equal(0, untouched.Count)?
    _ = Assert.Equal(0, untouched.Flushes)?
    _ = Assert.True(!untouched.Closed, "Quota rejection borrows output")?
    untouched.Close()
    return Assert.True(rejected is Failure(JsonError.LimitExceeded(_)), "Escaped output exceeding quota must fail before writing")
}

[Test("JSON number document quota preserves long number spelling")]
func StreamNumberBoundary() -> Result<unit, TestFailure> {
    var digits = "1"
    var index = 0
    while index < 10 {
        digits = digits + digits
        index = index + 1
    }
    let input = ShortInput(EncodedBytes(digits)?, -1)
    let result = CompletedValue(JsonSerializer.DeserializeNode(input))
    input.Close()
    if result is Ok(let value) {
        if JsonSerializer.SerializeNode(value) is Ok(let text) {
            _ = Assert.Equal(digits, text)?
        } else {
            return Assert.True(false, "Exact number quota must serialize")
        }
    } else {
        return Assert.True(false, "Exact number quota must parse")
    }
    return Assert.True(JsonNumber.Parse(digits + "0") is Failure(JsonError.InvalidNumber), "Oversized number token must fail")
}

// Produce 511 copies in nine steps without making boundary tests depend on a
// thousand temporary concatenations.
func Repeat511(value: string) -> string {
    var result = ""
    var part = value
    var index = 0
    while index < 9 {
        result = result + part
        part = part + part
        index = index + 1
    }
    return result
}

func EncodedBytes(text: string) -> Result<Sequence<byte>, TestFailure> {
    let Ok(bytes) = Encodings.Utf8.Encode(text) else {
        return Failure(TestFailure("UTF-8 encode", "Ok", "Error"))
    }
    return Ok(bytes)
}

// These fixtures promise inline completion; observation verifies that contract.
// Consumers of potentially pending streams use await instead.
func CompletedValue<T>(operation: System.Concurrency.Tasks.Task<T>) -> T {
    let Some(Completed(value)) = operation.Outcome else {
        System.Fail("Expected an immediately completed fixture operation")
    }
    return value
}

[Test("JSON indented stream output matches node text and preflights quotas")]
func StreamIndented() -> Result<unit, TestFailure> {
    let Ok(node) = JsonSerializer.DeserializeNode("{\"items\":[1,null]}") else {
        return Assert.True(false, "Parse source")
    }
    let options = JsonSerializerOptions()
    options.WriteIndented = true
    let expected = "{\n  \"items\": [\n    1,\n    null\n  ]\n}"
    let output = ShortOutput(-1, false)
    _ = Assert.True(CompletedValue(JsonSerializer.SerializeNode(output, node, options)) is Ok(_), "Write indented node")?
    let Ok(actual) = Encodings.Utf8.Decode(ArrayList<byte>(output.Bytes)[..]) else {
        return Assert.True(false, "Decode output")
    }
    _ = Assert.Equal(expected, actual)?
    _ = Assert.True(!output.Closed, "Leave output open")?
    let objectOutput = ShortOutput(-1, false)
    _ = Assert.True(CompletedValue(JsonSerializer.Serialize(objectOutput, node, options)) is Ok(_), "Write object overload")?
    _ = Assert.Equal(output.Count, objectOutput.Count)?
    let large = JsonArray()
    var text = ""
    for index in 0..1018 {
        text += "a"
    }
    _ = large.Add(JsonString(text))
    let rejected = ShortOutput(-1, false)
    _ = Assert.True(CompletedValue(JsonSerializer.SerializeNode(rejected, large, options)) is Failure(JsonError.LimitExceeded(_)), "Reject formatted output quota")?
    _ = Assert.Equal(0, rejected.Count)?
    return Assert.True(!rejected.Closed, "Rejected output remains open")
}

[Test("JSON UTF-8 byte output preserves escaping formatting and independent ownership")]
func OwnedUtf8Output() -> Result<unit, TestFailure> {
    let source = "{\"name\":\"é😀\\n\\u0000\\\"\\\\\",\"number\":-1.25e+2,\"values\":[true,false,null]}"
    let Ok(node) = JsonSerializer.DeserializeNode(source) else {
        return Assert.True(false, "Parse byte-output fixture")
    }
    let options = JsonSerializerOptions()
    options.WriteIndented = true
    let Ok(expected) = JsonSerializer.SerializeNode(node, options) else {
        return Assert.True(false, "Serialize formatted text")
    }
    let Ok(bytes) = JsonSerializer.SerializeToUtf8Bytes(node, options) else {
        return Assert.True(false, "Serialize formatted bytes")
    }
    let Ok(actual) = Encodings.Utf8.Decode(bytes) else {
        return Assert.True(false, "Decode result")
    }
    _ = Assert.Equal(expected, actual)?
    let Ok(second) = JsonSerializer.SerializeToUtf8Bytes(node, options) else {
        return Assert.True(false, "Serialize independent bytes")
    }
    bytes[0] = (byte)0
    _ = Assert.Equal(123, (int)second[0])?
    let Ok(compact) = JsonSerializer.SerializeToUtf8Bytes(node) else {
        return Assert.True(false, "Serialize compact bytes")
    }
    let Ok(compactText) = Encodings.Utf8.Decode(compact) else {
        return Assert.True(false, "Decode compact result")
    }
    return Assert.Equal("{\"name\":\"é😀\\u000a\\u0000\\\"\\\\\",\"number\":-1.25e+2,\"values\":[true,false,null]}", compactText)
}

[Test("JSON borrowed token parsing preserves empty Unicode escaped and scalar values")]
func ParserBorrowedValues() -> Result<unit, TestFailure> {
    let sources = ["\"\"", "\"Café 😀\"", "\"é\"", "true", "false", "null", "-0.125E+02", "{\"a\":\"plain\",\"b\":\"\\n\\u0000\\uD83D\\uDE00\"}"]
    let expected = ["\"\"", "\"Café 😀\"", "\"é\"", "true", "false", "null", "-0.125E+02", "{\"a\":\"plain\",\"b\":\"\\u000a\\u0000😀\"}"]
    var index = 0
    while index < sources.Length {
        let Ok(value) = JsonSerializer.DeserializeNode(sources[index]) else {
            return Assert.True(false, "Parse token fixture")
        }
        let Ok(text) = JsonSerializer.SerializeNode(value) else {
            return Assert.True(false, "Serialize token fixture")
        }
        _ = Assert.Equal(expected[index], text)?
        index += 1
    }
    return Ok(())
}

[Test("JSON borrowed token parsing rejects malformed escapes controls and numbers")]
func ParserInvalidTokens() -> Result<unit, TestFailure> {
    let sources = ["\"\\uD800\"", "\"\\uDC00\"", "\"\\uD800\\u0061\"", "\"\\u12\"", "\"\\x\"", "\"line\nfeed\"", "01", "-", "1.", "1e", "truex", "\"ok\" false"]
    for source in sources {
        _ = Assert.True(JsonSerializer.DeserializeNode(source) is Failure(_), "Reject malformed token")?
    }
    return Assert.True(JsonSerializer.DeserializeNode("{\"a\":1,\"\\u0061\":2}") is Failure(JsonError.DuplicateField("a")), "Compare decoded names")
}

[Test("JSON byte input borrows selected windows and returns owned mapped values")]
func ByteInputOwnership() -> Result<unit, TestFailure> {
    let bytes = [(byte)255, (byte)34, (byte)195, (byte)169, (byte)34, (byte)255]
    let window: ReadOnlySlice<byte> = bytes[1..5]
    let Ok(node) = JsonSerializer.DeserializeNode(window) else {
        return Assert.True(false, "Parse only the selected window")
    }
    bytes[2] = (byte)65
    if node is JsonString text {
        _ = Assert.Equal("é", text.Value)?
    } else {
        return Assert.True(false, "Return an owned string node")
    }
    _ = Assert.Equal(255, (int)bytes[0])?
    _ = Assert.True(JsonSerializer.Deserialize<string>("\"mapped\"".Utf8Bytes) is Ok("mapped"), "Generic byte mapping")?
    let Ok(number) = JsonSerializer.Deserialize("42".Utf8Bytes, typeof(int)) else {
        return Assert.True(false, "Explicit type byte mapping")
    }
    _ = Assert.Equal(42, (int)number)?
    let arrayType = typeof(int).MakeArrayType()
    let Ok(array) = JsonSerializer.Deserialize("[10,20]", arrayType) else {
        return Assert.True(false, "Runtime element type selects JSON array target")
    }
    let values = (int[])array
    _ = Assert.Equal(2, values.Length)?
    return Assert.Equal(20, values[1])
}

[Test("JSON byte input rejects invalid UTF-8 before syntax and preserves quotas")]
func ByteInputValidation() -> Result<unit, TestFailure> {
    _ = ExpectInvalidJsonUtf8([(byte)128])?
    _ = ExpectInvalidJsonUtf8([(byte)192, (byte)128])?
    _ = ExpectInvalidJsonUtf8([(byte)193, (byte)191])?
    _ = ExpectInvalidJsonUtf8([(byte)224, (byte)159, (byte)191])?
    _ = ExpectInvalidJsonUtf8([(byte)237, (byte)160, (byte)128])?
    _ = ExpectInvalidJsonUtf8([(byte)240, (byte)143, (byte)191, (byte)191])?
    _ = ExpectInvalidJsonUtf8([(byte)244, (byte)144, (byte)128, (byte)128])?
    _ = ExpectInvalidJsonUtf8([(byte)245, (byte)128, (byte)128, (byte)128])?
    _ = ExpectInvalidJsonUtf8([(byte)255])?
    _ = ExpectInvalidJsonUtf8([(byte)194])?
    _ = ExpectInvalidJsonUtf8([(byte)226, (byte)130])?
    _ = ExpectInvalidJsonUtf8([(byte)240, (byte)159, (byte)152])?
    _ = ExpectInvalidJsonUtf8([(byte)194, (byte)32])?
    _ = ExpectInvalidJsonUtf8([(byte)226, (byte)130, (byte)32])?
    let syntaxThenUtf8 = [(byte)63, (byte)255]
    _ = Assert.True(JsonSerializer.DeserializeNode(syntaxThenUtf8) is Failure(JsonError.Read(TextReadError.InvalidUtf8)), "Validate the entire input first")?
    let empty: byte[] = []
    _ = Assert.True(JsonSerializer.DeserializeNode(empty) is Failure(JsonError.Syntax("Missing value")), "Empty window is valid UTF-8 but not JSON")?
    let oversized = System.Runtime.CompilerServices.CheckedStorage.Reserve<byte>(1025)
    var index = 0
    while index < oversized.Length {
        oversized[index] = (byte)255
        index += 1
    }
    return Assert.True(JsonSerializer.DeserializeNode(oversized) is Failure(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes")), "Quota precedes UTF-8 validation")
}

[Test("JSON byte input accepts UTF-8 scalar boundaries and rejects BOM and raw controls")]
func ByteInputUnicodeBoundaries() -> Result<unit, TestFailure> {
    _ = ExpectValidJsonUtf8([(byte)34, (byte)194, (byte)128, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)223, (byte)191, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)224, (byte)160, (byte)128, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)237, (byte)159, (byte)191, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)238, (byte)128, (byte)128, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)239, (byte)191, (byte)191, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)240, (byte)144, (byte)128, (byte)128, (byte)34])?
    _ = ExpectValidJsonUtf8([(byte)34, (byte)244, (byte)143, (byte)191, (byte)191, (byte)34])?
    let bom = [(byte)239, (byte)187, (byte)191, (byte)49]
    _ = Assert.True(JsonSerializer.DeserializeNode(bom) is Failure(JsonError.InvalidNumber), "Keep existing BOM rejection")?
    let control = [(byte)34, (byte)0, (byte)34]
    return Assert.True(JsonSerializer.DeserializeNode(control) is Failure(JsonError.Syntax("Unescaped control byte")), "UTF-8 NUL is not a raw JSON string character")
}

[Test("JSON HTTP byte input preserves memory windows and aliases and rejects unbuffered content")]
func ByteInputHttp() -> Result<unit, TestFailure> {
    let bytes = [(byte)49]
    let content = System.Web.Http.HttpMemoryContent(bytes)
    _ = Assert.True(System.Web.Http.Json.JsonContent.Read<int>(content) is Ok(1), "Read array-backed content")?
    bytes[0] = (byte)50
    _ = Assert.True(System.Web.Http.Json.JsonContent.Read<int>(content) is Ok(2), "Preserve existing alias semantics")?
    let surrounded: byte[] = [(byte)255, (byte)51, (byte)255]
    let window: ReadOnlyMemory<byte> = surrounded
    _ = Assert.True(System.Web.Http.Json.JsonContent.Read<int>(System.Web.Http.HttpMemoryContent(window[1..2])) is Ok(3), "Read only selected memory window")?
    let input = ShortInput(bytes, -1)
    let Ok(streamed) = System.Web.Http.HttpStreamContent.Create(input, 1, true) else {
        return Assert.True(false, "Create stream content")
    }
    _ = Assert.True(System.Web.Http.Json.JsonContent.ReadNode(streamed) is Failure(JsonError.Read(TextReadError.IoFailure)), "Reject unbuffered content")?
    _ = Assert.Equal(0, input.Position)?
    return Assert.True(!input.Closed, "Do not consume or close stream content")
}


func ExpectInvalidJsonUtf8(bytes: byte[]) -> Result<unit, TestFailure> {
    return Assert.True(JsonSerializer.DeserializeNode(bytes) is Failure(JsonError.Read(TextReadError.InvalidUtf8)), "Reject malformed UTF-8")
}

func ExpectValidJsonUtf8(bytes: byte[]) -> Result<unit, TestFailure> {
    return Assert.True(JsonSerializer.DeserializeNode(bytes) is Ok(JsonString), "Accept valid scalar boundaries")
}

[Test("HTTP JSON async reads consume streams once preserve ownership and honor cancellation")]
func ByteInputHttpAsync() -> Result<unit, TestFailure> {
    let input = ShortInput([(byte)49], -1)
    let Ok(content) = HttpStreamContent.Create(input, 1, true) else {
        return Assert.True(false, "Create stream content")
    }
    _ = Assert.True(CompletedValue(content.ReadFromJson<int>()) is Ok(1), "Read streamed integer")?
    _ = Assert.Equal(1, input.Position)?
    _ = Assert.True(!input.Closed, "Borrow stream ownership")?
    _ = Assert.True(CompletedValue(content.ReadJsonNode()) is Failure(JsonError.Read(TextReadError.IoFailure)), "Reject second consumption")?
    let secondInput = ShortInput([(byte)50], -1)
    let Ok(second) = HttpStreamContent.Create(secondInput, 1, true) else {
        return Assert.True(false, "Create second content")
    }
    let cancellation = CancellationTokenSource()
    cancellation.Cancel()
    _ = Assert.True(second.ReadFromJson<int>(cancellation.Token).IsCancelled, "Pre-cancel before consumption")?
    _ = Assert.Equal(0, secondInput.Position)?
    let mapped = CompletedValue(second.ReadFromJson(typeof(int)))
    _ = Assert.True(mapped is Ok(_), "Runtime type stream mapping")?
    cancellation.Dispose()
    let badInput = ShortInput([(byte)255], -1)
    let Ok(bad) = HttpStreamContent.Create(badInput, 1, true) else {
        return Assert.True(false, "Create invalid content")
    }
    _ = Assert.True(CompletedValue(bad.ReadJsonNode()) is Failure(JsonError.Read(TextReadError.InvalidUtf8)), "Reject invalid streamed UTF-8")?
    return Assert.True(!badInput.Closed, "Failed JSON read preserves ownership")
}
