module NeoClr.RuntimeTests

import System.*
import System.Data.Json.*
import System.Collections.*
import System.IO.*
import System.Concurrency.Tasks.*
import System.Concurrency.*
import System.Result.*
import System.Text.*
import NeoClr.Testing.*

// Streams expose Close, not Disposable; these ownership tests close explicitly.
// One byte at a time deliberately splits multibyte UTF-8 characters.
class ShortInput : InputStream {
    private val bytes: Sequence<byte>
    private var position = 0
    private val failAt: int
    private var closed = false

    init(bytes: Sequence<byte>, failAt: int) {
        self.bytes = bytes
        self.failAt = failAt
    }

    val Closed: bool => closed
    val Position: int => position

    private func ReadCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if position == failAt {
            return Error(StreamError.IoFailure)
        }
        if count == 0 || position == bytes.Count {
            return Ok(0)
        }
        buffer[offset] = bytes[position]
        position += 1
        return Ok(1)
    }

    func Close() {
        closed = true
    }

    func Read(buffer: byte[], offset: int, count: int) -> Task<Result<int, StreamError>> {
        return Read(buffer, offset, count, CancellationToken.None)
    }
    func Read(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<int, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(ReadCore(buffer, offset, count))
    }
}

class ShortOutput : OutputStream {
    private val bytes: List<byte> = ArrayList<byte>()
    private val failAt: int
    private val zeroProgress: bool
    private var closed = false
    private var flushes = 0

    init(failAt: int, zeroProgress: bool) {
        self.failAt = failAt
        self.zeroProgress = zeroProgress
    }

    val Closed: bool => closed
    val Count: int => bytes.Count
    val Flushes: int => flushes
    val Bytes: Sequence<byte> => bytes

    private func WriteCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if bytes.Count == failAt {
            return Error(StreamError.AccessDenied)
        }
        if count == 0 || zeroProgress {
            return Ok(0)
        }
        bytes.Add(buffer[offset])
        return Ok(1)
    }

    private func FlushCore() -> Result<unit, StreamError> {
        flushes += 1
        return Ok(())
    }

    func Close() {
        closed = true
    }

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(WriteAll(buffer, offset, count))
    }

    private func WriteAll(buffer: byte[], offset: int, count: int) -> Result<unit, StreamError> {
        var sent = 0
        while !(sent >= count) {
            let amount = WriteCore(buffer, offset + sent, count - sent)?
            if amount == 0 {
                return Error(StreamError.IoFailure)
            }
            sent += amount
        }
        return Ok(())
    }
    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(FlushCore())
    }
}
