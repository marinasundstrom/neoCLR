module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Linq.*
import System.Option.*
import System.Result.*
import NeoClr.Testing.*

[Test("All stops at the first failed predicate")]
func QueryAll() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.All(value => value < 3) == false, "All stops at the first failed predicate")?
    return CheckObservation(input, 1, 3, 3, 1)
}

[Test("Fold visits every value")]
func QueryFold() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Fold(0, (sum, value) => sum + value) == 10, "Fold visits every value")?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test("First stops after one value")]
func QueryFirst() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.First() is Some(1), "First stops after one value")?
    return CheckObservation(input, 1, 1, 1, 1)
}

[Test("Last visits the complete input")]
func QueryLast() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Last() is Some(4), "Last visits the complete input")?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test("Single rejects multiple values without reading the second")]
func QuerySingle() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Single() is Error(SingleError.Multiple), "Single rejects multiple values without reading the second")?
    return CheckObservation(input, 1, 2, 1, 1)
}

[Test("Predicate First stops at its match")]
func QuerySelectedFirst() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.First(value => value == 2) is Some(2), "Predicate First stops at its match")?
    return CheckObservation(input, 1, 2, 2, 1)
}

[Test("Predicate Last retains the final match")]
func QuerySelectedLast() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Last(value => value < 3) is Some(2), "Predicate Last retains the final match")?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test("Predicate Single scans for a unique match")]
func QuerySelectedSingle() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Single(value => value == 2) is Ok(2), "Predicate Single scans for a unique match")?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test("Count advances without reading Current")]
func QueryCount() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Count() == 4, "Count advances without reading Current")?
    return CheckObservation(input, 1, 5, 0, 1)
}

[Test("Predicate Count reads every value")]
func QuerySelectedCount() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Count(value => value < 3) == 2, "Predicate Count reads every value")?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test("ToList materializes and disposes its input")]
func QueryToList() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.ToList().Count == 4, "ToList materializes and disposes its input")?
    return CheckObservation(input, 1, 5, 4, 1)
}

[Test("Any disposes empty input")]
func QueryEmptyAny() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    input.Limit = 0
    _ = Assert.True(!input.Any(), "Any disposes empty input")?
    return CheckObservation(input, 1, 1, 0, 1)
}

[Test("Predicate Single stops at the second match")]
func QueryMultipleMatches() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.Single(value => value < 3) is Error(SingleError.Multiple), "Predicate Single stops at the second match")?
    return CheckObservation(input, 1, 2, 2, 1)
}

[Test("Predicate First disposes input with no match")]
func QueryNoMatch() -> Result<unit, TestFailure> {
    let input = ObservedNumbers()
    _ = Assert.True(input.First(value => value > 4) is None, "Predicate First disposes input with no match")?
    return CheckObservation(input, 1, 5, 4, 1)
}
