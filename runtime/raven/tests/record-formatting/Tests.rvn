module NeoClr.RuntimeTests

import System.*
import System.Option.*
import System.Result.*
import NeoClr.Testing.*

record struct Position(Value: Index)
record struct Interval(Value: Range)
record struct Envelope(Position: Position, Interval: Interval)
record struct OptionalPosition(Value: Option<Index>)

[Test("Records use imported value formatting across typed and boxed calls")]
func ImportedValues() -> Result<unit, TestFailure> {
    let position = Position(Index.FromEnd(2))
    let interval = Interval(Range(Index.FromStart(1), Index.FromEnd(2)))
    _ = Assert.Equal("Position { Value = ^2 }", position.ToString())?
    _ = Assert.Equal("Interval { Value = 1..^2 }", interval.ToString())?
    let boxed: object = position
    System.Runtime.GC.Collect()
    _ = Assert.Equal("KeyValuePair { Key = 1, Value = \"one\" }", System.Collections.KeyValuePair<int, string>(1, "one").ToString())?
    return Assert.Equal(position.ToString(), boxed.ToString())
}

[Test("Nested records and unions retain imported value display contracts")]
func NestedValues() -> Result<unit, TestFailure> {
    let envelope = Envelope(Position(Index.Start), Interval(Range.All))
    _ = Assert.Equal("Envelope { Position = Position { Value = 0 }, Interval = Interval { Value = 0..^0 } }", envelope.ToString())?
    let some = OptionalPosition(Some(Index.FromEnd(3)))
    _ = Assert.Equal("OptionalPosition { Value = Option.Some(^3) }", some.ToString())?
    return Assert.Equal("OptionalPosition { Value = Option.None }", OptionalPosition(None).ToString())
}

record struct Scalars(Number: int, Flag: bool, Text: string?)

[Test("Record scalar formatting preserves null and original Unicode text")]
func ScalarsAndNull() -> Result<unit, TestFailure> {
    _ = Assert.Equal("Scalars { Number = -2147483648, Flag = True, Text = null }", Scalars(-2147483648, true, null).ToString())?
    let expected = "Scalars { Number = 42, Flag = False, Text = \"é\" }"
    return Assert.True(Scalars(42, false, "é").ToString().Equals(expected, StringComparison.Ordinal), "Original UTF-8 representation")
}

[Flags]
public enum Access { None = 0, Read = 1, Alias = 1, Write = 2, Execute = 4 }
record struct Permissions(Value: Access)
record struct Comparison(Value: StringComparison)
record struct OptionalPermission(Value: Option<Access>)

[Test("Record enum display preserves names flags and numeric fallback")]
func EnumValues() -> Result<unit, TestFailure> {
    _ = Assert.Equal("Permissions { Value = Read }", Permissions(Access.Alias).ToString())?
    _ = Assert.Equal("Permissions { Value = Read, Execute }", Permissions((Access)5).ToString())?
    _ = Assert.Equal("Permissions { Value = 8 }", Permissions((Access)8).ToString())?
    _ = Assert.Equal("Permissions { Value = -2147483648 }", Permissions((Access)(-2147483648)).ToString())?
    _ = Assert.Equal("Permissions { Value = None }", Permissions(Access.None).ToString())?
    return Assert.Equal("Comparison { Value = Ordinal }", Comparison(StringComparison.Ordinal).ToString())
}

[Test("Record enum payload display survives boxed dispatch and collection")]
func EnumPayloads() -> Result<unit, TestFailure> {
    let value = OptionalPermission(Some((Access)5))
    let boxed: object = value
    let text = boxed.ToString()
    System.Runtime.GC.Collect()
    _ = Assert.Equal("OptionalPermission { Value = Option.Some(Read, Execute) }", text)?
    return Assert.Equal(text, value.ToString())
}

record struct Floating(Wide: double, Narrow: float)
record struct OptionalFloating(Value: Option<double>)
record struct NestedFloating(Value: Floating)

[Test("Floating records use value equality for NaNs zeros and infinities")]
func FloatingEquality() -> Result<unit, TestFailure> {
    let nan = Double.NaN
    let left = Floating(nan, (float)nan)
    let right = Floating(-nan, (float)(-nan))
    _ = Assert.True(nan != nan && left == right && left.Equals(right) && !(left != right), "Record equality uses Equals semantics")?
    _ = Assert.Equal(left.GetHashCode(), right.GetHashCode())?
    let zero = Floating(0.0, (float)0.0)
    let negativeZero = Floating(-0.0, (float)(-0.0))
    let absent: Floating = default
    _ = Assert.True(absent == zero, "Default storage")?
    _ = Assert.True(zero == negativeZero, "Signed zero equality")?
    _ = Assert.Equal(zero.GetHashCode(), negativeZero.GetHashCode())?
    let infinity = Double.PositiveInfinity
    _ = Assert.True(Floating(infinity, (float)infinity) != Floating(-infinity, (float)infinity), "Infinity sign")?
    _ = Assert.True(Floating(1.0, (float)2.0) != Floating(1.0, (float)3.0), "Single participates")?
    return Assert.True(Floating(1.0, (float)2.0) != Floating(3.0, (float)2.0), "Double participates")
}

[Test("Floating record contracts agree across boxed interface and nested calls")]
func FloatingDispatch() -> Result<unit, TestFailure> {
    let nan = Double.NaN
    let value = Floating(nan, (float)nan)
    let boxed: object = value
    let contract: EquatableTo<Floating> = value
    System.Runtime.GC.Collect()
    _ = Assert.True(boxed.Equals(value) && contract.Equals(value), "Boxed and interface equality")?
    _ = Assert.True(!boxed.Equals(null) && !boxed.Equals(nan), "Nominal record identity")?
    _ = Assert.Equal(value.GetHashCode(), boxed.GetHashCode())?
    _ = Assert.True(NestedFloating(value) == NestedFloating(value), "Nested equality")?
    let first = OptionalFloating(Some(nan))
    let second = OptionalFloating(Some(-nan))
    _ = Assert.True(first == second && first != OptionalFloating(None), "Union payload equality")?
    return Assert.Equal(first.GetHashCode(), second.GetHashCode())
}

[Test("Floating record display uses primitive text including negative zero")]
func FloatingText() -> Result<unit, TestFailure> {
    let nan = Double.NaN
    let infinity = Double.PositiveInfinity
    _ = Assert.Equal("Floating { Wide = NaN, Narrow = Infinity }", Floating(nan, (float)infinity).ToString())?
    _ = Assert.Equal("Floating { Wide = -0, Narrow = -0 }", Floating(-0.0, (float)(-0.0)).ToString())?
    let value = Floating(1.5, (float)2.5)
    let boxed: object = value
    _ = Assert.Equal("Floating { Wide = 1.5, Narrow = 2.5 }", boxed.ToString())?
    _ = Assert.Equal("OptionalFloating { Value = Option.Some(NaN) }", OptionalFloating(Some(nan)).ToString())?
    return Assert.Equal("NestedFloating { Value = Floating { Wide = 1.5, Narrow = 2.5 } }", NestedFloating(value).ToString())
}

record struct Wrapped<T>(Value: T)

[Test("Generic record display preserves text null and primitive contracts")]
func GenericText() -> Result<unit, TestFailure> {
    _ = Assert.Equal("Wrapped { Value = 42 }", Wrapped<int>(42).ToString())?
    _ = Assert.Equal("Wrapped { Value = True }", Wrapped<bool>(true).ToString())?
    _ = Assert.Equal("Wrapped { Value = NaN }", Wrapped<double>(Double.NaN).ToString())?
    _ = Assert.Equal("Wrapped { Value = \"é\\\"\\\\\" }", Wrapped<string>("é\"\\").ToString())?
    _ = Assert.Equal("Wrapped { Value = 'é' }", Wrapped<Char>('é').ToString())?
    _ = Assert.Equal("Wrapped { Value = \"text\" }", Wrapped<object>("text").ToString())?
    return Assert.Equal("Wrapped { Value = null }", Wrapped<string?>(null).ToString())
}

[Test("Generic record display uses nested and boxed value dispatch")]
func GenericDispatch() -> Result<unit, TestFailure> {
    let value = Wrapped<Position>(Position(Index.FromEnd(2)))
    let boxed: object = value
    System.Runtime.GC.Collect()
    _ = Assert.Equal("Wrapped { Value = Position { Value = ^2 } }", value.ToString())?
    _ = Assert.Equal(value.ToString(), boxed.ToString())?
    _ = Assert.Equal("Wrapped { Value = Read, Write }", Wrapped<Access>(Access.Read | Access.Write).ToString())?
    return Assert.Equal("Wrapped { Value = Wrapped { Value = 5 } }", Wrapped<Wrapped<int>>(Wrapped<int>(5)).ToString())
}

record Person(Name: string, Age: int)
record Household(Owner: Person?)
record struct Contact(Owner: Person?)

[Test("Root record classes preserve value equality and reference identity")]
func ReferenceContracts() -> Result<unit, TestFailure> {
    let first = Person("Ada", 37)
    let equal = Person("Ada", 37)
    let different = Person("Ada", 38)
    let absent: Person? = null
    let alsoAbsent: Person? = null
    let boxed: object = first
    let contract: EquatableTo<Person> = first
    _ = Assert.True(absent == alsoAbsent && !(absent != alsoAbsent), "Both absent")?
    _ = Assert.True(!Object.ReferenceEquals(first, equal), "Separate instances")?
    _ = Assert.True(first == equal && first != different && first != absent && absent != first, "Operators")?
    _ = Assert.True(first.Equals(equal) && boxed.Equals(equal) && contract.Equals(equal), "Dispatch")?
    _ = Assert.True(!first.Equals(null) && !boxed.Equals(42), "Absent and unrelated")?
    _ = Assert.Equal(first.GetHashCode(), equal.GetHashCode())?
    System.Runtime.GC.Collect()
    return Assert.Equal("Person { Name = \"Ada\", Age = 37 }", boxed.ToString())
}

[Test("Record class display preserves nested and absent references")]
func ReferenceDisplay() -> Result<unit, TestFailure> {
    let owner = Person("Ada", 37)
    _ = Assert.Equal("Household { Owner = Person { Name = \"Ada\", Age = 37 } }", Household(owner).ToString())?
    _ = Assert.Equal("Household { Owner = null }", Household(null).ToString())?
    _ = Assert.Equal("Contact { Owner = null }", Contact(null).ToString())?
    return Assert.Equal("Contact { Owner = Person { Name = \"Ada\", Age = 37 } }", Contact(owner).ToString())
}

record Link(Name: string, Next: Link?)

[Test("Recursive record shapes display finite reference chains")]
func RecursiveReferences() -> Result<unit, TestFailure> {
    let first = Link("first", Link("last", null))
    let equal = Link("first", Link("last", null))
    _ = Assert.True(first == equal, "Recursive equality")?
    _ = Assert.Equal(first.GetHashCode(), equal.GetHashCode())?
    let boxed: object = first
    System.Runtime.GC.Collect()
    return Assert.Equal("Link { Name = \"first\", Next = Link { Name = \"last\", Next = null } }", boxed.ToString())
}

open record Entity(Id: int)
record Item(Id: int, Name: string) : Entity(Id)
record Other(Id: int) : Entity(Id)
record Leaf(Name: string) : Entity(7)
open record GenericEntity<T>(Value: T)
record GenericItem<T>(Value: T, Id: int) : GenericEntity<T>(Value)

[Test("Inherited record equality observes runtime type and derived state")]
func InheritedContracts() -> Result<unit, TestFailure> {
    let first: Entity = Item(1, "a")
    let same: Entity = Item(1, "a")
    let changed: Entity = Item(1, "b")
    let other: Entity = Other(1)
    let root = Entity(1)
    let contract: EquatableTo<Entity> = first
    let boxed: object = first
    _ = Assert.True(first == same && first.Equals(same) && contract.Equals(same), "Same runtime type and state")?
    _ = Assert.True(first != changed && !first.Equals(changed) && !contract.Equals(changed), "Derived state")?
    _ = Assert.True(first != other && other != first && first != root && root != first, "Symmetric type identity")?
    _ = Assert.True(boxed.Equals(same) && !boxed.Equals(other), "Object dispatch")?
    _ = Assert.Equal(first.GetHashCode(), same.GetHashCode())?
    let generic: GenericEntity<string> = GenericItem<string>("a", 1)
    let genericSame: GenericEntity<string> = GenericItem<string>("a", 1)
    let genericChanged: GenericEntity<string> = GenericItem<string>("a", 2)
    return Assert.True(generic == genericSame && generic != genericChanged, "Generic inherited state")
}

[Test("Inherited record display includes base members through virtual calls")]
func InheritedDisplay() -> Result<unit, TestFailure> {
    let original = Item(9, "copy")
    let copy = Item(original)
    _ = Assert.True(!Object.ReferenceEquals(original, copy) && original == copy, "Copy preserves base and derived state")?
    let value: Entity = Item(1, "a")
    _ = Assert.Equal("Item { Id = 1, Name = \"a\" }", value.ToString())?
    return Assert.Equal("Leaf { Id = 7, Name = \"x\" }", Leaf("x").ToString())
}
