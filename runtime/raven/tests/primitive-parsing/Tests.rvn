func ParseInt16() -> Result<unit, TestFailure> {
    if Int16.Parse("-32768") is Ok(let value) {
        _ = Assert.True(value == (short)-32768, "Parsed Int16 value")?
    } else {
        return Assert.True(false, "Valid Int16 text must parse")
    }
    return Assert.True(Int16.Parse("32768") is Error(NumberParseError.Overflow), "Out-of-range Int16 must report overflow")
}

