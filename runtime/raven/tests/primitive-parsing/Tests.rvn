[Test("UInt64 parsing preserves values and reports overflow")]
func ParseUInt64() -> Result<unit, TestFailure> {
    if UInt64.Parse("18446744073709551615") is Ok(let value) {
        _ = Assert.True(value == (ulong)-1L, "Parsed UInt64 value")?
    } else {
        return Assert.True(false, "Valid UInt64 text must parse")
    }
    return Assert.True(UInt64.Parse("18446744073709551616") is Error(NumberParseError.Overflow), "Out-of-range UInt64 must report overflow")
