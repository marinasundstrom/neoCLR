[Test("Single parsing preserves values and reports overflow")]
func ParseSingle() -> Result<unit, TestFailure> {
    if Single.Parse("1.25e2") is Ok(let value) {
        _ = Assert.True(value == (float)125, "Parsed Single value")?
    } else {
        return Assert.True(false, "Valid Single text must parse")
    }
    return Assert.True(Single.Parse("1e39") is Error(NumberParseError.Overflow), "Out-of-range Single must report overflow")
}

[Test("Double parsing preserves values and reports overflow")]
func ParseDouble() -> Result<unit, TestFailure> {
    if Double.Parse("-2.5e-1") is Ok(let value) {
        _ = Assert.True(value == -0.25, "Parsed Double value")?
    } else {
        return Assert.True(false, "Valid Double text must parse")
    }
    return Assert.True(Double.Parse("1e309") is Error(NumberParseError.Overflow), "Out-of-range Double must report overflow")
}

[Test("Boolean parsing accepts mixed case and rejects numeric aliases")]
func ParseBoolean() -> Result<unit, TestFailure> {
    if Boolean.Parse("tRuE") is Ok(let value) {
        _ = Assert.True(value, "Mixed-case true")?
    } else {
        return Assert.True(false, "Mixed-case Boolean must parse")
    }
    return Assert.True(Boolean.Parse("1") is Error(BooleanParseError.InvalidFormat), "Numeric Boolean must fail")
}

[Test("Primitive parsers distinguish invalid format from overflow")]
func ParseFormat() -> Result<unit, TestFailure> {
    _ = Assert.True(Double.Parse(" 1") is Error(NumberParseError.InvalidFormat), "Floating parser rejects leading whitespace")?
    return Assert.True(UInt64.Parse("999999999999999999999999x") is Error(NumberParseError.InvalidFormat), "Invalid suffix takes precedence over unsigned overflow")
}

[Test("Byte parsing preserves distinct small values")]
func ParseByteValues() -> Result<unit, TestFailure> {
    if Byte.Parse("1") is Ok(let first) && Byte.Parse("2") is Ok(let second) {
        return Assert.True(first == (byte)1 && second == (byte)2, "Small parsed bytes remain distinct")
    }
    return Assert.True(false, "Small byte inputs must parse")
}
