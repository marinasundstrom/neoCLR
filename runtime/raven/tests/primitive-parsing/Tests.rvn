[Test("UInt32 parsing preserves values and reports overflow")]
func ParseUInt32() -> Result<unit, TestFailure> {
    if UInt32.Parse("4294967295") is Ok(let value) {
        _ = Assert.True(value == (uint)4294967295L, "Parsed UInt32 value")?
    } else {
        return Assert.True(false, "Valid UInt32 text must parse")
    }
    return Assert.True(UInt32.Parse("4294967296") is Error(NumberParseError.Overflow), "Out-of-range UInt32 must report overflow")
