module NeoClr.RuntimeTests

import System.*
import System.Result.*
import System.Option.*
import NeoClr.Testing.*

[Test("SByte parsing preserves values and reports overflow")]
func ParseSByte() -> Result<unit, TestFailure> {
    if SByte.Parse("-128") is Ok(let value) {
        _ = Assert.True(value == (sbyte)-128, "Parsed SByte value")?
    } else {
        return Assert.True(false, "Valid SByte text must parse")
    }
    return Assert.True(SByte.Parse("128") is Error(NumberParseError.Overflow), "Out-of-range SByte must report overflow")
}

[Test("Byte parsing preserves values and reports overflow")]
func ParseByte() -> Result<unit, TestFailure> {
    if Byte.Parse("255") is Ok(let value) {
        _ = Assert.True(value == (byte)255, "Parsed Byte value")?
    } else {
        return Assert.True(false, "Valid Byte text must parse")
    }
    return Assert.True(Byte.Parse("-1") is Error(NumberParseError.Overflow), "Out-of-range Byte must report overflow")
}

