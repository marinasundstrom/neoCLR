module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Option.*
import System.Result.*
import NeoClr.Testing.*

[Test("Map indexers share comparer lookup and insert-or-replace semantics")]
func MapIndexers() -> Result<unit, TestFailure> {
    let storage = HashMap<string, int>(StringComparer.OrdinalIgnoreCase)
    let writer: MutableMap<string, int> = storage
    let reader: Map<string, int> = writer
    storage["Café"] = 7
    _ = Assert.Equal(7, reader["CAFÉ"])?
    writer["café"] = 9
    _ = Assert.Equal(9, storage["Café"])?
    _ = Assert.Equal(9, writer["CAFÉ"])?
    _ = Assert.Equal(1, reader.Count)?
    _ = Assert.Equal("Café", reader.Keys[0])?
    writer["雪"] = 12
    _ = Assert.Equal(12, reader["雪"])?
    _ = Assert.Equal(2, reader.Count)?
    _ = Assert.True(reader.Find("absent") is None, "Find safely represents absence")?
    storage.Set("method", 42)
    _ = Assert.Equal(42, reader["method"])?
    let collided = HashMap<int, string>((left, right) => left == right, key => 0)
    for index in 0..<12 {
        collided[index] = index.ToString()
    }
    collided[7] = "replaced"
    _ = Assert.Equal("replaced", collided[7])?
    return Assert.Equal("11", collided[11])
}
