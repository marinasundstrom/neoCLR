module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Introspection.*
import System.Result.*
import NeoClr.Testing.*

interface Named {
    val Name: string { get }
}

interface Tagged : Named {
    val Tag: int { get }
}

open class Parent : Tagged {
    val Name: string => "parent"
    val Tag: int => 1
}

class Child : Parent { }
class Other { }

[Test("Type identity and assignment direction")]
func Identity() -> Result<unit, TestFailure> {
    let parent = typeof(Parent)
    let child = typeof(Child)
    _ = Assert.True(parent.AssignableFrom(child), "derived to base")?
    _ = Assert.True(child.AssignableTo(parent), "inverse spelling")?
    _ = Assert.True(child.AssignableFrom(child), "identity")?
    _ = Assert.True(!parent.AssignableTo(child), "base to derived")?
    return Assert.True(!child.AssignableTo(typeof(Other)), "unrelated")
}

[Test("Interface assignment includes inherited contracts")]
func Interfaces() -> Result<unit, TestFailure> {
    _ = Assert.True(typeof(Child).AssignableTo(typeof(Tagged)), "inherited interface")?
    _ = Assert.True(typeof(Child).AssignableTo(typeof(Named)), "base interface")?
    _ = Assert.True(typeof(Tagged).AssignableTo(typeof(Named)), "interface inheritance")?
    _ = Assert.True(typeof(Tagged).AssignableTo(typeof(Object)), "interface to object")?
    return Assert.True(!typeof(Named).AssignableTo(typeof(Child)), "interface to class")
}

[Test("Boxing and instance checks reject null")]
func Instances() -> Result<unit, TestFailure> {
    _ = Assert.True(typeof(int).AssignableTo(typeof(Object)), "boxing")?
    _ = Assert.True(!typeof(int).AssignableTo(typeof(long)), "no numeric conversion")?
    _ = Assert.True(typeof(int).IsInstanceOfType(42), "boxed integer")?
    _ = Assert.True(typeof(Parent).IsInstanceOfType(Child()), "derived instance")?
    _ = Assert.True(typeof(Named).IsInstanceOfType(Child()), "interface instance")?
    _ = Assert.True(!typeof(Child).IsInstanceOfType(Parent()), "base instance")?
    return Assert.True(!typeof(Object).IsInstanceOfType(null), "null is no instance")
}

[Test("Closed generic types remain distinct")]
func Generics() -> Result<unit, TestFailure> {
    let generic = typeof(ArrayList<int>)
    let definition = generic.GetGenericTypeDefinition()
    _ = Assert.True(definition.IsGenericTypeDefinition, "Recovered definition")?
    _ = Assert.True(definition.Equals(typeof(ArrayList<>)), "Definition literal identity")?
    _ = Assert.True(definition.Equals(typeof(ArrayList<string>).GetGenericTypeDefinition()), "Arguments share the same definition")?
    _ = Assert.True(definition.Equals(definition.GetGenericTypeDefinition()), "Definition is idempotent")?
    _ = Assert.True(!definition.Equals(typeof(List<int>).GetGenericTypeDefinition()), "Distinct declarations")?
    let Ok(reconstructed) = definition.MakeGenericType([typeof(int)]) else {
        return Assert.True(false, "Unable to construct retained ArrayList<int>")
    }
    _ = Assert.True(reconstructed.Equals(generic), "Construction preserves closed identity")?
    _ = Assert.True(definition.MakeGenericType([typeof(int), typeof(string)]) is Error(GenericTypeError.ArgumentCount), "Generic arity checked")?
    _ = Assert.True(typeof(int).MakeGenericType([typeof(int)]) is Error(GenericTypeError.InvalidDefinition), "Non-generic definition rejected")?
    _ = Assert.True(generic.IsGenericType, "Constructed nominal type is generic")?
    _ = Assert.True(generic.IsConstructedGenericType, "Constructed identity")?
    _ = Assert.True(!generic.IsGenericTypeDefinition, "Closed type is not its definition")?
    _ = Assert.True(!generic.ContainsGenericParameters, "All arguments supplied")?
    _ = Assert.True(!generic.IsGenericParameter, "Constructed type is not a parameter")?
    _ = Assert.True(!typeof(Parent).IsGenericType, "Inheritance openness is not genericity")?
    _ = Assert.True(!typeof(Parent).ContainsGenericParameters, "Open class has no generic parameters")?
    _ = Assert.True(!typeof((int) -> int).IsGenericType, "Structural function is not nominal generic")?
    _ = Assert.True(!typeof((int) -> int).ContainsGenericParameters, "Closed function shape")?
    _ = Assert.True(typeof(ArrayList<int>).AssignableTo(typeof(List<int>)), "constructed interface")?
    _ = Assert.True(!typeof(ArrayList<int>).AssignableTo(typeof(List<string>)), "different arguments")?
    return Assert.True(!typeof(ArrayList<string>).AssignableTo(typeof(ArrayList<Object>)), "invariant class")
}

[Test("Arrays preserve element identity")]
func Arrays() -> Result<unit, TestFailure> {
    let constructed = typeof(int).MakeArrayType()
    let values: Object?[] = [10, 20]
    let array = (int[])System.Runtime.Reflection.ArrayReflection.Create(constructed, values)
    _ = Assert.Equal(2, array.Length)?
    _ = Assert.Equal(20, array[1])?
    _ = Assert.True(typeof(int).MakeArrayType().Equals(typeof(int[])), "Construct integer vector identity")?
    _ = Assert.True(typeof(string).MakeArrayType().Equals(typeof(string[])), "Construct reference vector identity")?
    _ = Assert.True(typeof(int[]).MakeArrayType().Equals(typeof(int[][])), "Construct jagged vector identity")?
    _ = Assert.True(!typeof(int[]).IsGenericType, "Array is not a nominal generic type")?
    _ = Assert.True(!typeof(int[]).ContainsGenericParameters, "Closed array")?
    _ = Assert.True(typeof(int[]).AssignableTo(typeof(int[])), "array identity")?
    _ = Assert.True(typeof(int[]).AssignableTo(typeof(Object)), "array object")?
    return Assert.True(!typeof(int[]).AssignableTo(typeof(string[])), "array element mismatch")
}

[Test("Subclass checks are strict and exclude interfaces")]
func Subclasses() -> Result<unit, TestFailure> {
    _ = Assert.True(typeof(Child).IsSubclassOf(typeof(Parent)), "direct base")?
    _ = Assert.True(typeof(Child).IsSubclassOf(typeof(Object)), "transitive base")?
    _ = Assert.True(!typeof(Child).IsSubclassOf(typeof(Child)), "self")?
    _ = Assert.True(!typeof(Child).IsSubclassOf(typeof(Named)), "implemented interface")?
    return Assert.True(!typeof(Tagged).IsSubclassOf(typeof(Named)), "inherited interface")
}
