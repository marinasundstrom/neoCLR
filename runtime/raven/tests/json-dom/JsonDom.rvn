module NeoClr.RuntimeTests

import System.*
import System.Data.Json.*
import System.Result.*
import NeoClr.Testing.*

// Ported from json-dom/DomContracts and native-json document checks.

[Test("JSON arrays report invalid indices")]
func JsonArrayBounds() -> Result<unit, TestFailure> {
    let array = JsonArray()
    _ = Assert.True(array.Add(JsonBoolean(true)) is Ok(_), "Add array element")?
    _ = Assert.Equal(1, array.Count)?
    _ = Assert.True(array.Item(0) is Ok(JsonBoolean), "Read array element")?
    _ = Assert.True(array.Item(-1) is Error(JsonError.InvalidIndex(-1)), "Negative index must preserve its value")?
    return Assert.True(array.Item(1) is Error(JsonError.InvalidIndex(1)), "Past-end index must be rejected")
}

[Test("JSON objects distinguish present null from missing fields")]
func JsonObjectNull() -> Result<unit, TestFailure> {
    let document = JsonObject()
    _ = Assert.True(document.Add("note", JsonNull()) is Ok(_), "Add explicit null")?
    _ = Assert.True(document.Field("note") is Ok(JsonNull), "Present null must remain a node")?
    return Assert.True(document.Field("missing") is Error(JsonError.MissingField("missing")),
        "Missing field must preserve its name")
}

[Test("JSON duplicate insertion preserves the original value")]
func JsonObjectDuplicate() -> Result<unit, TestFailure> {
    let document = JsonObject()
    _ = Assert.True(document.Add("note", JsonNull()) is Ok(_), "Add original value")?
    if document.Add("note", JsonBoolean(false)) is Error(JsonError.DuplicateField(let name)) {
        _ = Assert.Equal("note", name)?
    } else {
        return Assert.True(false, "Reject duplicate name")
    }
    _ = Assert.Equal(1, document.Count)?
    return Assert.True(document.Field("note") is Ok(JsonNull), "Rejected insertion must preserve original null")
}

[Test("JSON object indexed access preserves insertion order")]
func JsonObjectOrder() -> Result<unit, TestFailure> {
    let document = JsonObject()
    let array = JsonArray()
    _ = Assert.True(array.Add(JsonBoolean(true)) is Ok(_), "Populate child array")?
    _ = Assert.True(document.Add("readings", array) is Ok(_), "Add first member")?
    _ = Assert.True(document.Add("note", JsonNull()) is Ok(_), "Add second member")?
    _ = Assert.Equal(2, document.Count)?
    if document.Name(0) is Ok(let first) && document.Name(1) is Ok(let second) {
        _ = Assert.Equal("readings", first)?
        _ = Assert.Equal("note", second)?
    } else {
        return Assert.True(false, "Indexed names must be present")
    }
    return Assert.True(document.Item(0) is Ok(JsonArray), "Indexed child must retain its kind")
}

[Test("JSON numbers preserve spelling and reject fractional Int32 conversion")]
func JsonNumberFraction() -> Result<unit, TestFailure> {
    let Ok(number) = JsonNumber.Parse("22.5") else {
        return Assert.True(false, "Valid decimal must parse")
    }
    _ = Assert.Equal("22.5", number.Text)?
    return Assert.True(number.AsInt32() is Error(JsonError.NumberOutOfRange), "Fraction must not silently truncate")
}

[Test("JSON scalar nodes expose their typed values")]
func JsonScalarProperties() -> Result<unit, TestFailure> {
    _ = Assert.Equal("hello", JsonString("hello").Value)?
    _ = Assert.True(JsonBoolean(true).Value, "Boolean true must be preserved")?
    return Assert.True(!JsonBoolean(false).Value, "Boolean false must be preserved")
}

[Test("JSON parsing rejects escaped aliases of duplicate names")]
func JsonEscapedDuplicate() -> Result<unit, TestFailure> {
    if JsonSerializer.DeserializeNode("{\"a\":1,\"\\u0061\":2}") is Error(JsonError.DuplicateField(let name)) {
        return Assert.Equal("a", name)
    }
    return Assert.True(false, "Escaped aliases must compare after decoding")
}

[Test("JSON parsing rejects trailing commas and truncated input")]
func JsonMalformed() -> Result<unit, TestFailure> {
    _ = Assert.True(JsonSerializer.DeserializeNode("[1,]") is Error(_), "Trailing comma must fail")?
    return Assert.True(JsonSerializer.DeserializeNode("[1,") is Error(_), "Truncated array must fail")
}

[Test("JSON nested documents round trip with Unicode and number spelling")]
func JsonDocumentRoundTrip() -> Result<unit, TestFailure> {
    let input = "{\"station\":\"Café\",\"readings\":[1,-2,0],\"flags\":[true,false,null],\"empty\":[],\"metadata\":{},\"detail\":{\"text\":\"雪\",\"decimal\":1.25e2}}"
    return CheckJsonDocument(input, input)
}

[Test("JSON document round trip removes surrounding whitespace")]
func JsonDocumentWhitespace() -> Result<unit, TestFailure> {
    return CheckJsonDocument(" {\"text\":\"Café 😀\",\"values\":[true,null,22.5]} ", "{\"text\":\"Café 😀\",\"values\":[true,null,22.5]}")
}

[Test("JSON documents support every root node kind")]
func JsonRootKinds() -> Result<unit, TestFailure> {
    for text in ["null", "true", "1.25e2", "\"雪\"", "[]", "{}"] {
        _ = CheckJsonDocument(text, text)?
    }
    return Assert.True(true, "All root kinds round trip")
}

[Test("JSON serialization rejects cyclic node graphs")]
func JsonCycle() -> Result<unit, TestFailure> {
    let cycle = JsonArray()
    _ = Assert.True(cycle.Add(cycle) is Ok(_), "Construct cycle for serialization validation")?
    return Assert.True(JsonSerializer.SerializeNode(cycle) is Error(JsonError.LimitExceeded(_)), "Cycle must return a bounded serialization error")
}

func CheckJsonDocument(input: string, canonical: string) -> Result<unit, TestFailure> {
    let Ok(tree) = JsonSerializer.DeserializeNode(input) else {
        return Assert.True(false, "Document must parse")
    }
    let Ok(text) = JsonSerializer.SerializeNode(tree) else {
        return Assert.True(false, "Parsed document must serialize")
    }
    _ = Assert.Equal(canonical, text)?
    let Ok(copy) = JsonSerializer.DeserializeNode(text) else {
        return Assert.True(false, "Serialized document must parse again")
    }
    let Ok(copiedText) = JsonSerializer.SerializeNode(copy) else {
        return Assert.True(false, "Restored document must serialize again")
    }
    return Assert.Equal(canonical, copiedText)
}

[Test("JSON map lookup distinguishes null absence and ordinal keys")]
func JsonMapLookup() -> Result<unit, TestFailure> {
    let document = JsonObject()
    let nullNode = JsonNull()
    let textNode = JsonString("text")
    _ = Assert.True(document.Add("name", nullNode) is Ok(_), "Insert explicit null")?
    _ = Assert.True(document.Add("Name", textNode) is Ok(_), "Case-distinct key")?
    let map: System.Collections.Map<string, JsonValue> = document
    _ = Assert.Equal(2, map.Count)?
    _ = Assert.True(Object.ReferenceEquals(nullNode, map["name"]), "Indexer retains JsonNull identity")?
    _ = Assert.True(Object.ReferenceEquals(textNode, document["Name"]), "Concrete indexer retains node identity")?
    if map.Find("name") is System.Option<JsonValue>.Some(let node) {
        _ = Assert.True(Object.ReferenceEquals(node, nullNode), "Find distinguishes present null")?
    } else {
        return Assert.True(false, "Present JsonNull must be Some")
    }
    _ = Assert.True(map.Find("absent") is System.Option<JsonValue>.None, "Absent key is None")?
    return Assert.True(map.ContainsKey("name") && !map.ContainsKey("NAME"), "Keys use ordinal equality")
}

[Test("JSON map snapshots preserve insertion order and node identity")]
func JsonMapSnapshot() -> Result<unit, TestFailure> {
    let document = JsonObject()
    let first = JsonString("first")
    let second = JsonArray()
    _ = Assert.True(document.Add("雪", first) is Ok(_), "Insert first field")?
    _ = Assert.True(document.Add("second", second) is Ok(_), "Insert second field")?
    let map: System.Collections.Map<string, JsonValue> = document
    let keys = map.Keys
    use pairs = map.GetIterator()
    _ = Assert.True(document.Add("later", JsonBoolean(true)) is Ok(_), "Mutate after snapshots")?
    _ = Assert.Equal(2, keys.Count)?
    _ = Assert.Equal("雪", keys[0])?
    _ = Assert.Equal("second", keys[1])?
    // Deliberately drive the snapshot captured before mutation.
    _ = Assert.True(pairs.MoveNext(), "First pair exists")?
    let (key, value) = pairs.Current
    _ = Assert.Equal("雪", key)?
    _ = Assert.True(Object.ReferenceEquals(first, value), "First node identity retained")?
    _ = Assert.True(pairs.MoveNext(), "Second pair exists")?
    let pair = pairs.Current
    _ = Assert.Equal("second", pair.Key)?
    _ = Assert.True(Object.ReferenceEquals(second, pair.Value), "Second node identity retained")?
    _ = Assert.True(!pairs.MoveNext(), "Snapshot excludes later addition")?
    var count = 0
    for entry in map {
        count += 1
    }
    return Assert.Equal(3, count)
}

[Test("JSON map views keep JSON node serialization precedence")]
func JsonMapSerialization() -> Result<unit, TestFailure> {
    let Ok(node) = JsonSerializer.DeserializeNode("{\"name\":null,\"nested\":[true,{\"x\":1}]}") else {
        return Assert.True(false, "Parse nested object")
    }
    if node is JsonObject document {
        let map: System.Collections.Map<string, JsonValue> = document
        let boxed: Object = map
        _ = Assert.True(map["nested"] is JsonArray, "Parsed object supports map access")?
        let Ok(text) = JsonSerializer.Serialize(boxed) else {
            return Assert.True(false, "Serialize node through Object")
        }
        return Assert.Equal("{\"name\":null,\"nested\":[true,{\"x\":1}]}", text)
    }
    return Assert.True(false, "Parsed root must be JsonObject")
}

[Test("Empty JSON objects support empty map snapshots and safe lookup")]
func JsonMapEmpty() -> Result<unit, TestFailure> {
    let map: System.Collections.Map<string, JsonValue> = JsonObject()
    _ = Assert.Equal(0, map.Count)?
    _ = Assert.Equal(0, map.Keys.Count)?
    use pairs = map.GetIterator()
    _ = Assert.True(!pairs.MoveNext(), "Empty pair iterator")?
    _ = Assert.True(!map.ContainsKey("missing"), "Empty membership")?
    return Assert.True(map.Find("missing") is System.Option<JsonValue>.None, "Empty safe lookup")
}

[Test("JSON sequence indexing retains node identity and explicit null")]
func JsonSequenceAccess() -> Result<unit, TestFailure> {
    let array = JsonArray()
    let first = JsonNull()
    let second = JsonString("雪")
    _ = Assert.True(array.Add(first) is Ok(_), "Add null")?
    _ = Assert.True(array.Add(second) is Ok(_), "Add string")?
    let sequence: System.Collections.Sequence<JsonValue> = array
    _ = Assert.Equal(2, sequence.Count)?
    _ = Assert.True(Object.ReferenceEquals(first, sequence[0]), "Interface indexer retains null identity")?
    return Assert.True(Object.ReferenceEquals(second, array[1]), "Concrete indexer retains string identity")
}

[Test("JSON sequence snapshots preserve order and shared child contents")]
func JsonSequenceSnapshot() -> Result<unit, TestFailure> {
    let array = JsonArray()
    let child = JsonArray()
    let last = JsonNull()
    _ = Assert.True(array.Add(child) is Ok(_), "Add child")?
    _ = Assert.True(array.Add(last) is Ok(_), "Add null")?
    let sequence: System.Collections.Sequence<JsonValue> = array
    use items = sequence.GetIterator()
    _ = Assert.True(array.Add(JsonBoolean(true)) is Ok(_), "Append after snapshot")?
    _ = Assert.True(child.Add(JsonBoolean(false)) is Ok(_), "Mutate shared child")?
    _ = Assert.True(items.MoveNext(), "First item")?
    _ = Assert.True(Object.ReferenceEquals(child, items.Current), "Child identity")?
    if items.Current is JsonArray captured {
        _ = Assert.Equal(1, captured.Count)?
    } else {
        return Assert.True(false, "Snapshot preserves node kind")
    }
    _ = Assert.True(items.MoveNext(), "Second item")?
    _ = Assert.True(Object.ReferenceEquals(last, items.Current), "Null identity")?
    _ = Assert.True(!items.MoveNext(), "Snapshot excludes later append")?
    var count = 0
    for node in sequence {
        count += 1
    }
    return Assert.Equal(3, count)
}

[Test("Empty JSON arrays expose empty sequence snapshots")]
func JsonSequenceEmpty() -> Result<unit, TestFailure> {
    let array = JsonArray()
    let sequence: System.Collections.Sequence<JsonValue> = array
    use items = sequence.GetIterator()
    _ = Assert.Equal(0, sequence.Count)?
    _ = Assert.True(array.Add(JsonNull()) is Ok(_), "Append after empty snapshot")?
    _ = Assert.True(!items.MoveNext(), "Empty snapshot stays empty")?
    return Assert.Equal(1, sequence.Count)
}

[Test("JSON sequence views retain node serialization precedence")]
func JsonSequenceSerialization() -> Result<unit, TestFailure> {
    let input = "[null,{\"name\":\"雪\"},[true],1.25e2]"
    let Ok(node) = JsonSerializer.DeserializeNode(input) else {
        return Assert.True(false, "Parse array")
    }
    if node is JsonArray array {
        let sequence: System.Collections.Sequence<JsonValue> = array
        _ = Assert.Equal(4, sequence.Count)?
        let boxed: Object = sequence
        let Ok(text) = JsonSerializer.Serialize(boxed) else {
            return Assert.True(false, "Serialize sequence as JSON DOM")
        }
        return Assert.Equal(input, text)
    }
    return Assert.True(false, "Expected array root")
}
