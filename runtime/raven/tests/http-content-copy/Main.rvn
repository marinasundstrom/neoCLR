module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.*
import System.Result.*
import NeoClr.Testing.*

// The discovery runner is synchronous. Await these lifecycle tests explicitly.
func Report(result: Result<unit, TestFailure>, name: string) {
    if result is Error(_) { System.Fail(name) }
    Console.WriteLine("PASS " + name)
}

async func Main() -> Task<int> {
    Report(await ABackpressure(), "HTTP content copy awaits writes before reading more and preserves ownership")
    Report(await BBuffered(), "HTTP content copy writes arrays directly and stages other sequences in bounded chunks")
    Report(await CFailures(), "HTTP content copy preserves stream failures and rejects truncated or invalid reads")
    Report(await DLengths(), "HTTP content copy respects declared lengths and skips empty I/O")
    Report(await ECancellation(), "HTTP content copy cancellation skips pre-cancelled input and stops pending writes")
    Report(await FDisposal(), "HTTP content copy rejects disposed bodies and stops before the next source read")
    Console.WriteLine("Tests: 6, passed: 6, failed: 0, skipped: 0")
    return 0
}
