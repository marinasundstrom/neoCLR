module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Result.*
import System.Text.*
import System.Web.Http.*
import NeoClr.Testing.*

func LargePrefix() -> string {
    var text = "x"
    for index in 0..<16 {
        text = String.Concat(text, text)
    }
    return match text.SliceUtf8(0, 65535) {
        Ok(let prefix) => prefix
        Error(_) => {
            System.Fail("ASCII fixture boundary")
            ""
        }
    }
}

// The current TestAttribute contract is synchronous. Buffered ReadText completes
// immediately, so GetResult observes that contract without scheduling a wait.
[Test("HTTP buffered text preserves scalars beyond the one-shot codec quota")]
func ALargeRoundTrip() -> Result<unit, TestFailure> {
    let text = String.Concat(LargePrefix(), "😀é")
    _ = Assert.True(Encodings.Utf8.Encode(text) is Error(EncodingError.LimitExceeded), "Fixture exceeds one-shot quota")?
    let content = HttpContent.FromText(text)
    _ = Assert.Equal(65541, content.Bytes.Count)?
    let Ok(decoded) = content.ReadText().GetResult() else {
        return Error(TestFailure("Large body decode", "Ok", "Error"))
    }
    return Assert.Equal(text, decoded)
}

[Test("HTTP buffered text rejects malformed and truncated large bodies")]
func BLargeErrors() -> Result<unit, TestFailure> {
    let bytes: byte[] = [for index in 0..<65537 => (byte)120]
    bytes[bytes.Length - 1] = (byte)195
    _ = Assert.True(HttpContent(bytes).ReadText().GetResult() is Error(_), "Truncated final scalar")?
    bytes[bytes.Length - 1] = (byte)128
    _ = Assert.True(HttpContent(bytes).ReadText().GetResult() is Error(_), "Stray continuation")?
    bytes[bytes.Length - 1] = (byte)65
    let Ok(text) = HttpContent(bytes).ReadText().GetResult() else {
        return Error(TestFailure("Fresh decode after errors", "Ok", "Error"))
    }
    return Assert.True(text.EndsWithOrdinal("xA"), "Valid body remains readable")
}

[Test("HTTP buffered text preserves empty BOM and NUL data")]
func CSmallRoundTrips() -> Result<unit, TestFailure> {
    for text in ["", "\uFEFFcafé\u0000🌍"] {
        let Ok(decoded) = HttpContent.FromText(text).ReadText().GetResult() else {
            return Error(TestFailure("Buffered text decode", "Ok", "Error"))
        }
        _ = Assert.Equal(text, decoded)?
    }
    return Assert.True(true, "Complete text preserved")
}
