module NeoClr.RuntimeTests

import System.*
import System.Collections.*
import System.Concurrency.Tasks.*
import System.Concurrency.Tasks.TaskOutcome.*
import System.Data.Json.*
import System.IO.*
import System.Globalization.*
import System.Localization.*
import System.Option.*
import System.Result.*
import System.Text.*
import NeoClr.Testing.*

// The memory and current blocking file providers complete inline; observe that fixture contract.
func CompletedValue<T>(operation: Task<T>) -> T {
    let Some(Completed(value)) = operation.Outcome else {
        System.Fail("Expected inline fixture completion")
    }
    return value
}

[Test("Localizer preserves strings and distinguishes missing from empty")]
func ALookup() -> Result<unit, TestFailure> {
    let Ok(strings) = JsonLocalizerProvider.Create("{\"hello\":\"Hej världen\",\"empty\":\"\",\"menu.save\":\"Spara\"}") else {
        return Assert.True(false, "Load catalogue")
    }
    _ = Assert.Equal("Hej världen", strings["hello"])?
    _ = Assert.Equal("Spara", strings["menu.save"])?
    _ = Assert.Equal("HELLO", strings["HELLO"])?
    _ = Assert.Equal("missing", strings["missing"])?
    _ = Assert.True(strings.Find("missing") is None, "Missing key")?
    return Assert.True(strings.Find("empty") is Some(""), "Present empty string")
}

[Test("Localizer uses ordinal keys and decodes JSON escapes")]
func BUnicode() -> Result<unit, TestFailure> {
    let Ok(strings) = JsonLocalizerProvider.Create("{\"é\":\"one\",\"é\":\"two\",\"emoji\":\"\\uD83D\\uDE00\",\"line\":\"a\\nb\"}") else {
        return Assert.True(false, "Distinct ordinal keys")
    }
    _ = Assert.Equal("one", strings["é"])?
    _ = Assert.Equal("two", strings["é"])?
    _ = Assert.Equal("😀", strings["emoji"])?
    _ = Assert.Equal("a\nb", strings["line"])?
    return Assert.True(JsonLocalizerProvider.Create("{\"a\":\"1\",\"\\u0061\":\"2\"}") is Error(LocalizationError.Json(JsonError.DuplicateField("a"))), "Decoded duplicate")
}

[Test("Localizer rejects malformed and non-string catalogues")]
func CInvalid() -> Result<unit, TestFailure> {
    for text in ["[]", "null", "{\"a\":1}", "{\"a\":null}", "{\"a\":{}}", "{\"a\":[]}", "{\"a\":\"b\",}", "{}x", "{\"a\":\"\\uD800\"}", "{\"a\":\"\\q\"}"] {
        _ = Assert.True(JsonLocalizerProvider.Create(text) is Error(_), "Invalid catalogue")?
    }
    let invalid: byte[] = [(byte)123, (byte)255, (byte)125]
    _ = Assert.True(JsonLocalizerProvider.Create(invalid[..]) is Error(_), "Invalid UTF-8")?
    return Assert.True(JsonLocalizerProvider.Create(" {} \n") is Ok(_), "Empty catalogue")
}

[Test("Localizer supports catalogues beyond provisional DOM limits")]
func DSize() -> Result<unit, TestFailure> {
    let json = StringBuilder()
    _ = json.Append("{")
    for index in 0..100 {
        if index > 0 { _ = json.Append(",") }
        _ = json.Append("\"key" + index.ToString() + "\":\"translation\"")
    }
    _ = json.Append("}")
    let Ok(strings) = JsonLocalizerProvider.Create(json.ToString()) else {
        return Assert.True(false, "100 resource strings")
    }
    _ = Assert.Equal("translation", strings["key99"])?
    let tooLarge = System.Runtime.CompilerServices.CheckedStorage.Reserve<byte>(65537)
    return Assert.True(JsonLocalizerProvider.Create(tooLarge[..]) is Error(LocalizationError.Json(JsonError.LimitExceeded(_))), "Byte quota before parsing")
}

[Test("Localizer reads borrowed streams and explicit files")]
func EInput() -> Result<unit, TestFailure> {
    let memory = MemoryStream()
    let Ok(node) = JsonSerializer.DeserializeNode("{\"hello\":\"Hej\"}") else {
        return Assert.True(false, "Fixture")
    }
    _ = Assert.True(CompletedValue(JsonSerializer.SerializeNode(memory, node)) is Ok(_), "Write fixture")?
    _ = Assert.True(memory.Seek(0) is Ok(_), "Rewind")?
    let Ok(strings) = CompletedValue(JsonLocalizerProvider.Read(memory)) else {
        return Assert.True(false, "Read stream")
    }
    _ = Assert.Equal("Hej", strings["hello"])?
    _ = Assert.True(memory.GetPosition() is Ok(_), "Borrowed stream remains open")?
    memory.Close()
    _ = Assert.True(CompletedValue(JsonLocalizerProvider.Read(memory)) is Error(LocalizationError.Read(_)), "Closed stream")?
    let Ok(fileStrings) = JsonLocalizerProvider.Load("catalogue.json") else {
        return Assert.True(false, "Load explicit file")
    }
    _ = Assert.Equal("Hej världen", fileStrings["hello"])?
    _ = Assert.True(JsonLocalizerProvider.Load("invalid.json") is Error(LocalizationError.Json(_)), "Bad file content")?
    return Assert.True(JsonLocalizerProvider.Load("absent-localization-file.json") is Error(LocalizationError.File(_)), "Missing file")
}

class MissingKeys {
    var Count: int = 0
    var Last: string = ""
    func Report(key: string) {
        Count += 1
        Last = key
    }
}

[Test("Localizer diagnostics report only missing display lookups")]
func FDiagnostics() -> Result<unit, TestFailure> {
    let Ok(strings) = JsonLocalizerProvider.Create("{\"empty\":\"\"}") else {
        return Assert.True(false, "Fixture")
    }
    let missing = MissingKeys()
    let reporting = strings.WithMissingKeyHandler(key => missing.Report(key))
    _ = Assert.Equal("", reporting["empty"])?
    _ = Assert.True(reporting.Find("Foo") is None, "Quiet probe")?
    _ = Assert.Equal(0, missing.Count)?
    _ = Assert.Equal("Foo", reporting["Foo"])?
    _ = Assert.Equal(1, missing.Count)?
    _ = Assert.Equal("Foo", missing.Last)?
    _ = Assert.Equal("Foo", strings["Foo"])?
    return Assert.Equal(1, missing.Count)
}


class FeatureX { }

[Test("Localizer scopes and cultures fall back per key")]
func GFallback() -> Result<unit, TestFailure> {
    let provider = JsonLocalizerProvider("resources")
    let Ok(strings) = provider.Load(Culture.SwedishSweden) else {
        return Assert.True(false, "Load unscoped resources")
    }
    _ = Assert.Equal("regional", strings["shared"])?
    _ = Assert.Equal("sv", strings["neutral"])?
    _ = Assert.Equal("invariant", strings["base"])?
    _ = Assert.Equal("", strings["empty"])?
    let Ok(scopedStrings) = provider.Load(Culture.SwedishSweden, "FeatureX") else {
        return Assert.True(false, "Load scoped resources")
    }
    _ = Assert.Equal("scoped sv-SE", scopedStrings["regional"])?
    _ = Assert.Equal("scoped sv", scopedStrings["neutral"])?
    _ = Assert.Equal("scoped invariant", scopedStrings["base"])?
    _ = Assert.True(provider.Load(Culture.SwedishSweden, "../bad") is Error(LocalizationError.InvalidScope), "Scope is not a path")?
    return Assert.True(provider.Load(Culture.SwedishSweden, "Broken") is Error(LocalizationError.Json(_)), "Malformed fallback is not silently ignored")
}

[Test("Localizer invariant fallback is configurable and typed scope is explicit")]
func HInvariant() -> Result<unit, TestFailure> {
    let provider = JsonLocalizerProvider("resources", fallbackToInvariant: false)
    let Ok(strings) = provider.Load<FeatureX>(Culture.SwedishSweden) else {
        return Assert.True(false, "Typed load")
    }
    _ = Assert.Equal("scoped sv-SE", strings["regional"])?
    _ = Assert.Equal("scoped sv", strings["neutral"])?
    _ = Assert.Equal("base", strings["base"])?
    let Ok(invariant) = provider.Load<FeatureX>(Culture.Invariant) else {
        return Assert.True(false, "Explicit invariant")
    }
    _ = Assert.Equal("scoped invariant", invariant["base"])?
    _ = Assert.Equal("regional", invariant["regional"])?
    let Ok(absent) = provider.Load(Culture.HebrewIsrael, "Absent") else {
        return Assert.True(false, "No resources is an empty localizer")
    }
    _ = Assert.True(absent.Find("Foo") is None, "All files absent")?
    return Assert.True(provider.Load(Culture.SwedishSweden, "Broken") is Ok(_), "Disabled invariant file is not read")
}

[Test("Localizer resolves templates before formatting arguments")]
func IFormatting() -> Result<unit, TestFailure> {
    let Ok(strings) = JsonLocalizerProvider.Create("{\"Greeting\":\"Hej {0}!\",\"pair\":\"{0}/{1}\",\"triple\":\"{0}/{1}/{2}\",\"many\":\"{0}/{1}/{2}/{3}\",\"escaped\":\"{{{0}}}\",\"empty\":\"\"}") else {
        return Assert.True(false, "Formatting catalogue")
    }
    _ = Assert.Equal("Hej Raven!", strings["Greeting", "Raven"])?
    _ = Assert.Equal("Hej {0}!", strings["Greeting"])?
    _ = Assert.Equal("A/B", strings["pair", "A", "B"])?
    _ = Assert.Equal("A/B/C", strings["triple", "A", "B", "C"])?
    _ = Assert.Equal("A/B/C/D", strings["many", "A", "B", "C", "D"])?
    _ = Assert.Equal("{Raven}", strings["escaped", "Raven"])?
    _ = Assert.Equal("Hej !", strings["Greeting", (object?)null])?
    _ = Assert.Equal("missing {0}", strings["missing {0}", "Raven"])?
    _ = Assert.True(strings.Find("Greeting", "Raven") is Some("Hej Raven!"), "Found template")?
    _ = Assert.True(strings.Find("pair", "A", "B") is Some("A/B"), "Two arguments")?
    _ = Assert.True(strings.Find("triple", "A", "B", "C") is Some("A/B/C"), "Three arguments")?
    _ = Assert.True(strings.Find("many", "A", "B", "C", "D") is Some("A/B/C/D"), "Argument list")?
    _ = Assert.True(strings.Find("empty", "unused") is Some(""), "Present empty template")?
    _ = Assert.True(strings.Find("missing {0}", "Raven") is None, "Missing key is not formatted")?
    let Ok(swedish) = JsonLocalizerProvider("resources").Load(Culture.SwedishSweden) else {
        return Assert.True(false, "Culture formatting fixture")
    }
    _ = Assert.Equal("12,00", swedish["number", 12])?
    let missing = MissingKeys()
    let reporting = swedish.WithMissingKeyHandler(key => missing.Report(key))
    _ = Assert.Equal("12,00", reporting["number", 12])?
    _ = Assert.Equal("missing {0}", reporting["missing {0}", 12])?
    _ = Assert.True(reporting.Find("missing {0}", 12) is None, "Quiet formatted lookup")?
    return Assert.Equal(1, missing.Count)
}
