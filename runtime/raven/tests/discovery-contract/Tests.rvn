module NeoClr.DiscoveryTests

import System.*
import System.Result.*
import NeoClr.Testing.*

// Source order deliberately differs from declaration-name order.
[Test("after discovered failure")]
func CAfter() -> Result<unit, TestFailure> {
    return Ok(())
}

[Test(Description: "first discovered test")]
[Category("fast")]
func ABefore() -> Result<unit, TestFailure> {
    return Ok(())
}

[Test("discovered failure")]
func BFailure() -> Result<unit, TestFailure> {
    return Assert.Equal(1, 2)
}

[Test]
func `D preserves café. 世界 😀`() -> Result<unit, TestFailure> {
    return Ok(())
}

// Neither ordinary functions nor another namespace's TestAttribute are tests.
func Unmarked() -> Result<unit, TestFailure> {
    Console.WriteLine("UNEXPECTED unmarked test executed")
    return Assert.True(false, "not a test")
}

[Other.Test]
func WrongMarker() -> Result<unit, TestFailure> {
    Console.WriteLine("UNEXPECTED wrong marker executed")
    return Assert.True(false, "not our marker")
}

func Main(arguments: string[]) -> int {
    let suite = TestSuite()
    RegisterDiscoveredTests(suite)
    suite.Add("manual", "manually registered companion", () => Ok(()))
    return TestRunner.Run(suite, arguments)
}

[Test]
[Category("math")]
[Category("fast")]
[Arguments(5, 6, 11)]
[Arguments(2, 3, 5)]
func `E adds integers`(a: int, b: int, expected: int) -> Result<unit, TestFailure> {
    return Assert.Equal(expected, a + b)
}

func `Inputs with spaces. λ`() -> int[] => [13, 27]

[Test]
[Category("data")]
[MethodDataSource("Inputs with spaces. λ")]
func `F accepts data rows`(value: int) -> Result<unit, TestFailure> {
    return Assert.True(value == 13 || value == 27, "source value")
}
