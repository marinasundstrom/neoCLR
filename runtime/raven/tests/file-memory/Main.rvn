import System.*
import System.IO.*
import System.Result.*
import System.Option.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Concurrency.Tasks.TaskOutcome.*

// The current file provider completes inline. Observe outcomes to also assert
// this boundary; it does not test asynchronous OS file I/O.
func CompletedValue<T>(task: Task<T>) -> T {
    let Some(Completed(value)) = task.Outcome else {
        System.Fail("Expected inline file completion")
    }
    return value
}

func Main(arguments: string[]) -> int {
    let Ok(output) = FileOutputStream.CreateNew(arguments[0]) else { return 1 }
    let bytes: byte[] = [(byte)165, (byte)40, (byte)2, (byte)166]
    if CompletedValue(output.Write(bytes, 1, 2)) is Error(_) { return 2 }
    if CompletedValue(output.Write(bytes, 4, 0)) is Error(_) { return 3 }
    if CompletedValue(output.Write(bytes, -1, 1)) is not Error(StreamError.InvalidRange) { return 4 }
    if CompletedValue(output.Flush()) is Error(_) { return 5 }
    output.Close()
    let Ok(input) = FileInputStream.Open(arguments[0]) else { return 6 }
    let destination: byte[] = [(byte)9, (byte)9, (byte)9, (byte)9, (byte)9]
    if CompletedValue(input.Read(destination, 1, 3)) is not Ok(2) { return 7 }
    if destination[0] != 9 || destination[1] != 40 || destination[2] != 2 || destination[3] != 9 || destination[4] != 9 { return 8 }
    if CompletedValue(input.Read(destination, 5, 0)) is not Ok(0) { return 9 }
    if CompletedValue(input.Read(destination, 0, 1)) is not Ok(0) { return 10 }
    if CompletedValue(input.Read(destination, 4, 2)) is not Error(StreamError.InvalidRange) { return 11 }
    if input.GetPosition() is not Ok(2L) { return 12 }
    input.Close()
    if CompletedValue(input.Read(destination, -1, 1)) is not Error(StreamError.Closed) { return 13 }
    let cancellation = CancellationTokenSource()
    cancellation.Cancel()
    if !input.Read(destination, -1, 1, cancellation.Token).IsCancelled { return 14 }
    if !output.Write(bytes, -1, 1, cancellation.Token).IsCancelled { return 15 }
    Console.WriteLine("PASS file memory windows, EOF, sentinels, ranges and cancellation")
    return 0
}
