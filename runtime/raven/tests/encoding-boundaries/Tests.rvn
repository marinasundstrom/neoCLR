module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.TaskOutcome.*
import System.Collections.*
import System.IO.*
import System.Option.*
import System.Result.*
import System.Text.*
import NeoClr.Testing.*

func ReadText(result: Result<string, TextReadError>, expected: string) -> Result<unit, TestFailure> {
    let Ok(text) = result else {
        return Failure(TestFailure("Read text", expected, "Error"))
    }
    return Assert.Equal(expected, text)
}

func ReadLineText(reader: StreamReader, limit: int, expected: string) -> Result<unit, TestFailure> {
    let Ok(Some(text)) = CompletedValue(reader.ReadLine(limit)) else {
        return Failure(TestFailure("Read line", expected, "Error or None"))
    }
    return Assert.Equal(expected, text)
}

func MaximumText() -> string {
    var text = "x"
    for index in 0..16 {
        text = text + text
    }
    return text
}

[Test("StreamReader decodes Unicode lines across single-byte reads")]
func AUnicodeLines() -> Result<unit, TestFailure> {
    for text in ["", "a", "é", "😀", "é", "a\rb", "\u0000"] {
        let encoded = EncodedBytes(text + "\r\n")?
        let source = ShortInput(encoded, -1)
        let Ok(reader) = StreamReader.Create(source) else {
            System.Fail("Unable to create text wrapper")
        }
        reader.NewLine = "\r\n"
        _ = ReadLineText(reader, text.GetUtf8ByteCount(), text)?
        _ = Assert.True(CompletedValue(reader.ReadLine(0)) is Ok(None), "Line EOF")?
        reader.Close()
        _ = Assert.True(source.Closed, "Owned input closes")?
    }
    return Assert.True(true, "All Unicode lines")
}

[Test("StreamReader distinguishes empty lines EOF and lone carriage returns")]
func BLineEndings() -> Result<unit, TestFailure> {
    let endings = EncodedBytes("A\n\nB\r")?
    let source = ShortInput(endings, -1)
    let Ok(reader) = StreamReader.Create(source) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = ReadLineText(reader, 1, "A")?
    _ = ReadLineText(reader, 0, "")?
    _ = ReadLineText(reader, 2, "B\r")?
    _ = Assert.True(CompletedValue(reader.ReadLine(0)) is Ok(None), "EOF is not an empty line")?
    _ = ReadText(CompletedValue(reader.ReadToEnd(0)), "")?
    let carriageReturn = EncodedBytes("\r")?
    let Ok(lone) = StreamReader.Create(ShortInput(carriageReturn, -1)) else {
        System.Fail("Unable to create text wrapper")
    }
    return Assert.True(CompletedValue(lone.ReadLine(0)) is Failure(TextReadError.LimitExceeded), "Lone CR consumes quota")
}

[Test("StreamReader delimits custom decoded output and bounds expansion")]
func CCustomDecode() -> Result<unit, TestFailure> {
    let encoded = EncodedBytes("x")?
    let source = ShortInput(encoded, -1)
    let Ok(reader) = StreamReader.Create(source, ExpandedEncoding()) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = ReadLineText(reader, 1, "A")?
    _ = ReadText(CompletedValue(reader.ReadToEnd(1)), "B")?
    let Ok(limited) = StreamReader.Create(ShortInput(encoded, -1), ExpandedEncoding()) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(limited.ReadToEnd(1)) is Failure(TextReadError.LimitExceeded), "Decoded expansion counts toward limit")?
    let sink = ShortOutput(-1, false)
    let Ok(writer) = StreamWriter.Create(sink, ExpandedEncoding()) else {
        System.Fail("Unable to create text wrapper")
    }
    let Ok(count) = CompletedValue(writer.Write("several input bytes")) else {
        return Failure(TestFailure("Custom write", "Ok", "Error"))
    }
    return Assert.True(count == 1 && sink.Count == 1 && sink.Bytes[0] == 90, "Count encoded output bytes")
}

[Test("StreamWriter reports zero progress and preserves flush failures")]
func DZeroProgress() -> Result<unit, TestFailure> {
    let sink = FailedSink(true)
    let Ok(writer) = StreamWriter.Create(sink, Encodings.Ascii) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(writer.Write("ok")) is Failure(StreamError.IoFailure), "Zero output progress is an error")?
    _ = Assert.Equal(1, sink.Calls)?
    _ = Assert.True(CompletedValue(writer.Write("retry")) is Failure(StreamError.InvalidEncoding), "Cannot replay consumed conversion")?
    _ = Assert.Equal(1, sink.Calls)?
    return Assert.True(CompletedValue(writer.Flush()) is Failure(StreamError.IoFailure), "Flush error remains observable")
}

[Test("StreamReader rejects invalid limits before consuming its input")]
func EReaderPreflight() -> Result<unit, TestFailure> {
    let encoded = EncodedBytes("é")?
    let source = ShortInput(encoded, -1)
    let Ok(reader) = StreamReader.Create(source, Encodings.Utf8, true) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(reader.ReadToEnd(-1)) is Failure(TextReadError.InvalidRange), "Negative limit")?
    _ = Assert.True(CompletedValue(reader.ReadLine(65537)) is Failure(TextReadError.LimitExceeded), "Oversized limit")?
    _ = Assert.Equal(0, source.Position)?
    _ = ReadText(CompletedValue(reader.ReadToEnd(2)), "é")?
    reader.Close()
    _ = Assert.True(!source.Closed, "Borrowed input remains open")?
    return Assert.True(CompletedValue(reader.ReadLine(2)) is Failure(TextReadError.Closed), "Closed reader")
}

[Test("Encoding input quotas reject oversized chunks without poisoning sessions")]
func FEncodingQuota() -> Result<unit, TestFailure> {
    let excessive = MaximumText() + "x"
    _ = Assert.True(Encodings.Utf8.Encode(excessive) is Failure(EncodingError.LimitExceeded), "UTF-8 input quota")?
    _ = Assert.True(Encodings.Ascii.Encode(excessive) is Failure(EncodingError.LimitExceeded), "ASCII input quota")?
    let encoder = Encodings.Utf8.CreateEncoder()
    _ = Assert.True(encoder.Accept(excessive, true) is Failure(EncodingError.LimitExceeded), "Encoder input quota")?
    _ = Assert.True(encoder.Accept("ok", true) is Ok(_), "Quota rejection is retryable")?
    let buffer: byte[] = [(byte)0, (byte)0]
    let Ok(step) = encoder.Drain(buffer[..2]) else {
        return Failure(TestFailure("Quota retry", "Ok", "Error"))
    }
    return Assert.True(step.BytesWritten == 2 && step.State is EncoderState.Finished && buffer[0] == 111 && buffer[1] == 107, "Retry output")
}

[Test("StreamWriter accepts its maximum byte count and preflights oversized lines")]
func GMaximumWrite() -> Result<unit, TestFailure> {
    let text = MaximumText()
    let sink = CountingSink()
    let Ok(writer) = StreamWriter.Create(sink) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(writer.WriteLine(text)) is Failure(StreamError.LimitExceeded), "LF counts toward line limit")?
    _ = Assert.True(CompletedValue(writer.Write(text + "x")) is Failure(StreamError.LimitExceeded), "Oversized write")?
    _ = Assert.Equal(0, sink.Total)?
    let Ok(count) = CompletedValue(writer.Write(text)) else {
        return Failure(TestFailure("Maximum write", "Ok", "Error"))
    }
    _ = Assert.Equal(65536, count)?
    _ = Assert.Equal(65536, sink.Total)?
    _ = Assert.True(sink.AllX, "Maximum write content")?
    return Assert.True(CompletedValue(writer.Finish()) is Ok(0), "Maximum write completion")
}

[Test("StreamReader preserves input failures and rejects truncated UTF-8 at EOF")]
func HInputFailures() -> Result<unit, TestFailure> {
    let encoded = EncodedBytes("AB")?
    let Ok(failed) = StreamReader.Create(ShortInput(encoded, 1)) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(failed.ReadToEnd(2)) is Failure(TextReadError.IoFailure), "Input error after prefix")?
    let bytes: byte[] = [(byte)65, (byte)240, (byte)159]
    let Ok(truncated) = StreamReader.Create(ShortInput(bytes, -1)) else {
        System.Fail("Unable to create text wrapper")
    }
    return Assert.True(CompletedValue(truncated.ReadToEnd(8)) is Failure(TextReadError.InvalidUtf8), "Final incomplete scalar")
}

func EncodedBytes(text: string) -> Result<Sequence<byte>, TestFailure> {
    let Ok(bytes) = Encodings.Utf8.Encode(text) else {
        return Failure(TestFailure("UTF-8 encode", "Ok", "Error"))
    }
    return Ok(bytes)
}

// These fixtures promise inline completion; observation verifies that contract.
// Consumers of potentially pending streams use await instead.
func CompletedValue<T>(operation: System.Concurrency.Tasks.Task<T>) -> T {
    let Some(Completed(value)) = operation.Outcome else {
        System.Fail("Expected an immediately completed fixture operation")
    }
    return value
}
