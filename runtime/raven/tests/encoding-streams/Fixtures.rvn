module NeoClr.RuntimeTests

import System.*
import System.Option.*
import System.Collections.*
import System.IO.*
import System.Tasks.*
import System.Concurrency.*
import System.Result.*
import System.Text.*

class TrailerEncoding : Encoding {
    func Decode(bytes: Sequence<byte>) -> Result<string, EncodingError> {
        return Encodings.Utf8.Decode(bytes)
    }
    func Encode(text: string) -> Result<Sequence<byte>, EncodingError> {
        return Encodings.Utf8.Encode(text + "<end>")
    }
    func CreateDecoder() -> Decoder {
        return Encodings.Utf8.CreateDecoder()
    }
    func CreateEncoder() -> Encoder {
        return TrailerEncoder()
    }
}

class TrailerEncoder : Encoder {
    private val inner: Encoder = Encodings.Utf8.CreateEncoder()
    func Accept(text: string, final: bool) -> Result<unit, EncodingError> {
        if final {
            return inner.Accept(text + "<end>", true)
        }
        return inner.Accept(text, false)
    }
    func Drain(output: byte[], offset: int, count: int) -> Result<EncoderProgress, EncodingError> {
        return inner.Drain(output, offset, count)
    }
}

class ProbeSink : OutputStream {
    private val bytes: ArrayList<byte> = ArrayList<byte>()
    private var closed: bool = false
    private var failAfter: int = -1
    private var flushes: int = 0
    init(failAfter: int) {
        self.failAfter = failAfter
    }
    val Bytes: Sequence<byte> => bytes
    val Closed: bool => closed
    val Flushes: int => flushes
    private func WriteCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if failAfter >= 0 && bytes.Count >= failAfter {
            return Error(StreamError.AccessDenied)
        }
        if count == 0 {
            return Ok(0)
        }
        bytes.Add(buffer[offset])
        return Ok(1)
    }
    private func FlushCore() -> Result<unit, StreamError> {
        flushes += 1
        return Ok(())
    }
    func Close() {
        closed = true
    }

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(WriteAll(buffer, offset, count))
    }

    private func WriteAll(buffer: byte[], offset: int, count: int) -> Result<unit, StreamError> {
        var sent = 0
        while !(sent >= count) {
            let amount = WriteCore(buffer, offset + sent, count - sent)?
            if amount == 0 {
                return Error(StreamError.IoFailure)
            }
            sent += amount
        }
        return Ok(())
    }
    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<unit, StreamError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        return Task.FromResult(FlushCore())
    }
}

// The test owns settlement to prove adapters support genuinely pending I/O.
class PendingInput : InputStream {
    private val source = Promise<Result<int, StreamError>>()
    private var destination: System.Option<byte[]> = System.Option<byte[]>.None()
    private var start = 0
    private var requested = false

    func Read(buffer: byte[], offset: int, count: int) -> Task<Result<int, StreamError>> {
        return Read(buffer, offset, count, CancellationToken.None)
    }
    func Read(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        if requested || count == 0 {
            return Task.FromResult(Result<int, StreamError>.Ok(0))
        }
        requested = true
        destination = System.Option<byte[]>.Some(buffer)
        start = offset
        return source.Task
    }
    func Complete() {
        if let Some(buffer) = destination {
            buffer[start] = (byte)65
        }
        _ = source.Complete(Ok(1))
    }
    func Cancel() {
        _ = source.Cancel()
    }
    func Close() { }
}

class PendingOutput : OutputStream {
    private val source = Promise<Result<unit, StreamError>>()
    private var received = 0
    val Received: int => received

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        received += count
        return source.Task
    }
    func Complete() {
        _ = source.Complete(Ok(()))
    }
    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        return Task.FromResult(Result<unit, StreamError>.Ok(()))
    }
    func Close() { }
}
