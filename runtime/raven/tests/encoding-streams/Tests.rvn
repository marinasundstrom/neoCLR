module NeoClr.RuntimeTests

import System.*
import System.Concurrency.Tasks.TaskOutcome.*
import System.Collections.*
import System.IO.*
import System.Optional.*
import System.Result.*
import System.Text.*
import NeoClr.Testing.*

func Wrote(result: Result<int, StreamError>, expected: int) -> Result<unit, TestFailure> {
    let Ok(count) = result else {
        return Failure(TestFailure("Write", "Ok", "Error"))
    }
    return Assert.Equal(expected, count)
}

func Content(bytes: Sequence<byte>, expected: string) -> Result<unit, TestFailure> {
    let Ok(text) = Encodings.Utf8.Decode(ArrayList<byte>(bytes)[..]) else {
        return Failure(TestFailure("Encoded output", "UTF-8", "Error"))
    }
    return Assert.Equal(expected, text)
}

[Test("StreamWriter completes short writes and preserves cross-input graphemes")]
func AShortWrites() -> Result<unit, TestFailure> {
    let sink = ProbeSink(-1)
    let Ok(writer) = StreamWriter.Create(sink, Encodings.Utf8, true) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Wrote(CompletedValue(writer.Write("é😀")), 6)?
    _ = Wrote(CompletedValue(writer.Write("e")), 1)?
    _ = Wrote(CompletedValue(writer.Write("́")), 2)?
    _ = Wrote(CompletedValue(writer.Finish()), 0)?
    _ = Content(sink.Bytes, "é😀é")?
    writer.Close()
    _ = Assert.True(!sink.Closed, "leaveOpen preserves sink")?
    return Assert.True(CompletedValue(writer.Write("A")) is Failure(StreamError.Closed), "Closed wrapper rejects writes")
}

[Test("ASCII StreamWriter rejects complete lines before output and remains reusable")]
func BAsciiPreflight() -> Result<unit, TestFailure> {
    let sink = ProbeSink(-1)
    let Ok(writer) = StreamWriter.Create(sink, Encodings.Ascii) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(writer.Write("prefix é")) is Failure(StreamError.InvalidEncoding), "Strict write")?
    _ = Assert.Equal(0, sink.Bytes.Count)?
    _ = Wrote(CompletedValue(writer.Write("ok")), 2)?
    _ = Assert.True(CompletedValue(writer.WriteLine("é")) is Failure(StreamError.InvalidEncoding), "Strict complete line")?
    _ = Assert.Equal(2, sink.Bytes.Count)?
    _ = Wrote(CompletedValue(writer.WriteLine("A")), 2)?
    _ = Content(sink.Bytes, "okA\n")?
    writer.Close()
    return Assert.True(sink.Closed, "Owned sink closes")
}

[Test("Custom encoder trailers require explicit Finish and are emitted once")]
func CCompletion() -> Result<unit, TestFailure> {
    let sink = ProbeSink(-1)
    let Ok(writer) = StreamWriter.Create(sink, TrailerEncoding(), true) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Wrote(CompletedValue(writer.Write("A")), 1)?
    _ = Assert.True(CompletedValue(writer.Flush()) is Ok(_), "Flush succeeds")?
    _ = Assert.Equal(1, sink.Flushes)?
    _ = Content(sink.Bytes, "A")?
    _ = Wrote(CompletedValue(writer.Finish()), 5)?
    _ = Wrote(CompletedValue(writer.Finish()), 0)?
    _ = Content(sink.Bytes, "A<end>")?
    return Assert.True(CompletedValue(writer.Write("B")) is Failure(StreamError.InvalidEncoding), "No writes after finalization")
}

[Test("Closing a writer manages ownership without implicit encoder finalization")]
func DClose() -> Result<unit, TestFailure> {
    let sink = ProbeSink(-1)
    let Ok(writer) = StreamWriter.Create(sink, TrailerEncoding()) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Wrote(CompletedValue(writer.Write("A")), 1)?
    writer.Close()
    _ = Assert.True(sink.Closed, "Owned sink closes")?
    _ = Content(sink.Bytes, "A")?
    return Assert.True(CompletedValue(writer.Finish()) is Failure(StreamError.Closed), "Cannot finish a closed writer")
}

[Test("Partial write and final-output failures are observable without replay")]
func EOutputFailure() -> Result<unit, TestFailure> {
    let sink = ProbeSink(1)
    let Ok(writer) = StreamWriter.Create(sink, Encodings.Utf8, true) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(writer.Write("AB")) is Failure(StreamError.AccessDenied), "Preserve first output error")?
    _ = Content(sink.Bytes, "A")?
    _ = Assert.True(CompletedValue(writer.Write("C")) is Failure(StreamError.InvalidEncoding), "Failed writer cannot replay")?
    _ = Assert.True(CompletedValue(writer.Finish()) is Failure(StreamError.InvalidEncoding), "Failed writer cannot finalize")?
    let finalSink = ProbeSink(2)
    let Ok(finalWriter) = StreamWriter.Create(finalSink, TrailerEncoding(), true) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Wrote(CompletedValue(finalWriter.Write("A")), 1)?
    _ = Assert.True(CompletedValue(finalWriter.Finish()) is Failure(StreamError.AccessDenied), "Final trailer failure")?
    _ = Content(finalSink.Bytes, "A<")?
    _ = Assert.True(CompletedValue(finalWriter.Finish()) is Failure(StreamError.InvalidEncoding), "No final-output replay")?
    return Content(finalSink.Bytes, "A<")
}

[Test("Custom encoder final acceptance waits for all trailer bytes to drain")]
func FFinalDrain() -> Result<unit, TestFailure> {
    let encoder: Encoder = TrailerEncoder()
    _ = Assert.True(encoder.Accept("", true) is Ok(_), "Accept final input")?
    let buffer: byte[] = [(byte)0, (byte)0, (byte)0]
    let Ok(first) = encoder.Drain(buffer[..3]) else {
        return Failure(TestFailure("First final drain", "Ok", "Error"))
    }
    _ = Assert.True(first.BytesWritten == 3 && first.State is EncoderState.NeedsOutput, "Trailer still pending")?
    _ = Assert.True(buffer[0] == 60 && buffer[1] == 101 && buffer[2] == 110, "Trailer prefix")?
    let Ok(last) = encoder.Drain(buffer[..3]) else {
        return Failure(TestFailure("Last final drain", "Ok", "Error"))
    }
    return Assert.True(last.BytesWritten == 2 && last.State is EncoderState.Finished && buffer[0] == 100 && buffer[1] == 62, "Completion includes trailer suffix")
}

[Test("Selected ASCII reader recognizes CRLF and preserves borrowed ownership")]
func GReader() -> Result<unit, TestFailure> {
    let source = MemoryStream()
    let bytes: byte[] = [(byte)65, (byte)13, (byte)10, (byte)66]
    _ = Assert.True(CompletedValue(source.Write(bytes, 0, 4)) is Ok(_), "Complete byte write")?
    _ = Assert.True(source.Seek(0L) is Ok(_), "Rewind input")?
    let Ok(reader) = StreamReader.Create(source, Encodings.Ascii, true) else {
        System.Fail("Unable to create text wrapper")
    }
    reader.NewLine = "\r\n"
    let Ok(Some(line)) = CompletedValue(reader.ReadLine(1)) else {
        return Failure(TestFailure("ASCII line", "Some", "Error or None"))
    }
    _ = Assert.Equal("A", line)?
    let Ok(rest) = CompletedValue(reader.ReadToEnd(1)) else {
        return Failure(TestFailure("ASCII remainder", "Ok", "Error"))
    }
    _ = Assert.Equal("B", rest)?
    reader.Close()
    return Assert.True(source.Seek(0L) is Ok(_), "Borrowed source remains open")
}

[Test("Selected readers reject malformed bytes and enforce decoded text limits")]
func HReaderErrors() -> Result<unit, TestFailure> {
    let source = MemoryStream()
    let bytes: byte[] = [(byte)65, (byte)128]
    _ = Assert.True(CompletedValue(source.Write(bytes, 0, 2)) is Ok(_), "Complete byte write")?
    _ = Assert.True(source.Seek(0L) is Ok(_), "Rewind invalid input")?
    let Ok(reader) = StreamReader.Create(source, Encodings.Ascii) else {
        System.Fail("Unable to create text wrapper")
    }
    _ = Assert.True(CompletedValue(reader.ReadToEnd(8)) is Failure(TextReadError.InvalidEncoding), "Strict reader conversion")?
    let valid = MemoryStream()
    let plain: byte[] = [(byte)65, (byte)66, (byte)67]
    _ = Assert.True(CompletedValue(valid.Write(plain, 0, 3)) is Ok(_), "Complete byte write")?
    _ = Assert.True(valid.Seek(0L) is Ok(_), "Rewind limited input")?
    let Ok(validReader) = StreamReader.Create(valid, Encodings.Ascii) else {
        System.Fail("Unable to create reader")
    }
    return Assert.True(CompletedValue(validReader.ReadToEnd(2)) is Failure(TextReadError.LimitExceeded), "Decoded text limit")
}

// These fixtures promise inline completion; observation verifies that contract.
// Consumers of potentially pending streams use await instead.
func CompletedValue<T>(operation: System.Concurrency.Tasks.Task<T>) -> T {
    let Some(Completed(value)) = operation.Outcome else {
        System.Fail("Expected an immediately completed fixture operation")
    }
    return value
}

[Test("StreamReader waits for pending input before decoding and completing")]
func IPendingRead() -> Result<unit, TestFailure> {
    let source = PendingInput()
    let Ok(reader) = StreamReader.Create(source) else {
        System.Fail("Unable to create text wrapper")
    }
    let operation = reader.ReadToEnd(16)
    _ = Assert.True(!operation.IsCompleted, "Reader remains pending")?
    source.Complete()
    System.Concurrency.Tasks.TaskQueue.Default.Drain()
    return Assert.True(CompletedValue(operation) is Ok("A"), "Resume decoding and observe EOF")
}

[Test("StreamWriter waits for pending output before reporting the byte count")]
func JPendingWrite() -> Result<unit, TestFailure> {
    let sink = PendingOutput()
    let Ok(writer) = StreamWriter.Create(sink) else {
        System.Fail("Unable to create text wrapper")
    }
    let operation = writer.Write("é")
    _ = Assert.True(!operation.IsCompleted && sink.Received == 2, "Writer retains pending output")?
    sink.Complete()
    System.Concurrency.Tasks.TaskQueue.Default.Drain()
    return Assert.True(CompletedValue(operation) is Ok(2), "Report bytes only after settlement")
}

[Test("Cancelled input cancels the pending reader operation")]
func KPendingCancellation() -> Result<unit, TestFailure> {
    let source = PendingInput()
    let Ok(reader) = StreamReader.Create(source) else {
        System.Fail("Unable to create text wrapper")
    }
    let operation = reader.ReadToEnd(16)
    _ = Assert.True(!operation.IsCompleted, "Reader starts pending")?
    source.Cancel()
    System.Concurrency.Tasks.TaskQueue.Default.Drain()
    return Assert.True(operation.IsCancelled, "Cancellation propagates through await")
}
