module NeoClr.RuntimeTests

import System.*
import System.Result.*
import NeoClr.Testing.*

[Test("Platform version types retain distinct readable representations")]
func AVersionText() -> Result<unit, TestFailure> {
    _ = Assert.Equal("10.0.26100.0", WindowsVersion(10, 0, 26100, 0).ToString())?
    _ = Assert.Equal("15.2.0", ProductVersion(15, 2, 0).ToString())?
    _ = Assert.Equal("6.12.0-custom", KernelRelease("6.12.0-custom").ToString())?
    return Assert.Equal("API 35", AndroidApiLevel(35).ToString())
}

func CheckOS(value: OperatingSystem, expected: string) -> Result<unit, TestFailure> {
    _ = Assert.Equal(expected, value.ToString())?
    let boxed: object = value
    _ = Assert.Equal(expected, boxed.ToString())?
    return Assert.Equal(expected, "${value}")
}

[Test("Every OS case formats through base Object and interpolation")]
func BOSDisplay() -> Result<unit, TestFailure> {
    _ = CheckOS(OperatingSystem.Windows(WindowsVersion(10, 0, 26100, 0)), "Windows 10.0.26100.0")?
    _ = CheckOS(OperatingSystem.MacOS(ProductVersion(15, 2, 0)), "macOS 15.2.0")?
    _ = CheckOS(OperatingSystem.Linux(KernelRelease("6.12.0-custom"), DistributionRelease("debian", "testing")), "Linux 6.12.0-custom (debian testing)")?
    _ = CheckOS(OperatingSystem.Linux(KernelRelease("6.12.0"), null), "Linux 6.12.0")?
    _ = CheckOS(OperatingSystem.Android(AndroidApiLevel(35)), "Android API 35")?
    _ = CheckOS(OperatingSystem.IOS(ProductVersion(18, 0, 0)), "iOS 18.0.0")?
    return CheckOS(OperatingSystem.OtherOS("future host"), "future host")
}

[Test("Distribution identity and release remain independently optional")]
func CDistributionText() -> Result<unit, TestFailure> {
    _ = Assert.Equal("Unknown distribution", DistributionRelease(null, null).ToString())?
    _ = Assert.Equal("debian", DistributionRelease("debian", null).ToString())?
    _ = Assert.Equal("Unknown distribution rolling", DistributionRelease(null, "rolling").ToString())?
    return Assert.Equal("debian testing", DistributionRelease("debian", "testing").ToString())
}

[Test("Architecture cases preserve readable and unknown names")]
func DArchitectureText() -> Result<unit, TestFailure> {
    _ = Assert.Equal("x86", Architecture.X86().ToString())?
    _ = Assert.Equal("x64", Architecture.X64().ToString())?
    _ = Assert.Equal("ARM", Architecture.Arm().ToString())?
    let architecture: Architecture = Architecture.Arm64()
    let boxed: object = architecture
    _ = Assert.Equal("ARM64", architecture.ToString())?
    _ = Assert.Equal("ARM64", boxed.ToString())?
    return Assert.Equal("FutureCPU", Architecture.OtherArchitecture("FutureCPU").ToString())
}

[Test("OS record equality preserves payload and runtime case identity")]
func ERecordEquality() -> Result<unit, TestFailure> {
    let first: OperatingSystem = OperatingSystem.Windows(WindowsVersion(10, 0, 26100, 0))
    let same: OperatingSystem = OperatingSystem.Windows(WindowsVersion(10, 0, 26100, 0))
    let different: OperatingSystem = OperatingSystem.Windows(WindowsVersion(10, 0, 22631, 0))
    _ = Assert.True(first == same && first.Equals(same), "Equal Windows payloads")?
    _ = Assert.Equal(first.GetHashCode(), same.GetHashCode())?
    _ = Assert.True(first != different, "Different build numbers")?
    _ = Assert.True(first != OperatingSystem.Linux(KernelRelease("10.0.26100.0"), null), "Different OS cases")?
    return Assert.True(KernelRelease("6.12-custom") != KernelRelease("6.12"), "Kernel suffix is identity")
}

[Test("Live discovery returns execution platform architecture and newline")]
func FHostDiscovery() -> Result<unit, TestFailure> {
    let result = Environment.GetOperatingSystem()
    let Ok(os) = result else {
        return Error(TestFailure("OS unavailable", "OS description", result.ToString()))
    }
    _ = Assert.True(os.ToString() != "", "OS display")?
    _ = Assert.True(Environment.ProcessArchitecture.ToString() != "", "Process architecture")?
    _ = Assert.True(Environment.OSArchitecture.ToString() != "", "OS architecture")?
    if os is OperatingSystem.Windows {
        return Assert.Equal("\r\n", Environment.NewLine)
    }
    return Assert.Equal("\n", Environment.NewLine)
}

[Test("Discovered platform values survive garbage collection")]
func GHostValueLifetime() -> Result<unit, TestFailure> {
    let Ok(os) = Environment.GetOperatingSystem() else {
        return Error(TestFailure("OS unavailable", "OS description", "Error"))
    }
    let expected = os.ToString()
    let architecture = Environment.OSArchitecture
    let architectureText = architecture.ToString()
    System.Runtime.GC.Collect()
    _ = Assert.Equal(expected, os.ToString())?
    return Assert.Equal(architectureText, architecture.ToString())
}

func Family(os: OperatingSystem) -> string {
    return match os {
        OperatingSystem.Windows => "windows"
        OperatingSystem.Linux => "linux"
        OperatingSystem.MacOS => "macos"
        OperatingSystem.Android => "android"
        OperatingSystem.IOS => "ios"
        OperatingSystem.OtherOS => "other"
    }
}

[Test("Nested OS patterns select characteristics and cover every case")]
func HPatterns() -> Result<unit, TestFailure> {
    let result: Result<OperatingSystem, EnvironmentError> = Ok(OperatingSystem.Linux(KernelRelease("6.12-custom"), DistributionRelease("debian", "testing")))
    if result is Ok(OperatingSystem.Linux(let kernel, let distribution)) {
        _ = Assert.Equal("6.12-custom", kernel.Value)?
        _ = Assert.True(distribution is DistributionRelease, "Distribution payload")?
    } else {
        return Error(TestFailure("Linux pattern", "Linux payload", "No match"))
    }
    _ = Assert.Equal("linux", Family(OperatingSystem.Linux(KernelRelease("6.12"), null)))?
    _ = Assert.Equal("windows", Family(OperatingSystem.Windows(WindowsVersion(10, 0, 26100, 0))))?
    _ = Assert.Equal("macos", Family(OperatingSystem.MacOS(ProductVersion(15, 0, 0))))?
    _ = Assert.Equal("android", Family(OperatingSystem.Android(AndroidApiLevel(35))))?
    _ = Assert.Equal("ios", Family(OperatingSystem.IOS(ProductVersion(18, 0, 0))))?
    return Assert.Equal("other", Family(OperatingSystem.OtherOS("future")))
}
