; Managed array shape. The loader maps this class to the existing arrayref<T> identity.
; Fixed length; element replacement does not imply growable collection operations.
.type class System.Array<T>
    .implements System.Collections.MutableSequence<T>
    .property static Empty() -> arrayref<T>
        .get System.Array<T>::get_Empty()
    .end
    .method static get_Empty() -> arrayref<T>
        ldc.i4 0
        newarr T
        ret
    .end
    .method instance ForEach(System.Func<T,Void> action) -> void
        .local Int32 index
        ldc.i4 0
        stloc index
        br Test
    Body:
        ldarg action
        ldarg this
        ldloc index
        ldelem T
        call instance System.Func<T,Void>::Invoke(T)
        pop
        ldloc index
        ldc.i4 1
        add
        stloc index
    Test:
        ldloc index
        ldarg this
        ldlen
        conv.i4
        blt Body
        ret
    .end
    .property instance Length() -> Int32
        .get instance System.Array<T>::get_Length()
    .end
    .property instance Count() -> Int32
        .get instance System.Array<T>::get_Count()
    .end
    .method instance get_Count() -> Int32
        ldarg this
        ldlen
        conv.i4
        ret
    .end
    .property instance Item(Int32) -> T
        .get instance System.Array<T>::get_Item(Int32)
        .set instance System.Array<T>::set_Item(Int32,T)
    .end
    .method instance get_Length() -> Int32
        ldarg this
        ldlen
        conv.i4
        ret
    .end
    .method instance get_Item(Int32 index) -> T
        ldarg this
        ldarg index
        ldelem T
        ret
    .end
    .method instance set_Item(Int32 index, T value) -> void
        ldarg this
        ldarg index
        ldarg value
        stelem T
        ret
    .end
.end
