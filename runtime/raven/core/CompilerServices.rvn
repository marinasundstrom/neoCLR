module System.Runtime.CompilerServices

/// Compiler marker for the native Self signature kind; not a concrete callback or payload type.
public struct Self {}

/// Supported runtime method implementation flags.
[System.Flags]
public enum MethodImplOptions {
    /// Prevents method inlining in JIT and AOT compilation.
    NoInlining = 8,
    /// Requests inlining when the backend can safely inline the method.
    AggressiveInlining = 256,
    InternalCall = 4096
}

/// Controls method inlining or declares a runtime-supplied implementation.
/// NoInlining takes precedence over AggressiveInlining; neither changes interpreter behavior.
public class MethodImplAttribute : System.Attribute {
    init(options: MethodImplOptions) {}
}

/// Compiler storage operations with checked initialization.
public static class CheckedStorage {
    /// Reserves an array whose slots must be written before they can be read.
    /// Negative lengths, allocation limits and uninitialized reads fault.
    static func Reserve<T>(count: int) -> T[] => neoCLR.Runtime.ReserveArray<T>(count)
}
