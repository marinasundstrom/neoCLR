namespace System

import System.Runtime.CompilerServices.RuntimeServices
import System.Result.*

public struct LocalDateTime {
    private field StoredDate: Date
    private field StoredTime: Time

    private init(date: Date, time: Time) {
        StoredDate = date
        StoredTime = time
    }

    internal static func FromUnixTimeTicks(ticks: long) -> LocalDateTime {
        let parts = RuntimeServices.UnixTimeToLocal(ticks)
        let Ok(date) = System.Date.Create(parts[0], parts[1], parts[2]) else {
            System.Fault("Invalid local date from runtime")
        }
        let Ok(time) = System.Time.Create(parts[3], parts[4], parts[5], parts[6]) else {
            System.Fault("Invalid local time from runtime")
        }
        return LocalDateTime(date, time)
    }

    val Date: Date => StoredDate
    val Time: Time => StoredTime
}
