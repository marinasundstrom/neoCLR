namespace System

import System.Runtime.CompilerServices.RuntimeServices

public struct UIntPtr : Comparable<nuint> {
    // The runtime supplies intrinsic native-width storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: nuint

    func CompareTo(other: nuint) -> int {
        let left = RuntimeServices.UIntPtrToUInt64(m_value)
        let right = RuntimeServices.UIntPtrToUInt64(other)
        if left < right {
            return -1
        }
        if left > right {
            return 1
        }
        return 0
    }
}
