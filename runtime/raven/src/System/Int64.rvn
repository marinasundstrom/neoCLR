module System

import System.Result.*

public struct Int64 : Number, Formattable, EquatableTo<long> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: long

    static val MinValue: long => -9223372036854775807L - 1L
    static val MaxValue: long => 9223372036854775807L

    static func Parse(value: string) -> Result<long, NumberParseError> {
        let payload = neoCLR.Runtime.ParseInt64(value)
        if neoCLR.Runtime.IsValue<long>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<long>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<byte>(payload)
        if status == 1 {
            return Failure(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Failure(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Failure(NumberParseError.InvalidFormat())
    }

    func ToString() -> string {
        return neoCLR.Runtime.Int64ToString(m_value)
    }

    /// Parses explicit culture punctuation with strict three-digit grouping; whitespace is not accepted.
    static func Parse(text: string, culture: Globalization.Culture) -> Result<long, NumberParseError> {
        let normalized = Globalization.NumericParsing.Normalize(text, culture, false)?
        return Parse(normalized)
    }

    /// Formats with the current culture. Supports empty/G/G0, D, F and N; D/F/N precision is 0–99.
    func ToString(format: string) -> string => ToString(format, Globalization.Culture.Current)

    /// Formats with explicit culture. D pads integer digits; F adds fractional zeros; N also groups.
    /// Unsupported specifiers or precision fault. Parsing remains invariant.
    func ToString(format: string, culture: Globalization.Culture) -> string {
        return Globalization.IntegerFormatting.Format((long)m_value, format, culture)
    }

    static val Zero: long => (long)0
    static val One: long => (long)1

    static func +(left: long, right: long) -> long => (long)(left + right)
    static func -(left: long, right: long) -> long => (long)(left - right)
    static func *(left: long, right: long) -> long => (long)(left * right)
    static func /(left: long, right: long) -> long => (long)(left / right)

    /// Tests equality with another value of the same type without boxing.
    func Equals(other: long) -> bool => m_value == other

    func CompareTo(other: long) -> int {
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
