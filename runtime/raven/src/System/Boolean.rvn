module System

import System.Result.*

public struct Boolean : ComparableTo<bool>, EquatableTo<bool> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: bool

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<bool, BooleanParseError> {
        let payload = neoCLR.Runtime.ParseBoolean(value)
        if neoCLR.Runtime.IsValue<bool>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<bool>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<int>(payload)
        if status == 1 {
            return Error(BooleanParseError.InvalidFormat())
        }
        System.Fail("invalid native parse status")
        return Error(BooleanParseError.InvalidFormat())
    }

    /// Tests equality with another value of the same type without boxing.
    func Equals(other: bool) -> bool => m_value == other

    func CompareTo(other: bool) -> int {
        if m_value == other {
            return 0
        }
        if m_value {
            return 1
        }
        return -1
    }
}
