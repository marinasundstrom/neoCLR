module System.Web.Http

import System.*
import System.Collections.*
import System.Result.*

// Bounded buffering policy, independent of socket/codec per-operation limits.
// Configurable per-client/server budgets and live body streams remain follow-ups.
internal static class HttpWireLimits {
    static val BodyBytes: int => 1048576
    static val HeaderBytes: int => 32768
    static val HeaderCount: int => 100
    static val ChunkFramingBytes: int => 65536
    static val InformationalResponses: int => 16
}

internal class HttpChunkDecoder {
    private val body: ArrayList<byte>
    private val emptyOnly: bool
    private var chunkState = 0
    private var chunkSize = 0
    private var chunkDigits = 0
    private var framingBytes = 0
    private var ended = false

    internal init(body: ArrayList<byte>, emptyOnly: bool) {
        self.body = body
        self.emptyOnly = emptyOnly
    }

    // Chunk metadata is bounded separately from decoded content. This first
    // implementation explicitly rejects extensions and nonempty trailers.
    internal func Push(value: byte) -> Result<bool, HttpError> {
        if chunkState != 2 {
            framingBytes += 1
            if framingBytes > HttpWireLimits.ChunkFramingBytes {
                return Error(HttpError.LimitExceeded("Chunk framing limit exceeded"))
            }
        }
        if chunkState == 0 {
            if value == 59 {
                return Error(HttpError.Unsupported("Chunk extensions unsupported"))
            }
            if value == 13 && chunkDigits > 0 {
                chunkState = 1
                return Ok(false)
            }
            var digit = -1
            if value >= 48 && value <= 57 {
                digit = (int)value - 48
            }
            if value >= 65 && value <= 70 {
                digit = (int)value - 55
            }
            if value >= 97 && value <= 102 {
                digit = (int)value - 87
            }
            if digit < 0 {
                return Error(HttpError.Protocol("Invalid chunk size"))
            }
            if chunkSize > (HttpWireLimits.BodyBytes - body.Count - digit) / 16 || digit > HttpWireLimits.BodyBytes - body.Count {
                return Error(HttpError.LimitExceeded("Body limit exceeded"))
            }
            chunkSize = chunkSize * 16 + digit
            chunkDigits += 1
        } else if chunkState == 1 {
            if value != 10 {
                return Error(HttpError.Protocol("Invalid chunk CRLF"))
            }
            if emptyOnly && chunkSize != 0 {
                return Error(HttpError.Protocol("This message cannot contain content"))
            }
            chunkState = if chunkSize == 0 { 5 } else { 2 }
        } else if chunkState == 2 {
            body.Add(value)
            chunkSize -= 1
            if chunkSize == 0 {
                chunkState = 3
            }
        } else if chunkState == 3 {
            if value != 13 {
                return Error(HttpError.Protocol("Invalid chunk CRLF"))
            }
            chunkState = 4
        } else if chunkState == 4 {
            if value != 10 {
                return Error(HttpError.Protocol("Invalid chunk CRLF"))
            }
            chunkState = 0
            chunkDigits = 0
        } else if chunkState == 5 {
            if value != 13 {
                return Error(HttpError.Unsupported("Trailers unsupported"))
            }
            chunkState = 6
        } else {
            if value != 10 {
                return Error(HttpError.Protocol("Invalid chunk CRLF"))
            }
            ended = true
        }
        return Ok(ended)
    }

}
