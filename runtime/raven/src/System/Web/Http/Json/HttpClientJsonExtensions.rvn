module System.Web.Http.Json

import System.Diagnostics.CodeAnalysis.*
import System.*
import System.Concurrency.*
import System.Data.Json.*
import System.Introspection.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

/// Buffered JSON client conveniences using the configured HTTP handler.
public extension HttpClientJsonExtensions for HttpClient {
    /// Sends GET and decodes a successful response as a supported flat model.
    func GetFromJson<[DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] T>(url: string) -> Task<Result<T, HttpError | JsonError>> {
        let transform: (Result<Object, HttpError | JsonError>) -> Result<T, HttpError | JsonError> = JsonClientOperations.Convert<T>
        return JsonClientOperations.Get(self, url, typeof(T), CancellationToken.None).Map(transform)
    }

    /// Sends GET and decodes a successful response as a supported flat model.
    func GetFromJson<[DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] T>(url: string, cancellationToken: CancellationToken) -> Task<Result<T, HttpError | JsonError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<T, HttpError | JsonError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        let transform: (Result<Object, HttpError | JsonError>) -> Result<T, HttpError | JsonError> = JsonClientOperations.Convert<T>
        return JsonClientOperations.Get(self, url, typeof(T), cancellationToken).Map(transform)
    }

    /// Sends GET and decodes a successful response as a supported flat model.
    func GetFromJson<[DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] T>(url: Uri) -> Task<Result<T, HttpError | JsonError>> {
        let transform: (Result<Object, HttpError | JsonError>) -> Result<T, HttpError | JsonError> = JsonClientOperations.Convert<T>
        return JsonClientOperations.Get(self, url, typeof(T), CancellationToken.None).Map(transform)
    }

    /// Sends GET and decodes a successful response as a supported flat model.
    func GetFromJson<[DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] T>(url: Uri, cancellationToken: CancellationToken) -> Task<Result<T, HttpError | JsonError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<T, HttpError | JsonError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        let transform: (Result<Object, HttpError | JsonError>) -> Result<T, HttpError | JsonError> = JsonClientOperations.Convert<T>
        return JsonClientOperations.Get(self, url, typeof(T), cancellationToken).Map(transform)
    }

    /// Serializes a supported flat model and returns the HTTP response, including non-success status.
    func PostAsJson<T>(url: string, value: T) -> Task<Result<HttpResponse, HttpError | JsonError>> {
        return JsonClientOperations.Post(self, url, value, CancellationToken.None)
    }

    /// Serializes a supported flat model and returns the HTTP response, including non-success status.
    func PostAsJson<T>(url: string, value: T, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError | JsonError>> {
        return JsonClientOperations.Post(self, url, value, cancellationToken)
    }

    /// Serializes a supported flat model and returns the HTTP response, including non-success status.
    func PostAsJson<T>(url: Uri, value: T) -> Task<Result<HttpResponse, HttpError | JsonError>> {
        return JsonClientOperations.Post(self, url, value, CancellationToken.None)
    }

    /// Serializes a supported flat model and returns the HTTP response, including non-success status.
    func PostAsJson<T>(url: Uri, value: T, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError | JsonError>> {
        return JsonClientOperations.Post(self, url, value, cancellationToken)
    }

}
