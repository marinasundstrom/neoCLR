module System.Web.Http.Json

import System.*
import System.Data.Json.*
import System.Introspection.*
import System.IO.*
import System.Result.*
import System.Text.*
import System.Web.Http.*

// Shared buffered conversion for requests and responses, independent of transport.
public class JsonContent {
    private init() { }

    static func Create(value: Object) -> Result<HttpContent, JsonError> {
        let bytes = JsonSerializer.SerializeToUtf8Bytes(value)?
        return Ok(HttpContent(bytes, "application/json; charset=utf-8"))
    }

    static func CreateNode(value: JsonValue) -> Result<HttpContent, JsonError> {
        let bytes = JsonSerializer.SerializeToUtf8Bytes(value)?
        return Ok(HttpContent(bytes, "application/json; charset=utf-8"))
    }

    static func ReadNode(content: HttpContent) -> Result<JsonValue, JsonError> {
        let bytes = BufferedBytes(content)?
        return JsonSerializer.DeserializeNode(bytes)
    }

    static func Read(content: HttpContent, type: TypeInfo) -> Result<Object, JsonError> {
        let bytes = BufferedBytes(content)?
        return JsonSerializer.Deserialize(bytes, type)
    }

    static func Read<T>(content: HttpContent) -> Result<T, JsonError> {
        let instance = Read(content, typeof(T))?
        return Ok((T)instance)
    }

    private static func BufferedBytes(content: HttpContent) -> Result<byte[], JsonError> {
        if !content.IsBuffered {
            return Error(JsonError.Read(TextReadError.IoFailure))
        }
        if content.Bytes.Count > 1024 {
            return Error(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        return Ok(HttpText.Snapshot(content.Bytes))
    }
}
