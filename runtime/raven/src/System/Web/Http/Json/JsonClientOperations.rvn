module System.Web.Http.Json

import System.*
import System.Concurrency.*
import System.Data.Json.*
import System.Introspection.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Web.Http.*

internal class JsonClientOperations {
    init() { }

    static func Convert<T>(result: Result<Object, HttpError | JsonError>) -> Result<T, HttpError | JsonError> {
        let value = result?
        return Ok((T)value)
    }

    private static func Adapt(result: Result<HttpResponse, HttpError>) -> Result<HttpResponse, HttpError | JsonError> {
        let response = result?
        return Ok(response)
    }

    static func Get(client: HttpClient, url: string, type: TypeInfo, token: CancellationToken) -> Task<Result<Object, HttpError | JsonError>> {
        return client.Get(url, token).Map(JsonClientRead(type).Decode)
    }

    static func Post(client: HttpClient, url: string, value: Object, token: CancellationToken) -> Task<Result<HttpResponse, HttpError | JsonError>> {
        if token.IsCancellationRequested {
            let cancelled = Promise<Result<HttpResponse, HttpError | JsonError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        let created = JsonContent.Create(value)
        if let Ok(content) = created {
            return client.Post(url, content, token).Map(Adapt)
        } else if let Failure(error) = created {
            let failed = Promise<Result<HttpResponse, HttpError | JsonError>>()
            _ = failed.Complete(Failure(error))
            return failed.Task
        }
        System.Fail("JSON creation returned no outcome")
    }

    static func Get(client: HttpClient, url: Uri, type: TypeInfo, token: CancellationToken) -> Task<Result<Object, HttpError | JsonError>> {
        return client.Get(url, token).Map(JsonClientRead(type).Decode)
    }

    static func Post(client: HttpClient, url: Uri, value: Object, token: CancellationToken) -> Task<Result<HttpResponse, HttpError | JsonError>> {
        if token.IsCancellationRequested {
            let cancelled = Promise<Result<HttpResponse, HttpError | JsonError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        let created = JsonContent.Create(value)
        if let Ok(content) = created {
            return client.Post(url, content, token).Map(Adapt)
        } else if let Failure(error) = created {
            let failed = Promise<Result<HttpResponse, HttpError | JsonError>>()
            _ = failed.Complete(Failure(error))
            return failed.Task
        }
        System.Fail("JSON creation returned no outcome")
    }
}

internal class JsonClientRead {
    private var type: TypeInfo
    init(type: TypeInfo) {
        self.type = type
    }

    func Decode(result: Result<HttpResponse, HttpError>) -> Result<Object, HttpError | JsonError> {
        let response = result?
        if !response.IsSuccessStatusCode {
            return Failure(HttpError.UnsuccessfulStatus(response.StatusCode))
        }
        let value = JsonContent.Read(response.Content, type)?
        return Ok(value)
    }
}
