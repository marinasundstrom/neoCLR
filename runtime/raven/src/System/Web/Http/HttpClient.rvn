module System.Web.Http

import System.Runtime.CompilerServices.*
import System.Option.*
import System.Concurrency.Tasks.*
import System.Concurrency.*
import System.Networking.*
import System.Networking.Security.*
import System.Networking.Sockets.*
import System.*
import System.Collections.*
import System.Result.*
import System.Text.*
import System.IO.*
import System.Time.*

// Provisional bounded HTTP response contracts.
public class HttpHeader {
    private var storedName: string
    val Name: string => storedName
    private var storedValue: string
    val Value: string => storedValue

    init(name: string, value: string) {
        storedName = name
        storedValue = value
    }

    internal static func FindValues(headers: Sequence<HttpHeader>, name: string) -> Sequence<string> {
        let values = ArrayList<string>()
        let query = HttpText.Encode(name)
        if query.Count == 0 {
            return values
        }
        var index = 0
        while index < query.Count {
            let value = query[index]
            if !((value >= 48 && value <= 57) || (value >= 65 && value <= 90) ||
                (value >= 97 && value <= 122) || value == 33 || value == 35 || value == 36 ||
                value == 37 || value == 38 || value == 39 || value == 42 || value == 43 ||
                value == 45 || value == 46 || value == 94 || value == 95 || value == 96 ||
                value == 124 || value == 126) {
                return values
            }
            index += 1
        }
        for header in headers {
            let candidate = HttpText.Encode(header.Name)
            if candidate.Count == query.Count {
                var matches = true
                index = 0
                while index < query.Count && matches {
                    var left = (int)candidate[index]
                    var right = (int)query[index]
                    if left >= 65 && left <= 90 {
                        left += 32
                    }
                    if right >= 65 && right <= 90 {
                        right += 32
                    }
                    matches = left == right
                    index += 1
                }
                if matches {
                    values.Add(header.Value)
                }
            }
        }
        return values
    }
}

public class HttpResponse : Disposable {
    /// The response protocol version. Current transport accepts and emits HTTP/1.1 only.
    val Version: HttpVersion => HttpVersion.Http11
    private var reasonPhrase: string? = null
    private var reasonSource: ArrayList<byte>? = null
    private var reasonEnd: int = 0

    /// The exact HTTP/1.1 reason text, including an empty phrase. Success depends only on StatusCode.
    /// Custom incoming text is decoded on first access and cached; no body read is performed.
    val ReasonPhrase: string {
        get {
            if reasonPhrase is string cached { return cached }
            if reasonSource is ArrayList<byte> source {
                let bytes: ReadOnlySlice<byte> = source[13..reasonEnd]
                if let Ok(text) = HttpText.Decode(bytes) {
                    reasonPhrase = text
                    reasonSource = null
                    return text
                }
                System.Fail("Validated HTTP reason text could not be decoded")
            }
            return if storedStatusCode == 200 { "OK" } else { "" }
        }
    }

    internal func SetReason(source: ArrayList<byte>, end: int) {
        reasonEnd = end
        if end == 13 {
            reasonPhrase = ""
        } else if end == 15 && source[13] == 79 && source[14] == 75 {
            reasonPhrase = "OK"
        } else {
            reasonSource = source
        }
    }

    /// Closes owned response content, including an unread streaming connection.
    func Dispose() { storedContent.Dispose() }

    internal func SetContent(content: HttpContent) { storedContent = content }
    private var originatingRequest: Option<HttpRequest> = None()
    /// The effective client request passed to the handler, including applied defaults.
    val Request: Option<HttpRequest> {
        get {
            if let Some(request) = originatingRequest {
                return Some(request)
            }
            return None()
        }
    }

    internal func Associate(request: HttpRequest) {
        originatingRequest = Some(request)
    }

    private var storedStatusCode: int
    val StatusCode: HttpStatusCode => (HttpStatusCode)storedStatusCode
    /// Whether the response status is in the successful 200–299 range.
    val IsSuccessStatusCode: bool => storedStatusCode >= 200 && storedStatusCode <= 299
    private var storedHeaders: Sequence<HttpHeader>
    val Headers: Sequence<HttpHeader> => storedHeaders

    /// Gets all matching field values in order using ASCII case-insensitive names.
    /// Returns an empty snapshot for absent or invalid names; does not split or join values.
    func GetHeaderValues(name: string) -> Sequence<string> {
        return HttpHeader.FindValues(storedHeaders, name)
    }
    private var storedContent: HttpContent
    val Content: HttpContent => storedContent

    /// Creates a response retaining its body without reading or copying it.
    /// Content metadata replaces any Content-Type header; other headers are preserved.
    init(statusCode: HttpStatusCode, headers: Sequence<HttpHeader>, content: HttpContent) {
        storedStatusCode = (int)statusCode
        storedHeaders = ContentHeaders(headers, content)
        storedContent = content
    }

    /// Creates a response from a numeric status and an explicit content producer.
    /// The transport validates framing and length before sending.
    init(statusCode: int, headers: Sequence<HttpHeader>, content: HttpContent) {
        storedStatusCode = statusCode
        storedHeaders = ContentHeaders(headers, content)
        storedContent = content
    }

    private static func ContentHeaders(headers: Sequence<HttpHeader>, content: HttpContent) -> Sequence<HttpHeader> {
        let Some(mediaType) = content.MediaType else {
            return headers
        }
        let result = ArrayList<HttpHeader>()
        for header in headers {
            if String.CompareOrdinalIgnoreCase(header.Name, "content-type") != 0 {
                result.Add(header)
            }
        }
        result.Add(HttpHeader("Content-Type", mediaType))
        return result
    }

    /// Sets the status and empty content. Does not perform network I/O.
    func Respond(statusCode: HttpStatusCode) {
        Respond(statusCode, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    }

    /// Sets status and content, replacing Content-Type from the content metadata.
    /// Other headers are retained. The context validates and snapshots when completed.
    func Respond(statusCode: HttpStatusCode, content: HttpContent) {
        let headers = ArrayList<HttpHeader>()
        for header in storedHeaders {
            if String.CompareOrdinalIgnoreCase(header.Name, "content-type") != 0 {
                headers.Add(header)
            }
        }
        if let Some(mediaType) = content.MediaType {
            headers.Add(HttpHeader("Content-Type", mediaType))
        }
        storedStatusCode = (int)statusCode
        reasonPhrase = null
        reasonSource = null
        storedContent = content
        storedHeaders = headers
    }


}

internal class HttpResponseDecoder {
    internal init(isHead: bool) {
        self.isHead = isHead
    }
    private var isHead: bool
    private var chunks: HttpChunkDecoder? = null
    private var informational = 0
    private var headerBytes = 0
    private var chunked: bool = false
    private var ended: bool = false
    private var head: ArrayList<byte> = ArrayList<byte>()
    private var body: ArrayList<byte> = ArrayList<byte>()
    private var headers: ArrayList<HttpHeader> = ArrayList<HttpHeader>()
    private var expected: int = -1
    private var statusCode: int = 0
    private var reasonEnd: int = 13
    private var failed: bool = false

    internal val HeadersComplete: bool => expected != -1 && !failed
    internal val BodyLength: int => expected
    internal val EmptyOnly: bool => statusCode == 205
    internal func FinishHeaders() -> HttpResponse {
        let response = HttpResponse(statusCode, headers, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
        response.SetReason(head, reasonEnd)
        return response
    }

    internal val Complete: bool => (ended || (expected >= 0 && body.Count == expected)) && !failed

    internal func Push(value: byte) -> Result<bool, HttpError> {
        if failed {
            return Failure(HttpError.Protocol("Decoder already failed"))
        }
        let result = PushCore(value)
        if let Failure(message) = result {
            failed = true
            return Failure(message)
        }
        return result
    }

    private func PushCore(value: byte) -> Result<bool, HttpError> {
        if Complete {
            return Failure(HttpError.Protocol("Bytes after response"))
        }
        if expected == -2 {
            if body.Count >= HttpWireLimits.BodyBytes {
                return Failure(HttpError.LimitExceeded("Body limit exceeded"))
            }
            if statusCode == 205 {
                return Failure(HttpError.Protocol("Status 205 cannot contain content"))
            }
            body.Add(value)
            return Ok(false)
        }
        if expected == -3 {
            if chunks is HttpChunkDecoder decoder {
                ended = decoder.Push(value)?
                return Ok(Complete)
            }
            return Failure(HttpError.Protocol("Missing chunk decoder"))
        }
        if expected >= 0 {
            body.Add(value)
            return Ok(Complete)
        }
        if headerBytes >= HttpWireLimits.HeaderBytes {
            return Failure(HttpError.LimitExceeded("Header limit exceeded"))
        }
        let count = head.Count
        if value == 10 && (count == 0 || head[count - 1] != 13) {
            return Failure(HttpError.Protocol("Bare LF in headers"))
        }
        if count > 0 && head[count - 1] == 13 && value != 10 {
            return Failure(HttpError.Protocol("Bare CR in headers"))
        }
        if value != 9 && value != 10 && value != 13 && !(value >= 32 && value <= 126) {
            return Failure(HttpError.Protocol("Invalid header byte"))
        }
        headerBytes += 1
        head.Add(value)
        let size = head.Count
        if size >= 4 && head[size - 4] == 13 && head[size - 3] == 10 && head[size - 2] == 13 && head[size - 1] == 10 {
            let length = ParseHead()?
            if statusCode < 200 {
                informational += 1
                if informational > HttpWireLimits.InformationalResponses {
                    return Failure(HttpError.LimitExceeded("Informational response limit exceeded"))
                }
                head = ArrayList<byte>()
                headers = ArrayList<HttpHeader>()
                statusCode = 0
            } else {
                expected = length
                if expected == -3 {
                    chunks = HttpChunkDecoder(body, statusCode == 205, HttpWireLimits.BodyBytes)
                }
            }
        }
        return Ok(Complete)
    }

    internal func EndOfInput() -> Result<HttpResponse, HttpError> {
        if expected == -2 && !failed {
            ended = true
        }
        if !Complete {
            return Failure(HttpError.Protocol("EOF before complete response"))
        }
        return Finish()
    }

    private func Token(value: byte) -> bool {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 33 || value == 35 ||
            value == 36 || value == 37 || value == 38 || value == 39 ||
            value == 42 || value == 43 || value == 45 || value == 46 ||
            value == 94 || value == 95 || value == 96 || value == 124 || value == 126
    }

    private func Text(start: int, end: int, lower: int) -> Result<string, HttpError> {
        let bytes = ArrayList<byte>()
        var index = start
        while index < end {
            var value = head[index]
            if lower == 1 && value >= 65 && value <= 90 {
                value = (byte)((int)value + 32)
            }
            bytes.Add(value)
            index += 1
        }
        if let Ok(text) = HttpText.Decode(bytes) {
            return Ok(text)
        }
        return Failure(HttpError.Protocol("Invalid header text"))
    }

    private func ParseHead() -> Result<int, HttpError> {
        var start = 0
        var line = 0
        var length = -1
        var end = 0
        while end + 1 < head.Count {
            if head[end] != 13 || head[end + 1] != 10 {
                end += 1
                continue
            }
            if line == 0 {
                if end < 13 || Text(0, 9, 0)? != "HTTP/1.1 " || head[12] != 32 {
                    return Failure(HttpError.Protocol("Invalid status line"))
                }
                var code = 0
                var digitIndex = 9
                while digitIndex < 12 {
                    let digit = (int)head[digitIndex] - 48
                    if !(digit >= 0 && digit <= 9) {
                        return Failure(HttpError.Protocol("Invalid status code"))
                    }
                    code = code * 10 + digit
                    digitIndex += 1
                }
                if !(code >= 100 && code <= 599) {
                    return Failure(HttpError.Protocol("Invalid status code"))
                }
                if code == 101 {
                    return Failure(HttpError.Unsupported("Protocol upgrades are not implemented"))
                }
                statusCode = code
                reasonEnd = end
            } else if end == start {
                if chunked && length >= 0 {
                    return Failure(HttpError.Protocol("Ambiguous response framing"))
                }
                if statusCode < 200 {
                    if chunked || length >= 0 {
                        return Failure(HttpError.Protocol("Informational responses cannot contain framing headers"))
                    }
                    return Ok(0)
                }
                if statusCode == 204 {
                    if chunked {
                        return Failure(HttpError.Protocol("Transfer-Encoding is prohibited for status 204"))
                    }
                    if length >= 0 {
                        return Failure(HttpError.Protocol("Content-Length is prohibited for status 204"))
                    }
                    return Ok(0)
                }
                if statusCode == 304 || isHead {
                    // Content-Length describes the selected representation, not a message body.
                    return Ok(0)
                }
                if chunked {
                    return Ok(-3)
                }
                if length < 0 {
                    return Ok(-2)
                }
                if statusCode == 205 && length != 0 {
                    return Failure(HttpError.Protocol("Status 205 cannot contain content"))
                }
                return Ok(length)
            } else {
                if headers.Count >= HttpWireLimits.HeaderCount {
                    return Failure(HttpError.LimitExceeded("Header count exceeded"))
                }
                var colon = start
                while colon < end && head[colon] != 58 {
                    if !Token(head[colon]) {
                        return Failure(HttpError.Protocol("Invalid header name"))
                    }
                    colon += 1
                }
                if colon == start || colon == end {
                    return Failure(HttpError.Protocol("Missing header name or colon"))
                }
                let name = Text(start, colon, 1)?
                var first = colon + 1
                var last = end
                while first < last && (head[first] == 32 || head[first] == 9) {
                    first += 1
                }
                while last > first && (head[last - 1] == 32 || head[last - 1] == 9) {
                    last -= 1
                }
                let value = Text(first, last, 0)?
                if name == "content-encoding" {
                    return Failure(HttpError.Unsupported("Unsupported encoding"))
                }
                if name == "transfer-encoding" {
                    if chunked {
                        return Failure(HttpError.Protocol("Duplicate Transfer-Encoding"))
                    }
                    if Text(first, last, 1)? != "chunked" {
                        return Failure(HttpError.Unsupported("Unsupported transfer encoding"))
                    }
                    chunked = true
                }
                if name == "content-length" {
                    if length >= 0 {
                        return Failure(HttpError.Protocol("Duplicate Content-Length"))
                    }
                    if first == last {
                        return Failure(HttpError.Protocol("Empty Content-Length"))
                    }
                    var number = 0
                    var index = first
                    while index < last {
                        let digit = (int)head[index] - 48
                        if !(digit >= 0 && digit <= 9) {
                            return Failure(HttpError.Protocol("Invalid Content-Length"))
                        }
                        // Bound before multiplication, avoiding integer overflow.
                        let limit = if statusCode == 304 || isHead { 2147483647 } else { HttpWireLimits.BodyBytes }
                        if number > (limit - digit) / 10 {
                            if statusCode == 304 || isHead {
                                return Failure(HttpError.LimitExceeded("Content-Length metadata limit exceeded"))
                            }
                            return Failure(HttpError.LimitExceeded("Body limit exceeded"))
                        }
                        number = number * 10 + digit
                        index += 1
                    }
                    length = number
                }
                headers.Add(HttpHeader(name, value))
            }
            line += 1
            start = end + 2
            end = start
        }
        return Failure(HttpError.Protocol("Incomplete headers"))
    }

    internal func Finish() -> Result<HttpResponse, HttpError> {
        if !Complete {
            return Failure(HttpError.Protocol("Incomplete or invalid response"))
        }
        let response = HttpResponse(statusCode, headers, HttpMemoryContent(HttpText.Snapshot(body)))
        response.SetReason(head, reasonEnd)
        return Ok(response)
    }
}


// Request and handler contracts are independent of socket transport.
/// Base contract for a reusable request pipeline or terminal transport.
public abstract class HttpHandler : Disposable {
    protected init() { }

    abstract func Send(request: HttpRequest, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>>

    /// Releases resources owned by the handler. Stateless handlers need no override.
    virtual func Dispose() { }
}

/// Base for middleware which forwards to an owned inner handler.
public abstract class DelegatingHandler : HttpHandler {
    private var inner: HttpHandler? = null
    private var started = false
    private var disposed = false

    protected init() { }

    protected init(innerHandler: HttpHandler) {
        inner = innerHandler
    }

    /// The owned next handler. Assign before the first send or disposal.
    var InnerHandler: HttpHandler? {
        get => inner
        set {
            if disposed || started {
                System.Fail("Handler pipeline is already started or disposed")
            }
            if value is not HttpHandler {
                System.Fail("Inner handler cannot be null")
            }
            inner = value
        }
    }

    /// Forwards to the inner handler, freezing pipeline configuration.
    override func Send(request: HttpRequest, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        if disposed {
            System.Fail("HTTP handler is disposed")
        }
        let target = inner
        if target is HttpHandler handler {
            started = true
            return handler.Send(request, cancellationToken)
        }
        System.Fail("Inner handler has not been assigned")
    }

    /// Disposes the owned inner handler once. Overrides must call base.Dispose().
    override func Dispose() {
        if disposed {
            return
        }
        disposed = true
        let target = inner
        if target is HttpHandler handler {
            handler.Dispose()
        }
    }
}

public abstract class HttpContent : Disposable {
    private var input: Option<InputStream> = None()
    private var inputLength: int = 0
    private var leaveOpen: bool = true
    private var started: bool = false
    private var disposed: bool = false
    internal val IsDisposed: bool => disposed

    /// True when content already has a complete byte sequence.
    val IsBuffered: bool => input is None
    /// Declared byte count, or -1 for incoming chunked/close-delimited content.
    val Length: int {
        get {
            if self is HttpMemoryContent memoryContent {
                return memoryContent.Memory.Length
            }
            if IsBuffered {
                return storedBytes.Count
            }
            return inputLength
        }
    }

    internal static func Incoming(stream: InputStream, length: int) -> HttpContent {
        return HttpStreamContent.IncomingBody(stream, length)
    }

    protected init() { }

    protected init(contentType: string) {
        mediaType = Some(contentType)
    }

    protected init(stream: InputStream, length: int, leaveOpen: bool) {
        input = Some(stream)
        inputLength = length
        self.leaveOpen = leaveOpen
    }

    /// Returns the one-shot input stream, or None for buffered content. Does not read.
    /// The content owns the stream unless HttpStreamContent.Create was passed leaveOpen=true.
    func TryGetStream() -> Option<InputStream> {
        if let Some(stream) = input { return Some(stream) }
        return None()
    }

    /// Returns buffered bytes without reading or consuming an input stream.
    internal func TryGetBytes() -> Option<Sequence<byte>> {
        if IsBuffered && self is not HttpMemoryContent {
            return Some(storedBytes)
        }
        return None()
    }

    /// <summary>Copies this body to a destination stream with no cancellation request.</summary>
    /// <param name="destination">Borrowed output; never flushed or closed by this operation.</param>
    /// <returns>Completion or a content/stream failure. Output may be partial on failure.</returns>
    func CopyTo(destination: OutputStream) -> Task<Result<unit, HttpError>> {
        return CopyTo(destination, CancellationToken.None)
    }

    /// <summary>Copies buffered or streaming content with bounded staging and backpressure.</summary>
    /// <param name="destination">Borrowed output; keep it open until completion.</param>
    /// <param name="cancellationToken">Cancellation propagates as a cancelled task, including before empty copies.</param>
    /// <returns>Success after the body is written, or HttpError.Content preserving the stream error. A reused streaming body returns InvalidRequest.</returns>
    /// <remarks>Never flushes or closes either stream. Stream content is consumed once, including after failure or cancellation once started. Known lengths stop exactly at that length and reject early EOF; unknown incoming lengths end at EOF. Do not concurrently read, copy, upload or mutate the body. Array bodies are written directly; other sources use at most 1024 staging bytes. This operation does not add HTTP framing.</remarks>
    async func CopyTo(destination: OutputStream, cancellationToken: CancellationToken) -> Task<Result<unit, HttpError>> {
        if cancellationToken.IsCancellationRequested {
            return await CancelledCopy()
        }
        if disposed {
            return Failure(HttpError.Content(StreamError.Closed))
        }
        _ = BeginUpload()?
        if IsBuffered {
            if buffered is byte[] bytes {
                if bytes.Length == 0 {
                    return Ok(())
                }
                return CopyResult(await destination.Write(bytes, 0, bytes.Length, cancellationToken))
            }
            let count = Length
            if count == 0 {
                return Ok(())
            }
            let sequenceBuffer = CheckedStorage.Reserve<byte>(if count < 1024 { count } else { 1024 })
            var offset = 0
            while offset < count {
                if cancellationToken.IsCancellationRequested {
                    return await CancelledCopy()
                }
                if disposed {
                    return Failure(HttpError.Content(StreamError.Closed))
                }
                let sequenceRemaining = count - offset
                let sequenceTake = if sequenceRemaining < sequenceBuffer.Length { sequenceRemaining } else { sequenceBuffer.Length }
                if self is HttpMemoryContent content {
                    CopyMemoryWindow(content.Memory, offset, sequenceBuffer, sequenceTake)
                } else {
                    var index = 0
                    while index < sequenceTake {
                        sequenceBuffer[index] = storedBytes[offset + index]
                        index += 1
                    }
                }
                _ = CopyResult(await destination.Write(sequenceBuffer, 0, sequenceTake, cancellationToken))?
                offset += sequenceTake
            }
            return Ok(())
        }
        let Some(stream) = input else {
            return Failure(HttpError.Content(StreamError.IoFailure))
        }
        var remaining = inputLength
        if remaining == 0 {
            return Ok(())
        }
        let buffer = CheckedStorage.Reserve<byte>(if remaining > 0 && remaining < 1024 { remaining } else { 1024 })
        while remaining != 0 {
            if cancellationToken.IsCancellationRequested {
                return await CancelledCopy()
            }
            if disposed {
                return Failure(HttpError.Content(StreamError.Closed))
            }
            let take = if remaining > 0 && remaining < buffer.Length { remaining } else { buffer.Length }
            let result = await stream.Read(buffer, 0, take, cancellationToken)
            let Ok(read) = result else {
                if result is Failure(let reason) {
                    return Failure(HttpError.Content(reason))
                }
                return Failure(HttpError.Content(StreamError.IoFailure))
            }
            if read < 0 || read > take || (read == 0 && remaining > 0) {
                return Failure(HttpError.Content(StreamError.IoFailure))
            }
            if cancellationToken.IsCancellationRequested {
                return await CancelledCopy()
            }
            if disposed {
                return Failure(HttpError.Content(StreamError.Closed))
            }
            if read == 0 {
                return Ok(())
            }
            _ = CopyResult(await destination.Write(buffer, 0, read, cancellationToken))?
            if remaining > 0 {
                remaining -= read
            }
        }
        return Ok(())
    }

    private static func CopyMemoryWindow(memory: ReadOnlyMemory<byte>, offset: int, destination: byte[], count: int) {
        let source: ReadOnlySlice<byte> = memory
        var index = 0
        while index < count {
            destination[index] = source[offset + index]
            index += 1
        }
    }

    private static func CopyResult(result: Result<unit, StreamError>) -> Result<unit, HttpError> {
        return match result {
            Ok(_) => Ok(())
            Failure(let reason) => Failure(HttpError.Content(reason))
        }
    }

    private static func CancelledCopy() -> Task<Result<unit, HttpError>> {
        // Cancellation bridge only; ordinary transfers use await directly.
        let source = Promise<Result<unit, HttpError>>()
        _ = source.Cancel()
        return source.Task
    }

    /// Releases owned stream content; borrowed sources remain open. Idempotent.
    func Dispose() {
        if !disposed {
            disposed = true
            if !leaveOpen {
                if let Some(stream) = input {
                    stream.Close()
                }
            }
        }
    }

    internal func BeginUpload() -> Result<unit, HttpError> {
        if !IsBuffered {
            if started || disposed {
                return Failure(HttpError.InvalidRequest("Stream content has already been consumed or disposed"))
            }
            started = true
        }
        return Ok(())
    }

    internal async func ReadUpload(buffer: byte[], count: int, cancellationToken: CancellationToken) -> Task<Result<int, HttpError>> {
        if let Some(stream) = input {
            if disposed {
                return Failure(HttpError.Content(StreamError.Closed))
            }
            let result = await stream.Read(buffer, 0, count, cancellationToken)
            if let Failure(reason) = result {
                return Failure(HttpError.Content(reason))
            }
            if let Ok(read) = result {
                if read <= 0 || read > count {
                    return Failure(HttpError.Content(StreamError.IoFailure))
                }
                return Ok(read)
            }
        }
        return Failure(HttpError.InvalidRequest("Content has no stream source"))
    }

    private var mediaType: Option<string> = None()
    internal val MediaType: Option<string> {
        get {
            if let Some(value) = mediaType {
                return Some(value)
            }
            return None()
        }
    }
    private var buffered: Sequence<byte>? = null
    private val storedBytes: Sequence<byte> => buffered ?? Array<byte>.Empty
    // Internal sequence bridge for wire code; not part of the public content API.
    internal val Bytes: Sequence<byte> {
        get {
            if !IsBuffered || self is HttpMemoryContent {
                System.Fail("Content has no sequence storage")
            }
            return storedBytes
        }
    }

    protected init(bytes: Sequence<byte>) {
        buffered = bytes
    }

    /// Wraps bytes and an outbound Content-Type; socket validation occurs before I/O.
    protected init(bytes: Sequence<byte>, contentType: string) {
        buffered = bytes
        mediaType = Some(contentType)
    }


}

public class HttpRequest : Disposable {
    /// The request protocol version, available after headers. Current transport supports HTTP/1.1 only.
    val Version: HttpVersion => HttpVersion.Http11
    /// Releases owned content without reading or draining it. Safe to repeat.
    /// Header-derived copies share content; disposal affects every alias.
    func Dispose() { storedContent.Dispose() }
    internal var HeadersOnly: bool = false
    internal func SetContent(content: HttpContent) { storedContent = content }
    private var storedContent: HttpContent = HttpMemoryContent(default(ReadOnlyMemory<byte>))
    /// Request body content. Incoming nonempty bodies are consumed asynchronously on demand.
    val Content: HttpContent => storedContent
    private var storedHeaders: Sequence<HttpHeader>
    val Headers: Sequence<HttpHeader> => storedHeaders

    /// Gets all matching field values in order using ASCII case-insensitive names.
    /// Returns an empty snapshot for absent or invalid names; does not split or join values.
    func GetHeaderValues(name: string) -> Sequence<string> {
        return HttpHeader.FindValues(storedHeaders, name)
    }
    private var storedMethod: HttpMethod
    /// The validated method value. Its Method property preserves the wire spelling.
    val Method: HttpMethod => storedMethod
    private var storedHost: string
    val Host: string => storedHost
    private var secure = false
    /// Whether the request uses authenticated HTTPS transport.
    val IsSecure: bool => secure
    private var storedPort: int
    val Port: int => storedPort
    private var storedTarget: string
    val Target: string => storedTarget

    private init(host: string, port: int, target: string) {
        storedHeaders = ArrayList<HttpHeader>()
        storedMethod = HttpMethod.Get
        storedHost = host
        storedPort = port
        storedTarget = target
    }

    internal static func FromIncoming(method: HttpMethod, target: string, host: string, headers: Sequence<HttpHeader>, body: Sequence<byte>, secure: bool) -> Result<HttpRequest, HttpError> {
        let request = IncomingRequest(target, host, secure)?
        request.storedHeaders = headers
        request.storedMethod = method
        request.storedContent = HttpMemoryContent(HttpText.Snapshot(body))
        for header in headers {
            if header.Name == "content-type" {
                request.storedContent = HttpMemoryContent(HttpText.Snapshot(body), header.Value)
            }
        }
        return Ok(request)
    }

    // Incoming origin-form requests already own their authority and target. Do not
    // reconstruct an absolute URL or allocate a Uri merely to recover those fields.
    // Keep the existing URI grammar/error precedence, including malformed Host
    // suffixes, before applying the narrower HTTP authority and 1024-byte quota.
    private static func IncomingCharacters(bytes: Sequence<byte>) -> Result<(), HttpError> {
        var index = 0
        while index < bytes.Count {
            let value = bytes[index]
            if value == 37 {
                if index + 2 >= bytes.Count {
                    return Failure(HttpError.InvalidUri(UriError.InvalidFormat()))
                }
                for offset in 1..3 {
                    let digit = bytes[index + offset]
                    if !((digit >= 48 && digit <= 57) || (digit >= 65 && digit <= 70) || (digit >= 97 && digit <= 102)) {
                        return Failure(HttpError.InvalidUri(UriError.InvalidFormat()))
                    }
                }
                index += 3
                continue
            }
            if !((value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
                (value >= 48 && value <= 57) || value == 45 || value == 46 || value == 95 || value == 126 ||
                value == 58 || value == 47 || value == 63 || value == 35 || value == 64 ||
                value == 33 || value == 36 || value == 38 || value == 39 || value == 40 || value == 41 ||
                value == 42 || value == 43 || value == 44 || value == 59 || value == 61) {
                if value == 91 || value == 93 {
                    return Failure(HttpError.InvalidUri(UriError.UnsupportedAuthority()))
                }
                return Failure(HttpError.InvalidUri(UriError.InvalidFormat()))
            }
            index += 1
        }
        return Ok(())
    }

    private static func IncomingRequest(target: string, authority: string, secure: bool) -> Result<HttpRequest, HttpError> {
        // The decoder admits only nonempty origin-form targets (starting with /),
        // with no fragment. Thus percent escapes cannot cross these two fields.
        let prefixLength = if secure { 8 } else { 7 }
        let length = prefixLength + authority.GetUtf8ByteCount() + target.GetUtf8ByteCount()
        if length > 4096 {
            return Failure(HttpError.InvalidUri(UriError.TooLong()))
        }
        let hostBytes = HttpText.Encode(authority)
        let targetBytes = HttpText.Encode(target)
        IncomingCharacters(hostBytes)?
        IncomingCharacters(targetBytes)?
        var end = 0
        var at = -1
        var lastColon = -1
        while end < hostBytes.Count && hostBytes[end] != 47 && hostBytes[end] != 63 && hostBytes[end] != 35 {
            if hostBytes[end] == 64 {
                if at >= 0 {
                    return Failure(HttpError.InvalidUri(UriError.InvalidFormat()))
                }
                at = end
                lastColon = -1
            } else if hostBytes[end] == 58 {
                lastColon = end
            }
            end += 1
        }
        var position = at + 1
        while position < end {
            let value = hostBytes[position]
            if (value == 58 && position != lastColon) ||
                (lastColon >= 0 && position > lastColon && !(value >= 48 && value <= 57)) {
                return Failure(HttpError.InvalidUri(UriError.InvalidFormat()))
            }
            position += 1
        }
        var fragment = false
        position = end
        while position < hostBytes.Count {
            if hostBytes[position] == 35 {
                if fragment {
                    return Failure(HttpError.InvalidUri(UriError.InvalidFormat()))
                }
                fragment = true
            }
            position += 1
        }
        if length > 1024 {
            return Failure(HttpError.LimitExceeded("URL limit exceeded"))
        }
        var colon = 0
        while colon < end && hostBytes[colon] != 58 {
            let value = hostBytes[colon]
            if !((value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
                (value >= 48 && value <= 57) || value == 45 || value == 46) {
                return Failure(HttpError.Unsupported("Unsupported hostname"))
            }
            colon += 1
        }
        if colon == 0 || colon > 253 {
            return Failure(HttpError.InvalidRequest("Invalid hostname length"))
        }
        var port = if secure { 443 } else { 80 }
        var host = authority
        if colon < end {
            port = 0
            position = colon + 1
            if position == end {
                return Failure(HttpError.InvalidRequest("Empty port"))
            }
            while position < end {
                let digit = (int)hostBytes[position] - 48
                if !(digit >= 0 && digit <= 9) || port > (65535 - digit) / 10 {
                    return Failure(HttpError.InvalidRequest("Invalid port"))
                }
                port = port * 10 + digit
                position += 1
            }
            if port == 0 {
                return Failure(HttpError.InvalidRequest("Invalid port"))
            }
            host = Text(hostBytes, 0, colon)?
        }
        if fragment {
            return Failure(HttpError.Unsupported("Unsupported request target"))
        }
        if end != hostBytes.Count {
            return Failure(HttpError.InvalidRequest("Invalid Host authority"))
        }
        let request = HttpRequest(host, port, target)
        request.secure = secure
        return Ok(request)
    }

    /// Constructs a request using a predefined or custom method, without performing I/O.
    static func Create(method: HttpMethod, url: string) -> Result<HttpRequest, HttpError> {
        return Create(method, url, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    }

    /// Constructs a request with explicit method and content; transport bounds apply when sent.
    static func Create(method: HttpMethod, url: string, content: HttpContent) -> Result<HttpRequest, HttpError> {
        if method is null {
            return Failure(HttpError.InvalidRequest("HTTP method cannot be null"))
        }
        let request = Post(url, content)?
        request.storedMethod = method
        return Ok(request)
    }

    /// Constructs a URI-based request using a predefined or custom method.
    static func Create(method: HttpMethod, uri: Uri) -> Result<HttpRequest, HttpError> {
        return Create(method, uri, HttpMemoryContent(default(ReadOnlyMemory<byte>)))
    }

    /// Constructs a URI-based request with explicit method and content.
    static func Create(method: HttpMethod, uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        if method is null {
            return Failure(HttpError.InvalidRequest("HTTP method cannot be null"))
        }
        let request = Post(uri, content)?
        request.storedMethod = method
        return Ok(request)
    }

    /// Constructs a POST request without performing I/O.
    static func Post(url: string, content: HttpContent) -> Result<HttpRequest, HttpError> {
        let request = Get(url)?
        request.storedMethod = HttpMethod.Post
        request.storedContent = content
        let headers = ArrayList<HttpHeader>()
        if let Some(contentType) = content.MediaType {
            headers.Add(HttpHeader("Content-Type", contentType))
        }
        request.storedHeaders = headers
        return Ok(request)
    }

    /// Constructs a POST request from an absolute HTTP URI.
    static func Post(uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        let request = Get(uri)?
        request.storedMethod = HttpMethod.Post
        request.storedContent = content
        let headers = ArrayList<HttpHeader>()
        if let Some(contentType) = content.MediaType {
            headers.Add(HttpHeader("Content-Type", contentType))
        }
        request.storedHeaders = headers
        return Ok(request)
    }

    /// Constructs an absolute HTTP PUT request with buffered content.
    static func Put(url: string, content: HttpContent) -> Result<HttpRequest, HttpError> {
        let request = Post(url, content)?
        request.storedMethod = HttpMethod.Put
        return Ok(request)
    }

    /// Constructs an absolute HTTP PUT request with buffered content.
    static func Put(uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        let request = Post(uri, content)?
        request.storedMethod = HttpMethod.Put
        return Ok(request)
    }

    /// Constructs an absolute HTTP PATCH request with buffered content.
    static func Patch(url: string, content: HttpContent) -> Result<HttpRequest, HttpError> {
        let request = Post(url, content)?
        request.storedMethod = HttpMethod.Patch
        return Ok(request)
    }

    /// Constructs an absolute HTTP PATCH request with buffered content.
    static func Patch(uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        let request = Post(uri, content)?
        request.storedMethod = HttpMethod.Patch
        return Ok(request)
    }

    /// Constructs an absolute HTTP DELETE request without content.
    static func Delete(url: string) -> Result<HttpRequest, HttpError> {
        let request = Get(url)?
        request.storedMethod = HttpMethod.Delete
        return Ok(request)
    }

    /// Constructs an absolute HTTP DELETE request without content.
    static func Delete(uri: Uri) -> Result<HttpRequest, HttpError> {
        let request = Get(uri)?
        request.storedMethod = HttpMethod.Delete
        return Ok(request)
    }

    /// Constructs an absolute HTTP HEAD request without content.
    static func Head(url: string) -> Result<HttpRequest, HttpError> {
        let request = Get(url)?
        request.storedMethod = HttpMethod.Head
        return Ok(request)
    }

    /// Constructs an absolute HTTP HEAD request without content.
    static func Head(uri: Uri) -> Result<HttpRequest, HttpError> {
        let request = Get(uri)?
        request.storedMethod = HttpMethod.Head
        return Ok(request)
    }

    /// Returns a new request with one application header replaced case-insensitively.
    /// The original request is unchanged; content is shared and framing stays provider-owned.
    func WithHeader(name: string, value: string) -> Result<HttpRequest, HttpError> {
        if storedContent.IsDisposed { return Failure(HttpError.InvalidRequest("Request is disposed")) }
        let key = HeaderName(name)?
        if ReservedHeader(key) || key == "content-type" {
            return Failure(HttpError.InvalidRequest("Header is controlled by transport or content"))
        }
        if !HeaderValueValid(value) {
            return Failure(HttpError.InvalidRequest("Invalid request header value"))
        }
        let headers = ArrayList<HttpHeader>()
        for header in storedHeaders {
            if HeaderName(header.Name)? != key {
                headers.Add(header)
            }
        }
        headers.Add(HttpHeader(name, value))
        if headers.Count > HttpWireLimits.HeaderCount - 3 {
            return Failure(HttpError.LimitExceeded("Request application header count exceeded"))
        }
        let request = HttpRequest(storedHost, storedPort, storedTarget)
        request.secure = secure
        request.storedMethod = storedMethod
        request.storedContent = storedContent
        request.storedHeaders = headers
        return Ok(request)
    }

    internal func WithDefaults(defaults: Sequence<HttpHeader>) -> Result<HttpRequest, HttpError> {
        if storedContent.IsDisposed { return Failure(HttpError.InvalidRequest("Request is disposed")) }
        if defaults.Count == 0 {
            return Ok(self)
        }
        if defaults.Count > HttpWireLimits.HeaderCount - 3 {
            return Failure(HttpError.LimitExceeded("Default request header count exceeded"))
        }
        let headers = ArrayList<HttpHeader>()
        for header in defaults {
            let key = HeaderName(header.Name)?
            if ReservedHeader(key) || key == "content-type" {
                return Failure(HttpError.InvalidRequest("Default header is controlled by transport or content"))
            }
            if !HeaderValueValid(header.Value) {
                return Failure(HttpError.InvalidRequest("Invalid default request header value"))
            }
            if HttpHeader.FindValues(storedHeaders, header.Name).Count == 0 {
                headers.Add(header)
            }
        }
        if headers.Count == 0 {
            return Ok(self)
        }
        for header in storedHeaders {
            headers.Add(header)
        }
        if headers.Count > HttpWireLimits.HeaderCount - 3 {
            return Failure(HttpError.LimitExceeded("Request application header count exceeded"))
        }
        let request = HttpRequest(storedHost, storedPort, storedTarget)
        request.secure = secure
        request.storedMethod = storedMethod
        request.storedContent = storedContent
        request.storedHeaders = headers
        request.HeadersOnly = HeadersOnly
        return Ok(request)
    }

    private static func HeaderName(name: string) -> Result<string, HttpError> {
        let bytes = HttpText.Encode(name)
        if bytes.Count == 0 || bytes.Count > HttpWireLimits.HeaderBytes {
            return Failure(HttpError.InvalidRequest("Invalid request header name"))
        }
        let lower = ArrayList<byte>()
        for value in bytes {
            if !((value >= 48 && value <= 57) || (value >= 65 && value <= 90) ||
                (value >= 97 && value <= 122) || value == 33 || value == 35 || value == 36 ||
                value == 37 || value == 38 || value == 39 || value == 42 || value == 43 ||
                value == 45 || value == 46 || value == 94 || value == 95 || value == 96 ||
                value == 124 || value == 126) {
                return Failure(HttpError.InvalidRequest("Invalid request header name"))
            }
            lower.Add(if value >= 65 && value <= 90 { (byte)((int)value + 32) } else { value })
        }
        if let Ok(text) = HttpText.Decode(lower) {
            return Ok(text)
        }
        return Failure(HttpError.InvalidRequest("Invalid request header name"))
    }

    private static func HeaderValueValid(value: string) -> bool {
        let bytes = HttpText.Encode(value)
        if bytes.Count > HttpWireLimits.HeaderBytes {
            return false
        }
        for item in bytes {
            if !(item >= 32 && item <= 126) {
                return false
            }
        }
        return true
    }

    private static func ReservedHeader(name: string) -> bool {
        return name == "host" || name == "content-length" || name == "transfer-encoding" ||
            name == "connection" || name == "keep-alive" || name == "proxy-connection" ||
            name == "te" || name == "trailer" || name == "upgrade" || name == "expect" ||
            name == "content-encoding"
    }

    internal func Encode() -> Result<Sequence<byte>, HttpError> {
        if (String.CompareOrdinalIgnoreCase(storedMethod.Method, "CONNECT") == 0) {
            return Failure(HttpError.Unsupported("CONNECT tunnelling is not supported"))
        }
        let count = storedContent.Length
        if count < 0 {
            return Failure(HttpError.Unsupported("Unknown-length uploads are not implemented"))
        }
        if storedContent.IsBuffered && count > HttpWireLimits.BodyBytes {
            return Failure(HttpError.LimitExceeded("Request body limit exceeded"))
        }
        let method = storedMethod.Method
        let noBody = String.CompareOrdinalIgnoreCase(method, "GET") == 0 ||
            String.CompareOrdinalIgnoreCase(method, "DELETE") == 0 ||
            String.CompareOrdinalIgnoreCase(method, "HEAD") == 0
        if noBody && count != 0 {
            return Failure(HttpError.InvalidRequest("This request method cannot contain content"))
        }
        let port = storedPort
        var wire = String.Concat(String.Concat(storedMethod.Method, " "), storedTarget)
        wire = String.Concat(wire, String.Concat(" HTTP/1.1\r\nHost: ", storedHost))
        wire = String.Concat(wire, String.Concat(":", port.ToString()))
        wire = String.Concat(wire, "\r\nConnection: close\r\n")
        if !noBody {
            wire = String.Concat(wire, String.Concat("Content-Length: ", count.ToString()))
            wire = String.Concat(wire, "\r\n")
        }
        if storedHeaders.Count > HttpWireLimits.HeaderCount - 3 {
            return Failure(HttpError.LimitExceeded("Request application header count exceeded"))
        }
        var hasContentType = false
        for header in storedHeaders {
            let key = HeaderName(header.Name)?
            if key == "content-type" {
                if hasContentType {
                    return Failure(HttpError.InvalidRequest("Duplicate request Content-Type"))
                }
                hasContentType = true
            }
            if ReservedHeader(key) {
                return Failure(HttpError.InvalidRequest("Header is controlled by transport"))
            }
            if !HeaderValueValid(header.Value) || (key == "content-type" && header.Value.IsEmpty) {
                return Failure(HttpError.InvalidRequest("Invalid request header value"))
            }
            wire = String.Concat(wire, String.Concat(header.Name, ": "))
            wire = String.Concat(wire, String.Concat(header.Value, "\r\n"))
        }
        let encoded = HttpText.Encode(String.Concat(wire, "\r\n"))
        if encoded.Count > HttpWireLimits.HeaderBytes {
            return Failure(HttpError.LimitExceeded("Request header limit exceeded"))
        }
        let outgoing = ArrayList<byte>()
        var cursor = 0
        while cursor < encoded.Count {
            outgoing.Add(encoded[cursor])
            cursor += 1
        }
        if storedContent is HttpMemoryContent memoryContent {
            let body: ReadOnlySlice<byte> = memoryContent.Memory
            cursor = 0
            while cursor < count {
                outgoing.Add(body[cursor])
                cursor += 1
            }
        } else if let Some(body) = storedContent.TryGetBytes() {
            cursor = 0
            while cursor < count {
                outgoing.Add(body[cursor])
                cursor += 1
            }
        }
        let outgoingBytes: Sequence<byte> = outgoing
        return Ok(outgoingBytes)
    }

    private static func Text(bytes: Sequence<byte>, first: int, last: int) -> Result<string, HttpError> {
        let part = ArrayList<byte>()
        var index = first
        while index < last {
            part.Add(bytes[index])
            index += 1
        }
        if let Ok(text) = HttpText.Decode(part) {
            return Ok(text)
        }
        return Failure(HttpError.InvalidRequest("Invalid URL text"))
    }

    /// Parses an absolute HTTP URL and constructs a GET request without performing I/O.
    static func Get(url: string) -> Result<HttpRequest, HttpError> {
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Get(uri)
        } else if let Failure(reason) = parsed {
            return Failure(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return Failure(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Constructs a GET request from an absolute URI; unsupported HTTP forms remain errors.
    static func Get(uri: Uri) -> Result<HttpRequest, HttpError> {
        if !uri.IsAbsolute {
            return Failure(HttpError.InvalidRequest("An absolute request URI is required"))
        }
        let url = uri.Text
        let secure = url.StartsWithOrdinal("https://")
        if !secure && !url.StartsWithOrdinal("http://") {
            return Failure(HttpError.Unsupported("Only http:// and https:// URLs are supported"))
        }
        let authorityStart = if secure { 8 } else { 7 }
        let bytes = HttpText.Encode(url)
        if bytes.Count > 1024 {
            return Failure(HttpError.LimitExceeded("URL limit exceeded"))
        }
        var end = authorityStart
        while end < bytes.Count && bytes[end] != 47 && bytes[end] != 63 && bytes[end] != 35 {
            end += 1
        }
        var colon = authorityStart
        while colon < end && bytes[colon] != 58 {
            let value = bytes[colon]
            if !((value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
                (value >= 48 && value <= 57) || value == 45 || value == 46) {
                return Failure(HttpError.Unsupported("Unsupported hostname"))
            }
            colon += 1
        }
        if colon == authorityStart || colon - authorityStart > 253 {
            return Failure(HttpError.InvalidRequest("Invalid hostname length"))
        }
        let host = Text(bytes, authorityStart, colon)?
        var port = if secure { 443 } else { 80 }
        if colon < end {
            port = 0
            var index = colon + 1
            if index == end {
                return Failure(HttpError.InvalidRequest("Empty port"))
            }
            while index < end {
                let digit = (int)bytes[index] - 48
                if !(digit >= 0 && digit <= 9) || port > (65535 - digit) / 10 {
                    return Failure(HttpError.InvalidRequest("Invalid port"))
                }
                port = port * 10 + digit
                index += 1
            }
            if port == 0 {
                return Failure(HttpError.InvalidRequest("Invalid port"))
            }
        }
        var target = "/"
        if end < bytes.Count {
            var index = end
            while index < bytes.Count {
                let value = bytes[index]
                if !(value >= 33 && value <= 126) || value == 35 {
                    return Failure(HttpError.Unsupported("Unsupported request target"))
                }
                index += 1
            }
            target = Text(bytes, end, bytes.Count)?
            if bytes[end] == 63 {
                target = String.Concat("/", target)
            }
        }
        let request = HttpRequest(host, port, target)
        request.secure = secure
        return Ok(request)
    }
}

public class HttpClient : Disposable {
    private var started = false
    private var timeout: Option<Duration> = Some(Duration.FromTicks(1000000000L))

    /// The total cooperative request budget, including custom handlers and response buffering.
    /// Defaults to Some(100 seconds); None disables the client countdown.
    /// Positive durations through Int32.MaxValue milliseconds are accepted; fractions round upward.
    /// Invalid values, changes after sending starts, and changes after disposal fault.
    /// Expiry requests cancellation and waits for handler cleanup before HttpError.TimedOut.
    /// Caller/disposal cancellation takes precedence. Normal handler results are preserved.
    /// Requires scheduler progress and cooperating handlers; transport phase limits still apply.
    var Timeout: Option<Duration> {
        get {
            if let Some(duration) = timeout {
                return Some(duration)
            }
            return None()
        }
        set {
            if let Some(duration) = value {
                if duration.Ticks <= 0L {
                    System.Fail("HTTP timeout is out of range")
                }
                if duration.Ticks > 21474836470000L {
                    System.Fail("HTTP timeout is out of range")
                }
            } else if let System.Option.None = value {
                // Explicitly disabled, without a negative-duration sentinel.
            } else {
                System.Fail("Timeout requires Some or None")
            }
            EnsureUsable()
            if started {
                System.Fail("HTTP timeout cannot change after sending starts")
            }
            timeout = value
        }
    }

    private val lifetime = CancellationTokenSource()
    private var disposed = false
    private var ownsHandler = true
    private var defaultHeaders: Sequence<HttpHeader> = ArrayList<HttpHeader>()

    /// Client-wide application headers, copied on get/set and validated at Send.
    var DefaultRequestHeaders: Sequence<HttpHeader> {
        get {
            let snapshot = ArrayList<HttpHeader>()
            for header in defaultHeaders {
                snapshot.Add(header)
            }
            return snapshot
        }
        set {
            let snapshot = ArrayList<HttpHeader>()
            for header in value {
                snapshot.Add(header)
            }
            defaultHeaders = snapshot
        }
    }

    private var handler: HttpHandler
    private var baseUri: Option<string> = None()

    /// Optional absolute base URL, validated when a verb helper constructs a request.
    var BaseUri: Option<string> {
        get {
            if let Some(text) = baseUri {
                return Some(text)
            }
            return None()
        }
        set {
            if let Some(text) = value {
                baseUri = Some(text)
            } else if let System.Option.None = value {
                baseUri = None()
            } else {
                System.Fail("BaseUri requires Some or None")
            }
        }
    }

    init() {
        handler = HttpSocketHandler()
    }

    /// Creates a client which owns the supplied handler.
    init(handler: HttpHandler) {
        self.handler = handler
    }

    /// Creates a client with explicit handler ownership.
    init(handler: HttpHandler, disposeHandler: bool) {
        self.handler = handler
        ownsHandler = disposeHandler
    }

    /// Cancels pending requests and disposes the handler when this client owns it.
    /// Repeated disposal is harmless; completed responses remain caller-owned.
    func Dispose() {
        if disposed {
            return
        }
        disposed = true
        lifetime.Cancel()
        lifetime.Dispose()
        if ownsHandler {
            handler.Dispose()
        }
    }

    private func EnsureUsable() {
        if disposed {
            System.Fail("HTTP client is disposed")
        }
    }

    func Send(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
        return Send(request, CancellationToken.None)
    }

    /// Sends a prepared request, forwarding the token through the handler pipeline.
    func Send(request: HttpRequest, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        return Send(request, HttpCompletionOption.ResponseContentRead, cancellationToken)
    }

    /// Selects buffered completion or ownership transfer at final response headers.
    func Send(request: HttpRequest, completionOption: HttpCompletionOption) -> Task<Result<HttpResponse, HttpError>> {
        return Send(request, completionOption, CancellationToken.None)
    }

    /// Headers-only completion ends the client timeout; body reads require their own token.
    func Send(request: HttpRequest, completionOption: HttpCompletionOption, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if completionOption != HttpCompletionOption.ResponseContentRead && completionOption != HttpCompletionOption.ResponseHeadersRead {
            return FailedResponse(HttpError.InvalidRequest("Unknown HTTP completion option"))
        }
        started = true
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let prepared = request.WithDefaults(defaultHeaders)
        if let Failure(error) = prepared {
            return FailedResponse(error)
        }
        let Ok(outgoing) = prepared else {
            System.Fail("Request preparation returned no outcome")
        }
        outgoing.HeadersOnly = completionOption == HttpCompletionOption.ResponseHeadersRead
        let operation = HttpSendScope(outgoing, cancellationToken, lifetime.Token)
        if let Some(delay) = timeout {
            operation.StartTimeout(delay)
        }
        return operation.Attach(handler.Send(outgoing, operation.Token))
    }

    /// Sends an absolute URL without a base, or a relative URL when BaseUri is set.
    func Get(url: string) -> Task<Result<HttpResponse, HttpError>> {
        return Get(url, CancellationToken.None)
    }

    /// Uses the same address rules, with cooperative cancellation.
    func Get(url: string, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Get(uri, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Uses the same base-resolution rules as the string overload.
    func Get(uri: Uri) -> Task<Result<HttpResponse, HttpError>> {
        return Get(uri, CancellationToken.None)
    }

    /// Uses the same address rules, with cooperative cancellation.
    func Get(uri: Uri, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreateRequest(uri)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        System.Fail("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    /// Posts buffered content using the same BaseUri and handler rules as Get.
    func Post(url: string, content: HttpContent) -> Task<Result<HttpResponse, HttpError>> {
        return Post(url, content, CancellationToken.None)
    }

    /// Posts content with cooperative exchange cancellation.
    func Post(url: string, content: HttpContent, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Post(uri, content, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Posts content to a URI using the same base-resolution rules as Get.
    func Post(uri: Uri, content: HttpContent) -> Task<Result<HttpResponse, HttpError>> {
        return Post(uri, content, CancellationToken.None)
    }

    /// Posts content through Send, forwarding the cancellation token unchanged.
    func Post(uri: Uri, content: HttpContent, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreatePost(uri, content)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        System.Fail("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreatePost(uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        return HttpRequest.Post(ResolveAddress(uri)?, content)
    }

    /// Sends PUT buffered content using the same BaseUri and handler rules as Get.
    func Put(url: string, content: HttpContent) -> Task<Result<HttpResponse, HttpError>> {
        return Put(url, content, CancellationToken.None)
    }

    /// Sends PUT content with cooperative exchange cancellation.
    func Put(url: string, content: HttpContent, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Put(uri, content, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Sends PUT content to a URI using the same base-resolution rules as Get.
    func Put(uri: Uri, content: HttpContent) -> Task<Result<HttpResponse, HttpError>> {
        return Put(uri, content, CancellationToken.None)
    }

    /// Sends PUT content through Send, forwarding the cancellation token unchanged.
    func Put(uri: Uri, content: HttpContent, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreatePut(uri, content)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        System.Fail("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreatePut(uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        return HttpRequest.Put(ResolveAddress(uri)?, content)
    }

    /// Sends PATCH buffered content using the same BaseUri and handler rules as Get.
    func Patch(url: string, content: HttpContent) -> Task<Result<HttpResponse, HttpError>> {
        return Patch(url, content, CancellationToken.None)
    }

    /// Sends PATCH content with cooperative exchange cancellation.
    func Patch(url: string, content: HttpContent, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Patch(uri, content, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Sends PATCH content to a URI using the same base-resolution rules as Get.
    func Patch(uri: Uri, content: HttpContent) -> Task<Result<HttpResponse, HttpError>> {
        return Patch(uri, content, CancellationToken.None)
    }

    /// Sends PATCH content through Send, forwarding the cancellation token unchanged.
    func Patch(uri: Uri, content: HttpContent, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreatePatch(uri, content)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        System.Fail("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreatePatch(uri: Uri, content: HttpContent) -> Result<HttpRequest, HttpError> {
        return HttpRequest.Patch(ResolveAddress(uri)?, content)
    }

    /// Sends DELETE without content to an absolute URL without a base, or a relative URL when BaseUri is set.
    func Delete(url: string) -> Task<Result<HttpResponse, HttpError>> {
        return Delete(url, CancellationToken.None)
    }

    /// Uses the same address rules, with cooperative cancellation.
    func Delete(url: string, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Delete(uri, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Uses the same base-resolution rules as the string overload.
    func Delete(uri: Uri) -> Task<Result<HttpResponse, HttpError>> {
        return Delete(uri, CancellationToken.None)
    }

    /// Uses the same address rules, with cooperative cancellation.
    func Delete(uri: Uri, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreateDelete(uri)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        System.Fail("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreateDelete(uri: Uri) -> Result<HttpRequest, HttpError> {
        return HttpRequest.Delete(ResolveAddress(uri)?)
    }

    /// Sends HEAD without content to an absolute URL without a base, or a relative URL when BaseUri is set.
    func Head(url: string) -> Task<Result<HttpResponse, HttpError>> {
        return Head(url, CancellationToken.None)
    }

    /// Uses the same address rules, with cooperative cancellation.
    func Head(url: string, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = Uri.Parse(url)
        if let Ok(uri) = parsed {
            return Head(uri, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(HttpError.InvalidUri(reason))
        }
        System.Fail("URI parser returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid URI"))
    }

    /// Uses the same base-resolution rules as the string overload.
    func Head(uri: Uri) -> Task<Result<HttpResponse, HttpError>> {
        return Head(uri, CancellationToken.None)
    }

    /// Uses the same address rules, with cooperative cancellation.
    func Head(uri: Uri, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            return Cancelled()
        }
        let parsed = CreateHead(uri)
        if let Ok(request) = parsed {
            return Send(request, cancellationToken)
        } else if let Failure(reason) = parsed {
            return FailedResponse(reason)
        }
        System.Fail("Request construction returned no outcome")
        return FailedResponse(HttpError.InvalidRequest("Invalid request"))
    }

    private func CreateHead(uri: Uri) -> Result<HttpRequest, HttpError> {
        return HttpRequest.Head(ResolveAddress(uri)?)
    }

    /// Fetches a bounded response and decodes its buffered body as strict UTF-8.
    func GetString(url: string) -> Task<Result<string, HttpError>> {
        return GetString(url, CancellationToken.None)
    }

    /// Fetches UTF-8 text, preserving HTTP failures and acknowledged task cancellation.
    func GetString(url: string, cancellationToken: CancellationToken) -> Task<Result<string, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            let source = Promise<Result<string, HttpError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Get(url, cancellationToken).Map(DecodeText)
    }

    /// Fetches a bounded response and decodes its buffered body as strict UTF-8.
    func GetString(uri: Uri) -> Task<Result<string, HttpError>> {
        return GetString(uri, CancellationToken.None)
    }

    /// Fetches UTF-8 text, preserving HTTP failures and acknowledged task cancellation.
    func GetString(uri: Uri, cancellationToken: CancellationToken) -> Task<Result<string, HttpError>> {
        EnsureUsable()
        if cancellationToken.IsCancellationRequested {
            started = true
            let source = Promise<Result<string, HttpError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Get(uri, cancellationToken).Map(DecodeText)
    }

    private static func DecodeText(result: Result<HttpResponse, HttpError>) -> Result<string, HttpError> {
        let response = result?
        if !response.IsSuccessStatusCode {
            return Failure(HttpError.UnsuccessfulStatus(response.StatusCode))
        }
        if !response.Content.IsBuffered {
            return Failure(HttpError.Unsupported("Response content is not buffered"))
        }
        if response.Content is HttpMemoryContent memoryContent {
            return match HttpText.Decode(memoryContent.Memory) {
                Ok(let text) => Ok(text)
                Failure(_) => Failure(HttpError.Protocol("Invalid UTF-8 body"))
            }
        }
        if let Ok(text) = HttpText.Decode(response.Content.Bytes) {
            return Ok(text)
        }
        return Failure(HttpError.Protocol("Invalid UTF-8 body"))
    }

    private static func Cancelled() -> Task<Result<HttpResponse, HttpError>> {
        let source = Promise<Result<HttpResponse, HttpError>>()
        _ = source.Cancel()
        return source.Task
    }

    private func CreateRequest(uri: Uri) -> Result<HttpRequest, HttpError> {
        return HttpRequest.Get(ResolveAddress(uri)?)
    }

    private func ResolveAddress(uri: Uri) -> Result<Uri, HttpError> {
        // Snapshot the configuration before calling user-supplied handlers.
        let configured = baseUri
        if let Some(baseText) = configured {
            if uri.IsAbsolute || uri.Text.StartsWithOrdinal("//") {
                return Failure(HttpError.InvalidRequest("A relative URL without authority is required with BaseUri"))
            }
            let parsed = Uri.Parse(baseText)
            if let Failure(reason) = parsed {
                return Failure(HttpError.InvalidUri(reason))
            } else if let Ok(baseAddress) = parsed {
                // Validate HTTP policy on the base before allowing resolution.
                _ = HttpRequest.Get(baseAddress)?
                let resolved = baseAddress.Resolve(uri)
                if let Ok(address) = resolved {
                    return Ok(address)
                } else if let Failure(reason) = resolved {
                    return Failure(HttpError.InvalidUri(reason))
                }
            }
            System.Fail("URI resolution returned no outcome")
            return Failure(HttpError.InvalidRequest("Invalid URI"))
        }
        return Ok(uri)
    }

    private static func FailedResponse(reason: HttpError) -> Task<Result<HttpResponse, HttpError>> {
        let source = Promise<Result<HttpResponse, HttpError>>()
        _ = source.Complete(Failure(reason))
        return source.Task
    }

}

public class HttpSocketHandler : HttpHandler {
    private val sslOptions: SslClientAuthenticationOptions? = null
    private val lifetime = CancellationTokenSource()
    private var disposed = false

    init() { }

    /// Uses explicit TLS trust for HTTPS. The caller owns these immutable options.
    init(sslOptions: SslClientAuthenticationOptions) { self.sslOptions = sslOptions }

    /// Requests cancellation of this handler's pending exchanges, once.
    override func Dispose() {
        if disposed {
            return
        }
        disposed = true
        lifetime.Cancel()
        lifetime.Dispose()
    }

    func Send(request: HttpRequest) -> Task<Result<HttpResponse, HttpError>> {
        return Send(request, CancellationToken.None)
    }

    /// Uses one token across lookup, connect and transfers, closing before cancellation completes.
    override func Send(request: HttpRequest, cancellationToken: CancellationToken) -> Task<Result<HttpResponse, HttpError>> {
        if disposed {
            System.Fail("HTTP handler is disposed")
        }
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<HttpResponse, HttpError>>()
            _ = source.Cancel()
            return source.Task
        }
        let operation = HttpSendScope(request, cancellationToken, lifetime.Token)
        let exchange = HttpExchange(request, operation.Token, sslOptions)
        return operation.Attach(exchange.Execute())
    }
}

// Private continuation adapter, replaceable when runtime suspension is available.
// Each Send owns independent buffers, pending tasks and one socket.
internal class HttpExchange {
    private var uploadRemaining: int = 0
    private var ownsUpload: bool = false
    private var token: CancellationToken
    private var request: HttpRequest
    private var source: Promise<Result<HttpResponse, HttpError>>
    private var socket: Option<HttpConnection>
    private var lookup: Option<Task<Result<Sequence<IPAddress>, DnsError>>>
    private var connecting: Option<Task<Result<Socket, SocketError>>>
    private var transfer: Option<Task<Result<int, HttpError>>>
    private var outgoing: Sequence<byte>
    private var sent: int
    private var buffer: byte[]
    private var decoder: HttpResponseDecoder

    private val sslOptions: SslClientAuthenticationOptions?
    private var authentication: Task<Result<unit, HttpError>>? = null
    internal init(request: HttpRequest, token: CancellationToken, sslOptions: SslClientAuthenticationOptions?) {
        self.sslOptions = sslOptions
        self.token = token
        self.request = request
        source = Promise<Result<HttpResponse, HttpError>>()
        socket = None()
        lookup = None()
        connecting = None()
        transfer = None()
        outgoing = ArrayList<byte>()
        sent = 0
        buffer = CheckedStorage.Reserve<byte>(256)
        decoder = HttpResponseDecoder(String.CompareOrdinalIgnoreCase(request.Method.Method, "HEAD") == 0)
    }

    internal func Execute() -> Task<Result<HttpResponse, HttpError>> {
        if request.IsSecure && sslOptions is null {
            _ = source.Complete(Failure(HttpError.InvalidRequest("HTTPS requires explicit TLS trust options")))
            return source.Task
        }
        // Validate and snapshot before starting the network exchange budget.
        let encoded = request.Encode()
        if let Ok(bytes) = encoded {
            outgoing = bytes
        } else if let Failure(reason) = encoded {
            _ = source.Complete(Failure(reason))
            return source.Task
        }
        if let Failure(reason) = request.Content.BeginUpload() {
            _ = source.Complete(Failure(reason))
            return source.Task
        }
        if !request.Content.IsBuffered {
            ownsUpload = true
            uploadRemaining = request.Content.Length
        }
        let pending = Dns.GetHostAddresses(request.Host, token)
        lookup = Some(pending)
        pending.OnCompleted(self.OnLookup)
        return source.Task
    }

    private func Cleanup() {
        if ownsUpload {
            ownsUpload = false
            request.Content.Dispose()
        }
        if let Some(connection) = socket {
            connection.Close()
        }
        socket = None()
        lookup = None()
        connecting = None()
        transfer = None()
    }

    private func Cancel() {
        Cleanup()
        _ = source.Cancel()
    }

    private func Finish(result: Result<HttpResponse, HttpError>) {
        Cleanup()
        _ = source.Complete(result)
    }

    private func OnLookup() {
        if let Some(pending) = lookup {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            lookup = None()
            if let Ok(addresses) = result {
                let next = Socket.Connect(addresses, request.Port, token)
                connecting = Some(next)
                next.OnCompleted(self.OnConnected)
            } else if let Failure(reason) = result {
                Finish(Failure(HttpError.NameResolution(reason)))
            }
        }
    }

    private func OnConnected() {
        if let Some(pending) = connecting {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            connecting = None()
            if let Ok(connection) = result {
                let transport = HttpConnection(connection)
                socket = Some(transport)
                if request.IsSecure && sslOptions is SslClientAuthenticationOptions options {
                    let pending = transport.AuthenticateClient(options, request.Host, token)
                    authentication = pending
                    pending.OnCompleted(self.OnAuthenticated)
                } else { SendNext() }
            } else if let Failure(reason) = result {
                Finish(Failure(HttpError.Transport(reason)))
            }
        }
    }

    // Outcome adapter preserves outer HTTP cancellation and cleanup ownership.
    private func OnAuthenticated() {
        if authentication is Task<Result<unit, HttpError>> pending {
            authentication = null
            if pending.IsCancelled { Cancel(); return }
            if let Failure(error) = pending.GetResult() { Finish(Failure(error)); return }
            SendNext()
        }
    }

    private var uploadRead: Option<Task<Result<int, HttpError>>> = None()

    // Outcome observation is part of the existing socket callback adapter: cancellation
    // must settle the outer operation without accessing a cancelled task's result.
    private func OnUploadRead() {
        if let Some(pending) = uploadRead {
            uploadRead = None()
            if pending.IsCancelled || token.IsCancellationRequested {
                Cancel()
                return
            }
            let reading = pending.GetResult()
            if let Failure(reason) = reading {
                Finish(Failure(reason))
                return
            }
            if let Ok(read) = reading {
                let chunk = ArrayList<byte>()
                var index = 0
                while index < read {
                    chunk.Add(buffer[index])
                    index += 1
                }
                outgoing = chunk
                sent = 0
                uploadRemaining -= read
                SendNext()
            }
        }
    }

    private func SendNext() {
        if token.IsCancellationRequested {
            Cancel()
            return
        }
        if let Some(connection) = socket {
            if sent == outgoing.Count {
                if uploadRemaining == 0 {
                    ReceiveNext()
                    return
                }
                let requested = if uploadRemaining < 256 { uploadRemaining } else { 256 }
                let reading = request.Content.ReadUpload(buffer, requested, token)
                uploadRead = Some(reading)
                reading.OnCompleted(self.OnUploadRead)
                return
            }
            var count = 0
            while count < 256 && sent + count < outgoing.Count {
                buffer[count] = outgoing[sent + count]
                count += 1
            }
            let pending = connection.Send(buffer, 0, count, token)
            transfer = Some(pending)
            pending.OnCompleted(self.OnSent)
        }
    }

    private func OnSent() {
        if let Some(pending) = transfer {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            transfer = None()
            if let Ok(count) = result {
                if count > 0 {
                    sent += count
                    SendNext()
                } else {
                    Finish(Failure(HttpError.Protocol("Send made no progress")))
                }
            } else if let Failure(reason) = result {
                Finish(Failure(reason))
            }
        }
    }

    private func ReceiveNext() {
        if let Some(connection) = socket {
            let pending = connection.Receive(buffer, 0, 256, token)
            transfer = Some(pending)
            pending.OnCompleted(self.OnReceived)
        }
    }

    private func OnReceived() {
        if let Some(pending) = transfer {
            if pending.IsCancelled {
                Cancel()
                return
            }
            let result = pending.GetResult()
            transfer = None()
            if let Ok(count) = result {
                if count == 0 {
                    Finish(decoder.EndOfInput())
                    return
                }
                var index = 0
                while index < count && !decoder.Complete && !(request.HeadersOnly && decoder.HeadersComplete) {
                    let progress = decoder.Push(buffer[index])
                    if let Failure(message) = progress {
                        Finish(Failure(message))
                        return
                    }
                    index += 1
                }
                if request.HeadersOnly && decoder.HeadersComplete {
                    if let Some(connection) = socket {
                        let length = decoder.BodyLength
                        let stream = HttpBodyInput(connection, buffer, index, count, length,
                            HttpWireLimits.BodyBytes, None(), true, decoder.EmptyOnly)
                        let response = decoder.FinishHeaders()
                        response.SetContent(HttpContent.Incoming(stream, if length < 0 { -1 } else { length }))
                        socket = None()
                        Finish(Ok(response))
                    }
                } else if decoder.Complete {
                    Finish(decoder.Finish())
                } else {
                    ReceiveNext()
                }
            } else if let Failure(reason) = result {
                Finish(Failure(reason))
            }
        }
    }
}


// Cancellation-outcome adapter: await cannot currently observe a cancelled task.
// Cancellation requests are cooperative; completion waits for provider cleanup.
internal class HttpSendScope {
    private val caller: CancellationToken
    private val owner: CancellationToken
    private var timeoutSource: CancellationTokenSource? = null
    private var timeoutRegistration: CancellationRegistration? = null
    private var timedOut = false
    private val request: HttpRequest
    private val cancellation = CancellationTokenSource()
    private val source = Promise<Result<HttpResponse, HttpError>>()
    private var callerRegistration: CancellationRegistration? = null
    private var ownerRegistration: CancellationRegistration? = null
    private var pending: Option<Task<Result<HttpResponse, HttpError>>> = None()
    private var closed = false

    internal init(request: HttpRequest, caller: CancellationToken, owner: CancellationToken) {
        self.caller = caller
        self.owner = owner
        self.request = request
        callerRegistration = caller.Register(self.Cancel)
        ownerRegistration = owner.Register(self.Cancel)
    }

    internal val Token: CancellationToken => cancellation.Token

    internal func StartTimeout(delay: Duration) {
        let timer = CancellationTokenSource()
        timeoutSource = timer
        timeoutRegistration = timer.Token.Register(self.TimeoutElapsed)
        timer.CancelAfter(delay)
    }

    private func TimeoutElapsed() {
        if closed {
            return
        }
        if let Some(task) = pending {
            if task.IsCompleted {
                return
            }
        }
        timedOut = true
        cancellation.Cancel()
    }

    private func Cancel() {
        if !closed {
            cancellation.Cancel()
        }
    }

    internal func Attach(task: Task<Result<HttpResponse, HttpError>>) -> Task<Result<HttpResponse, HttpError>> {
        pending = Some(task)
        if task.IsCompleted {
            Complete()
        } else {
            task.OnCompleted(self.Complete)
        }
        return source.Task
    }

    private func Complete() {
        if closed {
            return
        }
        let Some(task) = pending else {
            System.Fail("HTTP operation has no pending task")
        }
        closed = true
        pending = None()
        if callerRegistration is CancellationRegistration caller {
            caller.Dispose()
        }
        if ownerRegistration is CancellationRegistration owner {
            owner.Dispose()
        }
        callerRegistration = null
        ownerRegistration = null
        if timeoutRegistration is CancellationRegistration registration {
            registration.Dispose()
        }
        if timeoutSource is CancellationTokenSource timer {
            timer.Dispose()
        }
        timeoutRegistration = null
        timeoutSource = null
        cancellation.Dispose()
        if task.IsCancelled {
            // Like HttpClient's .NET cancellation classification, an explicit caller
            // or client-lifetime request takes precedence over timeout at acknowledgement.
            // Copy readonly struct fields before invoking their getters: the current
            // native compiler does not emit defensive copies for field receivers.
            let callerToken = self.caller
            let ownerToken = self.owner
            if timedOut && !callerToken.IsCancellationRequested && !ownerToken.IsCancellationRequested {
                _ = source.Complete(Failure(HttpError.TimedOut))
            } else {
                _ = source.Cancel()
            }
        } else {
            let result = task.GetResult()
            if let Ok(response) = result {
                response.Associate(request)
            }
            _ = source.Complete(result)
        }
    }
}
