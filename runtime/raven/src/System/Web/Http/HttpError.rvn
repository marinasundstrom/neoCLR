module System.Web.Http

import System.*
import System.IO.*
import System.Networking.*
import System.Networking.Security.*
import System.Networking.Sockets.*

/// An expected failure while constructing or exchanging an HTTP message.
public union HttpError {
    /// A URI could not be parsed or resolved.
    case InvalidUri(reason: UriError)
    /// Host name resolution failed.
    case NameResolution(reason: DnsError)
    /// A socket operation failed.
    case Transport(reason: SocketError)
    /// Reading an upload source failed or ended before its declared length.
    case Content(reason: StreamError)
    /// A convenience operation required a successful status but received another status.
    case UnsuccessfulStatus(statusCode: HttpStatusCode)
    /// The request is invalid for this HTTP implementation.
    case InvalidRequest(message: string)
    /// The peer supplied an invalid or incomplete HTTP message.
    case Protocol(message: string)
    /// The requested HTTP behavior is not supported.
    case Unsupported(message: string)
    /// A configured message or resource bound was exceeded.
    case LimitExceeded(message: string)
    /// The shared request deadline expired.
    case TimedOut
    /// Certificate configuration or peer authentication failed.
    case Tls(reason: SslError)
    /// Encrypted stream framing, truncation or state failure.
    case SecureTransport(reason: StreamError)
    /// An application handler could not produce a response.
    case Handler(message: string)

    /// Returns diagnostic text; match cases to inspect structured causes.
    override func ToString() -> string {
        return match self {
            InvalidUri(let reason) => reason.ToString()
            NameResolution(let reason) => reason.ToString()
            Transport(let reason) => reason.ToString()
            Content(let reason) => reason.ToString()
            UnsuccessfulStatus(let statusCode) => String.Concat("HTTP status ", ((int)statusCode).ToString())
            InvalidRequest(let message) => message
            Protocol(let message) => message
            Unsupported(let message) => message
            LimitExceeded(let message) => message
            Tls(let reason) => "TLS authentication failed"
            SecureTransport(let reason) => reason.ToString()
            TimedOut => "Request deadline exceeded"
            Handler(let message) => message
            _ => "Empty"
        }
    }
}
