module System.Web.Http

import System.*
import System.Collections.*
import System.Option.*
import System.Result.*
import System.Text.*

/// Captured, decoded values from a successful route match.
public class RouteMatch {
    private var storedNames: Sequence<string>
    private var storedValues: Sequence<string>

    internal init(names: Sequence<string>, values: Sequence<string>) {
        storedNames = names
        storedValues = values
    }

    /// Gets a named parameter; names are case-sensitive.
    func Get(name: string) -> Result<string, string> {
        for index in 0..<storedNames.Count {
            if storedNames[index] == name {
                return Ok(storedValues[index])
            }
        }
        return Error("Missing route parameter: " + name)
    }

    /// Parses a captured parameter using Int32.Parse, preserving failure as an error.
    func GetInt32(name: string) -> Result<int, string> {
        let text = Get(name)?
        if let Ok(value) = Int32.Parse(text) {
            return Ok(value)
        }
        return Error("Invalid Int32 route parameter: " + name)
    }
}

/// A reusable literal/single-segment parameter pattern, independent of dispatch.
public class RoutePattern {
    private var storedParts: Sequence<string>
    private var storedNames: Sequence<string>

    private init(parts: Sequence<string>, names: Sequence<string>) {
        storedParts = parts
        storedNames = names
    }

    private static func Part(text: string, start: int, length: int) -> string {
        if let Ok(value) = text.SliceUtf8(start, length) {
            return value
        }
        System.Fail("Invalid route boundary")
        return ""
    }

    private static func Hex(value: byte) -> int {
        if value >= 48 && value <= 57 {
            return (int)value - 48
        }
        if value >= 65 && value <= 70 {
            return (int)value - 55
        }
        if value >= 97 && value <= 102 {
            return (int)value - 87
        }
        return -1
    }

    private static func Decode(text: string) -> Result<string, string> {
        let bytes = Utf8.Encode(text)
        let decoded = ArrayList<byte>()
        var index = 0
        while index < bytes.Count {
            var value = (int)bytes[index]
            if value == 37 {
                if index + 2 >= bytes.Count {
                    return Error("Incomplete route escape")
                }
                let high = Hex(bytes[index + 1])
                let low = Hex(bytes[index + 2])
                if high < 0 || low < 0 {
                    return Error("Invalid route escape")
                }
                value = high * 16 + low
                index += 2
            }
            // No separator decoding, control characters or double decoding.
            if value == 47 || value == 92 || value < 32 || value == 127 {
                return Error("Invalid route segment")
            }
            decoded.Add((byte)value)
            index += 1
        }
        if let Ok(value) = Utf8.Decode(decoded) {
            return Ok(value)
        }
        return Error("Invalid route UTF-8")
    }

    private static func Segments(path: string) -> Result<Sequence<string>, string> {
        let bytes = Utf8.Encode(path)
        if bytes.Count == 0 || bytes[0] != 47 {
            return Error("Route path must start with /")
        }
        let result = ArrayList<string>()
        if bytes.Count == 1 {
            return Ok(result)
        }
        var start = 1
        var index = 1
        while index <= bytes.Count {
            if index == bytes.Count || bytes[index] == 47 {
                if result.Count == 16 {
                    return Error("Route exceeds 16 segments")
                }
                result.Add(Part(path, start, index - start))
                start = index + 1
            }
            index += 1
        }
        return Ok(result)
    }

    /// Parses an absolute path pattern with unique {name} parameters.
    static func Parse(pattern: string) -> Result<RoutePattern, string> {
        if pattern.GetUtf8ByteCount() > 1024 {
            return Error("Route exceeds 1024 bytes")
        }
        let source = Segments(pattern)?
        let parts = ArrayList<string>()
        let names = ArrayList<string>()
        for segment in source {
            let bytes = Utf8.Encode(segment)
            if bytes.Count > 0 && bytes[0] == 123 {
                if bytes.Count < 3 || bytes[bytes.Count - 1] != 125 {
                    return Error("Invalid route parameter")
                }
                for index in 1..<(bytes.Count - 1) {
                    let value = bytes[index]
                    if !((value >= 65 && value <= 90) || (value >= 97 && value <= 122) || value == 95 ||
                        (index > 1 && value >= 48 && value <= 57)) {
                        return Error("Invalid route parameter name")
                    }
                }
                let name = Part(segment, 1, bytes.Count - 2)
                for existing in names {
                    if existing == name {
                        return Error("Duplicate route parameter: " + name)
                    }
                }
                parts.Add("")
                names.Add(name)
            } else {
                for value in bytes {
                    if value == 123 || value == 125 || value == 63 || value == 35 {
                        return Error("Invalid route literal")
                    }
                }
                let literal = Decode(segment)?
                parts.Add(literal)
                names.Add("")
            }
        }
        return Ok(RoutePattern(parts, names))
    }

    /// Returns an independent snapshot of capture names in path order.
    func GetParameterNames() -> Sequence<string> {
        let result = ArrayList<string>()
        for name in storedNames {
            if name != "" {
                result.Add(name)
            }
        }
        return result
    }

    /// Checks structural overlap, before target byte limits or typed conversion.
    func Overlaps(other: RoutePattern) -> bool {
        if storedParts.Count != other.storedParts.Count {
            return false
        }
        for index in 0..<storedParts.Count {
            let leftParameter = storedNames[index] != ""
            let rightParameter = other.storedNames[index] != ""
            if !leftParameter && !rightParameter && storedParts[index] != other.storedParts[index] {
                return false
            }
            if leftParameter && !rightParameter && other.storedParts[index] == "" {
                return false
            }
            if !leftParameter && rightParameter && storedParts[index] == "" {
                return false
            }
        }
        return true
    }

    /// Matches an origin-form request target, ignoring its query component.
    func Match(target: string) -> Result<Option<RouteMatch>, string> {
        if target.GetUtf8ByteCount() > 1024 {
            return Error("Route target exceeds 1024 bytes")
        }
        let bytes = Utf8.Encode(target)
        var end = bytes.Count
        for index in 0..<bytes.Count {
            if bytes[index] == 35 {
                return Error("Fragments are not request targets")
            }
            if bytes[index] == 63 && end == bytes.Count { end = index }
        }
        let source = Segments(Part(target, 0, end))?
        let decoded = ArrayList<string>()
        // Validate every segment even when a literal or segment count will differ.
        for segment in source {
            let value = Decode(segment)?
            decoded.Add(value)
        }
        if source.Count != storedParts.Count {
            return Ok(None())
        }
        let capturedNames = ArrayList<string>()
        let capturedValues = ArrayList<string>()
        for index in 0..<storedParts.Count {
            if storedNames[index] == "" {
                if decoded[index] != storedParts[index] {
                    return Ok(None())
                }
            } else {
                if decoded[index] == "" {
                    return Ok(None())
                }
                capturedNames.Add(storedNames[index])
                capturedValues.Add(decoded[index])
            }
        }
        return Ok(Some(RouteMatch(capturedNames, capturedValues)))
    }
}
