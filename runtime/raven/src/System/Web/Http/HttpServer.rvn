module System.Web.Http

import System.*
import System.Option.*
import System.Result.*
import System.Collections.*
import System.Concurrency.Tasks.*
import System.Concurrency.*
import System.Text.*
import System.Time.*
import System.Networking.*
import System.Networking.Security.*
import System.Networking.Sockets.*
import System.Runtime.CompilerServices.*

// Parser-owned contiguous header storage. Borrowed prefixes are consumed synchronously;
// only owned text and request fields escape parsing, never a view of a receive buffer.
internal class HttpRequestHeaderBuffer : Sequence<byte> {
    private var bytes: byte[]
    private var count = 0

    internal init(capacity: int) {
        bytes = CheckedStorage.Reserve<byte>(capacity)
    }

    val Count: int => count
    internal val Written: ReadOnlySlice<byte> => bytes[0..count]

    val self[index: int]: byte {
        get {
            if index < 0 || index >= count {
                System.Fail("HTTP header index out of range")
            }
            return bytes[index]
        }
    }

    internal func Add(value: byte) {
        if count == bytes.Length {
            let capacity = if count == 0 { 4 } else { count * 2 }
            let grown = CheckedStorage.Reserve<byte>(capacity)
            var index = 0
            while index < count {
                grown[index] = bytes[index]
                index += 1
            }
            bytes = grown
        }
        bytes[count] = value
        count += 1
    }

    func GetIterator() -> Iterator<byte> => HttpByteWindowIterator(self)
}

internal class HttpRequestDecoder {
    private var headersOnly = false
    private var headersComplete = false
    private var consumed = 0
    internal val HeadersComplete: bool => headersComplete && !failed
    internal val Consumed: int => consumed
    internal val BodyLength: int => if chunked { -3 } else { expected }
    internal func EnableStreaming() { headersOnly = true }
    internal func FinishHeaders() -> Result<HttpRequest, HttpError> {
        if let Some(parsed) = request { return Ok(parsed) }
        return Error(HttpError.Protocol("Incomplete headers"))
    }
    private val head: HttpRequestHeaderBuffer
    private var request: Option<HttpRequest> = None()
    private var complete: bool = false
    private var failed = false
    private var chunked = false
    private var chunks: HttpChunkDecoder? = null
    private var expected: int = -1
    private var body: ArrayList<byte> = ArrayList<byte>()

    private val settings: HttpServerSettings
    private val secure: bool

    internal init(settings: HttpServerSettings, secure: bool) {
        self.settings = settings
        self.secure = secure
        // Reserve a small header prefix once; larger requests retain normal growth.
        let capacity = if settings.HeaderBytes < 128 { settings.HeaderBytes } else { 128 }
        head = HttpRequestHeaderBuffer(capacity)
    }
    internal val Complete: bool => complete && !failed

    internal func Push(buffer: ReadOnlySlice<byte>) -> Result<bool, HttpError> {
        if failed {
            return Error(HttpError.Protocol("Decoder already failed"))
        }
        let result = PushCore(buffer)
        if let Error(_) = result {
            failed = true
        }
        return result
    }

    // One result per received block; input is borrowed only for this call.
    // Header/body storage owns copied bytes before the receive buffer is reused.
    private func PushCore(buffer: ReadOnlySlice<byte>) -> Result<bool, HttpError> {
        if complete {
            return Error(HttpError.Protocol("Request already complete"))
        }
        var index = 0
        while index < buffer.Length && !complete && !(headersOnly && headersComplete) {
            let value = buffer[index]
            index += 1
            if chunks is HttpChunkDecoder decoder {
                complete = decoder.Push(value)?
                continue
            }
            if expected >= 0 {
                body.Add(value)
                complete = body.Count == expected
                continue
            }
            if head.Count >= settings.HeaderBytes {
                return Error(HttpError.LimitExceeded("Request header limit exceeded"))
            }
            let count = head.Count
            if value == 10 && (count == 0 || head[count - 1] != 13) {
                return Error(HttpError.Protocol("Bare LF in request"))
            }
            if count > 0 && head[count - 1] == 13 && value != 10 {
                return Error(HttpError.Protocol("Bare CR in request"))
            }
            if value != 9 && value != 10 && value != 13 && !(value >= 32 && value <= 126) {
                return Error(HttpError.Protocol("Invalid request byte"))
            }
            head.Add(value)
            let size = head.Count
            if size >= 4 && head[size - 4] == 13 && head[size - 3] == 10 && head[size - 2] == 13 && head[size - 1] == 10 {
                let parsed = Parse()?
                request = Some(parsed)
                headersComplete = true
                complete = !chunked && expected == 0
            }
        }
        consumed = index
        return Ok(complete)
    }

    internal func Finish() -> Result<HttpRequest, HttpError> {
        if !Complete {
            return Error(HttpError.Protocol("Incomplete request"))
        }
        if let Some(parsed) = request {
            return Ok(parsed)
        }
        return Error(HttpError.Protocol("Incomplete request"))
    }

    private func Token(value: byte) -> bool {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 33 || value == 35 ||
            value == 36 || value == 37 || value == 38 || value == 39 ||
            value == 42 || value == 43 || value == 45 || value == 46 ||
            value == 94 || value == 95 || value == 96 || value == 124 || value == 126
    }

    private func MethodToken(bytes: ReadOnlySlice<byte>) -> Result<string, HttpError> {
        if bytes.Length == 0 {
            return Error(HttpError.Protocol("Invalid request method"))
        }
        var index = 0
        while index < bytes.Length {
            if !Token(bytes[index]) {
                // Keep malformed UTF-8's existing text error ahead of token errors.
                let ignored = Text(0, bytes.Length, 0)?
                return Error(HttpError.Protocol("Invalid request method"))
            }
            index += 1
        }
        return Text(0, bytes.Length, 0)
    }

    private func Text(start: int, end: int, lower: int) -> Result<string, HttpError> {
        if lower == 0 {
            if let Ok(text) = HttpText.Decode(head.Written[start..end]) {
                return Ok(text)
            }
            return Error(HttpError.Protocol("Invalid header text"))
        }
        let bytes = ArrayList<byte>(end - start)
        var index = start
        while index < end {
            var value = head[index]
            if lower == 1 && value >= 65 && value <= 90 {
                value = (byte)((int)value + 32)
            }
            bytes.Add(value)
            index += 1
        }
        if let Ok(text) = HttpText.Decode(bytes) {
            return Ok(text)
        }
        return Error(HttpError.Protocol("Invalid header text"))
    }

    // Fixed ASCII spellings avoid lowercase buffers and UTF-8 decoding for common names.
    // Token validation runs first. Only letters fold; hyphens compare exactly.
    // Unknown names keep the existing owned, lowercase text representation.
    private func HeaderName(start: int, end: int) -> Result<string, HttpError> {
        let count = end - start
        // host
        if count == 4 &&
            ((int)head[start] | 32) == 104 && ((int)head[start + 1] | 32) == 111 &&
            ((int)head[start + 2] | 32) == 115 && ((int)head[start + 3] | 32) == 116 {
            return Ok(HttpHeaderNames.Host)
        }
        // connection
        if count == 10 &&
            ((int)head[start] | 32) == 99 && ((int)head[start + 1] | 32) == 111 &&
            ((int)head[start + 2] | 32) == 110 && ((int)head[start + 3] | 32) == 110 &&
            ((int)head[start + 4] | 32) == 101 && ((int)head[start + 5] | 32) == 99 &&
            ((int)head[start + 6] | 32) == 116 && ((int)head[start + 7] | 32) == 105 &&
            ((int)head[start + 8] | 32) == 111 && ((int)head[start + 9] | 32) == 110 {
            return Ok(HttpHeaderNames.Connection)
        }
        // content-length
        if count == 14 &&
            ((int)head[start] | 32) == 99 && ((int)head[start + 1] | 32) == 111 &&
            ((int)head[start + 2] | 32) == 110 && ((int)head[start + 3] | 32) == 116 &&
            ((int)head[start + 4] | 32) == 101 && ((int)head[start + 5] | 32) == 110 &&
            ((int)head[start + 6] | 32) == 116 && head[start + 7] == 45 &&
            ((int)head[start + 8] | 32) == 108 && ((int)head[start + 9] | 32) == 101 &&
            ((int)head[start + 10] | 32) == 110 && ((int)head[start + 11] | 32) == 103 &&
            ((int)head[start + 12] | 32) == 116 && ((int)head[start + 13] | 32) == 104 {
            return Ok(HttpHeaderNames.ContentLength)
        }
        // transfer-encoding
        if count == 17 &&
            ((int)head[start] | 32) == 116 && ((int)head[start + 1] | 32) == 114 &&
            ((int)head[start + 2] | 32) == 97 && ((int)head[start + 3] | 32) == 110 &&
            ((int)head[start + 4] | 32) == 115 && ((int)head[start + 5] | 32) == 102 &&
            ((int)head[start + 6] | 32) == 101 && ((int)head[start + 7] | 32) == 114 &&
            head[start + 8] == 45 && ((int)head[start + 9] | 32) == 101 &&
            ((int)head[start + 10] | 32) == 110 && ((int)head[start + 11] | 32) == 99 &&
            ((int)head[start + 12] | 32) == 111 && ((int)head[start + 13] | 32) == 100 &&
            ((int)head[start + 14] | 32) == 105 && ((int)head[start + 15] | 32) == 110 &&
            ((int)head[start + 16] | 32) == 103 {
            return Ok(HttpHeaderNames.TransferEncoding)
        }
        // expect
        if count == 6 &&
            ((int)head[start] | 32) == 101 && ((int)head[start + 1] | 32) == 120 &&
            ((int)head[start + 2] | 32) == 112 && ((int)head[start + 3] | 32) == 101 &&
            ((int)head[start + 4] | 32) == 99 && ((int)head[start + 5] | 32) == 116 {
            return Ok(HttpHeaderNames.Expect)
        }
        // content-encoding
        if count == 16 &&
            ((int)head[start] | 32) == 99 && ((int)head[start + 1] | 32) == 111 &&
            ((int)head[start + 2] | 32) == 110 && ((int)head[start + 3] | 32) == 116 &&
            ((int)head[start + 4] | 32) == 101 && ((int)head[start + 5] | 32) == 110 &&
            ((int)head[start + 6] | 32) == 116 && head[start + 7] == 45 &&
            ((int)head[start + 8] | 32) == 101 && ((int)head[start + 9] | 32) == 110 &&
            ((int)head[start + 10] | 32) == 99 && ((int)head[start + 11] | 32) == 111 &&
            ((int)head[start + 12] | 32) == 100 && ((int)head[start + 13] | 32) == 105 &&
            ((int)head[start + 14] | 32) == 110 && ((int)head[start + 15] | 32) == 103 {
            return Ok(HttpHeaderNames.ContentEncoding)
        }
        // content-type
        if count == 12 &&
            ((int)head[start] | 32) == 99 && ((int)head[start + 1] | 32) == 111 &&
            ((int)head[start + 2] | 32) == 110 && ((int)head[start + 3] | 32) == 116 &&
            ((int)head[start + 4] | 32) == 101 && ((int)head[start + 5] | 32) == 110 &&
            ((int)head[start + 6] | 32) == 116 && head[start + 7] == 45 &&
            ((int)head[start + 8] | 32) == 116 && ((int)head[start + 9] | 32) == 121 &&
            ((int)head[start + 10] | 32) == 112 && ((int)head[start + 11] | 32) == 101 {
            return Ok(HttpHeaderNames.ContentType)
        }
        // accept
        if count == 6 &&
            ((int)head[start] | 32) == 97 && ((int)head[start + 1] | 32) == 99 &&
            ((int)head[start + 2] | 32) == 99 && ((int)head[start + 3] | 32) == 101 &&
            ((int)head[start + 4] | 32) == 112 && ((int)head[start + 5] | 32) == 116 {
            return Ok(HttpHeaderNames.Accept)
        }
        // accept-encoding
        if count == 15 &&
            ((int)head[start] | 32) == 97 && ((int)head[start + 1] | 32) == 99 &&
            ((int)head[start + 2] | 32) == 99 && ((int)head[start + 3] | 32) == 101 &&
            ((int)head[start + 4] | 32) == 112 && ((int)head[start + 5] | 32) == 116 &&
            head[start + 6] == 45 && ((int)head[start + 7] | 32) == 101 &&
            ((int)head[start + 8] | 32) == 110 && ((int)head[start + 9] | 32) == 99 &&
            ((int)head[start + 10] | 32) == 111 && ((int)head[start + 11] | 32) == 100 &&
            ((int)head[start + 12] | 32) == 105 && ((int)head[start + 13] | 32) == 110 &&
            ((int)head[start + 14] | 32) == 103 {
            return Ok(HttpHeaderNames.AcceptEncoding)
        }
        // authorization
        if count == 13 &&
            ((int)head[start] | 32) == 97 && ((int)head[start + 1] | 32) == 117 &&
            ((int)head[start + 2] | 32) == 116 && ((int)head[start + 3] | 32) == 104 &&
            ((int)head[start + 4] | 32) == 111 && ((int)head[start + 5] | 32) == 114 &&
            ((int)head[start + 6] | 32) == 105 && ((int)head[start + 7] | 32) == 122 &&
            ((int)head[start + 8] | 32) == 97 && ((int)head[start + 9] | 32) == 116 &&
            ((int)head[start + 10] | 32) == 105 && ((int)head[start + 11] | 32) == 111 &&
            ((int)head[start + 12] | 32) == 110 {
            return Ok(HttpHeaderNames.Authorization)
        }
        // cookie
        if count == 6 &&
            ((int)head[start] | 32) == 99 && ((int)head[start + 1] | 32) == 111 &&
            ((int)head[start + 2] | 32) == 111 && ((int)head[start + 3] | 32) == 107 &&
            ((int)head[start + 4] | 32) == 105 && ((int)head[start + 5] | 32) == 101 {
            return Ok(HttpHeaderNames.Cookie)
        }
        // user-agent
        if count == 10 &&
            ((int)head[start] | 32) == 117 && ((int)head[start + 1] | 32) == 115 &&
            ((int)head[start + 2] | 32) == 101 && ((int)head[start + 3] | 32) == 114 &&
            head[start + 4] == 45 && ((int)head[start + 5] | 32) == 97 &&
            ((int)head[start + 6] | 32) == 103 && ((int)head[start + 7] | 32) == 101 &&
            ((int)head[start + 8] | 32) == 110 && ((int)head[start + 9] | 32) == 116 {
            return Ok(HttpHeaderNames.UserAgent)
        }
        // cache-control
        if count == 13 &&
            ((int)head[start] | 32) == 99 && ((int)head[start + 1] | 32) == 97 &&
            ((int)head[start + 2] | 32) == 99 && ((int)head[start + 3] | 32) == 104 &&
            ((int)head[start + 4] | 32) == 101 && head[start + 5] == 45 &&
            ((int)head[start + 6] | 32) == 99 && ((int)head[start + 7] | 32) == 111 &&
            ((int)head[start + 8] | 32) == 110 && ((int)head[start + 9] | 32) == 116 &&
            ((int)head[start + 10] | 32) == 114 && ((int)head[start + 11] | 32) == 111 &&
            ((int)head[start + 12] | 32) == 108 {
            return Ok(HttpHeaderNames.CacheControl)
        }
        return Text(start, end, 1)
    }

    private func Parse() -> Result<HttpRequest, HttpError> {
        var start = 0
        var end = 0
        var line = 0
        var target = ""
        var method = ""
        var length = 0
        var host = ""
        var hasLength = false
        let headers = ArrayList<HttpHeader>()
        while end + 1 < head.Count {
            if head[end] != 13 || head[end + 1] != 10 {
                end += 1
                continue
            }
            if line == 0 {
                var methodEnd = 0
                while methodEnd < end && head[methodEnd] != 32 {
                    methodEnd += 1
                }
                if end < methodEnd + 11 || !(head[end - 9] == 32 && head[end - 8] == 72 && head[end - 7] == 84 &&
                    head[end - 6] == 84 && head[end - 5] == 80 && head[end - 4] == 47 &&
                    head[end - 3] == 49 && head[end - 2] == 46 && head[end - 1] == 49) {
                    return Error(HttpError.Unsupported("Unsupported request line"))
                }
                method = MethodToken(head.Written[0..methodEnd])?
                let parsedTarget = Text(methodEnd + 1, end - 9, 0)?
                var targetIndex = methodEnd + 1
                while targetIndex < end - 9 {
                    if head[targetIndex] <= 32 || head[targetIndex] == 127 || head[targetIndex] == 35 {
                        return Error(HttpError.Protocol("Invalid request target"))
                    }
                    targetIndex += 1
                }
                target = parsedTarget
                if !target.StartsWithOrdinal("/") {
                    return Error(HttpError.Protocol("Origin-form target required"))
                }
            } else if end == start {
                if host.IsEmpty {
                    return Error(HttpError.Protocol("Host required"))
                }
                if (method == "GET" || method == "DELETE" || method == "HEAD") && length != 0 {
                    return Error(HttpError.Unsupported(String.Concat(method, " request bodies unsupported")))
                }
                if chunked && hasLength {
                    return Error(HttpError.Protocol("Ambiguous request framing"))
                }
                if chunked {
                    chunks = HttpChunkDecoder(body, method == "GET" || method == "DELETE" || method == "HEAD", settings.BodyBytes)
                }
                expected = length
                return HttpRequest.FromIncoming(HttpMethod.FromValidatedToken(method), target, host, headers, body, secure)
            } else {
                if headers.Count >= settings.HeaderCount {
                    return Error(HttpError.LimitExceeded("Request header count exceeded"))
                }
                var colon = start
                while colon < end && head[colon] != 58 {
                    if !Token(head[colon]) {
                        return Error(HttpError.Protocol("Invalid request header name"))
                    }
                    colon += 1
                }
                if colon == start || colon == end {
                    return Error(HttpError.Protocol("Missing request header name or colon"))
                }
                let name = HeaderName(start, colon)?
                var first = colon + 1
                var last = end
                while first < last && (head[first] == 32 || head[first] == 9) {
                    first += 1
                }
                while last > first && (head[last - 1] == 32 || head[last - 1] == 9) {
                    last -= 1
                }
                let value = Text(first, last, 0)?
                if name == "host" {
                    if !host.IsEmpty {
                        return Error(HttpError.Protocol("Duplicate Host"))
                    }
                    if value.IsEmpty {
                        return Error(HttpError.Protocol("Empty Host"))
                    }
                    host = value
                }
                if name == "expect" || name == "content-encoding" {
                    return Error(HttpError.Unsupported("Request expectation or content encoding unsupported"))
                }
                if name == "transfer-encoding" {
                    if chunked {
                        return Error(HttpError.Protocol("Duplicate request Transfer-Encoding"))
                    }
                    if String.CompareOrdinalIgnoreCase(value, "chunked") != 0 {
                        return Error(HttpError.Unsupported("Request transfer encoding unsupported"))
                    }
                    chunked = true
                }
                if name == "content-length" {
                    if hasLength {
                        return Error(HttpError.Protocol("Duplicate request Content-Length"))
                    }
                    hasLength = true
                    if first == last {
                        return Error(HttpError.Protocol("Invalid request Content-Length"))
                    }
                    var cursor = first
                    while cursor < last {
                        let digit = (int)head[cursor] - 48
                        if !(digit >= 0 && digit <= 9) {
                            return Error(HttpError.Protocol("Invalid request Content-Length"))
                        }
                        if digit > settings.BodyBytes || length > (settings.BodyBytes - digit) / 10 {
                            return Error(HttpError.LimitExceeded("Request body limit exceeded"))
                        }
                        length = length * 10 + digit
                        cursor += 1
                    }
                }
                headers.Add(HttpHeader(name, value))
            }
            line += 1
            start = end + 2
            end = start
        }
        return Error(HttpError.Protocol("Incomplete request"))
    }
}

public class HttpServer {
    internal val SslOptions: SslServerAuthenticationOptions?
    private val settings: HttpServerSettings
    internal val Settings: HttpServerSettings => settings
    private var listener: Socket
    private var shutdown: CancellationTokenSource = CancellationTokenSource()
    private var active: int = 0
    private var serving: HttpServerRun? = null
    private var completedRequests: long = 0L
    private var failedRequests: long = 0L
    private var lastRequestError: Option<HttpError> = None()
    // Private, dispatcher-owned scratch storage. Never exposed through a request.
    // One retained buffer per size class bounds idle payload retention to 4352 bytes.
    private var smallReceiveBuffer: byte[]? = null
    private var largeReceiveBuffer: byte[]? = null

    internal func RentReceiveBuffer(size: int) -> byte[] {
        if size == 256 {
            if smallReceiveBuffer is byte[] available {
                smallReceiveBuffer = null
                return available
            }
        } else if size == 4096 {
            if largeReceiveBuffer is byte[] available {
                largeReceiveBuffer = null
                return available
            }
        }
        return CheckedStorage.Reserve<byte>(size)
    }

    internal func ReturnReceiveBuffer(buffer: byte[]) {
        if closed { return }
        // Only completed receive bytes are read, then copied by the decoder.
        // Uncleared tails remain private; streaming buffers are never returned here.
        if buffer.Length == 256 && smallReceiveBuffer is null {
            smallReceiveBuffer = buffer
        } else if buffer.Length == 4096 && largeReceiveBuffer is null {
            largeReceiveBuffer = buffer
        }
    }


    /// Successful responses completed by Serve; excludes explicit Accept/ServeOne calls.
    val CompletedRequests: long => completedRequests
    /// Failed Serve exchanges, excluding cancellation caused by server shutdown.
    val FailedRequests: long => failedRequests
    /// Most recent Serve request error; None before any failure.
    val LastRequestError: Option<HttpError> {
        get {
            if let Some(error) = lastRequestError {
                return Some(error)
            }
            return None()
        }
    }
    internal val IsClosed: bool => closed
    internal func RecordServed() { completedRequests += 1L }
    internal func RecordFailure(error: HttpError) {
        failedRequests += 1L
        lastRequestError = Some(error)
    }
    internal func ListenerFailed(error: HttpError) {
        if serving is HttpServerRun run {
            run.Fail(error)
        }
    }
    internal func AcceptForServe() -> Task<Result<HttpContext, HttpError>> {
        return AcceptCore(CancellationToken.None, false, true)
    }

    private var accepting: bool = false
    private var acceptHead: HttpServerExchange? = null
    private var acceptTail: HttpServerExchange? = null

    // The socket contract allows one pending accept. Advance this queue when a
    // socket is accepted, independently of that connection's TLS/read/parse work.
    internal func BeginAccept(exchange: HttpServerExchange) {
        if accepting {
            if acceptTail is HttpServerExchange tail {
                tail.SetNextAccept(exchange)
            } else {
                acceptHead = exchange
            }
            acceptTail = exchange
            return
        }
        accepting = true
        exchange.StartAccept()
    }

    internal func EndAccept() {
        accepting = false
        if acceptHead is HttpServerExchange next {
            acceptHead = next.TakeNextAccept()
            if acceptHead is null {
                acceptTail = null
            }
            accepting = true
            next.StartAccept()
        }
    }

    internal func RemoveAccept(exchange: HttpServerExchange) -> bool {
        var previous: HttpServerExchange? = null
        var cursor = acceptHead
        while cursor is HttpServerExchange current {
            if Object.ReferenceEquals(current, exchange) {
                let remaining = current.TakeNextAccept()
                if previous is HttpServerExchange preceding {
                    preceding.SetNextAccept(remaining)
                } else {
                    acceptHead = remaining
                }
                if Object.ReferenceEquals(acceptTail, current) {
                    acceptTail = previous
                }
                return true
            }
            previous = current
            cursor = current.NextAccept
        }
        return false
    }
    private var closed: bool = false

    internal val StopToken: CancellationToken => shutdown.Token

    internal func Release() {
        active -= 1
    }

    internal init(listener: Socket, settings: HttpServerSettings, sslOptions: SslServerAuthenticationOptions?) {
        SslOptions = sslOptions
        self.listener = listener
        self.settings = settings
    }

    static func Listen(address: string, port: int, backlog: int) -> Result<HttpServer, HttpError> {
        return Listen(address, port, backlog, HttpServerOptions())
    }

    /// <summary>Validates and snapshots options before opening the listener.</summary>
    /// <returns>A listening server, an InvalidRequest for unsupported options, or a transport error.</returns>
    static func Listen(address: string, port: int, backlog: int, options: HttpServerOptions) -> Result<HttpServer, HttpError> {
        let settings = HttpServerSettings.Create(options)?
        let result = Socket.Listen(address, port, backlog)
        if let Ok(listener) = result {
            return Ok(HttpServer(listener, settings, options.SslOptions))
        }
        if let Error(reason) = result {
            return Error(HttpError.Transport(reason))
        }
        return Error(HttpError.Protocol("Inactive listen result"))
    }

    func GetLocalPort() -> Result<int, HttpError> {
        let result = listener.GetLocalPort()
        if let Ok(port) = result {
            return Ok(port)
        }
        return Error(HttpError.InvalidRequest("Listener port unavailable"))
    }

    /// Accepts and buffers one request, transferring its exchange lifetime to the caller.
    func Accept() -> Task<Result<HttpContext, HttpError>> {
        return Accept(CancellationToken.None)
    }

    /// Cancellation covers waiting for a connection and reading the complete request.
    func Accept(cancellationToken: CancellationToken) -> Task<Result<HttpContext, HttpError>> {
        return AcceptCore(cancellationToken, false)
    }

    /// Returns after valid headers; the caller reads Request.Content's stream on demand.
    func AcceptHeaders() -> Task<Result<HttpContext, HttpError>> {
        return AcceptHeaders(CancellationToken.None)
    }

    /// Cancellation covers acceptance and headers. Pass a token to later body reads.
    func AcceptHeaders(cancellationToken: CancellationToken) -> Task<Result<HttpContext, HttpError>> {
        return AcceptCore(cancellationToken, true)
    }

    private func AcceptCore(cancellationToken: CancellationToken, streaming: bool) -> Task<Result<HttpContext, HttpError>> {
        return AcceptCore(cancellationToken, streaming, false)
    }

    private func AcceptCore(cancellationToken: CancellationToken, streaming: bool, managed: bool) -> Task<Result<HttpContext, HttpError>> {
        if !managed && serving is HttpServerRun {
            return Task.FromResult<Result<HttpContext, HttpError>>(Result<HttpContext, HttpError>.Error(HttpError.InvalidRequest("Serve owns request acceptance")))
        }
        if cancellationToken.IsCancellationRequested {
            let rejected = Promise<Result<HttpContext, HttpError>>()
            _ = rejected.Cancel()
            return rejected.Task
        }
        if closed {
            let rejected = Promise<Result<HttpContext, HttpError>>()
            _ = rejected.Complete(Error(HttpError.InvalidRequest("Server is closed")))
            return rejected.Task
        }
        if active >= 16 {
            let rejected = Promise<Result<HttpContext, HttpError>>()
            _ = rejected.Complete(Error(HttpError.LimitExceeded("Server exchange limit exceeded")))
            return rejected.Task
        }
        active += 1
        return HttpServerExchange(self, listener, cancellationToken, streaming).Start()
    }

    /// Starts server-managed concurrent request handling. The returned task represents server lifetime.
    /// Up to 16 exchanges run concurrently; request failures are recorded and do not stop serving.
    func Serve(handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>) -> Task<Result<System.Void, HttpError>> {
        return Serve(handler, CancellationToken.None)
    }

    /// Cancellation closes the server. Completion waits for every started handler task to settle.
    /// Close completes normally; caller cancellation cancels the lifetime task; listener failure returns Error.
    func Serve(handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>, cancellationToken: CancellationToken) -> Task<Result<System.Void, HttpError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<System.Void, HttpError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        if closed || serving is HttpServerRun || active != 0 {
            return Task.FromResult<Result<System.Void, HttpError>>(Result<System.Void, HttpError>.Error(HttpError.InvalidRequest("Serve requires an open idle server")))
        }
        let run = HttpServerRun(self, handler, cancellationToken)
        serving = run
        return run.Start()
    }

    /// Handles one accepted context and sends the callback's buffered or known-length stream response.
    func ServeOne(handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>) -> Task<Result<System.Void, HttpError>> {
        return ServeOne(handler, CancellationToken.None)
    }

    /// Cancellation ends this exchange, including an outstanding handler wait.
    func ServeOne(handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>, cancellationToken: CancellationToken) -> Task<Result<System.Void, HttpError>> {
        return HttpServeOperation(self, handler, cancellationToken).Start()
    }

    /// Stops acceptance and closes all owned exchanges. Idempotent; does not drain handlers.
    func Close() {
        if closed {
            return
        }
        closed = true
        smallReceiveBuffer = null
        largeReceiveBuffer = null
        shutdown.Cancel()
        listener.Close()
    }

    internal static func EncodeResponse(response: HttpResponse, headOnly: int) -> Result<byte[], HttpError> {
        let status = (int)response.StatusCode
        if !(status >= 200 && status <= 599) {
            return Error(HttpError.InvalidRequest("A final response status from 200 through 599 is required"))
        }
        let count = response.Content.Length
        if count < 0 {
            return Error(HttpError.Unsupported("Unknown-length response output is not implemented"))
        }
        if (status == 204 || status == 205 || status == 304) && count != 0 {
            return Error(HttpError.InvalidRequest("This response status cannot contain content"))
        }
        if count > HttpWireLimits.BodyBytes {
            return Error(HttpError.LimitExceeded("Response body limit exceeded"))
        }
        let fields = response.Headers
        if fields.Count > HttpWireLimits.HeaderCount - 2 {
            return Error(HttpError.LimitExceeded("Response header count exceeded"))
        }
        let result = ArrayList<byte>()
        AppendStatusPrefix(result)
        AppendDecimal(result, status)
        result.Add((byte)32)
        if status == 200 {
            result.Add((byte)79)
            result.Add((byte)75)
        }
        if status != 204 && status != 304 {
            AppendLengthPrefix(result)
            AppendDecimal(result, count)
        }
        AppendConnectionClose(result)
        var index = 0
        while index < fields.Count {
            let header = fields[index]
            if header.Name.GetUtf8ByteCount() > HttpWireLimits.HeaderBytes - 2 || header.Value.GetUtf8ByteCount() > HttpWireLimits.HeaderBytes - 2 {
                return Error(HttpError.LimitExceeded("Response header limit exceeded"))
            }
            let name = HttpText.Encode(header.Name)
            if name.Count == 0 {
                return Error(HttpError.Protocol("Empty response header name"))
            }
            var part = 0
            while part < name.Count {
                let value = name[part]
                if !HeaderToken(value) {
                    return Error(HttpError.Protocol("Invalid response header name"))
                }
                part += 1
            }
            if String.CompareOrdinalIgnoreCase(header.Name, "content-length") == 0 ||
               String.CompareOrdinalIgnoreCase(header.Name, "connection") == 0 ||
               String.CompareOrdinalIgnoreCase(header.Name, "transfer-encoding") == 0 ||
               String.CompareOrdinalIgnoreCase(header.Name, "content-encoding") == 0 {
                return Error(HttpError.Protocol("Response framing headers are server-owned"))
            }
            let valueBytes = HttpText.Encode(header.Value)
            part = 0
            while part < valueBytes.Count {
                let value = valueBytes[part]
                if value != 9 && !(value >= 32 && value <= 126) {
                    return Error(HttpError.Protocol("Invalid response header value"))
                }
                part += 1
            }
            AppendWire(result, name)
            result.Add((byte)58)
            result.Add((byte)32)
            AppendWire(result, valueBytes)
            result.Add((byte)13)
            result.Add((byte)10)
            if result.Count > HttpWireLimits.HeaderBytes - 2 {
                return Error(HttpError.LimitExceeded("Response header limit exceeded"))
            }
            index += 1
        }
        result.Add((byte)13)
        result.Add((byte)10)
        // Snapshot once into exact storage. Appending the body to the growable
        // header list repeatedly reallocates and copies the full response.
        let bodyCount = if response.Content.IsBuffered && headOnly == 0 { count } else { 0 }
        let bytes = CheckedStorage.Reserve<byte>(result.Count + bodyCount)
        index = 0
        while index < result.Count {
            bytes[index] = result[index]
            index += 1
        }
        if bodyCount > 0 {
            if response.Content is HttpMemoryContent memoryContent {
                let body: ReadOnlySlice<byte> = memoryContent.Memory
                var offset = 0
                while offset < bodyCount {
                    bytes[index + offset] = body[offset]
                    offset += 1
                }
            } else {
                let body = response.Content.Bytes
                var offset = 0
                while offset < bodyCount {
                    bytes[index + offset] = body[offset]
                    offset += 1
                }
            }
        }
        return Ok(bytes)
    }

    // Fixed ASCII protocol fragments need no text codec or temporary byte storage.
    private static func AppendStatusPrefix(output: ArrayList<byte>) {
        output.Add((byte)72)
        output.Add((byte)84)
        output.Add((byte)84)
        output.Add((byte)80)
        output.Add((byte)47)
        output.Add((byte)49)
        output.Add((byte)46)
        output.Add((byte)49)
        output.Add((byte)32)
    }

    private static func AppendLengthPrefix(output: ArrayList<byte>) {
        output.Add((byte)13)
        output.Add((byte)10)
        output.Add((byte)67)
        output.Add((byte)111)
        output.Add((byte)110)
        output.Add((byte)116)
        output.Add((byte)101)
        output.Add((byte)110)
        output.Add((byte)116)
        output.Add((byte)45)
        output.Add((byte)76)
        output.Add((byte)101)
        output.Add((byte)110)
        output.Add((byte)103)
        output.Add((byte)116)
        output.Add((byte)104)
        output.Add((byte)58)
        output.Add((byte)32)
    }

    private static func AppendConnectionClose(output: ArrayList<byte>) {
        output.Add((byte)13)
        output.Add((byte)10)
        output.Add((byte)67)
        output.Add((byte)111)
        output.Add((byte)110)
        output.Add((byte)110)
        output.Add((byte)101)
        output.Add((byte)99)
        output.Add((byte)116)
        output.Add((byte)105)
        output.Add((byte)111)
        output.Add((byte)110)
        output.Add((byte)58)
        output.Add((byte)32)
        output.Add((byte)99)
        output.Add((byte)108)
        output.Add((byte)111)
        output.Add((byte)115)
        output.Add((byte)101)
        output.Add((byte)13)
        output.Add((byte)10)
    }

    private static func AppendWire(output: ArrayList<byte>, bytes: Sequence<byte>) {
        var index = 0
        while index < bytes.Count {
            output.Add(bytes[index])
            index += 1
        }
    }

    // Protocol integers are nonnegative and emitted directly as ASCII digits.
    private static func AppendDecimal(output: ArrayList<byte>, value: int) {
        var divisor = 1
        while value / divisor >= 10 {
            divisor *= 10
        }
        var remaining = value
        while divisor > 0 {
            output.Add((byte)(48 + remaining / divisor))
            remaining = remaining % divisor
            divisor = divisor / 10
        }
    }

    private static func HeaderToken(value: byte) -> bool {
        return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) ||
            (value >= 48 && value <= 57) || value == 33 || value == 35 ||
            value == 36 || value == 37 || value == 38 || value == 39 ||
            value == 42 || value == 43 || value == 45 || value == 46 ||
            value == 94 || value == 95 || value == 96 || value == 124 || value == 126
    }
}

// A context owns one exchange, not a reusable physical connection contract.
public class HttpContext : Disposable {
    private var owner: HttpServer
    private var connection: HttpConnection
    private var request: HttpRequest
    private var response: HttpResponse = HttpResponse(HttpStatusCode.OK, ArrayList<HttpHeader>(), ArrayList<byte>())
    private var closed: bool = false
    private var started: bool = false
    private var shutdownRegistration: CancellationRegistration? = null
    private var source: Promise<Result<System.Void, HttpError>> = Promise<Result<System.Void, HttpError>>()
    private var transfer: Option<Task<Result<int, HttpError>>> = None()
    private var buffer: byte[] = Array<byte>.Empty
    private var outgoing: byte[] = Array<byte>.Empty
    private var sent: int = 0
    private var token: CancellationToken = CancellationToken.None
    private var deadline = NetworkDeadline.Expired
    private var writeCancellation: CancellationTokenSource? = null
    private var writeCaller: CancellationRegistration? = null
    private var callerToken = CancellationToken.None
    private var sendingContent: HttpContent? = null
    private var ownsContent = false
    private var remainingContent = 0
    private var contentCount = 0
    private var contentOffset = 0
    private var readingContent: Task<Result<int, HttpError>>? = null

    internal init(owner: HttpServer, connection: HttpConnection, request: HttpRequest) {
        self.owner = owner
        self.connection = connection
        self.request = request
        shutdownRegistration = owner.StopToken.Register(self.Close)
    }

    /// The incoming request. AcceptHeaders supplies content readable only during this context's lifetime.
    val Request: HttpRequest => request

    /// The outgoing response configuration. Initially status 200 with empty content.
    val Response: HttpResponse => response

    /// Forwards status and empty-content configuration to Response without sending.
    func Respond(statusCode: HttpStatusCode) {
        response.Respond(statusCode)
    }

    /// Forwards status and content configuration to Response without sending.
    func Respond(statusCode: HttpStatusCode, content: HttpContent) {
        response.Respond(statusCode, content)
    }

    /// Configures status 200 and UTF-8 text/plain content; does not send it.
    func RespondText(text: string) {
        RespondText(HttpStatusCode.OK, text)
    }

    /// Configures a status and UTF-8 text/plain content; call Complete to send it.
    func RespondText(statusCode: HttpStatusCode, text: string) {
        response.Respond(statusCode, HttpStringContent(text))
    }

    /// Snapshots response headers and sends buffered bytes or a known-length stream, then closes the exchange.
    func Complete() -> Task<Result<System.Void, HttpError>> {
        return Complete(CancellationToken.None)
    }

    /// Reports validation/send errors or acknowledged cancellation; all end the exchange.
    func Complete(cancellationToken: CancellationToken) -> Task<Result<System.Void, HttpError>> {
        return Send(response, cancellationToken)
    }

    internal func Send(response: HttpResponse, cancellationToken: CancellationToken) -> Task<Result<System.Void, HttpError>> {
        if started || closed {
            let rejected = Promise<Result<System.Void, HttpError>>()
            _ = rejected.Complete(Error(HttpError.InvalidRequest("Context is closed or response already started")))
            return rejected.Task
        }
        started = true
        self.response = response
        token = cancellationToken
        callerToken = cancellationToken
        if token.IsCancellationRequested {
            Close()
            _ = source.Cancel()
            return source.Task
        }
        let encoded = HttpServer.EncodeResponse(response, if request.Method.Method == "HEAD" { 1 } else { 0 })
        if let Ok(bytes) = encoded {
            if let Error(reason) = response.Content.BeginUpload() {
                Finish(Error(reason))
                return source.Task
            }
            if !response.Content.IsBuffered {
                ownsContent = true
                sendingContent = response.Content
                if request.Method.Method != "HEAD" {
                    remainingContent = response.Content.Length
                }
            }
            outgoing = bytes
            // Socket providers currently admit arrays up to 64 KiB. Large
            // snapshots and stream producers use one reusable bounded block.
            if ownsContent || bytes.Length > 65536 {
                buffer = CheckedStorage.Reserve<byte>(4096)
            }
            deadline = NetworkDeadline.AfterMilliseconds(owner.Settings.WriteMilliseconds)
            if ownsContent {
                let cancellation = CancellationTokenSource()
                writeCancellation = cancellation
                writeCaller = callerToken.Register(() => { cancellation.Cancel() })
                token = cancellation.Token
                // NetworkDeadline rounds its timestamp up to a millisecond;
                // Timer uses an unrounded timestamp. Allow that rounding before
                // cancelling a waiting producer, so it observes TimedOut rather
                // than an unrelated cancelled task just before the deadline.
                cancellation.CancelAfter(Duration.FromTicks(((long)owner.Settings.WriteMilliseconds + 1L) * 10000L))
            }
            SendNext()
        } else if let Error(reason) = encoded {
            Finish(Error(reason))
        }
        return source.Task
    }

    /// Ends the exchange without implicitly sending a response. Safe to repeat.
    func Close() {
        if closed {
            return
        }
        closed = true
        request.Content.Dispose()
        connection.Close()
        let caller = writeCaller
        writeCaller = null
        if caller is CancellationRegistration callerSubscription {
            callerSubscription.Dispose()
        }
        let cancellation = writeCancellation
        writeCancellation = null
        if cancellation is CancellationTokenSource activeCancellation {
            activeCancellation.Cancel()
            activeCancellation.Dispose()
        }
        if ownsContent {
            ownsContent = false
            if sendingContent is HttpContent content {
                content.Dispose()
            }
            sendingContent = null
        }
        let registration = shutdownRegistration
        shutdownRegistration = null
        if registration is CancellationRegistration active {
            active.Dispose()
        }
        owner.Release()
    }

    /// Equivalent to Close; await Respond separately to observe send completion.
    func Dispose() {
        Close()
    }

    private func Finish(result: Result<System.Void, HttpError>) {
        Close()
        outgoing = Array<byte>.Empty
        _ = source.Complete(result)
    }

    private func SendNext() {
        if !closed && !callerToken.IsCancellationRequested && deadline.IsExpired {
            Finish(Error(HttpError.TimedOut))
            return
        }
        if closed || token.IsCancellationRequested {
            Close()
            outgoing = Array<byte>.Empty
            _ = source.Cancel()
            return
        }
        if deadline.IsExpired {
            Finish(Error(HttpError.TimedOut))
            return
        }
        if sent == outgoing.Length && remainingContent > 0 {
            if contentOffset < contentCount {
                let bodyWrite = connection.SendUntil(buffer, contentOffset, contentCount - contentOffset, deadline, token)
                transfer = Some(bodyWrite)
                bodyWrite.OnCompleted(self.OnSent)
            } else {
                let wanted = if remainingContent < buffer.Length { remainingContent } else { buffer.Length }
                if sendingContent is HttpContent content {
                    let bodyRead = content.ReadUpload(buffer, wanted, token)
                    readingContent = bodyRead
                    bodyRead.OnCompleted(self.OnContentRead)
                } else {
                    Finish(Error(HttpError.InvalidRequest("Missing response content")))
                }
            }
            return
        }
        if sent == outgoing.Length {
            let shutdownTask = connection.Shutdown(token)
            finishing = shutdownTask
            shutdownTask.OnCompleted(self.OnShutdown)
            return
        }
        if outgoing.Length <= 65536 {
            // Bound native transfer copies even when the snapshot is larger.
            let remaining = outgoing.Length - sent
            let directCount = if remaining < 4096 { remaining } else { 4096 }
            let directWrite = connection.SendUntil(outgoing, sent, directCount, deadline, token)
            transfer = Some(directWrite)
            directWrite.OnCompleted(self.OnSent)
            return
        }
        var count = 0
        while count < buffer.Length && sent + count < outgoing.Length {
            buffer[count] = outgoing[sent + count]
            count += 1
        }
        let pending = connection.SendUntil(buffer, 0, count, deadline, token)
        transfer = Some(pending)
        pending.OnCompleted(self.OnSent)
    }

    // Outcome adapter keeps the borrowed buffer alive through producer completion
    // and maps cancellation before releasing exchange ownership.
    private func OnContentRead() {
        if readingContent is Task<Result<int, HttpError>> pending {
            readingContent = null
            if !closed && !callerToken.IsCancellationRequested && deadline.IsExpired {
                Finish(Error(HttpError.TimedOut))
                return
            }
            if pending.IsCancelled || closed || token.IsCancellationRequested {
                Close()
                _ = source.Cancel()
                return
            }
            if let Ok(count) = pending.GetResult() {
                contentCount = count
                contentOffset = 0
                SendNext()
            } else if let Error(reason) = pending.GetResult() {
                Finish(Error(reason))
            }
        }
    }

    private var finishing: Task<Result<unit, HttpError>>? = null
    private func OnShutdown() {
        if finishing is Task<Result<unit, HttpError>> pending {
            finishing = null
            if pending.IsCancelled { Close(); _ = source.Cancel(); return }
            Finish(pending.GetResult())
        }
    }

    private func OnSent() {
        if let Some(pending) = transfer {
            transfer = None()
            if !closed && !callerToken.IsCancellationRequested && deadline.IsExpired {
                Finish(Error(HttpError.TimedOut))
                return
            }
            if pending.IsCancelled || closed || token.IsCancellationRequested {
                Close()
                outgoing = Array<byte>.Empty
                _ = source.Cancel()
                return
            }
            if deadline.IsExpired {
                Finish(Error(HttpError.TimedOut))
                return
            }
            if let Ok(count) = pending.GetResult() {
                if count == 0 {
                    Finish(Error(HttpError.Protocol("Response send made no progress")))
                    return
                }
                if sent == outgoing.Length && remainingContent > 0 {
                    contentOffset += count
                    remainingContent -= count
                } else {
                    sent += count
                }
                SendNext()
            } else if let Error(reason) = pending.GetResult() {
                Finish(Error(reason))
            }
        }
    }
}

internal class HttpServerExchange {
    private val streaming: bool
    private var nextAccept: HttpServerExchange? = null
    internal val NextAccept: HttpServerExchange? => nextAccept

    internal func SetNextAccept(value: HttpServerExchange?) {
        nextAccept = value
    }

    internal func TakeNextAccept() -> HttpServerExchange? {
        let next = nextAccept
        nextAccept = null
        return next
    }

    private var owner: HttpServer
    private var listener: Socket
    private var cancellation: CancellationTokenSource = CancellationTokenSource()
    private var callerRegistration: CancellationRegistration? = null
    private var shutdownRegistration: CancellationRegistration? = null
    private var source: Promise<Result<HttpContext, HttpError>> = Promise<Result<HttpContext, HttpError>>()
    private var socket: Option<HttpConnection> = None()
    private var accepting: Option<Task<Result<Socket, SocketError>>> = None()
    private var transfer: Option<Task<Result<int, HttpError>>> = None()
    private var requestDecoder: HttpRequestDecoder? = null
    private var buffer: byte[]? = null
    private var deadline = NetworkDeadline.Expired

    internal init(owner: HttpServer, listener: Socket, token: CancellationToken, streaming: bool) {
        self.streaming = streaming
        self.owner = owner
        self.listener = listener
        callerRegistration = token.Register(self.RequestCancellation)
        shutdownRegistration = owner.StopToken.Register(self.RequestCancellation)
    }

    private func RequestCancellation() {
        cancellation.Cancel()
        if owner.RemoveAccept(self) {
            Fail(HttpError.InvalidRequest("Accept cancelled"))
        }
    }

    internal func Start() -> Task<Result<HttpContext, HttpError>> {
        owner.BeginAccept(self)
        return source.Task
    }

    internal func StartAccept() {
        let pending = listener.Accept(cancellation.Token)
        accepting = Some(pending)
        pending.OnCompleted(self.OnAccepted)
    }

    private func Cleanup() {
        let caller = callerRegistration
        callerRegistration = null
        if caller is CancellationRegistration active {
            active.Dispose()
        }
        let shutdown = shutdownRegistration
        shutdownRegistration = null
        if shutdown is CancellationRegistration active {
            active.Dispose()
        }
        cancellation.Dispose()
        accepting = None()
        transfer = None()
        ReleaseReceiveBuffer()
    }

    private func ReleaseReceiveBuffer() {
        if buffer is byte[] completed {
            buffer = null
            if !streaming {
                owner.ReturnReceiveBuffer(completed)
            }
        }
    }

    private func Fail(reason: HttpError) {
        if let Some(connection) = socket {
            connection.Close()
        }
        socket = None()
        let cancelled = cancellation.IsCancellationRequested
        Cleanup()
        owner.Release()
        if cancelled {
            _ = source.Cancel()
        } else {
            _ = source.Complete(Error(reason))
        }
    }

    private func OnAccepted() {
        if let Some(pending) = accepting {
            accepting = None()
            owner.EndAccept()
            if pending.IsCancelled {
                Fail(HttpError.InvalidRequest("Accept cancelled"))
                return
            }
            if let Ok(connection) = pending.GetResult() {
                let transport = HttpConnection(connection)
                socket = Some(transport)
                deadline = NetworkDeadline.AfterMilliseconds(owner.Settings.ReadMilliseconds)
                if owner.SslOptions is SslServerAuthenticationOptions options {
                    let handshake = transport.AuthenticateServer(options, deadline, cancellation.Token)
                    authentication = handshake
                    handshake.OnCompleted(self.OnAuthenticated)
                } else { ReceiveNext() }
            } else if let Error(reason) = pending.GetResult() {
                owner.ListenerFailed(HttpError.Transport(reason))
                Fail(HttpError.Transport(reason))
            }
        }
    }

    private var authentication: Task<Result<unit, HttpError>>? = null
    // Outcome adapter transfers cancellation to the HTTP exchange before cleanup.
    private func OnAuthenticated() {
        if authentication is Task<Result<unit, HttpError>> pending {
            authentication = null
            if pending.IsCancelled { Fail(HttpError.InvalidRequest("TLS cancelled")); return }
            if let Error(error) = pending.GetResult() { Fail(error); return }
            ReceiveNext()
        }
    }

    private func ReceiveNext() {
        if cancellation.IsCancellationRequested {
            Fail(HttpError.InvalidRequest("Request cancelled"))
            return
        }
        if let Some(connection) = socket {
            // Queued accepts and TLS handshakes need cancellation state, but no
            // HTTP parser or receive storage until they can read request bytes.
            if buffer is null {
                let decoder = HttpRequestDecoder(owner.Settings, owner.SslOptions is SslServerAuthenticationOptions)
                if streaming {
                    decoder.EnableStreaming()
                }
                requestDecoder = decoder
                buffer = if streaming { CheckedStorage.Reserve<byte>(256) } else { owner.RentReceiveBuffer(256) }
            }
            if buffer is byte[] receiving {
                let pending = connection.ReceiveUntil(receiving, 0, receiving.Length, deadline, cancellation.Token)
                transfer = Some(pending)
                pending.OnCompleted(self.OnReceived)
            }
        }
    }

    private func OnReceived() {
        // ReceiveNext initializes the parser before registering this callback.
        if requestDecoder is HttpRequestDecoder decoder {
            if buffer is byte[] received {
                OnReceived(decoder, received)
            }
        }
    }

    private func OnReceived(decoder: HttpRequestDecoder, received: byte[]) {
        if let Some(pending) = transfer {
            transfer = None()
            if pending.IsCancelled || cancellation.IsCancellationRequested {
                Fail(HttpError.InvalidRequest("Request cancelled"))
                return
            }
            if deadline.IsExpired {
                Fail(HttpError.TimedOut)
                return
            }
            if let Ok(count) = pending.GetResult() {
                if count == 0 {
                    Fail(HttpError.Protocol("EOF before complete request"))
                    return
                }
                if let Error(reason) = decoder.Push(received[0..count]) {
                    Fail(reason)
                    return
                }
                if streaming && decoder.HeadersComplete {
                    if let Ok(request) = decoder.FinishHeaders() {
                        if let Some(connection) = socket {
                            let length = decoder.BodyLength
                            let stream = HttpBodyInput(connection, received, decoder.Consumed, count, length,
                                owner.Settings.BodyBytes, Some(deadline), false,
                                request.Method.Method == "GET" || request.Method.Method == "DELETE" || request.Method.Method == "HEAD")
                            request.SetContent(HttpContent.Incoming(stream, if length < 0 { -1 } else { length }))
                            let context = HttpContext(owner, connection, request)
                            socket = None()
                            Cleanup()
                            _ = source.Complete(Ok(context))
                        }
                    }
                } else if decoder.Complete {
                    if let Ok(request) = decoder.Finish() {
                        if let Some(connection) = socket {
                            let context = HttpContext(owner, connection, request)
                            socket = None()
                            Cleanup()
                            _ = source.Complete(Ok(context))
                        }
                    } else {
                        Fail(HttpError.Protocol("Invalid request"))
                    }
                } else {
                    // Keep tiny requests cheap; grow only after a partial request.
                    // Push has already copied all bytes out of the receive block.
                    if received.Length < 4096 {
                        ReleaseReceiveBuffer()
                        buffer = if streaming { CheckedStorage.Reserve<byte>(4096) } else { owner.RentReceiveBuffer(4096) }
                    }
                    ReceiveNext()
                }
            } else if let Error(reason) = pending.GetResult() {
                Fail(reason)
            }
        }
    }
}

internal class HttpServeOperation {
    private val managed: bool
    private var stopping: bool = false
    private var invoking: bool = false
    private var managedResponse: HttpResponse? = null
    private var server: HttpServer
    private var handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>
    private var token: CancellationToken
    private var source: Promise<Result<System.Void, HttpError>> = Promise<Result<System.Void, HttpError>>()
    private var context: Option<HttpContext> = None()
    private var accepting: Option<Task<Result<HttpContext, HttpError>>> = None()
    private var handling: Option<Task<Result<HttpResponse, HttpError>>> = None()
    private var sending: Option<Task<Result<System.Void, HttpError>>> = None()
    private var callerRegistration: CancellationRegistration? = null
    private var shutdownRegistration: CancellationRegistration? = null

    internal init(server: HttpServer, handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>, token: CancellationToken) {
        self.server = server
        self.handler = handler
        self.token = token
        managed = false
    }

    internal init(server: HttpServer, handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>) {
        self.server = server
        self.handler = handler
        token = CancellationToken.None
        managed = true
    }

    internal func Start() -> Task<Result<System.Void, HttpError>> {
        let pending = if managed { server.AcceptForServe() } else { server.Accept(token) }
        accepting = Some(pending)
        pending.OnCompleted(self.OnAccepted)
        return source.Task
    }

    private func Cleanup() {
        let caller = callerRegistration
        callerRegistration = null
        if caller is CancellationRegistration active {
            active.Dispose()
        }
        let shutdown = shutdownRegistration
        shutdownRegistration = null
        if shutdown is CancellationRegistration active {
            active.Dispose()
        }
        if let Some(active) = context {
            active.Close()
        }
        context = None()
        handling = None()
        if managedResponse is HttpResponse response {
            response.Dispose()
        }
        managedResponse = null
    }

    private func Cancel() {
        stopping = true
        // During a send the socket callback owns acknowledgement. During an
        // application handler wait there is no transport operation to acknowledge.
        if let Some(active) = context {
            active.Close()
        }
        if let Some(_) = sending {
            return
        }
        if managed {
            if invoking {
                return
            }
            if let Some(_) = handling {
                // Keep observing the handler after Close; dispose a late response.
                return
            }
        }
        Cleanup()
        _ = source.Cancel()
    }

    private func Finish(result: Result<System.Void, HttpError>) {
        Cleanup()
        _ = source.Complete(result)
    }

    private func OnAccepted() {
        if let Some(pending) = accepting {
            accepting = None()
            if pending.IsCancelled {
                Cancel()
                return
            }
            if let Ok(active) = pending.GetResult() {
                context = Some(active)
                callerRegistration = token.Register(self.Cancel)
                shutdownRegistration = server.StopToken.Register(self.Cancel)
                if source.Task.IsCompleted {
                    Cleanup()
                    return
                }
                invoking = true
                let response = handler(active.Request)
                invoking = false
                if source.Task.IsCompleted {
                    Cleanup()
                    return
                }
                handling = Some(response)
                response.OnCompleted(self.OnHandled)
            } else if let Error(reason) = pending.GetResult() {
                Finish(Error(reason))
            }
        }
    }

    private func OnHandled() {
        if source.Task.IsCompleted {
            return
        }
        if let Some(pending) = handling {
            handling = None()
            if managed && stopping {
                if !pending.IsCancelled {
                    if let Ok(response) = pending.GetResult() {
                        response.Dispose()
                    }
                }
                Cancel()
                return
            }
            if pending.IsCancelled {
                Cancel()
                return
            }
            if let Ok(response) = pending.GetResult() {
                if let Some(active) = context {
                    if managed {
                        managedResponse = response
                    }
                    let result = active.Send(response, token)
                    sending = Some(result)
                    result.OnCompleted(self.OnSent)
                }
            } else if let Error(reason) = pending.GetResult() {
                Finish(Error(reason))
            }
        }
    }

    private func OnSent() {
        if let Some(pending) = sending {
            sending = None()
            if pending.IsCancelled {
                Cancel()
                return
            }
            Finish(pending.GetResult())
        }
    }
}


// Outcome-observation adapters own all Serve exchanges and their lifetime task.
// They reuse a fixed number of lanes rather than allocating an unbounded task queue.
internal class HttpServerRun {
    private val server: HttpServer
    private val handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>
    private val token: CancellationToken
    private val source: Promise<Result<System.Void, HttpError>> = Promise<Result<System.Void, HttpError>>()
    private var registration: CancellationRegistration? = null
    private var lanes: ArrayList<HttpServerLane> = ArrayList<HttpServerLane>(16)
    private var remaining: int = 16
    private var failure: Option<HttpError> = None()

    internal init(server: HttpServer, handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>, token: CancellationToken) {
        self.server = server
        self.handler = handler
        self.token = token
    }

    internal func Start() -> Task<Result<System.Void, HttpError>> {
        registration = token.Register(server.Close)
        for index in 0..16 {
            let lane = HttpServerLane(self, server, handler)
            lanes.Add(lane)
            lane.Start()
        }
        return source.Task
    }

    internal func Fail(error: HttpError) {
        if failure is None {
            failure = Some(error)
        }
        server.Close()
    }

    internal func Finished() {
        remaining -= 1
        if remaining != 0 {
            return
        }
        lanes = ArrayList<HttpServerLane>()
        if registration is CancellationRegistration active {
            active.Dispose()
        }
        registration = null
        if let Some(error) = failure {
            _ = source.Complete(Error(error))
        } else if token.IsCancellationRequested {
            _ = source.Cancel()
        } else {
            _ = source.Complete(Ok(()))
        }
    }
}

internal class HttpServerLane {
    private val owner: HttpServerRun
    private val server: HttpServer
    private val handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>
    private var pending: Task<Result<System.Void, HttpError>>? = null

    internal init(owner: HttpServerRun, server: HttpServer, handler: (HttpRequest) -> Task<Result<HttpResponse, HttpError>>) {
        self.owner = owner
        self.server = server
        self.handler = handler
    }

    internal func Start() {
        if server.IsClosed {
            owner.Finished()
            return
        }
        let operation = HttpServeOperation(server, handler).Start()
        pending = operation
        operation.OnCompleted(self.Completed)
    }

    private func Completed() {
        if pending is Task<Result<System.Void, HttpError>> operation {
            pending = null
            if operation.IsCancelled {
                if !server.IsClosed {
                    server.RecordFailure(HttpError.Handler("Request handler cancelled"))
                }
            } else if let Error(error) = operation.GetResult() {
                if !server.IsClosed {
                    server.RecordFailure(error)
                }
            } else {
                server.RecordServed()
            }
            Start()
        }
    }
}
