module System.Globalization

import System.Time.*

import System.Result.*

/// Provisional explicit civil formatting with independent culture and calendar.
public class DateTimeFormat {
    private var culture: Culture
    private var calendar: System.Time.Calendar
    private var rules: DateTimeFormatRules

    private init(culture: Culture, calendar: System.Time.Calendar) {
        self.culture = culture
        self.calendar = calendar
        if culture.Name.Equals("he-IL") {
            rules = HebrewDateTimeFormat(calendar)
        } else if culture.Name.Equals("sv-SE") {
            rules = SwedishDateTimeFormat()
        } else {
            rules = InvariantDateTimeFormat()
        }
    }

    static val Invariant: DateTimeFormat {
        get {
            let selectedCulture = System.Globalization.Culture.Invariant
            let selectedCalendar = System.Time.Calendar.Gregorian
            return DateTimeFormat(selectedCulture, selectedCalendar)
        }
    }
    val Culture: Culture => culture
    val Calendar: System.Time.Calendar => calendar

    /// Selects culture and calendar independently. Both supported calendars are accepted.
    static func Create(culture: Culture, calendar: System.Time.Calendar) -> DateTimeFormat {
        return DateTimeFormat(culture, calendar)
    }

    func WithCalendar(calendar: System.Time.Calendar) -> DateTimeFormat {
        return DateTimeFormat(culture, calendar)
    }

    /// Formats calendar fields using the selected culture; Hebrew-calendar he-IL uses Hebrew letters.
    func FormatDate(date: System.Time.Date) -> System.Result<string, System.Time.InvalidDateError> {
        let year = calendar.GetYear(date)?
        let month = calendar.GetMonth(date)?
        let day = calendar.GetDay(date)?
        return Ok(rules.FormatDate(year, month, day))
    }

    /// Formats HH:mm:ss.fffffff; Swedish uses a comma before fractional seconds.
    func FormatTime(time: System.Time.TimeOfDay) -> string {
        return rules.FormatTime(time)
    }

    /// Invariant uses T; named cultures use a space. No offset or timezone is implied.
    func FormatLocalDateTime(value: System.Time.LocalDateTime) -> System.Result<string, System.Time.InvalidDateError> {
        let date = FormatDate(value.Date)?
        return Ok(date + rules.DateTimeSeparator + FormatTime(value.Time))
    }

    /// Supports empty/G/d for the selected numeric date, and O/o for invariant Gregorian yyyy-MM-dd.
    /// Other specifiers fault. Selected-calendar range failures retain InvalidDateError.
    func FormatDate(date: System.Time.Date, format: string) -> System.Result<string, System.Time.InvalidDateError> {
        if format == "" || format == "G" || format == "d" {
            return FormatDate(date)
        }
        if format == "O" || format == "o" {
            return Invariant.FormatDate(date)
        }
        System.Fail("Unsupported Date format")
        return Error(System.Time.InvalidDateError())
    }

    /// Supports empty/G for existing culture precision, O/o for invariant seven-digit precision,
    /// T for HH:mm:ss and t for HH:mm. Other specifiers fault.
    func FormatTime(time: System.Time.TimeOfDay, format: string) -> string {
        if format == "" || format == "G" {
            return FormatTime(time)
        }
        if format == "O" || format == "o" {
            return Invariant.FormatTime(time)
        }
        if format == "T" || format == "t" {
            let digits = DateTimeFormatDigits()
            let text = digits.Pad(time.Hour, 2) + ":" + digits.Pad(time.Minute, 2)
            return if format == "T" { text + ":" + digits.Pad(time.Second, 2) } else { text }
        }
        System.Fail("Unsupported TimeOfDay format")
        return ""
    }

    /// Supports empty/G for the selected civil conventions, O/o for invariant seven-digit precision,
    /// and s for invariant yyyy-MM-ddTHH:mm:ss. No format adds an offset or a zone.
    /// Other specifiers fault; selected-calendar range failures retain InvalidDateError.
    func FormatLocalDateTime(value: System.Time.LocalDateTime, format: string) -> System.Result<string, System.Time.InvalidDateError> {
        if format == "" || format == "G" {
            return FormatLocalDateTime(value)
        }
        if format == "O" || format == "o" {
            return Invariant.FormatLocalDateTime(value)
        }
        if format == "s" {
            let selected = Invariant
            let date = selected.FormatDate(value.Date)?
            return Ok(date + "T" + selected.FormatTime(value.Time, "T"))
        }
        System.Fail("Unsupported LocalDateTime format")
        return Error(System.Time.InvalidDateError())
    }

}

internal interface DateTimeFormatRules {
    val DateTimeSeparator: string { get; }
    func FormatDate(year: int, month: int, day: int) -> string
    func FormatTime(time: System.Time.TimeOfDay) -> string
}
