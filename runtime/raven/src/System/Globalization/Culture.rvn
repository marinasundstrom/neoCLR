module System.Globalization

import System.Time.*

/// Immutable, bounded formatting conventions; no ambient culture or locale resolver.
public class Culture {
    private var kind: int

    private init(value: int) {
        kind = value
    }

    static val Invariant: Culture => Culture(0)
    static val SwedishSweden: Culture => Culture(1)
    static val HebrewIsrael: Culture => Culture(2)

    /// English formatting conventions for the United Kingdom.
    static val EnglishUnitedKingdom: Culture => Culture(3)
    /// English formatting conventions for the United States.
    static val EnglishUnitedStates: Culture => Culture(4)

    val Name: string {
        get {
            if kind == 1 {
                return "sv-SE"
            }
            if kind == 2 {
                return "he-IL"
            }
            if kind == 3 {
                return "en-GB"
            }
            if kind == 4 {
                return "en-US"
            }
            return ""
        }
    }
    val Language: Language {
        get {
            if kind == 1 {
                return System.Globalization.Language.Swedish
            }
            if kind == 2 {
                return System.Globalization.Language.Hebrew
            }
            if kind == 3 || kind == 4 {
                return System.Globalization.Language.English
            }
            return System.Globalization.Language.Undetermined
        }
    }
    /// Resolves a fresh snapshot of the host preference with invariant fallback.
    static val Current: Culture => SystemCultureProvider().Current

    val DefaultCalendar: System.Time.Calendar => System.Time.Calendar.Gregorian
    /// Fresh calendar selections supported by the explicit formatting policy, default first.
    /// Both calendars are available independently of language; this is not an OS locale inventory.
    val OptionalCalendars: System.Time.Calendar[] => [System.Time.Calendar.Gregorian, System.Time.Calendar.Hebrew]
    /// Immutable numeric conventions; retain the returned policy for repeated formatting.
    val NumberFormat: NumberFormat => System.Globalization.NumberFormat.Create(self)
    val DateTimeFormat: DateTimeFormat => System.Globalization.DateTimeFormat.Create(self, DefaultCalendar)
}
