module System.Globalization

import System.*
import System.Result.*

// Bounded CLDR-derived presentation data; formatting does not resolve ambient culture.
internal static class CurrencyFormatting {
    static func Symbol(currency: Currency, culture: Culture) -> string {
        let code = currency.Code
        if code == "XXX" {
            return "¤"
        }
        if code == "EUR" {
            return "€"
        }
        if code == "ILS" {
            return "₪"
        }
        if code == "SEK" { return if culture.Name == "sv-SE" { "kr" } else { "SEK" } }
        if code == "GBP" { return if culture.Name == "sv-SE" { "GBP" } else { "£" } }
        if code == "USD" { return if culture.Name == "sv-SE" || culture.Name == "en-GB" { "US$" } else { "$" } }
        if code == "JPY" {
            if culture.Name == "sv-SE" {
                return "JPY"
            }
            if culture.Name == "en-GB" {
                return "JP¥"
            }
            return "¥"
        }
        return code
    }

    static func SymbolAfter(culture: Culture) -> bool => culture.Name == "sv-SE" || culture.Name == "he-IL"
    static func DirectionMark(culture: Culture) -> string => if culture.Name == "he-IL" { "‏" } else { "" }
    static func NegativeSign(culture: Culture) -> string {
        if culture.Name == "sv-SE" {
            return "−"
        }
        if culture.Name == "he-IL" {
            return "‎-"
        }
        return "-"
    }

    static func PrefixSpace(symbol: string) -> string {
        let bytes = symbol.Utf8Bytes
        if bytes.Length == 0 {
            return ""
        }
        let last = bytes[bytes.Length - 1]
        return if last >= (byte)65 && last <= (byte)90 { " " } else { "" }
    }

    private static func Matches(bytes: ReadOnlySlice<byte>, offset: int, text: string) -> bool {
        let expected = text.Utf8Bytes
        if offset < 0 || offset > bytes.Length - expected.Length {
            return false
        }
        var index = 0
        while index < expected.Length {
            if bytes[offset + index] != expected[index] {
                return false
            }
            index += 1
        }
        return true
    }

    static func Parse(text: string, currency: Currency, culture: Culture) -> Result<Decimal, NumberParseError> {
        let bytes = text.Utf8Bytes
        let direction = DirectionMark(culture)
        var start = 0
        var end = bytes.Length
        if !Matches(bytes, start, direction) {
            return Error(NumberParseError.InvalidFormat())
        }
        start += direction.Utf8Bytes.Length
        let minus = NegativeSign(culture)
        var negative = false
        if Matches(bytes, start, minus) {
            negative = true
            start += minus.Utf8Bytes.Length
        } else if Matches(bytes, start, "+") {
            start += 1
        }
        let symbol = Symbol(currency, culture)
        var token = symbol
        if SymbolAfter(culture) {
            if !Matches(bytes, end - symbol.Utf8Bytes.Length, symbol) {
                token = currency.Code
                if !Matches(bytes, end - token.Utf8Bytes.Length, token) {
                    return Error(NumberParseError.InvalidFormat())
                }
            }
            end -= token.Utf8Bytes.Length
            end -= direction.Utf8Bytes.Length
            if !Matches(bytes, end, direction) {
                return Error(NumberParseError.InvalidFormat())
            }
            end -= 2
            if !Matches(bytes, end, " ") {
                return Error(NumberParseError.InvalidFormat())
            }
        } else {
            if !Matches(bytes, start, symbol) {
                token = currency.Code
                if !Matches(bytes, start, token) {
                    return Error(NumberParseError.InvalidFormat())
                }
            }
            start += token.Utf8Bytes.Length
            let space = PrefixSpace(token)
            if !Matches(bytes, start, space) {
                return Error(NumberParseError.InvalidFormat())
            }
            start += space.Utf8Bytes.Length
        }
        if start >= end {
            return Error(NumberParseError.InvalidFormat())
        }
        return Decimal.ParseCurrencyDigits(bytes[start..end], culture, negative)
    }
}
