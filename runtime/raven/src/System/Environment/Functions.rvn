module System.Environment

import System.EnvironmentError
import System.Result.*
import System.Option.*

public func GetCommandLineArgs() -> string[] {
    return neoCLR.Runtime.EnvironmentArguments()
}

public func GetCurrentDirectory() -> System.Result<string, EnvironmentError> {
    let payload = neoCLR.Runtime.EnvironmentCurrentDirectory()
    if neoCLR.Runtime.IsValue<int>(payload) {
        return Error(default(EnvironmentError))
    }
    return Ok(neoCLR.Runtime.UnpackValue<string>(payload))
}

public func GetEnvironmentVariable(name: string) -> System.Result<System.Option<string>, EnvironmentError> {
    let payload = neoCLR.Runtime.EnvironmentVariable(name)
    if neoCLR.Runtime.IsValue<int>(payload) {
        return Error(default(EnvironmentError))
    }
    if neoCLR.Runtime.IsValue<System.Void>(payload) {
        let absent: System.Option<string> = None()
        return Ok(absent)
    }
    let present: System.Option<string> = Some(neoCLR.Runtime.UnpackValue<string>(payload))
    return Ok(present)
}
