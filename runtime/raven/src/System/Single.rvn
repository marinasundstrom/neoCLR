namespace System

import System.Result.*
import System.Runtime.CompilerServices.RuntimeServices

public struct Single : Number {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: float

    static val Zero: float => (float)0
    static val One: float => (float)1

    static func +(left: float, right: float) -> float => (float)(left + right)
    static func -(left: float, right: float) -> float => (float)(left - right)
    static func *(left: float, right: float) -> float => (float)(left * right)
    static func /(left: float, right: float) -> float => (float)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<float, NumberParseError> {
        let payload = RuntimeServices.ParseSingle(value)
        if RuntimeServices.IsValue<float>(payload) {
            return Ok(RuntimeServices.UnpackValue<float>(payload))
        }
        let status = RuntimeServices.UnpackValue<int>(payload)
        if status == 1 {
            return Error(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Error(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Error(NumberParseError.InvalidFormat())
    }

    func CompareTo(other: float) -> int {
        if m_value != m_value {
            if other != other {
                return 0
            }
            return -1
        }
        if other != other {
            return 1
        }
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
