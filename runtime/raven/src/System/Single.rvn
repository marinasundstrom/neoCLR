module System

import System.Result.*

public struct Single : Number, EquatableTo<float> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: float

    static val Zero: float => (float)0
    static val One: float => (float)1

    static func +(left: float, right: float) -> float => (float)(left + right)
    static func -(left: float, right: float) -> float => (float)(left - right)
    static func *(left: float, right: float) -> float => (float)(left * right)
    static func /(left: float, right: float) -> float => (float)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<float, NumberParseError> {
        let payload = neoCLR.Runtime.ParseSingle(value)
        if neoCLR.Runtime.IsValue<float>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<float>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<int>(payload)
        if status == 1 {
            return Error(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Error(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Error(NumberParseError.InvalidFormat())
    }

    /// Tests value equality; NaNs compare equal and signed zeros compare equal.
    func Equals(other: float) -> bool => m_value == other || (m_value != m_value && other != other)

    func CompareTo(other: float) -> int {
        if m_value != m_value {
            if other != other {
                return 0
            }
            return -1
        }
        if other != other {
            return 1
        }
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
