namespace System.Introspection

import System.*
import System.Collections.*
import System.Runtime.CompilerServices.*

public sealed interface AssemblyInfo {
    val Name: string { get }
    val FullName: string { get }
    val MetadataToken: int { get }
    val ReferencedAssemblies: Sequence<AssemblyInfo> { get }
    func GetModules() -> Sequence<ModuleInfo>
    func GetTypes() -> Sequence<TypeInfo>
}

internal class RuntimeAssemblyInfo : AssemblyInfo {
    private field StoredIdentity: string

    private init(identity: string) {
        StoredIdentity = identity
    }

    val Name: string => RuntimeServices.AssemblyName(StoredIdentity)

    val FullName: string => StoredIdentity

    val MetadataToken: int => RuntimeServices.AssemblyMetadataToken(StoredIdentity)

    val ReferencedAssemblies: Sequence<AssemblyInfo> => RuntimeServices.AssemblyReferences(StoredIdentity)

    func GetModules() -> Sequence<ModuleInfo> {
        return RuntimeServices.AssemblyModules(StoredIdentity)
    }

    func GetTypes() -> Sequence<TypeInfo> {
        return RuntimeServices.AssemblyTypes(StoredIdentity)
    }

    override func Equals(other: Object?) -> bool {
        if other is RuntimeAssemblyInfo implementation {
            return StoredIdentity == implementation.StoredIdentity
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(StoredIdentity)
        return hash.ToHashCode()
    }

    override func ToString() -> string => FullName

}
