module System.Introspection

import System.*
import System.Collections.*
import System.Runtime.CompilerServices.*

public sealed interface AssemblyInfo {
    val Name: string { get }
    val FullName: string { get }
    val MetadataToken: int { get }
    val ReferencedAssemblies: Sequence<AssemblyInfo> { get }
    func GetModules() -> Sequence<ModuleInfo>
    func GetTypes() -> Sequence<TypeInfo>
}

internal class RuntimeAssemblyInfo : AssemblyInfo {
    private field StoredIdentity: string

    private init(identity: string) {
        StoredIdentity = identity
    }

    val Name: string => neoCLR.Runtime.AssemblyName(StoredIdentity)

    val FullName: string => StoredIdentity

    val MetadataToken: int => neoCLR.Runtime.AssemblyMetadataToken(StoredIdentity)

    val ReferencedAssemblies: Sequence<AssemblyInfo> => neoCLR.Runtime.AssemblyReferences(StoredIdentity)

    func GetModules() -> Sequence<ModuleInfo> {
        return neoCLR.Runtime.AssemblyModules(StoredIdentity)
    }

    func GetTypes() -> Sequence<TypeInfo> {
        return neoCLR.Runtime.AssemblyTypes(StoredIdentity)
    }

    override func Equals(other: Object?) -> bool {
        if other is RuntimeAssemblyInfo implementation {
            return String.CompareOrdinal(StoredIdentity, implementation.StoredIdentity) == 0
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(neoCLR.Runtime.StringHashOrdinal(StoredIdentity))
        return hash.ToHashCode()
    }

    override func ToString() -> string => FullName

}
