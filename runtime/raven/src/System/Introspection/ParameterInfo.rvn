module System.Introspection

import System.*
import System.Option.*
import System.Collections.*
import System.Runtime.CompilerServices.*

public sealed interface ParameterInfo {
    func GetCustomAttributesData() -> Sequence<CustomAttributeData>
    val MetadataToken: Option<int> { get }
    val Module: Option<ModuleInfo> { get }
    val Name: string { get }
    val Position: int { get }
    val ParameterType: TypeInfo { get }
    val IsOut: bool { get }
    val IsOutWhenTrue: bool { get }
    val IsReadOnly: bool { get }
}

internal class RuntimeParameterInfo : ParameterInfo {
    private field StoredName: string
    private field StoredPosition: int
    private field StoredParameterType: TypeInfo
    private field StoredIsOut: bool
    private field StoredIsOutWhenTrue: bool
    private field StoredIsReadOnly: bool
    private field StoredMetadataToken: int
    private field StoredModule: Option<ModuleInfo>
    private field StoredDeclaringType: TypeInfo
    private field StoredMemberKind: int
    private field StoredMemberIndex: int
    private field StoredMemberIdentity: string

    private init(name: string, position: int, parameterType: TypeInfo,
        isOut: bool, isOutWhenTrue: bool, isReadOnly: bool, metadataToken: int, module: Option<ModuleInfo>,
        declaringType: TypeInfo, memberKind: int, memberIndex: int) {
        StoredName = name
        StoredPosition = position
        StoredParameterType = parameterType
        StoredIsOut = isOut
        StoredIsOutWhenTrue = isOutWhenTrue
        StoredIsReadOnly = isReadOnly
        StoredMetadataToken = metadataToken
        StoredModule = module
        StoredDeclaringType = declaringType
        StoredMemberKind = memberKind
        StoredMemberIndex = memberIndex
        StoredMemberIdentity = ""
    }

    func GetCustomAttributesData() -> Sequence<CustomAttributeData> {
        if StoredDeclaringType.IsNominalType {
            return RuntimeServices.MemberCustomAttributes(StoredDeclaringType, StoredMetadataToken)
        }
        return CheckedStorage.Reserve<CustomAttributeData>(0)
    }

    val MetadataToken: Option<int> => if StoredMetadataToken == 0 { None } else { Some(StoredMetadataToken) }
    val Module: Option<ModuleInfo> => StoredModule match {
        Some(let module) => Some(module)
        None => None
    }
    val Name: string => StoredName
    val Position: int => StoredPosition
    val ParameterType: TypeInfo => StoredParameterType
    val IsOut: bool => StoredIsOut
    val IsOutWhenTrue: bool => StoredIsOutWhenTrue
    val IsReadOnly: bool => StoredIsReadOnly

    override func Equals(other: Object?) -> bool {
        if other is RuntimeParameterInfo implementation {
            return StoredMemberIdentity == implementation.StoredMemberIdentity
                && Position == implementation.Position
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(StoredMemberIdentity)
        hash.Add(Position)
        return hash.ToHashCode()
    }

    override func ToString() -> string => Name

}
