    }


    func GetGenericArguments() -> Sequence<TypeInfo> {
        return RuntimeTypeInfo.GenericArgumentsFromHandle(Handle)
    }

    func GetElementType() -> Optional<TypeInfo> {
        return neoCLR.Runtime.TypeElementType(Handle)
    }
}

// Keep assignment semantics in the runtime; descriptors only project the contract.
internal static class TypeRelationships {
    private static func Handle(type: TypeInfo) -> RuntimeTypeHandle {
        if type is RuntimeNominalTypeInfo nominal {
            return nominal.ExecutionHandle
        }
        if type is RuntimeFunctionTypeInfo function {
            return function.ExecutionHandle
        }
        return ((RuntimeTypeInfo)type).ExecutionHandle
    }

    static func Assignable(source: TypeInfo, target: TypeInfo) -> bool {
        return neoCLR.Runtime.ReflectionAssignable(Handle(source), Handle(target))
    }

    static func Subclass(source: TypeInfo, target: TypeInfo) -> bool {
        return neoCLR.Runtime.ReflectionSubclass(Handle(source), Handle(target))
    }
}

/// Declared variance of a nominal interface type parameter.
public enum GenericVariance {
    Invariant = 0
    Covariant = 1
    Contravariant = 2
}

/// An unbound generic parameter discovered on a type or method definition.
/// Closed generic arguments describe their actual types instead.
public sealed interface GenericParameterTypeInfo : TypeInfo {
    /// The declaration's variance; invariant when no annotation is present.
    val Variance: GenericVariance { get }
}

internal class RuntimeGenericParameterTypeInfo : RuntimeTypeInfo, GenericParameterTypeInfo {
    private init(handle: RuntimeTypeHandle) : base(handle) { }

    internal static func Create(handle: RuntimeTypeHandle) -> GenericParameterTypeInfo {
        return RuntimeGenericParameterTypeInfo(handle)
    }

    val Variance: GenericVariance {
        get {
            if neoCLR.Runtime.TypeShape(ExecutionHandle, 18) {
                return GenericVariance.Covariant
            }
            if neoCLR.Runtime.TypeShape(ExecutionHandle, 19) {
                return GenericVariance.Contravariant
            }
            return GenericVariance.Invariant
        }
    }
}
