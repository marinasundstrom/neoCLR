    }

    func GetElementType() -> Optional<TypeInfo> {
        return neoCLR.Runtime.TypeElementType(Handle)
    }
}

public class CustomAttributeTypedArgument {
    private var storedType: TypeInfo
    private var storedValue: Object?

    private init(type: TypeInfo, value: Object?) {
        storedType = type
        storedValue = value
    }

    val ArgumentType: TypeInfo => storedType
    val Value: Object? => storedValue
}

public class CustomAttributeNamedArgument {
    private var storedName: string
    private var storedIsField: bool
    private var storedValue: CustomAttributeTypedArgument

    private init(name: string, isField: bool, value: CustomAttributeTypedArgument) {
        storedName = name
        storedIsField = isField
        storedValue = value
    }

    val MemberName: string => storedName
    val IsField: bool => storedIsField
    val TypedValue: CustomAttributeTypedArgument => storedValue
}

public class CustomAttributeData {
    private var storedType: TypeInfo
    private var storedConstructor: ConstructorInfo
    private var storedArguments: CustomAttributeTypedArgument[]
    private var storedNamedArguments: CustomAttributeNamedArgument[]

    private init(type: TypeInfo, constructor: ConstructorInfo, arguments: CustomAttributeTypedArgument[], namedArguments: CustomAttributeNamedArgument[]) {
        storedType = type
        storedConstructor = constructor
        storedArguments = arguments
        storedNamedArguments = namedArguments
    }

    val AttributeType: TypeInfo => storedType
    val Constructor: ConstructorInfo => storedConstructor

    func GetConstructorArguments() -> Sequence<CustomAttributeTypedArgument> {
        let result = CheckedStorage.Reserve<CustomAttributeTypedArgument>(storedArguments.Length)
        var index = 0
        while index < storedArguments.Length {
            result[index] = storedArguments[index]
            index += 1
        }
        return result
    }

    func GetNamedArguments() -> Sequence<CustomAttributeNamedArgument> {
        let result = CheckedStorage.Reserve<CustomAttributeNamedArgument>(storedNamedArguments.Length)
        var index = 0
        while index < storedNamedArguments.Length {
            result[index] = storedNamedArguments[index]
            index += 1
        }
        return result
    }
}

/// A structural union, accepting any one of its constituent types.
public sealed interface UnionTypeInfo : TypeInfo {
    /// Direct constituent types in normalized signature order.
    val Types: Sequence<TypeInfo> { get }
}

/// A structural intersection, requiring all of its constituent types.
public sealed interface IntersectionTypeInfo : TypeInfo {
    /// Direct constituent types in normalized signature order.
    val Types: Sequence<TypeInfo> { get }
}

internal class RuntimeUnionTypeInfo : RuntimeTypeInfo, UnionTypeInfo {
    private init(handle: RuntimeTypeHandle): base(handle) { }

    internal static func Create(handle: RuntimeTypeHandle) -> TypeInfo {
        return RuntimeUnionTypeInfo(handle)
    }

    val Types: Sequence<TypeInfo> => neoCLR.Runtime.TypeConstituents(ExecutionHandle)
}

internal class RuntimeIntersectionTypeInfo : RuntimeTypeInfo, IntersectionTypeInfo {
    private init(handle: RuntimeTypeHandle): base(handle) { }

    internal static func Create(handle: RuntimeTypeHandle) -> TypeInfo {
        return RuntimeIntersectionTypeInfo(handle)
    }

    val Types: Sequence<TypeInfo> => neoCLR.Runtime.TypeConstituents(ExecutionHandle)
}

/// A structural value tuple with ordered element types and no nominal definition.
public sealed interface TupleTypeInfo : TypeInfo {
    /// Element types in positional order, preserving duplicates and nested tuples.
    val ElementTypes: Sequence<TypeInfo> { get }
    /// Effective element names in positional order; unnamed positions use ItemN.
    val ElementNames: Sequence<string> { get }
}

internal class RuntimeTupleTypeInfo : RuntimeTypeInfo, TupleTypeInfo {
    private init(handle: RuntimeTypeHandle): base(handle) { }

    internal static func Create(handle: RuntimeTypeHandle) -> TypeInfo {
        return RuntimeTupleTypeInfo(handle)
    }

    val ElementTypes: Sequence<TypeInfo> => neoCLR.Runtime.TypeTupleElements(ExecutionHandle)
    val ElementNames: Sequence<string> => neoCLR.Runtime.TypeTupleNames(ExecutionHandle)
}

public sealed interface FunctionTypeInfo : TypeInfo {
    val Parameters: Sequence<ParameterInfo> { get }
    val ReturnType: TypeInfo { get }
    val InvokeMethod: MethodInfo { get }
}

internal class RuntimeFunctionTypeInfo : FunctionTypeInfo {
    private field Handle: RuntimeTypeHandle

    internal val ExecutionHandle: RuntimeTypeHandle => Handle

    private init(handle: RuntimeTypeHandle) {
        Handle = handle
    }

    internal static func FromHandle(handle: RuntimeTypeHandle) -> TypeInfo {
        return RuntimeFunctionTypeInfo(handle)
    }

    val InvokeMethod: MethodInfo {
        get {
            let methods = neoCLR.Runtime.TypeMethods(Handle, 28)
            return methods[0]
        }
    }

    val Parameters: Sequence<ParameterInfo> {
        get {
            let invoke = InvokeMethod
            return invoke.GetParameters()
        }
    }

    val ReturnType: TypeInfo {
        get {
            let invoke = InvokeMethod
            return invoke.ReturnType
        }
    }

    func AssignableTo(target: TypeInfo) -> bool {
        return TypeRelationships.Assignable(self, target)
    }

    func AssignableFrom(source: TypeInfo) -> bool {
        return TypeRelationships.Assignable(source, self)
    }

    func IsSubclassOf(target: TypeInfo) -> bool {
        return TypeRelationships.Subclass(self, target)
    }

    func IsInstanceOfType(value: Object?) -> bool {
        if value is Object instance {
            return TypeRelationships.Assignable(instance.GetType(), self)
        }
        return false
    }

    val BaseType: Optional<TypeInfo> => neoCLR.Runtime.TypeBaseType(Handle)

    func GetInterfaces() -> Sequence<TypeInfo> {
        return neoCLR.Runtime.TypeInterfaces(Handle)
    }

    func GetEnumValues() -> Sequence<Object> {
        return neoCLR.Runtime.TypeEnumValues(Handle)
    }

    func GetEnumNames() -> Sequence<string> {
        return neoCLR.Runtime.TypeEnumNames(Handle)
    }

    func GetEnumUnderlyingType() -> TypeInfo {
        return neoCLR.Runtime.TypeEnumUnderlying(Handle)
    }

    func GetFields() -> Sequence<FieldInfo> {
        return neoCLR.Runtime.TypeFields(Handle, 28)
    }

    func GetFields(flags: BindingFlags) -> Sequence<FieldInfo> {
        return neoCLR.Runtime.TypeFields(Handle, (int)flags)
    }

    func GetConstructors() -> Sequence<ConstructorInfo> {
        return neoCLR.Runtime.TypeConstructors(Handle, 20)
    }

    func GetConstructors(flags: BindingFlags) -> Sequence<ConstructorInfo> {
        return neoCLR.Runtime.TypeConstructors(Handle, (int)flags)
    }

    func GetMethods() -> Sequence<MethodInfo> {
        return neoCLR.Runtime.TypeMethods(Handle, 28)
    }

    func GetMethods(flags: BindingFlags) -> Sequence<MethodInfo> {
        return neoCLR.Runtime.TypeMethods(Handle, (int)flags)
    }

    func GetProperties() -> Sequence<PropertyInfo> {
        return neoCLR.Runtime.TypeProperties(Handle, 28)
    }

    func GetProperties(flags: BindingFlags) -> Sequence<PropertyInfo> {
        return neoCLR.Runtime.TypeProperties(Handle, (int)flags)
    }
    val DisplayName: string => neoCLR.Runtime.TypeDisplayName(Handle, 0)
    val IsNominalType: bool => neoCLR.Runtime.TypeShape(Handle, 12)
    val IsFunctionType: bool => neoCLR.Runtime.TypeShape(Handle, 13)
    val IsGenericType: bool => neoCLR.Runtime.TypeShape(Handle, 21)
    val IsGenericTypeDefinition: bool => neoCLR.Runtime.TypeShape(Handle, 22)
    val IsConstructedGenericType: bool => neoCLR.Runtime.TypeShape(Handle, 23)
    val IsGenericParameter: bool => neoCLR.Runtime.TypeShape(Handle, 17)
    val ContainsGenericParameters: bool => neoCLR.Runtime.TypeShape(Handle, 24)
    val GenericArgumentCount: int => neoCLR.Runtime.TypeArgumentCount(Handle)

    func MakeGenericType(arguments: Sequence<TypeInfo>) -> Result<TypeInfo, GenericTypeError> {
        return RuntimeTypeInfo.ConstructGeneric(Handle, arguments)
    }

    func MakeArrayType() -> TypeInfo {
        return RuntimeTypeInfo.FromHandle(neoCLR.Runtime.TypeMakeArray(Handle))
    }

    func GetGenericTypeDefinition() -> TypeInfo {
        return RuntimeTypeInfo.FromHandle(neoCLR.Runtime.TypeGenericDefinition(Handle))
    }

    func GetGenericArgument(index: int) -> TypeInfo {
        return RuntimeTypeInfo.FromHandle(neoCLR.Runtime.TypeArgument(Handle, index))
    }

    func Equals(other: TypeInfo) -> bool {
        if other is RuntimeTypeInfo implementation {
            return neoCLR.Runtime.TypeEquals(Handle, implementation.ExecutionHandle)
        }
        if other is RuntimeNominalTypeInfo nominal {
            return neoCLR.Runtime.TypeEquals(Handle, nominal.ExecutionHandle)
        }
        if other is RuntimeFunctionTypeInfo functionType {
            return neoCLR.Runtime.TypeEquals(Handle, functionType.ExecutionHandle)
        }
        return false
    }

    override func Equals(other: Object?) -> bool {
        if other is TypeInfo info {
            return Equals(info)
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(DisplayName)
        return hash.ToHashCode()
    }

    override func ToString() -> string => DisplayName

    val IsArray: bool => neoCLR.Runtime.TypeShape(Handle, 0)
    val IsByRef: bool => neoCLR.Runtime.TypeShape(Handle, 1)
    val IsPointer: bool => neoCLR.Runtime.TypeShape(Handle, 2)
    val IsInterface: bool => neoCLR.Runtime.TypeShape(Handle, 3)
    val IsReadOnly: bool => neoCLR.Runtime.TypeShape(Handle, 4)
    val IsAbstract: bool => neoCLR.Runtime.TypeShape(Handle, 5)
    val IsOpen: bool => neoCLR.Runtime.TypeShape(Handle, 8)
    val IsClosedHierarchy: bool => neoCLR.Runtime.TypeShape(Handle, 9)
