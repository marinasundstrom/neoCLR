module System.Introspection

import System.*
import System.Collections.*
import System.Optional.*
import System.Result.*
import System.Runtime.CompilerServices.*

public sealed interface MemberInfo {
    func GetCustomAttributesData() -> Sequence<CustomAttributeData>
    val MetadataToken: Optional<int> { get }
    val Module: Optional<ModuleInfo> { get }
    val Name: string { get }
    val DeclaringType: Optional<TypeInfo> { get }
}

public sealed interface FieldInfo : MemberInfo {
    /// True for storage assignable only during its owning initialization.
    val IsInitOnly: bool { get }
    /// True for a storage-free constant declaration.
    val IsLiteral: bool { get }
    /// The declared constant, without executing initialization; None for storage fields.
    val ConstantValue: Optional<Object> { get }
    val FieldType: TypeInfo { get }
    val IsPublic: bool { get }
    val IsPrivate: bool { get }
    val IsAssembly: bool { get }
    val IsStatic: bool { get }
    val DefinitionIndex: int { get }
}

public sealed interface MethodInfo : MemberInfo {
    /// True for a generic method definition or a constructed generic method.
    val IsGenericMethod: bool { get }
    /// True when the method's own generic arguments remain its declared parameters.
    val IsGenericMethodDefinition: bool { get }
    /// True when this method or its declaring type contains unbound parameters.
    val ContainsGenericParameters: bool { get }
    val ReturnType: TypeInfo { get }
    val IsStatic: bool { get }
    val IsPublic: bool { get }
    val IsPrivate: bool { get }
    val IsAssembly: bool { get }
    val IsReceiverByRef: bool { get }
    val DefinitionIndex: Optional<int> { get }
    func GetParameters() -> Sequence<ParameterInfo>
    val IsReadOnly: bool { get }
    val IsVirtual: bool { get }
    val IsOverride: bool { get }
    val IsAbstract: bool { get }
}

public sealed interface ConstructorInfo : MemberInfo {
    val IsStatic: bool { get }
    val IsPublic: bool { get }
    val IsPrivate: bool { get }
    val IsAssembly: bool { get }
    val DefinitionIndex: int { get }
    func GetParameters() -> Sequence<ParameterInfo>
}

public sealed interface PropertyInfo : MemberInfo {
    val PropertyType: TypeInfo { get }
    val IsStatic: bool { get }
    val CanRead: bool { get }
    val CanWrite: bool { get }
    val DefinitionIndex: int { get }
    func GetIndexParameters() -> Sequence<ParameterInfo>
    func GetGetMethod() -> Optional<MethodInfo>
    func GetGetMethod(arg0: bool) -> Optional<MethodInfo>
    func GetSetMethod() -> Optional<MethodInfo>
    func GetSetMethod(arg0: bool) -> Optional<MethodInfo>
}

internal sealed class RuntimeMemberInfo {
    private field StoredName: string
    private field StoredDeclaringType: TypeInfo?
    private field StoredMetadataToken: int
    private field StoredModule: Optional<ModuleInfo>

    protected init(name: string, declaringType: TypeInfo, metadataToken: int) {
        StoredName = name
        StoredDeclaringType = declaringType
        StoredMetadataToken = metadataToken
        StoredModule = None
    }

    func GetCustomAttributesData() -> Sequence<CustomAttributeData> {
        if StoredDeclaringType is NominalTypeInfo nominal {
            return neoCLR.Runtime.MemberCustomAttributes(nominal, StoredMetadataToken)
        }
        if let Some(owner) = StoredModule {
            return neoCLR.Runtime.ModuleMemberCustomAttributes(owner.Assembly.FullName, owner.Name, StoredMetadataToken)
        }
        return CheckedStorage.Reserve<CustomAttributeData>(0)
    }

    val MetadataToken: Optional<int> => if StoredMetadataToken == 0 { None } else { Some(StoredMetadataToken) }
    val Module: Optional<ModuleInfo> {
        get {
            if let Some(module) = StoredModule {
                return Some(module)
            }
            if StoredMetadataToken == 0 {
                return None
            }
            if StoredDeclaringType is NominalTypeInfo nominal {
                if let Some(module) = nominal.Module {
                    return Some(module)
                }
            }
            return None
        }
    }
    val Name: string => StoredName
    val DeclaringType: Optional<TypeInfo> {
        get {
            if StoredDeclaringType is TypeInfo owner {
                return Some(owner)
            }
            return None
        }
    }

    override func ToString() -> string => Name
}

internal class RuntimeFieldInfo : RuntimeMemberInfo, FieldInfo {
    val IsInitOnly: bool => StoredIsInitOnly
    val IsLiteral: bool => StoredIsLiteral
    val ConstantValue: Optional<Object> {
        get {
            if StoredConstantValue is Object value { return Some(value) }
            return None
        }
    }
    private field StoredFieldType: TypeInfo
    private field StoredIsPublic: bool
    private field StoredIsPrivate: bool
    private field StoredIsAssembly: bool
    private field StoredIsStatic: bool
    private field StoredDefinitionIndex: int
    private val StoredIsInitOnly: bool
    private val StoredIsLiteral: bool
    private val StoredConstantValue: Object?

    private init(
        name: string, declaringType: TypeInfo, metadataToken: int,
        fieldType: TypeInfo, isPublic: bool,
        isPrivate: bool, isAssembly: bool,
        isStatic: bool, definitionIndex: int, isInitOnly: bool, isLiteral: bool, constantValue: Object?): base(name, declaringType, metadataToken) {
        StoredIsInitOnly = isInitOnly
        StoredIsLiteral = isLiteral
        StoredConstantValue = constantValue
        StoredFieldType = fieldType
        StoredIsPublic = isPublic
        StoredIsPrivate = isPrivate
        StoredIsAssembly = isAssembly
        StoredIsStatic = isStatic
        StoredDefinitionIndex = definitionIndex
    }

    val FieldType: TypeInfo => StoredFieldType
    val IsPublic: bool => StoredIsPublic
    val IsPrivate: bool => StoredIsPrivate
    val IsAssembly: bool => StoredIsAssembly
    val IsStatic: bool => StoredIsStatic
    val DefinitionIndex: int => StoredDefinitionIndex

    override func Equals(other: Object?) -> bool {
        if other is RuntimeFieldInfo implementation {
            if let Some(owner) = DeclaringType {
                if let Some(otherOwner) = implementation.DeclaringType {
                    return owner.Equals(otherOwner) && DefinitionIndex == implementation.DefinitionIndex
                }
            }
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(1)
        if let Some(owner) = DeclaringType {
            hash.Add(owner.DisplayName)
        }
        hash.Add(DefinitionIndex)
        return hash.ToHashCode()
    }

}

internal class RuntimeMethodInfo : RuntimeMemberInfo, MethodInfo {
    private field StoredReturnType: TypeInfo
    private field StoredIsStatic: bool
    private field StoredIsPublic: bool
    private field StoredIsPrivate: bool
    private field StoredIsAssembly: bool
    private field StoredIsReceiverByRef: bool
    private field StoredDefinitionIndex: int
    private field StoredParameters: ParameterSnapshot
    private field StoredIsReadOnly: bool
    private field StoredIsVirtual: bool
    private field StoredIsOverride: bool
    private field StoredIsAbstract: bool
    private val StoredIsGenericMethod: bool
    private val StoredIsGenericMethodDefinition: bool
    private val StoredContainsGenericParameters: bool
    private field StoredIdentity: string

    private init(
        name: string, declaringType: TypeInfo, metadataToken: int,
        returnType: TypeInfo, isStatic: bool,
        isPublic: bool, isPrivate: bool,
        isAssembly: bool, isReceiverByRef: bool,
        definitionIndex: int, parameters: ParameterSnapshot,
        isReadOnly: bool, isVirtual: bool,
        isOverride: bool, isAbstract: bool,
        isGenericMethod: bool, isGenericMethodDefinition: bool, containsGenericParameters: bool): base(name, declaringType, metadataToken) {
        StoredReturnType = returnType
        StoredIsStatic = isStatic
        StoredIsPublic = isPublic
        StoredIsPrivate = isPrivate
        StoredIsAssembly = isAssembly
        StoredIsReceiverByRef = isReceiverByRef
        StoredDefinitionIndex = definitionIndex
        StoredParameters = parameters
        StoredIsReadOnly = isReadOnly
        StoredIsVirtual = isVirtual
        StoredIsOverride = isOverride
        StoredIsAbstract = isAbstract
        StoredIsGenericMethod = isGenericMethod
        StoredIsGenericMethodDefinition = isGenericMethodDefinition
        StoredContainsGenericParameters = containsGenericParameters
        StoredIdentity = ""
    }

    val IsGenericMethod: bool => StoredIsGenericMethod
    val IsGenericMethodDefinition: bool => StoredIsGenericMethodDefinition
    val ContainsGenericParameters: bool => StoredContainsGenericParameters
    val ReturnType: TypeInfo => StoredReturnType
    val IsStatic: bool => StoredIsStatic
    val IsPublic: bool => StoredIsPublic
    val IsPrivate: bool => StoredIsPrivate
    val IsAssembly: bool => StoredIsAssembly
    val IsReceiverByRef: bool => StoredIsReceiverByRef
    val DefinitionIndex: Optional<int> => if StoredDefinitionIndex < 0 { None } else { Some(StoredDefinitionIndex) }

    func GetParameters() -> Sequence<ParameterInfo> {
        let count = StoredParameters.Length
        let result = CheckedStorage.Reserve<ParameterInfo>(count)
        var index = 0
        while index < count {
            result[index] = StoredParameters.Get(index)
            index += 1
        }
        return result
    }
    val IsReadOnly: bool => StoredIsReadOnly
    val IsVirtual: bool => StoredIsVirtual
    val IsOverride: bool => StoredIsOverride
    val IsAbstract: bool => StoredIsAbstract

    override func Equals(other: Object?) -> bool {
        if other is RuntimeMethodInfo implementation {
            return String.CompareOrdinal(StoredIdentity, implementation.StoredIdentity) == 0
        }
        return false
    }

    override func GetHashCode() -> int => neoCLR.Runtime.StringHashOrdinal(StoredIdentity)

}

internal class RuntimeConstructorInfo : RuntimeMemberInfo, ConstructorInfo {
    private field StoredReturnType: TypeInfo
    private field StoredIsStatic: bool
    private field StoredIsPublic: bool
    private field StoredIsPrivate: bool
    private field StoredIsAssembly: bool
    private field StoredIsReceiverByRef: bool
    private field StoredDefinitionIndex: int
    private field StoredParameters: ParameterSnapshot
    private field StoredIsReadOnly: bool
    private field StoredIsVirtual: bool
    private field StoredIsOverride: bool
    private field StoredIsAbstract: bool

    private init(
        name: string, declaringType: TypeInfo, metadataToken: int,
        returnType: TypeInfo, isStatic: bool,
        isPublic: bool, isPrivate: bool,
        isAssembly: bool, isReceiverByRef: bool,
        definitionIndex: int, parameters: ParameterSnapshot,
        isReadOnly: bool, isVirtual: bool,
        isOverride: bool, isAbstract: bool): base(name, declaringType, metadataToken) {
        StoredReturnType = returnType
        StoredIsStatic = isStatic
        StoredIsPublic = isPublic
        StoredIsPrivate = isPrivate
        StoredIsAssembly = isAssembly
        StoredIsReceiverByRef = isReceiverByRef
        StoredDefinitionIndex = definitionIndex
        StoredParameters = parameters
        StoredIsReadOnly = isReadOnly
        StoredIsVirtual = isVirtual
        StoredIsOverride = isOverride
        StoredIsAbstract = isAbstract
    }

    val ReturnType: TypeInfo => StoredReturnType
    val IsStatic: bool => StoredIsStatic
    val IsPublic: bool => StoredIsPublic
    val IsPrivate: bool => StoredIsPrivate
    val IsAssembly: bool => StoredIsAssembly
    val IsReceiverByRef: bool => StoredIsReceiverByRef
    val DefinitionIndex: int => StoredDefinitionIndex

    func GetParameters() -> Sequence<ParameterInfo> {
        let count = StoredParameters.Length
        let result = CheckedStorage.Reserve<ParameterInfo>(count)
        var index = 0
        while index < count {
            result[index] = StoredParameters.Get(index)
            index += 1
        }
        return result
    }
    val IsReadOnly: bool => StoredIsReadOnly
    val IsVirtual: bool => StoredIsVirtual
    val IsOverride: bool => StoredIsOverride
    val IsAbstract: bool => StoredIsAbstract

    override func Equals(other: Object?) -> bool {
        if other is RuntimeConstructorInfo implementation {
            if let Some(owner) = DeclaringType {
                if let Some(otherOwner) = implementation.DeclaringType {
                    return owner.Equals(otherOwner) && DefinitionIndex == implementation.DefinitionIndex
                }
            }
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(2)
        if let Some(owner) = DeclaringType {
            hash.Add(owner.DisplayName)
        }
        hash.Add(DefinitionIndex)
        return hash.ToHashCode()
    }

}

internal class RuntimePropertyInfo : RuntimeMemberInfo, PropertyInfo {
    private field StoredPropertyType: TypeInfo
    private field StoredIsStatic: bool
    private field StoredCanRead: bool
    private field StoredCanWrite: bool
    private field StoredDefinitionIndex: int
    private field StoredIndexParameters: ParameterSnapshot
    private field StoredGetter: Optional<MethodInfo>
    private field StoredSetter: Optional<MethodInfo>

    private init(
        name: string, declaringType: TypeInfo, metadataToken: int,
        propertyType: TypeInfo, isStatic: bool,
        canRead: bool, canWrite: bool,
        definitionIndex: int, indexParameters: ParameterSnapshot,
        getter: Optional<MethodInfo>, setter: Optional<MethodInfo>): base(name, declaringType, metadataToken) {
        StoredPropertyType = propertyType
        StoredIsStatic = isStatic
        StoredCanRead = canRead
        StoredCanWrite = canWrite
        StoredDefinitionIndex = definitionIndex
        StoredIndexParameters = indexParameters
        StoredGetter = getter
        StoredSetter = setter
    }

    val PropertyType: TypeInfo => StoredPropertyType
    val IsStatic: bool => StoredIsStatic
    val CanRead: bool => StoredCanRead
    val CanWrite: bool => StoredCanWrite
    val DefinitionIndex: int => StoredDefinitionIndex

    func GetIndexParameters() -> Sequence<ParameterInfo> {
        let count = StoredIndexParameters.Length
        let result = CheckedStorage.Reserve<ParameterInfo>(count)
        var index = 0
        while index < count {
            result[index] = StoredIndexParameters.Get(index)
            index += 1
        }
        return result
    }

    func GetGetMethod() -> Optional<MethodInfo> {
        return GetGetMethod(false)
    }

    func GetGetMethod(arg0: bool) -> Optional<MethodInfo> {
        if StoredGetter is .Some(let method) {
            if arg0 || method.IsPublic {
                return Some(method)
            }
        }
        return None()
    }

    func GetSetMethod() -> Optional<MethodInfo> {
        return GetSetMethod(false)
    }

    func GetSetMethod(arg0: bool) -> Optional<MethodInfo> {
        if StoredSetter is .Some(let method) {
            if arg0 || method.IsPublic {
                return Some(method)
            }
        }
        return None()
    }

    override func Equals(other: Object?) -> bool {
        if other is RuntimePropertyInfo implementation {
            if let Some(owner) = DeclaringType {
                if let Some(otherOwner) = implementation.DeclaringType {
                    return owner.Equals(otherOwner) && DefinitionIndex == implementation.DefinitionIndex
                }
            }
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(3)
        if let Some(owner) = DeclaringType {
            hash.Add(owner.DisplayName)
        }
        hash.Add(DefinitionIndex)
        return hash.ToHashCode()
    }

}

public sealed interface NominalTypeInfo : TypeInfo, MemberInfo {
    /// Tests whether this declaration carries nominal union metadata.
    val IsUnionDeclaration: bool { get }
    val FullName: string { get }
    val Namespace: string { get }
}

/// Reasons a generic type cannot be constructed from the supplied arguments.
public enum GenericTypeError { InvalidDefinition, ArgumentCount, InvalidArgument, NotRetained }

public sealed interface TypeInfo : EquatableTo<TypeInfo> {
    val DisplayName: string { get }
    val IsNominalType: bool { get }
    val IsFunctionType: bool { get }
    /// True for a nominal generic definition or constructed nominal generic type.
    val IsGenericType: bool { get }
    /// True when this identity is the declaration with its own unbound parameters.
    val IsGenericTypeDefinition: bool { get }
    /// True for a constructed nominal generic identity, whether open or closed.
    val IsConstructedGenericType: bool { get }
    /// True when this identity is an unbound generic parameter.
    val IsGenericParameter: bool { get }
    /// Recursively tests unbound parameters, including element and structural types.
    val ContainsGenericParameters: bool { get }
    val GenericArgumentCount: int { get }
    func GetGenericArgument(index: int) -> TypeInfo
    /// Returns the source declaration for this nominal generic type; faults for nongeneric types.
    func GetGenericTypeDefinition() -> TypeInfo
    /// Constructs a closed nominal identity; native execution requires its retention.
    func MakeGenericType(arguments: Sequence<TypeInfo>) -> Result<TypeInfo, GenericTypeError>
    /// Returns the zero-based vector type with this element type, without allocating an array.
    /// Invalid elements and unavailable native array shapes cause a runtime fault.
    func MakeArrayType() -> TypeInfo
    func Equals(other: TypeInfo) -> bool
    /// Returns whether this type can be assigned to a variable of target's type.
    func AssignableTo(target: TypeInfo) -> bool
    /// Returns whether source can be assigned to a variable of this type.
    func AssignableFrom(source: TypeInfo) -> bool
    /// Returns whether this type strictly derives from target; interfaces are excluded.
    func IsSubclassOf(target: TypeInfo) -> bool
    /// Returns whether a non-null value can be assigned to a variable of this type.
    func IsInstanceOfType(value: Object?) -> bool
    val IsArray: bool { get }
    val IsByRef: bool { get }
    val IsPointer: bool { get }
    val IsInterface: bool { get }
    val IsReadOnly: bool { get }
    val IsAbstract: bool { get }
    val IsOpen: bool { get }
    val IsClosedHierarchy: bool { get }
    val IsUnion: bool { get }
    val IsEnum: bool { get }
    val IsValueType: bool { get }
    val IsVisible: bool { get }
    /// Whether initialization uses relaxed first-static-field-access timing.
    val IsBeforeFieldInit: bool { get }
    /// Describes the runtime-owned initializer without executing it.
    val TypeInitializer: Optional<ConstructorInfo> { get }
    func GetGenericArguments() -> Sequence<TypeInfo>
    func GetElementType() -> Optional<TypeInfo>

    val BaseType: Optional<TypeInfo> { get }
    func GetInterfaces() -> Sequence<TypeInfo>
    func GetEnumValues() -> Sequence<Object>
    func GetEnumNames() -> Sequence<string>
    func GetEnumUnderlyingType() -> TypeInfo
    func GetFields() -> Sequence<FieldInfo>
    func GetFields(flags: BindingFlags) -> Sequence<FieldInfo>
    func GetConstructors() -> Sequence<ConstructorInfo>
    func GetConstructors(flags: BindingFlags) -> Sequence<ConstructorInfo>
    /// <summary>Describes declared methods, including generic definitions and open owner signatures.</summary>
    /// <remarks>Native discovery requires explicit methodTypes retention; it describes the definition and closed owner tokens present in the compiled program, without granting invocation.</remarks>
    func GetMethods() -> Sequence<MethodInfo>
    func GetMethods(flags: BindingFlags) -> Sequence<MethodInfo>
    func GetProperties() -> Sequence<PropertyInfo>
    func GetProperties(flags: BindingFlags) -> Sequence<PropertyInfo>
}

internal open class RuntimeTypeInfo : TypeInfo {
    private field Handle: RuntimeTypeHandle

    internal val ExecutionHandle: RuntimeTypeHandle => Handle

    protected init(handle: RuntimeTypeHandle) {
        Handle = handle
    }

    internal static func GenericArgumentsFromHandle(handle: RuntimeTypeHandle) -> Sequence<TypeInfo> {
        let count = neoCLR.Runtime.TypeArgumentCount(handle)
        let result = CheckedStorage.Reserve<TypeInfo>(count)
        var index = 0
        while index < count {
            result[index] = FromHandle(neoCLR.Runtime.TypeArgument(handle, index))
            index += 1
        }
        return result
    }

    internal static func HandleOf(type: TypeInfo) -> RuntimeTypeHandle {
        if type is RuntimeTypeInfo value { return value.ExecutionHandle }
        if type is RuntimeNominalTypeInfo value { return value.ExecutionHandle }
        if type is RuntimeFunctionTypeInfo value { return value.ExecutionHandle }
        System.Fail("Invalid TypeInfo implementation")
        return ((RuntimeNominalTypeInfo)typeof(Object)).ExecutionHandle
    }

    internal static func ConstructGeneric(handle: RuntimeTypeHandle, arguments: Sequence<TypeInfo>) -> Result<TypeInfo, GenericTypeError> {
        if !neoCLR.Runtime.TypeShape(handle, 22) { return Failure(GenericTypeError.InvalidDefinition) }
        if neoCLR.Runtime.TypeArgumentCount(handle) != arguments.Count { return Failure(GenericTypeError.ArgumentCount) }
        var bound = handle
        for index in 0..arguments.Count {
            let argument = HandleOf(arguments[index])
            let status = neoCLR.Runtime.TypeApplyGenericArgumentCheck(bound, index, argument)
            if status == 2 { return Failure(GenericTypeError.NotRetained) }
            if status != 0 { return Failure(GenericTypeError.InvalidArgument) }
            bound = neoCLR.Runtime.TypeApplyGenericArgument(bound, index, argument)
        }
        return Ok(FromHandle(bound))
    }

    internal static func FromHandle(handle: RuntimeTypeHandle) -> TypeInfo {
        if neoCLR.Runtime.TypeShape(handle, 17) {
            return RuntimeGenericParameterTypeInfo.Create(handle)
        }
        if neoCLR.Runtime.TypeShape(handle, 12) {
            return RuntimeNominalTypeInfo.FromHandle(handle)
        }
        if neoCLR.Runtime.TypeShape(handle, 13) {
            return RuntimeFunctionTypeInfo.FromHandle(handle)
        }
        if neoCLR.Runtime.TypeShape(handle, 14) {
            return RuntimeUnionTypeInfo.Create(handle)
        }
        if neoCLR.Runtime.TypeShape(handle, 15) {
            return RuntimeIntersectionTypeInfo.Create(handle)
        }
        if neoCLR.Runtime.TypeShape(handle, 16) {
            return RuntimeTupleTypeInfo.Create(handle)
        }
        return RuntimeTypeInfo(handle)
    }

    func AssignableTo(target: TypeInfo) -> bool {
        return TypeRelationships.Assignable(self, target)
    }

    func AssignableFrom(source: TypeInfo) -> bool {
        return TypeRelationships.Assignable(source, self)
    }

    func IsSubclassOf(target: TypeInfo) -> bool {
        return TypeRelationships.Subclass(self, target)
    }

    func IsInstanceOfType(value: Object?) -> bool {
        if value is Object instance {
            return TypeRelationships.Assignable(instance.GetType(), self)
        }
        return false
    }

    val BaseType: Optional<TypeInfo> => neoCLR.Runtime.TypeBaseType(Handle)

    func GetInterfaces() -> Sequence<TypeInfo> {
        return neoCLR.Runtime.TypeInterfaces(Handle)
    }

    func GetEnumValues() -> Sequence<Object> {
        return neoCLR.Runtime.TypeEnumValues(Handle)
    }

    func GetEnumNames() -> Sequence<string> {
        return neoCLR.Runtime.TypeEnumNames(Handle)
    }

    func GetEnumUnderlyingType() -> TypeInfo {
        return neoCLR.Runtime.TypeEnumUnderlying(Handle)
    }

    func GetFields() -> Sequence<FieldInfo> {
        return neoCLR.Runtime.TypeFields(Handle, 28)
    }

    func GetFields(flags: BindingFlags) -> Sequence<FieldInfo> {
        return neoCLR.Runtime.TypeFields(Handle, (int)flags)
    }

    func GetConstructors() -> Sequence<ConstructorInfo> {
        return neoCLR.Runtime.TypeConstructors(Handle, 20)
    }

    func GetConstructors(flags: BindingFlags) -> Sequence<ConstructorInfo> {
        return neoCLR.Runtime.TypeConstructors(Handle, (int)flags)
    }

    func GetMethods() -> Sequence<MethodInfo> {
        return neoCLR.Runtime.TypeMethods(Handle, 28)
    }

    func GetMethods(flags: BindingFlags) -> Sequence<MethodInfo> {
        return neoCLR.Runtime.TypeMethods(Handle, (int)flags)
    }

    func GetProperties() -> Sequence<PropertyInfo> {
        return neoCLR.Runtime.TypeProperties(Handle, 28)
    }

    func GetProperties(flags: BindingFlags) -> Sequence<PropertyInfo> {
        return neoCLR.Runtime.TypeProperties(Handle, (int)flags)
    }
    val DisplayName: string => neoCLR.Runtime.TypeDisplayName(Handle, 0)
    val IsNominalType: bool => neoCLR.Runtime.TypeShape(Handle, 12)
    val IsFunctionType: bool => neoCLR.Runtime.TypeShape(Handle, 13)
    val IsGenericType: bool => neoCLR.Runtime.TypeShape(Handle, 21)
    val IsGenericTypeDefinition: bool => neoCLR.Runtime.TypeShape(Handle, 22)
    val IsConstructedGenericType: bool => neoCLR.Runtime.TypeShape(Handle, 23)
    val IsGenericParameter: bool => neoCLR.Runtime.TypeShape(Handle, 17)
    val ContainsGenericParameters: bool => neoCLR.Runtime.TypeShape(Handle, 24)
    val GenericArgumentCount: int => neoCLR.Runtime.TypeArgumentCount(Handle)

    func MakeGenericType(arguments: Sequence<TypeInfo>) -> Result<TypeInfo, GenericTypeError> {
        return RuntimeTypeInfo.ConstructGeneric(Handle, arguments)
    }

    func MakeArrayType() -> TypeInfo {
        return RuntimeTypeInfo.FromHandle(neoCLR.Runtime.TypeMakeArray(Handle))
    }

    func GetGenericTypeDefinition() -> TypeInfo {
        return RuntimeTypeInfo.FromHandle(neoCLR.Runtime.TypeGenericDefinition(Handle))
    }

    func GetGenericArgument(index: int) -> TypeInfo {
        return RuntimeTypeInfo.FromHandle(neoCLR.Runtime.TypeArgument(Handle, index))
    }

    func Equals(other: TypeInfo) -> bool {
        if other is RuntimeTypeInfo implementation {
            return neoCLR.Runtime.TypeEquals(Handle, implementation.ExecutionHandle)
        }
        if other is RuntimeNominalTypeInfo nominal {
            return neoCLR.Runtime.TypeEquals(Handle, nominal.ExecutionHandle)
        }
        if other is RuntimeFunctionTypeInfo functionType {
            return neoCLR.Runtime.TypeEquals(Handle, functionType.ExecutionHandle)
        }
        return false
    }

    override func Equals(other: Object?) -> bool {
        if other is TypeInfo info {
            return Equals(info)
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(DisplayName)
        return hash.ToHashCode()
    }

    override func ToString() -> string => DisplayName

    val IsArray: bool => neoCLR.Runtime.TypeShape(Handle, 0)
    val IsByRef: bool => neoCLR.Runtime.TypeShape(Handle, 1)
    val IsPointer: bool => neoCLR.Runtime.TypeShape(Handle, 2)
    val IsInterface: bool => neoCLR.Runtime.TypeShape(Handle, 3)
    val IsReadOnly: bool => neoCLR.Runtime.TypeShape(Handle, 4)
    val IsAbstract: bool => neoCLR.Runtime.TypeShape(Handle, 5)
    val IsOpen: bool => neoCLR.Runtime.TypeShape(Handle, 8)
    val IsClosedHierarchy: bool => neoCLR.Runtime.TypeShape(Handle, 9)
    val IsUnion: bool => neoCLR.Runtime.TypeShape(Handle, 14)
    val IsEnum: bool => neoCLR.Runtime.TypeShape(Handle, 6)
    val IsValueType: bool => neoCLR.Runtime.TypeShape(Handle, 7)
    val IsVisible: bool => neoCLR.Runtime.TypeShape(Handle, 11)
    val IsBeforeFieldInit: bool => neoCLR.Runtime.TypeShape(Handle, 20)
    val TypeInitializer: Optional<ConstructorInfo> {
        get {
            if !IsNominalType {
                return None
            }
            for constructor in GetConstructors(BindingFlags.Static | BindingFlags.NonPublic) {
                if constructor.IsStatic { return Some(constructor) }
            }
            return None
        }
    }


    func GetGenericArguments() -> Sequence<TypeInfo> {
        return RuntimeTypeInfo.GenericArgumentsFromHandle(Handle)
    }

    func GetElementType() -> Optional<TypeInfo> {
        return neoCLR.Runtime.TypeElementType(Handle)
    }
}

internal class RuntimeNominalTypeInfo : NominalTypeInfo {
    func GetCustomAttributesData() -> Sequence<CustomAttributeData> {
        return neoCLR.Runtime.MemberCustomAttributes(self, neoCLR.Runtime.TypeMetadataToken(Handle))
    }

    private field Handle: RuntimeTypeHandle

    internal val ExecutionHandle: RuntimeTypeHandle => Handle

    private init(handle: RuntimeTypeHandle) {
        Handle = handle
    }

    internal static func FromHandle(handle: RuntimeTypeHandle) -> TypeInfo {
        return RuntimeNominalTypeInfo(handle)
    }

    func AssignableTo(target: TypeInfo) -> bool {
        return TypeRelationships.Assignable(self, target)
    }

    func AssignableFrom(source: TypeInfo) -> bool {
        return TypeRelationships.Assignable(source, self)
    }

    func IsSubclassOf(target: TypeInfo) -> bool {
        return TypeRelationships.Subclass(self, target)
    }

    func IsInstanceOfType(value: Object?) -> bool {
        if value is Object instance {
            return TypeRelationships.Assignable(instance.GetType(), self)
        }
        return false
    }

    val BaseType: Optional<TypeInfo> => neoCLR.Runtime.TypeBaseType(Handle)

    func GetInterfaces() -> Sequence<TypeInfo> {
        return neoCLR.Runtime.TypeInterfaces(Handle)
    }

    func GetEnumValues() -> Sequence<Object> {
