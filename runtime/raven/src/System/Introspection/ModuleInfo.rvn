namespace System.Introspection

import System.*
import System.Collections.*
import System.Runtime.CompilerServices.*

public sealed interface ModuleInfo {
    val Name: string { get }
    val Assembly: AssemblyInfo { get }
    val MetadataToken: int { get }
    func GetTypes() -> Sequence<TypeInfo>
}

internal class RuntimeModuleInfo : ModuleInfo {
    private field StoredIdentity: string
    private field StoredName: string

    private init(identity: string, name: string) {
        StoredIdentity = identity
        StoredName = name
    }

    val Name: string => StoredName

    val Assembly: AssemblyInfo => RuntimeServices.ModuleAssembly(StoredIdentity, StoredName)

    val MetadataToken: int => RuntimeServices.ModuleMetadataToken(StoredIdentity, StoredName)

    func GetTypes() -> Sequence<TypeInfo> {
        return RuntimeServices.ModuleTypes(StoredIdentity, StoredName)
    }

    override func Equals(other: Object?) -> bool {
        if other is RuntimeModuleInfo implementation {
            return StoredIdentity == implementation.StoredIdentity && StoredName == implementation.StoredName
        }
        return false
    }

    override func GetHashCode() -> int {
        var hash = HashCode()
        hash.Add(StoredIdentity)
        hash.Add(StoredName)
        return hash.ToHashCode()
    }

    override func ToString() -> string => Name

}
