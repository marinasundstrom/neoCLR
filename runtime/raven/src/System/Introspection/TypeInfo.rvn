namespace System.Introspection

import System.*
import System.Runtime.CompilerServices.*

public sealed interface TypeInfo : Equatable<TypeInfo> {
    val Name: string { get }
    val FullName: string { get }
    val Namespace: string { get }
    val GenericArgumentCount: int { get }
    func GetGenericArgument(index: int) -> TypeInfo
    func Equals(other: TypeInfo) -> bool
    val IsArray: bool { get }
    val IsByRef: bool { get }
    val IsPointer: bool { get }
    val IsInterface: bool { get }
    val IsReadOnly: bool { get }
    val IsAbstract: bool { get }
    val IsEnum: bool { get }
    val IsValueType: bool { get }
    func GetGenericArguments() -> TypeInfo[]
    func GetElementType() -> Option<TypeInfo>

    val BaseType: Option<TypeInfo> { get }
    func GetInterfaces() -> TypeInfo[]
    func GetEnumNames() -> string[]
    func GetEnumUnderlyingType() -> TypeInfo
    func GetFields() -> FieldInfo[]
    func GetFields(flags: BindingFlags) -> FieldInfo[]
    func GetMethods() -> MethodInfo[]
    func GetMethods(flags: BindingFlags) -> MethodInfo[]
    func GetProperties() -> PropertyInfo[]
    func GetProperties(flags: BindingFlags) -> PropertyInfo[]
}

internal class RuntimeTypeInfo : TypeInfo {
    private field Handle: RuntimeTypeHandle

    private init(handle: RuntimeTypeHandle) {
        Handle = handle
    }

    internal static func FromHandle(handle: RuntimeTypeHandle) -> TypeInfo {
        return RuntimeTypeInfo(handle)
    }

    val BaseType: Option<TypeInfo> { get => RuntimeServices.TypeBaseType(Handle) }

    func GetInterfaces() -> TypeInfo[] {
        return RuntimeServices.TypeInterfaces(Handle)
    }

    func GetEnumNames() -> string[] {
        return RuntimeServices.TypeEnumNames(Handle)
    }

    func GetEnumUnderlyingType() -> TypeInfo {
        return RuntimeServices.TypeEnumUnderlying(Handle)
    }

    func GetFields() -> FieldInfo[] {
        return RuntimeServices.TypeFields(Handle, 28)
    }

    func GetFields(flags: BindingFlags) -> FieldInfo[] {
        return RuntimeServices.TypeFields(Handle, (int)flags)
    }

    func GetMethods() -> MethodInfo[] {
        return RuntimeServices.TypeMethods(Handle, 28)
    }

    func GetMethods(flags: BindingFlags) -> MethodInfo[] {
        return RuntimeServices.TypeMethods(Handle, (int)flags)
    }

    func GetProperties() -> PropertyInfo[] {
        return RuntimeServices.TypeProperties(Handle, 28)
    }

    func GetProperties(flags: BindingFlags) -> PropertyInfo[] {
        return RuntimeServices.TypeProperties(Handle, (int)flags)
    }
    val Name: string { get => RuntimeServices.TypeName(Handle) }
    val FullName: string { get => RuntimeServices.TypeDisplayName(Handle, 0) }
    val Namespace: string { get => RuntimeServices.TypeDisplayName(Handle, 1) }
    val GenericArgumentCount: int { get => RuntimeServices.TypeArgumentCount(Handle) }

    func GetGenericArgument(index: int) -> TypeInfo {
        return FromHandle(RuntimeServices.TypeArgument(Handle, index))
    }

    func Equals(other: TypeInfo) -> bool {
        val implementation = (RuntimeTypeInfo)other
        return RuntimeServices.TypeEquals(Handle, implementation.Handle)
    }

    val IsArray: bool { get => RuntimeServices.TypeShape(Handle, 0) }
    val IsByRef: bool { get => RuntimeServices.TypeShape(Handle, 1) }
    val IsPointer: bool { get => RuntimeServices.TypeShape(Handle, 2) }
    val IsInterface: bool { get => RuntimeServices.TypeShape(Handle, 3) }
    val IsReadOnly: bool { get => RuntimeServices.TypeShape(Handle, 4) }
    val IsAbstract: bool { get => RuntimeServices.TypeShape(Handle, 5) }
    val IsEnum: bool { get => RuntimeServices.TypeShape(Handle, 6) }
    val IsValueType: bool { get => RuntimeServices.TypeShape(Handle, 7) }


    func GetGenericArguments() -> TypeInfo[] {
        return RuntimeServices.TypeGenericArguments(Handle)
    }

    func GetElementType() -> Option<TypeInfo> {
        return RuntimeServices.TypeElementType(Handle)
    }
}
