namespace System

import System.*
import System.Option.*

public union Option<T>: Propagatable<Option<T>, T, System.Void> {
    /// Represents an available value.
    case Some(T)

    /// Represents the absence of a value.
    case None

    /// Attempts to extract the successful output used by the propagation protocol.
    func TryGetOutput(out output: T) -> bool {
        output = default
        if self is Some(let value) {
            output = value
            return true
        }
        return false
    }

    /// Reports absence as the unit residual used by the propagation protocol.
    func TryGetResidual(out residual: System.Void) -> bool {
        residual = ()
        self is None
    }

    /// Constructs an empty option from a propagated residual.
    static func FromResidual(residual: System.Void) -> Option<T> => None

}
