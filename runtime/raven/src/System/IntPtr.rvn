namespace System

import System.Runtime.CompilerServices.RuntimeServices

public struct IntPtr : Comparable<nint> {
    // The runtime supplies intrinsic native-width storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: nint

    func CompareTo(other: nint) -> int {
        let left = RuntimeServices.IntPtrToInt64(m_value)
        let right = RuntimeServices.IntPtrToInt64(other)
        if left < right {
            return -1
        }
        if left > right {
            return 1
        }
        return 0
    }
}
