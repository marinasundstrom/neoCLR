namespace System

import System.Runtime.CompilerServices.RuntimeServices

public struct Char : ComparableTo<char> {
    // Immutable grapheme storage is supplied by the runtime.
    #pragma warning disable-next-line RAV9032
    private field m_value: char

    static func FromString(text: string) -> char {
        return RuntimeServices.CharFromString(text)
    }

    func ToString() -> string {
        return RuntimeServices.CharText(m_value)
    }

    func Equals(other: char) -> bool {
        return RuntimeServices.StringEquals(RuntimeServices.CharText(m_value), RuntimeServices.CharText(other))
    }

    func CompareTo(other: char) -> int {
        return RuntimeServices.StringCompareOrdinal(RuntimeServices.CharText(m_value), RuntimeServices.CharText(other))
    }
}
