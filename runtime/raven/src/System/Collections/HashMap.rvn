module System.Collections

import System.Option.*

public class HashMap<K, V> : MutableMap<K, V> {
    // Explicit storage: the pinned compiler treats uninitialized private var as getter-only.
    private field comparer: EqualityComparer<K>
    private field buckets: int[]
    private field keys: ArrayList<K>
    private field values: ArrayList<V>
    private field hashes: ArrayList<int>
    private field next: ArrayList<int>
    private field busy: bool

    init(equal: (K, K) -> bool, hash: (K) -> int) {
        comparer = FunctionEqualityComparer<K>(equal, hash)
        buckets = [0, 0, 0, 0]
        keys = ArrayList<K>()
        values = ArrayList<V>()
        hashes = ArrayList<int>()
        next = ArrayList<int>()
        busy = false
    }

    init(comparer: EqualityComparer<K>) {
        self.comparer = comparer
        buckets = [0, 0, 0, 0]
        keys = ArrayList<K>()
        values = ArrayList<V>()
        hashes = ArrayList<int>()
        next = ArrayList<int>()
        busy = false
    }

    /// <summary>Copies pairs into independent storage using the supplied key policy.</summary>
    /// <param name="items">Pairs to enumerate once, including sequences, queries and existing maps.</param>
    /// <param name="comparer">Explicit stable key policy; never inferred from the source.</param>
    /// <remarks>Native development API. Shallow independent storage. Duplicate keys cause a terminal Fault after iterator disposal. Use TryAdd for recoverable duplicates. Provider/comparer Faults do not guarantee cleanup. No concurrent snapshot guarantee.</remarks>
    init(items: Iterable<KeyValuePair<K, V>>, comparer: EqualityComparer<K>) {
        self.comparer = comparer
        buckets = [0, 0, 0, 0]
        keys = ArrayList<K>()
        values = ArrayList<V>()
        hashes = ArrayList<int>()
        next = ArrayList<int>()
        busy = false
        CopyItems(items)
    }

    /// <summary>Copies pairs using explicit equality and hash callbacks.</summary>
    /// <param name="items">Pairs to enumerate once.</param>
    /// <param name="equal">Stable key equality callback.</param>
    /// <param name="hash">Stable hash callback; equal keys must have equal hashes.</param>
    /// <remarks>Native development API. Uses the same shallow-copy, terminal duplicate Fault and disposal contract as the comparer overload.</remarks>
    init(items: Iterable<KeyValuePair<K, V>>, equal: (K, K) -> bool, hash: (K) -> int) {
        comparer = FunctionEqualityComparer<K>(equal, hash)
        buckets = [0, 0, 0, 0]
        keys = ArrayList<K>()
        values = ArrayList<V>()
        hashes = ArrayList<int>()
        next = ArrayList<int>()
        busy = false
        CopyItems(items)
    }

    private func CopyItems(items: Iterable<KeyValuePair<K, V>>) {
        let iterator = items.GetIterator()
        while iterator.MoveNext() {
            let pair = iterator.Current
            if !TryAdd(pair.Key, pair.Value) {
                iterator.Dispose()
                System.Fail("HashMap input contains a duplicate key")
            }
        }
        iterator.Dispose()
    }

    val Count: int => keys.Count
    val Keys: Sequence<K> => keys.Copy()

    /// <summary>Returns a shallow snapshot of key/value pairs in unspecified order.</summary>
    func GetIterator() -> Iterator<KeyValuePair<K, V>> {
        Enter()
        let pairs = ArrayList<KeyValuePair<K, V>>(keys.Count)
        var index = 0
        while index < keys.Count {
            pairs.Add(KeyValuePair<K, V>(keys[index], values[index]))
            index = index + 1
        }
        Leave()
        return pairs.GetIterator()
    }

    private func Enter() {
        if busy {
            System.Fail("HashMap callbacks must not reenter the map")
        }
        busy = true
    }

    private func Leave() {
        busy = false
    }

    private func HashKey(key: K) -> int {
        return comparer.GetHashCode(key) & 2147483647
    }

    private func Locate(key: K, hash: int) -> int {
        var node = buckets[hash % buckets.Length]
        while node != 0 {
            let index = node - 1
            if hashes[index] == hash && comparer.Equals(keys[index], key) {
                return index
            }
            node = next[index]
        }
        return -1
    }

    func Find(key: K) -> System.Option<V> {
        Enter()
        let index = Locate(key, HashKey(key))
        Leave()
        if index < 0 {
            return None
        }
        return Some(values[index])
    }

    func ContainsKey(key: K) -> bool {
        Enter()
        let found = Locate(key, HashKey(key)) >= 0
        Leave()
        return found
    }

    private func Grow() {
        var size = buckets.Length
        if keys.Count < size {
            return
        }
        if size > 1073741823 {
            System.Fail("HashMap capacity overflow")
        }
        size = size * 2
        let expanded = System.Runtime.CompilerServices.CheckedStorage.Reserve<int>(size)
        var slot = 0
        while slot < size {
            expanded[slot] = 0
            slot = slot + 1
        }
        var index = 0
        while index < keys.Count {
            let bucket = hashes[index] % size
            next[index] = expanded[bucket]
            expanded[bucket] = index + 1
            index = index + 1
        }
        buckets = expanded
    }

    private func Append(key: K, value: V, hash: int) {
        Grow()
        let bucket = hash % buckets.Length
        keys.Add(key)
        values.Add(value)
        hashes.Add(hash)
        next.Add(buckets[bucket])
        buckets[bucket] = keys.Count
    }

    func TryAdd(key: K, value: V) -> bool {
        Enter()
        let code = HashKey(key)
        let index = Locate(key, code)
        if index >= 0 {
            Leave()
            return false
        }
        Append(key, value, code)
        Leave()
        return true
    }

    func Set(key: K, value: V) {
        Enter()
        let code = HashKey(key)
        let index = Locate(key, code)
        if index < 0 {
            Append(key, value, code)
        } else {
            values[index] = value
        }
        Leave()
    }
}
