module System

import System.Option.*
import System.Result.*

public class Array<T> : Collections.MutableSequence<T> {
    #pragma warning disable-next-line RAV9032
    private field m_value: T[]

    private init() {
    }

    static val Empty: T[] {
        get => Runtime.CompilerServices.CheckedStorage.Reserve<T>(0)
    }

    val Length: int => m_value.Length
    val Count: int => m_value.Length

    var self[index: int]: T {
        get => m_value[index]
        set { m_value[index] = value }
    }

    /// Returns the element, or None when index is outside this array.
    func Get(index: int) -> Option<T> {
        if index < 0 || index >= m_value.Length {
            return None
        }
        return Some(m_value[index])
    }

    /// Resolves a directional index and returns the element, or None when outside this array.
    func Get(index: Index) -> Option<T> => Get(index.GetOffset(m_value.Length))

    /// Borrows a checked range without copying; writes affect this array.
    func Slice(range: Range) -> Slice<T> => Runtime.CompilerServices.RuntimeHelpers.GetSlice<T>(m_value, range)

    /// Borrows a checked range without copying.
    val self[range: Range]: Slice<T> => Slice(range)

    func ForEach(action: (T) -> Void) {
        let buffer = m_value
        var index = 0
        while index < buffer.Length {
            action(buffer[index])
            index = index + 1
        }
    }

    func GetIterator() -> Collections.Iterator<T> {
        return ArrayIterator<T>(m_value)
    }
}

internal class ArrayIterator<T> : Collections.Iterator<T> {
    private field data: T[]
    private field position: int

    init(buffer: T[]) {
        data = buffer
        position = -1
    }

    func MoveNext() -> bool {
        if position >= data.Length {
            return false
        }
        position = position + 1
        return position < data.Length
    }

    val Current: T {
        get {
            if position < 0 || position >= data.Length {
                Fail("Iterator has no current element")
            }
            return data[position]
        }
    }

    func Dispose() {
        position = data.Length
    }
}
