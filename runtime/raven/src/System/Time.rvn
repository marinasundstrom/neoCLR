namespace System

import System.Result.*

public struct Time : ComparableTo<Time>, EquatableTo<Time> {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func Create(hour: int, minute: int, second: int) -> Result<Time, InvalidTimeError> {
        return Create(hour, minute, second, 0)
    }

    static func Create(hour: int, minute: int, second: int, fractionTicks: int) -> Result<Time, InvalidTimeError> {
        if hour < 0 {
            return Error(InvalidTimeError())
        }
        if hour > 23 {
            return Error(InvalidTimeError())
        }
        if minute < 0 {
            return Error(InvalidTimeError())
        }
        if minute > 59 {
            return Error(InvalidTimeError())
        }
        if second < 0 {
            return Error(InvalidTimeError())
        }
        if second > 59 {
            return Error(InvalidTimeError())
        }
        if fractionTicks < 0 {
            return Error(InvalidTimeError())
        }
        if fractionTicks > 9999999 {
            return Error(InvalidTimeError())
        }
        let seconds: long = (hour * 60 + minute) * 60 + second
        return Ok(Time(seconds * 10000000L + fractionTicks))
    }

    static func FromTicks(ticks: long) -> Result<Time, InvalidTimeError> {
        if ticks < 0L {
            return Error(InvalidTimeError())
        }
        if ticks > 863999999999L {
            return Error(InvalidTimeError())
        }
        return Ok(Time(ticks))
    }

    val Ticks: long => StoredTicks
    val Hour: int => (int)(StoredTicks / 36000000000L)
    val Minute: int => (int)(StoredTicks / 600000000L % 60L)
    val Second: int => (int)(StoredTicks / 10000000L % 60L)
    val Millisecond: int => (int)(StoredTicks / 10000L % 1000L)
    val FractionTicks: int => (int)(StoredTicks % 10000000L)

    func Equals(other: Time) -> bool {
        return StoredTicks == other.StoredTicks
    }

    func CompareTo(other: Time) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
}
