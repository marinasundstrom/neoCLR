namespace System

import System.Result.*

public struct Time : Comparable<Time>, Equatable<Time> {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func Create(arg0: int, arg1: int, arg2: int) -> Result<Time, InvalidTimeError> {
        return Create(arg0, arg1, arg2, 0)
    }

    static func Create(arg0: int, arg1: int, arg2: int, arg3: int) -> Result<Time, InvalidTimeError> {
        let hour = arg0
        let minute = arg1
        let second = arg2
        let fractionTicks = arg3
        if hour < 0 {
            return Error(InvalidTimeError())
        }
        if hour > 23 {
            return Error(InvalidTimeError())
        }
        if minute < 0 {
            return Error(InvalidTimeError())
        }
        if minute > 59 {
            return Error(InvalidTimeError())
        }
        if second < 0 {
            return Error(InvalidTimeError())
        }
        if second > 59 {
            return Error(InvalidTimeError())
        }
        if fractionTicks < 0 {
            return Error(InvalidTimeError())
        }
        if fractionTicks > 9999999 {
            return Error(InvalidTimeError())
        }
        let seconds: long = (hour * 60 + minute) * 60 + second
        return Ok(Time(seconds * 10000000L + fractionTicks))
    }

    static func FromTicks(arg0: long) -> Result<Time, InvalidTimeError> {
        if arg0 < 0L {
            return Error(InvalidTimeError())
        }
        if arg0 > 863999999999L {
            return Error(InvalidTimeError())
        }
        return Ok(Time(arg0))
    }

    val Ticks: long { get => StoredTicks }
    val Hour: int { get => (int)(StoredTicks / 36000000000L) }
    val Minute: int { get => (int)(StoredTicks / 600000000L % 60L) }
    val Second: int { get => (int)(StoredTicks / 10000000L % 60L) }
    val Millisecond: int { get => (int)(StoredTicks / 10000L % 1000L) }
    val FractionTicks: int { get => (int)(StoredTicks % 10000000L) }

    func Equals(arg0: Time) -> bool {
        return StoredTicks == arg0.StoredTicks
    }

    func CompareTo(arg0: Time) -> int {
        if StoredTicks < arg0.StoredTicks {
            return -1
        }
        if StoredTicks > arg0.StoredTicks {
            return 1
        }
        return 0
    }
}
