namespace System.Networking

import System.*
import System.Result.*
import System.Collections.*
import System.Tasks.*
import System.Runtime.CompilerServices.*

public class Dns {
    private init() { }

    static func GetHostAddresses(hostName: string) -> Task<Result<Sequence<IPAddress>, DnsError>> {
        return GetHostAddressesUntil(hostName, 0)
    }

    internal static func GetHostAddressesUntil(hostName: string, deadline: long) -> Task<Result<Sequence<IPAddress>, DnsError>> {
        let source = Promise<Result<Sequence<IPAddress>, DnsError>>()
        let completion = DnsCompletion(source)
        completion.StartUntil(hostName, deadline)
        return source.Task
    }

    internal static func DecodeError(code: byte) -> DnsError {
        if code == 1 {
            return DnsError.InvalidName()
        }
        if code == 2 {
            return DnsError.LimitExceeded()
        }
        if code == 3 {
            return DnsError.NoAddress()
        }
        if code == 4 {
            return DnsError.TimedOut()
        }
        if code == 5 {
            return DnsError.Cancelled()
        }
        if code == 6 {
            return DnsError.LookupFailed()
        }
        System.Fault("invalid native DNS error")
        return DnsError.LookupFailed()
    }
}

internal class DnsCompletion {
    private field source: Promise<Result<Sequence<IPAddress>, DnsError>>
    private field operation: long

    internal init(source: Promise<Result<Sequence<IPAddress>, DnsError>>) {
        self.source = source
        operation = 0
    }

    internal func Start(hostName: string) {
        StartUntil(hostName, 0)
    }

    internal func StartUntil(hostName: string, deadline: long) {
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            RuntimeServices.DnsLookup(hostName, self.Complete)
        } else {
            RuntimeServices.DnsLookupUntil(hostName, deadline, self.Complete)
        }
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Dns.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            operation = RuntimeServices.UnpackValue<long>(payload)
        }
    }

    internal func Complete() {
        let payload = RuntimeServices.DnsResult(operation)
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Dns.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            let addresses: Sequence<string> = RuntimeServices.DnsAddresses(payload)
            let values = ArrayList<IPAddress>()
            var index = 0
            while index < addresses.Count {
                if let Ok(address) = IPAddress.Parse(addresses[index]) {
                    values.Add(address)
                } else {
                    _ = source.Complete(Error(DnsError.LookupFailed()))
                    return
                }
                index += 1
            }
            let result: Sequence<IPAddress> = values
            _ = source.Complete(Ok(result))
        }
    }
}
