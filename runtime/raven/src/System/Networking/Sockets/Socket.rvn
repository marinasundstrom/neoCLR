namespace System.Networking.Sockets

import System.*
import System.Networking.*
import System.Result.*
import System.Tasks.*
import System.Concurrency.*
import System.Collections.*
import System.Runtime.CompilerServices.*

public class Socket {
    private field handle: long

    internal init(handle: long) {
        self.handle = handle
    }

    /// Connects to an address value. IPv6 transport is not supported yet.
    static func Connect(address: IPAddress, port: int) -> Task<Result<Socket, SocketError>> {
        return Connect(address, port, CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(address: IPAddress, port: int, cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<Socket, SocketError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        if address is IPv4Address {
            return Connect(address.ToString(), port, cancellationToken)
        }
        let source = Promise<Result<Socket, SocketError>>()
        _ = source.Complete(Error(SocketError.UnsupportedAddressFamily()))
        return source.Task
    }

    /// Tries address values within the existing bounded connection policy.
    static func Connect(addresses: Sequence<IPAddress>, port: int) -> Task<Result<Socket, SocketError>> {
        return Connect(addresses, port, CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(addresses: Sequence<IPAddress>, port: int, cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        return ConnectUntil(addresses, port, 0, cancellationToken)
    }

    internal static func ConnectUntil(addresses: Sequence<IPAddress>, port: int, deadline: long) -> Task<Result<Socket, SocketError>> {
        return ConnectUntil(addresses, port, deadline, CancellationToken.None)
    }

    internal static func ConnectUntil(addresses: Sequence<IPAddress>, port: int, deadline: long, cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        if cancellationToken.IsCancellationRequested {
            let cancelled = Promise<Result<Socket, SocketError>>()
            _ = cancelled.Cancel()
            return cancelled.Task
        }
        if addresses.Count == 0 {
            let empty = Promise<Result<Socket, SocketError>>()
            _ = empty.Complete(Error(SocketError.InvalidRange()))
            return empty.Task
        }
        if addresses.Count > 16 {
            let excessive = Promise<Result<Socket, SocketError>>()
            _ = excessive.Complete(Error(SocketError.LimitExceeded()))
            return excessive.Task
        }
        let text = ArrayList<string>()
        var index = 0
        while index < addresses.Count {
            let address = addresses[index]
            if !(address is IPv4Address) {
                let source = Promise<Result<Socket, SocketError>>()
                _ = source.Complete(Error(SocketError.UnsupportedAddressFamily()))
                return source.Task
            }
            text.Add(address.ToString())
            index += 1
        }
        return ConnectUntil(text, port, deadline, cancellationToken)
    }

    /// Listens on an address value. IPv6 transport is not supported yet.
    static func Listen(address: IPAddress, port: int, backlog: int) -> Result<Socket, SocketError> {
        if address is IPv4Address {
            return Listen(address.ToString(), port, backlog)
        }
        return Error(SocketError.UnsupportedAddressFamily())
    }

    static func Connect(address: string, port: int) -> Task<Result<Socket, SocketError>> {
        return Connect(address, port, CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(address: string, port: int, cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        let source = Promise<Result<Socket, SocketError>>()
        let completion = SocketConnectCompletion(source, cancellationToken)
        completion.Start(address, port)
        return source.Task
    }

    static func Connect(addresses: Sequence<string>, port: int) -> Task<Result<Socket, SocketError>> {
        return Connect(addresses, port, CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    static func Connect(addresses: Sequence<string>, port: int, cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        return ConnectUntil(addresses, port, 0, cancellationToken)
    }

    internal static func ConnectUntil(addresses: Sequence<string>, port: int, deadline: long) -> Task<Result<Socket, SocketError>> {
        return ConnectUntil(addresses, port, deadline, CancellationToken.None)
    }

    internal static func ConnectUntil(addresses: Sequence<string>, port: int, deadline: long, cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        let source = Promise<Result<Socket, SocketError>>()
        let completion = SocketConnectCompletion(source, cancellationToken)
        completion.StartAddressesUntil(addresses, port, deadline)
        return source.Task
    }

    static func Listen(address: string, port: int, backlog: int) -> Result<Socket, SocketError> {
        let payload = RuntimeServices.SocketListen(address, port, backlog)
        if RuntimeServices.IsValue<byte>(payload) {
            return Error(DecodeError(RuntimeServices.UnpackValue<byte>(payload)))
        }
        return Ok(Socket(RuntimeServices.UnpackValue<long>(payload)))
    }

    func Accept() -> Task<Result<Socket, SocketError>> {
        return Accept(CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    func Accept(cancellationToken: CancellationToken) -> Task<Result<Socket, SocketError>> {
        let source = Promise<Result<Socket, SocketError>>()
        let completion = SocketConnectCompletion(source, cancellationToken)
        completion.StartAccept(handle)
        return source.Task
    }

    func GetLocalPort() -> Result<int, SocketError> {
        let payload = RuntimeServices.SocketLocalPort(handle)
        if RuntimeServices.IsValue<byte>(payload) {
            return Error(DecodeError(RuntimeServices.UnpackValue<byte>(payload)))
        }
        return Ok(RuntimeServices.UnpackValue<int>(payload))
    }

    func Receive(buffer: byte[], offset: int, count: int) -> Task<Result<int, SocketError>> {
        return Receive(buffer, offset, count, CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    func Receive(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, SocketError>> {
        return ReceiveUntil(buffer, offset, count, 0, cancellationToken)
    }

    internal func ReceiveUntil(buffer: byte[], offset: int, count: int, deadline: long) -> Task<Result<int, SocketError>> {
        return ReceiveUntil(buffer, offset, count, deadline, CancellationToken.None)
    }

    internal func ReceiveUntil(buffer: byte[], offset: int, count: int, deadline: long, cancellationToken: CancellationToken) -> Task<Result<int, SocketError>> {
        let source = Promise<Result<int, SocketError>>()
        let completion = SocketTransferCompletion(source, cancellationToken)
        completion.StartReceiveUntil(handle, buffer, offset, count, deadline)
        return source.Task
    }

    func Send(buffer: byte[], offset: int, count: int) -> Task<Result<int, SocketError>> {
        return Send(buffer, offset, count, CancellationToken.None)
    }

    /// Requests cancellation cooperatively; the task is cancelled after provider acknowledgement.
    func Send(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, SocketError>> {
        return SendUntil(buffer, offset, count, 0, cancellationToken)
    }

    internal func SendUntil(buffer: byte[], offset: int, count: int, deadline: long) -> Task<Result<int, SocketError>> {
        return SendUntil(buffer, offset, count, deadline, CancellationToken.None)
    }

    internal func SendUntil(buffer: byte[], offset: int, count: int, deadline: long, cancellationToken: CancellationToken) -> Task<Result<int, SocketError>> {
        let source = Promise<Result<int, SocketError>>()
        let completion = SocketTransferCompletion(source, cancellationToken)
        completion.StartSendUntil(handle, buffer, offset, count, deadline)
        return source.Task
    }

    func Close() {
        _ = RuntimeServices.SocketClose(handle)
    }

    internal static func DecodeError(code: byte) -> SocketError {
        if code == 1 {
            return SocketError.Closed()
        }
        if code == 2 {
            return SocketError.Busy()
        }
        if code == 3 {
            return SocketError.InvalidRange()
        }
        if code == 4 {
            return SocketError.LimitExceeded()
        }
        if code == 5 {
            return SocketError.Cancelled()
        }
        if code == 6 {
            return SocketError.InvalidAddress()
        }
        if code == 7 {
            return SocketError.ConnectionRefused()
        }
        if code == 8 {
            return SocketError.ConnectionReset()
        }
        if code == 9 {
            return SocketError.AccessDenied()
        }
        if code == 10 {
            return SocketError.TimedOut()
        }
        if code == 11 {
            return SocketError.IoFailure()
        }
        if code == 12 {
            return SocketError.InvalidOperation()
        }
        if code == 13 {
            return SocketError.AddressInUse()
        }
        System.Fault("invalid native socket error")
        return SocketError.IoFailure()
    }
}

internal class SocketConnectCompletion {
    private var source: Promise<Result<Socket, SocketError>>
    private var operation: long
    private var token: CancellationToken
    private var registration: CancellationRegistration?
    private var cancellationWon: bool

    internal init(source: Promise<Result<Socket, SocketError>>, token: CancellationToken) {
        self.source = source
        operation = 0
        self.token = token
        registration = null
        cancellationWon = false
    }

    internal func Start(address: string, port: int) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = RuntimeServices.SocketConnect(address, port, self.Complete)
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            operation = RuntimeServices.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func StartAddresses(addresses: Sequence<string>, port: int) {
        StartAddressesUntil(addresses, port, 0)
    }

    internal func StartAddressesUntil(addresses: Sequence<string>, port: int, deadline: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        let count = addresses.Count
        if count <= 0 {
            _ = source.Complete(Error(SocketError.InvalidRange()))
            return
        }
        if count > 16 {
            _ = source.Complete(Error(SocketError.LimitExceeded()))
            return
        }
        let snapshot = CheckedStorage.Reserve<string>(count)
        var index = 0
        while index < count {
            snapshot[index] = addresses[index]
            index += 1
        }
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            RuntimeServices.SocketConnectAddresses(snapshot, port, self.Complete)
        } else {
            RuntimeServices.SocketConnectAddressesUntil(snapshot, port, deadline, self.Complete)
        }
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            operation = RuntimeServices.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func StartAccept(handle: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = RuntimeServices.SocketAccept(handle, self.Complete)
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            operation = RuntimeServices.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func RequestCancellation() {
        cancellationWon = RuntimeServices.SocketCancel(operation)
    }

    internal func Complete() {
        let active = registration
        registration = null
        if active is CancellationRegistration current {
            current.Dispose()
        }
        let payload = RuntimeServices.SocketConnectResult(operation)
        operation = 0
        if cancellationWon {
            _ = source.Cancel()
            return
        }
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            _ = source.Complete(Ok(Socket(RuntimeServices.UnpackValue<long>(payload))))
        }
    }
}

internal class SocketTransferCompletion {
    private var source: Promise<Result<int, SocketError>>
    private var operation: long
    private var token: CancellationToken
    private var registration: CancellationRegistration?
    private var cancellationWon: bool

    internal init(source: Promise<Result<int, SocketError>>, token: CancellationToken) {
        self.source = source
        operation = 0
        self.token = token
        registration = null
        cancellationWon = false
    }

    internal func StartReceive(handle: long, buffer: byte[], offset: int, count: int) {
        StartReceiveUntil(handle, buffer, offset, count, 0)
    }

    internal func StartReceiveUntil(handle: long, buffer: byte[], offset: int, count: int, deadline: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            RuntimeServices.SocketReceive(handle, buffer, offset, count, self.Complete)
        } else {
            RuntimeServices.SocketReceiveUntil(handle, buffer, offset, count, deadline, self.Complete)
        }
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            operation = RuntimeServices.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func StartSend(handle: long, buffer: byte[], offset: int, count: int) {
        StartSendUntil(handle, buffer, offset, count, 0)
    }

    internal func StartSendUntil(handle: long, buffer: byte[], offset: int, count: int, deadline: long) {
        if token.IsCancellationRequested {
            _ = source.Cancel()
            return
        }
        _ = TaskQueue.Default
        let payload = if deadline == 0 {
            RuntimeServices.SocketSend(handle, buffer, offset, count, self.Complete)
        } else {
            RuntimeServices.SocketSendUntil(handle, buffer, offset, count, deadline, self.Complete)
        }
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            operation = RuntimeServices.UnpackValue<long>(payload)
            if token.CanBeCancelled {
                registration = token.Register(self.RequestCancellation)
            }
        }
    }

    internal func RequestCancellation() {
        cancellationWon = RuntimeServices.SocketCancel(operation)
    }

    internal func Complete() {
        let active = registration
        registration = null
        if active is CancellationRegistration current {
            current.Dispose()
        }
        let payload = RuntimeServices.SocketTransferResult(operation)
        operation = 0
        if cancellationWon {
            _ = source.Cancel()
            return
        }
        if RuntimeServices.IsValue<byte>(payload) {
            _ = source.Complete(Error(Socket.DecodeError(RuntimeServices.UnpackValue<byte>(payload))))
        } else {
            _ = source.Complete(Ok(RuntimeServices.UnpackValue<int>(payload)))
        }
    }
}
