namespace System.Networking

public union DnsError {
    case InvalidName
    case LimitExceeded
    case NoAddress
    case TimedOut
    case Cancelled
    case LookupFailed

    override func ToString() -> string {
        return match self {
            InvalidName => "InvalidName"
            LimitExceeded => "LimitExceeded"
            NoAddress => "NoAddress"
            TimedOut => "TimedOut"
            Cancelled => "Cancelled"
            LookupFailed => "LookupFailed"
            _ => "Empty"
        }
    }
}
