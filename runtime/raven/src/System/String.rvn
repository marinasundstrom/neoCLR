namespace System

import System.Runtime.CompilerServices.RuntimeServices
import System.Result.*
import System.Text.Utf8SliceError

public class String : EquatableTo<string>, Collections.Sequence<char> {
    // Intrinsic storage supplied by the runtime, never an allocated class field.
    #pragma warning disable-next-line RAV9032
    private field m_value: string

    internal static func CreateFromCharacters(characters: Collections.Sequence<char>) -> string {
        let count = characters.Count
        let snapshot = Runtime.CompilerServices.CheckedStorage.Reserve<char>(count)
        let iterator = characters.GetIterator()
        var index = 0
        while iterator.MoveNext() {
            snapshot[index] = iterator.Current
            index += 1
        }
        iterator.Dispose()
        if index != count {
            System.Fail("Character sequence count changed during construction")
        }
        return RuntimeServices.StringFromChars(snapshot)
    }

    val Collections.Collection<char>.Count: int => RuntimeServices.StringGraphemeCount(m_value)

    val self[index: int]: char {
        get => RuntimeServices.StringGraphemeAt(m_value, index)
    }

    static func Intern(text: string) -> string {
        return RuntimeServices.StringIntern(text)
    }

    static func Concat(left: string, right: string) -> string {
        return RuntimeServices.StringConcat(left, right)
    }

    /// Concatenates textual representations; null contributes an empty string.
    static func Concat(left: Object?, right: Object?) -> string {
        let first = if left is Object value { value.ToString() } else { "" }
        let second = if right is Object value { value.ToString() } else { "" }
        return RuntimeServices.StringConcat(first, second)
    }

    static func ==(left: string, right: string) -> bool => RuntimeServices.StringEquals(left, right)

    static func !=(left: string, right: string) -> bool => !RuntimeServices.StringEquals(left, right)

    func Equals(other: string) -> bool {
        return RuntimeServices.StringEquals(m_value, other)
    }

    /// Compares non-null strings using an explicit policy; unknown modes fault.
    static func Compare(left: string, right: string, comparison: StringComparison) -> int {
        if comparison == StringComparison.Ordinal {
            return CompareOrdinal(left, right)
        }
        if comparison == StringComparison.OrdinalIgnoreCase {
            return CompareOrdinalIgnoreCase(left, right)
        }
        System.Fail("Unsupported StringComparison")
        return 0
    }

    /// Uses Unicode 17 default simple folding without normalization or expansion.
    static func CompareOrdinalIgnoreCase(left: string, right: string) -> int {
        return RuntimeServices.StringCompareOrdinalIgnoreCase(left, right)
    }

    static func CompareOrdinal(left: string, right: string) -> int {
        return RuntimeServices.StringCompareOrdinal(left, right)
    }

    /// Unicode 17 full default uppercase; no locale tailoring or normalization.
    func ToUpperInvariant() -> string {
        return RuntimeServices.StringToUpperInvariant(m_value)
    }

    /// Unicode 17 full default lowercase, including final sigma context.
    func ToLowerInvariant() -> string {
        return RuntimeServices.StringToLowerInvariant(m_value)
    }

    func ContainsOrdinal(substring: string) -> bool {
        return RuntimeServices.StringContainsOrdinal(m_value, substring)
    }

    func StartsWithOrdinal(prefix: string) -> bool {
        return RuntimeServices.StringStartsWithOrdinal(m_value, prefix)
    }

    func EndsWithOrdinal(suffix: string) -> bool {
        return RuntimeServices.StringEndsWithOrdinal(m_value, suffix)
    }

    func GetUtf8ByteCount() -> int {
        return RuntimeServices.StringByteCount(m_value)
    }

    val Length: int => RuntimeServices.StringGraphemeCount(m_value)


    func GetIterator() -> Collections.Iterator<char> {
        let elements = RuntimeServices.StringGraphemes(m_value)
        return elements.GetIterator()
    }

    func GetScalars() -> Collections.Sequence<uint> {
        return RuntimeServices.StringScalars(m_value)
    }

    val IsEmpty: bool => RuntimeServices.StringEquals(m_value, "")

    func SliceUtf8(byteStart: int, byteLength: int) -> Result<string, Utf8SliceError> {
        let payload = RuntimeServices.StringSliceUtf8(m_value, byteStart, byteLength)
        if RuntimeServices.IsValue<string>(payload) {
            return Ok(RuntimeServices.UnpackValue<string>(payload))
        }
        let status = RuntimeServices.UnpackValue<byte>(payload)
        if status == 1 {
            return Error(Utf8SliceError.OutOfRange())
        }
        if status == 2 {
            return Error(Utf8SliceError.InvalidBoundary())
        }
        System.Fail("invalid native UTF-8 slice status")
        return Error(Utf8SliceError.OutOfRange())
    }
}
