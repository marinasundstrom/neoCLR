module System

import System.Result.*
import System.Option.*
import System.Text.Utf8SliceError

public class String : EquatableTo<string>, ComparableTo<string>, Collections.Sequence<char> {
    /// <summary>Formats indexed arguments with escaped braces and optional grapheme alignment.</summary>
    /// <param name="format">Composite text using {index[,alignment][:format]}; {{ and }} escape braces.</param>
    /// <param name="arg0">Values formatted through ToString; null produces empty text.</param>
    /// <returns>Formatted UTF-8 text; unchanged literal-only input is reused.</returns>
    /// <remarks>Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives one Culture.Current snapshot per call; explicit Culture overloads are available. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.</remarks>
    static func Format(format: string, arg0: object?) -> string {
        return Text.CompositeFormatting.Format(format, 1, arg0, null, null, null, null)
    }

    /// <summary>Formats indexed arguments with escaped braces and optional grapheme alignment.</summary>
    /// <param name="format">Composite text using {index[,alignment][:format]}; {{ and }} escape braces.</param>
    /// <param name="arg0">Values formatted through ToString; null produces empty text.</param>
    /// <param name="arg1">Values formatted through ToString; null produces empty text.</param>
    /// <returns>Formatted UTF-8 text; unchanged literal-only input is reused.</returns>
    /// <remarks>Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives one Culture.Current snapshot per call; explicit Culture overloads are available. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.</remarks>
    static func Format(format: string, arg0: object?, arg1: object?) -> string {
        return Text.CompositeFormatting.Format(format, 2, arg0, arg1, null, null, null)
    }

    /// <summary>Formats indexed arguments with escaped braces and optional grapheme alignment.</summary>
    /// <param name="format">Composite text using {index[,alignment][:format]}; {{ and }} escape braces.</param>
    /// <param name="arg0">Values formatted through ToString; null produces empty text.</param>
    /// <param name="arg1">Values formatted through ToString; null produces empty text.</param>
    /// <param name="arg2">Values formatted through ToString; null produces empty text.</param>
    /// <returns>Formatted UTF-8 text; unchanged literal-only input is reused.</returns>
    /// <remarks>Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives one Culture.Current snapshot per call; explicit Culture overloads are available. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.</remarks>
    static func Format(format: string, arg0: object?, arg1: object?, arg2: object?) -> string {
        return Text.CompositeFormatting.Format(format, 3, arg0, arg1, arg2, null, null)
    }

    /// <summary>Formats indexed arguments with escaped braces and optional grapheme alignment.</summary>
    /// <param name="format">Composite text using {index[,alignment][:format]}; {{ and }} escape braces.</param>
    /// <param name="arguments">Values formatted through ToString; null produces empty text.</param>
    /// <returns>Formatted UTF-8 text; unchanged literal-only input is reused.</returns>
    /// <remarks>Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives one Culture.Current snapshot per call; explicit Culture overloads are available. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.</remarks>
    static func Format(format: string, params arguments: object?[]) -> string {
        return Text.CompositeFormatting.Format(format, arguments.Length, null, null, null, arguments, null)
    }

    /// Formats indexed arguments with escaped braces and optional grapheme alignment.
    /// culture: Supported culture supplied to every Formattable argument.
    /// format: Composite text using {index[,alignment][:format]}; {{ and }} escape braces.
    /// arg0: Values formatted through ToString; null produces empty text.
    /// Formatted UTF-8 text; unchanged literal-only input is reused.
    /// Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives the supplied culture; no ambient culture is read. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.
    static func Format(culture: Globalization.Culture, format: string, arg0: object?) -> string {
        return Text.CompositeFormatting.Format(format, 1, arg0, null, null, null, culture)
    }

    /// Formats indexed arguments with escaped braces and optional grapheme alignment.
    /// culture: Supported culture supplied to every Formattable argument.
    /// format: Composite text using {index[,alignment][:format]}; {{ and }} escape braces.
    /// arg0: Values formatted through ToString; null produces empty text.
    /// arg1: Values formatted through ToString; null produces empty text.
    /// Formatted UTF-8 text; unchanged literal-only input is reused.
    /// Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives the supplied culture; no ambient culture is read. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.
    static func Format(culture: Globalization.Culture, format: string, arg0: object?, arg1: object?) -> string {
        return Text.CompositeFormatting.Format(format, 2, arg0, arg1, null, null, culture)
    }

    /// Formats indexed arguments with escaped braces and optional grapheme alignment.
    /// culture: Supported culture supplied to every Formattable argument.
    /// format: Composite text using {index[,alignment][:format]}; {{ and }} escape braces.
    /// arg0: Values formatted through ToString; null produces empty text.
    /// arg1: Values formatted through ToString; null produces empty text.
    /// arg2: Values formatted through ToString; null produces empty text.
    /// Formatted UTF-8 text; unchanged literal-only input is reused.
    /// Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives the supplied culture; no ambient culture is read. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.
    static func Format(culture: Globalization.Culture, format: string, arg0: object?, arg1: object?, arg2: object?) -> string {
        return Text.CompositeFormatting.Format(format, 3, arg0, arg1, arg2, null, culture)
    }

    /// Formats indexed arguments with escaped braces and optional grapheme alignment.
    /// culture: Supported culture supplied to every Formattable argument.
    /// format: Composite text using {index[,alignment][:format]}; {{ and }} escape braces.
    /// arguments: Values formatted through ToString; null produces empty text.
    /// Formatted UTF-8 text; unchanged literal-only input is reused.
    /// Development API. Type-specific specifiers dispatch through Formattable; other values use ToString. Formattable receives the supplied culture; no ambient culture is read. Custom providers are unsupported. Invalid syntax/indexes and output over 65536 bytes fault. Alignment counts graphemes, not terminal columns. Fixed-arity overloads avoid an argument array; value arguments may box.
    static func Format(culture: Globalization.Culture, format: string, params arguments: object?[]) -> string {
        return Text.CompositeFormatting.Format(format, arguments.Length, null, null, null, arguments, culture)
    }

    /// Borrows immutable UTF-8 bytes. Byte offsets are independent of grapheme indexes.
    val Utf8Bytes: ReadOnlySlice<byte> => neoCLR.Runtime.ViewUtf8(self)

    // Intrinsic storage supplied by the runtime, never an allocated class field.
    #pragma warning disable-next-line RAV9032
    private field m_value: string

    /// Snapshots characters into immutable Unicode text; later input mutation is independent.
    init(characters: Collections.Sequence<char>) {
        m_value = CreateFromCharacters(characters)
    }

    internal static func CreateFromCharacters(characters: Collections.Sequence<char>) -> string {
        let count = characters.Count
        let snapshot = Runtime.CompilerServices.CheckedStorage.Reserve<char>(count)
        let iterator = characters.GetIterator()
        var index = 0
        while iterator.MoveNext() {
            snapshot[index] = iterator.Current
            index += 1
        }
        iterator.Dispose()
        if index != count {
            System.Fail("Character sequence count changed during construction")
        }
        return neoCLR.Runtime.StringFromChars(snapshot)
    }

    val Collections.Collection<char>.Count: int => neoCLR.Runtime.StringGraphemeCount(m_value)

    val self[index: int]: char {
        get => neoCLR.Runtime.StringGraphemeAt(m_value, index)
    }

    /// Applies a directional grapheme index; invalid element bounds fault.
    val self[index: Index]: char {
        get => neoCLR.Runtime.StringGraphemeAt(m_value, index.GetOffset(Length))
    }

    /// Copies a half-open grapheme range; invalid bounds fault.
    val self[range: Range]: string {
        get {
            let bounds = range.GetOffsetAndLength(Length)
            return neoCLR.Runtime.StringSliceGraphemes(m_value, bounds.Item1, bounds.Item2)
        }
    }

    /// Returns a grapheme, or None when index is outside the text.
    func Get(index: int) -> Option<char> {
        if index < 0 {
            return None
        }
        if index >= Length {
            return None
        }
        return Some(neoCLR.Runtime.StringGraphemeAt(m_value, index))
    }

    /// Returns a grapheme at a directional index, or None when outside the text.
    func Get(index: Index) -> Option<char> => Get(index.GetOffset(Length))

    /// Copies a grapheme range, or returns InvalidRangeError for invalid bounds.
    func Slice(range: Range) -> Result<string, InvalidRangeError> {
        if range.TryGetOffsetAndLength(Length) is Ok(let bounds) {
            return Ok(neoCLR.Runtime.StringSliceGraphemes(m_value, bounds.Item1, bounds.Item2))
        }
        return Error(InvalidRangeError())
    }

    /// Returns true for null or empty text without creating a string.
    static func IsNullOrEmpty(text: string?) -> bool {
        if text is string value {
            return value.Utf8Bytes.Length == 0
        }
        return true
    }

    /// Returns true for null, empty or entirely Unicode 17 White_Space text.
    /// Scans borrowed UTF-8 without trimming or creating temporary arrays.
    static func IsNullOrWhiteSpace(text: string?) -> bool {
        if text is string value {
            let bytes = value.Utf8Bytes
            var index = 0
            while index < bytes.Length {
                let width = WhitespaceWidth(bytes, index)
                if width == 0 {
                    return false
                }
                index += width
            }
        }
        return true
    }

    static func Intern(text: string) -> string {
        return neoCLR.Runtime.StringIntern(text)
    }

    static func Concat(left: string, right: string) -> string {
        return neoCLR.Runtime.StringConcat(left, right)
    }

    /// Joins initialized non-null strings, inserting separator between every pair.
    /// Empty input produces an empty string; size overflow faults before allocation.
    static func Join(separator: string, values: string[]) -> string {
        let count = values.Length
        let separatorBytes = separator.GetUtf8ByteCount()
        var size = 0
        var index = 0
        while index < count {
            if index != 0 {
                if separatorBytes > 2147483647 - size {
                    System.Fail("String.Join UTF-8 byte count overflow")
                }
                size += separatorBytes
            }
            let bytes = values[index].GetUtf8ByteCount()
            if bytes > 2147483647 - size {
                System.Fail("String.Join UTF-8 byte count overflow")
            }
            size += bytes
            index += 1
        }
        return neoCLR.Runtime.StringJoinParts(values, count, separator, size)
    }

    /// Concatenates textual representations; null contributes an empty string.
    static func Concat(left: Object?, right: Object?) -> string {
        let first = if left is Object value { value.ToString() } else { "" }
        let second = if right is Object value { value.ToString() } else { "" }
        return neoCLR.Runtime.StringConcat(first, second)
    }

    static func ==(left: string, right: string) -> bool => neoCLR.Runtime.StringEquals(left, right)

    static func !=(left: string, right: string) -> bool => !neoCLR.Runtime.StringEquals(left, right)

    /// Tests Unicode canonical equivalence without changing either string.
    func Equals(other: string) -> bool {
        return neoCLR.Runtime.StringEquals(m_value, other)
    }

    /// Compares non-null text using the specified policy; unknown modes fault.
    func Equals(other: string, comparison: StringComparison) -> bool {
        return Compare(m_value, other, comparison) == 0
    }

    /// Orders canonical NFD scalar sequences, consistently with String.Compare.
    func CompareTo(other: string) -> int => Compare(m_value, other)

    /// Compares text by Unicode canonical equivalence, preserving original UTF-8 bytes.
    override func Equals(other: Object?) -> bool {
        if other is string text {
            return Equals(text)
        }
        return false
    }

    /// Returns this string without copying or changing its UTF-8 storage.
    override func ToString() -> string => m_value

    /// Hashes canonical text identity without normalizing stored bytes.
    override func GetHashCode() -> int => neoCLR.Runtime.StringHashCanonical(m_value)

    /// Orders canonical NFD scalar sequences; this is not linguistic collation.
    static func Compare(left: string, right: string) -> int => neoCLR.Runtime.StringCompareCanonical(left, right)

    /// Compares non-null strings using an explicit policy; unknown modes fault.
    static func Compare(left: string, right: string, comparison: StringComparison) -> int {
        if comparison == StringComparison.Canonical {
            return Compare(left, right)
        }
        if comparison == StringComparison.Ordinal {
            return CompareOrdinal(left, right)
        }
        if comparison == StringComparison.OrdinalIgnoreCase {
            return CompareOrdinalIgnoreCase(left, right)
        }
        System.Fail("Unsupported StringComparison")
        return 0
    }

    /// Uses Unicode 17 default simple folding without normalization or expansion.
    static func CompareOrdinalIgnoreCase(left: string, right: string) -> int {
        return neoCLR.Runtime.StringCompareOrdinalIgnoreCase(left, right)
    }

    static func CompareOrdinal(left: string, right: string) -> int {
        return neoCLR.Runtime.StringCompareOrdinal(left, right)
    }

    /// Unicode 17 full default uppercase; no locale tailoring or normalization.
    func ToUpperInvariant() -> string {
        return neoCLR.Runtime.StringToUpperInvariant(m_value)
    }

    /// Unicode 17 full default lowercase, including final sigma context.
    func ToLowerInvariant() -> string {
        return neoCLR.Runtime.StringToLowerInvariant(m_value)
    }

    /// Replaces exact, non-overlapping matches without modifying this string.
    /// Empty replacement deletes matches; empty search faults with RuntimeError.
    /// Arguments must be non-null. Matching uses UTF-8 without culture or normalization.
    func Replace(oldValue: string, newValue: string) -> string {
        return neoCLR.Runtime.StringReplaceOrdinal(m_value, oldValue, newValue)
    }

    /// Replaces Unicode newline sequences with LF, independently of the host OS.
    func ReplaceLineEndings() -> string => ReplaceLineEndings("\n")

    /// Replaces CRLF, CR, LF, FF, NEL, LS and PS; empty replacement deletes them.
    /// Unchanged text reuses its owner. Not for protocol framing or validation.
    func ReplaceLineEndings(replacementText: string) -> string {
        return neoCLR.Runtime.StringReplaceLineEndings(m_value, replacementText)
    }

    /// Removes leading and trailing Unicode 17 White_Space scalars.
    /// Preserves retained UTF-8 bytes; combining marks are not whitespace.
    func Trim() -> string => TrimWhitespace(m_value, true, true)

    /// Removes leading Unicode 17 White_Space scalars, preserving retained bytes.
    func TrimStart() -> string => TrimWhitespace(m_value, true, false)

    /// Removes trailing Unicode 17 White_Space scalars, preserving retained bytes.
    func TrimEnd() -> string => TrimWhitespace(m_value, false, true)

    private static func TrimWhitespace(text: string, start: bool, end: bool) -> string {
        let bytes = text.Utf8Bytes
        var first = 0
        var limit = bytes.Length
        if start {
            while first < limit {
                let width = WhitespaceWidth(bytes, first)
                if width == 0 {
                    break
                }
                first += width
            }
        }
        if end {
            while limit > first {
                var scalar = limit - 1
                while scalar > first && bytes[scalar] >= 128 && bytes[scalar] < 192 {
                    scalar -= 1
                }
                if WhitespaceWidth(bytes, scalar) == 0 {
                    break
                }
                limit = scalar
            }
        }
        if first == 0 && limit == bytes.Length {
            return text
        }
        if first == limit {
            return ""
        }
        // Both offsets are scalar boundaries in runtime-validated immutable UTF-8.
        // Use the existing checked runtime service, without a Result or array copy.
        return neoCLR.Runtime.UnpackValue<string>(neoCLR.Runtime.StringSliceUtf8(text, first, limit - first))
    }

    // Unicode 17 PropList White_Space: 25 scalars, all encoded in 1–3 bytes.
    // Input is a String view and index is a scalar boundary; never arbitrary bytes.
    private static func WhitespaceWidth(bytes: ReadOnlySlice<byte>, index: int) -> int {
        let first = bytes[index]
        if first == 32 || first >= 9 && first <= 13 {
            return 1
        }
        if first == 194 {
            let second = bytes[index + 1]
            if second == 133 || second == 160 {
                return 2
            }
        }
        if first == 225 && bytes[index + 1] == 154 && bytes[index + 2] == 128 {
            return 3
        }
        if first == 226 {
            let second = bytes[index + 1]
            let third = bytes[index + 2]
            if second == 128 && (third >= 128 && third <= 138 || third == 168 || third == 169 || third == 175) {
                return 3
            }
            if second == 129 && third == 159 {
                return 3
            }
        }
        if first == 227 && bytes[index + 1] == 128 && bytes[index + 2] == 128 {
            return 3
        }
        return 0
    }

    /// <summary>Tests whether text contains the supplied text by canonical whole-grapheme matching.</summary>
    /// <param name="substring">Non-null text to match; empty always matches.</param>
    /// <returns>True when a match is found.</returns>
    /// <remarks>Development API. Preserves UTF-8 bytes without temporary strings or arrays.
    /// Does not match part of a grapheme. Candidate scans can repeat prefix work; no linear-time guarantee.</remarks>
    func Contains(substring: string) -> bool {
        return neoCLR.Runtime.StringContainsCanonical(m_value, substring)
    }

    /// <summary>Tests whether text contains the supplied text using an explicit policy.</summary>
    /// <param name="substring">Non-null text to match; empty matches for every valid policy.</param>
    /// <param name="comparison">Canonical matches complete graphemes; Ordinal matches bytes;
    /// OrdinalIgnoreCase matches simple-folded scalars without normalization or expansion.</param>
    /// <returns>True when a match is found.</returns>
    /// <remarks>Development API. Unknown modes fault with RuntimeError, including empty patterns.
    /// Ordinal modes may match inside graphemes. No cultural matching, temporary strings or arrays.
    /// Preserves UTF-8 bytes. Candidate scans can repeat prefix work; no linear-time guarantee.</remarks>
    func Contains(substring: string, comparison: StringComparison) -> bool {
        if comparison == StringComparison.Canonical {
            return neoCLR.Runtime.StringContainsCanonical(m_value, substring)
        }
        if comparison == StringComparison.Ordinal {
            return neoCLR.Runtime.StringContainsOrdinal(m_value, substring)
        }
        if comparison == StringComparison.OrdinalIgnoreCase {
            return neoCLR.Runtime.StringContainsOrdinalIgnoreCase(m_value, substring)
        }
        System.Fail("Unsupported StringComparison")
        return false
    }

    /// <summary>Tests whether text starts with the supplied text by canonical whole-grapheme matching.</summary>
    /// <param name="prefix">Non-null text to match; empty always matches.</param>
    /// <returns>True when a match is found.</returns>
    /// <remarks>Development API. Preserves UTF-8 bytes without temporary strings or arrays.
    /// Does not match part of a grapheme. Candidate scans can repeat prefix work; no linear-time guarantee.</remarks>
    func StartsWith(prefix: string) -> bool {
        return neoCLR.Runtime.StringStartsWithCanonical(m_value, prefix)
    }

    /// <summary>Tests whether text starts with the supplied text using an explicit policy.</summary>
    /// <param name="prefix">Non-null text to match; empty matches for every valid policy.</param>
    /// <param name="comparison">Canonical matches complete graphemes; Ordinal matches bytes;
    /// OrdinalIgnoreCase matches simple-folded scalars without normalization or expansion.</param>
    /// <returns>True when a match is found.</returns>
    /// <remarks>Development API. Unknown modes fault with RuntimeError, including empty patterns.
    /// Ordinal modes may match inside graphemes. No cultural matching, temporary strings or arrays.
    /// Preserves UTF-8 bytes. Candidate scans can repeat prefix work; no linear-time guarantee.</remarks>
    func StartsWith(prefix: string, comparison: StringComparison) -> bool {
        if comparison == StringComparison.Canonical {
            return neoCLR.Runtime.StringStartsWithCanonical(m_value, prefix)
        }
        if comparison == StringComparison.Ordinal {
            return neoCLR.Runtime.StringStartsWithOrdinal(m_value, prefix)
        }
        if comparison == StringComparison.OrdinalIgnoreCase {
            return neoCLR.Runtime.StringStartsWithOrdinalIgnoreCase(m_value, prefix)
        }
        System.Fail("Unsupported StringComparison")
        return false
    }

    /// <summary>Tests whether text ends with the supplied text by canonical whole-grapheme matching.</summary>
    /// <param name="suffix">Non-null text to match; empty always matches.</param>
    /// <returns>True when a match is found.</returns>
    /// <remarks>Development API. Preserves UTF-8 bytes without temporary strings or arrays.
    /// Does not match part of a grapheme. Candidate scans can repeat prefix work; no linear-time guarantee.</remarks>
    func EndsWith(suffix: string) -> bool {
        return neoCLR.Runtime.StringEndsWithCanonical(m_value, suffix)
    }

    /// <summary>Tests whether text ends with the supplied text using an explicit policy.</summary>
    /// <param name="suffix">Non-null text to match; empty matches for every valid policy.</param>
    /// <param name="comparison">Canonical matches complete graphemes; Ordinal matches bytes;
    /// OrdinalIgnoreCase matches simple-folded scalars without normalization or expansion.</param>
    /// <returns>True when a match is found.</returns>
    /// <remarks>Development API. Unknown modes fault with RuntimeError, including empty patterns.
    /// Ordinal modes may match inside graphemes. No cultural matching, temporary strings or arrays.
    /// Preserves UTF-8 bytes. Candidate scans can repeat prefix work; no linear-time guarantee.</remarks>
    func EndsWith(suffix: string, comparison: StringComparison) -> bool {
        if comparison == StringComparison.Canonical {
            return neoCLR.Runtime.StringEndsWithCanonical(m_value, suffix)
        }
        if comparison == StringComparison.Ordinal {
            return neoCLR.Runtime.StringEndsWithOrdinal(m_value, suffix)
        }
        if comparison == StringComparison.OrdinalIgnoreCase {
            return neoCLR.Runtime.StringEndsWithOrdinalIgnoreCase(m_value, suffix)
        }
        System.Fail("Unsupported StringComparison")
        return false
    }

    func ContainsOrdinal(substring: string) -> bool {
        return neoCLR.Runtime.StringContainsOrdinal(m_value, substring)
    }

    func StartsWithOrdinal(prefix: string) -> bool {
        return neoCLR.Runtime.StringStartsWithOrdinal(m_value, prefix)
    }

    func EndsWithOrdinal(suffix: string) -> bool {
        return neoCLR.Runtime.StringEndsWithOrdinal(m_value, suffix)
    }

    /// Legacy byte-oriented API; byte counting belongs to explicit encoding.
    [Obsolete("Byte counting will move to explicit encoding APIs. This string member is scheduled for removal.")]
    func GetUtf8ByteCount() -> int {
        return neoCLR.Runtime.StringByteCount(m_value)
    }

    val Length: int => neoCLR.Runtime.StringGraphemeCount(m_value)


    func GetIterator() -> Collections.Iterator<char> {
        let elements = neoCLR.Runtime.StringGraphemes(m_value)
        return elements.GetIterator()
    }

    func GetScalars() -> Collections.Sequence<uint> {
        return neoCLR.Runtime.StringScalars(m_value)
    }

    val IsEmpty: bool => neoCLR.Runtime.StringEquals(m_value, "")

    /// Legacy byte-oriented API; byte slicing belongs to explicit encoding and buffers.
    [Obsolete("Byte slicing will move to explicit encoding and buffer APIs. This string member is scheduled for removal.")]
    func SliceUtf8(byteStart: int, byteLength: int) -> Result<string, Utf8SliceError> {
        let payload = neoCLR.Runtime.StringSliceUtf8(m_value, byteStart, byteLength)
        if neoCLR.Runtime.IsValue<string>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<string>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<byte>(payload)
        if status == 1 {
            return Error(Utf8SliceError.OutOfRange())
        }
        if status == 2 {
            return Error(Utf8SliceError.InvalidBoundary())
        }
        System.Fail("invalid native UTF-8 slice status")
        return Error(Utf8SliceError.OutOfRange())
    }
}
