module System.Concurrency.Tasks {

import System.*
import System.Collections.*
import System.Option.*
import System.Concurrency.Tasks.TaskOutcome.*

// Submission owns no public thread handle; all overloads use the default dispatcher.
public static class Task {
    /// Returns an already successfully completed unit task.
    /// Each access uses the current dispatcher; task identity is not guaranteed.
    static val CompletedTask: Task<()> => FromResult(())

    /// Returns an already successfully completed task containing value.
    /// Awaiting the task needs no scheduled work. Explicit completion callbacks
    /// retain normal deferred dispatch through the current task queue.
    static func FromResult<T>(value: T) -> Task<T> {
        let source = Promise<T>()
        _ = source.Complete(value)
        return source.Task
    }

    static func Run(callback: () -> System.Void) -> Task<System.Void> {
        let source = Promise<System.Void>(TaskQueue.Default)
        let work = TaskRunWork<System.Void>(callback, source)
        neoCLR.Runtime.ScheduleTask(work.Run)
        return source.Task
    }

    static func Run<T>(callback: () -> T) -> Task<T> {
        let source = Promise<T>(TaskQueue.Default)
        let work = TaskRunWork<T>(callback, source)
        neoCLR.Runtime.ScheduleTask(work.Run)
        return source.Task
    }

    static func Run<T>(callback: () -> Task<T>) -> Task<T> {
        let source = Promise<T>(TaskQueue.Default)
        let work = TaskRunAsyncWork<T>(callback, source)
        neoCLR.Runtime.ScheduleTask(work.Run)
        return source.Task
    }
}

internal class TaskRunWork<T> {
    // Explicit fields retain bootstrap compatibility for constructor-assigned storage.
    private field callback: () -> T
    private field source: Promise<T>

    init(callback: () -> T, source: Promise<T>) {
        self.callback = callback
        self.source = source
    }

    func Run() {
        _ = source.Complete(callback())
    }
}

internal class TaskRunAsyncWork<T> {
    // Explicit fields retain bootstrap compatibility for constructor-assigned storage.
    private field callback: () -> Task<T>
    private field source: Promise<T>

    init(callback: () -> Task<T>, source: Promise<T>) {
        self.callback = callback
        self.source = source
    }

    func Run() {
        let inner = callback()
        let transfer = OutcomeTransfer<T>(inner, source)
        inner.OnCompleted(transfer.Run)
    }
}

// Explicit, single-invocation dispatcher for the provisional Task proof of concept.
public class TaskQueue {
    private field pending: ArrayQueue<() -> System.Void>
    private field running: bool

    init() {
        pending = ArrayQueue<() -> System.Void>()
        running = false
    }

    static val Default: TaskQueue {
        get {
            let queue = neoCLR.Runtime.GetDefaultTaskQueue<TaskQueue>()
            if queue is null {
                let created = TaskQueue()
                neoCLR.Runtime.RegisterTaskQueue(created)
                return created
            }
            return queue
        }
    }

    internal static val Current: TaskQueue {
        get {
            let queue = neoCLR.Runtime.GetCurrentTaskQueue<TaskQueue>()
            if queue is null {
                return TaskQueue.Default
            }
            return queue
        }
    }

    func Post(callback: () -> System.Void) {
        pending.Enqueue(callback)
    }

    func Run(callback: () -> System.Void) {
        if running {
            System.Fail("Task queue cannot be pumped recursively")
        }
        running = true
        callback()
        running = false
        self.Drain()
    }

    func Drain() {
        if running {
            System.Fail("Task queue cannot be pumped recursively")
        }
        running = true
        while pending.Count != 0 {
            // Dequeue clears the stored reference before invoking user code.
            // Newly posted work stays behind callbacks already in the FIFO.
            if pending.Dequeue() is Some(let callback) {
                callback()
            }
        }
        running = false
    }
}

public class Task<T> : System.Runtime.CompilerServices.TaskAwaiter {
    private field source: Promise<T>

    internal init(source: Promise<T>) {
        self.source = source
    }

    val IsCompleted: bool {
        get {
            return source.Completed()
        }
    }

    // Provisional compiler protocol; application code normally uses await or Outcome.
    val IsCancelled: bool {
        get {
            return source.Cancelled()
        }
    }

    val State: TaskState {
        get {
            if source.Cancelled() { return TaskState.Cancelled }
            if source.Completed() { return TaskState.Completed }
            return TaskState.Pending
        }
    }

    val Outcome: Option<TaskOutcome<T>> {
        get {
            if source.Cancelled() {
                let outcome: TaskOutcome<T> = Cancelled()
                return Some(outcome)
            }
            if source.Completed() {
                let outcome: TaskOutcome<T> = Completed(source.Read())
                return Some(outcome)
            }
            return None()
        }
    }

    internal func Dispatcher() -> TaskQueue => source.Dispatcher()

    func GetAwaiter() -> Task<T> => self

    func GetResult() -> T => source.Read()

    func OnCompleted(callback: () -> System.Void) {
        source.Register(callback)
    }
}

public class Promise<T> {
    private field queue: TaskQueue
    // Keep the array initialization marker so pending value results are not traced.
    private var slot: T[]
    private var hasResult: bool
    private field callbacks: ArrayList<() -> System.Void>?
    private field task: Task<T>
    private field cancelled: bool

    init() {
        queue = TaskQueue.Current
        cancelled = false
        slot = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(1)
        hasResult = false
        callbacks = null
        task = Task<T>(self)
    }

    init(queue: TaskQueue) {
        self.queue = queue
        cancelled = false
        slot = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(1)
        hasResult = false
        callbacks = null
        task = Task<T>(self)
    }

    val Task: Task<T> => task

    func Complete(value: T) -> bool {
        if self.Completed() {
            return false
        }
        slot[0] = value
        hasResult = true
        PostCallbacks()
        return true
    }

    func Cancel() -> bool {
        if self.Completed() {
            return false
        }
        cancelled = true
        PostCallbacks()
        return true
    }

    private func PostCallbacks() {
        let pending = callbacks
        callbacks = null
        if pending is ArrayList<() -> System.Void> registered {
            // Settlement precedes posting: later registrations go to the queue.
            var index = 0
            while index < registered.Count {
                queue.Post(registered[index])
                index += 1
            }
        }
    }

    internal func Dispatcher() -> TaskQueue => queue

    internal func Cancelled() -> bool => cancelled

    internal func Completed() -> bool => cancelled || hasResult

    internal func Read() -> T {
        if cancelled {
            System.Fail("Task is cancelled; consume its Outcome")
        }
        if !self.Completed() {
            System.Fail("Task is still pending")
        }
        return slot[0]
    }

    internal func Register(callback: () -> System.Void) {
        if self.Completed() {
            queue.Post(callback)
        } else if callbacks is ArrayList<() -> System.Void> pending {
            pending.Add(callback)
        } else {
            // The first callback is already known; avoid empty storage then growth.
            let pending = ArrayList<() -> System.Void>(1)
            pending.Add(callback)
            callbacks = pending
        }
    }
}

}

module System.Runtime.CompilerServices {
    import System.*
    import System.Option.*
    import System.Concurrency.Tasks.*

    public interface AsyncStateMachine {
        func MoveNext()
        func SetStateMachine(stateMachine: AsyncStateMachine)
    }

    public interface TaskAwaiter {
        func OnCompleted(callback: () -> System.Void)
    }

    public class AsyncTaskMethodBuilder<T> {
        private field source: Promise<T>
        private field machine: Option<AsyncStateMachine>

        init(queue: TaskQueue) {
            source = Promise<T>(queue)
            machine = None
        }

        static func Create() -> AsyncTaskMethodBuilder<T> {
            return AsyncTaskMethodBuilder<T>(TaskQueue.Current)
        }

        val Task: Task<T> => source.Task

        func Start(stateMachine: AsyncStateMachine) {
            stateMachine.MoveNext()
        }

        func SetStateMachine(stateMachine: AsyncStateMachine) {
            machine = Some(stateMachine)
        }

        func HasStateMachine() -> bool {
            return machine is Some(_)
        }

        func GetStateMachine() -> AsyncStateMachine {
            if let Some(state) = machine {
                return state
            }
            System.Fail("Async state has not been retained")
            return GetStateMachine()
        }

        func SetResult(value: T) {
            machine = None
            _ = source.Complete(value)
        }

        func SetCancelled() {
            machine = None
            _ = source.Cancel()
        }

        func AwaitOnCompleted(awaiter: TaskAwaiter, stateMachine: AsyncStateMachine) {
            awaiter.OnCompleted(stateMachine.MoveNext)
        }
    }
}
