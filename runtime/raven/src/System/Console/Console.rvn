module System

import System.*
import System.IO.*
import System.ConsoleReadError
import System.Result.*
import System.Option.*

public static class Console {
    private static var inputReader: SyncTextReader?

    /// <summary>Writes composite text.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arg0">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    /// <returns>Completion of output and flush.</returns>
    static func Write(format: string, arg0: object?) {
        return Write(String.Format(format, arg0))
    }

    /// <summary>Writes composite text.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arg0">Format arguments; null values produce empty text.</param>
    /// <param name="arg1">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    /// <returns>Completion of output and flush.</returns>
    static func Write(format: string, arg0: object?, arg1: object?) {
        return Write(String.Format(format, arg0, arg1))
    }

    /// <summary>Writes composite text.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arg0">Format arguments; null values produce empty text.</param>
    /// <param name="arg1">Format arguments; null values produce empty text.</param>
    /// <param name="arg2">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    /// <returns>Completion of output and flush.</returns>
    static func Write(format: string, arg0: object?, arg1: object?, arg2: object?) {
        return Write(String.Format(format, arg0, arg1, arg2))
    }

    /// <summary>Writes composite text.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arguments">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    /// <returns>Completion of output and flush.</returns>
    static func Write(format: string, params arguments: object?[]) {
        return Write(String.Format(format, arguments))
    }

    /// <summary>Writes composite text followed by a newline.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arg0">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    static func WriteLine(format: string, arg0: object?) {
        WriteLine(String.Format(format, arg0))
    }

    /// <summary>Writes composite text followed by a newline.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arg0">Format arguments; null values produce empty text.</param>
    /// <param name="arg1">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    static func WriteLine(format: string, arg0: object?, arg1: object?) {
        WriteLine(String.Format(format, arg0, arg1))
    }

    /// <summary>Writes composite text followed by a newline.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arg0">Format arguments; null values produce empty text.</param>
    /// <param name="arg1">Format arguments; null values produce empty text.</param>
    /// <param name="arg2">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    static func WriteLine(format: string, arg0: object?, arg1: object?, arg2: object?) {
        WriteLine(String.Format(format, arg0, arg1, arg2))
    }

    /// <summary>Writes composite text followed by a newline.</summary>
    /// <param name="format">Composite format text; see String.Format.</param>
    /// <param name="arguments">Format arguments; null values produce empty text.</param>
    /// <remarks>Uses String.Format syntax, grapheme alignment and limits. Formats before writing, so format errors emit no partial output.</remarks>
    static func WriteLine(format: string, params arguments: object?[]) {
        WriteLine(String.Format(format, arguments))
    }

    static func ReadByte() -> System.Result<System.Option<byte>, ConsoleReadError> {
        let payload = neoCLR.Runtime.ConsoleReadByte()
        if neoCLR.Runtime.IsValue<int>(payload) {
            let status = neoCLR.Runtime.UnpackValue<int>(payload)
            if status == 1 {
                return System.Result<System.Option<byte>, ConsoleReadError>.Error(ConsoleReadError.Unavailable())
            }
            if status == 2 {
                return System.Result<System.Option<byte>, ConsoleReadError>.Error(ConsoleReadError.ReadFailed())
            }
            System.Fail("invalid native I/O status")
            return System.Result<System.Option<byte>, ConsoleReadError>.Error(ConsoleReadError.ReadFailed())
        }
        if neoCLR.Runtime.IsValue<System.Void>(payload) {
            let absent: System.Option<byte> = None()
            return Ok(absent)
        }
        let present: System.Option<byte> = Some(neoCLR.Runtime.UnpackValue<byte>(payload))
        return Ok(present)
    }

    static func WriteLine(value0: string) {
        neoCLR.Runtime.WriteLine(value0)
    }

    static func WriteLine(value: object?) {
        if value is object present {
            WriteLine(present.ToString())
        } else {
            WriteLine()
        }
    }

    static func WriteLine(value0: int) {
        neoCLR.Runtime.WriteLine(neoCLR.Runtime.Int32ToString(value0))
    }

    static func WriteLine(value: bool) {
        WriteLine(if value { "True" } else { "False" })
    }

    static func WriteLine(value: char) {
        WriteLine(neoCLR.Runtime.CharText(value))
    }

    static func WriteLine(value: sbyte) {
        WriteLine(neoCLR.Runtime.Int32ToString(value))
    }

    static func WriteLine(value: byte) {
        WriteLine(neoCLR.Runtime.Int32ToString(value))
    }

    static func WriteLine(value: short) {
        WriteLine(neoCLR.Runtime.Int32ToString(value))
    }

    static func WriteLine(value: ushort) {
        WriteLine(neoCLR.Runtime.Int32ToString(value))
    }

    static func WriteLine(value: uint) {
        WriteLine(neoCLR.Runtime.UInt64ToString(value))
    }

    static func WriteLine(value: long) {
        WriteLine(neoCLR.Runtime.Int64ToString(value))
    }

    static func WriteLine(value: ulong) {
        WriteLine(neoCLR.Runtime.UInt64ToString(value))
    }

    static func WriteLine(value: nint) {
        WriteLine(neoCLR.Runtime.Int64ToString(neoCLR.Runtime.IntPtrToInt64(value)))
    }

    static func WriteLine(value: nuint) {
        WriteLine(neoCLR.Runtime.UInt64ToString(neoCLR.Runtime.UIntPtrToUInt64(value)))
    }

    // Fresh non-owning wrappers share the host's channels; closing one closes only it.
    static val In: SyncTextReader {
        get {
            if inputReader is SyncTextReader reader {
                return reader
            }
            let Ok(created) = SyncStreamReader.Create(OpenStandardInput(), true) else {
                System.Fail("Unable to create text wrapper")
            }
            inputReader = created
            return created
        }
    }
    static val Out: SyncTextWriter {
        get {
            let Ok(writer) = SyncStreamWriter.Create(OpenStandardOutput()) else {
                System.Fail("Unable to create console writer")
            }
            return writer
        }
    }
    static val Error: SyncTextWriter {
        get {
            let Ok(writer) = SyncStreamWriter.Create(OpenStandardError()) else {
                System.Fail("Unable to create console writer")
            }
            return writer
        }
    }

    static func OpenStandardInput() -> SyncInputStream => ConsoleInputStream()
    static func OpenStandardOutput() -> SyncOutputStream => ConsoleOutputStream(false)
    static func OpenStandardError() -> SyncOutputStream => ConsoleOutputStream(true)

    /// <summary>Peeks at the next UTF-8 grapheme without advancing Console.In.</summary>
    /// <returns>Returned Char, None at EOF, or a text read error.</returns>
    /// <remarks>May read ahead to find a grapheme boundary. Shares the invocation-owned text reader.</remarks>
    static func PeekChar() -> Result<Option<char>, TextReadError> => In.PeekChar()

    /// <summary>Reads one UTF-8 grapheme from the shared Console.In cursor.</summary>
    /// <returns>Returned Char, None at EOF, or a text read error.</returns>
    static func ReadChar() -> Result<Option<char>, TextReadError> => In.ReadChar()

    /// <summary>Reads a requested grapheme count, or the shorter remainder at EOF.</summary>
    /// <param name="count">Count from zero through 65536; zero consumes nothing.</param>
    /// <returns>Returned text or a text read error, with a 65536-byte result limit.</returns>
    static func Read(count: int) -> Result<string, TextReadError> => In.Read(count)

    /// <summary>Reads a requested grapheme count with a separate UTF-8 byte bound.</summary>
    /// <param name="count">Count from zero through 65536.</param>
    /// <param name="maxUtf8Bytes">Maximum result bytes, from zero through 65536.</param>
    /// <returns>Returned text, shorter at EOF, or a text read error.</returns>
    static func Read(count: int, maxUtf8Bytes: int) -> Result<string, TextReadError> => In.Read(count, maxUtf8Bytes)

    static func ReadLine() -> System.Result<System.Option<string>, TextReadError> {
        return In.ReadLine(65536)
    }

    static func ReadLine(maxUtf8Bytes: int) -> System.Result<System.Option<string>, TextReadError> {
        return In.ReadLine(maxUtf8Bytes)
    }

    static func Write(value0: string) {
        let writer = Out
        match writer.Write(value0) {
            Ok(_) => { }
            Error(_) => System.Fail("console output failed")
        }
        match writer.Flush() {
            Ok(_) => { }
            Error(_) => System.Fail("console output failed")
        }
        return ()
    }

    static func Write(value0: int) {
        return Write(neoCLR.Runtime.Int32ToString(value0))
    }

    static func WriteLine() {
        neoCLR.Runtime.WriteLine("")
    }
}
