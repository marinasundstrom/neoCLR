module System.IO

import System.*
import System.Result.*
import System.Option.*

// The current host console is blocking. Expose its actual capabilities directly.
internal class ConsoleInputStream : SyncInputStream {
    private var closed: bool = false

    internal init() { }

    func Read(buffer: Slice<byte>) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if buffer.Length > 65536 {
            return Error(StreamError.LimitExceeded)
        }
        if buffer.IsEmpty {
            return Ok(0)
        }
        return match System.Console.ReadByte() {
            Ok(Some(let value)) => {
                buffer[0] = value
                Ok(1)
            }
            Ok(None) => Ok(0)
            Error(_) => Error(StreamError.IoFailure)
        }
    }

    func Close() {
        closed = true
    }
}

internal class ConsoleOutputStream : SyncOutputStream {
    private val error: bool
    private var closed: bool = false

    internal init(error: bool) {
        self.error = error
    }

    func Write(buffer: ReadOnlySlice<byte>) -> Result<unit, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if buffer.Length > 65536 {
            return Error(StreamError.LimitExceeded)
        }
        var sent = 0
        while true {
            let payload = neoCLR.Runtime.ConsoleWriteBytes(error, buffer[sent..])
            if neoCLR.Runtime.IsValue<byte>(payload) {
                return Error(StreamError.IoFailure)
            }
            let written = neoCLR.Runtime.UnpackValue<int>(payload)
            if written < 0 || written > buffer.Length - sent {
                System.Fail("Invalid console output count")
            }
            sent += written
            if sent == buffer.Length {
                return Ok(())
            }
            if written == 0 {
                return Error(StreamError.IoFailure)
            }
        }
        return Error(StreamError.IoFailure)
    }

    func Flush() -> Result<unit, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        let payload = neoCLR.Runtime.ConsoleFlush(error)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Error(StreamError.IoFailure)
        }
        return Ok(())
    }

    func Close() {
        closed = true
    }
}
