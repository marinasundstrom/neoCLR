module System

import System.Result.*
import System.Runtime.CompilerServices.RuntimeServices

public struct UInt64 : Number {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: ulong

    static val Zero: ulong => (ulong)0
    static val One: ulong => (ulong)1

    static func +(left: ulong, right: ulong) -> ulong => (ulong)(left + right)
    static func -(left: ulong, right: ulong) -> ulong => (ulong)(left - right)
    static func *(left: ulong, right: ulong) -> ulong => (ulong)(left * right)
    static func /(left: ulong, right: ulong) -> ulong => (ulong)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<ulong, NumberParseError> {
        let payload = RuntimeServices.ParseUInt64(value)
        if RuntimeServices.IsValue<ulong>(payload) {
            return Ok(RuntimeServices.UnpackValue<ulong>(payload))
        }
        let status = RuntimeServices.UnpackValue<int>(payload)
        if status == 1 {
            return Error(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Error(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Error(NumberParseError.InvalidFormat())
    }

    func CompareTo(other: ulong) -> int {
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
