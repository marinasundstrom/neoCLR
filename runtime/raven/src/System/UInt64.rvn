namespace System

public struct UInt64 : Comparable<ulong> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: ulong

    func CompareTo(other: ulong) -> int {
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
