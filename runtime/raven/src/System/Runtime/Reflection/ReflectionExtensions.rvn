module System.Runtime.Reflection

import System.*
import System.Introspection.*
import System.Optional.*
import System.Result.*
import System.Runtime.CompilerServices.*

public extension TypeReflectionExtensions for TypeInfo {
    func CreateInstance(params arguments: Object?[]) -> Result<Object, ReflectionError> {
        if self is RuntimeNominalTypeInfo implementation {
            let handle = implementation.ExecutionHandle
            let status = neoCLR.Runtime.ReflectionConstructArgsCheck(handle, 0, null, arguments)
            if status == 0 {
                return Ok(neoCLR.Runtime.ReflectionConstructArgs(handle, 0, null, arguments))
            }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 2 {
                        return Failure(ReflectionError.UnsupportedType)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 4 {
                        return Failure(ReflectionError.MissingConstructor)
                    }
                    if status == 6 {
                        return Failure(ReflectionError.InvalidReceiver)
                    }
                    if status == 7 {
                        return Failure(ReflectionError.InvalidValue)
                    }
                    if status == 8 {
                        return Failure(ReflectionError.InvalidArguments)
                    }
                    if status == 9 {
                        return Failure(ReflectionError.AmbiguousConstructor)
                    }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }

    func CreateInstance<T>(params arguments: Object?[]) -> Result<T, ReflectionError> {
        if self is RuntimeNominalTypeInfo implementation {
            if !self.AssignableTo(typeof(T)) {
                return Failure(ReflectionError.InvalidResultType)
            }
            let instance = self.CreateInstance(arguments)?
            return Ok((T)instance)
        }
        return Failure(ReflectionError.UnboundMetadata)
    }


    func CreateInstance() -> Result<Object, ReflectionError> {
        if self is RuntimeNominalTypeInfo implementation {
            let handle = implementation.ExecutionHandle
            let status = NativeReflection.ReflectionConstructionCheck(handle)
            if status == 0 {
                return Ok(NativeReflection.ReflectionConstruct(handle))
            }
            if status == 1 {
                return Failure(ReflectionError.UnboundMetadata)
            }
            if status == 2 {
                return Failure(ReflectionError.UnsupportedType)
            }
            if status == 3 {
                return Failure(ReflectionError.AccessDenied)
            }
            return Failure(ReflectionError.MissingConstructor)
        }
        return Failure(ReflectionError.UnboundMetadata)
    }
}

public extension PropertyReflectionExtensions for PropertyInfo {
    func GetValue(receiver: Object?) -> Result<Object?, ReflectionError> {
        if self is RuntimePropertyInfo implementation {
            if let Some(owner) = implementation.DeclaringType {
                if owner is RuntimeNominalTypeInfo runtimeOwner {
                    let handle = runtimeOwner.ExecutionHandle
                    let status = neoCLR.Runtime.ReflectionPropertyGetCheck(handle, implementation.DefinitionIndex, receiver)
                    if status == 0 {
                        let value: Object? = neoCLR.Runtime.ReflectionPropertyGet(handle, implementation.DefinitionIndex, receiver)
                        return Ok(value)
                    }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 5 {
                        return Failure(ReflectionError.MissingAccessor)
                    }
                    if status == 6 {
                        return Failure(ReflectionError.InvalidReceiver)
                    }
                    return Failure(ReflectionError.UnsupportedProperty)
                }
            }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }

    func SetValue(receiver: Object?, value: Object?) -> Result<(), ReflectionError> {
        if self is RuntimePropertyInfo implementation {
            if let Some(owner) = implementation.DeclaringType {
                if owner is RuntimeNominalTypeInfo runtimeOwner {
                    let handle = runtimeOwner.ExecutionHandle
                    let status = neoCLR.Runtime.ReflectionPropertySetCheck(handle, implementation.DefinitionIndex, receiver, value)
                    if status == 0 {
                        neoCLR.Runtime.ReflectionPropertySet(handle, implementation.DefinitionIndex, receiver, value)
                        return Ok(())
                    }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 5 {
                        return Failure(ReflectionError.MissingAccessor)
                    }
                    if status == 6 {
                        return Failure(ReflectionError.InvalidReceiver)
                    }
                    if status == 7 {
                        return Failure(ReflectionError.InvalidValue)
                    }
                    return Failure(ReflectionError.UnsupportedProperty)
                }
            }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }
}

public extension MethodReflectionExtensions for MethodInfo {
    func Invoke(receiver: Object?, params arguments: Object?[]) -> Result<Object?, ReflectionError> {
        if self is RuntimeMethodInfo implementation {
            if let Some(owner) = implementation.DeclaringType {
                if owner is RuntimeNominalTypeInfo runtimeOwner && implementation.DefinitionIndex is Some(let index) {
                    let handle = runtimeOwner.ExecutionHandle
                    let status = neoCLR.Runtime.ReflectionInvokeCheck(handle, index, receiver, arguments)
                    if status == 0 {
                        let value: Object? = neoCLR.Runtime.ReflectionInvoke(handle, index, receiver, arguments)
                        return Ok(value)
                    }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 2 {
                        return Failure(ReflectionError.UnsupportedMethod)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 4 {
                        return Failure(ReflectionError.UnsupportedMethod)
                    }
                    if status == 6 {
                        return Failure(ReflectionError.InvalidReceiver)
                    }
                    if status == 7 {
                        return Failure(ReflectionError.InvalidValue)
                    }
                    if status == 8 {
                        return Failure(ReflectionError.InvalidArguments)
                    }
                    if status == 9 {
                        return Failure(ReflectionError.AmbiguousConstructor)
                    }
                }
            }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }
}

public extension FieldReflectionExtensions for FieldInfo {
    func GetValue(receiver: Object?) -> Result<Object?, ReflectionError> {
        if self is RuntimeFieldInfo implementation {
            if let Some(owner) = implementation.DeclaringType {
                if owner is RuntimeNominalTypeInfo runtimeOwner {
                    let handle = runtimeOwner.ExecutionHandle
                    let status = neoCLR.Runtime.ReflectionFieldGetCheck(handle, implementation.DefinitionIndex, receiver, [])
                    if status == 0 {
                        let value: Object? = neoCLR.Runtime.ReflectionFieldGet(handle, implementation.DefinitionIndex, receiver, [])
                        return Ok(value)
                    }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 2 {
                        return Failure(ReflectionError.UnsupportedField)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 4 {
                        return Failure(ReflectionError.UnsupportedField)
                    }
                    if status == 6 {
                        return Failure(ReflectionError.InvalidReceiver)
                    }
                    if status == 7 {
                        return Failure(ReflectionError.InvalidValue)
                    }
                    if status == 8 {
                        return Failure(ReflectionError.InvalidArguments)
                    }
                    if status == 9 {
                        return Failure(ReflectionError.AmbiguousConstructor)
                    }
                }
            }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }
    func SetValue(receiver: Object?, value: Object?) -> Result<(), ReflectionError> {
        if self is RuntimeFieldInfo implementation {
            if let Some(owner) = implementation.DeclaringType {
                if owner is RuntimeNominalTypeInfo runtimeOwner {
                    let handle = runtimeOwner.ExecutionHandle
                    let status = neoCLR.Runtime.ReflectionFieldSetCheck(handle, implementation.DefinitionIndex, receiver, [value])
                    if status == 0 {
                        let _ = neoCLR.Runtime.ReflectionFieldSet(handle, implementation.DefinitionIndex, receiver, [value])
                        return Ok(())
                    }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 2 {
                        return Failure(ReflectionError.UnsupportedField)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 4 {
                        return Failure(ReflectionError.UnsupportedField)
                    }
                    if status == 6 {
                        return Failure(ReflectionError.InvalidReceiver)
                    }
                    if status == 7 {
                        return Failure(ReflectionError.InvalidValue)
                    }
                    if status == 8 {
                        return Failure(ReflectionError.InvalidArguments)
                    }
                    if status == 9 {
                        return Failure(ReflectionError.AmbiguousConstructor)
                    }
                }
            }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }
}

public extension ConstructorReflectionExtensions for ConstructorInfo {
    func Invoke(arguments: System.Collections.Sequence<Object?>) -> Result<Object, ReflectionError> {
        let snapshot = CheckedStorage.Reserve<Object?>(arguments.Count)
        for index in 0..arguments.Count {
            snapshot[index] = arguments[index]
        }
        return self.Invoke(snapshot)
    }

    func Invoke(params arguments: Object?[]) -> Result<Object, ReflectionError> {
        if self is RuntimeConstructorInfo implementation {
            if let Some(owner) = implementation.DeclaringType {
                if owner is RuntimeNominalTypeInfo runtimeOwner {
                    let handle = runtimeOwner.ExecutionHandle
                    let status = neoCLR.Runtime.ReflectionConstructorInvokeCheck(handle, implementation.DefinitionIndex, null, arguments)
                    if status == 0 {
                        return Ok(neoCLR.Runtime.ReflectionConstructorInvoke(handle, implementation.DefinitionIndex, null, arguments))
                    }
                    if status == 1 {
                        return Failure(ReflectionError.UnboundMetadata)
                    }
                    if status == 2 {
                        return Failure(ReflectionError.UnsupportedType)
                    }
                    if status == 3 {
                        return Failure(ReflectionError.AccessDenied)
                    }
                    if status == 4 {
                        return Failure(ReflectionError.MissingConstructor)
                    }
                    return Failure(ReflectionError.InvalidArguments)
                }
            }
        }
        return Failure(ReflectionError.UnboundMetadata)
    }
}
