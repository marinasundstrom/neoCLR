namespace System.Runtime.Reflection

public union ReflectionError {
    case UnboundMetadata
    case UnsupportedType
    case AccessDenied
    case MissingConstructor
    case UnsupportedProperty
    case MissingAccessor
    case InvalidReceiver
    case UnsupportedMethod
    case UnsupportedField
    case InvalidArguments
    case AmbiguousConstructor
    case InvalidResultType
    case InvalidValue
}
