module System.Runtime.CompilerServices

/// Library operations used by compiler lowering.
public static class RuntimeHelpers {
    /// Compiler startup hook that drains registered entry work before observing its result.
    /// Reentrant pumping and invocation from a task callback fault.
    static func DrainEntryTasks() {
        neoCLR.Runtime.DrainEntryTasks()
    }

    /// Tests assignment from TSource to TTarget using declared types, without creating type descriptors.
    /// Used by generated generic value semantics; does not inspect an object's runtime type.
    static func IsAssignable<TSource, TTarget>() -> bool {
        return neoCLR.Runtime.ReflectionAssignable(neoCLR.Runtime.TypeHandle<TSource>(), neoCLR.Runtime.TypeHandle<TTarget>())
    }

    /// Compares exact runtime type identities without allocating reflection descriptors.
    /// Both objects must be non-null. Used by generated record-class equality.
    static func HaveSameRuntimeType(left: object, right: object) -> bool {
        return neoCLR.Runtime.TypeEquals(neoCLR.Runtime.ObjectTypeHandle(left), neoCLR.Runtime.ObjectTypeHandle(right))
    }

    /// Borrows a range without copying; invalid ranges fault.
    static func GetSlice<T>(array: T[], range: System.Range) -> System.Slice<T> {
        let bounds = range.GetOffsetAndLength(array.Length)
        return neoCLR.Runtime.ViewCreateSlice<T>(array, bounds.Item1, bounds.Item2)
    }

    internal static func CopyRange<T>(array: T[], offset: int, count: int) -> T[] {
        let result = CheckedStorage.Reserve<T>(count)
        var index = 0
        while index < count {
            result[index] = array[offset + index]
            index += 1
        }
        return result
    }
}
