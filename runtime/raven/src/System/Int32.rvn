namespace System

import System.Result.*
import System.Runtime.CompilerServices.RuntimeServices

public struct Int32 : Number, EquatableTo<int> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: int

    static func Parse(value: string) -> Result<int, NumberParseError> {
        let payload = RuntimeServices.ParseInt32(value)
        if RuntimeServices.IsValue<int>(payload) {
            return Ok(RuntimeServices.UnpackValue<int>(payload))
        }
        let status = RuntimeServices.UnpackValue<byte>(payload)
        if status == 1 {
            return Error(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Error(NumberParseError.Overflow())
        }
        System.Fault("invalid native parse status")
        return Error(NumberParseError.InvalidFormat())
    }

    static func Divide(dividend: int, divisor: int) -> System.Result<int, IntegerDivisionError> {
        if divisor == 0 {
            return Error(IntegerDivisionError.DivisionByZero())
        }
        if dividend == -2147483648 && divisor == -1 {
            return Error(IntegerDivisionError.Overflow())
        }
        return Ok(dividend / divisor)
    }

    func Equals(other: int) -> bool {
        return m_value == other
    }

    func ToString() -> string {
        return RuntimeServices.Int32ToString(m_value)
    }

    static val Zero: int => (int)0
    static val One: int => (int)1

    static func +(left: int, right: int) -> int => (int)(left + right)
    static func -(left: int, right: int) -> int => (int)(left - right)
    static func *(left: int, right: int) -> int => (int)(left * right)
    static func /(left: int, right: int) -> int => (int)(left / right)

    func CompareTo(other: int) -> int {
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
