module System

/// Formats a value with a type-defined format and an explicit supported culture.
public interface Formattable {
    /// Formats using a non-null format and culture; empty requests the type's default representation.
    /// Implementations validate specifiers. Culture is explicit; custom format providers are not supported.
    /// String.Format without a culture resolves Culture.Current once, when a formattable item is first used.
    func ToString(format: string, culture: Globalization.Culture) -> string
}
