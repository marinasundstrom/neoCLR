module System

import System.Result.*
import System.Runtime.CompilerServices.RuntimeServices

public struct Double : Number {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: double

    static val Zero: double => (double)0
    static val One: double => (double)1

    static func +(left: double, right: double) -> double => (double)(left + right)
    static func -(left: double, right: double) -> double => (double)(left - right)
    static func *(left: double, right: double) -> double => (double)(left * right)
    static func /(left: double, right: double) -> double => (double)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<double, NumberParseError> {
        let payload = RuntimeServices.ParseDouble(value)
        if RuntimeServices.IsValue<double>(payload) {
            return Ok(RuntimeServices.UnpackValue<double>(payload))
        }
        let status = RuntimeServices.UnpackValue<int>(payload)
        if status == 1 {
            return Error(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Error(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Error(NumberParseError.InvalidFormat())
    }

    func CompareTo(other: double) -> int {
        if m_value != m_value {
            if other != other {
                return 0
            }
            return -1
        }
        if other != other {
            return 1
        }
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
