namespace System

public struct Double : Comparable<double> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: double

    func CompareTo(other: double) -> int {
        if m_value != m_value {
            if other != other {
                return 0
            }
            return -1
        }
        if other != other {
            return 1
        }
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
