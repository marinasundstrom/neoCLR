namespace System

import System.*
import System.Result.*

public union Result<T, E>: Propagatable<Result<T, E>, T, E> {
    /// Represents a successful result value.
    case Ok(T)

    /// Represents an error result.
    case Error(E)

    /// Attempts to extract the successful output used by the propagation protocol.
    func TryGetOutput(out output: T) -> bool {
        output = default
        if self is Ok(let value) {
            output = value
            return true
        }
        return false
    }

    /// Attempts to extract the residual used by the propagation protocol.
    func TryGetResidual(out residual: E) -> bool {
        residual = default
        if self is Error(let error) {
            residual = error
            return true
        }
        return false
    }

    /// Constructs an error result from a propagated residual.
    static func FromResidual(residual: E) -> Result<T, E> => Error(residual)

}
