namespace System.Threading

import System.*
import System.Tasks.*
import System.Runtime.CompilerServices.*

public class Thread {
    static func Start(callback: Func<string, string>, input: string) -> Task<string> {
        let queue = RuntimeServices.CurrentTaskQueue()
        let source = TaskCompletionSource<string>(queue)
        let handle = RuntimeServices.StartWorker(callback, input)
        let completion = WorkerCompletion(handle, source)
        queue.Post(completion.Complete)
        return source.Task
    }
}

public class ThreadPool {
    static func Queue(callback: Func<string, string>, input: string) -> Task<string> {
        let queue = RuntimeServices.CurrentTaskQueue()
        let source = TaskCompletionSource<string>(queue)
        let handle = RuntimeServices.QueueWorker(callback, input)
        let completion = WorkerCompletion(handle, source)
        queue.Post(completion.Complete)
        return source.Task
    }
}

internal class WorkerCompletion {
    private field handle: int
    private field source: TaskCompletionSource<string>

    internal init(handle: int, source: TaskCompletionSource<string>) {
        self.handle = handle
        self.source = source
    }

    internal func Complete() {
        _ = source.TrySetResult(RuntimeServices.JoinWorker(handle))
    }
}
