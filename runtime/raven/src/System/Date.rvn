namespace System

import System.Result.*

public struct Date : ComparableTo<Date>, EquatableTo<Date> {
    private field StoredDayNumber: int

    private init(dayNumber: int) {
        StoredDayNumber = dayNumber
    }

    static func Create(year: int, month: int, day: int) -> Result<Date, InvalidDateError> {
        if year < 1 {
            return Error(InvalidDateError())
        }
        if year > 9999 {
            return Error(InvalidDateError())
        }
        if month < 1 {
            return Error(InvalidDateError())
        }
        if month > 12 {
            return Error(InvalidDateError())
        }
        if day < 1 {
            return Error(InvalidDateError())
        }
        if day > DaysInMonth(year, month) {
            return Error(InvalidDateError())
        }
        return Ok(Date(DaysBeforeYear(year) + DaysBeforeMonth(year, month) + day - 1))
    }

    static func FromDayNumber(dayNumber: int) -> Result<Date, InvalidDateError> {
        if dayNumber < 0 {
            return Error(InvalidDateError())
        }
        if dayNumber > 3652058 {
            return Error(InvalidDateError())
        }
        return Ok(Date(dayNumber))
    }

    private static func DaysBeforeYear(year: int) -> int {
        let previous = year - 1
        return previous * 365 + previous / 4 - previous / 100 + previous / 400
    }

    private static func DaysInMonth(year: int, month: int) -> int {
        if month == 2 {
            if year % 4 != 0 {
                return 28
            }
            if year % 100 != 0 {
                return 29
            }
            if year % 400 != 0 {
                return 28
            }
            return 29
        }
        if month == 4 {
            return 30
        }
        if month == 6 {
            return 30
        }
        if month == 9 {
            return 30
        }
        if month == 11 {
            return 30
        }
        return 31
    }

    private static func DaysBeforeMonth(year: int, month: int) -> int {
        var current = 1
        var days = 0
        while current < month {
            days = days + DaysInMonth(year, current)
            current = current + 1
        }
        return days
    }

    val DayNumber: int => StoredDayNumber
    val Year: int {
        get {
            var remaining = StoredDayNumber
            var year = remaining / 146097 * 400
            remaining = remaining % 146097
            var cycles = remaining / 36524
            if cycles > 3 {
                cycles = 3
            }
            year = year + cycles * 100
            remaining = remaining - cycles * 36524
            year = year + remaining / 1461 * 4
            cycles = remaining % 1461 / 365
            if cycles > 3 {
                cycles = 3
            }
            return year + cycles + 1
        }
    }
    val DayOfYear: int => StoredDayNumber - DaysBeforeYear(Year) + 1
    val Month: int {
        get {
            let year = Year
            var remaining = DayOfYear
            var month = 1
            var length = DaysInMonth(year, month)
            while remaining > length {
                remaining = remaining - length
                month = month + 1
                length = DaysInMonth(year, month)
            }
            return month
        }
    }
    val Day: int => DayOfYear - DaysBeforeMonth(Year, Month)

    /// Adds calendar days, returning an error outside years 1–9999.
    func AddDays(days: int) -> Result<Date, InvalidDateError> {
        let target = (long)StoredDayNumber + days
        if target < 0L {
            return Error(InvalidDateError())
        }
        if target > 3652058L {
            return Error(InvalidDateError())
        }
        return FromDayNumber((int)target)
    }

    /// Adds months and clamps the day to the last day of the target month.
    func AddMonths(months: int) -> Result<Date, InvalidDateError> {
        let target = (long)(Year - 1) * 12L + Month - 1 + months
        if target < 0L {
            return Error(InvalidDateError())
        }
        if target > 119987L {
            return Error(InvalidDateError())
        }
        let year = (int)(target / 12L) + 1
        let month = (int)(target % 12L) + 1
        var day = Day
        let last = DaysInMonth(year, month)
        if day > last {
            day = last
        }
        return Create(year, month, day)
    }

    /// Adds years, clamping February 29 to February 28 when necessary.
    func AddYears(years: int) -> Result<Date, InvalidDateError> {
        if years < -9998 {
            return Error(InvalidDateError())
        }
        if years > 9998 {
            return Error(InvalidDateError())
        }
        return AddMonths(years * 12)
    }

    /// Formats using Culture.Current; pass Culture.Invariant for deterministic output.
    override func ToString() -> string {
        return ToString(Globalization.Culture.Current)
    }

    /// Formats with a culture's Gregorian default; no ambient culture is read.
    func ToString(culture: Globalization.Culture) -> string {
        let Ok(text) = culture.DateTimeFormat.FormatDate(self) else {
            System.Fail("A supported culture must format every valid Date")
        }
        return text
    }

    func Equals(other: Date) -> bool {
        return StoredDayNumber == other.StoredDayNumber
    }

    func CompareTo(other: Date) -> int {
        if StoredDayNumber < other.StoredDayNumber {
            return -1
        }
        if StoredDayNumber > other.StoredDayNumber {
            return 1
        }
        return 0
    }
}
