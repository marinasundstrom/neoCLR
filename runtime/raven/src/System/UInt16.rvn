module System

import System.Result.*

public struct UInt16 : Number, EquatableTo<ushort>, Formattable {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: ushort

    static val Zero: ushort => (ushort)0
    static val One: ushort => (ushort)1

    static func +(left: ushort, right: ushort) -> ushort => (ushort)(left + right)
    static func -(left: ushort, right: ushort) -> ushort => (ushort)(left - right)
    static func *(left: ushort, right: ushort) -> ushort => (ushort)(left * right)
    static func /(left: ushort, right: ushort) -> ushort => (ushort)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<ushort, NumberParseError> {
        let payload = neoCLR.Runtime.ParseUInt16(value)
        if neoCLR.Runtime.IsValue<ushort>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<ushort>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<int>(payload)
        if status == 1 {
            return Failure(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Failure(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Failure(NumberParseError.InvalidFormat())
    }

    /// Tests equality with another value of the same type without boxing.
    func Equals(other: ushort) -> bool => m_value == other

    /// Parses explicit culture punctuation with strict three-digit grouping; whitespace is not accepted.
    static func Parse(text: string, culture: Globalization.Culture) -> Result<ushort, NumberParseError> {
        let normalized = Globalization.NumericParsing.Normalize(text, culture, false)?
        return Parse(normalized)
    }

    /// Formats with the current culture using empty/G/G0, D, F or N; precision is 0–99.
    func ToString(format: string) -> string => ToString(format, Globalization.Culture.Current)

    /// Formats with explicit culture; unsupported formats or precision fault.
    func ToString(format: string, culture: Globalization.Culture) -> string {
        return Globalization.IntegerFormatting.FormatUnsigned((ulong)m_value, format, culture)
    }

    func CompareTo(other: ushort) -> int {
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
