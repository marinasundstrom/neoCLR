module System

import System.Option.*
import System.Result.*

public extension OptionOperators<T> for Option<T> {
    func Map<U>(mapper: (T) -> U) -> Option<U> {
        return self match {
            Some(let value) => Some(mapper(value))
            None => None
        }
    }

    func Then<U>(binder: (T) -> Option<U>) -> Option<U> {
        return self match {
            Some(let value) => binder(value)
            None => None
        }
    }

    func Filter(predicate: (T) -> bool) -> Option<T> {
        if self is Some(let value) {
            if predicate(value) {
                return self
            }
        }
        return None
    }

    func OrElse(alternative: () -> Option<T>) -> Option<T> {
        return self match {
            Some(_) => self
            None => alternative()
        }
    }

    func UnwrapOrElse(factory: () -> T) -> T {
        return self match {
            Some(let value) => value
            None => factory()
        }
    }

    func UnwrapOr(defaultValue: T) -> T {
        return self match {
            Some(let value) => value
            None => defaultValue
        }
    }

    func Match<U>(some: (T) -> U, none: () -> U) -> U {
        return self match {
            Some(let value) => some(value)
            None => none()
        }
    }

    func Tap(action: (T) -> System.Void) -> Option<T> {
        if self is Some(let value) {
            action(value)
        }
        return self
    }

    func TapNone(action: () -> System.Void) -> Option<T> {
        if self is None {
            action()
        }
        return self
    }

    func ToIterable() -> Collections.Iterable<T> {
        let values = Collections.ArrayList<T>()
        if self is Some(let value) {
            values.Add(value)
        }
        return values
    }

    func ThenResult<U, E>(binder: (T) -> Result<U, E>, noneError: () -> E) -> Result<U, E> {
        return self match {
            Some(let value) => binder(value)
            None => Error(noneError())
        }
    }

    func MapResult<U, E>(mapper: (T) -> U, noneError: () -> E) -> Result<U, E> {
        return self match {
            Some(let value) => Ok(mapper(value))
            None => Error(noneError())
        }
    }

    func OkOr<E>(error: E) -> Result<T, E> {
        return self match {
            Some(let value) => Ok(value)
            None => Error(error)
        }
    }

    func OkOr<E>(errorFactory: () -> E) -> Result<T, E> {
        return self match {
            Some(let value) => Ok(value)
            None => Error(errorFactory())
        }
    }

}

public extension OptionNestedOperators<T> for Option<Option<T>> {
    func Flatten() -> Option<T> {
        return self match {
            Some(let value) => value
            None => None
        }
    }
}
