namespace System.Data.Json

import System.*
import System.IO.*
import System.Introspection.*
import System.Result.*

// Provisional DOM codec and shallow object mapping; all I/O is synchronous.
public class JsonSerializer {
    private init() { }

    static func Deserialize(text: string) -> Result<JsonValue, JsonError> {
        if text.GetUtf8ByteCount() > 128 {
            return Error(JsonError.LimitExceeded("Document exceeds 128 UTF-8 bytes"))
        }
        return DocumentReader(text).Read()
    }

    static func Deserialize(input: InputStream) -> Result<JsonValue, JsonError> {
        let reader = StreamReader(input, true)
        let result = reader.ReadToEnd(128)
        reader.Close()
        return match result {
            Ok(let text) => Deserialize(text)
            Error(let error) => Error(JsonError.Read(error))
        }
    }

    static func Serialize(value: JsonValue) -> Result<string, JsonError> {
        return DocumentWriter().Write(value)
    }

    static func Serialize(output: OutputStream, value: JsonValue) -> Result<unit, JsonError> {
        // Validate the whole document before writing any bytes.
        let text = Serialize(value)?
        let writer = StreamWriter(output, true)
        let result = writer.Write(text)
        writer.Close()
        return match result {
            Ok(_) => Ok(())
            Error(let error) => Error(JsonError.Write(error))
        }
    }

    static func Deserialize(text: string, type: TypeInfo) -> Result<Object, JsonError> {
        let document = Deserialize(text)?
        return ObjectMapper.Read(document, type)
    }

    static func Deserialize(input: InputStream, type: TypeInfo) -> Result<Object, JsonError> {
        let document = Deserialize(input)?
        return ObjectMapper.Read(document, type)
    }

    static func Serialize(value: Object) -> Result<string, JsonError> {
        if value is JsonValue document {
            return Serialize(document)
        }
        let mapped = ObjectMapper.Write(value)?
        return Serialize(mapped)
    }

    static func Serialize(output: OutputStream, value: Object) -> Result<unit, JsonError> {
        if value is JsonValue document {
            return Serialize(output, document)
        }
        let mapped = ObjectMapper.Write(value)?
        return Serialize(output, mapped)
    }
}
