module System.Data.Json

import System.*
import System.Diagnostics.CodeAnalysis.*
import System.Concurrency.Tasks.*
import System.IO.*
import System.Introspection.*
import System.Result.*

// Provisional DOM codec and bounded nested object mapping; stream I/O returns Tasks; in-memory conversion remains immediate.
public class JsonSerializer {
    private init() { }

    static func DeserializeNode(text: string) -> Result<JsonValue, JsonError> {
        if text.GetUtf8ByteCount() > 1024 {
            return Failure(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        return DocumentReader().Read(text.Utf8Bytes)
    }

    /// <summary>Parses a borrowed UTF-8 byte window into independently owned JSON values.</summary>
    /// <param name="utf8">The complete document, borrowed only during this call.</param>
    /// <returns>A JSON node or a quota, UTF-8 or syntax error. The 1024-byte limit is checked before UTF-8; complete UTF-8 validation precedes JSON parsing.</returns>
    static func DeserializeNode(utf8: ReadOnlySlice<byte>) -> Result<JsonValue, JsonError> {
        if utf8.Length > 1024 {
            return Failure(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        if !JsonSyntax.ValidUtf8(utf8) {
            return Failure(JsonError.Read(TextReadError.InvalidUtf8))
        }
        return DocumentReader().Read(utf8)
    }

    async static func DeserializeNode(input: InputStream) -> Task<Result<JsonValue, JsonError>> {
        let reader = match StreamReader.Create(input, true) {
            Ok(let value) => value
            Failure(let error) => return Failure(JsonError.Read(error))
        }
        let result = await reader.ReadToEnd(1024)
        reader.Close()
        return match result {
            Ok(let text) => DeserializeNode(text)
            Failure(let error) => Failure(JsonError.Read(error))
        }
    }

    static func SerializeNode(value: JsonValue) -> Result<string, JsonError> {
        return DocumentWriter(false).Write(value)
    }

    /// <summary>Serializes a JSON node with compact or indented formatting.</summary>
    /// <param name="value">The node to serialize.</param>
    /// <param name="options">Output formatting options.</param>
    /// <returns>JSON text or a validation/quota error. Formatting counts toward the UTF-8 output limit.</returns>
    static func SerializeNode(value: JsonValue, options: JsonSerializerOptions) -> Result<string, JsonError> {
        return DocumentWriter(options.WriteIndented).Write(value)
    }

    async static func SerializeNode(output: OutputStream, value: JsonValue) -> Task<Result<unit, JsonError>> {
        // Keep the default path free of an options allocation.
        let bytes = DocumentWriter(false).WriteBytes(value)?
        let result = await output.Write(bytes, 0, bytes.Length)
        return match result {
            Ok(_) => Ok(())
            Failure(let error) => Failure(JsonError.Write(error))
        }
    }

    /// <summary>Validates and serializes a node with the selected formatting before writing to the stream.</summary>
    /// <param name="output">Destination stream, left open.</param>
    /// <param name="value">The node to serialize.</param>
    /// <param name="options">Output formatting options.</param>
    /// <returns>Success or a validation, quota or stream error.</returns>
    async static func SerializeNode(output: OutputStream, value: JsonValue, options: JsonSerializerOptions) -> Task<Result<unit, JsonError>> {
        // Validate the whole document before writing any bytes.
        let bytes = DocumentWriter(options.WriteIndented).WriteBytes(value)?
        let result = await output.Write(bytes, 0, bytes.Length)
        return match result {
            Ok(_) => Ok(())
            Failure(let error) => Failure(JsonError.Write(error))
        }
    }

    /// <summary>Serializes an object or JSON node directly into owned UTF-8 bytes.</summary>
    /// <param name="value">The supported object or JSON node.</param>
    /// <returns>A newly owned compact JSON array or a mapping, validation or quota error.</returns>
    /// <remarks>The 1024-byte document, 32-value and four-level depth limits apply. No document string is created.</remarks>
    static func SerializeToUtf8Bytes(value: Object) -> Result<byte[], JsonError> {
        if value is JsonValue document {
            return DocumentWriter(false).WriteBytes(document)
        }
        return DocumentWriter(false).WriteBytes(ObjectMapper.Write(value)?)
    }

    /// <summary>Serializes an object or JSON node directly into owned UTF-8 bytes with selected formatting.</summary>
    /// <param name="value">The supported object or JSON node.</param>
    /// <param name="options">Output formatting, included in the document byte limit.</param>
    /// <returns>A newly owned JSON array or a mapping, validation or quota error.</returns>
    /// <remarks>All validation completes before returning. The caller owns the returned bytes.</remarks>
    static func SerializeToUtf8Bytes(value: Object, options: JsonSerializerOptions) -> Result<byte[], JsonError> {
        if value is JsonValue document {
            return DocumentWriter(options.WriteIndented).WriteBytes(document)
        }
        return DocumentWriter(options.WriteIndented).WriteBytes(ObjectMapper.Write(value)?)
    }

    static func Deserialize<T>(text: string) -> Result<T, JsonError> {
        let instance = Deserialize(text, typeof(T))?
        return Ok((T)instance)
    }

    /// <summary>Deserializes a complete borrowed UTF-8 document using the supported object mapping contract.</summary>
    /// <param name="utf8">The complete document, borrowed only during this call.</param>
    /// <returns>An independently owned value or a quota, UTF-8, syntax or mapping error.</returns>
    static func Deserialize<T>(utf8: ReadOnlySlice<byte>) -> Result<T, JsonError> {
        let instance = Deserialize(utf8, typeof(T))?
        return Ok((T)instance)
    }

    async static func Deserialize<T>(input: InputStream) -> Task<Result<T, JsonError>> {
        let instance = await Deserialize(input, typeof(T))?
        return Ok((T)instance)
    }

    static func Deserialize(text: string, [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] type: TypeInfo) -> Result<Object, JsonError> {
        let document = DeserializeNode(text)?
        return ObjectMapper.Read(document, type)
    }

    /// <summary>Deserializes a complete borrowed UTF-8 document into the specified supported type.</summary>
    /// <param name="utf8">The complete document, borrowed only during this call.</param>
    /// <param name="type">The supported target type.</param>
    /// <returns>An independently owned object or a quota, UTF-8, syntax or mapping error.</returns>
    static func Deserialize(utf8: ReadOnlySlice<byte>, [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] type: TypeInfo) -> Result<Object, JsonError> {
        let document = DeserializeNode(utf8)?
        return ObjectMapper.Read(document, type)
    }

    async static func Deserialize(input: InputStream, [DynamicallyAccessedMembers(DynamicallyAccessedMemberTypes.PublicParameterlessConstructor | DynamicallyAccessedMemberTypes.PublicProperties)] type: TypeInfo) -> Task<Result<Object, JsonError>> {
        let document = await DeserializeNode(input)?
        return ObjectMapper.Read(document, type)
    }

    static func Serialize(value: Object) -> Result<string, JsonError> {
        if value is JsonValue document {
            return SerializeNode(document)
        }
        let mapped = ObjectMapper.Write(value)?
        return SerializeNode(mapped)
    }

    /// <summary>Serializes an object or JSON node using the selected output formatting.</summary>
    /// <param name="value">The supported object or JSON node.</param>
    /// <param name="options">Output formatting options.</param>
    /// <returns>JSON text or a mapping, validation or quota error.</returns>
    static func Serialize(value: Object, options: JsonSerializerOptions) -> Result<string, JsonError> {
        if value is JsonValue document {
            return SerializeNode(document, options)
        }
        let mapped = ObjectMapper.Write(value)?
        return SerializeNode(mapped, options)
    }

    async static func Serialize(output: OutputStream, value: Object) -> Task<Result<unit, JsonError>> {
        if value is JsonValue document {
            return await SerializeNode(output, document)
        }
        let mapped = ObjectMapper.Write(value)?
        return await SerializeNode(output, mapped)
    }

    /// <summary>Serializes an object or JSON node with selected formatting to a stream left open.</summary>
    /// <param name="output">Destination stream.</param>
    /// <param name="value">The supported object or JSON node.</param>
    /// <param name="options">Output formatting options.</param>
    /// <returns>Success or a mapping, validation, quota or stream error.</returns>
    async static func Serialize(output: OutputStream, value: Object, options: JsonSerializerOptions) -> Task<Result<unit, JsonError>> {
        if value is JsonValue document {
            return await SerializeNode(output, document, options)
        }
        let mapped = ObjectMapper.Write(value)?
        return await SerializeNode(output, mapped, options)
    }

}
