namespace System.Data.Json

import System.*
import System.IO.*
import System.Introspection.*
import System.Result.*

// Provisional DOM codec and bounded nested object mapping; all I/O is synchronous.
public class JsonSerializer {
    private init() { }

    static func DeserializeNode(text: string) -> Result<JsonValue, JsonError> {
        if text.GetUtf8ByteCount() > 1024 {
            return Error(JsonError.LimitExceeded("Document exceeds 1024 UTF-8 bytes"))
        }
        return DocumentReader(text).Read()
    }

    static func DeserializeNode(input: InputStream) -> Result<JsonValue, JsonError> {
        let reader = StreamReader(input, true)
        let result = reader.ReadToEnd(1024)
        reader.Close()
        return match result {
            Ok(let text) => DeserializeNode(text)
            Error(let error) => Error(JsonError.Read(error))
        }
    }

    static func SerializeNode(value: JsonValue) -> Result<string, JsonError> {
        return DocumentWriter().Write(value)
    }

    static func SerializeNode(output: OutputStream, value: JsonValue) -> Result<unit, JsonError> {
        // Validate the whole document before writing any bytes.
        let text = SerializeNode(value)?
        let writer = StreamWriter(output, true)
        let result = writer.Write(text)
        writer.Close()
        return match result {
            Ok(_) => Ok(())
            Error(let error) => Error(JsonError.Write(error))
        }
    }

    static func Deserialize<T>(text: string) -> Result<T, JsonError> {
        let instance = Deserialize(text, typeof(T))?
        return Ok((T)instance)
    }

    static func Deserialize<T>(input: InputStream) -> Result<T, JsonError> {
        let instance = Deserialize(input, typeof(T))?
        return Ok((T)instance)
    }

    static func Deserialize(text: string, type: TypeInfo) -> Result<Object, JsonError> {
        let document = DeserializeNode(text)?
        return ObjectMapper.Read(document, type)
    }

    static func Deserialize(input: InputStream, type: TypeInfo) -> Result<Object, JsonError> {
        let document = DeserializeNode(input)?
        return ObjectMapper.Read(document, type)
    }

    static func Serialize(value: Object) -> Result<string, JsonError> {
        if value is JsonValue document {
            return SerializeNode(document)
        }
        let mapped = ObjectMapper.Write(value)?
        return SerializeNode(mapped)
    }

    static func Serialize(output: OutputStream, value: Object) -> Result<unit, JsonError> {
        if value is JsonValue document {
            return SerializeNode(output, document)
        }
        let mapped = ObjectMapper.Write(value)?
        return SerializeNode(output, mapped)
    }
}
