module System.Data.Json

import System.*
import System.Collections.*
import System.Result.*
import System.Text.*

internal class JsonSyntax {
    // Callers preflight JSON's 1024-byte document/token bound before conversion.
    internal static func EncodeToken(text: string) -> Sequence<byte> {
        return match Encodings.Utf8.Encode(text) {
            Ok(let bytes) => bytes
            Error(_) => {
                System.Fail("Prevalidated JSON token encoding failed")
                ArrayList<byte>()
            }
        }
    }

    static func TokenEquals(bytes: ReadOnlySlice<byte>, text: string) -> bool {
        let expected = text.Utf8Bytes
        let length = bytes.Length
        if length != expected.Length {
            return false
        }
        var index = 0
        while index < length {
            if bytes[index] != expected[index] {
                return false
            }
            index += 1
        }
        return true
    }

    // Validate the complete byte document before reporting JSON syntax errors.
    // No decoded text or temporary byte array is needed.
    static func ValidUtf8(bytes: ReadOnlySlice<byte>) -> bool {
        let length = bytes.Length
        var index = 0
        while index < length {
            let first = bytes[index]
            if first <= 127 {
                index += 1
            } else {
                var width = 0
                var lower = 128
                var upper = 191
                if first >= 194 && first <= 223 {
                    width = 2
                } else if first >= 224 && first <= 239 {
                    width = 3
                    if first == 224 {
                        lower = 160
                    } else if first == 237 {
                        upper = 159
                    }
                } else if first >= 240 && first <= 244 {
                    width = 4
                    if first == 240 {
                        lower = 144
                    } else if first == 244 {
                        upper = 143
                    }
                } else {
                    return false
                }
                if length - index < width {
                    return false
                }
                let second = bytes[index + 1]
                if second < lower || second > upper {
                    return false
                }
                let end = index + width
                index += 2
                while index < end {
                    let next = bytes[index]
                    if next < 128 || next > 191 {
                        return false
                    }
                    index += 1
                }
            }
        }
        return true
    }

    static func Digit(value: byte) -> bool {
        return value >= 48 && value <= 57
    }

    // Preserve number text: recognizing JSON grammar must not round to a host number.
    static func ValidNumber(text: string) -> bool {
        let count = text.GetUtf8ByteCount()
        if count == 0 || count > 1024 {
            return false
        }
        let bytes = text.Utf8Bytes
        var index = 0
        if bytes[index] == 45 {
            index += 1
        }
        if index == count {
            return false
        }
        if bytes[index] == 48 {
            index += 1
        } else {
            if !(bytes[index] >= 49 && bytes[index] <= 57) {
                return false
            }
            while index < count && Digit(bytes[index]) {
                index += 1
            }
        }
        if index < count && bytes[index] == 46 {
            index += 1
            let start = index
            while index < count && Digit(bytes[index]) {
                index += 1
            }
            if index == start {
                return false
            }
        }
        if index < count && (bytes[index] == 101 || bytes[index] == 69) {
            index += 1
            if index < count && (bytes[index] == 43 || bytes[index] == 45) {
                index += 1
            }
            let start = index
            while index < count && Digit(bytes[index]) {
                index += 1
            }
            if index == start {
                return false
            }
        }
        return index == count
    }

    static func HexDigit(value: int) -> int {
        if value >= 48 && value <= 57 {
            return value - 48
        }
        if value >= 65 && value <= 70 {
            return value - 55
        }
        if value >= 97 && value <= 102 {
            return value - 87
        }
        return -1
    }

    static func Whitespace(value: byte) -> bool {
        return value == 32 || value == 9 || value == 10 || value == 13
    }

    static func WriteMessage(text: string) -> Result<string, JsonError> {
        if text.GetUtf8ByteCount() > 1022 {
            return Error(JsonError.LimitExceeded("Message exceeds payload limit"))
        }
        let input = JsonSyntax.EncodeToken(text)
        let output = ArrayList<byte>(input.Count + 2)
        let hex = JsonSyntax.EncodeToken("0123456789abcdef")
        output.Add((byte)34)
        for value in input {
            if value == 34 || value == 92 {
                output.Add((byte)92)
                output.Add(value)
            } else if value <= 31 {
                output.Add((byte)92)
                output.Add((byte)117)
                output.Add((byte)48)
                output.Add((byte)48)
                output.Add(hex[value / 16])
                output.Add(hex[value % 16])
            } else {
                output.Add(value)
            }
            if output.Count > 1023 {
                return Error(JsonError.LimitExceeded("Escaped message exceeds payload limit"))
            }
        }
        output.Add((byte)34)
        match Encodings.Utf8.Decode(output[..]) {
            Ok(let payload) => return Ok(payload)
            Error(_) => return Error(JsonError.Syntax("Invalid UTF-8"))
        }
    }
}

internal class MessageReader {
    private var position: int

    init() {
        position = 0
    }

    private func HexQuad(bytes: ReadOnlySlice<byte>) -> Result<int, JsonError> {
        if bytes.Length - position < 4 {
            return Error(JsonError.Syntax("Truncated Unicode escape"))
        }
        var value = 0
        for index in 0..4 {
            let digit = JsonSyntax.HexDigit(bytes[position])
            if digit == -1 {
                return Error(JsonError.Syntax("Invalid Unicode escape"))
            }
            value = value * 16 + digit
            position += 1
        }
        return Ok(value)
    }

    func Read(bytes: ReadOnlySlice<byte>) -> Result<string, JsonError> => Read(bytes, 1024)

    // Internal resource readers supply their own bounded document limit.
    func Read(bytes: ReadOnlySlice<byte>, maxBytes: int) -> Result<string, JsonError> {
        let length = bytes.Length
        if length > maxBytes {
            return Error(JsonError.LimitExceeded("JSON string exceeds byte limit"))
        }
        while position < length && JsonSyntax.Whitespace(bytes[position]) {
            position += 1
        }
        if position == length || bytes[position] != 34 {
            return Error(JsonError.Syntax("Expected a JSON string"))
        }
        position += 1
        let output = ArrayList<byte>(length)
        var closed = false
        while position < length && !closed {
            let value = bytes[position]
            position += 1
            if value == 34 {
                closed = true
            } else if value == 92 {
                if position == length {
                    return Error(JsonError.Syntax("Truncated escape"))
                }
                let escape = bytes[position]
                position += 1
                if escape == 34 || escape == 92 || escape == 47 {
                    output.Add(escape)
                } else if escape == 98 {
                    output.Add((byte)8)
                } else if escape == 102 {
                    output.Add((byte)12)
                } else if escape == 110 {
                    output.Add((byte)10)
                } else if escape == 114 {
                    output.Add((byte)13)
                } else if escape == 116 {
                    output.Add((byte)9)
                } else if escape == 117 {
                    var scalar = HexQuad(bytes)?
                    if scalar >= 55296 && scalar <= 56319 {
                        if length - position < 6 {
                            return Error(JsonError.Syntax("Missing low surrogate"))
                        }
                        if bytes[position] != 92 || bytes[position + 1] != 117 {
                            return Error(JsonError.Syntax("Missing low surrogate"))
                        }
                        position += 2
                        let low = HexQuad(bytes)?
                        if !(low >= 56320 && low <= 57343) {
                            return Error(JsonError.Syntax("Invalid low surrogate"))
                        }
                        scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
                    } else if scalar >= 56320 && scalar <= 57343 {
                        return Error(JsonError.Syntax("Unpaired low surrogate"))
                    }
                    if scalar <= 127 {
                        output.Add((byte)scalar)
                    } else if scalar <= 2047 {
                        output.Add((byte)(192 + scalar / 64))
                        output.Add((byte)(128 + scalar % 64))
                    } else if scalar <= 65535 {
                        output.Add((byte)(224 + scalar / 4096))
                        output.Add((byte)(128 + scalar / 64 % 64))
                        output.Add((byte)(128 + scalar % 64))
                    } else {
                        output.Add((byte)(240 + scalar / 262144))
                        output.Add((byte)(128 + scalar / 4096 % 64))
                        output.Add((byte)(128 + scalar / 64 % 64))
                        output.Add((byte)(128 + scalar % 64))
                    }
                } else {
                    return Error(JsonError.Syntax("Unknown escape"))
                }
            } else if value <= 31 {
                return Error(JsonError.Syntax("Unescaped control byte"))
            } else {
                output.Add(value)
            }
        }
        if !closed {
            return Error(JsonError.Syntax("Unclosed string"))
        }
        while position < length && JsonSyntax.Whitespace(bytes[position]) {
            position += 1
        }
        if position != length {
            return Error(JsonError.Syntax("Trailing content"))
        }
        match Encodings.Utf8.Decode(output[..]) {
            Ok(let text) => return Ok(text)
            Error(_) => return Error(JsonError.Syntax("Invalid UTF-8"))
        }
    }
}
