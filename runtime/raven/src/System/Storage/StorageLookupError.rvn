namespace System.Storage

public union StorageLookupError {
    case InvalidPath
    case NotFound
    case AccessDenied
    case WrongKind
    case IoFailure
    case InvalidRange
    case LimitExceeded

    override func ToString() -> string {
        return match self {
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            WrongKind => "WrongKind"
            IoFailure => "IoFailure"
            InvalidRange => "InvalidRange"
            LimitExceeded => "LimitExceeded"
            _ => "Empty"
        }
    }
}
