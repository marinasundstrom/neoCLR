module System.Storage

import System.Error

public union FileReadError : Error {
    /// A human-readable case description; use patterns to classify this failure.
    val Message: string => ToString()

    /// Leaf failures have no underlying cause.
    val Cause: System.Optional<Error> => System.Optional<Error>.None

    /// Leaf failures do not capture stacks implicitly.
    val StackTrace: System.Optional<System.Diagnostics.StackTrace> => System.Optional<System.Diagnostics.StackTrace>.None

    case InvalidLimit
    case InvalidPath
    case NotFound
    case AccessDenied
    case NotRegularFile
    case TooLarge
    case ReadFailed
    case InvalidUtf8

    override func ToString() -> string {
        return match self {
            InvalidLimit => "InvalidLimit"
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            NotRegularFile => "NotRegularFile"
            TooLarge => "TooLarge"
            ReadFailed => "ReadFailed"
            InvalidUtf8 => "InvalidUtf8"
            _ => "Empty"
        }
    }
}
