namespace System.Storage

public union FileReadError {
    case InvalidLimit
    case InvalidPath
    case NotFound
    case AccessDenied
    case NotRegularFile
    case TooLarge
    case ReadFailed
    case InvalidUtf8

    override func ToString() -> string {
        return match self {
            InvalidLimit => "InvalidLimit"
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            NotRegularFile => "NotRegularFile"
            TooLarge => "TooLarge"
            ReadFailed => "ReadFailed"
            InvalidUtf8 => "InvalidUtf8"
            _ => "Empty"
        }
    }
}
