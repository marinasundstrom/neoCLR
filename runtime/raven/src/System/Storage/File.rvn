namespace System.Storage

import System.*
import System.Streams.*
import System.Result.*
import System.Runtime.CompilerServices.RuntimeServices

public class File {
    private field provider: StorageProvider
    private field path: Path

    init(provider: StorageProvider, path: Path) {
        self.provider = provider
        self.path = path
    }

    val Path: Path => path
    val Name: string => System.Storage.Path.GetFileName(path.Text)

    func OpenRead() -> Result<InputStream, StreamError> {
        return provider.OpenRead(path)
    }

    func CreateNew() -> Result<OutputStream, StreamError> {
        return provider.CreateNew(path)
    }

    static func WriteAllText(path: string, text: string, maxBytes: int) -> System.Result<System.Void, FileWriteError> {
        let status = RuntimeServices.WriteAllText(path, text, maxBytes)
        if status == 0 {
            return Ok(())
        }
        if status == 1 {
            return Error(FileWriteError(FileWriteError.InvalidLimit()))
        }
        if status == 2 {
            return Error(FileWriteError(FileWriteError.InvalidPath()))
        }
        if status == 3 {
            return Error(FileWriteError(FileWriteError.NotFound()))
        }
        if status == 4 {
            return Error(FileWriteError(FileWriteError.AccessDenied()))
        }
        if status == 5 {
            return Error(FileWriteError(FileWriteError.NotRegularFile()))
        }
        if status == 6 {
            return Error(FileWriteError(FileWriteError.WriteFailed()))
        }
        if status == 7 {
            return Error(FileWriteError(FileWriteError.TooLarge()))
        }
        System.Fault("invalid native file write status")
        return Error(FileWriteError(FileWriteError.WriteFailed()))
    }

    static func ReadAllText(path: string, maxBytes: int) -> System.Result<string, FileReadError> {
        let payload = RuntimeServices.ReadAllText(path, maxBytes)
        if !RuntimeServices.IsValue<byte>(payload) {
            return Ok(RuntimeServices.UnpackValue<string>(payload))
        }
        let status = RuntimeServices.UnpackValue<byte>(payload)
        if status == 1 {
            return Error(FileReadError(FileReadError.InvalidLimit()))
        }
        if status == 2 {
            return Error(FileReadError(FileReadError.InvalidPath()))
        }
        if status == 3 {
            return Error(FileReadError(FileReadError.NotFound()))
        }
        if status == 4 {
            return Error(FileReadError(FileReadError.AccessDenied()))
        }
        if status == 5 {
            return Error(FileReadError(FileReadError.NotRegularFile()))
        }
        if status == 6 {
            return Error(FileReadError(FileReadError.ReadFailed()))
        }
        if status == 7 {
            return Error(FileReadError(FileReadError.TooLarge()))
        }
        if status == 8 {
            return Error(FileReadError(FileReadError.InvalidUtf8()))
        }
        System.Fault("invalid native I/O status")
        return Error(FileReadError(FileReadError.ReadFailed()))
    }
}
