module System.Storage.FileText

import System.Storage.FileReadError
import System.Storage.FileWriteError
import System.Result.*

public func WriteAllText(path: string, text: string, maxBytes: int) -> System.Result<System.Void, FileWriteError> {
    let status = neoCLR.Runtime.WriteAllText(path, text, maxBytes)
    if status == 0 {
        return Ok(())
    }
    if status == 1 {
        return Failure(FileWriteError.InvalidLimit())
    }
    if status == 2 {
        return Failure(FileWriteError.InvalidPath())
    }
    if status == 3 {
        return Failure(FileWriteError.NotFound())
    }
    if status == 4 {
        return Failure(FileWriteError.AccessDenied())
    }
    if status == 5 {
        return Failure(FileWriteError.NotRegularFile())
    }
    if status == 6 {
        return Failure(FileWriteError.WriteFailed())
    }
    if status == 7 {
        return Failure(FileWriteError.TooLarge())
    }
    System.Fail("invalid native file write status")
    return Failure(FileWriteError.WriteFailed())
}

public func ReadAllText(path: string, maxBytes: int) -> System.Result<string, FileReadError> {
    let payload = neoCLR.Runtime.ReadAllText(path, maxBytes)
    if !neoCLR.Runtime.IsValue<byte>(payload) {
        return Ok(neoCLR.Runtime.UnpackValue<string>(payload))
    }
    let status = neoCLR.Runtime.UnpackValue<byte>(payload)
    if status == 1 {
        return Failure(FileReadError.InvalidLimit())
    }
    if status == 2 {
        return Failure(FileReadError.InvalidPath())
    }
    if status == 3 {
        return Failure(FileReadError.NotFound())
    }
    if status == 4 {
        return Failure(FileReadError.AccessDenied())
    }
    if status == 5 {
        return Failure(FileReadError.NotRegularFile())
    }
    if status == 6 {
        return Failure(FileReadError.ReadFailed())
    }
    if status == 7 {
        return Failure(FileReadError.TooLarge())
    }
    if status == 8 {
        return Failure(FileReadError.InvalidUtf8())
    }
    System.Fail("invalid native I/O status")
    return Failure(FileReadError.ReadFailed())
}
