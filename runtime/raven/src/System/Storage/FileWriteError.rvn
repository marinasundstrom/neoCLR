namespace System.Storage

public union FileWriteError {
    case InvalidLimit
    case InvalidPath
    case NotFound
    case AccessDenied
    case NotRegularFile
    case TooLarge
    case WriteFailed

    override func ToString() -> string {
        return match self {
            InvalidLimit => "InvalidLimit"
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            NotRegularFile => "NotRegularFile"
            TooLarge => "TooLarge"
            WriteFailed => "WriteFailed"
            _ => "Empty"
        }
    }
}
