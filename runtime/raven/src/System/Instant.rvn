namespace System

import System.Runtime.CompilerServices.*
import System.Result.*

public struct Instant : ComparableTo<Instant>, EquatableTo<Instant> {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func FromUnixTimeTicks(ticks: long) -> Instant {
        return Instant(ticks)
    }

    func ToLocalDateTime() -> LocalDateTime {
        return RuntimeServices.LocalDateTime(StoredTicks)
    }

    /// Adds exact elapsed time, independently of calendars and zones.
    func Add(duration: Duration) -> Result<Instant, OverflowError> {
        let amount = duration.Ticks
        if amount > 0L {
            if StoredTicks > 9223372036854775807L - amount {
                return Error(OverflowError())
            }
        }
        if amount < 0L {
            if StoredTicks < -9223372036854775808L - amount {
                return Error(OverflowError())
            }
        }
        return Ok(Instant(StoredTicks + amount))
    }

    val UnixTimeTicks: long => StoredTicks

    func Equals(other: Instant) -> bool {
        return StoredTicks == other.StoredTicks
    }

    func CompareTo(other: Instant) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
}
