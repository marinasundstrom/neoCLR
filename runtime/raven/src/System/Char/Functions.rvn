namespace System.Char

public func IsSurrogate(value: char) -> bool {
    let code: int = value
    return code >= 55296 && code <= 57343
}

public func IsHighSurrogate(value: char) -> bool {
    let code: int = value
    return code >= 55296 && code <= 56319
}

public func IsLowSurrogate(value: char) -> bool {
    let code: int = value
    return code >= 56320 && code <= 57343
}

public func IsAscii(value: char) -> bool {
    let code: int = value
    return code <= 127
}

public func IsAsciiDigit(value: char) -> bool {
    let code: int = value
    return code >= 48 && code <= 57
}

public func IsLetterOrDigit(value: char) -> bool {
    return char.IsLetter(value) || char.IsDigit(value)
}

public func IsWhiteSpace(value: char) -> bool {
    let code: int = value
    return (code >= 9 && code <= 13) || code == 133 || char.IsSeparator(value)
}
