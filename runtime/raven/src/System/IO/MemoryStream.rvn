module System.IO

import System.*
import System.Collections.*
import System.Result.*
import System.Tasks.*
import System.Concurrency.*

// Provisional, bounded managed storage. All stream capabilities share one cursor.
public class MemoryStream : InputStream, OutputStream, SeekableStream, AsyncInputStream, AsyncOutputStream {
    private var bytes: List<byte> = ArrayList<byte>()
    private var position: int = 0
    private var closed: bool = false

    init() {
        position = 0
    }

    func GetLength() -> Result<long, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        return Ok((long)bytes.Count)
    }

    func GetPosition() -> Result<long, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        return Ok((long)position)
    }

    func Seek(position: long) -> Result<long, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if position < 0 {
            return Error(StreamError.InvalidRange)
        }
        if position > 65536 {
            return Error(StreamError.LimitExceeded)
        }
        self.position = (int)position
        return Ok(position)
    }

    func Read(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if offset < 0 {
            return Error(StreamError.InvalidRange)
        }
        if count < 0 {
            return Error(StreamError.InvalidRange)
        }
        if offset > buffer.Length {
            return Error(StreamError.InvalidRange)
        }
        if count > buffer.Length - offset {
            return Error(StreamError.InvalidRange)
        }
        var read = 0
        while read < count && position < bytes.Count {
            buffer[offset + read] = bytes[position]
            read += 1
            position += 1
        }
        return Ok(read)
    }

    func Write(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if offset < 0 {
            return Error(StreamError.InvalidRange)
        }
        if count < 0 {
            return Error(StreamError.InvalidRange)
        }
        if offset > buffer.Length {
            return Error(StreamError.InvalidRange)
        }
        if count > buffer.Length - offset {
            return Error(StreamError.InvalidRange)
        }
        if count > 65536 - position {
            return Error(StreamError.LimitExceeded)
        }
        if count == 0 {
            return Ok(0)
        }
        while bytes.Count < position {
            bytes.Add((byte)0)
        }
        var written = 0
        while written < count {
            if position == bytes.Count {
                bytes.Add(buffer[offset + written])
            } else {
                bytes[position] = buffer[offset + written]
            }
            position += 1
            written += 1
        }
        return Ok(written)
    }

    func Flush() -> Result<unit, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        return Ok(())
    }

    /// <summary>Reads memory synchronously and returns a settled task; no worker is scheduled.</summary>
    /// <remarks>Pre-cancellation wins before validation or mutation. Other errors match Read. This shared-cursor stream is not thread-safe.</remarks>
    func ReadAsync(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<int, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(Read(buffer, offset, count))
    }

    /// <summary>Writes the full range to memory and returns a settled task.</summary>
    /// <remarks>Pre-cancellation wins before validation or mutation. Range, closed-state and quota errors preserve storage and cursor, as with Write.</remarks>
    func WriteAsync(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<unit, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        let result: Result<unit, StreamError> = match Write(buffer, offset, count) {
            Ok(_) => Ok(())
            Error(let error) => Error(error)
        }
        return Task.FromResult(result)
    }

    /// <summary>Returns settled success for open memory storage; no data needs flushing.</summary>
    /// <remarks>Pre-cancellation wins over Closed. Does not change position or length.</remarks>
    func FlushAsync(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<unit, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(Flush())
    }

    func Close() {
        if !closed {
            closed = true
            bytes = ArrayList<byte>()
            position = 0
        }
    }
}
