module System.IO

import System.*
import System.Collections.*
import System.Result.*
import System.Concurrency.Tasks.*
import System.Concurrency.*

// Provisional, bounded managed storage. All stream capabilities share one cursor.
public class MemoryStream : InputStream, OutputStream, SeekableStream, SyncInputStream, SyncOutputStream {
    private var bytes: List<byte> = ArrayList<byte>()
    private var position: int = 0
    private var closed: bool = false

    init() {
        position = 0
    }

    func GetLength() -> Result<long, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        return Ok((long)bytes.Count)
    }

    func GetPosition() -> Result<long, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        return Ok((long)position)
    }

    func Seek(position: long) -> Result<long, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if position < 0 {
            return Error(StreamError.InvalidRange)
        }
        if position > 65536 {
            return Error(StreamError.LimitExceeded)
        }
        self.position = (int)position
        return Ok(position)
    }

    private func ReadCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if offset < 0 {
            return Error(StreamError.InvalidRange)
        }
        if count < 0 {
            return Error(StreamError.InvalidRange)
        }
        if offset > buffer.Length {
            return Error(StreamError.InvalidRange)
        }
        if count > buffer.Length - offset {
            return Error(StreamError.InvalidRange)
        }
        let view: Slice<byte> = buffer
        return ReadBorrowed(view.Slice(offset, count))
    }

    private func ReadBorrowed(buffer: Slice<byte>) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        let count = buffer.Length
        var read = 0
        while read < count && position < bytes.Count {
            buffer[read] = bytes[position]
            read += 1
            position += 1
        }
        return Ok(read)
    }

    private func WriteCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if offset < 0 {
            return Error(StreamError.InvalidRange)
        }
        if count < 0 {
            return Error(StreamError.InvalidRange)
        }
        if offset > buffer.Length {
            return Error(StreamError.InvalidRange)
        }
        if count > buffer.Length - offset {
            return Error(StreamError.InvalidRange)
        }
        let view: ReadOnlySlice<byte> = buffer
        return WriteBorrowed(view.Slice(offset, count))
    }

    private func WriteBorrowed(buffer: ReadOnlySlice<byte>) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        let count = buffer.Length
        if count > 65536 - position {
            return Error(StreamError.LimitExceeded)
        }
        if count == 0 {
            return Ok(0)
        }
        while bytes.Count < position {
            bytes.Add((byte)0)
        }
        var written = 0
        while written < count {
            if position == bytes.Count {
                bytes.Add(buffer[written])
            } else {
                bytes[position] = buffer[written]
            }
            position += 1
            written += 1
        }
        return Ok(written)
    }

    // Explicit capabilities keep concrete asynchronous method selection unambiguous.
    func SyncInputStream.Read(buffer: Slice<byte>) -> Result<int, StreamError> => ReadBorrowed(buffer)

    func SyncOutputStream.Write(buffer: ReadOnlySlice<byte>) -> Result<unit, StreamError> {
        return match WriteBorrowed(buffer) {
            Ok(_) => Ok(())
            Error(let error) => Error(error)
        }
    }

    func SyncOutputStream.Flush() -> Result<unit, StreamError> => FlushCore()

    private func FlushCore() -> Result<unit, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        return Ok(())
    }

    func Read(buffer: byte[], offset: int, count: int) -> Task<Result<int, StreamError>> {
        return Read(buffer, offset, count, CancellationToken.None)
    }

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }

    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }

    /// <summary>Reads memory synchronously and returns a settled task; no worker is scheduled.</summary>
    /// <remarks>Pre-cancellation wins before validation or mutation. Other errors match Read. This shared-cursor stream is not thread-safe.</remarks>
    func Read(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<int, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(ReadCore(buffer, offset, count))
    }

    /// <summary>Writes the full range to memory and returns a settled task.</summary>
    /// <remarks>Pre-cancellation wins before validation or mutation. Range, closed-state and quota errors preserve storage and cursor, as with Write.</remarks>
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<unit, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        let result: Result<unit, StreamError> = match WriteCore(buffer, offset, count) {
            Ok(_) => Ok(())
            Error(let error) => Error(error)
        }
        return Task.FromResult(result)
    }

    /// <summary>Returns settled success for open memory storage; no data needs flushing.</summary>
    /// <remarks>Pre-cancellation wins over Closed. Does not change position or length.</remarks>
    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<unit, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(FlushCore())
    }

    func Close() {
        if !closed {
            closed = true
            bytes = ArrayList<byte>()
            position = 0
        }
    }
}
