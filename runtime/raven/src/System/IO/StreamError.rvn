namespace System.IO

public union StreamError {
    case InvalidPath
    case NotFound
    case AccessDenied
    case WrongKind
    case AlreadyExists
    case Closed
    case InvalidRange
    case LimitExceeded
    case WrongAccess
    case IoFailure

    override func ToString() -> string {
        return match self {
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            WrongKind => "WrongKind"
            AlreadyExists => "AlreadyExists"
            Closed => "Closed"
            InvalidRange => "InvalidRange"
            LimitExceeded => "LimitExceeded"
            WrongAccess => "WrongAccess"
            IoFailure => "IoFailure"
            _ => "Empty"
        }
    }
}
