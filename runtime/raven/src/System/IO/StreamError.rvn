module System.IO

public union StreamError {
    case InvalidPath
    case NotFound
    case AccessDenied
    case WrongKind
    case AlreadyExists
    case Closed
    case InvalidRange
    case LimitExceeded
    case WrongAccess
    case IoFailure
    case InvalidEncoding
    /// Malformed or truncated binary content, including gzip checksum and format failures.
    case InvalidData

    /// Another text write, flush or finalization is pending.
    case Busy

    override func ToString() -> string {
        return match self {
            InvalidPath => "InvalidPath"
            NotFound => "NotFound"
            AccessDenied => "AccessDenied"
            WrongKind => "WrongKind"
            AlreadyExists => "AlreadyExists"
            Closed => "Closed"
            InvalidRange => "InvalidRange"
            LimitExceeded => "LimitExceeded"
            WrongAccess => "WrongAccess"
            InvalidData => "InvalidData"
            InvalidEncoding => "InvalidEncoding"
            IoFailure => "IoFailure"
            Busy => "Busy"
            _ => "Empty"
        }
    }
}
