namespace System.IO

import System.Runtime.CompilerServices.ValueStorage

public struct StreamError {
    private field Stored: System.Value

    public struct InvalidPath { }
    public struct NotFound { }
    public struct AccessDenied { }
    public struct WrongKind { }
    public struct AlreadyExists { }
    public struct Closed { }
    public struct InvalidRange { }
    public struct LimitExceeded { }
    public struct WrongAccess { }
    public struct IoFailure { }

    init(value: StreamError.InvalidPath) {
        Stored = ValueStorage.Pack(value)
    }

    val IsInvalidPath: bool => ValueStorage.Is<StreamError.InvalidPath>(Stored)

    func GetInvalidPath() -> StreamError.InvalidPath {
        return ValueStorage.Unpack<StreamError.InvalidPath>(Stored)
    }

    init(value: StreamError.NotFound) {
        Stored = ValueStorage.Pack(value)
    }

    val IsNotFound: bool => ValueStorage.Is<StreamError.NotFound>(Stored)

    func GetNotFound() -> StreamError.NotFound {
        return ValueStorage.Unpack<StreamError.NotFound>(Stored)
    }

    init(value: StreamError.AccessDenied) {
        Stored = ValueStorage.Pack(value)
    }

    val IsAccessDenied: bool => ValueStorage.Is<StreamError.AccessDenied>(Stored)

    func GetAccessDenied() -> StreamError.AccessDenied {
        return ValueStorage.Unpack<StreamError.AccessDenied>(Stored)
    }

    init(value: StreamError.WrongKind) {
        Stored = ValueStorage.Pack(value)
    }

    val IsWrongKind: bool => ValueStorage.Is<StreamError.WrongKind>(Stored)

    func GetWrongKind() -> StreamError.WrongKind {
        return ValueStorage.Unpack<StreamError.WrongKind>(Stored)
    }

    init(value: StreamError.AlreadyExists) {
        Stored = ValueStorage.Pack(value)
    }

    val IsAlreadyExists: bool => ValueStorage.Is<StreamError.AlreadyExists>(Stored)

    func GetAlreadyExists() -> StreamError.AlreadyExists {
        return ValueStorage.Unpack<StreamError.AlreadyExists>(Stored)
    }

    init(value: StreamError.Closed) {
        Stored = ValueStorage.Pack(value)
    }

    val IsClosed: bool => ValueStorage.Is<StreamError.Closed>(Stored)

    func GetClosed() -> StreamError.Closed {
        return ValueStorage.Unpack<StreamError.Closed>(Stored)
    }

    init(value: StreamError.InvalidRange) {
        Stored = ValueStorage.Pack(value)
    }

    val IsInvalidRange: bool => ValueStorage.Is<StreamError.InvalidRange>(Stored)

    func GetInvalidRange() -> StreamError.InvalidRange {
        return ValueStorage.Unpack<StreamError.InvalidRange>(Stored)
    }

    init(value: StreamError.LimitExceeded) {
        Stored = ValueStorage.Pack(value)
    }

    val IsLimitExceeded: bool => ValueStorage.Is<StreamError.LimitExceeded>(Stored)

    func GetLimitExceeded() -> StreamError.LimitExceeded {
        return ValueStorage.Unpack<StreamError.LimitExceeded>(Stored)
    }

    init(value: StreamError.WrongAccess) {
        Stored = ValueStorage.Pack(value)
    }

    val IsWrongAccess: bool => ValueStorage.Is<StreamError.WrongAccess>(Stored)

    func GetWrongAccess() -> StreamError.WrongAccess {
        return ValueStorage.Unpack<StreamError.WrongAccess>(Stored)
    }

    init(value: StreamError.IoFailure) {
        Stored = ValueStorage.Pack(value)
    }

    val IsIoFailure: bool => ValueStorage.Is<StreamError.IoFailure>(Stored)

    func GetIoFailure() -> StreamError.IoFailure {
        return ValueStorage.Unpack<StreamError.IoFailure>(Stored)
    }

    func ToString() -> string {
        if IsInvalidPath {
            return "InvalidPath"
        }
        if IsNotFound {
            return "NotFound"
        }
        if IsAccessDenied {
            return "AccessDenied"
        }
        if IsWrongKind {
            return "WrongKind"
        }
        if IsAlreadyExists {
            return "AlreadyExists"
        }
        if IsClosed {
            return "Closed"
        }
        if IsInvalidRange {
            return "InvalidRange"
        }
        if IsLimitExceeded {
            return "LimitExceeded"
        }
        if IsWrongAccess {
            return "WrongAccess"
        }
        if IsIoFailure {
            return "IoFailure"
        }
        System.Fault("invalid stream error case")
        return ""
    }
}
