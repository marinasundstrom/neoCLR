module System.IO

import System.*
import System.Concurrency.Tasks.*

/// <summary>Asynchronous decoded text reads sharing one logical cursor.</summary>
public interface TextReader {
    /// <summary>Peeks at the next grapheme without consuming it; None denotes EOF.</summary>
    /// <returns>Awaited Char or a text read error. May buffer underlying input to find a boundary.</returns>
    func PeekChar() -> Task<Result<Option<char>, TextReadError>>
    /// <summary>Reads one grapheme; None denotes EOF.</summary>
    /// <returns>Awaited Char or a text read error.</returns>
    func ReadChar() -> Task<Result<Option<char>, TextReadError>>
    /// <summary>Reads the requested grapheme count, or the shorter remainder at EOF.</summary>
    /// <param name="count">Nonnegative grapheme count; zero consumes nothing.</param>
    /// <returns>Awaited text or a text read error.</returns>
    func Read(count: int) -> Task<Result<string, TextReadError>>
    /// <summary>Reads the requested grapheme count with a separate result byte bound.</summary>
    /// <param name="count">Nonnegative grapheme count; zero consumes nothing.</param>
    /// <param name="maxUtf8Bytes">Maximum UTF-8 bytes in the returned text.</param>
    /// <returns>Awaited text, shorter at EOF, or a text read error.</returns>
    func Read(count: int, maxUtf8Bytes: int) -> Task<Result<string, TextReadError>>
    func ReadLine(maxUtf8Bytes: int) -> Task<Result<Option<string>, TextReadError>>
    func ReadToEnd(maxUtf8Bytes: int) -> Task<Result<string, TextReadError>>
    func Close()
}
