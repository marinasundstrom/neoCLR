module System.IO

import System.*
import System.Result.*
import System.Text.*
import System.Runtime.CompilerServices.*

public class StreamWriter : TextWriter {
    private var output: OutputStream
    private var leaveOpen: bool
    private var encoder: Encoder
    private var closed: bool = false
    private var finished: bool = false
    private var failed: bool = false
    private var finishing: bool = false

    init(output: OutputStream) {
        self.output = output
        encoder = Encodings.Utf8.CreateEncoder()
        leaveOpen = false
    }

    init(output: OutputStream, leaveOpen: bool) {
        self.output = output
        encoder = Encodings.Utf8.CreateEncoder()
        self.leaveOpen = leaveOpen
    }

    init(output: OutputStream, encoding: Encoding) {
        self.output = output
        encoder = encoding.CreateEncoder()
        leaveOpen = false
    }

    init(output: OutputStream, encoding: Encoding, leaveOpen: bool) {
        self.output = output
        encoder = encoding.CreateEncoder()
        self.leaveOpen = leaveOpen
    }

    func Write(text: string) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if finished || failed {
            return Error(StreamError.InvalidEncoding)
        }
        if text.GetUtf8ByteCount() > 65536 {
            return Error(StreamError.LimitExceeded)
        }
        match encoder.Accept(text, false) {
            Ok(_) => { }
            Error(EncodingError.LimitExceeded) => return Error(StreamError.LimitExceeded)
            Error(_) => return Error(StreamError.InvalidEncoding)
        }
        return Pump()
    }

    // Finalize conversion explicitly; Flush remains an output-stream operation.
    func Finish() -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed)
        }
        if failed {
            return Error(StreamError.InvalidEncoding)
        }
        if finished {
            return Ok(0)
        }
        match encoder.Accept("", true) {
            Ok(_) => { }
            Error(EncodingError.LimitExceeded) => return Error(StreamError.LimitExceeded)
            Error(_) => return Error(StreamError.InvalidEncoding)
        }
        finishing = true
        return Pump()
    }

    private func Pump() -> Result<int, StreamError> {
        let buffer = CheckedStorage.Reserve<byte>(256)
        var total = 0
        while true {
            let step = match encoder.Drain(buffer, 0, buffer.Length) {
                Ok(let value) => value
                Error(_) => {
                    failed = true
                    return Error(StreamError.InvalidEncoding)
                }
            }
            if !(step.BytesWritten >= 0) || step.BytesWritten > buffer.Length {
                System.Fail("Invalid encoder byte count")
            }
            if step.BytesWritten > 65536 - total {
                failed = true
                return Error(StreamError.LimitExceeded)
            }
            var sent = 0
            while sent < step.BytesWritten {
                match output.Write(buffer, sent, step.BytesWritten - sent) {
                    Ok(let count) => {
                        if !(count >= 0) || count > step.BytesWritten - sent {
                            System.Fail("Invalid output count")
                        }
                        if count == 0 {
                            failed = true
                            return Error(StreamError.IoFailure)
                        }
                        sent += count
                        total += count
                    }
                    Error(let error) => {
                        failed = true
                        return Error(error)
                    }
                }
            }
            match step.State {
                EncoderState.NeedsOutput => {
                    if step.BytesWritten == 0 {
                        System.Fail("Encoder made no progress with positive capacity")
                    }
                }
                EncoderState.Ready => {
                    if finishing {
                        System.Fail("Final input did not finalize encoder")
                    }
                    return Ok(total)
                }
                EncoderState.Finished => {
                    if !finishing {
                        System.Fail("Encoder finalized nonfinal input")
                    }
                    finished = true
                    return Ok(total)
                }
                _ => System.Fail("Invalid encoder state")
            }
        }
        return Error(StreamError.IoFailure)
    }

    func WriteLine(text: string) -> Result<int, StreamError> {
        if closed {
            return Error(StreamError.Closed())
        }
        if finished || failed {
            return Error(StreamError.InvalidEncoding)
        }
        if text.GetUtf8ByteCount() >= 65536 {
            return Error(StreamError.LimitExceeded())
        }
        return self.Write(text + "\n")
    }

    func Flush() -> Result<unit, StreamError> {
        if closed {
            return Error(StreamError.Closed())
        }
        return output.Flush()
    }

    // Finish conversion and Flush explicitly to observe errors before Close.
    func Close() {
        if !closed {
            closed = true
            if !leaveOpen {
                output.Close()
            }
        }
    }
}
