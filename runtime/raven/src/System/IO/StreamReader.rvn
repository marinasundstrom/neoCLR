module System.IO

import System.*
import System.Concurrency.Tasks.*
import System.Collections.*
import System.Result.*
import System.Option.*
import System.Text.*
import System.Runtime.CompilerServices.*

public class StreamReader : TextReader {
    private var input: InputStream
    private var decoder: Decoder
    private var leaveOpen: bool
    private var closed: bool = false
    private var eof: bool = false
    private var pendingText: string = ""
    private var lastRead: int = 0
    private var reading: bool = false
    private var pendingOffset: int = 0
    private var peeked: Option<char> = None
    private val readBuffer: byte[] = CheckedStorage.Reserve<byte>(256)

    init(input: InputStream) {
        self.input = input
        decoder = Encodings.Utf8.CreateDecoder()
        leaveOpen = false
    }

    init(input: InputStream, leaveOpen: bool) {
        self.input = input
        decoder = Encodings.Utf8.CreateDecoder()
        self.leaveOpen = leaveOpen
    }

    init(input: InputStream, encoding: Encoding) {
        self.input = input
        decoder = encoding.CreateDecoder()
        leaveOpen = false
    }

    init(input: InputStream, encoding: Encoding, leaveOpen: bool) {
        self.input = input
        decoder = encoding.CreateDecoder()
        self.leaveOpen = leaveOpen
    }

    /// <summary>Peeks at the next Unicode grapheme without advancing the text cursor.</summary>
    /// <returns>Some Char, None at EOF, or a decoding, I/O, Busy or limit error.</returns>
    /// <remarks>May await underlying input and retain lookahead. Repeated peeks reuse the cached Char.
    /// A grapheme may require a subsequent boundary or EOF. The maximum grapheme size is 65536 UTF-8 bytes.</remarks>
    async func PeekChar() -> Task<Result<Option<char>, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if reading {
            return Error(TextReadError.Busy)
        }
        reading = true
        let result = await PeekCharCore()
        reading = false
        return result
    }

    /// <summary>Reads one Unicode grapheme and advances the shared text cursor.</summary>
    /// <returns>Some Char, None at EOF, or a decoding, I/O, Busy or limit error.</returns>
    /// <remarks>Shares buffered lookahead with PeekChar, counted reads and line reads.
    /// Counts graphemes rather than UTF-8 bytes or Unicode scalars; maximum 65536 UTF-8 bytes.</remarks>
    async func ReadChar() -> Task<Result<Option<char>, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if reading {
            return Error(TextReadError.Busy)
        }
        reading = true
        let result = await PeekCharCore()
        if result is Ok(Some(_)) {
            pendingOffset += 1
            peeked = None
        }
        reading = false
        return result
    }

    /// <summary>Reads a requested number of graphemes, or the shorter remainder at EOF.</summary>
    /// <param name="count">Grapheme count, from zero through 65536.</param>
    /// <returns>Text, empty at EOF or for zero count, or TextReadError.</returns>
    /// <remarks>Uses the default 65536-byte result limit. May read ahead; unread text remains buffered.</remarks>
    func Read(count: int) -> Task<Result<string, TextReadError>> {
        return Read(count, 65536)
    }

    /// <summary>Reads a requested number of graphemes with a separate UTF-8 byte bound.</summary>
    /// <param name="count">Grapheme count, from zero through 65536.</param>
    /// <param name="maxUtf8Bytes">Maximum returned UTF-8 bytes, from zero through 65536.</param>
    /// <returns>The requested text, a shorter remainder at EOF, or TextReadError.</returns>
    /// <remarks>Zero count consumes nothing. Invalid bounds consume nothing. A result-limit error
    /// retains buffered text for retry; decoding/I/O errors do not rewind the source. Concurrent reads return Busy.</remarks>
    async func Read(count: int, maxUtf8Bytes: int) -> Task<Result<string, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if reading {
            return Error(TextReadError.Busy)
        }
        if count < 0 || maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange)
        }
        if count > 65536 || maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        if count == 0 {
            return Ok("")
        }
        reading = true
        let result = await ReadCore(count, maxUtf8Bytes)
        reading = false
        return result
    }

    private async func PeekCharCore() -> Task<Result<Option<char>, TextReadError>> {
        if peeked is Some(let cached) {
            return Ok(Some(cached))
        }
        let available = match await EnsureCharacters(1) {
            Ok(let value) => value
            Error(let error) => return Error(error)
        }
        if available == 0 {
            return Ok(None)
        }
        let character = pendingText[pendingOffset]
        // Ordinary buffered input needs no intermediate String. Only the oversized
        // boundary case needs a per-grapheme size check after lookahead completed it.
        if pendingText.Utf8Bytes.Length > 65536 {
            if character.ToString().Utf8Bytes.Length > 65536 {
                return Error(TextReadError.LimitExceeded)
            }
        }
        peeked = Some(character)
        return Ok(Some(character))
    }

    private async func ReadCore(count: int, maxUtf8Bytes: int) -> Task<Result<string, TextReadError>> {
        let available = match await EnsureCharacters(count) {
            Ok(let value) => value
            Error(let error) => return Error(error)
        }
        if available == 0 {
            return Ok("")
        }
        let end = pendingOffset + available
        let result = if pendingOffset == 0 && end == pendingText.Length {
            pendingText
        } else {
            pendingText[pendingOffset..end]
        }
        if result.Utf8Bytes.Length > maxUtf8Bytes {
            return Error(TextReadError.LimitExceeded)
        }
        pendingOffset = end
        peeked = None
        return Ok(result)
    }

    private async func EnsureCharacters(count: int) -> Task<Result<int, TextReadError>> {
        while true {
            let available = pendingText.Length - pendingOffset
            // Retain the last unfinished grapheme until another boundary or EOF.
            // LF has an unconditional boundary after it, so interactive line input
            // need not wait for a second line just to consume its final newline.
            let complete = pendingText.EndsWithOrdinal("\n")
            if available > count || eof || (available >= count && complete) {
                return Ok(if available < count { available } else { count })
            }
            pendingText = DrainPending()
            if pendingText.Utf8Bytes.Length > 65536 {
                return Error(TextReadError.LimitExceeded)
            }
            let part = match await ReadPart(readBuffer, 256, 256) {
                Ok(let text) => text
                Error(let error) => return Error(error)
            }
            pendingText = String.Concat(pendingText, part)
        }
        return Error(TextReadError.IoFailure)
    }

    private func DrainPending() -> string {
        let result = if pendingOffset == 0 {
            pendingText
        } else {
            pendingText[pendingOffset..]
        }
        pendingText = ""
        pendingOffset = 0
        peeked = None
        return result
    }

    // Delimit decoded text. Built-in codecs do not read ahead across lines.
    async func ReadLine(maxUtf8Bytes: int) -> Task<Result<Option<string>, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if reading {
            return Error(TextReadError.Busy)
        }
        reading = true
        let result = await ReadLineCore(maxUtf8Bytes)
        reading = false
        return result
    }

    private async func ReadLineCore(maxUtf8Bytes: int) -> Task<Result<Option<string>, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange)
        }
        if maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        let buffer = readBuffer
        let line = ArrayList<byte>()
        var accepted = 0
        while true {
            let part = DrainPending()
            let bytes = Utf8.Encode(part)
            var index = 0
            while index < bytes.Count {
                let value = bytes[index]
                if value == 10 {
                    match part.SliceUtf8(index + 1, bytes.Count - index - 1) {
                        Ok(let suffix) => pendingText = suffix
                        Error(_) => System.Fail("Invalid decoded line suffix")
                    }
                    var lineLength = line.Count
                    if lineLength > 0 && line[lineLength - 1] == 13 {
                        lineLength -= 1
                    }
                    return DecodeLine(line, lineLength)
                }
                if line.Count >= maxUtf8Bytes && (line.Count > maxUtf8Bytes || value != 13) {
                    return Error(TextReadError.LimitExceeded)
                }
                line.Add(value)
                index += 1
            }
            if eof {
                if line.Count > maxUtf8Bytes {
                    return Error(TextReadError.LimitExceeded)
                }
                if line.Count == 0 {
                    let absent: Option<string> = None()
                    return Ok(absent)
                }
                return DecodeLine(line, line.Count)
            }
            if accepted > maxUtf8Bytes + 1 {
                return Error(TextReadError.LimitExceeded)
            }
            match await ReadPart(buffer, 1, 1) {
                Ok(let decoded) => pendingText = decoded
                Error(let error) => return Error(error)
            }
            accepted += lastRead
        }
        return Error(TextReadError.IoFailure)
    }

    private static func DecodeLine(bytes: Sequence<byte>, length: int) -> Result<Option<string>, TextReadError> {
        let line = CheckedStorage.Reserve<byte>(length)
        var index = 0
        while index < length {
            line[index] = bytes[index]
            index += 1
        }
        return match Utf8.Decode(line) {
            Ok(let text) => {
                let present: Option<string> = Some(text)
                Ok(present)
            }
            Error(_) => Error(TextReadError.InvalidEncoding)
        }
    }

    async func ReadToEnd(maxUtf8Bytes: int) -> Task<Result<string, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if reading {
            return Error(TextReadError.Busy)
        }
        reading = true
        let result = await ReadToEndCore(maxUtf8Bytes)
        reading = false
        return result
    }

    private async func ReadToEndCore(maxUtf8Bytes: int) -> Task<Result<string, TextReadError>> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange)
        }
        if maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        let buffer = readBuffer
        var text = DrainPending()
        var accepted = 0
        while true {
            if text.Utf8Bytes.Length > maxUtf8Bytes {
                return Error(TextReadError.LimitExceeded)
            }
            if eof {
                return Ok(text)
            }
            var request = maxUtf8Bytes - accepted + 1
            if request > buffer.Length {
                request = buffer.Length
            }
            match await ReadPart(buffer, request, maxUtf8Bytes - accepted) {
                Ok(let part) => text = String.Concat(text, part)
                Error(let error) => return Error(error)
            }
            accepted += lastRead
            if accepted > maxUtf8Bytes {
                return Error(TextReadError.LimitExceeded)
            }
        }
        return Error(TextReadError.IoFailure)
    }

    private async func ReadPart(buffer: byte[], request: int, remaining: int) -> Task<Result<string, TextReadError>> {
        let count = match await input.Read(buffer, 0, request) {
            Ok(let value) => value
            Error(let error) => return Error(FromStream(error))
        }
        if !(count >= 0) || count > request {
            System.Fail("Invalid input read count")
        }
        lastRead = count
        if count > remaining {
            return Error(TextReadError.LimitExceeded)
        }
        if count == 0 {
            eof = true
        }
        let decoded = match decoder.Decode(buffer[..count], eof) {
            Ok(let text) => text
            Error(EncodingError.InvalidUtf8) => return Error(TextReadError.InvalidUtf8)
            Error(EncodingError.LimitExceeded) => return Error(TextReadError.LimitExceeded)
            Error(_) => return Error(TextReadError.InvalidEncoding)
        }
        if decoded.Utf8Bytes.Length > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        return Ok(decoded)
    }

    func Close() {
        if !closed {
            closed = true
            pendingText = ""
            pendingOffset = 0
            peeked = None
            if !leaveOpen {
                input.Close()
            }
        }
    }

    private static func FromStream(error: StreamError) -> TextReadError {
        return match error {
            StreamError.InvalidPath => TextReadError.InvalidPath
            StreamError.NotFound => TextReadError.NotFound
            StreamError.AccessDenied => TextReadError.AccessDenied
            StreamError.WrongKind => TextReadError.WrongKind
            StreamError.AlreadyExists => TextReadError.AlreadyExists
            StreamError.Closed => TextReadError.Closed
            StreamError.InvalidRange => TextReadError.InvalidRange
            StreamError.LimitExceeded => TextReadError.LimitExceeded
            StreamError.WrongAccess => TextReadError.WrongAccess
            StreamError.InvalidData => TextReadError.InvalidData
            StreamError.InvalidEncoding => TextReadError.InvalidEncoding
            _ => TextReadError.IoFailure
        }
    }
}
