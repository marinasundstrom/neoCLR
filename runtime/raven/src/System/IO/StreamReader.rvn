module System.IO

import System.*
import System.Collections.*
import System.Result.*
import System.Option.*
import System.Text.*
import System.Runtime.CompilerServices.*

public class StreamReader : TextReader {
    private var input: InputStream
    private var decoder: Decoder
    private var leaveOpen: bool
    private var closed: bool = false
    private var eof: bool = false
    private var pendingText: string = ""
    private var lastRead: int = 0

    init(input: InputStream) {
        self.input = input
        decoder = Encodings.Utf8.CreateDecoder()
        leaveOpen = false
    }

    init(input: InputStream, leaveOpen: bool) {
        self.input = input
        decoder = Encodings.Utf8.CreateDecoder()
        self.leaveOpen = leaveOpen
    }

    init(input: InputStream, encoding: Encoding) {
        self.input = input
        decoder = encoding.CreateDecoder()
        leaveOpen = false
    }

    init(input: InputStream, encoding: Encoding, leaveOpen: bool) {
        self.input = input
        decoder = encoding.CreateDecoder()
        self.leaveOpen = leaveOpen
    }

    // Delimit decoded text. Built-in codecs do not read ahead across lines.
    func ReadLine(maxUtf8Bytes: int) -> Result<Option<string>, TextReadError> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange)
        }
        if maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        let buffer: byte[] = [(byte)0]
        let line = ArrayList<byte>()
        var accepted = 0
        while true {
            let part = pendingText
            pendingText = ""
            let bytes = Utf8.Encode(part)
            var index = 0
            while index < bytes.Count {
                let value = bytes[index]
                if value == 10 {
                    match part.SliceUtf8(index + 1, bytes.Count - index - 1) {
                        Ok(let suffix) => pendingText = suffix
                        Error(_) => System.Fail("Invalid decoded line suffix")
                    }
                    var lineLength = line.Count
                    if lineLength > 0 && line[lineLength - 1] == 13 {
                        lineLength -= 1
                    }
                    return DecodeLine(line, lineLength)
                }
                if line.Count >= maxUtf8Bytes && (line.Count > maxUtf8Bytes || value != 13) {
                    return Error(TextReadError.LimitExceeded)
                }
                line.Add(value)
                index += 1
            }
            if eof {
                if line.Count > maxUtf8Bytes {
                    return Error(TextReadError.LimitExceeded)
                }
                if line.Count == 0 {
                    let absent: Option<string> = None()
                    return Ok(absent)
                }
                return DecodeLine(line, line.Count)
            }
            if accepted > maxUtf8Bytes + 1 {
                return Error(TextReadError.LimitExceeded)
            }
            match ReadPart(buffer, 1, 1) {
                Ok(let decoded) => pendingText = decoded
                Error(let error) => return Error(error)
            }
            accepted += lastRead
        }
        return Error(TextReadError.IoFailure)
    }

    private static func DecodeLine(bytes: Sequence<byte>, length: int) -> Result<Option<string>, TextReadError> {
        let line = CheckedStorage.Reserve<byte>(length)
        var index = 0
        while index < length {
            line[index] = bytes[index]
            index += 1
        }
        return match Utf8.Decode(line) {
            Ok(let text) => {
                let present: Option<string> = Some(text)
                Ok(present)
            }
            Error(_) => Error(TextReadError.InvalidEncoding)
        }
    }

    func ReadToEnd(maxUtf8Bytes: int) -> Result<string, TextReadError> {
        if closed {
            return Error(TextReadError.Closed)
        }
        if maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange)
        }
        if maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        let buffer = CheckedStorage.Reserve<byte>(256)
        var text = pendingText
        pendingText = ""
        var accepted = 0
        while true {
            if text.GetUtf8ByteCount() > maxUtf8Bytes {
                return Error(TextReadError.LimitExceeded)
            }
            if eof {
                return Ok(text)
            }
            var request = maxUtf8Bytes - accepted + 1
            if request > buffer.Length {
                request = buffer.Length
            }
            match ReadPart(buffer, request, maxUtf8Bytes - accepted) {
                Ok(let part) => text = String.Concat(text, part)
                Error(let error) => return Error(error)
            }
            accepted += lastRead
            if accepted > maxUtf8Bytes {
                return Error(TextReadError.LimitExceeded)
            }
        }
        return Error(TextReadError.IoFailure)
    }

    private func ReadPart(buffer: byte[], request: int, remaining: int) -> Result<string, TextReadError> {
        let count = match input.Read(buffer, 0, request) {
            Ok(let value) => value
            Error(let error) => return Error(FromStream(error))
        }
        if !(count >= 0) || count > request {
            System.Fail("Invalid input read count")
        }
        lastRead = count
        if count > remaining {
            return Error(TextReadError.LimitExceeded)
        }
        if count == 0 {
            eof = true
        }
        let decoded = match decoder.Decode(buffer, 0, count, eof) {
            Ok(let text) => text
            Error(EncodingError.InvalidUtf8) => return Error(TextReadError.InvalidUtf8)
            Error(EncodingError.LimitExceeded) => return Error(TextReadError.LimitExceeded)
            Error(_) => return Error(TextReadError.InvalidEncoding)
        }
        if decoded.GetUtf8ByteCount() > 65536 {
            return Error(TextReadError.LimitExceeded)
        }
        return Ok(decoded)
    }

    func Close() {
        if !closed {
            closed = true
            if !leaveOpen {
                input.Close()
            }
        }
    }

    private static func FromStream(error: StreamError) -> TextReadError {
        return match error {
            StreamError.InvalidPath => TextReadError.InvalidPath
            StreamError.NotFound => TextReadError.NotFound
            StreamError.AccessDenied => TextReadError.AccessDenied
            StreamError.WrongKind => TextReadError.WrongKind
            StreamError.AlreadyExists => TextReadError.AlreadyExists
            StreamError.Closed => TextReadError.Closed
            StreamError.InvalidRange => TextReadError.InvalidRange
            StreamError.LimitExceeded => TextReadError.LimitExceeded
            StreamError.WrongAccess => TextReadError.WrongAccess
            StreamError.InvalidEncoding => TextReadError.InvalidEncoding
            _ => TextReadError.IoFailure
        }
    }
}
