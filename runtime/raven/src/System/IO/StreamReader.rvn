namespace System.IO

import System.*
import System.Collections.*
import System.Result.*
import System.Option.*
import System.Text.*
import System.Runtime.CompilerServices.*

public class StreamReader : TextReader {
    private field input: InputStream
    private field leaveOpen: bool
    private field closed: bool = false

    init(input: InputStream) {
        self.input = input
        leaveOpen = false
    }

    init(input: InputStream, leaveOpen: bool) {
        self.input = input
        self.leaveOpen = leaveOpen
    }

    // LF and CRLF delimit lines; a lone CR is data. No read-ahead across lines.
    func ReadLine(maxUtf8Bytes: int) -> Result<Option<string>, TextReadError> {
        if closed {
            return Error(TextReadError.Closed())
        }
        if maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange())
        }
        if maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded())
        }
        let bytes: List<byte> = ArrayList<byte>()
        let buffer: byte[] = [(byte)0]
        while true {
            match input.Read(buffer, 0, 1) {
                Ok(let count) => {
                    if count < 0 {
                        System.Fault("Invalid input read count")
                    }
                    if count > 1 {
                        System.Fault("Invalid input read count")
                    }
                    if count == 0 {
                        if bytes.Count == 0 {
                            let absent: Option<string> = None()
                            return Ok(absent)
                        }
                        if bytes.Count > maxUtf8Bytes {
                            return Error(TextReadError.LimitExceeded())
                        }
                        return DecodeLine(bytes, bytes.Count)
                    }
                    let value = buffer[0]
                    if value == 10 {
                        var length = bytes.Count
                        if length > 0 && bytes[length - 1] == 13 {
                            length -= 1
                        }
                        return DecodeLine(bytes, length)
                    }
                    if bytes.Count >= maxUtf8Bytes && (bytes.Count > maxUtf8Bytes || value != 13) {
                        return Error(TextReadError.LimitExceeded())
                    }
                    bytes.Add(value)
                }
                Error(let error) => return Error(FromStream(error))
            }
        }
        return Error(TextReadError.IoFailure())
    }

    private static func DecodeLine(bytes: Sequence<byte>, length: int) -> Result<Option<string>, TextReadError> {
        let line = CheckedStorage.Reserve<byte>(length)
        var index = 0
        while index < length {
            line[index] = bytes[index]
            index += 1
        }
        return match Utf8.Decode(line) {
            Ok(let text) => {
                let present: Option<string> = Some(text)
                Ok(present)
            }
            Error(_) => Error(TextReadError.InvalidUtf8())
        }
    }

    func ReadToEnd(maxUtf8Bytes: int) -> Result<string, TextReadError> {
        if closed {
            return Error(TextReadError.Closed())
        }
        if maxUtf8Bytes < 0 {
            return Error(TextReadError.InvalidRange())
        }
        if maxUtf8Bytes > 65536 {
            return Error(TextReadError.LimitExceeded())
        }
        let bytes: List<byte> = ArrayList<byte>()
        let buffer = CheckedStorage.Reserve<byte>(256)
        while true {
            var request = maxUtf8Bytes - bytes.Count + 1
            if request > buffer.Length {
                request = buffer.Length
            }
            match input.Read(buffer, 0, request) {
                Ok(let count) => {
                    if count < 0 {
                        System.Fault("Invalid input read count")
                    }
                    if count > request {
                        System.Fault("Invalid input read count")
                    }
                    if count > maxUtf8Bytes - bytes.Count {
                        return Error(TextReadError.LimitExceeded())
                    }
                    if count == 0 {
                        return match Utf8.Decode(bytes) {
                            Ok(let text) => Ok(text)
                            Error(_) => Error(TextReadError.InvalidUtf8())
                        }
                    }
                    var index = 0
                    while index < count {
                        bytes.Add(buffer[index])
                        index += 1
                    }
                }
                Error(let error) => return Error(FromStream(error))
            }
        }
        return Error(TextReadError.IoFailure())
    }

    func Close() {
        if !closed {
            closed = true
            if !leaveOpen {
                input.Close()
            }
        }
    }

    private static func FromStream(error: StreamError) -> TextReadError {
        if error is StreamError.InvalidPath {
            return TextReadError.InvalidPath()
        }
        if error is StreamError.NotFound {
            return TextReadError.NotFound()
        }
        if error is StreamError.AccessDenied {
            return TextReadError.AccessDenied()
        }
        if error is StreamError.WrongKind {
            return TextReadError.WrongKind()
        }
        if error is StreamError.AlreadyExists {
            return TextReadError.AlreadyExists()
        }
        if error is StreamError.Closed {
            return TextReadError.Closed()
        }
        if error is StreamError.InvalidRange {
            return TextReadError.InvalidRange()
        }
        if error is StreamError.LimitExceeded {
            return TextReadError.LimitExceeded()
        }
        if error is StreamError.WrongAccess {
            return TextReadError.WrongAccess()
        }
        if error is StreamError.IoFailure {
            return TextReadError.IoFailure()
        }
        System.Fault("Invalid stream error")
        return TextReadError.IoFailure()
    }
}
