module System.IO

import System.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Result.*
import System.Runtime.CompilerServices.*

public class FileInputStream : InputStream, SeekableStream {
    private field handle: int
    private field closed: bool = false

    private init(handle: int) {
        self.handle = handle
    }

    static func Open(path: string) -> Result<FileInputStream, StreamError> {
        let payload = neoCLR.Runtime.FileOpenRead(path)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(FileInputStream(neoCLR.Runtime.UnpackValue<int>(payload)))
    }

    func Read(buffer: byte[], offset: int, count: int) -> Task<Result<int, StreamError>> {
        return Read(buffer, offset, count, CancellationToken.None)
    }

    /// Returns an inline-completed operation over the current blocking provider.
    func Read(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<int, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<int, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(ReadCore(buffer, offset, count))
    }

    private func ReadCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Failure(StreamError.Closed())
        }
        if offset < 0 || count < 0 || offset > buffer.Length || count > buffer.Length - offset {
            return Failure(StreamError.InvalidRange)
        }
        let memory: Memory<byte> = buffer
        let payload = neoCLR.Runtime.FileReadInto(handle, memory.Slice(offset, count))
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(neoCLR.Runtime.UnpackValue<int>(payload))
    }

    func GetPosition() -> Result<long, StreamError> {
        if closed {
            return Failure(StreamError.Closed())
        }
        let payload = neoCLR.Runtime.FilePosition(handle)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(neoCLR.Runtime.UnpackValue<long>(payload))
    }

    func Seek(position: long) -> Result<long, StreamError> {
        if closed {
            return Failure(StreamError.Closed())
        }
        let payload = neoCLR.Runtime.FileSeek(handle, position)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(neoCLR.Runtime.UnpackValue<long>(payload))
    }

    func Close() {
        if !closed {
            _ = neoCLR.Runtime.FileClose(handle)
            closed = true
        }
    }

    private static func DecodeError(status: byte) -> StreamError {
        if status == 1 {
            return StreamError.InvalidPath()
        }
        if status == 2 {
            return StreamError.NotFound()
        }
        if status == 3 {
            return StreamError.AccessDenied()
        }
        if status == 4 {
            return StreamError.WrongKind()
        }
        if status == 5 {
            return StreamError.AlreadyExists()
        }
        if status == 6 {
            return StreamError.Closed()
        }
        if status == 7 {
            return StreamError.InvalidRange()
        }
        if status == 8 {
            return StreamError.LimitExceeded()
        }
        if status == 9 {
            return StreamError.WrongAccess()
        }
        if status == 10 {
            return StreamError.IoFailure()
        }
        System.Fail("invalid native stream error")
        return StreamError.IoFailure()
    }
}
