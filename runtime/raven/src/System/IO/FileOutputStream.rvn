module System.IO

import System.*
import System.Concurrency.*
import System.Concurrency.Tasks.*
import System.Result.*
import System.Runtime.CompilerServices.*

public class FileOutputStream : OutputStream {
    private field handle: int
    private field closed: bool = false

    private init(handle: int) {
        self.handle = handle
    }

    static func CreateNew(path: string) -> Result<FileOutputStream, StreamError> {
        let payload = neoCLR.Runtime.FileCreateNew(path)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(FileOutputStream(neoCLR.Runtime.UnpackValue<int>(payload)))
    }

    func Write(buffer: byte[], offset: int, count: int) -> Task<Result<unit, StreamError>> {
        return Write(buffer, offset, count, CancellationToken.None)
    }

    /// Completes the range inline with the current blocking provider; partial failures are not rolled back.
    func Write(buffer: byte[], offset: int, count: int, cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<unit, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(WriteAll(buffer, offset, count))
    }

    private func WriteAll(buffer: byte[], offset: int, count: int) -> Result<unit, StreamError> {
        // The provider validates the full range even when count is zero.
        var sent = 0
        while true {
            let written = WriteCore(buffer, offset + sent, count - sent)?
            if !(written >= 0) || written > count - sent {
                System.Fail("Invalid output count")
            }
            sent += written
            if sent == count { return Ok(()) }
            if written == 0 { return Failure(StreamError.IoFailure) }
        }
        return Failure(StreamError.IoFailure)
    }

    func Flush() -> Task<Result<unit, StreamError>> {
        return Flush(CancellationToken.None)
    }

    func Flush(cancellationToken: CancellationToken) -> Task<Result<unit, StreamError>> {
        if cancellationToken.IsCancellationRequested {
            let source = Promise<Result<unit, StreamError>>()
            _ = source.Cancel()
            return source.Task
        }
        return Task.FromResult(FlushCore())
    }

    private func WriteCore(buffer: byte[], offset: int, count: int) -> Result<int, StreamError> {
        if closed {
            return Failure(StreamError.Closed())
        }
        if offset < 0 || count < 0 || offset > buffer.Length || count > buffer.Length - offset {
            return Failure(StreamError.InvalidRange)
        }
        let memory: ReadOnlyMemory<byte> = buffer
        let payload = neoCLR.Runtime.FileWriteChunk(handle, memory.Slice(offset, count))
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(neoCLR.Runtime.UnpackValue<int>(payload))
    }

    private func FlushCore() -> Result<unit, StreamError> {
        if closed {
            return Failure(StreamError.Closed())
        }
        let payload = neoCLR.Runtime.FileFlush(handle)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Failure(DecodeError(neoCLR.Runtime.UnpackValue<byte>(payload)))
        }
        return Ok(())
    }

    func Close() {
        if !closed {
            _ = neoCLR.Runtime.FileClose(handle)
            closed = true
        }
    }

    private static func DecodeError(status: byte) -> StreamError {
        if status == 1 {
            return StreamError.InvalidPath()
        }
        if status == 2 {
            return StreamError.NotFound()
        }
        if status == 3 {
            return StreamError.AccessDenied()
        }
        if status == 4 {
            return StreamError.WrongKind()
        }
        if status == 5 {
            return StreamError.AlreadyExists()
        }
        if status == 6 {
            return StreamError.Closed()
        }
        if status == 7 {
            return StreamError.InvalidRange()
        }
        if status == 8 {
            return StreamError.LimitExceeded()
        }
        if status == 9 {
            return StreamError.WrongAccess()
        }
        if status == 10 {
            return StreamError.IoFailure()
        }
        System.Fail("invalid native stream error")
        return StreamError.IoFailure()
    }
}
