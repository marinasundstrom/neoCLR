namespace System

public struct Duration : ComparableTo<Duration>, EquatableTo<Duration> {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func FromTicks(ticks: long) -> Duration {
        return Duration(ticks)
    }

    val Ticks: long => StoredTicks

    func Equals(other: Duration) -> bool {
        return StoredTicks == other.StoredTicks
    }

    func CompareTo(other: Duration) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
}
