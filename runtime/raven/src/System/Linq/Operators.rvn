namespace System.Linq

import System.Collections.*
import System.Option.*
import System.Result.*

public extension Operators<T> for Iterable<T> {
    func Filter(predicate: System.Func<T, bool>) -> Iterable<T> {
        return WhereSequence<T>(self, predicate)
    }

    func Map<U>(selector: System.Func<T, U>) -> Iterable<U> {
        return SelectSequence<T, U>(self, selector)
    }

    func Any() -> bool {
        let iterator = self.GetIterator()
        let result = iterator.MoveNext()
        iterator.Dispose()
        return result
    }

    func Any(predicate: System.Func<T, bool>) -> bool {
        let iterator = self.GetIterator()
        while iterator.MoveNext() {
            if predicate(iterator.Current) {
                iterator.Dispose()
                return true
            }
        }
        iterator.Dispose()
        return false
    }

    func All(predicate: System.Func<T, bool>) -> bool {
        let iterator = self.GetIterator()
        while iterator.MoveNext() {
            if !predicate(iterator.Current) {
                iterator.Dispose()
                return false
            }
        }
        iterator.Dispose()
        return true
    }

    func Count() -> int {
        let iterator = self.GetIterator()
        var count = 0
        while iterator.MoveNext() {
            if count == 2147483647 {
                iterator.Dispose()
                System.Fault("Query count exceeds Int32 capacity")
            }
            count = count + 1
        }
        iterator.Dispose()
        return count
    }

    func Count(predicate: System.Func<T, bool>) -> int {
        let iterator = self.GetIterator()
        var count = 0
        while iterator.MoveNext() {
            if predicate(iterator.Current) {
                if count == 2147483647 {
                    iterator.Dispose()
                    System.Fault("Query count exceeds Int32 capacity")
                }
                count = count + 1
            }
        }
        iterator.Dispose()
        return count
    }

    func Fold<U>(seed: U, accumulator: System.Func<U, T, U>) -> U {
        let iterator = self.GetIterator()
        var result = seed
        while iterator.MoveNext() {
            result = accumulator(result, iterator.Current)
        }
        iterator.Dispose()
        return result
    }

    func Take(count: int) -> Iterable<T> {
        return TakeSequence<T>(self, count)
    }

    func Skip(count: int) -> Iterable<T> {
        return SkipSequence<T>(self, count)
    }

    func Concat(second: Iterable<T>) -> Iterable<T> {
        return ConcatSequence<T>(self, second)
    }

    func FlatMap<U>(selector: System.Func<T, Iterable<U>>) -> Iterable<U> {
        return FlatMapSequence<T, U>(self, selector)
    }

    func ToList() -> ArrayList<T> {
        let result = ArrayList<T>()
        for item in self {
            result.Add(item)
        }
        return result
    }

    func First() -> System.Option<T> {
        let iterator = self.GetIterator()
        if iterator.MoveNext() {
            let value = iterator.Current
            iterator.Dispose()
            return Some(value)
        }
        iterator.Dispose()
        return None
    }

    func Last() -> System.Option<T> {
        let iterator = self.GetIterator()
        if !iterator.MoveNext() {
            iterator.Dispose()
            return None
        }
        var value = iterator.Current
        while iterator.MoveNext() {
            value = iterator.Current
        }
        iterator.Dispose()
        return Some(value)
    }

    func Single() -> System.Result<T, SingleError> {
        let iterator = self.GetIterator()
        if !iterator.MoveNext() {
            iterator.Dispose()
            return Error(SingleError(SingleError.Empty()))
        }
        let value = iterator.Current
        let multiple = iterator.MoveNext()
        iterator.Dispose()
        if multiple {
            return Error(SingleError(SingleError.Multiple()))
        }
        return Ok(value)
    }

    func First(predicate: System.Func<T, bool>) -> System.Option<T> {
        let iterator = self.GetIterator()
        while iterator.MoveNext() {
            let value = iterator.Current
            if predicate(value) {
                iterator.Dispose()
                return Some(value)
            }
        }
        iterator.Dispose()
        return None
    }

    func Last(predicate: System.Func<T, bool>) -> System.Option<T> {
        let iterator = self.GetIterator()
        while iterator.MoveNext() {
            var value = iterator.Current
            if predicate(value) {
                while iterator.MoveNext() {
                    let current = iterator.Current
                    if predicate(current) {
                        value = current
                    }
                }
                iterator.Dispose()
                return Some(value)
            }
        }
        iterator.Dispose()
        return None
    }

    func Single(predicate: System.Func<T, bool>) -> System.Result<T, SingleError> {
        let iterator = self.GetIterator()
        while iterator.MoveNext() {
            let value = iterator.Current
            if predicate(value) {
                while iterator.MoveNext() {
                    if predicate(iterator.Current) {
                        iterator.Dispose()
                        return Error(SingleError(SingleError.Multiple()))
                    }
                }
                iterator.Dispose()
                return Ok(value)
            }
        }
        iterator.Dispose()
        return Error(SingleError(SingleError.Empty()))
    }
}


internal class WhereSequence<T> : Iterable<T> {
    private field source: Iterable<T>
    private field callback: System.Func<T, bool>

    init(input: Iterable<T>, action: System.Func<T, bool>) {
        source = input
        callback = action
    }

    func GetIterator() -> Iterator<T> {
        return WhereIterator<T>(source.GetIterator(), callback)
    }
}

internal class WhereIterator<T> : Iterator<T> {
    private field source: Iterator<T>
    private field callback: System.Func<T, bool>
    private field cached: T[]
    private field active: bool
    private field finished: bool

    init(input: Iterator<T>, action: System.Func<T, bool>) {
        source = input
        callback = action
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(1)
        active = false
        finished = false
    }

    func MoveNext() -> bool {
        if finished {
            return false
        }
        active = false
        while source.MoveNext() {
            let value = source.Current
            if callback(value) {
                cached[0] = value
                active = true
                return true
            }
        }
        Dispose()
        return false
    }

    val Current: T {
        get {
            if !active {
                System.Fault("Query iterator has no current element")
            }
            return cached[0]
        }
    }

    func Dispose() {
        if finished {
            return
        }
        finished = true
        active = false
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(0)
        source.Dispose()
    }
}


internal class SelectSequence<T, U> : Iterable<U> {
    private field source: Iterable<T>
    private field callback: System.Func<T, U>

    init(input: Iterable<T>, action: System.Func<T, U>) {
        source = input
        callback = action
    }

    func GetIterator() -> Iterator<U> {
        return SelectIterator<T, U>(source.GetIterator(), callback)
    }
}

internal class SelectIterator<T, U> : Iterator<U> {
    private field source: Iterator<T>
    private field callback: System.Func<T, U>
    private field cached: U[]
    private field active: bool
    private field finished: bool

    init(input: Iterator<T>, action: System.Func<T, U>) {
        source = input
        callback = action
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<U>(1)
        active = false
        finished = false
    }

    func MoveNext() -> bool {
        if finished {
            return false
        }
        active = false
        if source.MoveNext() {
            cached[0] = callback(source.Current)
            active = true
            return true
        }
        Dispose()
        return false
    }

    val Current: U {
        get {
            if !active {
                System.Fault("Query iterator has no current element")
            }
            return cached[0]
        }
    }

    func Dispose() {
        if finished {
            return
        }
        finished = true
        active = false
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<U>(0)
        source.Dispose()
    }
}

internal class TakeSequence<T> : Iterable<T> {
    private field source: Iterable<T>
    private field count: int

    init(input: Iterable<T>, amount: int) {
        source = input
        count = amount
    }

    func GetIterator() -> Iterator<T> {
        return TakeIterator<T>(source, count)
    }
}

internal class TakeIterator<T> : Iterator<T> {
    private field input: Iterable<T>
    private field cursor: Iterator<T>[]
    private field remaining: int
    private field cached: T[]
    private field active: bool
    private field finished: bool

    init(source: Iterable<T>, count: int) {
        input = source
        cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        remaining = count
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(1)
        active = false
        finished = false
    }

    func MoveNext() -> bool {
        if finished {
            return false
        }
        active = false
        if remaining <= 0 {
            Dispose()
            return false
        }
        if cursor.Length == 0 {
            cursor = [input.GetIterator()]
        }
        if cursor[0].MoveNext() {
            cached[0] = cursor[0].Current
            active = true
            remaining = remaining - 1
            return true
        }
        Dispose()
        return false
    }

    val Current: T {
        get {
            if !active {
                System.Fault("Query iterator has no current element")
            }
            return cached[0]
        }
    }

    func Dispose() {
        if finished {
            return
        }
        finished = true
        active = false
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(0)
        if cursor.Length != 0 {
            cursor[0].Dispose()
            cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        }
    }
}

internal class SkipSequence<T> : Iterable<T> {
    private field source: Iterable<T>
    private field count: int

    init(input: Iterable<T>, amount: int) {
        source = input
        count = amount
    }

    func GetIterator() -> Iterator<T> {
        return SkipIterator<T>(source, count)
    }
}

internal class SkipIterator<T> : Iterator<T> {
    private field input: Iterable<T>
    private field cursor: Iterator<T>[]
    private field remaining: int
    private field cached: T[]
    private field active: bool
    private field finished: bool

    init(source: Iterable<T>, count: int) {
        input = source
        cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        remaining = count
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(1)
        active = false
        finished = false
    }

    func MoveNext() -> bool {
        if finished {
            return false
        }
        active = false
        if cursor.Length == 0 {
            cursor = [input.GetIterator()]
        }
        while remaining > 0 {
            if !cursor[0].MoveNext() {
                Dispose()
                return false
            }
            remaining = remaining - 1
        }
        if cursor[0].MoveNext() {
            cached[0] = cursor[0].Current
            active = true
            return true
        }
        Dispose()
        return false
    }

    val Current: T {
        get {
            if !active {
                System.Fault("Query iterator has no current element")
            }
            return cached[0]
        }
    }

    func Dispose() {
        if finished {
            return
        }
        finished = true
        active = false
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(0)
        if cursor.Length != 0 {
            cursor[0].Dispose()
            cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        }
    }
}

internal class ConcatSequence<T> : Iterable<T> {
    private field first: Iterable<T>
    private field second: Iterable<T>

    init(left: Iterable<T>, right: Iterable<T>) {
        first = left
        second = right
    }

    func GetIterator() -> Iterator<T> {
        return ConcatIterator<T>(first, second)
    }
}

internal class ConcatIterator<T> : Iterator<T> {
    private field sources: Iterable<T>[]
    private field cursor: Iterator<T>[]
    private field index: int
    private field cached: T[]
    private field active: bool
    private field finished: bool

    init(first: Iterable<T>, second: Iterable<T>) {
        sources = [first, second]
        cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        index = 0
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(1)
        active = false
        finished = false
    }

    func MoveNext() -> bool {
        if finished {
            return false
        }
        active = false
        while index < 2 {
            if cursor.Length == 0 {
                cursor = [sources[index].GetIterator()]
            }
            if cursor[0].MoveNext() {
                cached[0] = cursor[0].Current
                active = true
                return true
            }
            cursor[0].Dispose()
            cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
            index = index + 1
        }
        Dispose()
        return false
    }

    val Current: T {
        get {
            if !active {
                System.Fault("Query iterator has no current element")
            }
            return cached[0]
        }
    }

    func Dispose() {
        if finished {
            return
        }
        finished = true
        active = false
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<T>(0)
        if cursor.Length != 0 {
            cursor[0].Dispose()
            cursor = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        }
        sources = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterable<T>>(0)
    }
}

internal class FlatMapSequence<T, U> : Iterable<U> {
    private field source: Iterable<T>
    private field callback: System.Func<T, Iterable<U>>

    init(input: Iterable<T>, selector: System.Func<T, Iterable<U>>) {
        source = input
        callback = selector
    }

    func GetIterator() -> Iterator<U> {
        return FlatMapIterator<T, U>(source, callback)
    }
}

internal class FlatMapIterator<T, U> : Iterator<U> {
    private field input: Iterable<T>
    private field callback: System.Func<T, Iterable<U>>
    private field outer: Iterator<T>[]
    private field inner: Iterator<U>[]
    private field cached: U[]
    private field active: bool
    private field finished: bool

    init(source: Iterable<T>, selector: System.Func<T, Iterable<U>>) {
        input = source
        callback = selector
        outer = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        inner = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<U>>(0)
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<U>(1)
        active = false
        finished = false
    }

    func MoveNext() -> bool {
        if finished {
            return false
        }
        active = false
        if outer.Length == 0 {
            outer = [input.GetIterator()]
        }
        while true {
            if inner.Length != 0 {
                if inner[0].MoveNext() {
                    cached[0] = inner[0].Current
                    active = true
                    return true
                }
                inner[0].Dispose()
                inner = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<U>>(0)
            }
            if !outer[0].MoveNext() {
                Dispose()
                return false
            }
            let sequence = callback(outer[0].Current)
            inner = [sequence.GetIterator()]
        }
        // The bootstrap compiler requires an explicit terminal return here.
        return false
    }

    val Current: U {
        get {
            if !active {
                System.Fault("Query iterator has no current element")
            }
            return cached[0]
        }
    }

    func Dispose() {
        if finished {
            return
        }
        finished = true
        active = false
        cached = System.Runtime.CompilerServices.CheckedStorage.Reserve<U>(0)
        if inner.Length != 0 {
            inner[0].Dispose()
            inner = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<U>>(0)
        }
        if outer.Length != 0 {
            outer[0].Dispose()
            outer = System.Runtime.CompilerServices.CheckedStorage.Reserve<Iterator<T>>(0)
        }
    }
}
