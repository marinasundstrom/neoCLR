module System

import System.Optional.*
import System.Result.*

public extension ResultOperators<T, E> for Result<T, E> {
    func Map<U>(mapper: (T) -> U) -> Result<U, E> {
        return self match {
            Ok(let value) => Ok(mapper(value))
            Failure(let error) => Failure(error)
        }
    }

    func Then<U>(binder: (T) -> Result<U, E>) -> Result<U, E> {
        return self match {
            Ok(let value) => binder(value)
            Failure(let error) => Failure(error)
        }
    }

    func MapError<F>(mapper: (E) -> F) -> Result<T, F> {
        return self match {
            Ok(let value) => Ok(value)
            Failure(let error) => Failure(mapper(error))
        }
    }

    func Match<U>(ok: (T) -> U, error: (E) -> U) -> U {
        return self match {
            Ok(let value) => ok(value)
            Failure(let errorValue) => error(errorValue)
        }
    }

    func Tap(action: (T) -> System.Void) -> Result<T, E> {
        if self is Ok(let value) {
            action(value)
        }
        return self
    }

    func TapError(action: (E) -> System.Void) -> Result<T, E> {
        if self is Failure(let error) {
            action(error)
        }
        return self
    }

    func OrElse(recover: (E) -> Result<T, E>) -> Result<T, E> {
        return self match {
            Ok(_) => self
            Failure(let error) => recover(error)
        }
    }

    func UnwrapOrElse(factory: () -> T) -> T {
        return self match {
            Ok(let value) => value
            Failure(_) => factory()
        }
    }

    func UnwrapOr(defaultValue: T) -> T {
        return self match {
            Ok(let value) => value
            Failure(_) => defaultValue
        }
    }

    func ToIterable() -> Collections.Iterable<T> {
        let values = Collections.ArrayList<T>()
        if self is Ok(let value) {
            values.Add(value)
        }
        return values
    }
}
