module System.Time

import System.*

import System.Result.*

public struct Instant : ComparableTo<Instant>, EquatableTo<Instant> {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func FromUnixTimeTicks(ticks: long) -> Instant {
        return Instant(ticks)
    }

    func ToLocalDateTime() -> LocalDateTime {
        return LocalDateTime.FromUnixTimeTicks(StoredTicks)
    }

    /// Adds exact elapsed time, independently of calendars and zones.
    func Add(duration: Duration) -> Result<Instant, OverflowError> {
        let amount = duration.Ticks
        if amount > 0L {
            if StoredTicks > 9223372036854775807L - amount {
                return Error(OverflowError())
            }
        }
        if amount < 0L {
            if StoredTicks < -9223372036854775808L - amount {
                return Error(OverflowError())
            }
        }
        return Ok(Instant(StoredTicks + amount))
    }

    /// <summary>Parses invariant yyyy-MM-ddTHH:mm:ss[.fraction] followed by Z or ±HH:mm[:ss].</summary>
    /// <param name="value">Complete ASCII text with an explicit offset; fractions have 1–7 digits.</param>
    /// <returns>The instant, or InvalidFormat/OutOfRange for unsupported syntax or invalid fields.</returns>
    /// <remarks>Local years are 1–9999. Existing ±18-hour, whole-second offsets apply.
    /// UTC can cross those civil boundaries within Instant's wider signed tick domain.
    /// No ambient culture, host zone, whitespace, leap seconds or named zones are accepted.</remarks>
    static func Parse(value: string) -> Result<Instant, DateTimeParseError> {
        return CivilParser.ParseInstant(value)
    }

    val UnixTimeTicks: long => StoredTicks

    func Equals(other: Instant) -> bool {
        return StoredTicks == other.StoredTicks
    }

    func CompareTo(other: Instant) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
}
