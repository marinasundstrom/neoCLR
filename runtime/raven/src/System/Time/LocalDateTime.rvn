module System.Time

import System.*

import System.Result.*

public struct LocalDateTime : EquatableTo<LocalDateTime>, ComparableTo<LocalDateTime>, Formattable {
    /// <summary>Parses a supported numeric civil value using Culture.Current.</summary>
    /// <param name="value">The complete text; whitespace, offsets and zone names are not accepted.</param>
    /// <returns>A value or InvalidFormat/OutOfRange. Use the explicit culture overload for deterministic input.</returns>
    static func Parse(value: string) -> Result<LocalDateTime, DateTimeParseError> {
        return Parse(value, System.Globalization.Culture.Current)
    }

    /// <summary>Parses a supported numeric Gregorian value with an explicit culture.</summary>
    /// <param name="value">The complete culture-specific numeric representation.</param>
    /// <param name="culture">Invariant, SwedishSweden or HebrewIsrael conventions; no ambient culture is read.</param>
    /// <returns>A value or InvalidFormat/OutOfRange; no partial parse or rounding occurs.</returns>
    static func Parse(value: string, culture: System.Globalization.Culture) -> Result<LocalDateTime, DateTimeParseError> {
        return CivilParser.ParseLocal(value, culture)
    }

    private field StoredDate: Date
    private field StoredTime: TimeOfDay

    private init(date: Date, time: TimeOfDay) {
        StoredDate = date
        StoredTime = time
    }

    /// Combines already validated civil values without selecting a zone or offset.
    static func Create(date: Date, time: TimeOfDay) -> LocalDateTime {
        return LocalDateTime(date, time)
    }

    internal static func FromUnixTimeTicks(ticks: long) -> LocalDateTime {
        let parts = neoCLR.Runtime.UnixTimeToLocal(ticks)
        let Ok(date) = System.Time.Date.Create(parts[0], parts[1], parts[2]) else {
            System.Fail("Invalid local date from runtime")
        }
        let Ok(time) = System.Time.TimeOfDay.Create(parts[3], parts[4], parts[5], parts[6]) else {
            System.Fail("Invalid local time from runtime")
        }
        return LocalDateTime(date, time)
    }

    /// Civil arithmetic with day carry; it does not apply timezone transition rules.
    func Add(duration: Duration) -> Result<LocalDateTime, InvalidDateError> {
        let days = duration.Ticks / 864000000000L
        var ticks = StoredTime.Ticks + duration.Ticks % 864000000000L
        var day = StoredDate.DayNumber + days
        if ticks < 0L {
            ticks = ticks + 864000000000L
            day = day - 1L
        }
        if ticks >= 864000000000L {
            ticks = ticks - 864000000000L
            day = day + 1L
        }
        if day < 0L {
            return Failure(InvalidDateError())
        }
        if day > 3652058L {
            return Failure(InvalidDateError())
        }
        let date = System.Time.Date.FromDayNumber((int)day)?
        let Ok(time) = System.Time.TimeOfDay.FromTicks(ticks) else {
            return Failure(InvalidDateError())
        }
        return Ok(LocalDateTime(date, time))
    }

    val Date: Date => StoredDate
    val Time: TimeOfDay => StoredTime

    /// Compares both civil fields, without applying a timezone or culture.
    func Equals(other: LocalDateTime) -> bool {
        return StoredDate.Equals(other.StoredDate) && StoredTime.Equals(other.StoredTime)
    }

    /// Compares a boxed civil value; null and other types are unequal.
    override func Equals(other: Object?) -> bool {
        return other is LocalDateTime value && Equals(value)
    }

    /// Combines the date and complete tick-of-day hashes; not a persistent identifier.
    override func GetHashCode() -> int {
        return HashCode.Combine(StoredDate.GetHashCode(), StoredTime.GetHashCode())
    }

    /// Orders by date first, then complete tick of day; this does not compare instants.
    func CompareTo(other: LocalDateTime) -> int {
        let dateOrder = StoredDate.CompareTo(other.StoredDate)
        return if dateOrder != 0 { dateOrder } else { StoredTime.CompareTo(other.StoredTime) }
    }

    /// Formats with Culture.Current; supported formats are documented by DateTimeFormat.FormatLocalDateTime.
    func ToString(format: string) -> string => ToString(format, Globalization.Culture.Current)

    /// Formats with an explicit culture; unsupported specifiers fault. O/o is invariant.
    func ToString(format: string, culture: Globalization.Culture) -> string {
        let Ok(text) = culture.DateTimeFormat.FormatLocalDateTime(self, format) else {
            System.Fail("A supported culture must format every valid LocalDateTime")
        }
        return text
    }

    /// Formats the civil date and time using Culture.Current, without an offset or zone.
    override func ToString() -> string => ToString("", Globalization.Culture.Current)

    /// Formats the civil date and time using an explicit culture.
    func ToString(culture: Globalization.Culture) -> string => ToString("", culture)

}
