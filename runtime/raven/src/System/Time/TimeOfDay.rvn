module System.Time

import System.*

import System.Result.*

public struct TimeOfDay : ComparableTo<TimeOfDay>, EquatableTo<TimeOfDay>, Formattable {
    /// <summary>Parses a supported numeric civil value using Culture.Current.</summary>
    /// <param name="value">The complete text; whitespace, offsets and zone names are not accepted.</param>
    /// <returns>A value or InvalidFormat/OutOfRange. Use the explicit culture overload for deterministic input.</returns>
    static func Parse(value: string) -> Result<TimeOfDay, DateTimeParseError> {
        return Parse(value, System.Globalization.Culture.Current)
    }

    /// <summary>Parses a supported numeric Gregorian value with an explicit culture.</summary>
    /// <param name="value">The complete culture-specific numeric representation.</param>
    /// <param name="culture">Invariant, SwedishSweden or HebrewIsrael conventions; no ambient culture is read.</param>
    /// <returns>A value or InvalidFormat/OutOfRange; no partial parse or rounding occurs.</returns>
    static func Parse(value: string, culture: System.Globalization.Culture) -> Result<TimeOfDay, DateTimeParseError> {
        return CivilParser.ParseTime(value, culture)
    }

    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func Create(hour: int, minute: int, second: int) -> Result<TimeOfDay, InvalidTimeError> {
        return Create(hour, minute, second, 0)
    }

    static func Create(hour: int, minute: int, second: int, fractionTicks: int) -> Result<TimeOfDay, InvalidTimeError> {
        if hour < 0 {
            return Failure(InvalidTimeError())
        }
        if hour > 23 {
            return Failure(InvalidTimeError())
        }
        if minute < 0 {
            return Failure(InvalidTimeError())
        }
        if minute > 59 {
            return Failure(InvalidTimeError())
        }
        if second < 0 {
            return Failure(InvalidTimeError())
        }
        if second > 59 {
            return Failure(InvalidTimeError())
        }
        if fractionTicks < 0 {
            return Failure(InvalidTimeError())
        }
        if fractionTicks > 9999999 {
            return Failure(InvalidTimeError())
        }
        let seconds: long = (hour * 60 + minute) * 60 + second
        return Ok(TimeOfDay(seconds * 10000000L + fractionTicks))
    }

    static func FromTicks(ticks: long) -> Result<TimeOfDay, InvalidTimeError> {
        if ticks < 0L {
            return Failure(InvalidTimeError())
        }
        if ticks > 863999999999L {
            return Failure(InvalidTimeError())
        }
        return Ok(TimeOfDay(ticks))
    }

    /// Adds elapsed ticks modulo one day. Use LocalDateTime.Add to retain the date carry.
    func Add(duration: Duration) -> TimeOfDay {
        var ticks = StoredTicks + duration.Ticks % 864000000000L
        if ticks < 0L {
            ticks = ticks + 864000000000L
        }
        if ticks >= 864000000000L {
            ticks = ticks - 864000000000L
        }
        return TimeOfDay(ticks)
    }

    override func ToString() -> string {
        return ToString(System.Globalization.Culture.Current)
    }

    func ToString(culture: System.Globalization.Culture) -> string {
        return culture.DateTimeFormat.FormatTime(self)
    }

    val Ticks: long => StoredTicks
    val Hour: int => (int)(StoredTicks / 36000000000L)
    val Minute: int => (int)(StoredTicks / 600000000L % 60L)
    val Second: int => (int)(StoredTicks / 10000000L % 60L)
    val Millisecond: int => (int)(StoredTicks / 10000L % 1000L)
    val FractionTicks: int => (int)(StoredTicks % 10000000L)

    func Equals(other: TimeOfDay) -> bool {
        return StoredTicks == other.StoredTicks
    }

    /// Compares the complete value with a boxed TimeOfDay; null and other types are unequal.
    override func Equals(other: Object?) -> bool {
        return other is TimeOfDay value && Equals(value)
    }

    /// Returns an execution-local value hash consistent with equality; not a persistent identifier.
    override func GetHashCode() -> int {
        return (int)StoredTicks ^ (int)(StoredTicks >> 32)
    }

    func CompareTo(other: TimeOfDay) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
    /// Formats with Culture.Current; supported formats are documented by DateTimeFormat.FormatTime.
    func ToString(format: string) -> string => ToString(format, Globalization.Culture.Current)

    /// Formats with an explicit culture; unsupported specifiers fault. O/o is invariant.
    func ToString(format: string, culture: Globalization.Culture) -> string {
        return culture.DateTimeFormat.FormatTime(self, format)
    }

}
