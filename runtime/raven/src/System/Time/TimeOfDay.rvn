module System.Time

import System.*

import System.Result.*

public struct TimeOfDay : ComparableTo<TimeOfDay>, EquatableTo<TimeOfDay> {
    private field StoredTicks: long

    private init(ticks: long) {
        StoredTicks = ticks
    }

    static func Create(hour: int, minute: int, second: int) -> Result<TimeOfDay, InvalidTimeError> {
        return Create(hour, minute, second, 0)
    }

    static func Create(hour: int, minute: int, second: int, fractionTicks: int) -> Result<TimeOfDay, InvalidTimeError> {
        if hour < 0 {
            return Error(InvalidTimeError())
        }
        if hour > 23 {
            return Error(InvalidTimeError())
        }
        if minute < 0 {
            return Error(InvalidTimeError())
        }
        if minute > 59 {
            return Error(InvalidTimeError())
        }
        if second < 0 {
            return Error(InvalidTimeError())
        }
        if second > 59 {
            return Error(InvalidTimeError())
        }
        if fractionTicks < 0 {
            return Error(InvalidTimeError())
        }
        if fractionTicks > 9999999 {
            return Error(InvalidTimeError())
        }
        let seconds: long = (hour * 60 + minute) * 60 + second
        return Ok(TimeOfDay(seconds * 10000000L + fractionTicks))
    }

    static func FromTicks(ticks: long) -> Result<TimeOfDay, InvalidTimeError> {
        if ticks < 0L {
            return Error(InvalidTimeError())
        }
        if ticks > 863999999999L {
            return Error(InvalidTimeError())
        }
        return Ok(TimeOfDay(ticks))
    }

    /// Adds elapsed ticks modulo one day. Use LocalDateTime.Add to retain the date carry.
    func Add(duration: Duration) -> TimeOfDay {
        var ticks = StoredTicks + duration.Ticks % 864000000000L
        if ticks < 0L {
            ticks = ticks + 864000000000L
        }
        if ticks >= 864000000000L {
            ticks = ticks - 864000000000L
        }
        return TimeOfDay(ticks)
    }

    override func ToString() -> string {
        return ToString(System.Globalization.Culture.Current)
    }

    func ToString(culture: System.Globalization.Culture) -> string {
        return culture.DateTimeFormat.FormatTime(self)
    }

    val Ticks: long => StoredTicks
    val Hour: int => (int)(StoredTicks / 36000000000L)
    val Minute: int => (int)(StoredTicks / 600000000L % 60L)
    val Second: int => (int)(StoredTicks / 10000000L % 60L)
    val Millisecond: int => (int)(StoredTicks / 10000L % 1000L)
    val FractionTicks: int => (int)(StoredTicks % 10000000L)

    func Equals(other: TimeOfDay) -> bool {
        return StoredTicks == other.StoredTicks
    }

    func CompareTo(other: TimeOfDay) -> int {
        if StoredTicks < other.StoredTicks {
            return -1
        }
        if StoredTicks > other.StoredTicks {
            return 1
        }
        return 0
    }
}
