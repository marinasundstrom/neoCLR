module System.Time

import System.*

import System.Result.*

/// An immutable resolved instant and its projection under a named zone's rules.
public class ZonedDateTime : EquatableTo<ZonedDateTime> {
    private var instant: Instant
    private var zone: TimeZone
    private var local: LocalDateTime
    private var offset: TimeOffset

    private init(instant: Instant, zone: TimeZone, local: LocalDateTime, offset: TimeOffset) {
        self.instant = instant
        self.zone = zone
        self.local = local
        self.offset = offset
    }

    /// <summary>Parses an explicit-offset invariant timestamp and validates it against the supplied named zone.</summary>
    /// <param name="value">The same complete numeric timestamp accepted by Instant.Parse.</param>
    /// <param name="zone">An explicitly resolved zone; the host zone is never inferred.</param>
    /// <returns>A zoned value, InvalidFormat, OutOfRange, or OffsetMismatch.</returns>
    /// <remarks>Both UTC and local years must lie in the zone's supported range.
    /// An overlap is selected by its stated offset. Gaps and incorrect offsets return OffsetMismatch.
    /// No zone identifier is embedded in the text; resolve names separately with TimeZone.Find.</remarks>
    static func Parse(value: string, zone: TimeZone) -> Result<ZonedDateTime, DateTimeParseError> {
        return CivilParser.ParseZoned(value, zone)
    }

    static func Create(instant: Instant, zone: TimeZone) -> Result<ZonedDateTime, TimeZoneError> {
        let offset = zone.GetUtcOffset(instant)?
        let Ok(local) = offset.AtInstant(instant) else {
            return Error(TimeZoneError.OutOfRange)
        }
        return Ok(ZonedDateTime(instant, zone, local, offset))
    }

    /// Compares the same instant in the same named zone. Use Instant for timeline-only equality.
    /// Local fields and offset are deterministic projections under the fixed bundled rules.
    func Equals(other: ZonedDateTime) -> bool => instant.Equals(other.instant) && zone.Equals(other.zone)

    /// Compares zoned values; null and other types are unequal.
    override func Equals(other: Object?) -> bool => other is ZonedDateTime value && Equals(value)

    /// Combines instant and named-zone hashes without allocating wrappers or formatted strings.
    override func GetHashCode() -> int => HashCode.Combine(instant.GetHashCode(), zone.GetHashCode())

    val Instant: Instant => instant
    val Zone: TimeZone => zone
    val LocalDateTime: LocalDateTime => local
    val Offset: TimeOffset => offset
}
