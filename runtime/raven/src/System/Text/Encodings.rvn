module System.Text

import System.*
import System.Collections.*
import System.Result.*

public static class Encodings {
    // Invocation-owned provider caches; encoder/decoder session state is never shared.
    private static var utf8: Encoding?
    private static var ascii: Encoding?

    /// Returns the stateless UTF-8 provider. CreateEncoder/CreateDecoder create independent sessions.
    static val Utf8: Encoding {
        get {
            if utf8 is Encoding cached {
                return cached
            }
            let created = Utf8Encoding()
            utf8 = created
            return created
        }
    }

    /// Returns the stateless ASCII provider. CreateEncoder/CreateDecoder create independent sessions.
    static val Ascii: Encoding {
        get {
            if ascii is Encoding cached {
                return cached
            }
            let created = AsciiEncoding()
            ascii = created
            return created
        }
    }
}

internal class Utf8Encoding : Encoding {
    func Decode(bytes: ReadOnlySlice<byte>) -> Result<string, EncodingError> {
        if bytes.Length > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        return match Utf8.Decode(bytes) {
            Ok(let text) => Ok(text)
            Failure(_) => Failure(EncodingError.InvalidUtf8)
        }
    }

    func CreateEncoder() -> Encoder {
        return TextEncoder(false)
    }
    func Encode(text: string) -> Result<Sequence<byte>, EncodingError> {
        if text.GetUtf8ByteCount() > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        return Ok(Utf8.Encode(text))
    }
    func CreateDecoder() -> Decoder {
        return Utf8Decoder()
    }
}

internal class AsciiEncoding : Encoding {
    func Decode(bytes: ReadOnlySlice<byte>) -> Result<string, EncodingError> {
        if bytes.Length > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        var index = 0
        while index < bytes.Length {
            if bytes[index] > 127 {
                return Failure(EncodingError.InvalidData)
            }
            index += 1
        }
        return match Utf8.Decode(bytes) {
            Ok(let text) => Ok(text)
            Failure(_) => Failure(EncodingError.InvalidData)
        }
    }

    func CreateEncoder() -> Encoder {
        return TextEncoder(true)
    }
    func Encode(text: string) -> Result<Sequence<byte>, EncodingError> {
        if text.GetUtf8ByteCount() > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        let bytes = Utf8.Encode(text)
        for value in bytes {
            if value > 127 {
                return Failure(EncodingError.UnrepresentableText)
            }
        }
        return Ok(bytes)
    }
    func CreateDecoder() -> Decoder {
        return AsciiDecoder()
    }
}

internal class Utf8Decoder : Decoder {
    private var carry: byte[] = [(byte)0, (byte)0, (byte)0, (byte)0]
    private var pending: int = 0
    private var width: int = 0
    private var stopped: bool = false

    func Decode(source: ReadOnlySlice<byte>, final: bool) -> Result<string, EncodingError> {
        if stopped {
            return Failure(EncodingError.Finished)
        }
        let count = source.Length
        if count > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        let output = ArrayList<byte>(count + 3)
        var index = 0
        while index < count {
            let value = source[index]
            if pending == 0 {
                if value <= 127 {
                    width = 1
                } else if value >= 194 && value <= 223 {
                    width = 2
                } else if value >= 224 && value <= 239 {
                    width = 3
                } else if value >= 240 && value <= 244 {
                    width = 4
                } else {
                    stopped = true
                    return Failure(EncodingError.InvalidUtf8)
                }
            } else if !(value >= 128 && value <= 191) {
                stopped = true
                return Failure(EncodingError.InvalidUtf8)
            }
            carry[pending] = value
            pending += 1
            index += 1
            if pending == width {
                for slot in 0..width {
                    output.Add(carry[slot])
                }
                pending = 0
            }
        }
        if final {
            stopped = true
            if pending != 0 {
                return Failure(EncodingError.InvalidUtf8)
            }
        }
        return match Utf8.Decode(output) {
            Ok(let text) => Ok(text)
            Failure(_) => {
                stopped = true
                Failure(EncodingError.InvalidUtf8)
            }
        }
    }
}

internal class AsciiDecoder : Decoder {
    private var stopped: bool = false

    func Decode(source: ReadOnlySlice<byte>, final: bool) -> Result<string, EncodingError> {
        if stopped {
            return Failure(EncodingError.Finished)
        }
        let count = source.Length
        if count > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        let bytes = ArrayList<byte>(count)
        var index = 0
        while index < count {
            let value = source[index]
            if value > 127 {
                stopped = true
                return Failure(EncodingError.InvalidData)
            }
            bytes.Add(value)
            index += 1
        }
        if final {
            stopped = true
        }
        return match Utf8.Decode(bytes) {
            Ok(let text) => Ok(text)
            Failure(_) => Failure(EncodingError.InvalidData)
        }
    }
}

internal class TextEncoder : Encoder {
    private var policy: Encoding = Encodings.Utf8
    private var ascii: bool = false
    private var text: string = ""
    private var sourceOffset: int = 0
    private var bytes: Sequence<byte> = ArrayList<byte>()
    private var byteOffset: int = 0
    private var pending: bool = false
    private var ending: bool = false
    private var finished: bool = false

    init(strictAscii: bool) {
        ascii = strictAscii
        if strictAscii {
            policy = Encodings.Ascii
        }
    }

    func Accept(text: string, final: bool) -> Result<unit, EncodingError> {
        if finished || ending {
            return Failure(EncodingError.Finished)
        }
        if pending {
            return Failure(EncodingError.Busy)
        }
        if text.GetUtf8ByteCount() > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        // Validate restricted encodings before acceptance or any destination write.
        if ascii {
            var position = 0
            while position < text.GetUtf8ByteCount() {
                let part = ScalarChunk(text, position)
                match policy.Encode(part) {
                    Ok(_) => { }
                    Failure(_) => return Failure(EncodingError.UnrepresentableText)
                }
                position += part.GetUtf8ByteCount()
            }
        }
        self.text = text
        sourceOffset = 0
        bytes = ArrayList<byte>()
        byteOffset = 0
        pending = true
        ending = final
        return Ok(())
    }

    func Drain(output: Slice<byte>) -> Result<EncoderProgress, EncodingError> {
        if finished {
            return Failure(EncodingError.Finished)
        }
        let count = output.Length
        if count > 65536 {
            return Failure(EncodingError.LimitExceeded)
        }
        if !pending {
            return Ok(EncoderProgress(0, EncoderState.Ready))
        }
        var written = 0
        while written < count {
            if byteOffset == bytes.Count {
                if sourceOffset == text.GetUtf8ByteCount() {
                    break
                }
                let part = ScalarChunk(text, sourceOffset)
                bytes = match policy.Encode(part) {
                    Ok(let encoded) => encoded
                    Failure(_) => {
                        System.Fail("Validated text encoding failed")
                        ArrayList<byte>()
                    }
                }
                sourceOffset += part.GetUtf8ByteCount()
                byteOffset = 0
            }
            output[written] = bytes[byteOffset]
            byteOffset += 1
            written += 1
        }
        if sourceOffset == text.GetUtf8ByteCount() && byteOffset == bytes.Count {
            text = ""
            bytes = ArrayList<byte>()
            pending = false
            if ending {
                finished = true
                return Ok(EncoderProgress(written, EncoderState.Finished))
            }
            return Ok(EncoderProgress(written, EncoderState.Ready))
        }
        return Ok(EncoderProgress(written, EncoderState.NeedsOutput))
    }

    // Internal provider: helper visibility follows the bridge dependency profile.
    func ScalarChunk(text: string, start: int) -> string {
        var count = text.GetUtf8ByteCount() - start
        if count > 256 {
            count = 256
        }
        while count > 0 {
            match text.SliceUtf8(start, count) {
                Ok(let part) => return part
                Failure(_) => count -= 1
            }
        }
        System.Fail("Invalid internal scalar boundary")
        return ""
    }
}
