namespace System

public union UriError {
    case InvalidFormat
    case UnsupportedAuthority
    case TooLong
    case BaseNotAbsolute

    override func ToString() -> string {
        return match self {
            InvalidFormat => "InvalidFormat"
            UnsupportedAuthority => "UnsupportedAuthority"
            TooLong => "TooLong"
            BaseNotAbsolute => "BaseNotAbsolute"
            _ => "Empty"
        }
    }
}
