module System

import System.Result.*

public struct Byte : Number, EquatableTo<byte> {
    // The runtime supplies intrinsic primitive storage.
    #pragma warning disable-next-line RAV9032
    private field m_value: byte

    static val Zero: byte => (byte)0
    static val One: byte => (byte)1

    static func +(left: byte, right: byte) -> byte => (byte)(left + right)
    static func -(left: byte, right: byte) -> byte => (byte)(left - right)
    static func *(left: byte, right: byte) -> byte => (byte)(left * right)
    static func /(left: byte, right: byte) -> byte => (byte)(left / right)

    /// Parses the complete text using the strict, culture-independent grammar.
    static func Parse(value: string) -> Result<byte, NumberParseError> {
        let payload = neoCLR.Runtime.ParseByte(value)
        if neoCLR.Runtime.IsValue<byte>(payload) {
            return Ok(neoCLR.Runtime.UnpackValue<byte>(payload))
        }
        let status = neoCLR.Runtime.UnpackValue<int>(payload)
        if status == 1 {
            return Error(NumberParseError.InvalidFormat())
        }
        if status == 2 {
            return Error(NumberParseError.Overflow())
        }
        System.Fail("invalid native parse status")
        return Error(NumberParseError.InvalidFormat())
    }

    /// Tests equality with another value of the same type without boxing.
    func Equals(other: byte) -> bool => m_value == other

    func CompareTo(other: byte) -> int {
        if m_value < other {
            return -1
        }
        if m_value > other {
            return 1
        }
        return 0
    }
}
