module System

public union NumberParseError : System.Error {
    /// A human-readable case description; use patterns to classify this failure.
    val Message: string => ToString()

    /// Leaf failures have no underlying cause.
    val Cause: System.Option<System.Error> => System.Option<System.Error>.None

    /// Leaf failures do not capture stacks implicitly.
    val StackTrace: System.Option<System.Diagnostics.StackTrace> => System.Option<System.Diagnostics.StackTrace>.None

    case InvalidFormat
    case Overflow
}
