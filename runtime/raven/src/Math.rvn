namespace System.Math

import System.Runtime.CompilerServices.RuntimeServices

import System.OverflowError
import System.InvalidRangeError
import System.Result.*

public func Abs(value: int) -> System.Result<int, OverflowError> {
    if value == -2147483648 {
        return Error(OverflowError())
    }
    if value < 0 {
        return Ok(0 - value)
    }
    return Ok(value)
}

public func Min(left: int, right: int) -> int {
    if left < right {
        return left
    }
    return right
}

public func Max(left: int, right: int) -> int {
    if left > right {
        return left
    }
    return right
}

public func Sign(value: int) -> int {
    if value < 0 {
        return -1
    }
    if value > 0 {
        return 1
    }
    return 0
}

public func Clamp(value: int, min: int, max: int) -> System.Result<int, InvalidRangeError> {
    if min > max {
        return Error(InvalidRangeError())
    }
    return Ok(Min(Max(value, min), max))
}

public func Abs(value: double) -> double {
    return RuntimeServices.MathAbs(value)
}

public func Sqrt(value: double) -> double {
    return RuntimeServices.MathSqrt(value)
}

public func Floor(value: double) -> double {
    return RuntimeServices.MathFloor(value)
}

public func Ceiling(value: double) -> double {
    return RuntimeServices.MathCeiling(value)
}

public func Truncate(value: double) -> double {
    return RuntimeServices.MathTruncate(value)
}

public func Round(value: double) -> double {
    return RuntimeServices.MathRound(value)
}

public func Exp(value: double) -> double {
    return RuntimeServices.MathExp(value)
}

public func Log(value: double) -> double {
    return RuntimeServices.MathLog(value)
}

public func Log10(value: double) -> double {
    return RuntimeServices.MathLog10(value)
}

public func Sin(value: double) -> double {
    return RuntimeServices.MathSin(value)
}

public func Cos(value: double) -> double {
    return RuntimeServices.MathCos(value)
}

public func Tan(value: double) -> double {
    return RuntimeServices.MathTan(value)
}

public func Pow(left: double, right: double) -> double {
    return RuntimeServices.MathPow(left, right)
}

public func Min(left: double, right: double) -> double {
    return RuntimeServices.MathMin(left, right)
}

public func Max(left: double, right: double) -> double {
    return RuntimeServices.MathMax(left, right)
}
