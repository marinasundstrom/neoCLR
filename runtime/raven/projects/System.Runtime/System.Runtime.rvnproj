<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>System.Runtime</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RavenTargetPlatform>NeoCLR</RavenTargetPlatform>
    <RavenMetadataFormat>NeoCLR</RavenMetadataFormat>
    <!-- RavenNeoClrCoreReference and RavenNeoClrRuntimeSeed are explicit host inputs. -->
    <!-- Higher-level builds use the finalized seed; this root always uses its compile-time seed. -->
    <RavenNeoClrRuntimeSeed Condition="'$(RavenNeoClrBootstrapSeed)' != ''">$(RavenNeoClrBootstrapSeed)</RavenNeoClrRuntimeSeed>
    <RavenNeoClrBootstrapOwnership>ownership.json</RavenNeoClrBootstrapOwnership>
    <RavenNeoClrSourceObjectRoot>true</RavenNeoClrSourceObjectRoot>
    <RavenNeoClrBootstrapIntrinsics>true</RavenNeoClrBootstrapIntrinsics>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/System/**/*.rvn"
             Exclude="../../src/System/Data/**/*.rvn;../../src/System/Networking/**/*.rvn;../../src/System/Web/**/*.rvn" />
    <Compile Include="../../native/*.rvn"
             Exclude="../../native/ObjectIntrospection.rvn;../../native/RuntimeNetworkCalls.rvn;../../native/RuntimeNetworkServices.rvn" />
  </ItemGroup>
</Project>
