<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>System.Runtime</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RavenTargetPlatform>NeoCLR</RavenTargetPlatform>
    <RavenMetadataFormat>NeoCLR</RavenMetadataFormat>
    <RavenNeoClrSourceCore>true</RavenNeoClrSourceCore>
    <RavenNeoClrRuntimeContracts>ownership.json</RavenNeoClrRuntimeContracts>
    <RavenNeoClrAsyncLibrary>System.Runtime</RavenNeoClrAsyncLibrary>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../core/*.rvn" />
    <Compile Include="../../src/System/**/*.rvn"
             Exclude="../../src/System/Data/**/*.rvn;../../src/System/Networking/**/*.rvn;../../src/System/Web/**/*.rvn" />
    <Compile Include="../../native/*.rvn"
             Exclude="../../native/ObjectIntrospection.rvn;../../native/RuntimeNetworkCalls.rvn" />
  </ItemGroup>
</Project>
