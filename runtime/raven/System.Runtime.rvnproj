  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'IntPtr'">
    <Compile Include="src/System/IntPtr.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'UIntPtr'">
    <Compile Include="src/System/UIntPtr.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Int32'">
    <Compile Include="src/System/Int32.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Environment'">
    <Compile Include="src/System/Environment/Functions.rvn" />
  </ItemGroup>
