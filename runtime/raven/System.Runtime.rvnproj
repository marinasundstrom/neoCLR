<Project>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>System.Runtime</AssemblyName>
    <NeoCLRRoot>$(NeoCLRBootstrapRoot)</NeoCLRRoot>
  </PropertyGroup>
  <Import Project="../../build/NeoCLR.Raven.props" />
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'TaskState'">
    <Compile Include="src/System/Tasks/TaskState.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'TaskOutcome'">
    <Compile Include="src/System/Tasks/TaskOutcome.rvn" />
  </ItemGroup>
  <!-- Declaration slices shadow core types and contain no typeof expressions. -->
  <PropertyGroup>
    <RavenTypeOfAssemblyName></RavenTypeOfAssemblyName>
    <RavenTypeOfInfoType></RavenTypeOfInfoType>
    <RavenTypeOfContextType></RavenTypeOfContextType>
  </PropertyGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == ''">
    <Compile Include="src/System/Math/Functions.rvn" />
    <Compile Include="src/System/Linq/Operators.rvn" />
    <Compile Include="src/System/OptionOperators.rvn" />
    <Compile Include="src/System/ResultOperators.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'FileText'">
    <Compile Include="src/System/Storage/FileText.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'StorageItems'">
    <Compile Include="src/System/Storage/StorageItems.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'StorageLookup'">
    <Compile Include="src/System/Storage/StorageLookup.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Clock'">
    <Compile Include="src/System/Clock.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'ArrayList'">
    <Compile Include="src/System/Collections/ArrayList.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'HashMap'">
    <Compile Include="src/System/Collections/HashMap.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Time'">
    <Compile Include="src/System/Time.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Date'">
    <Compile Include="src/System/Date.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Int64'">
    <Compile Include="src/System/Int64.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'SByte'">
    <Compile Include="src/System/SByte.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Byte'">
    <Compile Include="src/System/Byte.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Int16'">
    <Compile Include="src/System/Int16.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'UInt16'">
    <Compile Include="src/System/UInt16.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'UInt32'">
    <Compile Include="src/System/UInt32.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'UInt64'">
    <Compile Include="src/System/UInt64.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Single'">
    <Compile Include="src/System/Single.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Double'">
    <Compile Include="src/System/Double.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Boolean'">
