    <RavenRecordAssemblyName></RavenRecordAssemblyName>
    <RavenRecordEquatableType></RavenRecordEquatableType>
    <RavenRecordHashCodeType></RavenRecordHashCodeType>
    <RavenTypeOfAssemblyName Condition="'$(NeoCLRLibrarySlice)' != 'JsonValue'"></RavenTypeOfAssemblyName>
    <RavenTypeOfInfoType Condition="'$(NeoCLRLibrarySlice)' != 'JsonValue'"></RavenTypeOfInfoType>
    <RavenTypeOfContextType Condition="'$(NeoCLRLibrarySlice)' != 'JsonValue'"></RavenTypeOfContextType>
  </PropertyGroup>
