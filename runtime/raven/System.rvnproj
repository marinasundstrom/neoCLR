    <Compile Include="src/System/String.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'InvalidRangeError'">
    <Compile Include="src/System/InvalidRangeError.rvn" />
