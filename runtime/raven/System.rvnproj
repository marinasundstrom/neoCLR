    <Compile Include="src/System/Type.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'ParameterInfo'">
    <Compile Include="src/System/Introspection/ParameterInfo.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'TypeInfo'">
    <Compile Include="src/System/Introspection/TypeInfo.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Instant'">
