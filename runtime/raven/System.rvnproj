<Project>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>NeoCLR.System</AssemblyName>
    <NeoCLRRoot>$(NeoCLRBootstrapRoot)</NeoCLRRoot>
  </PropertyGroup>
  <Import Project="../../build/NeoCLR.Raven.props" />
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == ''">
    <Compile Include="src/Math.rvn" />
    <Compile Include="src/Linq.rvn" />
    <Compile Include="src/Int32.rvn" />
    <Compile Include="src/Char.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'ArrayList'">
    <Compile Include="src/ArrayList.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'HashMap'">
    <Compile Include="src/HashMap.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Time'">
    <Compile Include="src/Time.rvn" />
  </ItemGroup>
  <ItemGroup Condition="'$(NeoCLRLibrarySlice)' == 'Date'">
    <Compile Include="src/Date.rvn" />
  </ItemGroup>
</Project>
