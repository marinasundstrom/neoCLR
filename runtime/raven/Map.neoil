; Experimental hashed lookup. Callback equivalence and stable matching hashes are a caller contract.
; Storage is managed and all algorithms use existing IL. No default comparer is implied.

.interface System.Collections.Map<K,V>

    .property instance Count() -> Int32
        .get instance System.Collections.Map<K,V>::get_Count()
    .end

    .method instance get_Count() -> Int32

    .end

    .property instance Keys() -> System.Collections.Sequence<K>
        .get instance System.Collections.Map<K,V>::get_Keys()
    .end

    .method instance get_Keys() -> System.Collections.Sequence<K>

    .end

    .method instance Find(K key) -> System.Option<V>

    .end

    .method instance ContainsKey(K key) -> Boolean

    .end

.end

.interface System.Collections.MutableMap<K,V>
    .implements System.Collections.Map<K,V>

    .method instance TryAdd(K key,V value) -> Boolean

    .end

    .method instance Set(K key,V value) -> void

    .end

.end

.type internal class System.Collections.MapCallbacks<K>
    .field Equal System.Func<K,K,Boolean>
    .field Hash System.Func<K,Int32>
.end

.type class System.Collections.HashMap<K,V>
    .implements System.Collections.MutableMap<K,V>

    .field private Callbacks System.Collections.MapCallbacks<K>

    .field private Buckets arrayref<Int32>

    .field private StoredKeys System.Collections.ArrayList<K>

    .field private StoredValues System.Collections.ArrayList<V>

    .field private Hashes System.Collections.ArrayList<Int32>

    .field private Next System.Collections.ArrayList<Int32>

    .field private Busy Boolean

    .method instance .ctor(System.Func<K,K,Boolean> equal,System.Func<K,Int32> hash) -> void
        ldarg this
        ldarg equal
        ldarg hash
        newobj System.Collections.MapCallbacks<K>
        stfld System.Collections.HashMap<K,V>::Callbacks
        ldarg this
        ldc.i4 4
        newarr Int32
        stfld System.Collections.HashMap<K,V>::Buckets
        ldarg this
        newobj instance System.Collections.ArrayList<K>::.ctor()
        stfld System.Collections.HashMap<K,V>::StoredKeys
        ldarg this
        newobj instance System.Collections.ArrayList<V>::.ctor()
        stfld System.Collections.HashMap<K,V>::StoredValues
        ldarg this
        newobj instance System.Collections.ArrayList<Int32>::.ctor()
        stfld System.Collections.HashMap<K,V>::Hashes
        ldarg this
        newobj instance System.Collections.ArrayList<Int32>::.ctor()
        stfld System.Collections.HashMap<K,V>::Next
        ret
    .end

    .property instance Count() -> Int32
        .get instance System.Collections.HashMap<K,V>::get_Count()
    .end

    .method instance get_Count() -> Int32
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredKeys
        call instance System.Collections.ArrayList<K>::get_Count()
        ret
    .end

    .method private instance Enter() -> void
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Busy
        brtrue Invalid
        ldarg this
        ldc.bool true
        stfld System.Collections.HashMap<K,V>::Busy
        ret
    Invalid:
        fault "HashMap callbacks must not reenter the map"
    .end

    .method private instance Leave() -> void
        ldarg this
        ldc.bool false
        stfld System.Collections.HashMap<K,V>::Busy
        ret
    .end

    .method private instance HashKey(K key) -> Int32
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Callbacks
        ldfld System.Collections.MapCallbacks<K>::Hash
        ldarg key
        call instance System.Func<K,Int32>::Invoke(K)
        ldc.i4 2147483647
        and
        ret
    .end

    .method private instance Locate(K key,Int32 hash) -> Int32
        .local Int32 node
        .local Int32 index
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Buckets
        ldarg hash
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Buckets
        ldlen
        conv.ovf.i4
        rem
        ldelem Int32
        stloc node
    NextNode:
        ldloc node
        brfalse Missing
        ldloc node
        ldc.i4 1
        sub
        stloc index
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Hashes
        ldloc index
        call instance System.Collections.ArrayList<Int32>::get_Item(Int32)
        ldarg hash
        bne.un Continue
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Callbacks
        ldfld System.Collections.MapCallbacks<K>::Equal
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredKeys
        ldloc index
        call instance System.Collections.ArrayList<K>::get_Item(Int32)
        ldarg key
        call instance System.Func<K,K,Boolean>::Invoke(K,K)
        brtrue Found
    Continue:
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Next
        ldloc index
        call instance System.Collections.ArrayList<Int32>::get_Item(Int32)
        stloc node
        br NextNode
    Found:
        ldloc index
        ret
    Missing:
        ldc.i4 -1
        ret
    .end

    .method instance Find(K key) -> System.Option<V>
        .local Int32 index
        ldarg this
        call instance System.Collections.HashMap<K,V>::Enter()
        ldarg this
        ldarg key
        ldarg this
        ldarg key
        call instance System.Collections.HashMap<K,V>::HashKey(K)
        call instance System.Collections.HashMap<K,V>::Locate(K,Int32)
        stloc index
        ldarg this
        call instance System.Collections.HashMap<K,V>::Leave()
        ldloc index
        ldc.i4 0
        blt Missing
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredValues
        ldloc index
        call instance System.Collections.ArrayList<V>::get_Item(Int32)
        newobj instance System.Option.Some<V>::.ctor(V)
        newobj instance System.Option<V>::.ctor(System.Option.Some<V>)
        ret
    Missing:
        newobj instance System.Option.None::.ctor()
        newobj instance System.Option<V>::.ctor(System.Option.None)
        ret
    .end

    .method instance ContainsKey(K key) -> Boolean
        ldarg this
        call instance System.Collections.HashMap<K,V>::Enter()
        ldarg this
        ldarg key
        ldarg this
        ldarg key
        call instance System.Collections.HashMap<K,V>::HashKey(K)
        call instance System.Collections.HashMap<K,V>::Locate(K,Int32)
        ldc.i4 -1
        cgt
        ldarg this
        call instance System.Collections.HashMap<K,V>::Leave()
        ret
    .end

    .method private instance Grow() -> void
        .local arrayref<Int32> buckets
        .local Int32 size
        .local Int32 index
        .local Int32 bucket
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Buckets
        ldlen
        conv.ovf.i4
        stloc size
        ldarg this
        call instance System.Collections.HashMap<K,V>::get_Count()
        ldloc size
        blt Done
        ldloc size
        ldc.i4 2
        mul.ovf
        stloc size
        ldloc size
        newarr Int32
        stloc buckets
        ldc.i4 0
        stloc index
    Loop:
        ldloc index
        ldarg this
        call instance System.Collections.HashMap<K,V>::get_Count()
        bge Install
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Hashes
        ldloc index
        call instance System.Collections.ArrayList<Int32>::get_Item(Int32)
        ldloc size
        rem
        stloc bucket
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Next
        ldloc index
        ldloc buckets
        ldloc bucket
        ldelem Int32
        call instance System.Collections.ArrayList<Int32>::set_Item(Int32,Int32)
        ldloc buckets
        ldloc bucket
        ldloc index
        ldc.i4 1
        add.ovf
        stelem Int32
        ldloc index
        ldc.i4 1
        add.ovf
        stloc index
        br Loop
    Install:
        ldarg this
        ldloc buckets
        stfld System.Collections.HashMap<K,V>::Buckets
    Done:
        ret
    .end

    .method private instance Append(K key,V value,Int32 hash) -> void
        .local Int32 bucket
        ldarg this
        call instance System.Collections.HashMap<K,V>::Grow()
        ldarg hash
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Buckets
        ldlen
        conv.ovf.i4
        rem
        stloc bucket
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredKeys
        ldarg key
        call instance System.Collections.ArrayList<K>::Add(K)
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredValues
        ldarg value
        call instance System.Collections.ArrayList<V>::Add(V)
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Hashes
        ldarg hash
        call instance System.Collections.ArrayList<Int32>::Add(Int32)
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Next
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Buckets
        ldloc bucket
        ldelem Int32
        call instance System.Collections.ArrayList<Int32>::Add(Int32)
        ldarg this
        ldfld System.Collections.HashMap<K,V>::Buckets
        ldloc bucket
        ldarg this
        call instance System.Collections.HashMap<K,V>::get_Count()
        stelem Int32
        ret
    .end

    .method instance TryAdd(K key,V value) -> Boolean
        .local Int32 hash
        .local Int32 index
        ldarg this
        call instance System.Collections.HashMap<K,V>::Enter()
        ldarg this
        ldarg key
        call instance System.Collections.HashMap<K,V>::HashKey(K)
        stloc hash
        ldarg this
        ldarg key
        ldloc hash
        call instance System.Collections.HashMap<K,V>::Locate(K,Int32)
        stloc index
        ldloc index
        ldc.i4 0
        bge Existing
        ldarg this
        ldarg key
        ldarg value
        ldloc hash
        call instance System.Collections.HashMap<K,V>::Append(K,V,Int32)
        ldarg this
        call instance System.Collections.HashMap<K,V>::Leave()
        ldc.bool true
        ret
    Existing:
        ldarg this
        call instance System.Collections.HashMap<K,V>::Leave()
        ldc.bool false
        ret
    .end

    .method instance Set(K key,V value) -> void
        .local Int32 hash
        .local Int32 index
        ldarg this
        call instance System.Collections.HashMap<K,V>::Enter()
        ldarg this
        ldarg key
        call instance System.Collections.HashMap<K,V>::HashKey(K)
        stloc hash
        ldarg this
        ldarg key
        ldloc hash
        call instance System.Collections.HashMap<K,V>::Locate(K,Int32)
        stloc index
        ldloc index
        ldc.i4 0
        bge Existing
        ldarg this
        ldarg key
        ldarg value
        ldloc hash
        call instance System.Collections.HashMap<K,V>::Append(K,V,Int32)
        ldarg this
        call instance System.Collections.HashMap<K,V>::Leave()
        ret
    Existing:
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredValues
        ldloc index
        ldarg value
        call instance System.Collections.ArrayList<V>::set_Item(Int32,V)
        ldarg this
        call instance System.Collections.HashMap<K,V>::Leave()
        ret
    .end

    .property instance Keys() -> System.Collections.Sequence<K>
        .get instance System.Collections.HashMap<K,V>::get_Keys()
    .end

    .method instance get_Keys() -> System.Collections.Sequence<K>
        ldarg this
        ldfld System.Collections.HashMap<K,V>::StoredKeys
        call instance System.Collections.ArrayList<K>::Copy()
        castclass System.Collections.Sequence<K>
        ret
    .end

.end
