; Runtime-known data representations with ordinary library-defined members.
.module System

.type System.Void
.end

.type System.Boolean
.end

.type System.String
    .method static Concat(String left, String right) -> String
        ldarg left
        ldarg right
        call neoCLR.Runtime.StringConcat(String,String)
        ret
    .end

    .method instance Equals(String other) -> Boolean
        ldarg this
        ldarg other
        ceq
        ret
    .end

    .method instance GetUtf8ByteCount() -> Int32
        ldarg this
        call neoCLR.Runtime.StringByteCount(String)
        ret
    .end

    .method instance IsEmpty() -> Boolean
        ldarg this
        ldstr ""
        ceq
        ret
    .end

    .method instance SliceUtf8(Int32 byteStart, Int32 byteLength) -> Result<String,Error>
        ldarg this
        ldarg byteStart
        ldarg byteLength
        call neoCLR.Runtime.StringSliceUtf8(String,Int32,Int32)
        ret
    .end
.end

.type System.Error
    .method static FromMessage(String message) -> Error
        ldarg message
        call neoCLR.Runtime.ErrorFromMessage(String)
        ret
    .end

    .method instance get_Message() -> String
        ldarg this
        call neoCLR.Runtime.ErrorMessage(Error)
        ret
    .end

    .method instance ToString() -> String
        ldarg this
        call instance System.Error::get_Message()
        ret
    .end
.end

.type System.SByte
.end

.type System.Byte
.end

.type System.Int16
.end

.type System.UInt16
.end

.type System.Char
.end

.type System.UInt32
.end

.type System.Int64
.end

.type System.UInt64
.end

.type System.Single
.end

.type System.Double
.end

.type System.IntPtr
.end

.type System.UIntPtr
.end

.type System.Int32
    .method static Parse(string value) -> Result<Int32,Error>
        ldarg 0
        call neoCLR.Runtime.ParseInt32(string)
        ret
    .end

    .method static Divide(int32 dividend, int32 divisor) -> Result<Int32,Error>
        ldarg divisor
        ldc.i4 0
        ceq
        brtrue DivisionByZero
        ldarg dividend
        ldc.i4 -2147483648
        ceq
        brtrue CheckOverflow
        br Divide
        CheckOverflow:
        ldarg divisor
        ldc.i4 -1
        ceq
        brtrue Overflow
        Divide:
        ldarg dividend
        ldarg divisor
        div
        ok Error
        ret
        DivisionByZero:
        error "DivisionByZero"
        err Int32
        ret
        Overflow:
        error "Overflow"
        err Int32
        ret
    .end

    .method instance ToString() -> string
        ldarg this
        call neoCLR.Runtime.Int32ToString(int32)
        ret
    .end
.end

.type System.Console
    .method static WriteLine(string value) -> Void
        ldarg value
        call neoCLR.Runtime.WriteLine(string)
        ret
    .end

    .method static WriteLine(int32 value) -> Void
        ldarg value
        call instance System.Int32::ToString()
        call System.Console.WriteLine(string)
        ret
    .end

.end

.type System.Math
    .method static Abs(int32 value) -> Result<Int32,Error>
        ldarg value
        ldc.i4 -2147483648
        ceq
        brtrue Overflow
        ldarg value
        ldc.i4 0
        clt
        brtrue Negative
        ldarg value
        ok Error
        ret
        Negative:
        ldc.i4 0
        ldarg value
        sub
        ok Error
        ret
        Overflow:
        error "Overflow"
        err Int32
        ret
    .end
.end

.function neoCLR.Runtime.WriteLine(string value) -> Void
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.Int32ToString(int32 value) -> string
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.ParseInt32(string value) -> Result<Int32,Error>
    .methodimpl InternalCall
.end

; Ordinary marker metadata; no union execution semantics are attached to this type.
.type System.Runtime.CompilerServices.UnionAttribute
    .method instance .ctor() -> Void
        ldvoid
        ret
    .end
.end

.function neoCLR.Runtime.StringConcat(String left, String right) -> String
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.StringByteCount(String value) -> Int32
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.StringSliceUtf8(String value, Int32 byteStart, Int32 byteLength) -> Result<String,Error>
    .methodimpl InternalCall
.end

; Explicit native buffer descriptor. Copies alias Data; Free is a caller obligation.
.type System.Array<T>
    .field Data T*
    .field Length Int32

    .method static Allocate(Int32 length, T initialValue) -> System.Array<T>
        .local System.Array<T> array
        .local Int32 index
        ldarg length
        ldc.i4 0
        blt InvalidLength
        ldarg length
        heap.alloc T
        ldarg length
        newobj System.Array<T>
        stloc array
        ldc.i4 0
        stloc index
        br Test
    Fill:
        ldloc array
        ldloc index
        ldarg initialValue
        call instance System.Array<T>::Set(Int32,T)
        pop
        ldloc index
        ldc.i4 1
        add
        stloc index
    Test:
        ldloc index
        ldarg length
        blt Fill
        ldloc array
        ret
    InvalidLength:
        fault "Array length must be non-negative"
    .end

    .method instance get_Length() -> Int32
        ldarg this
        ldfld System.Array<T>::Length
        ret
    .end

    .method instance GetElementAddress(Int32 index) -> T*
        ldarg index
        ldc.i4 0
        blt OutOfRange
        ldarg index
        ldarg this
        ldfld System.Array<T>::Length
        bge OutOfRange
        ldarg this
        ldfld System.Array<T>::Data
        ldarg index
        conv.i
        sizeof T
        conv.i
        mul.ovf
        ptr.add
        ret
    OutOfRange:
        fault "Array index out of range"
    .end

    .method instance Get(Int32 index) -> T
        ldarg this
        ldarg index
        call instance System.Array<T>::GetElementAddress(Int32)
        ldobj T
        ret
    .end

    .method instance Set(Int32 index, T value) -> Void
        ldarg this
        ldarg index
        call instance System.Array<T>::GetElementAddress(Int32)
        ldarg value
        stobj T
        ldvoid
        ret
    .end

    .method instance Free() -> Void
        ldarg this
        ldfld System.Array<T>::Data
        heap.free
        ret
    .end
.end

.function neoCLR.Runtime.ErrorFromMessage(String message) -> Error
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.ErrorMessage(Error value) -> String
    .methodimpl InternalCall
.end

.type System.IO.File
    .method static ReadAllText(String path, Int32 maxBytes) -> Result<String,Error>
        ldarg path
        ldarg maxBytes
        call neoCLR.Runtime.ReadAllText(String,Int32)
        ret
    .end
.end

.function neoCLR.Runtime.ReadAllText(String path, Int32 maxBytes) -> Result<String,Error>
    .methodimpl InternalCall
.end
