; Runtime-known data representations with ordinary library-defined members.
.module System

.type System.Void
.end

.type System.Boolean
.end

.type System.String
.end

.type System.Error
.end

.type System.Int32
    .method static Parse(value: string) -> Result<Int32,Error>
        ldarg 0
        call neoCLR.Runtime.ParseInt32(string)
        ret
    .end

    .method static Divide(dividend: int32, divisor: int32) -> Result<Int32,Error>
        ldarg divisor
        ldc.i4 0
        ceq
        brtrue DivisionByZero
        ldarg dividend
        ldc.i4 -2147483648
        ceq
        brtrue CheckOverflow
        br Divide
        CheckOverflow:
        ldarg divisor
        ldc.i4 -1
        ceq
        brtrue Overflow
        Divide:
        ldarg dividend
        ldarg divisor
        div
        ok Error
        ret
        DivisionByZero:
        error "DivisionByZero"
        err Int32
        ret
        Overflow:
        error "Overflow"
        err Int32
        ret
    .end

    .method instance ToString() -> string
        ldarg this
        call neoCLR.Runtime.Int32ToString(int32)
        ret
    .end
.end

.type System.Console
    .method static WriteLine(value: string) -> Void
        ldarg value
        call neoCLR.Runtime.WriteLine(string)
        ret
    .end

    .method static WriteLine(value: int32) -> Void
        ldarg value
        call instance System.Int32::ToString()
        call System.Console.WriteLine(string)
        ret
    .end

.end

.type System.Math
    .method static Abs(value: int32) -> Result<Int32,Error>
        ldarg value
        ldc.i4 -2147483648
        ceq
        brtrue Overflow
        ldarg value
        ldc.i4 0
        clt
        brtrue Negative
        ldarg value
        ok Error
        ret
        Negative:
        ldc.i4 0
        ldarg value
        sub
        ok Error
        ret
        Overflow:
        error "Overflow"
        err Int32
        ret
    .end
.end

.function neoCLR.Runtime.WriteLine(value: string) -> Void
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.Int32ToString(value: int32) -> string
    .methodimpl InternalCall
.end

.function neoCLR.Runtime.ParseInt32(value: string) -> Result<Int32,Error>
    .methodimpl InternalCall
.end
