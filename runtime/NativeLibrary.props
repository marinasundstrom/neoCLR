<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RavenTargetPlatform>NeoCLR</RavenTargetPlatform>
    <RavenMetadataFormat>NeoCLR</RavenMetadataFormat>
    <RavenNeoClrNativeCoreReference>$(MSBuildThisFileDirectory)System.Runtime/src/System.Runtime/bin/neoclr/System.Runtime.dll</RavenNeoClrNativeCoreReference>
    <RavenNeoClrRuntimeContracts>$(MSBuildThisFileDirectory)System.Runtime/src/System.Runtime/ownership.json</RavenNeoClrRuntimeContracts>
    <RavenNeoClrAsyncLibrary>System.Runtime</RavenNeoClrAsyncLibrary>
  </PropertyGroup>
</Project>
