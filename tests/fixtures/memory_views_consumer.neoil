; Run with: neoclr run examples/memory_views.neoil --execution interpreter
; Writes through a nested window; only the backing array allocates guest storage.
.module MemoryViewsExample
.entry Main
.function Main() -> Int32
.local arrayref<Int32> data
.local System.Slice<Int32> slice
ldc.i4 5
newarr Int32
stloc data
ldloc data
ldc.i4 1
ldc.i4 3
call System.MemoryViews.AsSlice<Int32>(arrayref<Int32>,Int32,Int32)
stloc slice
ldloc slice
ldc.i4 1
call instance System.Slice<Int32>::Slice(Int32)
ldc.i4 0
ldc.i4 42
call instance System.Slice<Int32>::set_Item(Int32,Int32)
pop
ldloc data
ldc.i4 2
ldelem Int32
ret
.end
