; Test-only pattern extraction against the generated union contract.
.function UnwrapSome<T0>(System.Optional<T0> value) -> T0
.local System.Optional.Some<T0> matched
ldarga value
ldloca matched
call instance System.Optional<T0>::TryGetValue(System.Optional.Some<T0>&)
brtrue Found
fault "Expected Some"
Found:
ldloca matched
call instance System.Optional.Some<T0>::get_Value()
ret
.end
