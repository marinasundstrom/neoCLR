; Private typed runtime services, not the public managed cryptography API.
; Outputs are writable byte slices; digest/MAC write exactly 32 bytes.
; 0 success, -1 insufficient destination, -2 random provider failure (output cleared).
.function neoCLR.Runtime.CryptoSha256(System.ReadOnlySlice<Byte> data,System.Slice<Byte> output) -> Int32
.methodimpl InternalCall
.end
.function neoCLR.Runtime.CryptoHmacSha256(System.ReadOnlySlice<Byte> key,System.ReadOnlySlice<Byte> data,System.Slice<Byte> output) -> Int32
.methodimpl InternalCall
.end
.function neoCLR.Runtime.CryptoHmacSha256Verify(System.ReadOnlySlice<Byte> key,System.ReadOnlySlice<Byte> data,System.ReadOnlySlice<Byte> tag) -> Boolean
.methodimpl InternalCall
.end
.function neoCLR.Runtime.CryptoRandomFill(System.Slice<Byte> output) -> Int32
.methodimpl InternalCall
.end
